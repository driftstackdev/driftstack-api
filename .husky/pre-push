#!/usr/bin/env sh
# V-223 — pre-push gate. Catches the class of regression where a
# previous commit pushed broken `tsconfig.test.json` typecheck or
# breaking test changes to main without a per-file lint-staged hook
# noticing.
#
# pre-commit runs lint-staged (per-file eslint + prettier on staged
# files only) — fast, narrow, doesn't catch project-wide regressions.
# pre-push runs the full verify chain that production-relevant
# commits depend on.
#
# Skip in emergencies via `git push --no-verify`. Don't make a habit.

set -e


# V-231 — every new SQL migration MUST have a matching journal entry
# (catch V-228-class regressions structurally; per founder verdict on
# TD-002 Option A). Compares migration SQL filenames against journal
# tags; aborts if any new file lacks an entry.
echo "→ migration journal sync (V-228 backstop)"
journal="apps/server/src/db/migrations/meta/_journal.json"
if [ -f "$journal" ]; then
  for sql in apps/server/src/db/migrations/*.sql; do
    [ -f "$sql" ] || continue
    tag=$(basename "$sql" .sql)
    if ! grep -q "\"tag\": \"$tag\"" "$journal"; then
      echo "✗ migration $sql has no journal entry for tag '$tag'"
      echo "  add an entry to $journal or regenerate via 'npm run db:generate'"
      exit 1
    fi
  done
fi

# W-27 — a release tag must be ANNOTATED. ⛔ THIS IS NOT THE LAST PLACE IT CAN BE
# STOPPED, and the earlier version of this comment claiming so was wrong in a way
# that cost a version number: `gh release create <tag>` CREATES the tag through the
# GitHub REST API when it does not already exist, so no push happens and this hook
# never runs. `gui-v0.1.18` shipped lightweight that way on 2026-09-07, after this
# guard was in place — because the runbook listed `gh release create` BEFORE the
# push. The runbook order is the real fix (push the annotated tag first, then
# create the release against it); this hook only covers the path that pushes.
# `docs/operations/release-policy.md` says "annotated tags only" and the
# GUI runbook gives the `-a` form, but prose is not a check: `gui-v0.1.3`,
# `gui-v0.1.13` and `gui-v0.1.14` all shipped LIGHTWEIGHT. Measured, not assumed —
# `git for-each-ref refs/tags/<t> --format='%(objecttype)'` returns `commit` for
# those three and `tag` for `gui-v0.1.4` and `gui-v0.1.17`. A lightweight tag
# carries no tagger, no date and no message, so the release record is whatever the
# commit happened to say.
#
# ⛔ Catching it HERE still matters, because CI is worse: the release workflow only
# fires once the tag is on origin, and the same policy forbids retagging — so a CI
# check catches the defect after it is published and the version is burnt. But
# "better than CI" is not "last line of defence": the API path bypasses both, and
# only the runbook's ordering closes it. Those tags are deliberately NOT retagged.
#
# Discriminator: on a tag push git hands us the object the ref points at —
# the TAG object for an annotated tag, the COMMIT itself for a lightweight one.
# An all-zero sha is a deletion and is none of our business.
tag_zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -n "$remote_ref" ] || continue
  case "$remote_ref" in
    refs/tags/gui-v*|refs/tags/server-v*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$tag_zero" ] && continue
  tag_kind=$(git cat-file -t "$local_sha" 2>/dev/null || echo unknown)
  if [ "$tag_kind" != "tag" ]; then
    name=${remote_ref#refs/tags/}
    echo "✗ $name is a LIGHTWEIGHT tag (objecttype=$tag_kind)"
    echo "  docs/operations/release-policy.md requires annotated tags, and a"
    echo "  published tag cannot be replaced — so this is the last chance to fix it."
    echo "  Re-cut it:"
    echo "    git tag -d $name"
    echo "    git tag -a $name -m \"Driftstack $name — <what changed>\""
    exit 1
  fi
  echo "→ ${remote_ref#refs/tags/} is an annotated tag"
done

# 2026-09-11 — the gate certifies on CI's Node MAJOR, not whatever `node` is
# first on PATH. Measured: this Mac ran Node 25, CI runs 22. Node 25's global
# `localStorage` is a stub whose methods throw and it shadows jsdom's; every
# storage read in the GUI sits in a try/catch, so the whole GUI suite passed
# here against storage that cannot store — while on CI's real storage one
# test's "☰ List" click persisted into the 29 tests after it and they failed.
# Two green gates certified a red main. The major is read from ci.yml so the
# two cannot drift apart silently; a Homebrew `node@<major>` is used when
# present, otherwise the push is refused with the install line.
ci_major=$(grep -m1 -oE "node-version: '[0-9]+'" .github/workflows/ci.yml | grep -oE '[0-9]+')
here_major=$(node -v | sed 's/^v//' | cut -d. -f1)
if [ -n "$ci_major" ] && [ "$here_major" != "$ci_major" ]; then
  alt="/opt/homebrew/opt/node@${ci_major}/bin"
  if [ -x "$alt/node" ]; then
    echo "→ node v$here_major here, CI runs Node $ci_major — the gate uses $alt"
    export PATH="$alt:$PATH"
    hash -r 2>/dev/null || true
  else
    echo "✗ node v$here_major here, CI runs Node $ci_major, and $alt/node is not installed"
    echo "  brew install node@$ci_major"
    echo "  (a gate on another major can pass where CI fails — see apps/gui-client/tests/setup.ts (4))"
    exit 1
  fi
fi
echo "→ gate node $(node -v) (CI: $ci_major)"

echo "→ typecheck (workspaces, including tsconfig.test.json)"
npm run typecheck

echo "→ lint"
npm run lint

echo "→ format check"
npm run format:check

# 2026-05-20 — sdk-python Ruff format check, gated on the venv being
# present (devs not touching Python aren't required to set it up).
# Closes the gap where Ruff regressions in packages/sdk-python/ slip
# through pre-push and only surface as a red CI run post-push — cost
# us a follow-up commit after fa8cb83a shipped with a 3-line
# launch() signature that Ruff wanted on one line.
if [ -x packages/sdk-python/.venv/bin/ruff ]; then
  echo "→ sdk-python lint + format check"
  npm run sdk:python:lint
else
  echo "→ sdk-python lint SKIPPED (no .venv — install via packages/sdk-python/scripts/setup.sh to enable)"
fi

# 2026-05-20 — sdk-go gofmt drift check. CI runs `go vet` + `go test`
# but neither enforces gofmt alignment; 12 files had silently drifted
# (pure indent/comment alignment, no semantic changes) until a sweep
# caught them. gofmt is part of the Go toolchain so this is gated on
# `command -v go` rather than a venv path.
if command -v gofmt >/dev/null 2>&1; then
  unformatted=$(cd packages/sdk-go && gofmt -l . 2>&1)
  if [ -n "$unformatted" ]; then
    echo "✗ sdk-go gofmt drift in:"
    echo "$unformatted" | sed 's/^/    /'
    echo "  run 'cd packages/sdk-go && gofmt -w .' to fix"
    exit 1
  fi
  echo "→ sdk-go gofmt check clean"
else
  echo "→ sdk-go gofmt SKIPPED (no go toolchain on PATH)"
fi

# 2026-05-20 — gui-client (Tauri) cargo fmt check. CI's gui-build-check
# runs `cargo check` + `cargo test` but not `cargo fmt --check`, so
# rustfmt drift wouldn't trip a gate. Symmetric with the Ruff + gofmt
# coverage shipped above. Skipped on machines without the Rust toolchain.
if command -v cargo >/dev/null 2>&1; then
  if ! (cd apps/gui-client/src-tauri && cargo fmt --check >/dev/null 2>&1); then
    echo "✗ gui-client cargo fmt drift"
    (cd apps/gui-client/src-tauri && cargo fmt --check 2>&1) | head -20 | sed 's/^/    /'
    echo "  run 'cd apps/gui-client/src-tauri && cargo fmt' to fix"
    exit 1
  fi
  echo "→ gui-client cargo fmt check clean"
  # Cargo.lock consistency: `cargo update -w --locked` fails on a stale app entry
  # AND on a crate pinned to a version that does not exist — the two states a
  # blanket version-replace produced at 0.1.45 (all three release builds failed
  # at resolution and an asset-less release became the updater's "latest").
  # Offline first (instant); the network variant when the offline index cannot
  # answer. Bumps go through scripts/bump-gui-version.mjs, which edits by field.
  if ! (cd apps/gui-client/src-tauri && { cargo update -w --locked --offline >/dev/null 2>&1 || cargo update -w --locked >/dev/null 2>&1; }); then
    echo "✗ gui-client Cargo.lock is not consistent with Cargo.toml / the registry"
    (cd apps/gui-client/src-tauri && cargo update -w --locked 2>&1) | head -12 | sed 's/^/    /'
    echo "  bump the desktop client with 'node scripts/bump-gui-version.mjs <x.y.z>' (edits by field, never a blanket replace)"
    exit 1
  fi
  echo "→ gui-client Cargo.lock consistent (--locked)"
else
  echo "→ gui-client cargo fmt + Cargo.lock checks SKIPPED (no cargo on PATH)"
fi

# W-12 — the test files that no tsconfig used to cover. Runs HERE and not in
# the vitest suite: it spawns a full compiler, and doing that inside the runner
# pushed a neighbouring guard past its timeout and doubled suite duration.
echo "→ test-file typecheck backlog (W-12)"
node scripts/typecheck-test-backlog.mjs

echo "→ tests"
npm test

# W-34 — say whether CI is currently RED on origin/main, because nothing else does.
#
# ⛔ CI sat red for 22 hours while every deploy shipped green. Two things made that
# possible and both are by design: this gate runs only the `build-test` job (its own
# notice says so), and the Deploy workflow does not depend on CI. So a failing e2e
# or SDK job produces no signal anywhere a person looks. This is the last moment
# before more work lands on top of it.
#
# ⚠️ ADVISORY, never blocking. Blocking here would put a network call on the push
# path and hand CI a veto over an urgent fix, which is the opposite of the
# continuous-deploy design. It reports; the human decides.
#
# ⛔ THREE STATES, and the third is the point. A check that goes quiet when it
# cannot run is indistinguishable from a green one — the exact defect this whole
# family of guards keeps producing. So "could not check" SAYS SO.
#
# ⛔ ONE COMMIT, NAMED (2026-09-25). The line used to be the newest run on main
# that carried a verdict, and pushes supersede in-flight runs — so it was routinely
# ANOTHER commit's verdict under origin/main's name ("green (7172d0cc5)", a run
# from 09-22, while origin/main was c2be2354b and its own run had none yet). It is
# now the verdict of the commit at the head of origin/main, or a plain "no verdict"
# that is never a green. The logic, and the states it reports, are in the script.
if [ "${DRIFTSTACK_SKIP_CI_CHECK:-}" != "1" ]; then
  node scripts/ci-verdict-on-main.mjs || echo "→ CI on origin/main: COULD NOT CHECK (the check itself failed to run) — Not a green."
fi

echo "✓ pre-push gate clean"
