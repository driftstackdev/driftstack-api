{
  "name": "driftstack-api",
  "version": "0.0.1",
  "description": "Driftstack API + control plane",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build -w packages --if-present",
    "build:apps": "npm run build -w apps --if-present",
    "dev": "npm run dev --workspace apps/server",
    "dev:all": "concurrently --names server,dashboard,admin,marketing,docs,status --prefix-colors auto -k 'npm:dev:server' 'npm:dev:dashboard' 'npm:dev:admin' 'npm:dev:marketing' 'npm:dev:docs' 'npm:dev:status'",
    "dev:server": "npm run dev --workspace @driftstack/server",
    "dev:dashboard": "npm run dev --workspace @driftstack/customer-dashboard",
    "dev:admin": "npm run dev --workspace @driftstack/admin-panel",
    "dev:marketing": "npm run dev --workspace @driftstack/marketing-site",
    "dev:docs": "npm run dev --workspace @driftstack/docs",
    "dev:status": "npm run dev --workspace @driftstack/status-site",
    "start": "npm run start --workspace apps/server",
    "pretest": "node scripts/clear-stale-vite-cache.mjs && PUBLIC_API_BASE_URL=\"${PUBLIC_API_BASE_URL:-http://localhost:3000}\" npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "bench:json": "vitest bench --run --outputJson=tmp/bench-results.json",
    "bench:check-regression": "node scripts/check-bench-regression.mjs",
    "check:rendered-product-status": "node scripts/check-rendered-product-status.mjs",
    "test:e2e": "npm run test:e2e --workspace apps/server",
    "test:e2e:setup": "docker compose up -d --wait",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/check-subprocessor-mirror.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:migrate --workspace apps/server",
    "db:seed": "npm run db:seed --workspace apps/server",
    "db:studio": "drizzle-kit studio",
    "sdk:python:dump-spec": "tsx apps/server/src/lib/dump-openapi.ts packages/sdk-python/openapi.json",
    "sdk:python:generate": "bash packages/sdk-python/scripts/generate.sh",
    "sdk:python:test": "cd packages/sdk-python && .venv/bin/pytest",
    "sdk:python:lint": "cd packages/sdk-python && .venv/bin/ruff check . && .venv/bin/ruff format --check ."
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autocannon": "^7.15.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "4.110.0",
    "ws": "^8.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
