# V-278.F — staging .env template.
#
# Mirrors production.env.template. V-278.K split Postgres into a
# separate staging Neon project; Redis remains shared with production
# behind the `stg:` key prefix.

NODE_ENV=production
PORT=7780
LOG_LEVEL=debug
DRIFTSTACK_DEPLOY_ENV=staging

# ── Postgres (isolated staging Neon project) ─────────────────────────
DATABASE_URL=postgresql://neondb_owner:REDACTED@ep-lingering-math-alnalhby-pooler.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require
# V-278.K isolation: staging migrations and test writes must never land
# in production's ep-aged-pond project. deploy-bridge.sh fails closed
# when the live staging and production DATABASE_URL hosts match.

# ── Redis (shared with prod, key prefix) ──────────────────────────────
UPSTASH_REDIS_REST_URL=https://welcome-antelope-114301.upstash.io
UPSTASH_REDIS_REST_TOKEN=REDACTED
REDIS_KEY_PREFIX=stg:

# ── R2 ────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=7260371ac521e2a08a27ba8c7bdd5f43
R2_BUCKET_AVATARS=driftstack-staging-avatars
R2_BUCKET_UPLOADS=driftstack-staging-uploads
R2_ACCESS_KEY_ID=REDACTED
R2_SECRET_ACCESS_KEY=REDACTED
R2_PUBLIC_BASE_URL=https://avatars.staging.driftstack.dev

# ── Postmark ──────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=REDACTED
POSTMARK_FROM_TRANSACTIONAL=noreply@driftstack.dev
POSTMARK_FROM_DEFAULT=info@driftstack.dev

# ── Sentry ────────────────────────────────────────────────────────────
SENTRY_DSN=https://a30962fd20ed09c4e7f23b3c3fc32724@o4511325811834880.ingest.de.sentry.io/4511325820223568
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=PLACEHOLDER_GIT_SHA
SENTRY_TRACES_SAMPLE_RATE=1.0

# ── Stripe (TEST keys; same as prod pre-launch) ───────────────────────
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_PUBLISHABLE_KEY=pk_test_REDACTED
STRIPE_WEBHOOK_SECRET=whsec_REDACTED

# ── Auth secrets (DIFFERENT from prod) ────────────────────────────────
SESSION_SIGNING_SECRET=REDACTED
EMAIL_VERIFICATION_SIGNING_SECRET=REDACTED
PASSWORD_RESET_SIGNING_SECRET=REDACTED
MAGIC_LINK_SIGNING_SECRET=REDACTED
MFA_ENCRYPTION_KEY=REDACTED
WEBHOOK_DEFAULT_SIGNING_SEED=REDACTED

# Surfaced on /version; deploy-api.sh writes the local HEAD SHA.
GIT_SHA=PLACEHOLDER_GIT_SHA
PUBLIC_BASE_URL=https://api.staging.driftstack.dev
DASHBOARD_BASE_URL=https://staging.driftstack.dev
# V-079.B — required boot-time guard (apps/server/src/lib/config.ts
# deriveAuthFlowUrls); NODE_ENV=production (set above) refuses to boot
# without this. Value per docs/operations/production-env-schema.md's
# documented staging convention — NOTE app-staging.driftstack.dev does
# not currently resolve in DNS (pre-existing gap, docs/internal/
# 2026-05-26-staging-hostname-inconsistency.md item 2: the real CF Pages
# staging custom domain lives in external Cloudflare config this repo
# can't confirm). This unblocks boot; the DNS/CF Pages domain itself is
# a separate, still-open item.
DASHBOARD_ORIGIN=https://app-staging.driftstack.dev
DOCS_BASE_URL=https://docs.driftstack.dev
MARKETING_BASE_URL=https://driftstack.dev
TRUST_PROXY=1
# V-278 — CORS allow-list. Comma-separated origin URLs that the
# customer-dashboard / marketing-site / docs are served from.
CORS_ALLOWED_ORIGINS=https://app.driftstack.dev,https://admin.driftstack.dev,https://status.driftstack.dev,https://driftstack.dev,https://www.driftstack.dev,https://docs.driftstack.dev
