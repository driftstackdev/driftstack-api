# V-278.A — production .env template.
#
# DO NOT commit a populated copy of this file. The deploy step writes
# /opt/driftstack/api/.env from DEPLOY_DOTENV_BASE64 (a base64-encoded
# secret kept in GitHub Actions / 1Password / KeePassXC — agent never
# sees the live-mode Stripe keys per the credential-handling rule).
#
# Required variables:

NODE_ENV=production
PORT=7780
LOG_LEVEL=info

# ── Postgres (Neon, eu-central-1) ─────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:REDACTED@ep-aged-pond-al77cutb.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Redis (Upstash REST, eu-central) ──────────────────────────────────
# The server's Redis client wraps @upstash/redis around the REST URL
# + token, so the URL stays HTTPS rather than redis://.
UPSTASH_REDIS_REST_URL=https://welcome-antelope-114301.upstash.io
UPSTASH_REDIS_REST_TOKEN=REDACTED

# ── R2 (Cloudflare) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=7260371ac521e2a08a27ba8c7bdd5f43
R2_BUCKET_AVATARS=driftstack-prod-avatars
R2_BUCKET_UPLOADS=driftstack-prod-uploads
R2_ACCESS_KEY_ID=REDACTED
R2_SECRET_ACCESS_KEY=REDACTED
# Public-read base for presigned avatar GETs.
R2_PUBLIC_BASE_URL=https://avatars.driftstack.dev

# ── Postmark ──────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=REDACTED
POSTMARK_FROM_TRANSACTIONAL=noreply@driftstack.dev
POSTMARK_FROM_DEFAULT=info@driftstack.dev

# ── Sentry ────────────────────────────────────────────────────────────
SENTRY_DSN=https://a30962fd20ed09c4e7f23b3c3fc32724@o4511325811834880.ingest.de.sentry.io/4511325820223568
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=PLACEHOLDER_GIT_SHA
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Stripe ────────────────────────────────────────────────────────────
# TEST mode pre-launch (per Stripe credential-handling memory rule).
# Live keys swap in via SSH-write after BV KvK closure (~2026-05-21).
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_PUBLISHABLE_KEY=pk_test_REDACTED
# Webhook signing secret deferred until live mode (no signing required
# against test events for v1.0 dev work).
STRIPE_WEBHOOK_SECRET=whsec_REDACTED

# ── Auth secrets ──────────────────────────────────────────────────────
# Generate fresh per environment:  openssl rand -hex 32
# These rotate independently of code deploys; rotation cycle V-296b.
SESSION_SIGNING_SECRET=REDACTED
EMAIL_VERIFICATION_SIGNING_SECRET=REDACTED
PASSWORD_RESET_SIGNING_SECRET=REDACTED
MAGIC_LINK_SIGNING_SECRET=REDACTED
MFA_AT_REST_KEY=REDACTED
WEBHOOK_DEFAULT_SIGNING_SEED=REDACTED

# ── Misc ──────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://api.driftstack.dev
DASHBOARD_BASE_URL=https://app.driftstack.dev
DOCS_BASE_URL=https://docs.driftstack.dev
MARKETING_BASE_URL=https://driftstack.dev
TRUST_PROXY=1
