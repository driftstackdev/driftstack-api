# V-278.A — production .env template.
#
# DO NOT commit a populated copy of this file. The deploy step writes
# /opt/driftstack/api/.env from DEPLOY_DOTENV_BASE64 (a base64-encoded
# secret kept in GitHub Actions / 1Password / KeePassXC — agent never
# sees the live-mode Stripe keys per the credential-handling rule).
#
# Required variables:

NODE_ENV=production
PORT=7780
LOG_LEVEL=info

# ── Postgres (Neon, eu-central-1) ─────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:REDACTED@ep-aged-pond-al77cutb.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Redis (Upstash, eu-central) ───────────────────────────────────────
# REDIS_URL is the one the server connects with: bootstrap.ts builds
# `new Redis(config.redisUrl)` over ioredis. It must be set here — an
# absent REDIS_URL falls back to redis://localhost:6379 SILENTLY, which
# would put rate limiting, the MFA challenge store, the pair-mode lock
# and the auth cache on a local store rather than failing loudly.
# Nothing in this repository reads the REST URL/token below.
REDIS_URL=rediss://default:REDACTED@welcome-antelope-114301.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://welcome-antelope-114301.upstash.io
UPSTASH_REDIS_REST_TOKEN=REDACTED

# ── R2 (Cloudflare) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=7260371ac521e2a08a27ba8c7bdd5f43
R2_BUCKET_AVATARS=driftstack-prod-avatars
R2_BUCKET_UPLOADS=driftstack-prod-uploads
R2_ACCESS_KEY_ID=REDACTED
R2_SECRET_ACCESS_KEY=REDACTED
# Public-read base for presigned avatar GETs.
R2_PUBLIC_BASE_URL=https://avatars.driftstack.dev

# ── Postmark ──────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=REDACTED
POSTMARK_FROM_TRANSACTIONAL=noreply@driftstack.dev
POSTMARK_FROM_DEFAULT=info@driftstack.dev

# ── Sentry ────────────────────────────────────────────────────────────
SENTRY_DSN=https://a30962fd20ed09c4e7f23b3c3fc32724@o4511325811834880.ingest.de.sentry.io/4511325820223568
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=PLACEHOLDER_GIT_SHA
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Stripe ────────────────────────────────────────────────────────────
# TEST mode pre-launch (per Stripe credential-handling memory rule).
# Live keys swap in via SSH-write after BV KvK closure (~2026-05-21).
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_PUBLISHABLE_KEY=pk_test_REDACTED
# Webhook signing secret deferred until live mode (no signing required
# against test events for v1.0 dev work).
STRIPE_WEBHOOK_SECRET=whsec_REDACTED

# ── Auth secrets ──────────────────────────────────────────────────────
# Generate fresh per environment:  openssl rand -hex 32
# These rotate independently of code deploys; rotation cycle V-296b.
SESSION_SIGNING_SECRET=REDACTED
EMAIL_VERIFICATION_SIGNING_SECRET=REDACTED
PASSWORD_RESET_SIGNING_SECRET=REDACTED
MAGIC_LINK_SIGNING_SECRET=REDACTED
MFA_ENCRYPTION_KEY=REDACTED
WEBHOOK_DEFAULT_SIGNING_SEED=REDACTED

# ── Misc ──────────────────────────────────────────────────────────────
# Surfaced on /version so deploy automation can confirm what's running.
# deploy-api.sh writes the local HEAD SHA at deploy time.
GIT_SHA=PLACEHOLDER_GIT_SHA
PUBLIC_BASE_URL=https://api.driftstack.dev
DASHBOARD_BASE_URL=https://app.driftstack.dev
# V-079.B — required boot-time guard (apps/server/src/lib/config.ts
# deriveAuthFlowUrls derives verify-email / magic-link / password-reset
# URLs from this + gates on NODE_ENV=production refusing to boot without
# it). Distinct from DASHBOARD_BASE_URL above (a different, older var) —
# both currently point at the same origin but keep both in sync if they
# ever diverge again (2026-07-01 incident: this var was missing from
# this template + staging's env despite being required since 2026-05-12,
# and deploy-api.sh overwrites the whole remote .env every deploy, so a
# one-off SSH patch alone does not survive the next redeploy).
DASHBOARD_ORIGIN=https://app.driftstack.dev
DOCS_BASE_URL=https://docs.driftstack.dev
MARKETING_BASE_URL=https://driftstack.dev
TRUST_PROXY=1
# V-278 — CORS allow-list. Comma-separated origin URLs that the
# customer-dashboard / marketing-site / docs are served from.
CORS_ALLOWED_ORIGINS=https://app.driftstack.dev,https://admin.driftstack.dev,https://status.driftstack.dev,https://driftstack.dev,https://www.driftstack.dev,https://docs.driftstack.dev

# ── LiveKit (WebRTC SFU) ──────────────────────────────────────────────
# All THREE are required together. bootstrap wires the LiveKit path only
# when apiKey, apiSecret and wsUrl are all present; any subset leaves
# real-WebRTC streaming disabled with no error.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_WS_URL=

# ── NOWPayments (crypto checkout) ─────────────────────────────────────
# The IPN webhook route is registered ONLY when NOWPAYMENTS_IPN_SECRET is
# set and non-empty — without it POST /v1/webhooks/nowpayments 404s, so
# payment callbacks are dropped rather than accepted unverified.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=

# ── Sign-in with Google / GitHub (Driftstack as OAuth CLIENT) ─────────
# A provider is enabled only when BOTH its id and secret are present;
# either one alone is ignored silently.
# OAUTH_CLIENT_SIGNING_SECRET=
# OAUTH_CLIENT_CALLBACK_URL_BASE=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Profile master key (AES-256 for encrypted profile stores) ─────────
# PROFILE_MASTER_KEY_CMD is preferred: it runs at boot and its stdout is
# used as the base64 key, so the key never sits in .env. FAIL-CLOSED — if
# the command is set but fails or returns empty, the server refuses to
# start. The key must base64-decode to exactly 32 bytes.
# PROFILE_MASTER_KEY_CMD=
# PROFILE_MASTER_KEY=

# ── Metrics + fleet control plane ─────────────────────────────────────
# METRICS_SCRAPE_TOKEN gates the Prometheus scrape endpoint.
# DRIFTSTACK_FLEET_INTERNAL_TOKEN authenticates fleet-node callbacks.
# FLEET_CONTROL_PLANE_ENABLED accepts true/1/yes/on (envFlag).
# METRICS_SCRAPE_TOKEN=
# DRIFTSTACK_FLEET_INTERNAL_TOKEN=
# FLEET_CONTROL_PLANE_ENABLED=

# ── R2 status-snapshot bucket ─────────────────────────────────────────
# Separate PUBLIC-read bucket for the status page snapshot; MUST differ
# from the recordings bucket (recordings hold Customer Data). Unset means
# the status-snapshot writer is disabled.
# R2_BUCKET_PUBLIC=

# ── CORS posture ──────────────────────────────────────────────────────
# Leave UNSET in production. PERMISSIVE_CORS echoes any Origin with
# credentials; bootstrap refuses to start when it is on and
# NODE_ENV=production (2026-05-31 incident). Accepts true/1/yes/on.
# PERMISSIVE_CORS=

# ── Anthropic fallback key (BYOK is the customer-supplied path) ────────
# Used ONLY when a customer has not supplied their own key. BYOK is the
# v1.0 path — most customers bring their own — so this is for
# demos + integration runs. While it is unset the AgentRuntime stays
# activation-gated and answers 503.
#
# TWO NAMES, one value. BYOK_ANTHROPIC_FALLBACK_KEY takes precedence;
# DRIFTSTACK_ANTHROPIC_FALLBACK_API_KEY is the alias. A BLANK primary
# falls through to the alias rather than winning with an empty string —
# set either, not both.
# BYOK_ANTHROPIC_FALLBACK_KEY=
# DRIFTSTACK_ANTHROPIC_FALLBACK_API_KEY=
#
# Model the AI agent runs. Unset uses DEFAULT_AGENT_MODEL
# (claude-opus-4-8); the value must be one of the four names in
# AgentModelSchema, which the database CHECK constraint also enforces.
# DRIFTSTACK_ANTHROPIC_MODEL=
