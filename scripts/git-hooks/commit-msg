#!/usr/bin/env bash
# V-527 — commit-msg hook (rejects attribution + anonymity leaks).
#
# Extends the V-205-CLEANUP.C pattern from driftstack + webkit-driftstack
# with V-211 anonymity-policy regex (no founder / personal-name strings in
# any commit attributed to Driftstack <dev@driftstack.dev>).
#
# Policies enforced:
#   - V-205 attribution — Driftstack-only commit attribution. ZERO third-
#     party tooling trailers, ZERO "Generated with" footers, ZERO robot
#     emoji markers, ZERO noreply@<tool>.com addresses.
#   - V-211 anonymity   — ZERO founder framing, ZERO personal-name
#     references (listed outside the repo, see scripts/personal-names.mjs) in
#     commit subject or body.
#
# Git identity policy: every commit is authored and committed as
# `Driftstack <dev@driftstack.dev>`, set per clone with
#   git config --local user.name "Driftstack"
#   git config --local user.email "dev@driftstack.dev"
# and never under a personal name or address.
#
# Canonical source — version-controlled. Install per-clone with
# `scripts/install-git-hooks.sh` (copies this file to .git/hooks/).
set -euo pipefail
MSG_FILE="${1:?commit-msg hook needs message file}"
MSG=$(cat "$MSG_FILE")

# V-205 attribution patterns (case-insensitive).
# The first nine patterns match the canonical trailer and footer forms only, so
# any OTHER phrasing passed: prose attribution, a footer without its emoji or
# markdown brackets, and a differently-named `*-By:` trailer were all accepted.
# The three added below close that, and are deliberately CONTEXT-based rather
# than bare vendor words: this product integrates both vendors, so `claude`
# appears in 34 legitimate commit messages and `anthropic` in 73 (BYOK route
# names). A bare-word rule for those would reject real work. Bare words ARE used
# for the two vendors with zero legitimate uses in 4000 commits.
#
# POSIX ERE only — `grep -E` has no `\b`, which is why the boundaries here read
# `[^[:alnum:]]`. Validated against all 4000 historical messages through grep
# itself: zero flagged.
REJECT_PATTERNS_V205=(
  'Co-Authored-By: Claude'
  'Co-Authored-By:.*claude'
  'Co-Authored-By:.*anthropic'
  'Co-Authored-By:.*GPT'
  'Co-Authored-By:.*Copilot'
  '🤖'
  'Generated with \[Claude'
  'noreply@anthropic\.com'
  'noreply@github\.com'
  '(generated|written|authored|assisted|created|built|made|paired)[^\n]{0,24}(by|with)[^\n]{0,24}(Claude|GPT|Copilot|anthropic)'
  '^[A-Za-z-]*-[Bb]y:.*(Claude|GPT|Copilot|anthropic)'
  '(^|[^[:alnum:]])(GPT|Copilot)([^[:alnum:]]|$)'
)

# V-211 anonymity patterns. Match standalone tokens — avoid biting
# "foundered" / "foundation" inside larger words.
# Trailing boundary is [^[:alpha:]] rather than [^[:alnum:]] deliberately.
# Excluding digits as well as letters let a word followed immediately by digits
# through — which is the form a real handle or address takes — while the
# documented purpose of the boundary is only to avoid biting "foundered" and
# "foundation" inside larger WORDS. Those still do not match; a word followed
# by digits now does.
REJECT_PATTERNS_V211=(
  '(^|[^[:alnum:]])[Ff]ounder([^[:alpha:]]|$)'
)

# V-211 personal names are NOT spelled out here, and not hashed here either: a
# digest of a name is reversed by hashing a public name list. The list lives
# outside the repo — DRIFTSTACK_PERSONAL_NAMES, or the file at
# DRIFTSTACK_PERSONAL_NAMES_FILE (default ~/.config/driftstack/personal-names.txt)
# — and scripts/personal-names.mjs matches the message against it, folding case
# and accents, so a name next to digits, punctuation or an `@` is caught and a
# longer word containing one is not. With no list configured it checks its
# canary word only and says so on stderr. Exit 1 = a name was found; anything
# else = the check could not run, and the hook fails CLOSED on that rather than
# waving the message through.
HOOK_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PERSONAL_NAMES="$HOOK_DIR/../personal-names.mjs"
if [[ ! -f "$PERSONAL_NAMES" ]]; then
  PERSONAL_NAMES="$(git rev-parse --show-toplevel)/scripts/personal-names.mjs"
fi

fail() {
  local pattern="$1"
  local policy="$2"
  echo "==========================================================" >&2
  echo "✗ commit-msg HOOK REJECTED: contains banned pattern" >&2
  echo "  matched: $pattern" >&2
  echo "  policy:  $policy" >&2
  echo "  fix:     remove the offending line(s) from your commit" >&2
  echo "           message, then re-run git commit." >&2
  echo "==========================================================" >&2
  exit 1
}

for PATTERN in "${REJECT_PATTERNS_V205[@]}"; do
  if echo "$MSG" | grep -iqE "$PATTERN"; then
    fail "$PATTERN" "V-205 attribution — Driftstack-only commit attribution"
  fi
done

for PATTERN in "${REJECT_PATTERNS_V211[@]}"; do
  if echo "$MSG" | grep -qE "$PATTERN"; then
    fail "$PATTERN" "V-211 anonymity — no founder/personal-name in commits"
  fi
done

NAME_RC=0
NAME_HITS=$(node "$PERSONAL_NAMES" "$MSG_FILE") || NAME_RC=$?
if [[ $NAME_RC -eq 1 ]]; then
  fail "a personal name (line:column word — $(echo "$NAME_HITS" | tr '\n' ' '))" "V-211 anonymity — no founder/personal-name in commits"
elif [[ $NAME_RC -ne 0 ]]; then
  echo "✗ commit-msg: the V-211 personal-name check could not run (exit $NAME_RC)." >&2
  exit 1
fi

exit 0
