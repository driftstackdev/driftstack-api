node_modules/
dist/
build/
coverage/
.tsbuildinfo
*.tsbuildinfo

# Astro's build-cache dir — auto-generated by `astro check` at the
# cwd it's run from (per-workspace expected, but a root invocation
# leaves a stray copy at the repo root).
.astro/

# Env
.env
.env.*
!.env.example

# V-278 deploy .env files (REAL secrets; never committed). The
# .template versions ARE committed.
/infra/env-templates/*.env
!/infra/env-templates/*.env.template

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Bench artifacts (V-165) — bench output is recorded per-run; only
# the canonical baseline at docs/benchmarks/baseline.ci.json is
# committed.
tmp/

# Drizzle
drizzle/.migrations-applied

# Python SDK
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
packages/sdk-python/dist/
.npmrc

# GUI client (Tauri)
apps/gui-client/dist/
apps/gui-client/src-tauri/target/
apps/gui-client/src-tauri/gen/
# Cargo.lock SHOULD be committed for binaries (Tauri app is a binary).

# Generated by scripts/scroll-e2e/build.mjs (real-converter live-scroll E2E harness)
scripts/scroll-e2e/harness.iife.js
