node_modules/
dist/
build/
coverage/
.tsbuildinfo
*.tsbuildinfo

# Astro's build-cache dir — auto-generated by `astro check` at the
# cwd it's run from (per-workspace expected, but a root invocation
# leaves a stray copy at the repo root).
.astro/

# Env
.env
.env.*
!.env.example

# V-278 deploy .env files (REAL secrets; never committed). The
# .template versions ARE committed.
/infra/env-templates/*.env
!/infra/env-templates/*.env.template

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Bench artifacts (V-165) — bench output is recorded per-run; only
# the canonical baseline at docs/benchmarks/baseline.ci.json is
# committed.
tmp/

# Drizzle
drizzle/.migrations-applied

# Python SDK
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
packages/sdk-python/dist/
.npmrc

# GUI client (Tauri)
apps/gui-client/dist/
apps/gui-client/src-tauri/target/
apps/gui-client/src-tauri/gen/
# Cargo.lock SHOULD be committed for binaries (Tauri app is a binary).

# Generated by scripts/scroll-e2e/build.mjs (real-converter live-scroll E2E harness)
scripts/scroll-e2e/harness.iife.js

# Ad-hoc local canary/test scripts (e.g. the BUG-42 NodeMaven canary) — not committed
scripts/.*-canary.mjs

# The internal ledger is NOT tracked here. `driftstack-api` is PUBLIC; the ledger
# carries open findings, decision rationale and where the guards are weak, and it
# lives in the private repository with the rest of the internal notes. This entry
# keeps it from being re-added here by accident.
docs/internal/OPEN-ITEMS.md

# Per-developer tool configuration and local instruction files — never tracked.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/

# V-2169 — the release workflow ditto's the built companion here so the main
# bundle can embed it in Contents/Resources. CI-only staging: a 200MB .app must
# never reach a commit.
apps/gui-client/src-tauri/Driftstack Simulator.app/
apps/gui-client/src-tauri/Driftstack Simulator.app.zip

# The design tokens COMMIT their generated outputs (CSS, the Tailwind preset and
# theme, hex constants): no deploy workflow runs a build step, and a reviewer sees
# the exact CSS a token change ships. `node packages/design-tokens/build.mjs --check`
# (in `npm run lint`) keeps them in step with tokens.json. Re-includes the one
# dist/ the `dist/` rule above would otherwise hide.
!packages/design-tokens/dist/
