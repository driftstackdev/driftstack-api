node_modules/
dist/
build/
coverage/
.tsbuildinfo
*.tsbuildinfo

# Astro's build-cache dir — auto-generated by `astro check` at the
# cwd it's run from (per-workspace expected, but a root invocation
# leaves a stray copy at the repo root).
.astro/

# Env
.env
.env.*
!.env.example

# V-278 deploy .env files (REAL secrets; never committed). The
# .template versions ARE committed.
/infra/env-templates/*.env
!/infra/env-templates/*.env.template

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Bench artifacts (V-165) — bench output is recorded per-run; only
# the canonical baseline at docs/benchmarks/baseline.ci.json is
# committed.
tmp/

# Drizzle
drizzle/.migrations-applied

# Python SDK
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
packages/sdk-python/dist/
.npmrc

# GUI client (Tauri)
apps/gui-client/dist/
apps/gui-client/src-tauri/target/
apps/gui-client/src-tauri/gen/
# Cargo.lock SHOULD be committed for binaries (Tauri app is a binary).

# Generated by scripts/scroll-e2e/build.mjs (real-converter live-scroll E2E harness)
scripts/scroll-e2e/harness.iife.js

# Cross-agent ad-hoc canary/test scripts (e.g. A3 BUG-42 NodeMaven canary) — not committed
scripts/.*-canary.mjs

# ⛔ The internal ledger is NOT tracked here. `driftstack-api` is PUBLIC, and this
# file is the one piece of P-1's move-set that had not yet reached origin — it
# carries open findings, decision rationale and where the guards are weak. It
# lives in the PRIVATE repo at `driftstack/docs/internal/OPEN-ITEMS.md`, which
# both agents can now read and write.
#
# ⚠️ The other 242 `docs/internal` files, CLAUDE.md, AGENTS.md and the
# verification log are ALREADY on origin. Moving them now removes them from the
# tip and not from history, which the owner's "scrub files, keep git history"
# decision accepted. So this entry is the only one with preventive value; the
# rest is hygiene.
docs/internal/OPEN-ITEMS.md

# V-2169 — the release workflow ditto's the built companion here so the main
# bundle can embed it in Contents/Resources. CI-only staging: a 200MB .app must
# never reach a commit.
apps/gui-client/src-tauri/Driftstack Simulator.app/
apps/gui-client/src-tauri/Driftstack Simulator.app.zip
