{
  "name": "@driftstack/sdk",
  "version": "0.1.3",
  "description": "Official TypeScript SDK for the Driftstack API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@driftstack/api-types": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driftstackdev/driftstack-api.git",
    "directory": "packages/sdk-typescript"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "driftstack",
    "iphone",
    "safari",
    "automation",
    "stealth",
    "browser"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
