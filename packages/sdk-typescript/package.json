{
  "name": "@driftstack/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for the Driftstack API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/sdk-typescript-harden-sourcemaps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driftstackdev/driftstack-api.git",
    "directory": "packages/sdk-typescript"
  },
  "devDependencies": {
    "@driftstack/api-types": "*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "driftstack",
    "iphone",
    "safari",
    "automation",
    "stealth",
    "browser"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
