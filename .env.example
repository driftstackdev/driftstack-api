# Driftstack API — example env. Copy to .env for local dev.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
HOST=0.0.0.0

# Postgres (matches docker-compose service)
DATABASE_URL=postgres://driftstack:driftstack@localhost:5432/driftstack

# Redis (matches docker-compose service)
REDIS_URL=redis://localhost:6379

# Driver selection: "mock" (dev/test) or "webkit" (production; not yet implemented)
DRIVER=mock

# Mock driver behaviour tuning (ms)
MOCK_NAVIGATE_LATENCY_MS=120
MOCK_INTERACT_LATENCY_MS=40

# V-079 / V-079.C — auth-flow deep-link URLs (emailed to users).
# Paths match the customer-dashboard's actual file-based routes;
# the previous `/auth/<flow>` paths (in this file's git history)
# landed on 404s — fix landed 2026-05-12 when Postmark approval hit
# the first real customer's verify email.
#
# Default-driven path: leave these UNSET and set DASHBOARD_ORIGIN
# instead — `deriveAuthFlowUrls()` builds the 3 URLs from
# `${DASHBOARD_ORIGIN}/<canonical path>` automatically. Set the
# per-URL overrides only if your dashboard uses non-standard paths.
#
# AUTH_VERIFY_EMAIL_URL=http://localhost:5173/verify-email
# AUTH_MAGIC_LINK_URL=http://localhost:5173/auth/magic-link
# AUTH_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# AUTH_EXPOSE_DEBUG_TOKEN — dev/test only. When true, signup / magic-link /
# password-reset responses include a `debug_token` plaintext field so dev
# scripts (scripts/dev-bootstrap.sh) can complete the flow without a
# wired email service. Production MUST leave this false.
AUTH_EXPOSE_DEBUG_TOKEN=true

# V-266 — origin of the customer dashboard. Used to build the browser_url
# returned by /v1/auth/cli-authorize/initiate (browser-OAuth-style GUI
# activation). Override per environment.
DASHBOARD_ORIGIN=http://localhost:5173

# ── Checkout redirect URLs (optional; sensible defaults apply) ──────────────
# Where the payment provider returns the customer after a Stripe or crypto
# checkout. These are CUSTOMER-VISIBLE: an unset or wrong value sends a paying
# customer somewhere unexpected immediately after payment, which is the worst
# moment to do so. Set them per environment.
STRIPE_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?checkout=cancelled
# Where Stripe's billing portal returns the customer when they click "back".
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing
NOWPAYMENTS_SUCCESS_URL=http://localhost:5173/billing?crypto=success
NOWPAYMENTS_CANCEL_URL=http://localhost:5173/billing?crypto=cancelled

# ── Abuse protection (optional) ────────────────────────────────────────────
# Requests per minute per source IP across all authenticated /v1/* routes.
# Set to 0 to disable the gate entirely — only sensible in local development,
# never in an internet-facing deployment.
GLOBAL_IP_RATE_LIMIT_PER_MIN=600

# ── Diagnostics (optional) ─────────────────────────────────────────────────
# Log any database query slower than this many milliseconds. Unset disables
# slow-query logging.
SLOW_QUERY_LOG_THRESHOLD_MS=250

# ── Default egress (operator default for sessions with no proxy_id) ────
# UNSET IS VALID AND DELIBERATE. Omitted -> a dispatched session carries no
# proxy, and a REQUIRE_PROXY=1 fleet node refuses it by name
# (no_proxy_configured) instead of routing it into an address nothing listens
# on. This exists in env because the previous SOURCE constant (127.0.0.1:1080,
# a local fleet-demo value) became the live production default and pointed
# every default session at a dead loopback, presenting as an unexplained
# freeze. HOST and PORT must BOTH be set to enable; USERNAME/PASSWORD only if
# the proxy authenticates.
DEFAULT_EGRESS_HOST=
DEFAULT_EGRESS_PORT=
DEFAULT_EGRESS_USERNAME=
DEFAULT_EGRESS_PASSWORD=
