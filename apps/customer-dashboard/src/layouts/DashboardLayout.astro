---
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** When true, render the side-nav. Onboarding pages opt out. */
  withSidebar?: boolean;
}

const {
  title,
  description = 'Driftstack — manage your account, API keys, and billing.',
  withSidebar = true,
} = Astro.props;

const fullTitle = `${title} · Driftstack`;
const pathname = Astro.url.pathname;

// V-331 — backend API base URL surfaced to the inline "act as" picker
// script. Per existing pages: localStorage uses `ds_web_session_token`
// for the bearer (V-141), and we add `ds_act_as_account` for the
// optional team-owner override.
import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

// 2026-07-02 — account-portal IA (dashboard redesign slice 2): the
// operational surfaces (profiles / snapshots / sessions / agent
// sessions / recipes / proxies) belong to the desktop GUI; the web
// dashboard is the account portal. Nav groups into 3 sections
// (General / Developers / Account) with an inline-SVG icon per item.
// Iconography stays Driftstack-native (Lucide-shape 14px stroke).
// No JS-hydration required for icons.
// `badgeKey` ties a nav item to a count slot the inline
// account-me-hydration script fills in (Team N).
// Items without a badgeKey just have a label.
type BadgeKey = 'team';
type NavItem = { href: string; label: string; icon: string; badgeKey?: BadgeKey };
type NavSection = { label: string; items: NavItem[] };

const ICON = {
  home: 'M3 8.5 8 4l5 4.5V13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z',
  layers:
    'M8 2 1.5 5.25 8 8.5l6.5-3.25Z M1.5 8 8 11.25 14.5 8 M1.5 10.75 8 14l6.5-3.25',
  film: 'M2.25 2.25h11.5v11.5h-11.5z M2.25 5.5h11.5 M2.25 10.5h11.5 M5.5 2.25v11.5 M10.5 2.25v11.5',
  activity: 'M1.5 8h2.75l1.5-4.5 3 9 1.5-4.5h4.25',
  agent: 'M3 6.75a3.25 3.25 0 1 1 6.5 0 3.25 3.25 0 0 1-6.5 0Z M12.5 11.75c-.4-1.9-1.9-3-4-3s-3.6 1.1-4 3 M12.25 4.25l1.25 1.25-1.25 1.25 M13.5 5.5h-2',
  key: 'M9.5 8.5a3.25 3.25 0 1 1 0-1l3.5 3.5-1.5 1.5-1-1-1 1-1-1-1 1Z',
  globe:
    'M8 13.75A5.75 5.75 0 1 0 8 2.25 5.75 5.75 0 0 0 8 13.75Z M2.25 8h11.5 M8 2.25c1.7 2 2.5 4 2.5 5.75S9.7 12 8 13.75 5.5 9.75 5.5 8 6.3 4.25 8 2.25Z',
  chart: 'M2 13h12 M3.5 11.5V8 M6.5 11.5V5 M9.5 11.5V7 M12.5 11.5V3',
  card: 'M2 4.5h12v7h-12z M2 7h12',
  receipt:
    'M3.25 2.25h9.5v11.5l-1.75-1-1.75 1-1.5-1-1.5 1-1.5-1-1.5 1Z M5.5 5.5h5 M5.5 8h5 M5.5 10.5h3',
  webhook:
    'M5.25 4.5a2.75 2.75 0 1 1 5.5 0c0 1.3-.85 2.4-2 2.7L5.5 12 M3.25 8.75a2.75 2.75 0 0 0 2.5 4 2.75 2.75 0 0 0 2.4-1.5h4.6 M10.75 12a2.75 2.75 0 1 1-4.85-1.8',
  list: 'M4.5 4.25h8 M4.5 8h8 M4.5 11.75h8',
  bookmark: 'M4 2.5h8v11l-4-2.5-4 2.5Z',
  users:
    'M6 6a2.25 2.25 0 1 1 0-4.5 2.25 2.25 0 0 1 0 4.5Z M2 13c.5-2 2-3 4-3s3.5 1 4 3 M10.75 4.25a2 2 0 0 1 0 3.5 M13.5 12.75c-.25-1.5-1-2.25-2.25-2.75',
  shield: 'M8 1.75l5.25 2.25v3.5c0 3.4-2.25 6-5.25 7.5-3-1.5-5.25-4.1-5.25-7.5V4z M5.75 8l1.5 1.5 3-3',
  cog: 'M8 6.25a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5Z M8 1.75v1.5 M8 12.75v1.5 M3.75 3.75l1 1 M11.25 11.25l1 1 M1.75 8h1.5 M12.75 8h1.5 M3.75 12.25l1-1 M11.25 4.75l1-1',
};

const navSections: NavSection[] = [
  {
    label: 'General',
    items: [{ href: '/', label: 'Overview', icon: ICON.home }],
  },
  {
    label: 'Developers',
    items: [
      { href: '/api-keys', label: 'API keys', icon: ICON.key },
      { href: '/webhooks', label: 'Webhooks', icon: ICON.webhook },
    ],
  },
  {
    label: 'Account',
    items: [
      { href: '/usage', label: 'Usage', icon: ICON.chart },
      { href: '/billing', label: 'Billing', icon: ICON.card },
      { href: '/audit-log', label: 'Audit log', icon: ICON.list },
      { href: '/team', label: 'Team', icon: ICON.users, badgeKey: 'team' },
      { href: '/security', label: 'Privacy & security', icon: ICON.shield },
      { href: '/settings', label: 'Settings', icon: ICON.cog },
    ],
  },
];
---

<!doctype html>
<html lang="en" data-mode="dark" data-accent="oxblood">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060608" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=4" />
    <link
      rel="preload"
      href="/fonts/geist/GeistVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      {
        /*
         * Fleet v2 (2026-07-02) — theme persistence, pre-paint. Applies the
         * customer's saved mode/accent BEFORE first paint so there is no
         * flash of the default theme. Values are WHITELISTED — never write
         * raw localStorage into a DOM attribute. The defaults (dark +
         * oxblood, founder-locked 2026-07-02) live on the <html> attrs;
         * the themer pill (wired at body end) writes ds_theme_mode /
         * ds_theme_accent. Runs on BOTH layout branches so auth pages
         * honour the saved theme too.
         *
         * NOTE: plain code in a brace-comment block, NOT the {`…`}
         * template-literal wrapper — Astro emits that wrapper literally,
         * which turns the whole script into a no-op string expression in
         * the browser (the 2026-07-02 dead-inline-script bug class).
         */
      }
      (function () {
        try {
          var m = localStorage.getItem('ds_theme_mode');
          var a = localStorage.getItem('ds_theme_accent');
          if (m === 'light' || m === 'dark') {
            document.documentElement.setAttribute('data-mode', m);
          }
          if (a === 'violet' || a === 'oxblood' || a === 'teal') {
            document.documentElement.setAttribute('data-accent', a);
          }
          if (m === 'light') {
            var mt = document.querySelector('meta[name="theme-color"]');
            if (mt) mt.setAttribute('content', '#f2f3f6');
          }
        } catch (_) {
          /* default theme */
        }
      })();
    </script>
    <script is:inline data-act-as-header-preflight>
      // The account-scoping helper must exist before <slot /> parses. Slotted
      // page scripts synchronously capture it before starting their first
      // request; defining it with the picker hydration at body-end silently
      // made those requests self-scoped on every fresh page load.
      (function () {
        var OWNER_ACCOUNT_ID_RE =
          /^acc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
        var authorityResolved = false;
        var verifiedOwner = '';

        function readCanonicalStoredOwner() {
          try {
            var value = localStorage.getItem('ds_act_as_account') || '';
            if (!value) return '';
            if (!OWNER_ACCOUNT_ID_RE.test(value)) {
              localStorage.removeItem('ds_act_as_account');
              return '';
            }
            return value;
          } catch (_) {
            return '';
          }
        }
        var provisionalOwner = readCanonicalStoredOwner();

        function actAsHeaders() {
          if (authorityResolved) {
            return verifiedOwner ? { 'x-driftstack-account': verifiedOwner } : {};
          }
          return provisionalOwner ? { 'x-driftstack-account': provisionalOwner } : {};
        }

        // Body-end hydration calls this only after a successful, structurally
        // valid /account/me response. Once resolved, forced localStorage edits
        // cannot switch a live page to an owner it did not render for.
        actAsHeaders.setVerifiedOwner = function (owner) {
          authorityResolved = true;
          verifiedOwner = OWNER_ACCOUNT_ID_RE.test(owner || '') ? owner : '';
        };

        window.driftstackActAsHeaders = actAsHeaders;
      })();
    </script>
    <style>
      /* 2026-05-21 — when the pre-paint script confirms the cached
       * `ds_is_team_user` flag, override the picker wrap's default
       * `display:none` (`.hidden`) so the slot takes layout space but
       * stays invisible. JS removes the reserved attribute once
       * /v1/account/me confirms teams[] and reveals the picker.
       * Non-team users never set the flag, so the wrap stays display:none. */
      html[data-pre-team-user='true'] [data-act-as-picker-wrap-reserved] {
        display: block;
        visibility: hidden;
      }
      /* 2026-05-21 — mobile-nav reveal. Default state is `hidden md:block`
       * (collapsed on mobile, side-rail on tablet+). When the hamburger
       * sets `data-mobile-nav-open` on <html>, the aside drops to
       * fullscreen overlay so the customer can still reach Sign out,
       * navigation, and the SSO bridge from a phone. */
      html[data-mobile-nav-open='true'] [data-mobile-nav] {
        display: block;
        position: fixed;
        inset: 56px 0 0 0;
        width: 100%;
        z-index: 30;
        overflow-y: auto;
      }
    </style>
    {
      withSidebar && (
        <script is:inline>
            // 2026-05-21 — login gate. The signed-in dashboard pages should
            // never render to a non-authenticated visitor — that exposed a
            // flash of scaffolding mock data on every page load. This runs
            // BEFORE the body parses (in <head>), so the redirect happens
            // pre-paint. Onboarding / auth pages opt out by setting
            // withSidebar={false} (this script isn't emitted on those).
            //
            // Same script also sets data-pre-team-user on <html> when the
            // cached ds_is_team_user flag is present, so the acting-as
            // picker can pre-reserve layout space (avoids vertical shift
            // when the picker reveals post-hydration on team accounts).
            (function () {
              try {
                var t = localStorage.getItem('ds_web_session_token');
                // 2026-05-21 — handle the admin bounce: if a staff member
                // landed on admin.driftstack.dev with no token, the admin
                // layout redirects here with ?next-admin=<path>. If we
                // already have a session token, bounce them back with
                // the token in the URL hash. Falls through to the normal
                // /login redirect when there's no token yet — login.astro
                // honours ?next= and will land back here, where this
                // block re-runs and forwards on to admin.
                var qs = new URLSearchParams(location.search);
                var nextAdmin = qs.get('next-admin');
                if (nextAdmin && t && t.length > 0) {
                  // 2026-05-21 — preserve any query string already on the
                  // admin path. URL parses + reassembles so a nextAdmin
                  // like "/accounts/abc?filter=x" doesn't end up with the
                  // broken "?filter=x?bounced=1" double-question.
                  var u = new URL(
                    'https://admin.driftstack.dev' + nextAdmin,
                  );
                  // 2026-06-03 — origin guard. nextAdmin is an attacker-
                  // controllable query param (?next-admin=); a value like
                  // ".evil.com/" or "@evil.com/" parses to a NON-admin host
                  // (admin.driftstack.dev.evil.com / evil.com), which would
                  // exfiltrate the session token via the #token= hash below
                  // → account takeover. Only ever hand the token to the real
                  // admin origin; on any host escape, fall back to admin root
                  // (drops the attacker-controlled path). Same intent as
                  // lib/safe-next.ts (which this is:inline block can't import).
                  if (u.origin !== 'https://admin.driftstack.dev') {
                    u = new URL('https://admin.driftstack.dev/');
                  }
                  u.searchParams.set('bounced', '1');
                  u.hash = '#token=' + encodeURIComponent(t);
                  location.replace(u.toString());
                  return;
                }
                if (nextAdmin && (!t || t.length === 0)) {
                  // Carry the next-admin intent through /login as a
                  // doubly-encoded ?next= round-trip.
                  var loginNext = '/?next-admin=' + encodeURIComponent(nextAdmin);
                  location.replace('/login/?next=' + encodeURIComponent(loginNext));
                  return;
                }
                if (!t || t.length === 0) {
                  var here = location.pathname + location.search;
                  location.replace('/login/?next=' + encodeURIComponent(here));
                  return;
                }
                if (localStorage.getItem('ds_is_team_user') === '1') {
                  document.documentElement.setAttribute('data-pre-team-user', 'true');
                }
              } catch (_) {
                location.replace('/login/');
              }
            })();
        </script>
      )
    }
    <script is:inline data-dashboard-fetch-deadline>
      // Installed before every slotted page script so dashboard transport
      // deadlines cover response decoding, not only response headers.
      (function () {
        window.driftstackRequestErrorMessage = function (err, fallback) {
          var name = err && typeof err.name === 'string' ? err.name : '';
          var message = err && typeof err.message === 'string' ? err.message.trim() : '';
          var normalized = (name + ' ' + message).toLowerCase();
          if (/abort|timed? out|timeout/.test(normalized)) {
            return 'Request timed out. Check your connection and try again.';
          }
          if (
            /failed to fetch|fetch failed|network(?:error| request)?|load failed|offline|internet|connection (?:failed|lost|refused)|dns|econn|getaddrinfo/.test(
              normalized,
            )
          ) {
            return 'Check your connection and try again.';
          }
          var statusMatch = message.match(/^HTTP\s+(\d{3})$/i);
          if (statusMatch) {
            var status = Number(statusMatch[1]);
            if (status === 401 || status === 403) {
              return 'Your sign-in has expired. Sign in again and retry.';
            }
            if (status === 429) return 'Too many attempts. Wait a moment and try again.';
            if (status >= 500) return 'The service is temporarily unavailable. Try again shortly.';
            return fallback;
          }
          if (err && err.customerSafe === true && message) return message;
          return fallback;
        };
        window.driftstackResponseError = function (response, body) {
          var prefix = 'https://errors.driftstack.dev/';
          var type = body && typeof body.type === 'string' ? body.type : '';
          var kind = type.indexOf(prefix) === 0 ? type.slice(prefix.length) : '';
          var exact = {
            'email-already-registered': 'An account with this email already exists. Sign in instead.',
            'email-not-verified': 'Verify your email address before signing in.',
            'invalid-credentials': 'The email or password was not accepted.',
            'invalid-auth-token': 'This link is invalid, expired, or already used.',
            'legal-acceptance-required': 'Review and accept the required terms before continuing.',
            'mfa-step-up-required': 'Confirm this action with a fresh authenticator code.',
            'profile-in-use': 'End the profile’s other live session before launching it again.',
            'proxy-validation-failed': 'The proxy could not be verified. Check its details and try again.',
            'storage-quota-exceeded': 'Profile storage is full. Trim or delete a profile, then try again.',
            'byok-anthropic-required': 'Connect your AI provider key in Settings, then try again.',
            'bundled-llm-consent-required': 'Enable bundled AI in Settings or connect your own provider key.',
            'bundled-llm-budget-exhausted': 'Your monthly AI budget has been reached. Review it in Settings.',
          };
          var message = Object.prototype.hasOwnProperty.call(exact, kind) ? exact[kind] : '';
          if (!message && kind === 'unauthorized') {
            message = 'Your sign-in could not be verified. Check your details and try again.';
          }
          if (!message && ['invalid-key', 'revoked-key', 'expired-key'].indexOf(kind) !== -1) {
            message = 'Your sign-in has expired. Sign in again and retry.';
          }
          if (!message && ['rate-limited', 'concurrency-limit', 'tier-limit'].indexOf(kind) !== -1) {
            message = 'A usage limit was reached. Wait a moment or review your plan, then try again.';
          }
          if (!message && ['bad-request', 'validation-failed'].indexOf(kind) !== -1) {
            message = 'Some information was not accepted. Check your input and try again.';
          }
          if (!message && ['conflict', 'pair-mode-conflict', 'pair-mode-invalid-transition'].indexOf(kind) !== -1) {
            message = 'The item changed or is busy. Refresh and try again.';
          }
          if (!message && kind === 'not-found') message = 'The requested item was not found. Refresh and try again.';
          if (!message && kind === 'forbidden') message = 'You do not have permission to perform this action.';
          if (!message && kind === 'session-destroyed') message = 'This session has ended and can no longer be used.';
          if (!message && kind === 'session-timeout') message = 'The session took too long to respond. Try again.';
          if (!message && ['driver-error', 'driver-not-integrated', 'feature-unavailable', 'internal'].indexOf(kind) !== -1) {
            message = 'The service is temporarily unavailable. Try again shortly.';
          }
          if (!message && response.status === 401) message = 'Your sign-in could not be verified. Check your details and try again.';
          if (!message && response.status === 403) message = 'You do not have permission to perform this action.';
          if (!message && response.status === 404) message = 'The requested item was not found. Refresh and try again.';
          if (!message && response.status === 409) message = 'The item changed or is busy. Refresh and try again.';
          if (!message && response.status === 429) message = 'Too many attempts. Wait a moment and try again.';
          if (!message && response.status >= 500) message = 'The service is temporarily unavailable. Try again shortly.';
          if (!message) message = 'The request could not be completed. Check your input and try again.';
          var error = new Error(message);
          error.customerSafe = true;
          if (kind) error.problemType = type;
          return error;
        };
        window.driftstackFetchWithDeadline = function (url, init, timeoutMs, suppliedController) {
          var controller = suppliedController || new AbortController();
          var callerSignal = init && init.signal;
          var forwardAbort = function () {
            controller.abort(callerSignal && callerSignal.reason);
          };
          if (callerSignal && callerSignal !== controller.signal) {
            if (callerSignal.aborted) forwardAbort();
            else callerSignal.addEventListener('abort', forwardAbort, { once: true });
          }
          var timeout = window.setTimeout(function () {
            controller.abort();
          }, timeoutMs);
          var requestInit = Object.assign({}, init || {}, { signal: controller.signal });
          return fetch(url, requestInit).then(
            function (response) {
              var cleared = false;
              function clearDeadline() {
                if (cleared) return;
                cleared = true;
                window.clearTimeout(timeout);
                if (callerSignal && callerSignal !== controller.signal) {
                  callerSignal.removeEventListener('abort', forwardAbort);
                }
              }
              ['arrayBuffer', 'blob', 'formData', 'json', 'text'].forEach(function (method) {
                var read = response[method];
                if (typeof read !== 'function') return;
                response[method] = function () {
                  try {
                    return Promise.resolve(read.apply(response, arguments)).finally(clearDeadline);
                  } catch (error) {
                    clearDeadline();
                    throw error;
                  }
                };
              });
              if (!response.body) clearDeadline();
              return response;
            },
            function (error) {
              window.clearTimeout(timeout);
              if (callerSignal && callerSignal !== controller.signal) {
                callerSignal.removeEventListener('abort', forwardAbort);
              }
              throw error;
            },
          );
        };
        window.driftstackTrustedRedirectUrl = function (value, allowedOrigins) {
          if (typeof value !== 'string' || !Array.isArray(allowedOrigins)) return null;
          try {
            var parsed = new URL(value);
            if (parsed.protocol !== 'https:' || parsed.username || parsed.password) return null;
            return allowedOrigins.indexOf(parsed.origin) !== -1 ? parsed.toString() : null;
          } catch (_) {
            return null;
          }
        };
        window.driftstackWriteClipboard = function (value) {
          if (typeof value !== 'string') {
            return Promise.reject(new Error('clipboard value must be a string'));
          }
          try {
            if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
              return Promise.reject(new Error('clipboard unavailable'));
            }
            return Promise.resolve(navigator.clipboard.writeText(value));
          } catch (error) {
            return Promise.reject(error);
          }
        };
      })();
    </script>
  </head>
  <body class="relative">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR users skip the sidebar nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-tk-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to main content
    </a>
    {/*
      V-219* — brand alignment with marketing site:
        - Sidebar header: L2 brand mark (driftstack-mark.svg) + the W2
          DRIFTSTACK black-italic two-tone wordmark, matching
          apps/marketing-site/src/components/Header.astro (Fleet rebrand).
        - withSidebar={false} branch: minimal horizontal header so onboarding
          pages have brand presence (Gap 2 from the V-219* audit) +
          ambient radial-glow background so the auth surfaces feel cohesive
          with the marketing landing.
        - Footer (signed-in dashboard) with legal-doc links (Gap 7).
    */}

    {/* Ambient background — only visible when withSidebar is false (auth +
        onboarding pages). The sidebar pages have plenty of UI chrome so the
        ambient glow would be visually noisy. */}
    {!withSidebar && (
      <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
        <div class="absolute inset-x-0 top-0 h-[600px] bg-glow-radial-accent" />
        <div class="absolute inset-x-0 bottom-0 h-[400px] bg-glow-radial-accent-soft" />
      </div>
    )}

    <div class="flex min-h-screen flex-col">
      {
        !withSidebar && (
          <header class="border-b border-tk-border bg-tk-bg">
            <div class="mx-auto flex max-w-6xl items-center px-6 py-4">
              <a
                href="/"
                class="group flex items-center gap-2.5 font-mono text-base font-semibold text-tk-ink"
              >
                <img
                  src="/driftstack-mark.svg?v=4"
                  alt="Driftstack"
                  width="32"
                  height="32"
                  class="inline-block h-8 w-8 transition-transform duration-300 group-hover:scale-110"
                />
                <span class="font-sans font-black italic tracking-tight">DRIFT<span class="text-tk-accent-text">STACK</span></span>
              </a>
              <span class="flex-1" />
              {/* Fleet v2 — theme switcher on auth/onboarding pages (the
                  signed-in shell carries its own instance in the sidebar).
                  Wired by the [data-themer] script at body end. */}
              <div data-themer class="themer" role="group" aria-label="Theme">
                <button type="button" class="themer-btn" data-set-mode="dark">
                  Dark
                </button>
                <button type="button" class="themer-btn" data-set-mode="light">
                  Light
                </button>
                <span class="themer-divider" aria-hidden="true" />
                <button
                  type="button"
                  class="themer-swatch"
                  data-set-accent="oxblood"
                  style="background:#9b3b46"
                  aria-label="Oxblood accent"
                />
                <button
                  type="button"
                  class="themer-swatch"
                  data-set-accent="violet"
                  style="background:#6d5efc"
                  aria-label="Violet accent"
                />
                <button
                  type="button"
                  class="themer-swatch"
                  data-set-accent="teal"
                  style="background:#109a82"
                  aria-label="Teal accent"
                />
              </div>
            </div>
          </header>
        )
      }
      {/* 2026-05-21 — mobile header for signed-in pages (md:hidden).
          The sidebar lives on the side at md+; on mobile the
