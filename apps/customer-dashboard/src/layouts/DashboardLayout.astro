            type="text"
            data-ds-prompt-input
            aria-label="Response"
            class="mt-4 w-full rounded-lg border border-tk-border bg-tk-bg px-3 py-2 text-sm text-tk-ink placeholder:text-tk-ink-3 focus:border-tk-accent focus:outline-none"
          />
          <div class="mt-6 flex justify-end gap-3">
            <button
              type="button"
              data-ds-prompt-cancel
              class="rounded-lg border border-tk-border px-4 py-2 text-sm text-tk-ink-2 hover:text-tk-ink"
              >Cancel</button
            >
            <button
              type="button"
              data-ds-prompt-ok
              class="rounded-lg bg-tk-accent px-4 py-2 text-sm font-medium text-white hover:bg-tk-accent/90"
              >OK</button
            >
          </div>
        </div>
      </div>
      <script is:inline>
          // 2026-05-29 — window.driftstackPrompt(message, opts?) → Promise<string|null>.
          // Branded replacement for native window.prompt(). Resolves the
          // input string on OK / Enter, or null on Cancel / Escape. opts:
          // defaultValue, placeholder, confirmLabel. Falls back to native
          // prompt only if the modal markup is absent (defensive).
          // NOTE: plain code, NOT the {`…`} template-literal wrapper — Astro
          // emits that wrapper literally, which made this whole script a
          // no-op string in the browser (window.driftstackPrompt was
          // undefined in production until the 2026-07-02 fix).
          (function () {
            if (typeof window.__driftstackModalOpen !== 'boolean') {
              window.__driftstackModalOpen = false;
            }
            window.driftstackPrompt = function (message, opts) {
              return new Promise(function (resolve) {
                var overlay = document.querySelector('[data-ds-prompt]');
                if (!overlay) {
                  resolve(window.prompt(message, (opts && opts.defaultValue) || ''));
                  return;
                }
                if (window.__driftstackModalOpen) {
                  resolve(null);
                  return;
                }
                window.__driftstackModalOpen = true;
                var msg = overlay.querySelector('[data-ds-prompt-message]');
                var input = overlay.querySelector('[data-ds-prompt-input]');
                var ok = overlay.querySelector('[data-ds-prompt-ok]');
                var cancel = overlay.querySelector('[data-ds-prompt-cancel]');
                if (msg) msg.textContent = message;
                if (ok) ok.textContent = (opts && opts.confirmLabel) || 'OK';
                if (input) {
                  input.value = (opts && opts.defaultValue) || '';
                  input.setAttribute('placeholder', (opts && opts.placeholder) || '');
                }
                // Remember the trigger so focus returns there on close.
                var prevFocus = document.activeElement;
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                if (input && input.focus) {
                  input.focus();
