          }

          function renderRequiredLegal(docs) {
            list.textContent = '';
            docs.forEach(function (doc) {
              const li = document.createElement('li');
              li.className = 'flex items-center gap-2';
              const dot = document.createElement('span');
              dot.className = 'inline-block size-1.5 rounded-full bg-tk-accent';
              const a = document.createElement('a');
              const slug = DOC_URL_SLUG[doc.document_key] || doc.document_key;
              a.href = 'https://driftstack.dev/legal/' + slug + '/';
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              a.className =
                'text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2';
              a.textContent = DOC_LABEL[doc.document_key] || doc.title || doc.document_key;
              const ver = document.createElement('span');
              ver.className = 'text-xs text-tk-ink-3';
              ver.textContent = '(v' + doc.current_version + ')';
              li.append(dot, a, ver);
              list.append(li);
            });
          }

          function finishLegalAcceptance() {
            statusEl.textContent = 'Accepted — reloading…';
            acceptAllBtn.disabled = true;
            setTimeout(function () {
              window.location.reload();
            }, 400);
          }

          function showLegalCheckFailure() {
            required = [];
            checkOnly = true;
            reloadOnly = false;
            list.textContent = '';
            banner.classList.remove('hidden');
            acceptAllBtn.disabled = false;
            acceptAllBtn.textContent = 'Retry agreement check';
            acceptAllBtn.title = 'Check required agreements without recording acceptance';
            statusEl.textContent =
              'Could not check whether updated agreements are required. Retry this check before creating API keys or sessions.';
          }

          function applyRequiredLegal(pending) {
            required = pending;
            checkOnly = false;
            reloadOnly = false;
            acceptAllBtn.removeAttribute('title');
            if (required.length === 0) {
              banner.classList.add('hidden');
              statusEl.textContent = '';
              return;
            }
            renderRequiredLegal(required);
            banner.classList.remove('hidden');
            acceptAllBtn.disabled = false;
            acceptAllBtn.textContent = 'Accept all and continue';
            statusEl.textContent = '';
          }

          function requireLegalReload() {
            reloadOnly = true;
            acceptAllBtn.disabled = false;
            acceptAllBtn.textContent = 'Reload to verify';
            acceptAllBtn.title = 'Reload before sending any acceptance again';
            statusEl.textContent =
              'Acceptance outcome is unknown. Reload to check what remains before retrying.';
          }

          function reconcileLegalAcceptance(attempted) {
            return fetchRequiredLegal()
              .then(function (pending) {
                required = pending;
                if (required.length === 0) {
                  finishLegalAcceptance();
                  return;
                }
                const pendingKeys = new Set(
                  required.map(function (doc) {
                    return doc.document_key;
                  }),
                );
                const recordedCount = attempted.filter(function (doc) {
                  return !pendingKeys.has(doc.document_key);
                }).length;
                renderRequiredLegal(required);
                acceptAllBtn.disabled = false;
                acceptAllBtn.textContent = 'Accept remaining and continue';
                statusEl.textContent =
                  recordedCount > 0
                    ? recordedCount +
                      ' accepted; ' +
                      required.length +
                      (required.length === 1
                        ? ' document still requires acceptance. '
                        : ' documents still require acceptance. ') +
                      'Only the remaining documents will be sent.'
                    : 'No acceptance was confirmed. Review the remaining documents before retrying.';
              })
              .catch(function () {
                requireLegalReload();
              });
          }

          acceptAllBtn.addEventListener('click', function () {
            if (reloadOnly) {
              window.location.reload();
              return;
            }
            if (checkOnly) {
              acceptAllBtn.disabled = true;
              statusEl.textContent = 'Checking required agreements…';
              fetchRequiredLegal().then(applyRequiredLegal).catch(showLegalCheckFailure);
              return;
            }
            const attempted = required.slice();
            if (attempted.length === 0) return;
            acceptAllBtn.disabled = true;
            acceptAllBtn.removeAttribute('title');
            statusEl.textContent = 'Recording acceptance…';
            // 2026-05-20 — /v1/legal/accept REQUIRES content_hash
            // (64-char SHA-256 hex); GET /v1/legal/required already
            // includes it on each entry so pass it through.
            Promise.allSettled(
              attempted.map(function (doc) {
                return fetchLegalWithDeadline(apiBaseUrl + '/v1/legal/accept', {
                  method: 'POST',
                  headers: headers,
                  body: JSON.stringify({
                    document_key: doc.document_key,
                    version: doc.current_version,
                    content_hash: doc.content_hash,
                  }),
                });
              }),
            ).then(function (results) {
              const allOk = results.every(function (result) {
                return result.status === 'fulfilled' && result.value.ok;
              });
              if (allOk) {
                finishLegalAcceptance();
                return;
              }
              return reconcileLegalAcceptance(attempted);
            });
          });

          fetchRequiredLegal()
            .then(applyRequiredLegal)
            .catch(showLegalCheckFailure);
        })();
      </script>
      <footer class="border-t border-tk-border bg-tk-bg">
        <div
          class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-4 text-xs text-tk-ink-3"
        >
          <span>Driftstack</span>
          {/* W211 — these pages live on the marketing-site at
              driftstack.dev, not on the dashboard's own
              app.driftstack.dev origin. Absolute URLs are required;
              relative paths would 404 against the Cloudflare Pages
              project that serves the dashboard. */}
          <nav class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <a href="https://driftstack.dev/legal/privacy/" class="hover:text-tk-accent-text">Privacy</a>
            <a href="https://driftstack.dev/legal/terms/" class="hover:text-tk-accent-text">Terms</a>
            <a href="https://driftstack.dev/legal/dpa/" class="hover:text-tk-accent-text">DPA</a>
            <a href="https://driftstack.dev/legal/aup/" class="hover:text-tk-accent-text">AUP</a>
            <a href="https://driftstack.dev/trust/sub-processors/" class="hover:text-tk-accent-text"
              >Sub-processors</a
            >
          </nav>
        </div>
      </footer>
    </div>
    <script is:inline>
      {
        /*
         * 2026-05-21 — page-hydrate reveal. <main> renders with
         * opacity:0 (SSR style attr) so the customer doesn't see any
         * scaffolding-era MOCK_X data flash on first paint. Two reveal
         * triggers, whichever fires first:
         *
         *   1. requestAnimationFrame after DOMContentLoaded — gives
         *      page-specific inline scripts a chance to swap mock
         *      <li> placeholders with real data + populate spans from
         *      /v1/account/me etc.
         *   2. 600ms safety fallback — if a page's inline script
         *      never resolves (network down, API 5xx), the user still
         *      sees the page chrome rather than a perpetually-blank
         *      <main>.
         *
         * Both triggers just clear opacity; the actual data swap is
         * up to each page's existing inline script. Skeleton <li>
         * placeholders on the list pages stay visible during the
         * fetch round-trip.
         */
      }
      (function () {
        var main = document.querySelector('main[data-hydrate="pending"]');
        if (!main) return;
        var revealed = false;
        function reveal() {
          if (revealed) return;
          revealed = true;
          main.style.opacity = '1';
          main.setAttribute('data-hydrate', 'ready');
        }
        // 2026-05-21 — pages call window.dashboardHydrated() after
        // their primary fetch resolves so the reveal waits for real
        // data, not just DOMContentLoaded. The 1200ms safety cap
        // covers pages that haven't been retrofitted + pages whose
        // network is genuinely degraded (the customer sees the
        // pre-hydration MOCK data after the cap rather than a
        // perpetually-blank surface).
        window.dashboardHydrated = reveal;
        setTimeout(reveal, 1200);
      })();
    </script>
    <script is:inline define:vars={{ apiBaseUrl }}>
      {
        /*
         * Fleet v2 (slice 4, 2026-07-03) — ⌘K command palette. Signed-in
         * shell only (the markup is gated to withSidebar). Dependency-free:
         * builds a static action list (navigate + quick actions + theme +
         * sign out), filters by label, and runs the selected action.
         * addEventListener-only — inline on* handlers are banned by the
         * dashboard sweep. Uses plain code, NOT the {`…`} wrapper (that
         * ships as a literal no-op string — the 2026-07-02 dead-script bug).
         */
      }
      (function () {
        var overlay = document.querySelector('[data-cmdk]');
        if (!overlay) return;
        var input = overlay.querySelector('[data-cmdk-input]');
        var list = overlay.querySelector('[data-cmdk-list]');
        var commandStatus = document.querySelector('[data-command-status]');
        if (!input || !list || !commandStatus) return;
        var commandStatusTimer = 0;
        var copyAccountInFlight = false;
        var previousFocus = null;

        function showCommandStatus(message) {
          commandStatus.textContent = message;
          commandStatus.classList.remove('hidden');
          if (commandStatusTimer) window.clearTimeout(commandStatusTimer);
          commandStatusTimer = window.setTimeout(function () {
            commandStatus.classList.add('hidden');
          }, 4500);
        }

        function writeClipboard(value) {
          try {
            if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
              return Promise.reject(new Error('clipboard unavailable'));
            }
            return Promise.resolve(navigator.clipboard.writeText(value));
          } catch (error) {
            return Promise.reject(error);
          }
        }

        function copyAccountId() {
          if (copyAccountInFlight) {
            showCommandStatus('Account ID copy is already in progress.');
            return;
          }

          var activeOwnerId = '';
          var token = '';
          try {
            activeOwnerId = localStorage.getItem('ds_act_as_account') || '';
            token = localStorage.getItem('ds_web_session_token') || '';
          } catch (_) {
            /* storage unavailable */
          }

          if (!activeOwnerId && !token) {
            showCommandStatus('Could not copy account ID — sign in again.');
            return;
          }

          copyAccountInFlight = true;
          var controller = new AbortController();
          var timeout = window.setTimeout(function () {
            controller.abort();
          }, 10_000);
          var accountIdPromise = activeOwnerId
            ? Promise.resolve(activeOwnerId)
            : fetch(apiBaseUrl + '/v1/account/me', {
                headers: { authorization: 'Bearer ' + token },
                signal: controller.signal,
              }).then(function (response) {
                if (!response.ok) throw new Error('account lookup failed');
                return response.json().then(function (account) {
                  if (!account || typeof account.id !== 'string' || account.id.length === 0) {
                    throw new Error('account id missing');
                  }
                  return account.id;
                });
              });

          accountIdPromise
            .then(writeClipboard)
            .then(function () {
              showCommandStatus(
                activeOwnerId ? 'Active team account ID copied.' : 'Account ID copied.',
              );
            })
            .catch(function (error) {
              showCommandStatus(
                error && error.name === 'AbortError'
                  ? 'Account ID lookup timed out — try again.'
                  : 'Could not copy account ID — check clipboard permission and try again.',
              );
            })
            .finally(function () {
              window.clearTimeout(timeout);
              copyAccountInFlight = false;
            });
        }

        function nav(href) {
          return function () {
            window.location.href = href;
          };
        }
        function setTheme(kind, value) {
          return function () {
            document.documentElement.setAttribute('data-' + kind, value);
            try {
              localStorage.setItem(kind === 'mode' ? 'ds_theme_mode' : 'ds_theme_accent', value);
            } catch (_) {
              /* session-only */
            }
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta && kind === 'mode') {
              meta.setAttribute('content', value === 'light' ? '#f2f3f6' : '#060608');
            }
          };
        }
        var actions = [
          { label: 'Go to Overview', run: nav('/') },
          { label: 'Go to API keys', run: nav('/api-keys/') },
          { label: 'Go to Webhooks', run: nav('/webhooks/') },
          { label: 'Go to Usage', run: nav('/usage/') },
          { label: 'Go to Billing', run: nav('/billing/') },
          { label: 'Go to Audit log', run: nav('/audit-log/') },
          { label: 'Go to Team', run: nav('/team/') },
          { label: 'Go to Settings', run: nav('/settings/') },
          { label: 'New API key', run: nav('/api-keys/') },
          { label: 'Request desktop app access', run: nav('mailto:support@driftstack.dev?subject=Driftstack%20desktop%20app%20access') },
          {
            label: 'Copy account ID',
            run: copyAccountId,
          },
          { label: 'Theme: Light', run: setTheme('mode', 'light') },
          { label: 'Theme: Dark', run: setTheme('mode', 'dark') },
          { label: 'Accent: Oxblood', run: setTheme('accent', 'oxblood') },
          { label: 'Accent: Violet', run: setTheme('accent', 'violet') },
          { label: 'Accent: Teal', run: setTheme('accent', 'teal') },
          {
            label: 'Sign out',
            run: function () {
              var b = document.querySelector('[data-signout]');
              if (b) b.click();
            },
          },
        ];

        var filtered = actions.slice();
        var active = 0;

        function render() {
          list.innerHTML = '';
          filtered.forEach(function (a, i) {
            var li = document.createElement('li');
            li.textContent = a.label;
            li.id = 'command-palette-option-' + String(i);
            li.setAttribute('role', 'option');
            li.setAttribute('aria-selected', i === active ? 'true' : 'false');
            li.className =
              'cursor-pointer px-4 py-2 text-sm ' +
              (i === active ? 'bg-tk-accent/10 text-tk-accent-text' : 'text-tk-ink-2');
            li.addEventListener('click', function () {
              close();
              a.run();
            });
            li.addEventListener('mousemove', function () {
              active = i;
              render();
            });
            list.appendChild(li);
          });
          input.setAttribute(
            'aria-activedescendant',
            filtered.length > 0 ? 'command-palette-option-' + String(active) : '',
          );
        }
        function applyFilter() {
          var q = input.value.trim().toLowerCase();
          filtered = q
            ? actions.filter(function (a) {
                return a.label.toLowerCase().indexOf(q) !== -1;
              })
            : actions.slice();
          active = 0;
          render();
        }
        function open() {
          previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          overlay.classList.remove('hidden');
          input.setAttribute('aria-expanded', 'true');
          input.value = '';
          applyFilter();
          input.focus();
        }
        function close() {
          overlay.classList.add('hidden');
          input.setAttribute('aria-expanded', 'false');
          input.setAttribute('aria-activedescendant', '');
          if (previousFocus && document.contains(previousFocus)) previousFocus.focus();
          previousFocus = null;
        }

        input.addEventListener('input', applyFilter);
        input.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            active = Math.min(active + 1, filtered.length - 1);
            render();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            active = Math.max(active - 1, 0);
            render();
          } else if (e.key === 'Enter') {
            e.preventDefault();
            var a = filtered[active];
            if (a) {
              close();
              a.run();
            }
          } else if (e.key === 'Escape') {
            close();
          }
        });
        overlay.addEventListener('click', function (e) {
          if (e.target === overlay) close();
        });
        document.addEventListener('keydown', function (e) {
          if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
            e.preventDefault();
            if (overlay.classList.contains('hidden')) open();
            else close();
          }
        });
      })();
    </script>
    <script is:inline>
      {
        /*
         * Fleet v2 (2026-07-02) — themer wiring. Both [data-themer]
         * instances (sidebar foot + auth header) share this handler.
         * Click writes the WHITELISTED value to <html> + localStorage
         * (ds_theme_mode / ds_theme_accent — read back by the pre-paint
         * script in <head>), syncs aria-pressed on every control, and
         * keeps the theme-color meta in step so mobile browser chrome
         * matches the active surface. addEventListener only — inline
         * on* handlers are banned by the dashboard sweep tests.
         */
      }
      (function () {
        var MODES = ['light', 'dark'];
        var ACCENTS = ['violet', 'oxblood', 'teal'];
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        function syncPressed() {
          var mode = root.getAttribute('data-mode');
          var accent = root.getAttribute('data-accent');
          document.querySelectorAll('[data-set-mode]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-set-mode') === mode));
          });
          document.querySelectorAll('[data-set-accent]').forEach(function (b) {
            b.setAttribute(
              'aria-pressed',
              String(b.getAttribute('data-set-accent') === accent),
            );
          });
          if (meta) meta.setAttribute('content', mode === 'light' ? '#f2f3f6' : '#060608');
        }
        document.querySelectorAll('[data-set-mode]').forEach(function (b) {
          b.addEventListener('click', function () {
            var m = b.getAttribute('data-set-mode');
            if (MODES.indexOf(m) === -1) return;
            root.setAttribute('data-mode', m);
            try {
              localStorage.setItem('ds_theme_mode', m);
            } catch (_) {
              /* theme stays session-only */
            }
            syncPressed();
          });
        });
        document.querySelectorAll('[data-set-accent]').forEach(function (b) {
          b.addEventListener('click', function () {
            var a = b.getAttribute('data-set-accent');
            if (ACCENTS.indexOf(a) === -1) return;
            root.setAttribute('data-accent', a);
            try {
              localStorage.setItem('ds_theme_accent', a);
            } catch (_) {
              /* theme stays session-only */
            }
            syncPressed();
          });
        });
        syncPressed();
      })();
    </script>
    <script is:inline>
      {
        /*
         * 2026-05-21 — mobile-nav hamburger wiring. Mobile customers
         * couldn't reach the sidebar (Sign out, Open admin, nav)
         * because `<aside>` was `hidden md:block`. The header above
         * now exposes a hamburger toggle; CSS reveals the aside as a
         * fullscreen overlay when html[data-mobile-nav-open=true].
         * Closes on: button click, nav-link click, Escape key.
         */
      }
      (function () {
        var toggle = document.querySelector('[data-mobile-nav-toggle]');
        if (!toggle) return;
        var root = document.documentElement;
        var closedIcon = document.querySelector('[data-mobile-nav-icon="closed"]');
        var openIcon = document.querySelector('[data-mobile-nav-icon="open"]');
        function setOpen(isOpen) {
          if (isOpen) {
            root.setAttribute('data-mobile-nav-open', 'true');
            toggle.setAttribute('aria-expanded', 'true');
            toggle.setAttribute('aria-label', 'Close navigation');
            if (closedIcon) closedIcon.classList.add('hidden');
            if (openIcon) openIcon.classList.remove('hidden');
          } else {
            root.removeAttribute('data-mobile-nav-open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open navigation');
            if (closedIcon) closedIcon.classList.remove('hidden');
            if (openIcon) openIcon.classList.add('hidden');
          }
        }
        toggle.addEventListener('click', function () {
          setOpen(root.getAttribute('data-mobile-nav-open') !== 'true');
        });
        // Close on nav-link click — link navigation reloads the page,
        // but closing first prevents a brief visual flash of the open
        // overlay on the destination page.
        document.querySelectorAll('aside[data-mobile-nav] a').forEach(function (a) {
          a.addEventListener('click', function () {
            setOpen(false);
          });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && root.getAttribute('data-mobile-nav-open') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
      })();
    </script>
  </body>
