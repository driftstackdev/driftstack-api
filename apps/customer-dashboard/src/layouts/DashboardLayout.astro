      </div>

      {/* 2026-05-29 — branded confirmation modal. Replaces native
          window.confirm() across the dashboard (founder: "avoid these
          alert boxes everywhere"). Pages call the global
          window.driftstackConfirm(message, opts?) → Promise<boolean>.
          Hidden by default; the inline helper below wires show/resolve. */}
      <div
        data-ds-confirm
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ds-confirm-message"
      >
        <div class="w-full max-w-md rounded-xl border border-tk-border bg-tk-surface p-6 shadow-2xl">
          <p
            data-ds-confirm-message
            id="ds-confirm-message"
            class="whitespace-pre-line text-sm text-tk-ink"
          >
          </p>
          <div class="mt-6 flex justify-end gap-3">
            <button
              type="button"
              data-ds-confirm-cancel
              class="rounded-lg border border-tk-border px-4 py-2 text-sm text-tk-ink-2 hover:text-tk-ink"
              >Cancel</button
            >
            <button
              type="button"
              data-ds-confirm-ok
              class="rounded-lg bg-tk-accent px-4 py-2 text-sm font-medium text-white hover:bg-tk-accent/90"
              >Confirm</button
            >
          </div>
        </div>
      </div>
      <script is:inline>
          // 2026-05-29 — window.driftstackConfirm(message, opts?) → Promise<boolean>.
          // Branded replacement for native window.confirm(). opts.confirmLabel
          // overrides the OK button text. Falls back to native confirm only if
          // the modal markup is somehow absent (defensive). Escape / Cancel
          // resolve false; Confirm resolves true.
          (function () {
            // Shared across the separately emitted confirm and prompt helpers.
            // A single lease prevents cross-type overlay/key-handler stacking.
            if (typeof window.__driftstackModalOpen !== 'boolean') {
              window.__driftstackModalOpen = false;
            }
            // NOTE: plain code, NOT the {`…`} template-literal wrapper — Astro
            // emits that wrapper literally, which made this whole script a
            // no-op string in the browser (window.driftstackConfirm was
            // undefined in production until the 2026-07-02 fix).
            window.driftstackConfirm = function (message, opts) {
              return new Promise(function (resolve) {
                var overlay = document.querySelector('[data-ds-confirm]');
                if (!overlay) {
                  resolve(window.confirm(message));
                  return;
                }
                if (window.__driftstackModalOpen) {
                  resolve(false);
                  return;
                }
                window.__driftstackModalOpen = true;
                var msg = overlay.querySelector('[data-ds-confirm-message]');
                var ok = overlay.querySelector('[data-ds-confirm-ok]');
                var cancel = overlay.querySelector('[data-ds-confirm-cancel]');
                if (msg) msg.textContent = message;
                if (ok) ok.textContent = (opts && opts.confirmLabel) || 'Confirm';
                var destructive = !!(opts && opts.destructive);
                // Remember what was focused (the trigger) so we can return
                // focus there on close — keyboard users keep their place.
                var prevFocus = document.activeElement;
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                if (destructive) {
                  if (cancel && cancel.focus) cancel.focus();
                } else if (ok && ok.focus) ok.focus();
                function done(result) {
                  window.__driftstackModalOpen = false;
                  overlay.classList.add('hidden');
                  document.body.style.overflow = '';
                  if (ok) ok.removeEventListener('click', onOk);
                  if (cancel) cancel.removeEventListener('click', onCancel);
                  overlay.removeEventListener('click', onOverlay);
                  document.removeEventListener('keydown', onKey);
                  if (prevFocus && prevFocus.focus) prevFocus.focus();
                  resolve(result);
                }
                function onOk() { done(true); }
                function onCancel() { done(false); }
                function onOverlay(e) { if (e.target === overlay) done(false); }
                function onKey(e) {
                  if (e.key === 'Escape') { done(false); return; }
                  if (destructive && e.key === 'Enter') { e.preventDefault(); return; }
                  if (e.key === 'Tab') {
                    var f = [cancel, ok].filter(function (el) { return el; });
                    if (!f.length) return;
                    if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
                    else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
                  }
                }
                if (ok) ok.addEventListener('click', onOk);
                if (cancel) cancel.addEventListener('click', onCancel);
                overlay.addEventListener('click', onOverlay);
                document.addEventListener('keydown', onKey);
              });
            };
          })();
      </script>

      {/* 2026-05-29 — branded prompt modal. Replaces native
          window.prompt(). Pages call window.driftstackPrompt(message,
          opts?) → Promise<string|null> (null on Cancel/Escape). opts:
          defaultValue, placeholder, confirmLabel. Enter submits. */}
      <div
        data-ds-prompt
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ds-prompt-message"
