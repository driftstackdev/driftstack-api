---
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** When true, render the side-nav. Onboarding pages opt out. */
  withSidebar?: boolean;
}

const {
  title,
  description = 'Driftstack — manage your account, profiles, sessions, and billing.',
  withSidebar = true,
} = Astro.props;

const fullTitle = `${title} · Driftstack`;
const pathname = Astro.url.pathname;

// V-331 — backend API base URL surfaced to the inline "act as" picker
// script. Per existing pages: localStorage uses `ds_web_session_token`
// for the bearer (V-141), and we add `ds_act_as_account` for the
// optional team-owner override.
import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

// 2026-05-21 — sidebar nav restructure: group items into 4 sections
// (Browse / Activity / Account / System) with an inline-SVG icon per
// item. Matches the gui-client Sidebar treatment so the two operator
// surfaces feel like one product. Iconography stays Driftstack-native
// (Lucide-shape 14px stroke). No JS-hydration required for icons.
// 2026-05-21 — `badgeKey` ties a nav item to a count slot the inline
// account-me-hydration script fills in (Profiles X/Y, Sessions X/Y).
// Items without a badgeKey just have a label.
type BadgeKey = 'profiles' | 'sessions' | 'team';
type NavItem = { href: string; label: string; icon: string; badgeKey?: BadgeKey };
type NavSection = { label: string; items: NavItem[] };

const ICON = {
  home: 'M3 8.5 8 4l5 4.5V13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z',
  layers:
    'M8 2 1.5 5.25 8 8.5l6.5-3.25Z M1.5 8 8 11.25 14.5 8 M1.5 10.75 8 14l6.5-3.25',
  film: 'M2.25 2.25h11.5v11.5h-11.5z M2.25 5.5h11.5 M2.25 10.5h11.5 M5.5 2.25v11.5 M10.5 2.25v11.5',
  activity: 'M1.5 8h2.75l1.5-4.5 3 9 1.5-4.5h4.25',
  agent: 'M3 6.75a3.25 3.25 0 1 1 6.5 0 3.25 3.25 0 0 1-6.5 0Z M12.5 11.75c-.4-1.9-1.9-3-4-3s-3.6 1.1-4 3 M12.25 4.25l1.25 1.25-1.25 1.25 M13.5 5.5h-2',
  key: 'M9.5 8.5a3.25 3.25 0 1 1 0-1l3.5 3.5-1.5 1.5-1-1-1 1-1-1-1 1Z',
  globe:
    'M8 13.75A5.75 5.75 0 1 0 8 2.25 5.75 5.75 0 0 0 8 13.75Z M2.25 8h11.5 M8 2.25c1.7 2 2.5 4 2.5 5.75S9.7 12 8 13.75 5.5 9.75 5.5 8 6.3 4.25 8 2.25Z',
  chart: 'M2 13h12 M3.5 11.5V8 M6.5 11.5V5 M9.5 11.5V7 M12.5 11.5V3',
  card: 'M2 4.5h12v7h-12z M2 7h12',
  receipt:
    'M3.25 2.25h9.5v11.5l-1.75-1-1.75 1-1.5-1-1.5 1-1.5-1-1.5 1Z M5.5 5.5h5 M5.5 8h5 M5.5 10.5h3',
  webhook:
    'M5.25 4.5a2.75 2.75 0 1 1 5.5 0c0 1.3-.85 2.4-2 2.7L5.5 12 M3.25 8.75a2.75 2.75 0 0 0 2.5 4 2.75 2.75 0 0 0 2.4-1.5h4.6 M10.75 12a2.75 2.75 0 1 1-4.85-1.8',
  list: 'M4.5 4.25h8 M4.5 8h8 M4.5 11.75h8',
  users:
    'M6 6a2.25 2.25 0 1 1 0-4.5 2.25 2.25 0 0 1 0 4.5Z M2 13c.5-2 2-3 4-3s3.5 1 4 3 M10.75 4.25a2 2 0 0 1 0 3.5 M13.5 12.75c-.25-1.5-1-2.25-2.25-2.75',
  cog: 'M8 6.25a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5Z M8 1.75v1.5 M8 12.75v1.5 M3.75 3.75l1 1 M11.25 11.25l1 1 M1.75 8h1.5 M12.75 8h1.5 M3.75 12.25l1-1 M11.25 4.75l1-1',
};

const navSections: NavSection[] = [
  {
    label: 'Browse',
    items: [
      { href: '/', label: 'Overview', icon: ICON.home },
      { href: '/profiles', label: 'Profiles', icon: ICON.layers, badgeKey: 'profiles' },
      { href: '/snapshots', label: 'Snapshots', icon: ICON.film },
      { href: '/sessions', label: 'Sessions', icon: ICON.activity, badgeKey: 'sessions' },
      { href: '/agent-sessions', label: 'Agent sessions', icon: ICON.agent },
    ],
  },
  {
    label: 'Connectivity',
    items: [
      { href: '/api-keys', label: 'API keys', icon: ICON.key },
      { href: '/proxies', label: 'Proxies', icon: ICON.globe },
      { href: '/webhooks', label: 'Webhooks', icon: ICON.webhook },
    ],
  },
  {
    label: 'Account',
    items: [
      { href: '/usage', label: 'Usage', icon: ICON.chart },
      { href: '/billing', label: 'Billing', icon: ICON.card },
      { href: '/subscription', label: 'Subscription', icon: ICON.receipt },
      { href: '/audit-log', label: 'Audit log', icon: ICON.list },
      { href: '/team', label: 'Team', icon: ICON.users, badgeKey: 'team' },
      { href: '/settings', label: 'Settings', icon: ICON.cog },
    ],
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f14" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=2" />
  </head>
  <body class="relative">
    {/*
      V-219* — brand alignment with marketing site:
        - Sidebar header: D-badge (gradient-accent) + lowercase font-mono
          "driftstack" wordmark matches apps/marketing-site/src/components/
          Header.astro pattern.
        - withSidebar={false} branch: minimal horizontal header so onboarding
          pages have brand presence (Gap 2 from the V-219* audit) +
          ambient radial-glow background so the auth surfaces feel cohesive
          with the marketing landing.
        - Footer (signed-in dashboard) with legal-doc links (Gap 7).
    */}

    {/* Ambient background — only visible when withSidebar is false (auth +
        onboarding pages). The sidebar pages have plenty of UI chrome so the
        ambient glow would be visually noisy. */}
    {!withSidebar && (
      <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
        <div class="absolute inset-x-0 top-0 h-[600px] bg-glow-radial-red" />
        <div class="absolute inset-x-0 bottom-0 h-[400px] bg-glow-radial-red-soft" />
      </div>
    )}

    <div class="flex min-h-screen flex-col">
      {
        !withSidebar && (
          <header class="border-b border-white/10 bg-surface-base/70 backdrop-blur-md">
            <div class="mx-auto flex max-w-6xl items-center px-6 py-4">
              <a
                href="/"
                class="group flex items-center gap-2.5 font-mono text-base font-semibold text-ink-primary"
              >
                <img
                  src="/driftstack-mark.svg?v=2"
                  alt="Driftstack"
                  width="32"
                  height="32"
                  class="inline-block h-8 w-8 transition-transform duration-300 group-hover:scale-110"
                />
                <span class="tracking-tight">driftstack</span>
              </a>
            </div>
          </header>
        )
      }
      <div class="flex flex-1">
        {
          withSidebar && (
            <aside class="hidden w-60 shrink-0 border-r border-white/10 bg-surface-raised/40 backdrop-blur-md md:block">
              <div class="flex h-16 items-center px-6 border-b border-white/10">
                <a
                  href="/"
                  class="group flex items-center gap-2.5 font-mono text-base font-semibold text-ink-primary"
                >
                  <img
                    src="/driftstack-mark.svg?v=2"
                    alt="Driftstack"
                    width="32"
                    height="32"
                    class="inline-block h-8 w-8 transition-transform duration-300 group-hover:scale-110"
                  />
                  <span class="tracking-tight">driftstack</span>
                </a>
              </div>
              {/*
                V-331 — "Acting as" picker. Hidden until JS confirms the
                user is on at least one team. Switching changes
                localStorage.ds_act_as_account + reloads the page so
                downstream fetches pick up the new X-Driftstack-Account
                header. Self-only customers never see this widget.
              */}
              <div
                data-act-as-picker-wrap
                class="hidden border-b border-white/10 px-4 py-3"
              >
                <label
                  for="act-as-picker"
                  class="block text-[10px] font-mono uppercase tracking-widest text-ink-muted"
                >
                  Acting as
                </label>
                <select
                  id="act-as-picker"
                  data-act-as-picker
                  class="mt-1 w-full rounded-md border border-white/10 bg-surface-inset px-2 py-1.5 text-sm text-ink-primary focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red/30"
                ></select>
              </div>
              {/* 2026-05-19 — signed-in identity badge. Avatar (from R2
                  upload OR OAuth IDP fallback per /account/me) +
                  display name above the nav. Hidden until JS hydrates
                  /account/me to avoid empty-state flash. */}
              <div
                data-signed-in-as
                class="hidden border-b border-white/10 px-4 py-4"
              >
                <div class="flex items-center gap-3">
                  <div
                    data-signed-in-avatar
                    class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-surface-raised text-[11px] text-ink-muted"
                  >
                    —
                  </div>
                  <div class="min-w-0 flex-1">
                    <p
                      data-signed-in-name
                      class="truncate text-sm font-medium text-ink-primary"
                    >
                      —
                    </p>
                    <a
                      href="/settings"
                      class="text-[11px] text-ink-muted hover:text-ink-primary"
                    >
                      Account settings
                    </a>
                  </div>
                </div>
              </div>
              <nav class="px-3 py-4">
                {navSections.map((section) => (
                  <div class="mb-3">
                    <div class="px-3 pb-1 pt-2 text-[10px] font-mono uppercase tracking-widest text-ink-muted">
                      {section.label}
                    </div>
                    <ul class="space-y-px">
                      {section.items.map((item) => {
                        // Exact match for "/" (Overview); prefix match for
                        // everything else so a deeper route like
                        // /profiles/abc still highlights the Profiles tab.
                        const active =
                          item.href === '/'
                            ? pathname === '/'
                            : pathname === item.href ||
                              pathname.startsWith(item.href + '/');
                        return (
                          <li>
                            <a
                              href={item.href}
                              class:list={[
                                // 2026-05-21 — font-weight stays constant across
                                // active/inactive (font-medium widens text → other
                                // items shifted on click). Active state distinguished
                                // by bg + text color + inset divider only.
                                'group flex items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium transition-colors duration-150',
                                active
                                  ? 'bg-glow-red/10 text-glow-red shadow-inset-divider'
                                  : 'text-ink-secondary hover:bg-white/5 hover:text-ink-primary',
                              ]}
                            >
                              <svg
                                viewBox="0 0 16 16"
                                width="14"
                                height="14"
                                aria-hidden="true"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class:list={[
                                  'shrink-0',
                                  active ? 'opacity-100' : 'opacity-70',
                                ]}
                              >
                                <path d={item.icon} />
                              </svg>
                              <span class="flex-1 truncate">{item.label}</span>
                              {item.badgeKey && (
                                <span
                                  data-nav-badge={item.badgeKey}
                                  class:list={[
                                    // 2026-05-21 — opacity-0 (not `hidden`) so the
                                    // slot reserves layout space pre-hydration; JS
                                    // sets opacity-100 + textContent in one paint
                                    // → no width jump when the badge appears.
                                    'shrink-0 rounded px-1.5 py-px font-mono text-[10px] opacity-0 transition-opacity',
                                    active
                                      ? 'bg-glow-red/20 text-glow-red'
                                      : 'bg-white/5 text-ink-muted group-hover:text-ink-secondary',
                                  ]}
                                  >&nbsp;</span>
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </nav>
            </aside>
          )
        }
        <main class="flex-1">
          <!-- V-331 — "Acting as" indicator banner. Hidden by default.
               JS below toggles + populates when the local
               ds_act_as_account selection differs from self. -->
          <div
            data-act-as-banner
            class="hidden border-b border-glow-red/30 bg-glow-red/10 px-6 py-3 text-sm text-glow-red-soft backdrop-blur-sm"
            role="status"
          >
            <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
              <span>
                Acting as <span class="font-mono" data-act-as-owner>—</span>. All actions read +
                write that team's resources.
              </span>
              <button
                type="button"
                data-act-as-clear
                class="rounded border border-glow-red/40 bg-surface-raised px-3 py-1 text-xs font-medium text-ink-primary hover:bg-glow-red/20"
              >
                Switch back to self
              </button>
            </div>
          </div>
          <!-- 2026-05-20 — notification SSE banner. Subscribes to
               GET /v1/account/me/notifications and renders the most-
               recent cost.threshold_alert / incident.broadcast /
               audit.high_severity / session.errored events as a top-
               of-page bar. Auto-dismisses on Settings nav OR via the
               × close affordance. Hidden by default; the inline
               script below toggles on incoming events. -->
          <div
            data-notification-banner
            class="hidden border-b border-glow-red/40 bg-glow-red/10 backdrop-blur-sm"
            role="status"
            aria-live="polite"
          >
            <div
              class="mx-auto flex max-w-6xl items-start justify-between gap-4 px-6 py-3"
            >
              <div class="min-w-0 flex-1">
                <p
                  data-notification-title
                  class="text-sm font-medium text-ink-primary"
                ></p>
                <p
                  data-notification-body
                  class="mt-0.5 text-xs text-ink-secondary"
                ></p>
              </div>
              <button
                type="button"
                data-notification-dismiss
                aria-label="Dismiss notification"
                class="shrink-0 rounded p-1 text-ink-muted hover:bg-glow-red/20 hover:text-ink-primary"
              >
                ✕
              </button>
            </div>
          </div>
          <!-- 2026-05-20 — legal-acceptance banner. Pings
               /v1/legal/required on dashboard load; renders pending
               docs + accept controls so the customer can clear the
               gate without seeing the raw 409 from the API. Hidden by
               default; the inline script below toggles + populates. -->
          <div
            data-legal-banner
            class="hidden border-b border-glow-red/40 bg-glow-red/15 backdrop-blur-sm"
            role="alert"
          >
            <div class="mx-auto max-w-6xl px-6 py-4">
              <p class="text-sm font-medium text-ink-primary">
                Before you can mint API keys or create sessions, please review and accept the
                following:
              </p>
              <ul data-legal-pending-list class="mt-3 space-y-2 text-sm">
                <!-- Populated at runtime by the script below. -->
              </ul>
              <div class="mt-4 flex items-center gap-3">
                <button
                  type="button"
                  data-legal-accept-all
                  class="rounded border border-glow-red/40 bg-surface-raised px-4 py-1.5 text-sm font-medium text-ink-primary hover:bg-glow-red/20 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  Accept all and continue
                </button>
                <span data-legal-status class="text-xs text-ink-muted"></span>
              </div>
            </div>
          </div>
          <slot />
        </main>
      </div>
      <script is:inline define:vars={{ apiBaseUrl }}>
        // V-331 — "Acting as" picker + global helper.
        // Exposes window.driftstackActAsHeaders() returning either
        // { 'x-driftstack-account': 'acc_<uuid>' } or {}. Inline-script
        // pages call it when building fetch headers so they pick up
        // the active team selection. Reads localStorage; never blocks
        // the render. Picker UI auto-hides for self-only accounts.
        (function () {
          window.driftstackActAsHeaders = function () {
            try {
              const v = localStorage.getItem('ds_act_as_account');
              return v && v.length > 0 ? { 'x-driftstack-account': v } : {};
            } catch (_) {
              return {};
            }
          };

          const banner = document.querySelector('[data-act-as-banner]');
          const ownerEl = document.querySelector('[data-act-as-owner]');
          const clearBtn = document.querySelector('[data-act-as-clear]');
          const wrap = document.querySelector('[data-act-as-picker-wrap]');
          const picker = document.querySelector('[data-act-as-picker]');

          function getToken() {
            try {
              return localStorage.getItem('ds_web_session_token') || '';
            } catch (_) {
              return '';
            }
          }

          function getActiveOwnerId() {
            try {
              return localStorage.getItem('ds_act_as_account') || '';
            } catch (_) {
              return '';
            }
          }

          if (clearBtn) {
            clearBtn.addEventListener('click', function () {
              try {
                localStorage.removeItem('ds_act_as_account');
              } catch (_) {
                /* swallow */
              }
              window.location.reload();
            });
          }

          // Toggle the indicator banner based on current selection.
          const active = getActiveOwnerId();
          if (active && banner) {
            banner.classList.remove('hidden');
            if (ownerEl) ownerEl.textContent = active;
          }

          // Fetch /v1/account/me to populate the picker. Quiet failure:
          // no token / network blip leaves the picker hidden (no
          // regression from pre-V-331 behaviour).
          const token = getToken();
          if (!token || !picker || !wrap) return;
          fetch(apiBaseUrl + '/v1/account/me', {
            headers: { authorization: 'Bearer ' + token },
          })
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (me) {
              if (!me) return;

              // 2026-05-19 — populate the signed-in-as identity badge
              // above the nav. Avatar from /account/me (R2 upload OR
              // OAuth IDP fallback); name → email → id as label
              // priority. Initials shown when no avatar URL.
              const sa = document.querySelector('[data-signed-in-as]');
              const saName = document.querySelector('[data-signed-in-name]');
              const saAvatar = document.querySelector('[data-signed-in-avatar]');
              if (sa && saName && saAvatar) {
                const displayName = me.name || me.email || me.id;
                saName.textContent = displayName;
                if (me.avatar_url) {
                  const img = document.createElement('img');
                  img.src = me.avatar_url;
                  img.alt = '';
                  img.referrerPolicy = 'no-referrer';
                  img.className = 'h-full w-full object-cover';
                  saAvatar.innerHTML = '';
                  saAvatar.appendChild(img);
                } else {
                  // Compute initials from the display label.
                  const parts = String(displayName)
                    .split(/[^A-Za-z0-9]+/)
                    .filter(Boolean);
                  const initials =
                    parts.length >= 2
                      ? (parts[0][0] + parts[1][0]).toUpperCase()
                      : (parts[0] || '?').slice(0, 2).toUpperCase();
                  saAvatar.textContent = initials;
                  saAvatar.className =
                    'flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-glow-red/10 text-xs font-medium text-glow-red';
                }
                sa.classList.remove('hidden');
              }

              // 2026-05-21 — operator-UI polish wave: fill the per-nav-item
              // count badges from the same /account/me payload. Profiles
              // X/Y, Sessions X/Y, Team N. Each badge has CSS .hidden by
              // default; we strip the class once we have data to show.
              const setBadge = (key, text) => {
                const el = document.querySelector('[data-nav-badge="' + key + '"]');
                if (!el) return;
                if (text === null) {
                  // Keep the slot taking layout space (avoid post-load shift),
                  // just stay invisible. Slot's pre-hydration content is &nbsp;.
                  el.classList.add('opacity-0');
                  el.classList.remove('opacity-100');
                  return;
                }
                el.textContent = text;
                el.classList.remove('opacity-0');
                el.classList.add('opacity-100');
              };
              const ratio = (active, cap) => {
                if (typeof active !== 'number') return null;
                if (typeof cap !== 'number' || cap === null) return String(active);
                return active + '/' + cap;
              };
              setBadge('profiles', ratio(me.profile_count, me.profile_cap));
              setBadge(
                'sessions',
                ratio(me.concurrent_session_active, me.concurrent_session_cap),
              );
              setBadge(
                'team',
                Array.isArray(me.teams) && me.teams.length > 0 ? String(me.teams.length) : null,
              );

              if (!Array.isArray(me.teams) || me.teams.length === 0) return;
              // Build options: Self + each team owner.
              const options = [{ value: '', label: 'Self (' + (me.email || me.id) + ')' }];
              for (const t of me.teams) {
                options.push({
                  value: t.owner_account_id,
                  label: t.owner_account_id + ' (' + t.role + ')',
                });
              }
              picker.innerHTML = '';
              for (const opt of options) {
                const el = document.createElement('option');
                el.value = opt.value;
                el.textContent = opt.label;
                if (opt.value === active) el.selected = true;
                picker.appendChild(el);
              }
              wrap.classList.remove('hidden');
              picker.addEventListener('change', function (e) {
                const v = e.target.value;
                try {
                  if (v && v.length > 0) {
                    localStorage.setItem('ds_act_as_account', v);
                  } else {
                    localStorage.removeItem('ds_act_as_account');
                  }
                } catch (_) {
                  /* swallow */
                }
                window.location.reload();
              });
            })
            .catch(function () {
              /* swallow — picker stays hidden */
            });
        })();
      </script>
      <script is:inline define:vars={{ apiBaseUrl }}>
        // 2026-05-20 — notification SSE subscriber. Opens an
        // EventSource against /v1/account/me/notifications and
        // surfaces the most-recent event in the dashboard's top
        // banner. Mirrors the GUI client's NotificationToastStack
        // shape (cost.threshold_alert / incident.broadcast /
        // audit.high_severity / session.errored). One concurrent
        // subscriber per tab; the SSE connection auto-reconnects
        // on transient drops via native EventSource behavior.
        //
        // Auth: native EventSource lacks header support; the
        // backend route uses requireAuth Bearer-header, so this
        // path passes the token via the query param (route layer
        // change deferred to v0.2 — until then the subscription
        // either succeeds via a polyfill OR drops on the 401 and
        // the dashboard stays silent, same as it does today).
        (function () {
          const banner = document.querySelector('[data-notification-banner]');
          if (!banner) return;
          const titleEl = banner.querySelector('[data-notification-title]');
          const bodyEl = banner.querySelector('[data-notification-body]');
          const dismissBtn = banner.querySelector('[data-notification-dismiss]');
          if (!titleEl || !bodyEl || !dismissBtn) return;
          let token = null;
          try {
            token = localStorage.getItem('ds_web_session_token');
          } catch (_) {
            /* localStorage blocked — skip subscription */
          }
          if (!token) return;
          function describe(event) {
            switch (event.kind) {
              case 'cost.threshold_alert': {
                const total = (event.totalCents / 100).toLocaleString('en-US', {
                  style: 'currency',
                  currency: 'USD',
                });
                const hard = (event.thresholdHardCents / 100).toLocaleString('en-US', {
                  style: 'currency',
                  currency: 'USD',
                });
                const sev =
                  event.severity === 'resolved'
                    ? 'recovered'
                    : event.severity === 'critical'
                      ? 'critical'
                      : 'warn';
                return {
                  title: 'Cost ' + sev + ': ' + total + ' / ' + hard,
                  body:
                    event.severity === 'resolved'
                      ? 'Spend dropped back below the soft threshold for ' +
                        event.billingCycle +
                        '.'
                      : 'Billing cycle ' +
                        event.billingCycle +
                        ' crossed the ' +
                        event.currentState +
                        ' threshold.',
                };
              }
              case 'incident.broadcast':
                return {
                  title: 'Incident: ' + event.title,
                  body: 'Severity ' + event.severity + ' — incident ' + event.incidentId + '.',
                };
              case 'audit.high_severity':
                return {
                  title: 'Account event: ' + event.action,
                  body:
                    'Actor ' +
                    event.actorType +
                    (event.targetResourceId !== null
                      ? ' · target ' + event.targetResourceId
                      : '') +
                    '.',
                };
              case 'session.errored':
                return {
                  title: 'Session error',
                  body: 'Session ' + event.sessionId + ' hit ' + event.errorClass + '.',
                };
              default:
                return null;
            }
          }
          function show(event) {
            const d = describe(event);
            if (!d) return;
            titleEl.textContent = d.title;
            bodyEl.textContent = d.body;
            banner.classList.remove('hidden');
          }
          dismissBtn.addEventListener('click', function () {
            banner.classList.add('hidden');
          });
          let es;
          try {
            const url =
              apiBaseUrl + '/v1/account/me/notifications?token=' + encodeURIComponent(token);
            es = new EventSource(url);
          } catch (_) {
            return;
          }
          const kinds = [
            'cost.threshold_alert',
            'incident.broadcast',
            'audit.high_severity',
            'session.errored',
          ];
          for (const kind of kinds) {
            es.addEventListener(kind, function (raw) {
              try {
                const parsed = JSON.parse(raw.data);
                if (parsed && parsed.kind === kind) show(parsed);
              } catch (_) {
                /* swallow */
              }
            });
          }
          window.addEventListener('beforeunload', function () {
            try {
              es.close();
            } catch (_) {
              /* swallow */
            }
          });
        })();
      </script>
      <script is:inline define:vars={{ apiBaseUrl }}>
        // 2026-05-20 — legal acceptance banner. Pings /v1/legal/required
        // at every dashboard page load; if the response carries pending
        // documents the banner surfaces a clickable list + "Accept all"
        // button. Without this the customer hits the raw 409
        // "Operation requires acceptance of N document(s)…" when minting
        // an api-key / creating a session and has no path forward.
        (function () {
          const banner = document.querySelector('[data-legal-banner]');
          if (!banner) return;
          const list = banner.querySelector('[data-legal-pending-list]');
          const acceptAllBtn = banner.querySelector('[data-legal-accept-all]');
          const statusEl = banner.querySelector('[data-legal-status]');
          if (!list || !acceptAllBtn || !statusEl) return;
          let token = null;
          try {
            token = localStorage.getItem('ds_web_session_token');
          } catch (_) {
            /* localStorage blocked — skip the banner */
          }
          if (!token) return;
          const headers = Object.assign(
            { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
            window.driftstackActAsHeaders ? window.driftstackActAsHeaders() : {},
          );
          fetch(apiBaseUrl + '/v1/legal/required', { headers })
            .then(function (res) {
              return res.ok ? res.json() : null;
            })
            .then(function (body) {
              // /v1/legal/required returns { data: [...] }, NOT { required: [...] }
              // (2026-05-20 fix — earlier rev silently no-op'd the banner).
              const required = body && Array.isArray(body.data) ? body.data : [];
              if (required.length === 0) return;
              banner.classList.remove('hidden');
              // 2026-05-20 — server's document_key for the
              // Terms-of-Service doc is 'tos' but the marketing-site
              // URL slug is /legal/terms/. Map the one mismatch.
              const DOC_URL_SLUG = { tos: 'terms' };
              const DOC_LABEL = {
                tos: 'Terms of Service',
                privacy: 'Privacy Policy',
                dpa: 'Data Processing Addendum',
                aup: 'Acceptable Use Policy',
              };
              required.forEach(function (doc) {
                const li = document.createElement('li');
                li.className = 'flex items-center gap-2';
                const dot = document.createElement('span');
                dot.className = 'inline-block size-1.5 rounded-full bg-glow-red';
                const a = document.createElement('a');
                const slug = DOC_URL_SLUG[doc.document_key] || doc.document_key;
                a.href = 'https://driftstack.dev/legal/' + slug + '/';
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
                a.className = 'text-glow-red underline underline-offset-4 hover:text-glow-red-soft';
                a.textContent = DOC_LABEL[doc.document_key] || doc.title || doc.document_key;
                const ver = document.createElement('span');
                ver.className = 'text-xs text-ink-muted';
                ver.textContent = '(v' + doc.current_version + ')';
                li.append(dot, a, ver);
                list.append(li);
              });
              acceptAllBtn.addEventListener('click', function () {
                acceptAllBtn.disabled = true;
                statusEl.textContent = 'Recording acceptance…';
                // 2026-05-20 — /v1/legal/accept REQUIRES content_hash
                // (64-char SHA-256 hex); GET /v1/legal/required already
                // includes it on each entry so pass it through.
                Promise.all(
                  required.map(function (doc) {
                    return fetch(apiBaseUrl + '/v1/legal/accept', {
                      method: 'POST',
                      headers: headers,
                      body: JSON.stringify({
                        document_key: doc.document_key,
                        version: doc.current_version,
                        content_hash: doc.content_hash,
                      }),
                    });
                  }),
                )
                  .then(function (responses) {
                    const allOk = responses.every(function (r) {
                      return r.ok;
                    });
                    if (!allOk) {
                      statusEl.textContent = 'One or more acceptances failed — please reload.';
                      acceptAllBtn.disabled = false;
                      return;
                    }
                    statusEl.textContent = 'Accepted — reloading…';
                    setTimeout(function () {
                      window.location.reload();
                    }, 400);
                  })
                  .catch(function () {
                    statusEl.textContent = 'Network error — please retry.';
                    acceptAllBtn.disabled = false;
                  });
              });
            })
            .catch(function () {
              /* swallow — banner stays hidden on transient failures */
            });
        })();
      </script>
      <footer class="border-t border-white/10 bg-surface-base/70 backdrop-blur-md">
        <div
          class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-4 text-xs text-ink-muted"
        >
          <span>Driftstack</span>
          {/* W211 — these pages live on the marketing-site at
              driftstack.dev, not on the dashboard's own
              app.driftstack.dev origin. Absolute URLs are required;
              relative paths would 404 against the Cloudflare Pages
              project that serves the dashboard. */}
          <nav class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <a href="https://driftstack.dev/legal/privacy" class="hover:text-glow-red">Privacy</a>
            <a href="https://driftstack.dev/legal/terms" class="hover:text-glow-red">Terms</a>
            <a href="https://driftstack.dev/legal/dpa" class="hover:text-glow-red">DPA</a>
            <a href="https://driftstack.dev/legal/aup" class="hover:text-glow-red">AUP</a>
            <a href="https://driftstack.dev/trust/sub-processors" class="hover:text-glow-red"
              >Sub-processors</a
            >
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
