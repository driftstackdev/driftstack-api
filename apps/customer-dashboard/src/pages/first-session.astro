---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { LOCKED_ARCHETYPE_DISPLAY_LABEL } from '@driftstack/api-types';

// V-184a — onboarding step 5. First session creation. Tier 1 minimal
// placeholder — full Tier 3 visual UX (tutorial, embedded WebView,
// "view your first capture" CTA) lands in V-184b draft.
// V-501 — disabled-while-pending guard + clearer status copy.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="First session" withSidebar={false}>
  {/* 2026-05-23 — hero-glow atmosphere on first-session onboarding so
      the brand surface stays consistent during the high-touch first
      flow. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl px-6 py-16" data-page="first-session">
    <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">First session</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">
      Create your first session.
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      A session is an iPhone Safari browser running in the cloud —
      every website it visits sees a genuine iPhone, not a bot.
      Give it a label so you can find it later.
    </p>
    <p class="mt-2 text-sm text-tk-ink-2">
      <strong>Archetype</strong> defines the iPhone model, iOS version,
      and Safari build your session runs as. You're starting with
      <strong>{LOCKED_ARCHETYPE_DISPLAY_LABEL}</strong> — our standard
      reference profile. Higher tiers unlock more archetypes.
    </p>
    <p class="mt-2 text-xs text-tk-ink-3">
      We'll create your first <strong>API key</strong> in the background —
      a secret token your code uses to call the SDK. It's shown once on
      the next page; copy it somewhere safe (1Password, a git-ignored
      <code class="font-mono">.env</code>, or similar).
    </p>

    <!-- Wave 1086+ — post-checkout confirmation banner. Stripe-success
         redirects (subscribe) land here with ?subscribed=<tier>.
         Without an explicit confirmation the customer sees the generic
         "create your first session" form and wonders if their payment
         went through. (The one-time trial pack was retired 2026-05-27;
         free accounts reach this page directly with no checkout.) -->
    <div
      data-post-checkout
      class="mt-6 hidden rounded-lg border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-200"
      role="status"
    >
    </div>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-tk-accent/30 bg-tk-accent/10 px-4 py-3 text-sm text-tk-accent-soft"
      role="status"
    >
    </div>

    <form data-form="first-session" class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-tk-ink-2" for="session-label">Label</label>
        <input
          id="session-label"
          name="label"
          type="text"
          required
          maxlength="120"
          placeholder="my-first-session"
          class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
        />
      </div>
      {/* 2026-05-24 — arrow icon on submit + busy state. */}
      <button type="submit" class="btn-primary w-full inline-flex items-center justify-center gap-1.5" data-submit>
        <span data-label-default class="inline-flex items-center gap-1.5">
          Create session
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </span>
        <span data-label-busy class="hidden inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
          </svg>
          Creating…
        </span>
      </button>
    </form>

    <p class="mt-8 text-xs text-tk-ink-3">
      Skip this step? <a href="/" class="text-tk-accent underline">Go to dashboard</a>.
    </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="first-session"]');
      if (!root) return;
      const form = root.querySelector('[data-form="first-session"]');
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Problem-type URI the server returns (409) when an operation is gated
      // on outstanding legal-document acceptances. A brand-new web-signup
      // account has accepted nothing, so the very first mint-key call here
      // hits this — without handling it the customer saw a raw "requires
      // acceptance of N document(s)" banner with no way forward.
      const LEGAL_ACCEPTANCE_TYPE = 'https://errors.driftstack.dev/legal-acceptance-required';

      // Accept every pending legal document for the account, then resolve.
      // Mirrors DashboardLayout's "Accept all" logic: GET /v1/legal/required
      // for the catalog (each entry carries the content_hash POST /accept
      // requires), then POST /v1/legal/accept per document. Rejects if any
      // acceptance fails so the caller can surface a clear error.
      async function acceptPendingLegal() {
        const headers = { 'content-type': 'application/json', authorization: 'Bearer ' + token };
        const reqRes = await fetch(apiBaseUrl + '/v1/legal/required', { headers });
        if (!reqRes.ok) throw new Error('legal/required HTTP ' + reqRes.status);
        const reqBody = await reqRes.json().catch(() => ({}));
        const required = Array.isArray(reqBody.data) ? reqBody.data : [];
        if (required.length === 0) return; // nothing pending — let the retry proceed
        const responses = await Promise.all(
          required.map((doc) =>
            fetch(apiBaseUrl + '/v1/legal/accept', {
              method: 'POST',
              headers: headers,
              body: JSON.stringify({
                document_key: doc.document_key,
                version: doc.current_version,
                content_hash: doc.content_hash,
              }),
            }),
          ),
        );
        if (!responses.every((r) => r.ok)) {
          throw new Error('One or more legal acceptances failed.');
        }
      }

      // Wave 1086+ — Stripe-success-redirect confirmation banner.
      // /select-tier sets success_url to /first-session?subscribed=<tier>
      // for paid tiers; without this handler the customer arrives with no
      // confirmation their payment landed.
      //
      // Finding #19 fix — the bare ?subscribed= query param only proves
      // Stripe Checkout REDIRECTED here; it does NOT prove the
      // subscription is active. The webhook that actually flips the
      // subscription mirror row to active/trialing can lag the redirect
      // (or fail). Confirm against GET /v1/billing before claiming
      // "Subscription active" so a lagging/failed webhook shows an
      // honest "still activating" state instead of a false confirmation.
      async function showPostCheckoutBanner() {
        const params = new URLSearchParams(window.location.search);
        const subscribed = params.get('subscribed');
        if (!subscribed) return;
        const postCheckout = root.querySelector('[data-post-checkout]');
        if (!postCheckout) return;

        postCheckout.textContent = 'Payment received — activating your subscription…';
        postCheckout.classList.remove('hidden');
        if (!token) return; // the no-token redirect below handles this case.

        try {
          const res = await fetch(apiBaseUrl + '/v1/billing', {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const body = await res.json();
          const status = body && body.subscription ? body.subscription.status : null;
          if (status === 'active' || status === 'trialing') {
            postCheckout.textContent =
              'Subscription active — welcome. Create your first session below; your concurrent cap is set by your tier.';
          } else {
            postCheckout.textContent =
              'Payment received — your subscription is being activated, this can take a moment. ' +
              "Refresh this page in a minute if it doesn't update on its own.";
          }
        } catch (_err) {
          // Best-effort confirmation only — leave the "activating"
          // message up rather than block the page on a transient
          // billing-read failure.
        }
      }
      void showPostCheckoutBanner();

      // Defensive redirect if user landed here without a token.
      if (!token) {
        window.location.replace('/signup');
        return;
      }

      // First-session creation typically uses an API key, not a web
      // session token. V-168 makes the web-session token usable on
      // /v1/api-keys (so customer can mint a key) — but for the
      // session-creation step, a key is needed. The minimal flow:
      //   1. Mint a "default" API key via web session.
      //   2. Use that API key to create the session.
      //   3. Stash the new API key plaintext in sessionStorage so the
      //      /first-session redirect to /sessions can show it.
      // V-184b can refine the UX (e.g. dedicated "your first key" step).

      const submitBtn = root.querySelector('[data-submit]');
      const labelDefault = submitBtn.querySelector('[data-label-default]');
      const labelBusy = submitBtn.querySelector('[data-label-busy]');
      function setBusy(busy) {
        submitBtn.disabled = busy;
        labelDefault.classList.toggle('hidden', busy);
        labelBusy.classList.toggle('hidden', !busy);
      }

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (submitBtn.disabled) return; // V-501 — guard against double-mint.
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const label = fd.get('label');
        setBusy(true);

        try {
          // V-501b — retry-safe: if a key was already minted in a prior
          // attempt this tab (mint succeeded but create failed → user
          // retries), reuse it instead of minting a SECOND "default" key.
          let apiKeyPlaintext = sessionStorage.getItem('ds_first_api_key_plaintext');
          if (!apiKeyPlaintext) {
            // Mint an API key with the web session. A fresh account has
            // accepted no legal docs, so this returns 409 LegalAcceptance-
            // Required; when it does, accept all pending docs inline and
            // retry once (so the customer isn't dead-ended on the CTA).
            async function mintKey() {
              return fetch(apiBaseUrl + '/v1/api-keys', {
                method: 'POST',
                headers: { 'content-type': 'application/json', authorization: 'Bearer ' + token },
                credentials: 'include',
                body: JSON.stringify({ name: 'default', scopes: ['read', 'write'] }),
              });
            }
            let mintRes = await mintKey();
            if (!mintRes.ok) {
              const errBody = await mintRes.json().catch(() => ({}));
              if (mintRes.status === 409 && errBody.type === LEGAL_ACCEPTANCE_TYPE) {
                showBanner('Recording your acceptance of our terms…');
                await acceptPendingLegal();
                banner.classList.add('hidden');
                mintRes = await mintKey();
                if (!mintRes.ok) {
                  const retryBody = await mintRes.json().catch(() => ({}));
                  throw new Error(retryBody.detail || 'mint key HTTP ' + mintRes.status);
                }
              } else {
                throw new Error(errBody.detail || 'mint key HTTP ' + mintRes.status);
              }
            }
            const apiKey = await mintRes.json();
            // Stash plaintext for the customer to copy from the
            // post-onboarding /api-keys redirect view (it's only
            // returned once).
            sessionStorage.setItem('ds_first_api_key_plaintext', apiKey.plaintext);
            apiKeyPlaintext = apiKey.plaintext;
          }

          // Create the session with the new (or reused) API key.
          const sessionRes = await fetch(apiBaseUrl + '/v1/sessions', {
            method: 'POST',
            headers: { 'content-type': 'application/json', authorization: 'Bearer ' + apiKeyPlaintext },
            credentials: 'include',
            body: JSON.stringify({ label }),
          });
          if (!sessionRes.ok) {
            const errBody = await sessionRes.json().catch(() => ({}));
            throw new Error(errBody.detail || 'create session HTTP ' + sessionRes.status);
          }
          window.location.href = '/sessions?onboarded=1';
        } catch (err) {
          setBusy(false);
          showBanner(err && err.message ? err.message : 'Failed to create first session.');
        }
      });
    })();
  </script>
</DashboardLayout>
