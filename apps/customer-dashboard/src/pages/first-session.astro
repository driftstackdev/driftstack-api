---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { LOCKED_ARCHETYPE_DISPLAY_LABEL } from '@driftstack/api-types';

// V-184a — onboarding step 5. First session creation. Tier 1 minimal
// placeholder — full Tier 3 visual UX (tutorial, embedded WebView,
// "view your first capture" CTA) lands in V-184b draft.
// V-501 — disabled-while-pending guard + clearer status copy.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="First session" withSidebar={false}>
  {/* 2026-05-23 — hero-glow atmosphere on first-session onboarding so
      the brand surface stays consistent during the high-touch first
      flow. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl px-6 py-16" data-page="first-session">
    <p class="font-mono text-xs uppercase tracking-widest text-glow-red">First session</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink-primary">
      Create your first session.
    </h1>
    <p class="mt-3 text-sm text-ink-secondary">
      A session is an iOS Safari instance running on Driftstack —
      same WebKit, same fingerprint surface as a physical iPhone.
      Give it a label so you can find it later.
    </p>
    <p class="mt-2 text-sm text-ink-secondary">
      <strong>Archetype</strong> defines the iPhone model, iOS version,
      and Safari build your session runs as. You're starting with
      <strong>{LOCKED_ARCHETYPE_DISPLAY_LABEL}</strong> — our standard
      reference profile. Higher tiers unlock more archetypes.
    </p>
    <p class="mt-2 text-xs text-ink-muted">
      We'll create your first <strong>API key</strong> in the background —
      a secret token your code uses to call the SDK. It's shown once on
      the next page; copy it somewhere safe (1Password, a git-ignored
      <code class="font-mono">.env</code>, or similar).
    </p>

    <!-- Wave 1086+ — post-checkout confirmation banner. Stripe-success
         redirects (trial-pack + subscribe) land here with ?trial=ok
         or ?subscribed=<tier>. Without an explicit confirmation the
         customer sees the generic "create your first session" form
         and wonders if their payment went through. -->
    <div
      data-post-checkout
      class="mt-6 hidden rounded-lg border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-200"
      role="status"
    >
    </div>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-glow-red/30 bg-glow-red/10 px-4 py-3 text-sm text-glow-red-soft"
      role="status"
    >
    </div>

    <form data-form="first-session" class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-ink-secondary" for="session-label">Label</label>
        <input
          id="session-label"
          name="label"
          type="text"
          required
          maxlength="120"
          placeholder="my-first-session"
          class="mt-1 w-full rounded-md border border-white/10 px-3 py-2 text-sm"
        />
      </div>
      {/* 2026-05-24 — arrow icon on submit + busy state. */}
      <button type="submit" class="btn-primary w-full inline-flex items-center justify-center gap-1.5" data-submit>
        <span data-label-default class="inline-flex items-center gap-1.5">
          Create session
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </span>
        <span data-label-busy class="hidden inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
          </svg>
          Creating…
        </span>
      </button>
    </form>

    <p class="mt-8 text-xs text-ink-muted">
      Skip this step? <a href="/" class="text-glow-red underline">Go to dashboard</a>.
    </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="first-session"]');
      if (!root) return;
      const form = root.querySelector('[data-form="first-session"]');
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Wave 1086+ — Stripe-success-redirect confirmation banner.
      // /select-tier sets success_url to /first-session?trial=ok for
      // the trial pack and /first-session?subscribed=<tier> for paid
      // tiers; without this handler the customer arrives with no
      // confirmation their payment landed.
      (function showPostCheckoutBanner() {
        const params = new URLSearchParams(window.location.search);
        const trialOk = params.get('trial') === 'ok';
        const subscribed = params.get('subscribed');
        if (!trialOk && !subscribed) return;
        const postCheckout = root.querySelector('[data-post-checkout]');
        if (!postCheckout) return;
        if (trialOk) {
          postCheckout.textContent =
            'Trial pack purchased. You have 16 hours of session time over the next 14 days. Create your first session below to get started.';
        } else if (subscribed) {
          postCheckout.textContent =
            'Subscription active — welcome. Create your first session below; your concurrent cap is set by your tier.';
        }
        postCheckout.classList.remove('hidden');
      })();

      // Defensive redirect if user landed here without a token.
      if (!token) {
        window.location.replace('/signup');
        return;
      }

      // First-session creation typically uses an API key, not a web
      // session token. V-168 makes the web-session token usable on
      // /v1/api-keys (so customer can mint a key) — but for the
      // session-creation step, a key is needed. The minimal flow:
      //   1. Mint a "default" API key via web session.
      //   2. Use that API key to create the session.
      //   3. Stash the new API key plaintext in sessionStorage so the
      //      /first-session redirect to /sessions can show it.
      // V-184b can refine the UX (e.g. dedicated "your first key" step).

      const submitBtn = root.querySelector('[data-submit]');
      const labelDefault = submitBtn.querySelector('[data-label-default]');
      const labelBusy = submitBtn.querySelector('[data-label-busy]');
      function setBusy(busy) {
        submitBtn.disabled = busy;
        labelDefault.classList.toggle('hidden', busy);
        labelBusy.classList.toggle('hidden', !busy);
      }

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (submitBtn.disabled) return; // V-501 — guard against double-mint.
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const label = fd.get('label');
        setBusy(true);

        try {
          // Mint an API key with web session.
          const mintRes = await fetch(apiBaseUrl + '/v1/api-keys', {
            method: 'POST',
            headers: { 'content-type': 'application/json', authorization: 'Bearer ' + token },
            credentials: 'include',
            body: JSON.stringify({ name: 'default', scopes: ['read', 'write'] }),
          });
          if (!mintRes.ok) {
            const errBody = await mintRes.json().catch(() => ({}));
            throw new Error(errBody.detail || 'mint key HTTP ' + mintRes.status);
          }
          const apiKey = await mintRes.json();
          // Stash plaintext for the customer to copy from the
          // post-onboarding /api-keys redirect view (it's only
          // returned once).
          sessionStorage.setItem('ds_first_api_key_plaintext', apiKey.plaintext);

          // Create the session.
          const sessionRes = await fetch(apiBaseUrl + '/v1/sessions', {
            method: 'POST',
            headers: { 'content-type': 'application/json', authorization: 'Bearer ' + apiKey.plaintext },
            credentials: 'include',
            body: JSON.stringify({ label }),
          });
          if (!sessionRes.ok) {
            const errBody = await sessionRes.json().catch(() => ({}));
            throw new Error(errBody.detail || 'create session HTTP ' + sessionRes.status);
          }
          window.location.href = '/sessions?onboarded=1';
        } catch (err) {
          setBusy(false);
          showBanner(err && err.message ? err.message : 'Failed to create first session.');
        }
      });
    })();
  </script>
</DashboardLayout>
