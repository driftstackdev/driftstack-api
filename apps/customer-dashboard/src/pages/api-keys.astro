---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-182 — progressive-enhancement wiring against /v1/api-keys.
// V-270 — wired the New-key form + revoke confirmation flow.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="API keys">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="api-keys">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="text-sm text-tk-ink-3">Bearer tokens · scoped + revocable</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">API keys</h1>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Pass as <code class="font-mono">Authorization: Bearer &lt;key&gt;</code>. Plaintext is
          shown ONCE on creation — store it now; we can't recover it later. Revocation is
          immediate.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        {/* Fleet v2 (slice 3.5) — contextual docs deep-links. */}
        <a
          href="https://docs.driftstack.dev/api/api-keys/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          Docs
        </a>
        <button type="button" class="btn-primary" data-show-create>New key</button>
      </div>
    </header>

    {/* Fleet v2 (slice 3.5) — "use it now" quickstart. A copy-paste curl +
        SDK install using a PLACEHOLDER key (ds_live_…) — never a real key
        (the one-time plaintext lives only in the reveal pane below, which
        wipes on dismiss). Links the auth + SDK references. */}
    <section class="dashboard-card mb-8">
      <div class="flex flex-wrap items-center gap-2">
        <p class="section-label">Use it now</p>
        <span class="flex-1"></span>
        <a
          href="https://docs.driftstack.dev/api/auth/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-tk-accent-text hover:underline">Auth reference →</a
        >
        <a
          href="https://docs.driftstack.dev/sdk/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-tk-accent-text hover:underline">SDKs →</a
        >
      </div>
      <pre class="mt-4 overflow-x-auto rounded-lg border border-tk-border bg-tk-code-bg px-4 py-3 font-mono text-xs text-white"><code>curl https://api.driftstack.dev/v1/account/me \
  -H "Authorization: Bearer ds_live_&lt;your-key&gt;"

# TypeScript SDK
npm i @driftstack/sdk</code></pre>
      <p class="mt-2 text-xs text-tk-ink-3">
        Replace <code class="font-mono">ds_live_&lt;your-key&gt;</code> with the key you copy on
        creation — the plaintext is shown once and never stored.
      </p>
    </section>

    <!-- V-270: Create-key form (hidden by default) -->
    <div
      data-create-form-wrap
      class="mb-8 hidden rounded-lg border border-tk-border bg-tk-surface p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="12" r="7" />
            <path d="M16 12h6M19 9v6" />
          </svg>
        </span>
        Create a new API key
      </h2>
      <form data-create-form class="mt-4 space-y-4">
        <div>
          <label for="key-name" class="block text-sm font-medium text-tk-ink-2">Name</label>
          <input
            id="key-name"
            name="name"
            type="text"
            required
            placeholder="e.g. production-server, staging-bot"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            Naming a key by purpose / environment makes leak triage faster later.
          </p>
        </div>
        <div>
          <span class="block text-sm font-medium text-tk-ink-2">Scope</span>
          <div class="mt-2 space-y-2 text-sm">
            <label class="flex items-start gap-2">
              <input
                type="radio"
                name="scope"
                value="account_owner"
                checked
                class="mt-0.5"
              />
              <span>
                <strong>account_owner</strong> — full access. Manage webhooks, billing, mint
                other keys. Choose this for keys driving the GUI client or your primary
                automation.
              </span>
            </label>
            <label class="flex items-start gap-2">
              <input type="radio" name="scope" value="write" class="mt-0.5" />
              <span>
                <strong>write</strong> — create + drive sessions; cannot mint other keys, manage
                webhooks, or change billing. Right scope for production runners.
              </span>
            </label>
            <label class="flex items-start gap-2">
              <input type="radio" name="scope" value="read" class="mt-0.5" />
              <span>
                <strong>read</strong> — list + get only. Right scope for monitoring or
                read-only integrations.
              </span>
            </label>
            <label class="flex items-start gap-2">
              <input
                type="radio"
                name="scope"
                value="granular"
                class="mt-0.5"
                data-scope-granular-radio
              />
              <span>
                <strong>granular (advanced)</strong> — pick exact per-resource permissions.
                Tightest possible attack surface for one job. Pick this for keys
                that should only touch a specific resource (e.g. monitoring that
                reads sessions but can't see billing).
              </span>
            </label>
          </div>

          <!--
            V-481 — granular scope picker. Hidden by default; reveals when
            the "granular" radio is selected. Submits the raw array of
            selected `verb:resource` scopes.
          -->
          <div
            data-granular-scopes
            class="mt-4 hidden rounded-md border border-tk-border bg-tk-bg p-4"
          >
            <p class="text-xs text-tk-ink-2">
              Pick at least one. Granular scopes do not satisfy broad checks —
              if you select <code class="font-mono">read:sessions</code> only,
              the key cannot read profiles, webhooks, or billing data. Mix with
              broad scopes if you want one key for many things.
            </p>
            <div class="mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              <fieldset>
                <legend class="font-mono text-xs uppercase tracking-wide text-tk-ink-3">
                  Sessions
                </legend>
                <label class="mt-2 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="read:sessions" />
                  <code class="font-mono text-xs">read:sessions</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="write:sessions" />
                  <code class="font-mono text-xs">write:sessions</code>
                </label>
              </fieldset>
              <fieldset>
                <legend class="font-mono text-xs uppercase tracking-wide text-tk-ink-3">
                  Profiles
                </legend>
                <label class="mt-2 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="read:profiles" />
                  <code class="font-mono text-xs">read:profiles</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="write:profiles" />
                  <code class="font-mono text-xs">write:profiles</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="admin:profiles" />
                  <code class="font-mono text-xs">admin:profiles</code>
                </label>
              </fieldset>
              <fieldset>
                <legend class="font-mono text-xs uppercase tracking-wide text-tk-ink-3">
                  Webhooks
                </legend>
                <label class="mt-2 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="read:webhooks" />
                  <code class="font-mono text-xs">read:webhooks</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="write:webhooks" />
                  <code class="font-mono text-xs">write:webhooks</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="admin:webhooks" />
                  <code class="font-mono text-xs">admin:webhooks</code>
                </label>
              </fieldset>
              <fieldset>
                <legend class="font-mono text-xs uppercase tracking-wide text-tk-ink-3">
                  API keys
                </legend>
                <label class="mt-2 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="read:api-keys" />
                  <code class="font-mono text-xs">read:api-keys</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="admin:api-keys" />
                  <code class="font-mono text-xs">admin:api-keys</code>
                </label>
              </fieldset>
              <fieldset>
                <legend class="font-mono text-xs uppercase tracking-wide text-tk-ink-3">
                  Billing
                </legend>
                <label class="mt-2 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="read:billing" />
                  <code class="font-mono text-xs">read:billing</code>
                </label>
                <label class="mt-1 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="admin:billing" />
                  <code class="font-mono text-xs">admin:billing</code>
                </label>
              </fieldset>
              <fieldset>
                <legend class="font-mono text-xs uppercase tracking-wide text-tk-ink-3">
                  Audit
                </legend>
                <label class="mt-2 flex items-center gap-2 text-sm">
                  <input type="checkbox" name="granular-scope" value="read:audit" />
                  <code class="font-mono text-xs">read:audit</code>
                </label>
              </fieldset>
            </div>
            <p class="mt-3 text-xs text-tk-accent-text" data-granular-warning hidden>
              Pick at least one granular scope.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="btn-primary" data-create-submit>Create key</button>
          <button
            type="button"
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
            data-create-cancel
          >
            Cancel
          </button>
          <span data-create-error class="hidden text-sm text-tk-err-text"></span>
        </div>
      </form>
    </div>

    <!-- V-270: Just-created key reveal (shown once, dismissible) -->
    {/* 2026-05-23 — icon on key-created success panel. */}
    <div
      data-created-reveal
      class="mb-8 hidden rounded-lg border border-tk-ready/30 bg-tk-ready/10 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ready-text">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-ready/15 ring-1 ring-tk-ready/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12l2 2 4-4" />
            <circle cx="12" cy="12" r="9" />
          </svg>
        </span>
        Key created — copy it now
      </h2>
      <p class="mt-2 text-sm text-tk-ready-text">
        This is the only time the full key is shown. Store it in your secret manager before
        dismissing.
      </p>
      <pre
        data-created-plaintext
        class="mt-4 overflow-x-auto rounded border border-tk-ready/30 bg-tk-surface px-4 py-3 font-mono text-sm text-tk-ink"></pre>
      <div class="mt-4 flex items-center gap-3">
        <button type="button" class="btn-primary" data-created-copy>Copy to clipboard</button>
        <button
          type="button"
          class="rounded-md border border-tk-ready/40 bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ready-text hover:bg-tk-ready/20"
          data-created-dismiss
        >
          Dismiss — I've saved it
        </button>
        <span data-created-copy-feedback class="hidden text-xs text-tk-ready-text">Copied.</span>
      </div>
    </div>

    <!--
      V-296b — dedicated rotate reveal pane. Mirrors the V-475 webhook
      rotate-secret pattern. Surfaces the new plaintext + grace expiry
      so the customer knows how long the OLD key keeps working.
      Replaces the previous reuse of the create-flow pane (which
      didn't surface the grace metadata).
    -->
    <div
      data-rotate-reveal
      class="mb-8 hidden rounded-lg border border-tk-accent/40 bg-tk-accent/10 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-accent-text">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/15 ring-1 ring-tk-accent/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 4 1 10 7 10" />
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
          </svg>
        </span>
        API key rotated
      </h2>
      <p class="mt-1 text-sm text-tk-accent-text">
        Copy the new plaintext now — it won't be shown again. The previous key
        keeps working for the grace window below; deploy the new key everywhere
        before then or requests using the old key will start returning 401.
      </p>
      <p class="mt-3 text-xs font-mono uppercase tracking-widest text-tk-busy-text">
        Rotated from
      </p>
      <p data-rotate-from-id class="mt-1 font-mono text-xs text-tk-ink"></p>
      <p class="mt-3 text-xs font-mono uppercase tracking-widest text-tk-busy-text">
        New plaintext
      </p>
      <pre
        data-rotate-plaintext
        class="mt-1 overflow-x-auto rounded border border-tk-accent/30 bg-tk-surface px-3 py-2 font-mono text-xs text-tk-ink"></pre>
      <p class="mt-3 text-xs font-mono uppercase tracking-widest text-tk-busy-text">
        Old key valid until
      </p>
      <p data-rotate-grace-expires class="mt-1 text-sm text-tk-ink"></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" data-rotate-copy class="btn-primary text-sm">
          Copy plaintext
        </button>
        <button type="button" data-rotate-dismiss class="btn-secondary text-sm">
          I've saved it
        </button>
        <span data-rotate-copy-feedback class="hidden text-xs text-tk-accent-text"
          >Copied.</span
        >
      </div>
    </div>

    <!-- Security notice -->
    <div
      class="mb-6 flex gap-3 rounded-lg border border-tk-accent/30 bg-tk-accent/10 px-4 py-3 text-sm text-tk-accent-text"
    >
      <span class="font-mono text-xs uppercase">!</span>
      <p>
        API keys are scrypt-hashed at rest. Driftstack staff cannot read your keys — a database
        breach surfaces hashes, not keys. If a key leaks, revoke + rotate; no admin recovery
        path exists.
      </p>
    </div>

    {/*
      2026-05-21 — empty state hidden by default; list renders skeleton
      <li> placeholders SSR. JS hydration on /v1/api-keys replaces them
      with real keys (or reveals the empty state when the list is empty).
      Pre-hydration the customer no longer sees fake scaffolding key
      names from MOCK_API_KEYS, just a loading skeleton.
    */}
    {/* 2026-05-22 — empty state with icon + warmer framing. */}
    <div data-empty class="dashboard-card hidden text-center">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="12" r="7" />
          <path d="M16 12h6M19 9v6" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold tracking-tight text-tk-ink">No API keys yet</h2>
      <p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">
        Create a key to start driving sessions from your code. Most customers create one key per
        environment (dev / staging / prod) — scopes are key-level, so a leaked dev key can't
        touch prod state.
      </p>
      <button type="button" class="btn-primary mt-6 inline-flex" data-show-create>
        Create your first key
      </button>
    </div>
    <ul
      data-list
      class="divide-y divide-tk-border rounded-lg border border-tk-border bg-tk-surface"
    >
      {[0, 1].map(() => (
        <li data-skeleton="true" class="px-6 py-4" aria-hidden="true">
          <div class="flex items-start justify-between gap-6">
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-4 w-44 animate-pulse rounded bg-tk-hover" />
              <div class="h-3 w-72 animate-pulse rounded bg-tk-hover" />
              <div class="h-3 w-56 animate-pulse rounded bg-tk-hover" />
            </div>
            <div class="h-6 w-32 shrink-0 animate-pulse rounded bg-tk-hover" />
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-xs text-tk-ink-3">
      Scopes: <code class="font-mono">read</code> (list/get-only),
      <code class="font-mono">write</code> (create sessions, navigate, interact),
      <code class="font-mono">account_owner</code> (manage webhooks, billing, mint other keys).
      Always create the narrowest-scoped key the job needs.
    </p>
  </div>

  <!--
 + — progressive-enhancement script. Reads
    ds_web_session_token from localStorage, fetches /v1/api-keys,
    replaces the key list with live data. Wires the New-key form
    POST + revoke DELETE flows.
  -->
  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="api-keys"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const ul = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const formWrap = root.querySelector('[data-create-form-wrap]');
      const form = root.querySelector('[data-create-form]');
      const createSubmit = root.querySelector('[data-create-submit]');
      const createCancel = root.querySelector('[data-create-cancel]');
      const createError = root.querySelector('[data-create-error]');
      const reveal = root.querySelector('[data-created-reveal]');
      const revealPre = root.querySelector('[data-created-plaintext]');
      const revealCopy = root.querySelector('[data-created-copy]');
      const revealCopyFb = root.querySelector('[data-created-copy-feedback]');
      const revealDismiss = root.querySelector('[data-created-dismiss]');
      const showCreateBtns = root.querySelectorAll('[data-show-create]');
      const token = localStorage.getItem('ds_web_session_token');
      const API_KEY_TIMEOUT_MS = 15_000;
      const mutationButtonsInFlight = new WeakSet();
      const mutationKeyIdsInFlight = new Set();
      const ambiguousRevokeIds = new Set();
      const ambiguousRotateIds = new Set();
      let keySnapshot = [];
      let createInFlight = false;
      let createOutcomeBlocked = false;
      let createOutcomeReason = '';
      let refreshController = null;
      let refreshGeneration = 0;

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      const SCOPE_LABEL = {
        read: 'read',
        write: 'write',
        admin: 'admin',
        account_owner: 'account_owner',
        driftstack_internal_admin: 'internal_admin',
        gui_control: 'gui',
      };

      function fmtIso(iso) {
        if (!iso) return 'never';
        const d = new Date(iso);
        const now = new Date();
        const diffMs = now.getTime() - d.getTime();
        // S35 2026-07-07 (fable-frontend-audit) — FUTURE timestamps (a
        // rotated key's grace expiry is now+24h) used to hit the floor()d
        // day math and render "-1 days ago" for the whole grace window.
        // Keep future grace deadlines readable instead of rendering negative
        // "days ago" values while a rotated key is still valid.
        if (diffMs < 0) {
          const aheadHours = Math.floor(-diffMs / (1000 * 60 * 60));
          if (aheadHours < 1) return 'in <1h';
          if (aheadHours < 48) return 'in ' + aheadHours + 'h';
          const aheadDays = Math.floor(aheadHours / 24);
          if (aheadDays < 30) return 'in ' + aheadDays + ' days';
          return d.toISOString().slice(0, 10);
        }
        const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        if (diffDays === 0) return 'today';
        if (diffDays === 1) return 'yesterday';
        if (diffDays < 30) return diffDays + ' days ago';
        return d.toISOString().slice(0, 10);
      }

      function keyLi(k) {
        const isRevoked = k.revoked_at !== null && k.revoked_at !== undefined;
        const mutationInFlight = mutationKeyIdsInFlight.has(String(k.id));
        const revokeOutcomeUnknown = ambiguousRevokeIds.has(String(k.id));
        const rotateOutcomeUnknown = ambiguousRotateIds.has(String(k.id));
        const rotateDisabledAttributes =
          mutationInFlight || revokeOutcomeUnknown || rotateOutcomeUnknown
            ? ' disabled aria-disabled="true"'
            : '';
        const rotateDisabledClass =
          mutationInFlight || revokeOutcomeUnknown || rotateOutcomeUnknown
            ? ' cursor-not-allowed opacity-60'
            : '';
        const revokeDisabledAttributes = mutationInFlight || revokeOutcomeUnknown
          ? ' disabled aria-disabled="true"'
          : '';
        const revokeDisabledClass = mutationInFlight || revokeOutcomeUnknown
          ? ' cursor-not-allowed opacity-60'
          : '';
        const scopes = (k.scopes || [])
          .map(
            (s) =>
              '<span class="rounded bg-tk-surface px-2 py-0.5 font-mono text-xs text-tk-ink-2">' +
              escapeHtml(SCOPE_LABEL[s] || s) +
              '</span>',
          )
          .join('');
        const revokeAction = isRevoked
          ? '<span class="rounded-full bg-tk-surface px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-ink-2">revoked ' +
            escapeHtml(fmtIso(k.revoked_at)) +
            '</span>'
          : '<div class="flex items-center gap-3">' +
            '<button type="button" data-rotate="' +
            escapeHtml(k.id) +
            '" data-rotate-name="' +
            escapeHtml(k.name) +
            '"' +
            rotateDisabledAttributes +
            ' class="text-sm text-tk-accent-text hover:underline' +
            rotateDisabledClass +
            '">' +
            (rotateOutcomeUnknown ? 'Rotation outcome unknown' : 'Rotate') +
            '</button>' +
            '<button type="button" data-revoke="' +
            escapeHtml(k.id) +
            '" data-revoke-name="' +
            escapeHtml(k.name) +
            '"' +
            revokeDisabledAttributes +
            ' class="text-sm text-tk-err-text hover:underline' +
            revokeDisabledClass +
            '">' +
            (revokeOutcomeUnknown ? 'Check status' : 'Revoke') +
            '</button>' +
            '</div>';
        return (
          '<li class="px-6 py-4">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-tk-ink">' +
          escapeHtml(k.name) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-2">' +
          escapeHtml(k.key_prefix) +
          '<span class="text-tk-ink-3">…<span aria-hidden="true">' +
          '•'.repeat(24) +
          '</span></span></p>' +
          '<p class="mt-2 text-xs text-tk-ink-3">Created ' +
          escapeHtml(fmtIso(k.created_at)) +
          ' · last used ' +
          escapeHtml(fmtIso(k.last_used_at)) +
          (k.expires_at
            ? ' · <span class="text-tk-accent-text">grace ends ' +
              escapeHtml(fmtIso(k.expires_at)) +
              '</span>'
            : '') +
          '</p></div>' +
          '<div class="flex shrink-0 flex-col items-end gap-3">' +
          '<div class="flex flex-wrap gap-1">' +
          scopes +
          '</div>' +
          revokeAction +
          '</div></div></li>'
        );
      }

      function keyMutationButtons(keyId) {
        if (!ul) return [];
        return Array.from(ul.querySelectorAll('[data-rotate], [data-revoke]')).filter(
          (button) =>
            button.getAttribute('data-rotate') === keyId ||
            button.getAttribute('data-revoke') === keyId,
        );
      }

      function beginKeyMutation(keyId) {
        if (!keyId || mutationKeyIdsInFlight.has(keyId)) return false;
        mutationKeyIdsInFlight.add(keyId);
        keyMutationButtons(keyId).forEach((button) => {
          button.disabled = true;
          button.setAttribute('aria-disabled', 'true');
          button.setAttribute('title', 'Wait for the active API key action to finish.');
        });
        return true;
      }

      function endKeyMutation(keyId) {
        mutationKeyIdsInFlight.delete(keyId);
        keyMutationButtons(keyId).forEach((button) => {
          const isRotate = button.hasAttribute('data-rotate');
          const blocked =
            ambiguousRevokeIds.has(keyId) || (isRotate && ambiguousRotateIds.has(keyId));
          button.disabled = blocked;
          if (blocked) {
            button.setAttribute('aria-disabled', 'true');
          } else {
            button.removeAttribute('aria-disabled');
          }
          button.removeAttribute('title');
        });
      }

      function refresh() {
        if (!token) return;
        if (refreshController) refreshController.abort();
        const controller = new AbortController();
        refreshController = controller;
        const generation = ++refreshGeneration;
        const isCurrent = () => generation === refreshGeneration;
        const timeout = window.setTimeout(() => controller.abort(), API_KEY_TIMEOUT_MS);
        return fetch(apiBaseUrl + '/v1/api-keys', {
          headers: { authorization: 'Bearer ' + token },
          signal: controller.signal,
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (!isCurrent()) return;
            const keys = body.data || [];
            keySnapshot = keys;
            if (keys.length === 0) {
              ul.classList.add('hidden');
              empty.classList.remove('hidden');
            } else {
              empty.classList.add('hidden');
              ul.classList.remove('hidden');
              ul.innerHTML = keys.map(keyLi).join('');
              wireRevokeButtons();
              wireRotateButtons();
            }
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (!isCurrent()) return;
            showBanner(
              err && err.name === 'AbortError'
                ? "Loading API keys took too long. Check your connection and retry."
                : "Couldn't load live API keys (" +
                  (err && err.message ? err.message : 'network error') +
                  ').',
            );
            return false;
          })
          .finally(function () {
            window.clearTimeout(timeout);
            if (!isCurrent()) return;
            refreshController = null;
            // 2026-05-21 — signal the layout's opacity-gate that the
            // /v1/api-keys fetch resolved (success or failure).
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function lockRotateAction(id, completed) {
        ambiguousRotateIds.add(String(id));
        const button = Array.from(ul.querySelectorAll('[data-rotate]')).find(
          (candidate) => candidate.getAttribute('data-rotate') === String(id),
        );
        if (!button) return;
        button.disabled = true;
        button.textContent = completed ? 'Rotation completed — key lost' : 'Verify before rotating';
        button.setAttribute(
          'title',
          completed
            ? 'Revoke the newly matched key before rotating this key again.'
            : 'Reload and verify the key list before rotating again.',
        );
      }

      async function reconcileAmbiguousMutation(kind, name, keyIdsBefore, sourceId = '') {
        const refreshed = Boolean(await refresh());
        const matchingKey =
          refreshed &&
          keySnapshot.find(
            (key) =>
              key.id && !keyIdsBefore.has(key.id) && String(key.name || '') === String(name),
          );
        if (kind === 'create') {
          if (matchingKey) {
            createOutcomeBlocked = true;
            createOutcomeReason = 'created';
          } else if (!refreshed) {
            createOutcomeBlocked = true;
            createOutcomeReason = 'unverified';
          }
          return (
            'Key creation timed out after the request was sent, so its outcome is unknown. ' +
            (matchingKey
              ? 'The refreshed list contains a new “' +
                name +
                '” key, so creation likely completed but its plaintext cannot be recovered; revoke it before creating another key.'
              : refreshed
                ? 'The refreshed authoritative list has no new “' +
                  name +
                  '” key; retry only if the key is still required.'
                : 'The key list could not be refreshed. Reload and verify it before retrying; another submission could create a second unrecoverable key.')
          );
        }
        if (matchingKey || !refreshed) lockRotateAction(sourceId, Boolean(matchingKey));
        return (
          'Key rotation timed out after the request was sent, so its outcome is unknown. ' +
          (matchingKey
            ? 'The refreshed list contains a new “' +
              name +
              '” successor, so rotation likely completed but its plaintext cannot be recovered; revoke that new key before rotating again.'
            : refreshed
              ? 'The refreshed authoritative list has no new “' +
                name +
                '” successor; retry only if rotation is still required.'
              : 'The key list could not be refreshed. Reload and verify it before rotating again; another rotation could replace an unrecoverable key.')
        );
      }

      async function reconcileAmbiguousRevoke(id, name) {
        const keyId = String(id || '');
        ambiguousRevokeIds.add(keyId);
        const refreshed = Boolean(await refresh());
        if (!refreshed) {
          return (
            'Key revocation timed out after the request was sent, so its outcome is unknown. ' +
            'The key list could not be refreshed. Do not revoke “' +
            name +
            '” again on this page. Reload API Keys later to verify its status before retrying.'
          );
        }
        const stillActive = Array.from(ul.querySelectorAll('[data-revoke]')).some(
          (button) => button.getAttribute('data-revoke') === keyId,
        );
        if (stillActive) {
          return (
            'Key revocation timed out after the request was sent, so its outcome is unknown. ' +
            'The refreshed list still shows “' +
            name +
            '” as active, but completion may be delayed. Do not revoke it again on this page. ' +
            'Wait, then reload API Keys; retry only if it still appears active.'
          );
        }
        return (
          'Key revocation timed out after the request was sent, so its outcome is unknown. ' +
          'The refreshed list no longer shows “' +
          name +
          '” as active. Revocation likely completed; do not revoke it again.'
        );
      }

      window.addEventListener('pagehide', () => {
        refreshGeneration += 1;
        if (refreshController) refreshController.abort();
        refreshController = null;
      });

      function wireRevokeButtons() {
        const buttons = ul.querySelectorAll('[data-revoke]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-revoke');
            if (ambiguousRevokeIds.has(String(id || ''))) return;
            if (mutationButtonsInFlight.has(btn)) return;
            if (!id || !beginKeyMutation(id)) return;
            mutationButtonsInFlight.add(btn);
            const name = btn.getAttribute('data-revoke-name') || '(unnamed)';
            const ok = await window.driftstackConfirm(
              'Revoke "' +
                name +
                '"? Apps using this key will start receiving 401 immediately. This cannot be undone.',
              { confirmLabel: 'Revoke', destructive: true },
            );
            if (!ok) {
              mutationButtonsInFlight.delete(btn);
              endKeyMutation(id);
              return;
            }
            btn.disabled = true;
            btn.setAttribute('aria-busy', 'true');
            btn.textContent = 'Revoking…';
            const controller = new AbortController();
            const timeout = window.setTimeout(() => controller.abort(), API_KEY_TIMEOUT_MS);
            fetch(apiBaseUrl + '/v1/api-keys/' + encodeURIComponent(id), {
              method: 'DELETE',
              headers: { authorization: 'Bearer ' + token },
              signal: controller.signal,
            })
              .then((r) => {
                if (!r.ok && r.status !== 204) {
                  return r
                    .json()
                    .catch(() => ({}))
                    .then((b) =>
                      Promise.reject(new Error(b.detail || 'HTTP ' + r.status)),
                    );
                }
                return refresh();
              })
              .catch(async (err) => {
                if (err && err.name === 'AbortError') {
                  showBanner(await reconcileAmbiguousRevoke(id, name));
                  return;
                }
                showBanner(
                  'Revoke failed: ' + (err && err.message ? err.message : 'network error'),
                );
              })
              .finally(() => {
                window.clearTimeout(timeout);
                mutationButtonsInFlight.delete(btn);
                const outcomeUnknown = ambiguousRevokeIds.has(String(id || ''));
                btn.disabled = outcomeUnknown;
                btn.setAttribute('aria-busy', 'false');
                btn.textContent = outcomeUnknown ? 'Check status' : 'Revoke';
                endKeyMutation(id);
              });
          });
        });
      }

      // V-296b — dedicated rotate-reveal pane wiring (mirrors V-475
      // webhook rotate-secret pattern). Replaces the earlier reuse of
      // the create-flow pane.
      const rotateReveal = root.querySelector('[data-rotate-reveal]');
      const rotatePlaintext = root.querySelector('[data-rotate-plaintext]');
      const rotateFromId = root.querySelector('[data-rotate-from-id]');
      const rotateGraceEl = root.querySelector('[data-rotate-grace-expires]');
      const rotateCopyBtn = root.querySelector('[data-rotate-copy]');
      const rotateDismissBtn = root.querySelector('[data-rotate-dismiss]');
      const rotateCopyFb = root.querySelector('[data-rotate-copy-feedback]');

      function showRotateReveal(rotatedFromId, plaintext, graceExpiresAt) {
        if (!rotateReveal || !rotatePlaintext) return;
        if (rotateFromId) rotateFromId.textContent = rotatedFromId || '—';
        rotatePlaintext.textContent = plaintext || '';
        if (rotateGraceEl) {
          rotateGraceEl.textContent = graceExpiresAt
            ? new Date(graceExpiresAt).toLocaleString()
            : '—';
        }
        if (rotateCopyFb) rotateCopyFb.classList.add('hidden');
        rotateReveal.classList.remove('hidden');
        rotateReveal.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function hideRotateReveal() {
        if (!rotateReveal || !rotatePlaintext) return;
        rotateReveal.classList.add('hidden');
        // Wipe plaintext from DOM so it isn't recoverable post-dismiss.
        rotatePlaintext.textContent = '';
        if (rotateFromId) rotateFromId.textContent = '';
        if (rotateGraceEl) rotateGraceEl.textContent = '';
      }

      if (rotateDismissBtn) rotateDismissBtn.addEventListener('click', hideRotateReveal);
      if (rotateCopyBtn) {
        rotateCopyBtn.addEventListener('click', () => {
          if (!rotatePlaintext) return;
          const plaintext = rotatePlaintext.textContent || '';
          if (!plaintext) return;
          navigator.clipboard
            .writeText(plaintext)
            .then(() => {
              if (rotateCopyFb) rotateCopyFb.classList.remove('hidden');
              window.setTimeout(() => {
                if (rotateCopyFb) rotateCopyFb.classList.add('hidden');
              }, 2000);
            })
            .catch(() => {
              showBanner('Copy failed. Select the plaintext manually.');
            });
        });
      }

      function wireRotateButtons() {
        const buttons = ul.querySelectorAll('[data-rotate]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-rotate');
            const name = btn.getAttribute('data-rotate-name') || '(unnamed)';
            if (mutationButtonsInFlight.has(btn)) return;
            if (!id || !beginKeyMutation(id)) return;
            mutationButtonsInFlight.add(btn);
            if (ambiguousRotateIds.has(String(id || ''))) {
              mutationButtonsInFlight.delete(btn);
              endKeyMutation(id);
              showBanner(
                'Rotation is locked because the previous outcome was confirmed or could not be verified. Reload and review the key list before rotating again.',
              );
              return;
            }
            const keyIdsBefore = new Set(keySnapshot.map((key) => key.id));
            const ok = await window.driftstackConfirm(
              'Rotate "' +
                name +
                '"? A new plaintext is shown ONCE; the old key keeps working for a 24h grace period so you can swap deployments without downtime.',
              { confirmLabel: 'Rotate', destructive: true },
            );
            if (!ok) {
              mutationButtonsInFlight.delete(btn);
              endKeyMutation(id);
              return;
            }
            btn.disabled = true;
            btn.setAttribute('aria-busy', 'true');
            btn.textContent = 'Rotating…';
            const controller = new AbortController();
            const timeout = window.setTimeout(() => controller.abort(), API_KEY_TIMEOUT_MS);
            fetch(apiBaseUrl + '/v1/api-keys/' + encodeURIComponent(id) + '/rotate', {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                'content-type': 'application/json',
              },
              body: '{}',
              signal: controller.signal,
            })
              .then((r) => {
                if (!r.ok) {
                  return r
                    .json()
                    .catch(() => ({}))
                    .then((b) =>
                      Promise.reject(new Error(b.detail || 'HTTP ' + r.status)),
                    );
                }
                return r.json();
              })
              .then((body) => {
                // V-296b — surface the rotated_from + grace_period_ends_at
                // fields the response carries; not just the plaintext.
                showRotateReveal(
                  body.rotated_from || '',
                  body.plaintext || '',
                  body.grace_period_ends_at || '',
                );
                return refresh();
              })
              .catch(async (err) => {
                if (err && err.name === 'AbortError') {
                  showBanner(
                    await reconcileAmbiguousMutation('rotate', name, keyIdsBefore, id),
                  );
                  return;
                }
                showBanner(
                  'Rotate failed: ' + (err && err.message ? err.message : 'network error'),
                );
              })
              .finally(() => {
                window.clearTimeout(timeout);
                mutationButtonsInFlight.delete(btn);
                const outcomeUnknown = ambiguousRotateIds.has(String(id || ''));
                btn.disabled = outcomeUnknown;
                btn.setAttribute('aria-busy', 'false');
                btn.textContent = outcomeUnknown ? 'Verify before rotating' : 'Rotate';
                endKeyMutation(id);
              });
          });
        });
      }

      function showCreate() {
        if (!token) {
          showBanner('Sign in to create API keys.');
          return;
        }
        formWrap.classList.remove('hidden');
        reveal.classList.add('hidden');
        // WIPE the previously-minted plaintext key from the DOM — hiding the
        // reveal pane left the full secret recoverable via devtools/extensions
        // until navigation, defeating the show-once guarantee.
        if (revealPre) revealPre.textContent = '';
        const nameInput = form.querySelector('input[name="name"]');
        if (nameInput) nameInput.focus();
      }

      function hideCreate() {
        // Deliberately does NOT touch the reveal pane (revealPre/reveal) —
        // the create-success path calls hideCreate() to close the FORM
        // right after populating the reveal with the new plaintext key, so
        // wiping it here would erase a secret the customer hasn't seen yet.
        // showCreate() already wipes any STALE reveal on reopen, and the
        // dedicated dismiss handler wipes it on explicit dismiss — this
        // function only ever owns the form's own visibility/error/fields.
        formWrap.classList.add('hidden');
        createError.classList.add('hidden');
        createError.textContent = '';
        form.reset();
      }

      showCreateBtns.forEach((btn) => btn.addEventListener('click', showCreate));
      createCancel.addEventListener('click', hideCreate);

      // V-481 — show/hide the granular scope picker when the
      // "granular" radio is selected.
      const granularPanel = root.querySelector('[data-granular-scopes]');
      const granularWarning = root.querySelector('[data-granular-warning]');
      const scopeRadios = form.querySelectorAll('input[name="scope"]');
      scopeRadios.forEach((radio) => {
        radio.addEventListener('change', () => {
          if (!granularPanel) return;
          if (radio.value === 'granular' && radio.checked) {
            granularPanel.classList.remove('hidden');
          } else if (radio.checked) {
            granularPanel.classList.add('hidden');
            if (granularWarning) granularWarning.hidden = true;
          }
        });
      });

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        if (createInFlight) return;
        if (createOutcomeBlocked) {
          createError.textContent =
            createOutcomeReason === 'created'
              ? 'This key was likely created, but its one-shot plaintext was lost with the timed-out response. Revoke the matching key before creating another.'
              : 'Key creation is locked because the prior outcome could not be verified. Reload and review the key list before retrying.';
          createError.classList.remove('hidden');
          return;
        }
        createError.classList.add('hidden');
        createError.textContent = '';
        const fd = new FormData(form);
        const name = (fd.get('name') || '').toString().trim();
        const scope = (fd.get('scope') || 'account_owner').toString();
        if (!name) return;

        // V-481 — granular submission resolves to the array of checked
        // checkbox values; broad submission resolves to a single scope.
        let scopes;
        if (scope === 'granular') {
          scopes = fd.getAll('granular-scope').map((v) => v.toString());
          if (scopes.length === 0) {
            if (granularWarning) granularWarning.hidden = false;
            return;
          }
          if (granularWarning) granularWarning.hidden = true;
        } else {
          scopes = [scope];
        }

        createInFlight = true;
        const keyIdsBefore = new Set(keySnapshot.map((key) => key.id));
        createSubmit.disabled = true;
        createSubmit.setAttribute('aria-busy', 'true');
        createSubmit.textContent = 'Creating…';
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), API_KEY_TIMEOUT_MS);
        fetch(apiBaseUrl + '/v1/api-keys', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            authorization: 'Bearer ' + token,
          },
          body: JSON.stringify({ name: name, scopes: scopes }),
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) =>
                    Promise.reject(new Error(b.detail || 'HTTP ' + r.status)),
                  ),
          )
          .then((body) => {
            // Show the plaintext one-shot reveal.
            revealPre.textContent = body.plaintext || '';
            reveal.classList.remove('hidden');
            hideCreate();
            return refresh();
          })
          .catch(async (err) => {
            createError.textContent =
              err && err.name === 'AbortError'
                ? await reconcileAmbiguousMutation('create', name, keyIdsBefore)
                : err && err.message
                  ? err.message
                  : 'Create failed.';
            createError.classList.remove('hidden');
          })
          .finally(() => {
            window.clearTimeout(timeout);
            createInFlight = false;
            createSubmit.disabled = createOutcomeBlocked;
            createSubmit.setAttribute('aria-busy', 'false');
            createSubmit.textContent = createOutcomeBlocked
              ? createOutcomeReason === 'created'
                ? 'Already created'
                : 'Verify before retrying'
              : 'Create key';
            if (createOutcomeBlocked) {
              createSubmit.setAttribute(
                'title',
                createOutcomeReason === 'created'
                  ? 'Revoke the newly matched key before creating another.'
                  : 'Reload and verify the key list before retrying.',
              );
            } else {
              createSubmit.removeAttribute('title');
            }
          });
      });

      revealCopy.addEventListener('click', () => {
        const value = revealPre.textContent || '';
        if (!value) return;
        navigator.clipboard
          .writeText(value)
          .then(() => {
            revealCopyFb.classList.remove('hidden');
            window.setTimeout(() => revealCopyFb.classList.add('hidden'), 2000);
          })
          .catch(() => {
            revealCopyFb.textContent = 'Copy failed — select + copy manually.';
            revealCopyFb.classList.remove('hidden');
          });
      });

      revealDismiss.addEventListener('click', () => {
        revealPre.textContent = '';
        reveal.classList.add('hidden');
      });

      if (!token) {
        showBanner('Sign in to see live API keys. Showing preview data below.');
        return;
      }

      void refresh();
    })();
  </script>
</DashboardLayout>
