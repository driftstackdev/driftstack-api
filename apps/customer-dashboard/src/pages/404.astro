---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="404" withSidebar={false}>
  <div class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-900">Page not found.</h1>
    <p class="mt-4 text-slate-600">
      The page you were looking for has moved or doesn't exist.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="btn-primary">Back to dashboard</a>
    </div>
  </div>
</DashboardLayout>
