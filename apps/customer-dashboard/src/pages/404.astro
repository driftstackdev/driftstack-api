---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="404" withSidebar={false}>
  {/* 2026-05-24 — hero-glow atmosphere on /404 matches brand surface. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-tk-ink">Page not found.</h1>
    <p class="mt-4 text-tk-ink-2">
      The page you were looking for has moved or doesn't exist.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="btn-primary">Back to dashboard</a>
      <a href="https://docs.driftstack.io" class="btn-secondary">Browse the docs</a>
    </div>
    <p class="mt-6 text-sm text-tk-ink-3">
      Stuck? Email <a
        href="mailto:support@driftstack.dev"
        class="text-tk-accent-text underline underline-offset-4">support@driftstack.dev</a
      > — a human reads it.
    </p>
    </div>
  </div>
</DashboardLayout>
