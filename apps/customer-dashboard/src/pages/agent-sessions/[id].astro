---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { resolveApiBaseUrl } from '../../lib/api-base-url';

// v2-#8 Wave 29-NNN ARC 3 — AI chat + manual side-by-side LIVE
// per-session workbench. Slice 2 scaffold per the design doc at
// docs/internal/ai-chat-manual-side-by-side-design.md (founder
// verdicts A/C/A/A/A LOCKED 2026-05-19).
//
// Split-screen workbench:
//   LEFT  — LiveKit browser-stream preview + ManualControlOverlay
//           (mouse/touch on the video translates to /v1/sessions/:id/
//           input-event POST in Manual / Pair mode; LK.6 wire shape).
//   RIGHT — AI chat panel (mode toggle / transcript / composer).
//
// Modes (per the design doc):
//   manual — human drives via overlay; AI observes only.
//   ai     — AgentRuntime drives via decompose loop.
//   pair   — both; AI pauses on customer takeover, resumes on handback.
//
// Verdict Q1 (transport): SSE on /v1/agent-sessions/:id/stream for
// transcript; POST /v1/agent-sessions/:id/message for customer input.
//
// Verdict Q3 (state): agent_sessions.pair_mode_state JSONB column —
// canonical mode + last_action_at + last_actor live there; Slice 5
// wires conflict resolution.
//
// Verdict Q5 (cost): hide actual per-turn cost in the customer-facing
// footer (operator-only audit-log surface only).
//
// Slice 2 SCAFFOLD scope (this file):
//   - Layout structure + Tailwind classes
//   - Mode toggle UI (client-side state only — backend wiring in Slice 3)
//   - Transcript placeholder (SSE wiring in Slice 4)
//   - Input event overlay placeholder (POST wiring in Slice 4)
//   - Mock data fallback so the page renders even when the agent_
//     session id doesn't exist yet (development affordance)
//
// Real harness integration lands when Agent 1's Swift harness end-
// to-end ships (per ORCHESTRATOR-STATE.md 2026-05-19 harness Option A
// verdict — 6-9 weeks Agent 1 work post §10/§11+EG-WK close).

// Astro dynamic-route mode: SSR not SSG. The page is rendered at
// request time and the client script hydrates from GET /v1/agent-
// sessions/:id (Slice 3) — there's no list of paths to enumerate at
// build time. Without this flag astro build fails with
// GetStaticPathsRequired.
export const prerender = false;

const { id } = Astro.params;
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title={`Agent session ${id ?? ''}`}>
  <div class="h-screen flex flex-col bg-slate-950" data-page="agent-session-workbench" data-session-id={id}>
    {/* 2026-05-22 — header overhaul. Richer info bar: back link +
        session-title block + cost + intent count + model badge +
        status pill. Replaces the single-line "Agent session / id"
        treatment that read as a debug page. */}
    <header class="border-b border-slate-800 bg-gradient-to-r from-slate-950 to-slate-900 px-6 py-4 flex items-center gap-6">
      <a href="/agent-sessions" class="flex items-center gap-1 text-sm text-ink-muted hover:text-ink-primary">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        All sessions
      </a>
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline gap-3">
          <h1 class="text-lg font-semibold text-ink-primary">AI agent workbench</h1>
          <button
            type="button"
            data-copy-session-id
            data-id={id}
            class="group inline-flex items-center gap-1 text-xs text-ink-muted font-mono truncate hover:text-glow-red"
            title="Copy session id"
          >
            <span>{id}</span>
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </button>
        </div>
        <p class="mt-0.5 text-xs text-ink-muted">
          Plain-English tasks → agent plans intents → your browser drives them, in real time
        </p>
      </div>
      <div class="flex items-center gap-3 text-xs">
        <div class="flex items-center gap-1.5 rounded-md border border-white/10 bg-surface-raised/40 px-3 py-1.5">
          <span class="text-ink-muted">Cost</span>
          <span class="font-mono text-ink-primary" data-header-cost>$0.0000</span>
        </div>
        <div class="flex items-center gap-1.5 rounded-md border border-white/10 bg-surface-raised/40 px-3 py-1.5">
          <span class="text-ink-muted">Turns</span>
          <span class="font-mono text-ink-primary" data-header-turns>0</span>
        </div>
        <div data-header-model class="hidden items-center gap-1.5 rounded-md border border-white/10 bg-surface-raised/40 px-3 py-1.5">
          <span class="text-ink-muted">Model</span>
          <span class="font-mono text-ink-primary text-[10px]" data-header-model-name>—</span>
        </div>
        <div data-status-pill class="rounded-md bg-slate-800 px-3 py-1.5 font-mono uppercase tracking-wide text-slate-300">
          Loading…
        </div>
      </div>
    </header>

    {/* 2026-05-22 — chat now dominant (60%); live preview secondary
        (40%). Was 50/50 which made the chat feel cramped given how
        info-rich a turn can be. */}
    <main class="flex-1 grid grid-cols-[1fr_42%] gap-0 overflow-hidden" data-component="SplitScreen">
      {/* DOM order keeps LeftPanel first for the JS handlers that
          query by data-component name; CSS `order-2` flips it
          visually to the right (smaller) column. */}
      <section
        class="order-2 border-l border-slate-800 bg-slate-950 flex flex-col"
        data-component="LeftPanel"
        aria-label="Live browser preview"
      >
        <div class="flex items-center justify-between border-b border-slate-800 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-ink-muted font-medium">
            Live preview
          </p>
          {/* 2026-05-22 — connection pill. Drives `data-preview-state`
              from the LiveKit JS SDK wire-up (V-666.AI-D slice).
              States: connecting (amber pulse) / streaming (emerald) /
              offline (slate). */}
          <span
            data-preview-state="connecting"
            class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide text-amber-300"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            Connecting
          </span>
        </div>
        <div
          class="flex-1 relative flex items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 overflow-hidden"
          data-component="LiveKitPreview"
          data-session-id={id}
        >
          {/* Placeholder layout: branded screen-icon + subtle scan-line
              animation + dynamic status text. Replaced by the LiveKit
              video element when the harness lands. */}
          <div class="text-center px-6">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-xl bg-glow-red/10 ring-1 ring-glow-red/30">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-glow-red" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
            </div>
            <p class="mt-4 text-sm font-medium text-ink-primary">
              Provisioning live preview
            </p>
            <p class="mt-1 text-xs text-ink-muted max-w-[18rem]">
              Your customer's browser stream appears here once the agent
              spawns the headless harness. You'll see clicks, scrolls,
              and form fills in real time.
            </p>
          </div>
          <!-- ManualControlOverlay: transparent click-capture div on top
               of LiveKit video in Manual/Pair mode. POSTs input events
               to /v1/sessions/:id/input-event (LK.6 wire shape). Wired
               in Slice 4. -->
          <div
            data-component="ManualControlOverlay"
            class="absolute inset-0 pointer-events-none"
            data-overlay-enabled="false"
          ></div>
        </div>
      </section>

      {/* DOM second; CSS order-1 puts it left (dominant column). */}
      <section class="order-1 bg-slate-950 flex flex-col" data-component="RightPanel" aria-label="AI chat">
        {/* 2026-05-22 — mode toggle row with bigger pills + icons +
            descriptive sub-labels. Each mode now has a small caption
            explaining what it does (manual = you click; ai = agent
            plans; pair = both). ModeStatus stays in the right slot
            but with a status dot. */}
        <div
          class="px-6 py-4 border-b border-slate-800 flex items-center gap-4"
          data-component="ChatHeader"
        >
          <div
            class="inline-flex bg-slate-900/80 rounded-lg p-1 text-xs border border-slate-800"
            data-component="ModeToggle"
            role="radiogroup"
            aria-label="Session mode"
          >
            <button
              data-mode="manual"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-slate-400 hover:text-ink-primary data-[active=true]:bg-slate-700 data-[active=true]:text-ink-primary"
              aria-checked="false"
              role="radio"
              title="You drive — agent doesn't plan or act"
            >
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 11l3 3 8-8M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
              </svg>
              Manual
            </button>
            <button
              data-mode="ai"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-slate-400 hover:text-ink-primary data-[active=true]:bg-slate-700 data-[active=true]:text-ink-primary"
              data-active="true"
              aria-checked="true"
              role="radio"
              title="Agent plans + drives autonomously"
            >
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
              </svg>
              AI
            </button>
            <button
              data-mode="pair"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-slate-400 hover:text-ink-primary data-[active=true]:bg-slate-700 data-[active=true]:text-ink-primary"
              aria-checked="false"
              role="radio"
              title="Agent suggests; you approve each step"
            >
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="7" r="4" />
                <circle cx="17" cy="11" r="3" />
                <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2M14 21v-1a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v1" />
              </svg>
              Pair
            </button>
          </div>
          <div class="ml-auto flex items-center gap-2 text-xs text-ink-muted">
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span data-component="ModeStatus">
              AI is driving
            </span>
          </div>
        </div>

        {/* 2026-05-22 — transcript: bigger padding + spacing + base
            text size (was text-sm). The workbench is the AI agent's
            primary surface; chat content should read at body-text
            weight, not the secondary text-sm used for sidebar items. */}
        <div
          class="flex-1 overflow-y-auto px-6 py-6 space-y-5 text-sm leading-relaxed"
          data-component="ChatTranscript"
          aria-live="polite"
        >
          <div class="flex flex-col items-center justify-center gap-4 py-12 text-center" data-empty>
            <div class="flex h-12 w-12 items-center justify-center rounded-md bg-glow-red/10 text-glow-red">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="text-sm font-medium text-ink-primary">No turns yet</p>
              <p class="max-w-xs text-xs text-ink-muted">
                Type a task in plain English below — the agent plans the steps, your browser
                drives the actions. <span class="font-mono">⌘+Enter</span> sends.
              </p>
            </div>
            <div class="grid w-full max-w-xs grid-cols-1 gap-2 text-left">
              <button
                type="button"
                data-empty-suggestion="Take a screenshot of the current page and describe what's on it."
                class="rounded-md border border-white/10 bg-surface-raised/50 px-3 py-2 text-xs text-ink-secondary hover:border-glow-red/40 hover:text-ink-primary"
              >
                📸 Screenshot + describe the page
              </button>
              <button
                type="button"
                data-empty-suggestion="Sign in with the credentials you'll get from me in the next message."
                class="rounded-md border border-white/10 bg-surface-raised/50 px-3 py-2 text-xs text-ink-secondary hover:border-glow-red/40 hover:text-ink-primary"
              >
                🔐 Log in with credentials I'll provide
              </button>
              <button
                type="button"
                data-empty-suggestion="Fill the contact form with placeholder text and submit it."
                class="rounded-md border border-white/10 bg-surface-raised/50 px-3 py-2 text-xs text-ink-secondary hover:border-glow-red/40 hover:text-ink-primary"
              >
                ✍️ Fill the contact form
              </button>
            </div>
          </div>
        </div>

        {/* 2026-05-22 — composer overhaul. Taller default (rows=3
            instead of rows=1) so multi-line tasks have room to
            breathe; auto-grows up to 200px on input (was 160px).
            Bigger Send button with keyboard hint chip + character
            counter below. */}
        <form
          class="border-t border-slate-800 p-5"
          data-component="ChatInput"
          data-disabled-when-mode="manual"
          autocomplete="off"
        >
          <div class="rounded-lg border border-slate-800 bg-slate-900 focus-within:border-glow-red/50 focus-within:ring-1 focus-within:ring-glow-red/20 transition-colors">
            <textarea
              name="message"
              rows="3"
              maxlength="8000"
              placeholder="Tell the agent what to do…
e.g. 'Open my Gmail and reply to messages from contact@example.com with a polite acknowledgement'"
              class="w-full resize-none bg-transparent px-4 py-3 text-sm text-ink-primary placeholder-slate-500 focus:outline-none"
            ></textarea>
            <div class="flex items-center justify-between gap-3 border-t border-slate-800 px-4 py-2">
              <div class="flex items-center gap-2 text-[10px] text-ink-muted">
                <kbd class="rounded border border-slate-700 bg-slate-900/80 px-1.5 py-0.5 font-mono">⌘</kbd>
                <kbd class="rounded border border-slate-700 bg-slate-900/80 px-1.5 py-0.5 font-mono">↵</kbd>
                <span>to send</span>
                <span class="ml-3 hidden font-mono" data-composer-char-count>0 / 8000</span>
              </div>
              <button
                type="submit"
                class="inline-flex items-center gap-1.5 rounded-md bg-glow-red px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-glow-red/90 disabled:bg-slate-700 disabled:text-slate-400 disabled:cursor-not-allowed"
              >
                Send
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>
        </form>
      </section>
    </main>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, sessionId: id }}>
    // Slice 3 (Wave 29-NNN ARC 3) — hydrates initial mode from
    // GET /v1/agent-sessions/:id on mount; POST /v1/agent-sessions/
    // :id/mode on toggle. Slices 4-6 wire transcript SSE + composer
    // POST + overlay input-event submit.

    const root = document.querySelector('[data-page="agent-session-workbench"]');
    if (!root) throw new Error('agent-session workbench root missing');

    const statusPill = root.querySelector('[data-status-pill]');
    const modeButtons = Array.from(root.querySelectorAll('[data-component="ModeToggle"] button[data-mode]'));
    const modeStatus = root.querySelector('[data-component="ModeStatus"]');
    const composerForm = root.querySelector('[data-component="ChatInput"]');
    const composerTextarea = composerForm?.querySelector('textarea');
    const composerSubmit = composerForm?.querySelector('button[type="submit"]');
    const overlay = root.querySelector('[data-component="ManualControlOverlay"]');

    /** @type {'manual'|'ai'|'pair'} */
    let mode = 'ai';
    /** @type {{kind: string, [k: string]: unknown} | null} */
    let pairModeState = null;

    function authHeaders() {
      const token = localStorage.getItem('ds_web_session_token');
      return token ? { Authorization: 'Bearer ' + token } : {};
    }

    function paintMode() {
      for (const btn of modeButtons) {
        const isActive = btn.getAttribute('data-mode') === mode;
        btn.setAttribute('data-active', isActive ? 'true' : 'false');
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
      }
      const label = { manual: 'You are driving', ai: 'AI is driving', pair: 'Pair mode — AI runs; you can take over' }[mode];
      if (modeStatus) modeStatus.textContent = label;

      const composerDisabled = mode === 'manual';
      if (composerTextarea) composerTextarea.disabled = composerDisabled;
      if (composerSubmit) composerSubmit.disabled = composerDisabled;

      const overlayEnabled = mode === 'manual' || mode === 'pair';
      if (overlay) {
        overlay.setAttribute('data-overlay-enabled', overlayEnabled ? 'true' : 'false');
        overlay.style.pointerEvents = overlayEnabled ? 'auto' : 'none';
      }

      if (statusPill) {
        statusPill.textContent = mode.toUpperCase();
        statusPill.className =
          'text-xs px-2 py-1 rounded ' +
          (mode === 'manual'
            ? 'bg-amber-900 text-amber-200'
            : mode === 'pair'
              ? 'bg-blue-900 text-blue-200'
              : 'bg-emerald-900 text-emerald-200');
      }
    }

    function paintError(detail) {
      if (statusPill) {
        statusPill.textContent = 'OFFLINE';
        statusPill.className = 'text-xs px-2 py-1 rounded bg-red-900 text-red-200';
        statusPill.title = detail;
      }
      for (const btn of modeButtons) {
        btn.disabled = true;
      }
      if (composerTextarea) composerTextarea.disabled = true;
      if (composerSubmit) composerSubmit.disabled = true;
    }

    async function hydrateFromServer() {
      try {
        const res = await fetch(apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId), {
          headers: { ...authHeaders() },
        });
        if (!res.ok) {
          paintError('GET /v1/agent-sessions/' + sessionId + ' returned ' + res.status.toString());
          return;
        }
        const body = await res.json();
        if (body && (body.mode === 'manual' || body.mode === 'ai' || body.mode === 'pair')) {
          mode = body.mode;
        }
        pairModeState =
          body && body.pair_mode_state && typeof body.pair_mode_state.kind === 'string'
            ? body.pair_mode_state
            : null;
        paintMode();
      } catch (err) {
        paintError(err instanceof Error ? err.message : String(err));
      } finally {
        // 2026-05-21 — opacity-gate hydrate signal (matches the other
        // dashboard pages 4a15ce31 / c8ad19a4 / 661f0422).
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
      }
    }

    async function postMode(next) {
      const previousMode = mode;
      mode = next;
      paintMode();
      try {
        const res = await fetch(
          apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId) + '/mode',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json', ...authHeaders() },
            body: JSON.stringify({ mode: next }),
          },
        );
        if (!res.ok) {
          // Roll back optimistic paint.
          mode = previousMode;
          paintMode();
          paintError('POST /mode returned ' + res.status.toString());
          return;
        }
        const body = await res.json();
        pairModeState =
          body && body.pair_mode_state && typeof body.pair_mode_state.kind === 'string'
            ? body.pair_mode_state
            : null;
      } catch (err) {
        mode = previousMode;
        paintMode();
        paintError(err instanceof Error ? err.message : String(err));
      }
    }

    for (const btn of modeButtons) {
      btn.addEventListener('click', () => {
        const next = btn.getAttribute('data-mode');
        if ((next === 'manual' || next === 'ai' || next === 'pair') && next !== mode) {
          void postMode(next);
        }
      });
    }

    // Slice 4 (Wave 29-NNN ARC 3) — ManualControlOverlay LK.6 InputEvent
    // capture. Translates browser mouse / wheel / keyboard events into
    // POST /v1/agent-sessions/:id/input-event calls. Throttled to 120Hz
    // for mouseMove. Active only when mode ∈ {manual, pair}; gated by
    // overlay's pointer-events (paintMode flips this).
    //
    // The route returns 503 FeatureUnavailable pre-harness; we drop
    // events silently on 503 to avoid hammering the server (set a
    // "harness offline" flag so subsequent events don't even attempt
    // the POST). 4xx (auth / mode / status) surface in the status pill.
    const MOUSE_MOVE_THROTTLE_MS = 8; // ≤120Hz
    let lastMouseMoveAt = 0;
    let harnessOffline = false;

    function viewportCoords(ev, target) {
      // pointerToViewport — translate clientX/clientY relative to the
      // target element's bounding rect (origin top-left).
      const rect = target.getBoundingClientRect();
      return {
        x: Math.round(ev.clientX - rect.left),
        y: Math.round(ev.clientY - rect.top),
      };
    }

    function mouseButton(raw) {
      // Browser MouseEvent.button: 0=left, 1=middle, 2=right. LK.6
      // InputEvent.button uses the same enum. Anything else → null
      // (back/forward buttons not supported by Quartz CGEventCreateMouseEvent).
      return raw === 0 || raw === 1 || raw === 2 ? raw : null;
    }

    function modifiersFromEvent(ev) {
      const out = [];
      if (ev.metaKey) out.push('cmd');
      if (ev.ctrlKey) out.push('ctrl');
      if (ev.shiftKey) out.push('shift');
      if (ev.altKey) out.push('option');
      return out.length > 0 ? out : undefined;
    }

    // 2026-05-19 Slice 5 — pair-mode takeover trigger requires
    // a stable per-tab client_id. Generated once per page load.
    const dashboardClientId =
      typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
        ? 'dash_' + crypto.randomUUID()
        : 'dash_' + Math.random().toString(36).slice(2) + Date.now().toString(36);

    async function sendInputEvent(event) {
      if (harnessOffline) return;
      try {
        const body = { event };
        // Always send client_id; server only consults it on the
        // pair-mode-ai-driving takeover-trigger path (Slice 5).
        body.client_id = dashboardClientId;
        const res = await fetch(
          apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId) + '/input-event',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json', ...authHeaders() },
            body: JSON.stringify(body),
          },
        );
        if (res.status === 200) {
          // Slice 5 — check for the takeover-fired discriminator; if
          // so, refresh the displayed pair_mode_state. The mode toggle
          // doesn't change (mode stays 'pair') but the inner state
          // does, which downstream code reads to decide what to show.
          try {
            const reply = await res.clone().json();
            if (reply && reply.kind === 'pair-mode-takeover-fired') {
              pairModeState = reply.pair_mode_state;
            }
          } catch {
            // Non-JSON success is unexpected but not fatal.
          }
        } else if (res.status === 503) {
          // Pre-harness forward path: drop silently, suppress
          // further sends. The Slice 5 takeover-trigger path
          // returns 200, not 503.
          harnessOffline = true;
          if (statusPill) {
            statusPill.title = 'Live input forwarding pending harness end-to-end';
          }
        } else if (res.status === 409) {
          // 409 = pair-mode mid-transition (takeover-pending etc.);
          // wait + retry on next event. Don't latch offline.
        } else if (!res.ok) {
          paintError('POST /input-event returned ' + res.status.toString());
        }
      } catch {
        // Network drop — let next event retry (don't latch offline).
      }
    }

    if (overlay) {
      overlay.addEventListener('mousemove', (ev) => {
        const now = Date.now();
        if (now - lastMouseMoveAt < MOUSE_MOVE_THROTTLE_MS) return;
        lastMouseMoveAt = now;
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({ type: 'mouseMove', x, y });
      });
      overlay.addEventListener('mousedown', (ev) => {
        const button = mouseButton(ev.button);
        if (button === null) return;
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({ type: 'mouseDown', x, y, button });
      });
      overlay.addEventListener('mouseup', (ev) => {
        const button = mouseButton(ev.button);
        if (button === null) return;
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({ type: 'mouseUp', x, y, button });
      });
      overlay.addEventListener('wheel', (ev) => {
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({
          type: 'wheel',
          x,
          y,
          deltaX: Math.round(ev.deltaX),
          deltaY: Math.round(ev.deltaY),
        });
      });
    }

    // Keyboard targets the document, NOT the overlay (focus is usually
    // elsewhere — composer textarea, etc.). Only fire when mode ∈
    // {manual, pair} AND focus is on the workbench page root (not the
    // composer textarea, which already handles its own input).
    document.addEventListener('keydown', (ev) => {
      if (mode === 'ai') return;
      if (composerTextarea && document.activeElement === composerTextarea) return;
      void sendInputEvent({ type: 'keyDown', key: ev.key, modifiers: modifiersFromEvent(ev) });
    });
    document.addEventListener('keyup', (ev) => {
      if (mode === 'ai') return;
      if (composerTextarea && document.activeElement === composerTextarea) return;
      void sendInputEvent({ type: 'keyUp', key: ev.key, modifiers: modifiersFromEvent(ev) });
    });

    // 2026-05-21 — V-666.AI-A composer wire-up. Optimistic-render the
    // customer's turn into the transcript immediately, then POST to
    // /v1/agent-sessions/:id/message. On response, append the agent's
    // turn (intent decomposition output). On error, mark the customer
    // bubble with a retry affordance + leave the textarea content
    // populated so the customer can resend without retyping.
    const transcript = root.querySelector('[data-component="ChatTranscript"]');
    const emptyHint = transcript?.querySelector('[data-empty]');
    let pendingTurnEl = null;

    function appendTurn(role, body) {
      if (!transcript) return null;
      if (emptyHint && !emptyHint.classList.contains('hidden')) {
        emptyHint.classList.add('hidden');
      }
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-col gap-1';
      wrap.dataset.role = role;
      const ts = Date.now();
      wrap.dataset.turnTs = String(ts);
      const labelRow = document.createElement('div');
      labelRow.className = 'flex items-baseline justify-between gap-3';
      const label = document.createElement('span');
      label.className =
        'text-[10px] font-mono uppercase tracking-widest ' +
        (role === 'agent' ? 'text-glow-red' : 'text-ink-muted');
      label.textContent = role === 'agent' ? 'agent' : 'you';
      const time = document.createElement('time');
      time.className = 'text-[10px] font-mono text-ink-muted';
      time.dataset.turnAge = String(ts);
      time.dateTime = new Date(ts).toISOString();
      time.textContent = 'now';
      labelRow.appendChild(label);
      labelRow.appendChild(time);
      const bubble = document.createElement('div');
      // 2026-05-22 — bigger bubble (px-4 py-3 instead of px-3 py-2)
      // + thin border for visual separation between adjacent
      // bubbles. Customer bubbles get a left accent stripe; agent
      // bubbles get a glow-red tint that matches the brand.
      bubble.className =
        'group whitespace-pre-wrap break-words rounded-lg px-4 py-3 text-sm relative border ' +
        (role === 'agent'
          ? 'bg-glow-red/5 border-glow-red/20 text-ink-primary'
          : 'bg-slate-800/60 border-slate-700/60 text-ink-primary');
      // 2026-05-21 — inline-code rendering for agent turns. Matches
      // single-backtick `code` spans and wraps them in <code> with
      // a subtle background. HTML-safe: we re-encode the body before
      // string-replacing so user text can't inject script tags.
      function escHtml(s) {
        return s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }
      if (role === 'agent' && /`[^`]+`/.test(body)) {
        bubble.innerHTML = escHtml(body).replace(
          /`([^`]+)`/g,
          '<code class="rounded bg-white/10 px-1 py-px font-mono text-[12px]">$1</code>',
        );
      } else {
        bubble.textContent = body;
      }
      // Copy-message affordance — hover-revealed pill on the bubble's
      // top-right corner. Only on agent turns (your own typed text
      // doesn't need a copy). Click writes the raw body (NOT the
      // HTML-rendered version) to the clipboard.
      if (role === 'agent') {
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className =
          'absolute top-1 right-1 hidden rounded bg-surface-base/60 px-1.5 py-0.5 ' +
          'font-mono text-[10px] text-ink-muted opacity-0 transition group-hover:block ' +
          'group-hover:opacity-100 hover:text-ink-primary';
        copyBtn.textContent = 'copy';
        copyBtn.addEventListener('click', async () => {
          if (!navigator.clipboard) return;
          try {
            await navigator.clipboard.writeText(body);
            copyBtn.textContent = 'copied ✓';
            setTimeout(() => {
              copyBtn.textContent = 'copy';
            }, 1500);
          } catch (_) {
            /* swallow */
          }
        });
        bubble.appendChild(copyBtn);
      }
      wrap.appendChild(labelRow);
      wrap.appendChild(bubble);
      transcript.appendChild(wrap);
      transcript.scrollTop = transcript.scrollHeight;
      return wrap;
    }

    // Tick the per-turn timestamps every 5s ("now" → "5s ago" →
    // "30s ago" → "1m ago" → "2h ago"). Cheaper than RelativeTimeFormat
    // for short windows + matches the admin overview live-feed style.
    function fmtTurnAge(ms) {
      const s = Math.floor((Date.now() - ms) / 1000);
      if (s < 5) return 'now';
      if (s < 60) return s.toString() + 's ago';
      if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
      return Math.floor(s / 3600).toString() + 'h ago';
    }
    setInterval(() => {
      const els = document.querySelectorAll('[data-turn-age]');
      els.forEach((el) => {
        const ts = Number(el.getAttribute('data-turn-age'));
        if (Number.isFinite(ts)) el.textContent = fmtTurnAge(ts);
      });
    }, 5_000);

    composerForm?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!composerTextarea) return;
      const text = composerTextarea.value.trim();
      if (text.length === 0) return;
      composerTextarea.value = '';
      if (composerSubmit) composerSubmit.disabled = true;

      const customerBubble = appendTurn('customer', text);
      // Pending agent bubble — three pulsing dots replace the
      // "thinking…" text when POST resolves. Pulse cadence staggered
      // 200ms per dot via inline animation-delay so it reads as a
      // live typing indicator.
      pendingTurnEl = appendTurn('agent', '');
      if (pendingTurnEl) {
        const bub = pendingTurnEl.querySelector('div:last-child');
        if (bub) {
          bub.innerHTML =
            '<span class="inline-flex items-center gap-1" aria-label="agent is thinking">' +
            '<span class="inline-block h-2 w-2 rounded-full bg-glow-red animate-pulse"></span>' +
            '<span class="inline-block h-2 w-2 rounded-full bg-glow-red animate-pulse" style="animation-delay:200ms"></span>' +
            '<span class="inline-block h-2 w-2 rounded-full bg-glow-red animate-pulse" style="animation-delay:400ms"></span>' +
            '</span>';
        }
      }

      try {
        const res = await fetch(
          apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId) + '/message',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json', ...authHeaders() },
            body: JSON.stringify({ content: text }),
          },
        );
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          const detail = body.detail || 'HTTP ' + res.status.toString();
          if (pendingTurnEl) {
            const bub = pendingTurnEl.querySelector('div:last-child');
            if (bub) {
              bub.textContent = '⚠ ' + detail + ' — your message above is preserved; click to retry.';
              bub.className = 'rounded-md bg-red-900/30 px-3 py-2 text-sm text-rose-300';
              bub.style.cursor = 'pointer';
              bub.addEventListener('click', () => {
                if (composerTextarea) {
                  composerTextarea.value = text;
                  composerTextarea.focus();
                }
              });
            }
          }
          return;
        }
        // V-666.AI-A response shape per kind:
        //   plan-executed → { intents: [...], results: [...], ok: bool }
        //   clarify       → { clarifying_question: string }
        //   refuse        → { refuse_reason: string }
        //   logged-manual → no reply content (operator-driven turn)
        // Render plan-executed as a richer block (numbered intents
        // with status icons); clarify / refuse render as plain text.
        const intents = Array.isArray(body.intents) ? body.intents : null;
        const results = Array.isArray(body.results) ? body.results : null;
        const clarifyQ = typeof body.clarifying_question === 'string' ? body.clarifying_question : null;
        const refuseR = typeof body.refuse_reason === 'string' ? body.refuse_reason : null;
        const fallbackReply =
          (typeof body.reply === 'string' && body.reply) ||
          (Array.isArray(body.transcript) &&
            body.transcript[body.transcript.length - 1] &&
            body.transcript[body.transcript.length - 1].content) ||
          null;

        if (pendingTurnEl) {
          const bub = pendingTurnEl.querySelector('div:last-child');
          if (bub) {
            if (clarifyQ !== null) {
              bub.textContent = '❓ ' + clarifyQ;
            } else if (refuseR !== null) {
              bub.textContent = '⚠ ' + refuseR;
            } else if (intents !== null && intents.length > 0) {
              // 2026-05-22 — visual intent decomposition. Each step
              // gets a numbered chip + status icon (✓ ok, ✗ failed,
              // — skipped). Customer-facing copy mirrors what the
              // executor wrote to the transcript on the server.
              bub.innerHTML = '';
              const headline = document.createElement('p');
              headline.className = 'mb-2 font-medium';
              headline.textContent =
                (body.ok === false ? '⚠ Plan executed with errors — ' : '✓ Plan executed — ') +
                intents.length.toString() +
                ' intent' +
                (intents.length === 1 ? '' : 's');
              bub.appendChild(headline);
              const list = document.createElement('ol');
              list.className = 'space-y-1.5';
              intents.forEach((it, idx) => {
                const r = results && results[idx];
                const ok = r && r.ok !== false;
                const li = document.createElement('li');
                li.className =
                  'flex items-start gap-2 rounded-md border border-white/5 ' +
                  (ok
                    ? 'bg-emerald-500/5 text-ink-primary'
                    : 'bg-rose-500/10 text-rose-200') +
                  ' px-2.5 py-1.5 text-xs';
                const num = document.createElement('span');
                num.className =
                  'shrink-0 inline-flex h-5 w-5 items-center justify-center rounded-full ' +
                  (ok ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/30 text-rose-100') +
                  ' font-mono text-[10px]';
                num.textContent = ok ? '✓' : '✗';
                const body2 = document.createElement('div');
                body2.className = 'min-w-0 flex-1';
                const verb = document.createElement('p');
                verb.className = 'font-mono text-[11px] uppercase tracking-wide text-ink-muted';
                verb.textContent = String((idx + 1).toString() + '. ' + (it.verb ?? 'step'));
                const summary = document.createElement('p');
                summary.className = 'mt-0.5 break-words';
                const argsText = it.args
                  ? Object.entries(it.args)
                      .map(([k, v]) =>
                        k +
                        '=' +
                        (typeof v === 'string'
                          ? '"' + v.slice(0, 60) + (v.length > 60 ? '…' : '') + '"'
                          : JSON.stringify(v)),
                      )
                      .join(' ')
                  : '';
                summary.textContent = argsText;
                body2.appendChild(verb);
                if (argsText) body2.appendChild(summary);
                if (r && r.ok === false && r.error) {
                  const err = document.createElement('p');
                  err.className = 'mt-0.5 text-[10px] text-rose-300';
                  err.textContent = 'error: ' + String(r.error).slice(0, 200);
                  body2.appendChild(err);
                }
                li.appendChild(num);
                li.appendChild(body2);
                list.appendChild(li);
              });
              bub.appendChild(list);
            } else if (fallbackReply !== null) {
              bub.textContent = fallbackReply;
            } else {
              bub.textContent = 'Done.';
            }
          }
        }
        // 2026-05-22 — render the cost badge below the bubble when the
        // response carries usage telemetry. "$0.0023 · 145 tokens"
        // shape; pulled from body.usage (V-666.AI cost surfacing).
        // Deterministic decomposers omit usage — badge skipped.
        if (pendingTurnEl && body.usage && typeof body.usage === 'object') {
          const u = body.usage;
          const cents = typeof u.cost_usd_cents === 'number' ? u.cost_usd_cents : null;
          const inTok = typeof u.anthropic_input_tokens === 'number' ? u.anthropic_input_tokens : 0;
          const outTok = typeof u.anthropic_output_tokens === 'number' ? u.anthropic_output_tokens : 0;
          const tokTotal = inTok + outTok;
          if (cents !== null || tokTotal > 0) {
            const meta = document.createElement('p');
            meta.className = 'mt-1 text-[10px] font-mono text-ink-muted';
            const parts = [];
            if (cents !== null) parts.push('$' + (cents / 100).toFixed(4));
            if (tokTotal > 0) parts.push(tokTotal.toString() + ' tokens');
            if (typeof u.model === 'string' && u.model.length > 0) parts.push(u.model);
            meta.textContent = parts.join(' · ');
            pendingTurnEl.appendChild(meta);

            // 2026-05-22 — running session-cost tally + new header
            // badges (header-cost / header-turns / header-model).
            // ModeStatus slot still gets the legacy message for the
            // mode-toggle row; the header is the more visible
            // surface for the running total.
            if (cents !== null) {
              window.__driftstackSessionCostCents =
                (window.__driftstackSessionCostCents || 0) + cents;
              const statusSlot = root.querySelector('[data-component="ModeStatus"]');
              if (statusSlot) {
                statusSlot.textContent =
                  'AI is driving · session cost $' +
                  (window.__driftstackSessionCostCents / 100).toFixed(4);
              }
              const headerCost = document.querySelector('[data-header-cost]');
              if (headerCost) {
                headerCost.textContent =
                  '$' + (window.__driftstackSessionCostCents / 100).toFixed(4);
              }
            }
            if (typeof u.model === 'string' && u.model.length > 0) {
              const headerModel = document.querySelector('[data-header-model]');
              const headerModelName = document.querySelector('[data-header-model-name]');
              if (headerModel && headerModelName) {
                headerModelName.textContent = u.model.replace(/^claude-/, '');
                headerModel.classList.remove('hidden');
                headerModel.classList.add('flex');
              }
            }
          }
        }
        // Bump turn counter (independent of usage availability).
        window.__driftstackSessionTurns = (window.__driftstackSessionTurns || 0) + 1;
        const headerTurns = document.querySelector('[data-header-turns]');
        if (headerTurns) headerTurns.textContent = String(window.__driftstackSessionTurns);
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        if (pendingTurnEl) {
          const bub = pendingTurnEl.querySelector('div:last-child');
          if (bub) {
            bub.textContent = '⚠ ' + msg + ' — click to retry.';
            bub.className = 'rounded-md bg-red-900/30 px-3 py-2 text-sm text-rose-300';
            bub.style.cursor = 'pointer';
            bub.addEventListener('click', () => {
              if (composerTextarea) {
                composerTextarea.value = text;
                composerTextarea.focus();
              }
            });
          }
        }
      } finally {
        if (composerSubmit) composerSubmit.disabled = false;
        pendingTurnEl = null;
        // Suppress unused-var warning for customerBubble (used for DOM side-effect).
        void customerBubble;
      }
    });

    composerTextarea?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' && (ev.metaKey || ev.ctrlKey)) {
        ev.preventDefault();
        composerForm?.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    });

    // 2026-05-22 — auto-grow textarea + character counter. Min 3
    // rows (default), max 240px before the inner scroll kicks in.
    // Character counter shows once the customer starts typing
    // (hidden at 0 length for cleaner empty state).
    const charCountEl = document.querySelector('[data-composer-char-count]');
    function autoGrowComposer() {
      if (!composerTextarea) return;
      composerTextarea.style.height = 'auto';
      composerTextarea.style.height = Math.min(240, composerTextarea.scrollHeight) + 'px';
      if (charCountEl) {
        const n = composerTextarea.value.length;
        if (n > 0) {
          charCountEl.textContent = n.toString() + ' / 8000';
          charCountEl.classList.remove('hidden');
        } else {
          charCountEl.classList.add('hidden');
        }
      }
    }
    composerTextarea?.addEventListener('input', autoGrowComposer);
    composerForm?.addEventListener('submit', () => {
      // Reset after the existing submit handler clears the value (it
      // runs first because addEventListener preserves order).
      setTimeout(() => {
        if (composerTextarea) composerTextarea.style.height = 'auto';
        if (charCountEl) charCountEl.classList.add('hidden');
      }, 0);
    });

    // 2026-05-22 — suggestion-chip wiring. Click prefills the
    // textarea + focuses it (customer can edit before sending).
    // Bound once at boot rather than per-chip so future tweaks to the
    // empty state only need to add the data-empty-suggestion attr.
    document.querySelectorAll('[data-empty-suggestion]').forEach((el) => {
      el.addEventListener('click', () => {
        const text = el.getAttribute('data-empty-suggestion') ?? '';
        if (composerTextarea && text.length > 0) {
          composerTextarea.value = text;
          composerTextarea.focus();
        }
      });
    });

    // 2026-05-22 — copy-session-id helper. Useful for support
    // tickets ("my session ord_… is stuck"). Visible affordance:
    // hover reveals the copy icon next to the truncated id.
    const copyIdBtn = document.querySelector('[data-copy-session-id]');
    if (copyIdBtn) {
      copyIdBtn.addEventListener('click', async () => {
        const id = copyIdBtn.getAttribute('data-id') ?? '';
        if (!id || !navigator.clipboard) return;
        try {
          await navigator.clipboard.writeText(id);
          const span = copyIdBtn.querySelector('span');
          const original = span ? span.textContent : id;
          if (span) span.textContent = 'copied ✓';
          setTimeout(() => {
            if (span) span.textContent = original;
          }, 1500);
        } catch (_) {
          /* swallow */
        }
      });
    }

    paintMode();
    void hydrateFromServer();
  </script>
</DashboardLayout>
