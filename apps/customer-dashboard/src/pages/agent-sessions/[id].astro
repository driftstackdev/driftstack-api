---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { resolveApiBaseUrl } from '../../lib/api-base-url';

// v2-#8 Wave 29-NNN ARC 3 — AI chat + manual side-by-side LIVE
// per-session workbench. Slice 2 scaffold per the design doc at
// docs/internal/ai-chat-manual-side-by-side-design.md (founder
// verdicts A/C/A/A/A LOCKED 2026-05-19).
//
// Split-screen workbench:
//   LEFT  — LiveKit browser-stream preview + ManualControlOverlay
//           (mouse/touch on the video translates to /v1/sessions/:id/
//           input-event POST in Manual / Pair mode; LK.6 wire shape).
//   RIGHT — AI chat panel (mode toggle / transcript / composer).
//
// Modes (per the design doc):
//   manual — human drives via overlay; AI observes only.
//   ai     — AgentRuntime drives via decompose loop.
//   pair   — both; AI pauses on customer takeover, resumes on handback.
//
// Verdict Q1 (transport): SSE on /v1/agent-sessions/:id/stream for
// transcript; POST /v1/agent-sessions/:id/message for customer input.
//
// Verdict Q3 (state): agent_sessions.pair_mode_state JSONB column —
// canonical mode + last_action_at + last_actor live there; Slice 5
// wires conflict resolution.
//
// Verdict Q5 (cost): hide actual per-turn cost in the customer-facing
// footer (operator-only audit-log surface only).
//
// Slice 2 SCAFFOLD scope (this file):
//   - Layout structure + Tailwind classes
//   - Mode toggle UI (client-side state only — backend wiring in Slice 3)
//   - Transcript placeholder (SSE wiring in Slice 4)
//   - Input event overlay placeholder (POST wiring in Slice 4)
//   - Mock data fallback so the page renders even when the agent_
//     session id doesn't exist yet (development affordance)
//
// Real harness integration lands when Agent 1's Swift harness end-
// to-end ships (per ORCHESTRATOR-STATE.md 2026-05-19 harness Option A
// verdict — 6-9 weeks Agent 1 work post §10/§11+EG-WK close).

// Astro dynamic-route mode: SSR not SSG. The page is rendered at
// request time and the client script hydrates from GET /v1/agent-
// sessions/:id (Slice 3) — there's no list of paths to enumerate at
// build time. Without this flag astro build fails with
// GetStaticPathsRequired.
export const prerender = false;

const { id } = Astro.params;
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title={`Agent session ${id ?? ''}`}>
  <div class="h-screen flex flex-col" data-page="agent-session-workbench" data-session-id={id}>
    <header class="border-b border-slate-800 px-6 py-3 flex items-center gap-4">
      <a href="/agent-sessions" class="text-sm text-ink-muted hover:text-ink-primary">
        ← All agent sessions
      </a>
      <div class="flex-1">
        <h1 class="text-base font-semibold text-ink-primary">Agent session</h1>
        <p class="text-xs text-ink-muted font-mono">{id}</p>
      </div>
      <div data-status-pill class="text-xs px-2 py-1 rounded bg-slate-800 text-slate-300">
        Loading…
      </div>
    </header>

    <main class="flex-1 grid grid-cols-2 gap-0 overflow-hidden" data-component="SplitScreen">
      <!-- LEFT — LiveKit preview + Manual control overlay -->
      <section
        class="border-r border-slate-800 bg-slate-950 flex flex-col"
        data-component="LeftPanel"
        aria-label="Live browser preview"
      >
        <div class="px-4 py-2 border-b border-slate-800 text-xs uppercase tracking-wide text-ink-muted">
          Live preview
        </div>
        <div
          class="flex-1 relative flex items-center justify-center"
          data-component="LiveKitPreview"
          data-session-id={id}
        >
          <!-- Placeholder until harness end-to-end Swift lands (Tier-3
               verdict 2026-05-19, 6-9wks Agent 1). LiveKit JS SDK
               wire-up follows in Slice 4. -->
          <div class="text-center text-ink-muted text-sm">
            <p class="font-mono">LiveKit stream coming online…</p>
            <p class="mt-2 text-xs">harness end-to-end (Swift) wires in Slice 4</p>
          </div>
          <!-- ManualControlOverlay: transparent click-capture div on top
               of LiveKit video in Manual/Pair mode. POSTs input events
               to /v1/sessions/:id/input-event (LK.6 wire shape). Wired
               in Slice 4. -->
          <div
            data-component="ManualControlOverlay"
            class="absolute inset-0 pointer-events-none"
            data-overlay-enabled="false"
          ></div>
        </div>
      </section>

      <!-- RIGHT — AI chat panel -->
      <section class="bg-slate-950 flex flex-col" data-component="RightPanel" aria-label="AI chat">
        <!-- Mode toggle row -->
        <div
          class="px-4 py-3 border-b border-slate-800 flex items-center gap-3"
          data-component="ChatHeader"
        >
          <div
            class="flex bg-slate-900 rounded-md p-0.5 text-xs"
            data-component="ModeToggle"
            role="radiogroup"
            aria-label="Session mode"
          >
            <button
              data-mode="manual"
              class="px-3 py-1.5 rounded text-slate-300 hover:text-ink-primary data-[active=true]:bg-slate-700 data-[active=true]:text-ink-primary"
              aria-checked="false"
              role="radio"
            >
              Manual
            </button>
            <button
              data-mode="ai"
              class="px-3 py-1.5 rounded text-slate-300 hover:text-ink-primary data-[active=true]:bg-slate-700 data-[active=true]:text-ink-primary"
              data-active="true"
              aria-checked="true"
              role="radio"
            >
              AI
            </button>
            <button
              data-mode="pair"
              class="px-3 py-1.5 rounded text-slate-300 hover:text-ink-primary data-[active=true]:bg-slate-700 data-[active=true]:text-ink-primary"
              aria-checked="false"
              role="radio"
            >
              Pair
            </button>
          </div>
          <span class="text-xs text-ink-muted ml-auto" data-component="ModeStatus">
            AI is driving
          </span>
        </div>

        <!-- Transcript: SSE-fed in Slice 4; scaffolded with mock entries. -->
        <div
          class="flex-1 overflow-y-auto px-4 py-4 space-y-3 text-sm"
          data-component="ChatTranscript"
          aria-live="polite"
        >
          <p class="text-ink-muted text-xs text-center" data-empty>
            No turns yet. Send a message to start.
          </p>
        </div>

        <!-- Composer: POSTs to /v1/agent-sessions/:id/message in Slice 4. -->
        <form
          class="border-t border-slate-800 p-4 flex gap-2"
          data-component="ChatInput"
          data-disabled-when-mode="manual"
          autocomplete="off"
        >
          <textarea
            name="message"
            rows="1"
            placeholder="Tell the agent what to do (Cmd-Enter to send)"
            class="flex-1 resize-none bg-slate-900 border border-slate-800 rounded-md px-3 py-2 text-sm text-ink-primary placeholder-slate-500 focus:outline-none focus:border-slate-600"
          ></textarea>
          <button
            type="submit"
            class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium disabled:bg-slate-700 disabled:cursor-not-allowed"
          >
            Send
          </button>
        </form>
      </section>
    </main>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, sessionId: id }}>
    // Slice 3 (Wave 29-NNN ARC 3) — hydrates initial mode from
    // GET /v1/agent-sessions/:id on mount; POST /v1/agent-sessions/
    // :id/mode on toggle. Slices 4-6 wire transcript SSE + composer
    // POST + overlay input-event submit.

    const root = document.querySelector('[data-page="agent-session-workbench"]');
    if (!root) throw new Error('agent-session workbench root missing');

    const statusPill = root.querySelector('[data-status-pill]');
    const modeButtons = Array.from(root.querySelectorAll('[data-component="ModeToggle"] button[data-mode]'));
    const modeStatus = root.querySelector('[data-component="ModeStatus"]');
    const composerForm = root.querySelector('[data-component="ChatInput"]');
    const composerTextarea = composerForm?.querySelector('textarea');
    const composerSubmit = composerForm?.querySelector('button[type="submit"]');
    const overlay = root.querySelector('[data-component="ManualControlOverlay"]');

    /** @type {'manual'|'ai'|'pair'} */
    let mode = 'ai';
    /** @type {{kind: string, [k: string]: unknown} | null} */
    let pairModeState = null;

    function authHeaders() {
      const token = localStorage.getItem('ds_web_session_token');
      return token ? { Authorization: 'Bearer ' + token } : {};
    }

    function paintMode() {
      for (const btn of modeButtons) {
        const isActive = btn.getAttribute('data-mode') === mode;
        btn.setAttribute('data-active', isActive ? 'true' : 'false');
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
      }
      const label = { manual: 'You are driving', ai: 'AI is driving', pair: 'Pair mode — AI runs; you can take over' }[mode];
      if (modeStatus) modeStatus.textContent = label;

      const composerDisabled = mode === 'manual';
      if (composerTextarea) composerTextarea.disabled = composerDisabled;
      if (composerSubmit) composerSubmit.disabled = composerDisabled;

      const overlayEnabled = mode === 'manual' || mode === 'pair';
      if (overlay) {
        overlay.setAttribute('data-overlay-enabled', overlayEnabled ? 'true' : 'false');
        overlay.style.pointerEvents = overlayEnabled ? 'auto' : 'none';
      }

      if (statusPill) {
        statusPill.textContent = mode.toUpperCase();
        statusPill.className =
          'text-xs px-2 py-1 rounded ' +
          (mode === 'manual'
            ? 'bg-amber-900 text-amber-200'
            : mode === 'pair'
              ? 'bg-blue-900 text-blue-200'
              : 'bg-emerald-900 text-emerald-200');
      }
    }

    function paintError(detail) {
      if (statusPill) {
        statusPill.textContent = 'OFFLINE';
        statusPill.className = 'text-xs px-2 py-1 rounded bg-red-900 text-red-200';
        statusPill.title = detail;
      }
      for (const btn of modeButtons) {
        btn.disabled = true;
      }
      if (composerTextarea) composerTextarea.disabled = true;
      if (composerSubmit) composerSubmit.disabled = true;
    }

    async function hydrateFromServer() {
      try {
        const res = await fetch(apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId), {
          headers: { ...authHeaders() },
        });
        if (!res.ok) {
          paintError('GET /v1/agent-sessions/' + sessionId + ' returned ' + res.status.toString());
          return;
        }
        const body = await res.json();
        if (body && (body.mode === 'manual' || body.mode === 'ai' || body.mode === 'pair')) {
          mode = body.mode;
        }
        pairModeState =
          body && body.pair_mode_state && typeof body.pair_mode_state.kind === 'string'
            ? body.pair_mode_state
            : null;
        paintMode();
      } catch (err) {
        paintError(err instanceof Error ? err.message : String(err));
      } finally {
        // 2026-05-21 — opacity-gate hydrate signal (matches the other
        // dashboard pages 4a15ce31 / c8ad19a4 / 661f0422).
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
      }
    }

    async function postMode(next) {
      const previousMode = mode;
      mode = next;
      paintMode();
      try {
        const res = await fetch(
          apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId) + '/mode',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json', ...authHeaders() },
            body: JSON.stringify({ mode: next }),
          },
        );
        if (!res.ok) {
          // Roll back optimistic paint.
          mode = previousMode;
          paintMode();
          paintError('POST /mode returned ' + res.status.toString());
          return;
        }
        const body = await res.json();
        pairModeState =
          body && body.pair_mode_state && typeof body.pair_mode_state.kind === 'string'
            ? body.pair_mode_state
            : null;
      } catch (err) {
        mode = previousMode;
        paintMode();
        paintError(err instanceof Error ? err.message : String(err));
      }
    }

    for (const btn of modeButtons) {
      btn.addEventListener('click', () => {
        const next = btn.getAttribute('data-mode');
        if ((next === 'manual' || next === 'ai' || next === 'pair') && next !== mode) {
          void postMode(next);
        }
      });
    }

    // Slice 4 (Wave 29-NNN ARC 3) — ManualControlOverlay LK.6 InputEvent
    // capture. Translates browser mouse / wheel / keyboard events into
    // POST /v1/agent-sessions/:id/input-event calls. Throttled to 120Hz
    // for mouseMove. Active only when mode ∈ {manual, pair}; gated by
    // overlay's pointer-events (paintMode flips this).
    //
    // The route returns 503 FeatureUnavailable pre-harness; we drop
    // events silently on 503 to avoid hammering the server (set a
    // "harness offline" flag so subsequent events don't even attempt
    // the POST). 4xx (auth / mode / status) surface in the status pill.
    const MOUSE_MOVE_THROTTLE_MS = 8; // ≤120Hz
    let lastMouseMoveAt = 0;
    let harnessOffline = false;

    function viewportCoords(ev, target) {
      // pointerToViewport — translate clientX/clientY relative to the
      // target element's bounding rect (origin top-left).
      const rect = target.getBoundingClientRect();
      return {
        x: Math.round(ev.clientX - rect.left),
        y: Math.round(ev.clientY - rect.top),
      };
    }

    function mouseButton(raw) {
      // Browser MouseEvent.button: 0=left, 1=middle, 2=right. LK.6
      // InputEvent.button uses the same enum. Anything else → null
      // (back/forward buttons not supported by Quartz CGEventCreateMouseEvent).
      return raw === 0 || raw === 1 || raw === 2 ? raw : null;
    }

    function modifiersFromEvent(ev) {
      const out = [];
      if (ev.metaKey) out.push('cmd');
      if (ev.ctrlKey) out.push('ctrl');
      if (ev.shiftKey) out.push('shift');
      if (ev.altKey) out.push('option');
      return out.length > 0 ? out : undefined;
    }

    // 2026-05-19 Slice 5 — pair-mode takeover trigger requires
    // a stable per-tab client_id. Generated once per page load.
    const dashboardClientId =
      typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
        ? 'dash_' + crypto.randomUUID()
        : 'dash_' + Math.random().toString(36).slice(2) + Date.now().toString(36);

    async function sendInputEvent(event) {
      if (harnessOffline) return;
      try {
        const body = { event };
        // Always send client_id; server only consults it on the
        // pair-mode-ai-driving takeover-trigger path (Slice 5).
        body.client_id = dashboardClientId;
        const res = await fetch(
          apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId) + '/input-event',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json', ...authHeaders() },
            body: JSON.stringify(body),
          },
        );
        if (res.status === 200) {
          // Slice 5 — check for the takeover-fired discriminator; if
          // so, refresh the displayed pair_mode_state. The mode toggle
          // doesn't change (mode stays 'pair') but the inner state
          // does, which downstream code reads to decide what to show.
          try {
            const reply = await res.clone().json();
            if (reply && reply.kind === 'pair-mode-takeover-fired') {
              pairModeState = reply.pair_mode_state;
            }
          } catch {
            // Non-JSON success is unexpected but not fatal.
          }
        } else if (res.status === 503) {
          // Pre-harness forward path: drop silently, suppress
          // further sends. The Slice 5 takeover-trigger path
          // returns 200, not 503.
          harnessOffline = true;
          if (statusPill) {
            statusPill.title = 'Live input forwarding pending harness end-to-end';
          }
        } else if (res.status === 409) {
          // 409 = pair-mode mid-transition (takeover-pending etc.);
          // wait + retry on next event. Don't latch offline.
        } else if (!res.ok) {
          paintError('POST /input-event returned ' + res.status.toString());
        }
      } catch {
        // Network drop — let next event retry (don't latch offline).
      }
    }

    if (overlay) {
      overlay.addEventListener('mousemove', (ev) => {
        const now = Date.now();
        if (now - lastMouseMoveAt < MOUSE_MOVE_THROTTLE_MS) return;
        lastMouseMoveAt = now;
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({ type: 'mouseMove', x, y });
      });
      overlay.addEventListener('mousedown', (ev) => {
        const button = mouseButton(ev.button);
        if (button === null) return;
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({ type: 'mouseDown', x, y, button });
      });
      overlay.addEventListener('mouseup', (ev) => {
        const button = mouseButton(ev.button);
        if (button === null) return;
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({ type: 'mouseUp', x, y, button });
      });
      overlay.addEventListener('wheel', (ev) => {
        const { x, y } = viewportCoords(ev, overlay);
        void sendInputEvent({
          type: 'wheel',
          x,
          y,
          deltaX: Math.round(ev.deltaX),
          deltaY: Math.round(ev.deltaY),
        });
      });
    }

    // Keyboard targets the document, NOT the overlay (focus is usually
    // elsewhere — composer textarea, etc.). Only fire when mode ∈
    // {manual, pair} AND focus is on the workbench page root (not the
    // composer textarea, which already handles its own input).
    document.addEventListener('keydown', (ev) => {
      if (mode === 'ai') return;
      if (composerTextarea && document.activeElement === composerTextarea) return;
      void sendInputEvent({ type: 'keyDown', key: ev.key, modifiers: modifiersFromEvent(ev) });
    });
    document.addEventListener('keyup', (ev) => {
      if (mode === 'ai') return;
      if (composerTextarea && document.activeElement === composerTextarea) return;
      void sendInputEvent({ type: 'keyUp', key: ev.key, modifiers: modifiersFromEvent(ev) });
    });

    // 2026-05-21 — V-666.AI-A composer wire-up. Optimistic-render the
    // customer's turn into the transcript immediately, then POST to
    // /v1/agent-sessions/:id/message. On response, append the agent's
    // turn (intent decomposition output). On error, mark the customer
    // bubble with a retry affordance + leave the textarea content
    // populated so the customer can resend without retyping.
    const transcript = root.querySelector('[data-component="ChatTranscript"]');
    const emptyHint = transcript?.querySelector('[data-empty]');
    let pendingTurnEl = null;

    function appendTurn(role, body) {
      if (!transcript) return null;
      if (emptyHint && !emptyHint.classList.contains('hidden')) {
        emptyHint.classList.add('hidden');
      }
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-col gap-1';
      wrap.dataset.role = role;
      const ts = Date.now();
      wrap.dataset.turnTs = String(ts);
      const labelRow = document.createElement('div');
      labelRow.className = 'flex items-baseline justify-between gap-3';
      const label = document.createElement('span');
      label.className =
        'text-[10px] font-mono uppercase tracking-widest ' +
        (role === 'agent' ? 'text-glow-red' : 'text-ink-muted');
      label.textContent = role === 'agent' ? 'agent' : 'you';
      const time = document.createElement('time');
      time.className = 'text-[10px] font-mono text-ink-muted';
      time.dataset.turnAge = String(ts);
      time.dateTime = new Date(ts).toISOString();
      time.textContent = 'now';
      labelRow.appendChild(label);
      labelRow.appendChild(time);
      const bubble = document.createElement('div');
      bubble.className =
        'whitespace-pre-wrap break-words rounded-md px-3 py-2 text-sm ' +
        (role === 'agent'
          ? 'bg-glow-red/5 text-ink-primary'
          : 'bg-slate-800 text-ink-primary');
      bubble.textContent = body;
      wrap.appendChild(labelRow);
      wrap.appendChild(bubble);
      transcript.appendChild(wrap);
      transcript.scrollTop = transcript.scrollHeight;
      return wrap;
    }

    // Tick the per-turn timestamps every 5s ("now" → "5s ago" →
    // "30s ago" → "1m ago" → "2h ago"). Cheaper than RelativeTimeFormat
    // for short windows + matches the admin overview live-feed style.
    function fmtTurnAge(ms) {
      const s = Math.floor((Date.now() - ms) / 1000);
      if (s < 5) return 'now';
      if (s < 60) return s.toString() + 's ago';
      if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
      return Math.floor(s / 3600).toString() + 'h ago';
    }
    setInterval(() => {
      const els = document.querySelectorAll('[data-turn-age]');
      els.forEach((el) => {
        const ts = Number(el.getAttribute('data-turn-age'));
        if (Number.isFinite(ts)) el.textContent = fmtTurnAge(ts);
      });
    }, 5_000);

    composerForm?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!composerTextarea) return;
      const text = composerTextarea.value.trim();
      if (text.length === 0) return;
      composerTextarea.value = '';
      if (composerSubmit) composerSubmit.disabled = true;

      const customerBubble = appendTurn('customer', text);
      // Pending agent bubble — three pulsing dots replace the
      // "thinking…" text when POST resolves. Pulse cadence staggered
      // 200ms per dot via inline animation-delay so it reads as a
      // live typing indicator.
      pendingTurnEl = appendTurn('agent', '');
      if (pendingTurnEl) {
        const bub = pendingTurnEl.querySelector('div:last-child');
        if (bub) {
          bub.innerHTML =
            '<span class="inline-flex items-center gap-1" aria-label="agent is thinking">' +
            '<span class="inline-block h-2 w-2 rounded-full bg-glow-red animate-pulse"></span>' +
            '<span class="inline-block h-2 w-2 rounded-full bg-glow-red animate-pulse" style="animation-delay:200ms"></span>' +
            '<span class="inline-block h-2 w-2 rounded-full bg-glow-red animate-pulse" style="animation-delay:400ms"></span>' +
            '</span>';
        }
      }

      try {
        const res = await fetch(
          apiBaseUrl + '/v1/agent-sessions/' + encodeURIComponent(sessionId) + '/message',
          {
            method: 'POST',
            headers: { 'content-type': 'application/json', ...authHeaders() },
            body: JSON.stringify({ content: text }),
          },
        );
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          const detail = body.detail || 'HTTP ' + res.status.toString();
          if (pendingTurnEl) {
            const bub = pendingTurnEl.querySelector('div:last-child');
            if (bub) {
              bub.textContent = '⚠ ' + detail + ' — your message above is preserved; click to retry.';
              bub.className = 'rounded-md bg-red-900/30 px-3 py-2 text-sm text-rose-300';
              bub.style.cursor = 'pointer';
              bub.addEventListener('click', () => {
                if (composerTextarea) {
                  composerTextarea.value = text;
                  composerTextarea.focus();
                }
              });
            }
          }
          return;
        }
        // V-666.AI-A response shape: { transcript: [...] } OR
        // { intent_calls: [...] } — render whatever's present as the
        // agent reply. SSE streaming is the V-666.AI-D follow-up.
        const replyText =
          (typeof body.reply === 'string' && body.reply) ||
          (Array.isArray(body.transcript) &&
            body.transcript[body.transcript.length - 1] &&
            body.transcript[body.transcript.length - 1].content) ||
          (Array.isArray(body.intent_calls) &&
            'Planned ' +
              body.intent_calls.length.toString() +
              ' intent' +
              (body.intent_calls.length === 1 ? '' : 's') +
              ': ' +
              body.intent_calls
                .map((c) => (typeof c.verb === 'string' ? c.verb : 'step'))
                .join(' → ')) ||
          'Done.';
        if (pendingTurnEl) {
          const bub = pendingTurnEl.querySelector('div:last-child');
          if (bub) bub.textContent = replyText;
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        if (pendingTurnEl) {
          const bub = pendingTurnEl.querySelector('div:last-child');
          if (bub) {
            bub.textContent = '⚠ ' + msg + ' — click to retry.';
            bub.className = 'rounded-md bg-red-900/30 px-3 py-2 text-sm text-rose-300';
            bub.style.cursor = 'pointer';
            bub.addEventListener('click', () => {
              if (composerTextarea) {
                composerTextarea.value = text;
                composerTextarea.focus();
              }
            });
          }
        }
      } finally {
        if (composerSubmit) composerSubmit.disabled = false;
        pendingTurnEl = null;
        // Suppress unused-var warning for customerBubble (used for DOM side-effect).
        void customerBubble;
      }
    });

    composerTextarea?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' && (ev.metaKey || ev.ctrlKey)) {
        ev.preventDefault();
        composerForm?.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    });

    paintMode();
    void hydrateFromServer();
  </script>
</DashboardLayout>
