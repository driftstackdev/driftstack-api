---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-217 — progressive-enhancement live wiring against:
//   - /v1/account/email-preferences (V-204) — list + PUT per-event toggles
//
// SSG renders mocks; inline <script> reads ds_web_session_token from
// localStorage and replaces the live sections. The security surfaces
// (change password V-079, MFA V-353h, active sign-ins V-355, connected
// accounts, recent activity V-216, and the danger zone) moved to
// /security (security.astro) with the 2026-07-03 design-system v2
// split.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

// V-204 opt-outable email events. Mirrors OptOutableEmailEventSchema.
const EMAIL_EVENTS = [
  {
    type: 'signup-welcome',
    label: 'Signup welcome',
    description: 'Once-after-verification onboarding email.',
  },
  {
    type: 'session-failed-first',
    label: 'First session failure',
    description: 'One-time notice the first time a session fails on this account.',
  },
  {
    type: 'session-success-first',
    label: 'First session success',
    description:
      'One-time activation email after your first session completes successfully. Subsequent sessions don\'t notify; the dashboard takes over.',
  },
  {
    type: 'tier-changed',
    label: 'Subscription tier changed',
    description: 'Confirmation when your tier changes via the Stripe portal.',
  },
  {
    type: 'billing-receipt',
    label: 'Billing receipts',
    description: 'Per-invoice receipt emails. Stripe receipts continue regardless.',
  },
  {
    type: 'billing-renewal-reminder',
    label: 'Renewal reminder',
    description:
      'Heads-up email ~7 days before each subscription renewal so you can update payment method or change tier ahead of time.',
  },
] as const;
---

<DashboardLayout title="Settings">
  <div class="mx-auto max-w-3xl px-6 py-10" data-page="settings">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-tk-ink-3" data-field="header-account">
        Account
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Settings</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Account profile, email notifications, and your Anthropic API key.
        Changes here affect all sessions, profiles, and webhooks under this
        account.
      </p>
      <p class="mt-2 text-sm text-tk-ink-3">
        Security, sign-ins &amp; danger zone moved to
        <a href="/security" class="text-tk-accent-text underline">Privacy &amp; security</a>.
      </p>
    </header>

    {/*
      2026-06-24 — the legacy "Profile" section (Name + Email inputs seeded
      from the mock account, with a no-op "Save changes" button) was removed.
      It was dead scaffolding superseded by the live "Display & locale"
      section below (data-region="profile"), which wires display name /
      timezone / slug / region / avatar to PATCH /v1/account/me. The header
      above shows the live account identity. No mock-account literal ships.
    */}

    <!-- Profile basics (V-352 — name + timezone) -->
    <section class="dashboard-card mt-6" data-region="profile">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          </svg>
        </span>
        Display &amp; locale
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Avatar, display name, timezone and data residency. Used by the dashboard
        + outbound emails to render timestamps in your local time.
      </p>
      <form data-form="profile" class="mt-6 space-y-4">
        <!-- V-352b — avatar upload -->
        <div class="flex items-center gap-4">
          <div
            data-field="avatar-preview"
            class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border border-tk-border bg-tk-surface text-xs text-tk-ink-3"
          >
            no avatar
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <label
                class="btn-secondary inline-flex cursor-pointer text-sm"
                for="profile-avatar-input"
              >
                Upload image
              </label>
              <input
                id="profile-avatar-input"
                data-field="avatar-input"
                type="file"
                accept="image/png,image/jpeg,image/webp"
                class="hidden"
              />
              <button
                type="button"
                data-button="avatar-remove"
                class="btn-secondary text-sm text-tk-err-text"
                hidden
              >
                Remove
              </button>
            </div>
            {/* S30 2026-07-07 (founder decision: soften) — avatars live
                on Cloudflare R2 in the default jurisdiction (EU + US
                replication), so the "(EU)" tag over-claimed. */}
            <p class="text-xs text-tk-ink-3">
              PNG, JPEG, or WebP. Max 2 MB. Stored privately on Cloudflare R2.
            </p>
            <p
              data-field="avatar-error"
              class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-2 py-1 text-xs text-tk-err-text"
            ></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-name">
            Display name
          </label>
          <input
            id="profile-name"
            data-field="profile-name"
            type="text"
            placeholder="Optional — leave blank to use your email"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-timezone">
            Timezone (IANA)
          </label>
          <input
            id="profile-timezone"
            data-field="profile-timezone"
            type="text"
            placeholder="Europe/Amsterdam"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            IANA name like <code class="font-mono">Europe/Amsterdam</code> or
            <code class="font-mono">America/Los_Angeles</code>. Leave blank for UTC.
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-slug">
            Account handle (slug)
          </label>
          <input
            id="profile-slug"
            data-field="profile-slug"
            type="text"
            inputmode="text"
            autocomplete="off"
            placeholder="acme-corp"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 font-mono text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            Lowercase a-z, 0-9, and hyphen. 3-32 chars. Used as a stable
            handle on support tickets, billing references, and audit
            entries. Leave blank to keep using the account UUID.
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-region">
            Data-residency region (preference)
          </label>
          <select
            id="profile-region"
            data-field="profile-region"
            class="mt-1 w-full rounded-md border border-tk-border bg-tk-surface px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          >
            <option value="">— no preference —</option>
            <option value="us">us — Americas</option>
            <option value="eu">eu — Europe</option>
            <option value="apac">apac — Asia-Pacific</option>
          </select>
          <p class="mt-1 text-xs text-tk-ink-3">
            Customer-stated preference. Currently informational; physical
            region routing of compute and storage is governed by the
            sub-processor list (see <a href="https://driftstack.dev/trust/sub-processors" class="text-tk-accent-text underline">driftstack.dev/trust/sub-processors</a>).
          </p>
        </div>
        <p
          data-field="profile-error"
          class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-3 py-2 text-sm text-tk-err-text"
        ></p>
        <div class="flex items-center justify-between border-t border-tk-border pt-4">
          <span data-field="profile-status" class="text-xs text-tk-ink-3"></span>
          <button
            type="submit"
            data-button="profile-save"
            class="btn-primary"
          >
            Save
          </button>
        </div>
      </form>
    </section>

    {/*
      2026-05-22 — V-666 BYOK Anthropic key UI. Customer can store
      their own Anthropic API key so the AI agent runs on their
      budget (instead of Driftstack's bundled fallback). The
      ciphertext is AES-256-GCM encrypted with MFA_ENCRYPTION_KEY
      server-side; plaintext leaves the browser exactly once on PUT.
      Three actions surface here: Save (PUT), Test (POST /test), Clear
      (DELETE). The GET /byok-anthropic-key endpoint returns metadata
      only (set_at + masked prefix) — never the plaintext, even to
      the owner.
    */}
    <section class="dashboard-card mt-6" data-region="byok-anthropic">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="12" r="7" />
            <path d="M16 12h6M19 9v6" />
          </svg>
        </span>
        Anthropic API key (BYOK)
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Bring your own Anthropic key so AI agent turns bill to your Anthropic console.
        Stored encrypted at rest; we never read or log the plaintext after you submit
        it. <a
          href="https://console.anthropic.com/settings/keys"
          target="_blank"
          rel="noopener noreferrer"
          class="text-tk-accent-text hover:underline"
        >Generate a key →</a>
      </p>

      <div data-byok-state="loading" class="mt-6 text-sm text-tk-ink-3">
        Checking key status…
      </div>

      <div data-byok-state="empty" class="mt-6 hidden">
        <p class="text-sm text-tk-ink-2">No key on file. Agent sessions fall back to the bundled key (if enabled on your tier).</p>
      </div>

      <div data-byok-state="set" class="mt-6 hidden space-y-2">
        <div class="flex items-center gap-3">
          <span class="rounded-full bg-tk-ready/10 px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-tk-ready-text">
            Active
          </span>
          <span class="text-sm text-tk-ink-2">
            Key set <time data-byok-set-at>—</time>; prefix
            <code class="font-mono text-xs text-tk-ink" data-byok-prefix>—</code>
          </span>
        </div>
      </div>

      {/* S35 2026-07-07 (fable-frontend-audit) — dedicated load-failure
          state. A transient non-2xx on the status GET used to fall back
          to the 'empty' panel, telling a customer WITH a stored key
          "No key on file" — a false claim about their credential. */}
      <div data-byok-state="error" class="mt-6 hidden">
        <p class="text-sm text-tk-ink-2">
          Couldn't check your key status just now — this is a loading problem,
          not a missing key. Your stored key (if any) is untouched.
          <button type="button" data-byok-retry class="text-tk-accent-text hover:underline">
            Try again
          </button>
        </p>
      </div>

      <div data-byok-error class="mt-6 hidden rounded-md bg-tk-accent/10 px-3 py-2 text-sm text-tk-accent-text"></div>

      <form data-byok-form class="mt-6 flex flex-wrap items-center gap-3" autocomplete="off">
        <label for="byok-key" class="sr-only">Anthropic API key</label>
        <input
          id="byok-key"
          type="password"
          name="byok-key"
          placeholder="sk-ant-..."
          autocomplete="off"
          spellcheck="false"
          class="flex-1 min-w-[260px] rounded-md border border-tk-border bg-tk-bg px-3 py-2 font-mono text-sm text-tk-ink placeholder-ink-muted focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
        />
        <button type="submit" class="btn-primary">Save key</button>
        <button type="button" data-byok-test class="btn-secondary">Test</button>
        <button type="button" data-byok-clear class="text-sm text-tk-err-text hover:underline">
          Clear
        </button>
      </form>

      <p class="mt-3 text-xs text-tk-ink-3">
        Test sends a 1-token completion to verify Anthropic accepts the key. Clear
        removes the stored ciphertext; agent turns immediately fall back to the
        bundled key (if available).
      </p>
    </section>

    <!-- Email notifications (V-204 — live-wired) -->
    <section class="dashboard-card mt-6" data-region="email-prefs">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" /><polyline points="22,6 12,13 2,6" />
          </svg>
        </span>
        Email notifications
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Security + financial emails (signup verification, password reset,
        billing failure, subscription cancellation, support replies) always
        go out. Below are the optional lifecycle emails — toggle off any
        you don't want.
      </p>
      <div class="mt-6 space-y-3" data-list="email-prefs">
        {
          EMAIL_EVENTS.map((event) => (
            <label class="flex items-start gap-3">
              <input
                type="checkbox"
                data-event-type={event.type}
                checked
                class="mt-0.5"
                disabled
              />
              <span class="text-sm text-tk-ink-2">
                <strong class="block font-medium text-tk-ink">{event.label}</strong>
                {event.description}
              </span>
            </label>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-tk-ink-3" data-field="email-prefs-status">
        Sign in to load live preferences.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="settings"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      // V-352c / V-298a — wire the profile (name + timezone + slug) form.
      const profileForm = root.querySelector('[data-form="profile"]');
      const profileNameInput = root.querySelector('[data-field="profile-name"]');
      const profileTzInput = root.querySelector('[data-field="profile-timezone"]');
      const profileSlugInput = root.querySelector('[data-field="profile-slug"]');
      const profileRegionInput = root.querySelector('[data-field="profile-region"]');
      const profileError = root.querySelector('[data-field="profile-error"]');
      const profileStatus = root.querySelector('[data-field="profile-status"]');
      const profileSaveBtn = root.querySelector('[data-button="profile-save"]');

      function showProfileError(msg) {
        if (!profileError) return;
        profileError.textContent = msg;
        profileError.classList.remove('hidden');
      }

      // V-352b — avatar elements + helpers.
      const avatarPreview = root.querySelector('[data-field="avatar-preview"]');
      const avatarInput = root.querySelector('[data-field="avatar-input"]');
      const avatarRemoveBtn = root.querySelector('[data-button="avatar-remove"]');
      const avatarError = root.querySelector('[data-field="avatar-error"]');

      function showAvatarError(msg) {
        if (!avatarError) return;
        avatarError.textContent = msg;
        avatarError.classList.remove('hidden');
      }
      function clearAvatarError() {
        if (!avatarError) return;
        avatarError.textContent = '';
        avatarError.classList.add('hidden');
      }

      function setAvatarPreview(url) {
        if (!avatarPreview) return;
        if (url) {
          avatarPreview.innerHTML =
            '<img src="' +
            escapeHtml(url) +
            '" alt="avatar" class="h-full w-full object-cover" />';
          if (avatarRemoveBtn) avatarRemoveBtn.hidden = false;
        } else {
          avatarPreview.innerHTML = 'no avatar';
          if (avatarRemoveBtn) avatarRemoveBtn.hidden = true;
        }
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = reader.result;
            if (typeof result !== 'string') {
              reject(new Error('Failed to read file.'));
              return;
            }
            // Strip the data:<mime>;base64, prefix.
            const idx = result.indexOf(',');
            resolve(idx >= 0 ? result.slice(idx + 1) : result);
          };
          reader.onerror = () => reject(new Error('Failed to read file.'));
          reader.readAsDataURL(file);
        });
      }

      // Load current profile values (GET /v1/account/me).
      if (token && profileNameInput && profileTzInput) {
        fetch(apiBaseUrl + '/v1/account/me', {
          headers: { authorization: 'Bearer ' + token },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((me) => {
            if (!me) return;
            if (me.name) profileNameInput.value = me.name;
            if (me.timezone) profileTzInput.value = me.timezone;
            if (profileSlugInput && me.slug) profileSlugInput.value = me.slug;
            if (profileRegionInput && me.region) profileRegionInput.value = me.region;
            // audit w2flmiw48 #3 — the header account-id used to be seeded
            // from the mock account and never overwritten by live data (so
            // every customer saw the mock id). Populate it from /account/me.
            // (The legacy mock-seeded email input was removed 2026-06-24.)
            if (me.id) {
              const headerAcct = document.querySelector('[data-field="header-account"]');
              if (headerAcct) headerAcct.textContent = 'Account · ' + me.id.slice(0, 16) + '…';
            }
            // V-352b — initial avatar preview.
            setAvatarPreview(me.avatar_url || null);
          })
          .catch(() => {
            /* leave inputs blank */
          });
      }

      // V-352b — avatar upload handler.
      if (avatarInput) {
        avatarInput.addEventListener('change', (ev) => {
          clearAvatarError();
          const target = ev.target;
          if (!(target instanceof HTMLInputElement)) return;
          const file = target.files && target.files[0];
          if (!file) return;
          if (!token) {
            showAvatarError('Sign in to upload an avatar.');
            target.value = '';
            return;
          }
          if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
            showAvatarError('Only PNG, JPEG, or WebP allowed.');
            target.value = '';
            return;
          }
          if (file.size > 2 * 1024 * 1024) {
            showAvatarError('Image is over 2 MB.');
            target.value = '';
            return;
          }
          fileToBase64(file)
            .then((b64) =>
              fetch(apiBaseUrl + '/v1/account/me/avatar', {
                method: 'POST',
                headers: {
                  'content-type': 'application/json',
                  authorization: 'Bearer ' + token,
                },
                body: JSON.stringify({
                  content_type: file.type,
                  data_base64: b64,
                }),
              }),
            )
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              setAvatarPreview(body.avatar_url || null);
            })
            .catch((err) => {
              showAvatarError(err && err.message ? err.message : 'Upload failed.');
            })
            .finally(() => {
              target.value = '';
            });
        });
      }

      // V-352b — avatar remove handler.
      if (avatarRemoveBtn) {
        avatarRemoveBtn.addEventListener('click', () => {
          clearAvatarError();
          if (!token) {
            showAvatarError('Sign in to remove your avatar.');
            return;
          }
          fetch(apiBaseUrl + '/v1/account/me/avatar', {
            method: 'DELETE',
            headers: { authorization: 'Bearer ' + token },
          })
            .then((r) => {
              if (r.status === 204 || r.ok) return null;
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
            })
            .then(() => {
              setAvatarPreview(null);
            })
            .catch((err) => {
              showAvatarError(err && err.message ? err.message : 'Remove failed.');
            });
        });
      }

      if (profileForm) {
        profileForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (profileError) {
            profileError.classList.add('hidden');
            profileError.textContent = '';
          }
          if (!token) {
            showProfileError('Sign in to update your profile.');
            return;
          }
          const name = profileNameInput.value.trim();
          const tz = profileTzInput.value.trim();
          const slug = profileSlugInput ? profileSlugInput.value.trim() : '';
          if (profileSaveBtn) {
            profileSaveBtn.disabled = true;
            profileSaveBtn.textContent = 'Saving…';
          }
          const body = {
            name: name.length > 0 ? name : null,
            timezone: tz.length > 0 ? tz : null,
          };
          // V-298a — only include slug when the input exists; the backend
          // refines reject of "no fields" still allows name/timezone-only.
          if (profileSlugInput) {
            body.slug = slug.length > 0 ? slug : null;
          }
          // V-298b — region from select; '' = no preference (null).
          if (profileRegionInput) {
            const region = profileRegionInput.value || '';
            body.region = region.length > 0 ? region : null;
          }
          fetch(apiBaseUrl + '/v1/account/me', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify(body),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              if (profileStatus) {
                profileStatus.textContent = 'Saved.';
                window.setTimeout(() => {
                  if (profileStatus) profileStatus.textContent = '';
                }, 3000);
              }
            })
            .catch((err) => {
              showProfileError(err && err.message ? err.message : 'Failed to save.');
            })
            .finally(() => {
              if (profileSaveBtn) {
                profileSaveBtn.disabled = false;
                profileSaveBtn.textContent = 'Save';
              }
            });
        });
      }

      function authedFetch(path, init = {}) {
        return fetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // V-204 — email preferences live wire.
      const emailPrefsList = root.querySelector('[data-list="email-prefs"]');
      const emailPrefsStatus = root.querySelector('[data-field="email-prefs-status"]');

      function setEmailPrefsState(prefs) {
        if (!emailPrefsList) return;
        const inputs = emailPrefsList.querySelectorAll('input[type="checkbox"][data-event-type]');
        inputs.forEach((input) => {
          input.disabled = false;
          const eventType = input.getAttribute('data-event-type');
          const pref = prefs.find((p) => p.event_type === eventType);
          input.checked = pref ? pref.opted_in : true;
        });
        if (emailPrefsStatus) {
          emailPrefsStatus.textContent =
            'Toggle off any lifecycle email you do not want. Changes save automatically.';
        }
      }

      function loadEmailPrefs() {
        if (!token || !emailPrefsList) return;
        authedFetch('/v1/account/email-preferences', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => setEmailPrefsState(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load email preferences (" + msg + ').');
          });
      }

      function saveEmailPref(eventType, optedIn, input) {
        if (!token) return;
        if (input) input.disabled = true;
        authedFetch('/v1/account/email-preferences', {
          method: 'PUT',
          body: JSON.stringify({ event_type: eventType, opted_in: optedIn }),
        })
          .then((r) => {
            if (r.status === 204 || r.ok) return null;
            return Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(() => {
            showBanner('Email preference saved.');
            setTimeout(hideBanner, 2000);
          })
          .catch((err) => {
            // The checkbox already flipped optimistically on 'change' —
            // revert it so the displayed state matches what the server
            // actually has, instead of silently lying about whether the
            // customer is opted in/out of this email.
            if (input) input.checked = !optedIn;
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't save email preference (" + msg + ').');
          })
          .finally(() => {
            if (input) input.disabled = false;
          });
      }

      if (emailPrefsList) {
        emailPrefsList.addEventListener('change', (ev) => {
          const target = ev.target;
          if (
            !(target instanceof HTMLInputElement) ||
            target.type !== 'checkbox' ||
            !target.getAttribute('data-event-type')
          )
            return;
          const eventType = target.getAttribute('data-event-type');
          if (eventType) saveEmailPref(eventType, target.checked, target);
        });
      }

      // 2026-05-22 — V-666 BYOK Anthropic key wiring. Three actions:
      //   Save → PUT /v1/account/me/byok-anthropic-key
      //   Test → POST /v1/account/me/byok-anthropic-key/test
      //   Clear → DELETE /v1/account/me/byok-anthropic-key
      // Status fetch on load: GET returns metadata only (set_at +
      // masked prefix); never plaintext. Plaintext goes over the
      // wire exactly once (Save), never re-displayed.
      const byokForm = document.querySelector('[data-byok-form]');
      const byokInput = document.querySelector('#byok-key');
      const byokTestBtn = document.querySelector('[data-byok-test]');
      const byokClearBtn = document.querySelector('[data-byok-clear]');
      const byokError = document.querySelector('[data-byok-error]');
      const byokStateLoading = document.querySelector('[data-byok-state="loading"]');
      const byokStateEmpty = document.querySelector('[data-byok-state="empty"]');
      const byokStateSet = document.querySelector('[data-byok-state="set"]');
      // S35 2026-07-07 (fable-frontend-audit) — 4th state: load failure.
      const byokStateError = document.querySelector('[data-byok-state="error"]');
      const byokRetryBtn = document.querySelector('[data-byok-retry]');
      const byokSetAt = document.querySelector('[data-byok-set-at]');
      const byokPrefix = document.querySelector('[data-byok-prefix]');

      function byokShowState(name) {
        [byokStateLoading, byokStateEmpty, byokStateSet, byokStateError].forEach((el) => {
          if (el) el.classList.add('hidden');
        });
        const el = document.querySelector('[data-byok-state="' + name + '"]');
        if (el) el.classList.remove('hidden');
      }
      function byokShowError(msg) {
        if (!byokError) return;
        byokError.textContent = msg;
        byokError.classList.remove('hidden');
      }
      function byokHideError() {
        if (byokError) byokError.classList.add('hidden');
      }

      function loadByokAnthropic() {
        if (!token) return;
        byokShowState('loading');
        fetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key', {
          headers: { authorization: 'Bearer ' + token },
        })
          .then((r) => {
            if (r.status === 404) return null; // empty (no key set)
            // S35 2026-07-07 (fable-frontend-audit) — parse-safe: a 5xx
            // from a gateway carries an HTML body, so r.json() itself
            // rejects; .catch(() => ({})) keeps the HTTP status as the
            // surfaced error instead of a JSON-parse one.
            if (!r.ok)
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
            return r.json();
          })
          .then((body) => {
            byokHideError();
            if (body === null || !body.key_set) {
              byokShowState('empty');
              return;
            }
            if (byokSetAt && body.set_at) {
              const d = new Date(body.set_at);
              byokSetAt.dateTime = d.toISOString();
              byokSetAt.textContent = d.toISOString().slice(0, 10);
            }
            if (byokPrefix && body.key_prefix) byokPrefix.textContent = body.key_prefix;
            byokShowState('set');
          })
          .catch((err) => {
            // S35 2026-07-07 (fable-frontend-audit) — a load FAILURE is
            // not an empty keyring: showing 'empty' here told a customer
            // with a stored key "No key on file" on any transient non-2xx.
            byokShowError(err && err.message ? err.message : 'network error');
            byokShowState('error');
          });
      }

      if (byokRetryBtn) byokRetryBtn.addEventListener('click', loadByokAnthropic);

      if (byokForm) {
        byokForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!byokInput || !token) return;
          const key = byokInput.value.trim();
          if (key.length === 0) {
            byokShowError('Paste an Anthropic API key first.');
            return;
          }
          byokHideError();
          fetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key', {
            method: 'PUT',
            headers: {
              authorization: 'Bearer ' + token,
              'content-type': 'application/json',
            },
            body: JSON.stringify({ api_key: key }),
          })
            .then((r) => {
              // S35 2026-07-07 (fable-frontend-audit) — parse-safe non-2xx
              // handling (HTML error bodies reject r.json()).
              if (!r.ok)
                return r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
              return r.json();
            })
            .then(() => {
              if (byokInput) byokInput.value = '';
              loadByokAnthropic();
            })
            .catch((err) => byokShowError(err && err.message ? err.message : 'network error'));
        });
      }

      if (byokTestBtn) {
        byokTestBtn.addEventListener('click', () => {
          if (!byokInput || !token) return;
          const key = byokInput.value.trim();
          // Test the field's content if present (e.g. before save);
          // otherwise test the stored key (server reads ciphertext).
          const payload = key.length > 0 ? { api_key: key } : {};
          byokTestBtn.disabled = true;
          byokTestBtn.textContent = 'Testing…';
          byokHideError();
          fetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key/test', {
            method: 'POST',
            headers: {
              authorization: 'Bearer ' + token,
              'content-type': 'application/json',
            },
            body: JSON.stringify(payload),
          })
            .then((r) =>
              // S35 2026-07-07 (fable-frontend-audit) — parse-safe non-2xx.
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              byokTestBtn.textContent = body.ok === true ? 'Test ✓' : 'Test ⚠';
              setTimeout(() => {
                byokTestBtn.textContent = 'Test';
                byokTestBtn.disabled = false;
              }, 2000);
              if (body.ok !== true) byokShowError(body.detail || 'Test call failed.');
            })
            .catch((err) => {
              byokTestBtn.textContent = 'Test ⚠';
              setTimeout(() => {
                byokTestBtn.textContent = 'Test';
                byokTestBtn.disabled = false;
              }, 2000);
              byokShowError(err && err.message ? err.message : 'network error');
            });
        });
      }

      if (byokClearBtn) {
        byokClearBtn.addEventListener('click', async () => {
          if (!token) return;
          if (
            !(await window.driftstackConfirm(
              'Clear your stored Anthropic key? Agent sessions will fall back to the bundled key (if available on your tier).',
              { confirmLabel: 'Clear key', destructive: true },
            ))
          )
            return;
          fetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key', {
            method: 'DELETE',
            headers: { authorization: 'Bearer ' + token },
          })
            .then((r) => {
              // S35 2026-07-07 (fable-frontend-audit) — parse-safe non-2xx.
              if (!r.ok && r.status !== 404)
                return r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
              loadByokAnthropic();
            })
            .catch((err) => byokShowError(err && err.message ? err.message : 'network error'));
        });
      }

      if (!token) {
        showBanner('Sign in to see live preferences + recent activity.');
        return;
      }

      loadEmailPrefs();
      loadByokAnthropic();
      // 2026-05-21 — opacity-gate signal. Two loaders fire in parallel
      // without returning promises (legacy shape). Fire the reveal in
      // a microtask so the first paint happens after the network
      // requests are scheduled; far better UX than waiting the 1200ms
      // safety cap. Fields populate as each request resolves.
      queueMicrotask(function () {
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
      });
    })();
  </script>
</DashboardLayout>
