---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_ACCOUNT } from '../data/mocks.ts';

// V-217 — progressive-enhancement live wiring against:
//   - /v1/account/email-preferences (V-204) — list + PUT per-event toggles
//   - /v1/account/audit-log (V-216) — recent customer-visible events
//   - /v1/auth/password-reset/request (V-079) — change-password trigger
//
// SSG renders mocks; inline <script> reads ds_web_session_token from
// localStorage and replaces the live sections. Profile + Active
// sign-ins remain on mock — those wires land in follow-up slices
// (/v1/account profile endpoint doesn't exist yet; sign-in tracking
// is a separate concern).

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';

// V-204 opt-outable email events. Mirrors OptOutableEmailEventSchema.
const EMAIL_EVENTS = [
  {
    type: 'signup-welcome',
    label: 'Signup welcome',
    description: 'Once-after-verification onboarding email.',
  },
  {
    type: 'session-failed-first',
    label: 'First session failure',
    description: 'One-time notice the first time a session fails on this account.',
  },
  {
    type: 'session-success-first',
    label: 'First session success',
    description:
      'One-time activation email after your first session completes successfully. Subsequent sessions don\'t notify; the dashboard takes over.',
  },
  {
    type: 'tier-changed',
    label: 'Subscription tier changed',
    description: 'Confirmation when your tier changes via the Stripe portal.',
  },
  {
    type: 'trial-pack-purchased',
    label: 'Trial pack purchased',
    description: 'Confirmation after the $2.99 checkout succeeds.',
  },
  {
    type: 'trial-pack-expired',
    label: 'Trial pack expired',
    description: 'Notice when the 14-day trial-pack window closes.',
  },
  {
    type: 'billing-receipt',
    label: 'Billing receipts',
    description: 'Per-invoice receipt emails. Stripe receipts continue regardless.',
  },
  {
    type: 'billing-renewal-reminder',
    label: 'Renewal reminder',
    description:
      'Heads-up email ~7 days before each subscription renewal so you can update payment method or change tier ahead of time.',
  },
] as const;
---

<DashboardLayout title="Settings">
  <div class="mx-auto max-w-3xl px-6 py-10" data-page="settings">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-slate-500" data-field="header-account">
        Account · {MOCK_ACCOUNT.id.slice(0, 16)}…
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Settings</h1>
      <p class="mt-2 max-w-prose text-sm text-slate-500">
        Account profile, security, and the danger zone. Changes here affect
        all sessions, profiles, and webhooks under this account.
      </p>
    </header>

    <!-- Profile -->
    <section class="dashboard-card">
      <h2 class="text-lg font-semibold text-slate-900">Profile</h2>
      <p class="mt-2 text-sm text-slate-500">
        Display name + email shown on invoices and webhook delivery audit logs.
      </p>
      <div class="mt-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="name">Name</label>
          <input
            id="name"
            type="text"
            value={MOCK_ACCOUNT.name ?? ''}
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="email">Email</label>
          <input
            id="email"
            type="email"
            value={MOCK_ACCOUNT.email}
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <p class="mt-1 text-xs text-slate-500">
            Verified {fmtIso(MOCK_ACCOUNT.emailVerifiedAt)}. Changing email
            triggers re-verification.
          </p>
        </div>
        <button class="btn-primary mt-2">Save changes</button>
        <p class="text-xs text-slate-400">
          Profile editing endpoint lands as a follow-up slice; saves are
          currently no-op.
        </p>
      </div>
    </section>

    <!-- Security -->
    <section class="dashboard-card mt-6">
      <h2 class="text-lg font-semibold text-slate-900">Security</h2>
      <p class="mt-2 text-sm text-slate-500">Password + recovery options.</p>
      <div class="mt-6 space-y-3">
        <button type="button" data-action="change-password" class="btn-secondary inline-flex">
          Change password
        </button>
        <p class="text-xs text-slate-500">
          We email you a magic link to confirm. The link expires after 15
          minutes; old sessions stay signed in until they naturally expire.
        </p>
      </div>
    </section>

    <!-- Two-factor authentication (V-353h) -->
    <section class="dashboard-card mt-6" data-region="mfa">
      <div class="flex items-start justify-between gap-6">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">Two-factor authentication</h2>
          <p class="mt-2 max-w-prose text-sm text-slate-500">
            Add a TOTP code from your authenticator app on top of your password.
            Recovery codes are issued at enrollment — store them somewhere safe;
            without your authenticator AND your recovery codes, account access
            requires support intervention.
          </p>
        </div>
        <span
          data-field="mfa-status-badge"
          class="shrink-0 rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600"
        >
          loading…
        </span>
      </div>

      <!-- Enroll flow (hidden when already enrolled). -->
      <div class="mt-6 hidden space-y-4" data-section="mfa-enroll">
        <p class="text-sm text-slate-700">
          Click <strong>Set up</strong> to generate a fresh secret. Scan the QR
          (or paste the manual-entry secret into your authenticator app), then
          enter the 6-digit code to confirm.
        </p>
        <button type="button" data-button="mfa-start" class="btn-primary text-sm">
          Set up two-factor authentication
        </button>

        <!-- Hidden until /enroll fires. -->
        <div class="hidden space-y-4 rounded-lg border border-slate-200 bg-slate-50 p-4" data-section="mfa-enroll-step">
          <p class="text-sm text-slate-700">
            Open your authenticator app (1Password, Authy, Google Authenticator, etc.)
            and either scan the QR or paste the manual secret.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
            <div
              class="flex h-44 w-44 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-white p-2"
              data-field="mfa-qr"
            >
              <span class="text-xs text-slate-400">QR will render here</span>
            </div>
            <div class="min-w-0 flex-1">
              <label class="block text-xs font-medium uppercase tracking-wide text-slate-500"
                >Manual secret</label>
              <code
                data-field="mfa-secret-base32"
                class="mt-1 block break-all rounded bg-white px-2 py-1 font-mono text-xs text-slate-900 ring-1 ring-slate-200"
              >—</code>
              <p class="mt-2 text-xs text-slate-500">
                SHA-1 / 30s / 6-digit (RFC 6238 defaults; every authenticator app
                supports).
              </p>
            </div>
          </div>
          <div class="border-t border-slate-200 pt-3">
            <label class="block text-sm font-medium text-slate-700" for="mfa-verify-code">
              Enter the 6-digit code from your app to confirm
            </label>
            <div class="mt-2 flex items-center gap-2">
              <input
                id="mfa-verify-code"
                data-field="mfa-verify-code"
                type="text"
                inputmode="numeric"
                pattern="\d{6}"
                maxlength="6"
                placeholder="123456"
                class="w-32 rounded-md border border-slate-300 px-3 py-2 font-mono text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
              />
              <button type="button" data-button="mfa-verify" class="btn-primary text-sm">
                Confirm + finish
              </button>
            </div>
            <p
              data-field="mfa-error"
              class="mt-2 hidden rounded border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-700"
            ></p>
          </div>
        </div>

        <!-- Hidden until /verify returns 10 recovery codes. -->
        <div class="hidden rounded-lg border border-amber-200 bg-amber-50 p-4" data-section="mfa-recovery">
          <p class="text-sm font-medium text-amber-900">
            Save your recovery codes — these are shown ONCE
          </p>
          <p class="mt-1 text-xs text-amber-900">
            Each code works once. Store them somewhere safe (password manager,
            printed copy, secure note). Without your authenticator AND these
            codes, account access requires support intervention.
          </p>
          <ul
            class="mt-3 grid grid-cols-2 gap-2 font-mono text-sm text-amber-900"
            data-list="mfa-recovery-codes"
          ></ul>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              data-button="mfa-recovery-copy"
              class="btn-secondary text-xs"
            >
              Copy all
            </button>
            <button
              type="button"
              data-button="mfa-recovery-download"
              class="btn-secondary text-xs"
            >
              Download .txt
            </button>
            <button
              type="button"
              data-button="mfa-recovery-acknowledge"
              class="btn-primary text-xs"
            >
              I've saved them
            </button>
          </div>
        </div>
      </div>

      <!-- Enrolled-state controls (hidden when not enrolled). -->
      <div class="mt-6 hidden space-y-4" data-section="mfa-enrolled">
        <dl class="grid grid-cols-2 gap-3 text-sm">
          <dt class="text-slate-500">Enrolled</dt>
          <dd class="font-mono text-xs text-slate-700" data-field="mfa-enrolled-at">—</dd>
          <dt class="text-slate-500">Last used</dt>
          <dd class="font-mono text-xs text-slate-700" data-field="mfa-last-used">—</dd>
          <dt class="text-slate-500">Recovery codes</dt>
          <dd class="text-xs text-slate-700">
            <span data-field="mfa-recovery-remaining">—</span> unused of 10
          </dd>
        </dl>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-button="mfa-regenerate" class="btn-secondary text-sm">
            Regenerate recovery codes
          </button>
          <button type="button" data-button="mfa-disable" class="btn-secondary text-sm text-red-700">
            Disable two-factor
          </button>
        </div>
        <p class="text-xs text-slate-500">
          Disabling clears your TOTP secret + invalidates all recovery codes.
          Requires a fresh authenticator code (step-up reauth) to confirm.
        </p>
      </div>

      <!-- Step-up reauth modal-ish prompt. -->
      <div class="mt-6 hidden rounded-lg border border-oxblood-200 bg-oxblood-50 p-4" data-section="mfa-step-up">
        <p class="text-sm font-medium text-oxblood-900">
          Confirm with your authenticator
        </p>
        <p class="mt-1 text-xs text-oxblood-900">
          Enter a fresh 6-digit code (or a recovery code) to continue.
        </p>
        <div class="mt-3 flex items-center gap-2">
          <input
            data-field="mfa-step-up-code"
            type="text"
            inputmode="numeric"
            maxlength="11"
            placeholder="123456 or recovery"
            class="w-44 rounded-md border border-oxblood-300 px-3 py-2 font-mono text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <button type="button" data-button="mfa-step-up-submit" class="btn-primary text-sm">
            Confirm
          </button>
          <button type="button" data-button="mfa-step-up-cancel" class="btn-secondary text-sm">
            Cancel
          </button>
        </div>
        <p
          data-field="mfa-step-up-error"
          class="mt-2 hidden rounded border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-700"
        ></p>
      </div>
    </section>

    <!-- Sessions / devices (V-355) -->
    <section class="dashboard-card mt-6" data-region="web-sessions">
      <h2 class="text-lg font-semibold text-slate-900">Active sign-ins</h2>
      <p class="mt-2 text-sm text-slate-500">
        Browser sessions where you're signed in to the dashboard. Distinct
        from your driver sessions on /sessions.
      </p>
      <ul class="mt-6 divide-y divide-slate-100" data-list="web-sessions">
        <li class="py-3 text-sm text-slate-500" data-field="web-sessions-empty">
          Sign in to load your active sessions.
        </li>
      </ul>
      <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
        <p
          data-field="web-sessions-status"
          class="text-xs text-slate-500"
        ></p>
        <button
          type="button"
          data-button="web-sessions-revoke-all"
          class="btn-secondary text-sm text-red-700"
          hidden
        >
          Sign out everywhere else
        </button>
      </div>
      <p class="mt-3 text-xs text-slate-400">
        IP omitted for privacy. The "current" session is the one you're using
        right now and can't be revoked from this list — sign out from the menu
        instead.
      </p>
    </section>

    <!-- Profile basics (V-352 — name + timezone) -->
    <section class="dashboard-card mt-6" data-region="profile">
      <h2 class="text-lg font-semibold text-slate-900">Profile</h2>
      <p class="mt-2 text-sm text-slate-500">
        Display name + timezone. Used by the dashboard + outbound emails to
        render timestamps in your local time.
      </p>
      <form data-form="profile" class="mt-6 space-y-4">
        <!-- V-352b — avatar upload -->
        <div class="flex items-center gap-4">
          <div
            data-field="avatar-preview"
            class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border border-slate-200 bg-slate-100 text-xs text-slate-400"
          >
            no avatar
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <label
                class="btn-secondary inline-flex cursor-pointer text-sm"
                for="profile-avatar-input"
              >
                Upload image
              </label>
              <input
                id="profile-avatar-input"
                data-field="avatar-input"
                type="file"
                accept="image/png,image/jpeg,image/webp"
                class="hidden"
              />
              <button
                type="button"
                data-button="avatar-remove"
                class="btn-secondary text-sm text-red-700"
                hidden
              >
                Remove
              </button>
            </div>
            <p class="text-xs text-slate-500">
              PNG, JPEG, or WebP. Max 2 MB. Stored on Cloudflare R2 (EU).
            </p>
            <p
              data-field="avatar-error"
              class="hidden rounded border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-700"
            ></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="profile-name">
            Display name
          </label>
          <input
            id="profile-name"
            data-field="profile-name"
            type="text"
            placeholder="Optional — leave blank to use your email"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="profile-timezone">
            Timezone (IANA)
          </label>
          <input
            id="profile-timezone"
            data-field="profile-timezone"
            type="text"
            placeholder="Europe/Amsterdam"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <p class="mt-1 text-xs text-slate-500">
            IANA name like <code class="font-mono">Europe/Amsterdam</code> or
            <code class="font-mono">America/Los_Angeles</code>. Leave blank for UTC.
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="profile-slug">
            Account handle (slug)
          </label>
          <input
            id="profile-slug"
            data-field="profile-slug"
            type="text"
            inputmode="text"
            autocomplete="off"
            placeholder="acme-corp"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <p class="mt-1 text-xs text-slate-500">
            Lowercase a-z, 0-9, and hyphen. 3-32 chars. Used as a stable
            handle on support tickets, billing references, and audit
            entries. Leave blank to keep using the account UUID.
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="profile-region">
            Data-residency region (preference)
          </label>
          <select
            id="profile-region"
            data-field="profile-region"
            class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          >
            <option value="">— no preference —</option>
            <option value="us">us — Americas</option>
            <option value="eu">eu — Europe</option>
            <option value="apac">apac — Asia-Pacific</option>
          </select>
          <p class="mt-1 text-xs text-slate-500">
            Customer-stated preference. Currently informational; physical
            region routing of compute and storage is governed by the
            sub-processor list (see <a href="/trust/sub-processors" class="text-oxblood-700 underline">/trust/sub-processors</a>).
          </p>
        </div>
        <p
          data-field="profile-error"
          class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        ></p>
        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
          <span data-field="profile-status" class="text-xs text-slate-500"></span>
          <button
            type="submit"
            data-button="profile-save"
            class="btn-primary"
          >
            Save
          </button>
        </div>
      </form>
    </section>

    <!-- Email notifications (V-204 — live-wired) -->
    <section class="dashboard-card mt-6" data-region="email-prefs">
      <h2 class="text-lg font-semibold text-slate-900">Email notifications</h2>
      <p class="mt-2 text-sm text-slate-500">
        Security + financial emails (signup verification, password reset,
        billing failure, subscription cancellation, support replies) always
        go out. Below are the optional lifecycle emails — toggle off any
        you don't want.
      </p>
      <div class="mt-6 space-y-3" data-list="email-prefs">
        {
          EMAIL_EVENTS.map((event) => (
            <label class="flex items-start gap-3">
              <input
                type="checkbox"
                data-event-type={event.type}
                checked
                class="mt-0.5"
                disabled
              />
              <span class="text-sm text-slate-700">
                <strong class="block font-medium text-slate-900">{event.label}</strong>
                {event.description}
              </span>
            </label>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-slate-400" data-field="email-prefs-status">
        Sign in to load live preferences.
      </p>
    </section>

    <!-- Audit log (V-216 — live-wired) -->
    <section class="dashboard-card mt-6" data-region="audit-log">
      <h2 class="text-lg font-semibold text-slate-900">Recent activity</h2>
      <p class="mt-2 text-sm text-slate-500">
        API key mints + revokes, session lifecycle events, and other account
        changes. Newest first; filtered to your own account.
      </p>
      <ul class="mt-6 divide-y divide-slate-100" data-list="audit-log">
        <li class="py-3 text-sm text-slate-500" data-field="audit-empty">
          Sign in to load recent activity.
        </li>
      </ul>
    </section>

    <!-- Danger zone -->
    <section class="mt-10 rounded-lg border border-red-200 bg-red-50 p-6">
      <h2 class="text-lg font-semibold text-red-900">Danger zone</h2>
      <p class="mt-2 text-sm text-red-800">
        Account deletion is irreversible. All sessions, profiles, API keys,
        and webhook endpoints are immediately revoked. Recordings are hard-
        deleted from R2 within 14 days. Invoice history retained per EU tax
        law (10 years) — not deletable on request.
      </p>
      <p class="mt-3 text-xs text-red-800">
        Pre-launch: deletion is processed by emailing
        <a
          href="mailto:support@driftstack.dev?subject=Account%20deletion%20request"
          class="underline">support@driftstack.dev</a
        >. Self-service deletion endpoint lands post-launch.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="settings"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      // V-352c / V-298a — wire the profile (name + timezone + slug) form.
      const profileForm = root.querySelector('[data-form="profile"]');
      const profileNameInput = root.querySelector('[data-field="profile-name"]');
      const profileTzInput = root.querySelector('[data-field="profile-timezone"]');
      const profileSlugInput = root.querySelector('[data-field="profile-slug"]');
      const profileRegionInput = root.querySelector('[data-field="profile-region"]');
      const profileError = root.querySelector('[data-field="profile-error"]');
      const profileStatus = root.querySelector('[data-field="profile-status"]');
      const profileSaveBtn = root.querySelector('[data-button="profile-save"]');

      function showProfileError(msg) {
        if (!profileError) return;
        profileError.textContent = msg;
        profileError.classList.remove('hidden');
      }

      // V-352b — avatar elements + helpers.
      const avatarPreview = root.querySelector('[data-field="avatar-preview"]');
      const avatarInput = root.querySelector('[data-field="avatar-input"]');
      const avatarRemoveBtn = root.querySelector('[data-button="avatar-remove"]');
      const avatarError = root.querySelector('[data-field="avatar-error"]');

      function showAvatarError(msg) {
        if (!avatarError) return;
        avatarError.textContent = msg;
        avatarError.classList.remove('hidden');
      }
      function clearAvatarError() {
        if (!avatarError) return;
        avatarError.textContent = '';
        avatarError.classList.add('hidden');
      }

      function setAvatarPreview(url) {
        if (!avatarPreview) return;
        if (url) {
          avatarPreview.innerHTML =
            '<img src="' +
            escapeHtml(url) +
            '" alt="avatar" class="h-full w-full object-cover" />';
          if (avatarRemoveBtn) avatarRemoveBtn.hidden = false;
        } else {
          avatarPreview.innerHTML = 'no avatar';
          if (avatarRemoveBtn) avatarRemoveBtn.hidden = true;
        }
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = reader.result;
            if (typeof result !== 'string') {
              reject(new Error('Failed to read file.'));
              return;
            }
            // Strip the data:<mime>;base64, prefix.
            const idx = result.indexOf(',');
            resolve(idx >= 0 ? result.slice(idx + 1) : result);
          };
          reader.onerror = () => reject(new Error('Failed to read file.'));
          reader.readAsDataURL(file);
        });
      }

      // Load current profile values (GET /v1/account/me).
      if (token && profileNameInput && profileTzInput) {
        fetch(apiBaseUrl + '/v1/account/me', {
          headers: { authorization: 'Bearer ' + token },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((me) => {
            if (!me) return;
            if (me.name) profileNameInput.value = me.name;
            if (me.timezone) profileTzInput.value = me.timezone;
            if (profileSlugInput && me.slug) profileSlugInput.value = me.slug;
            if (profileRegionInput && me.region) profileRegionInput.value = me.region;
            // V-352b — initial avatar preview.
            setAvatarPreview(me.avatar_url || null);
          })
          .catch(() => {
            /* leave inputs blank */
          });
      }

      // V-352b — avatar upload handler.
      if (avatarInput) {
        avatarInput.addEventListener('change', (ev) => {
          clearAvatarError();
          const target = ev.target;
          if (!(target instanceof HTMLInputElement)) return;
          const file = target.files && target.files[0];
          if (!file) return;
          if (!token) {
            showAvatarError('Sign in to upload an avatar.');
            target.value = '';
            return;
          }
          if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
            showAvatarError('Only PNG, JPEG, or WebP allowed.');
            target.value = '';
            return;
          }
          if (file.size > 2 * 1024 * 1024) {
            showAvatarError('Image is over 2 MB.');
            target.value = '';
            return;
          }
          fileToBase64(file)
            .then((b64) =>
              fetch(apiBaseUrl + '/v1/account/me/avatar', {
                method: 'POST',
                headers: {
                  'content-type': 'application/json',
                  authorization: 'Bearer ' + token,
                },
                body: JSON.stringify({
                  content_type: file.type,
                  data_base64: b64,
                }),
              }),
            )
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              setAvatarPreview(body.avatar_url || null);
            })
            .catch((err) => {
              showAvatarError(err && err.message ? err.message : 'Upload failed.');
            })
            .finally(() => {
              target.value = '';
            });
        });
      }

      // V-352b — avatar remove handler.
      if (avatarRemoveBtn) {
        avatarRemoveBtn.addEventListener('click', () => {
          clearAvatarError();
          if (!token) {
            showAvatarError('Sign in to remove your avatar.');
            return;
          }
          fetch(apiBaseUrl + '/v1/account/me/avatar', {
            method: 'DELETE',
            headers: { authorization: 'Bearer ' + token },
          })
            .then((r) => {
              if (r.status === 204 || r.ok) return null;
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
            })
            .then(() => {
              setAvatarPreview(null);
            })
            .catch((err) => {
              showAvatarError(err && err.message ? err.message : 'Remove failed.');
            });
        });
      }

      if (profileForm) {
        profileForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (profileError) {
            profileError.classList.add('hidden');
            profileError.textContent = '';
          }
          if (!token) {
            showProfileError('Sign in to update your profile.');
            return;
          }
          const name = profileNameInput.value.trim();
          const tz = profileTzInput.value.trim();
          const slug = profileSlugInput ? profileSlugInput.value.trim() : '';
          if (profileSaveBtn) {
            profileSaveBtn.disabled = true;
            profileSaveBtn.textContent = 'Saving…';
          }
          const body = {
            name: name.length > 0 ? name : null,
            timezone: tz.length > 0 ? tz : null,
          };
          // V-298a — only include slug when the input exists; the backend
          // refines reject of "no fields" still allows name/timezone-only.
          if (profileSlugInput) {
            body.slug = slug.length > 0 ? slug : null;
          }
          // V-298b — region from select; '' = no preference (null).
          if (profileRegionInput) {
            const region = profileRegionInput.value || '';
            body.region = region.length > 0 ? region : null;
          }
          fetch(apiBaseUrl + '/v1/account/me', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify(body),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              if (profileStatus) {
                profileStatus.textContent = 'Saved.';
                window.setTimeout(() => {
                  if (profileStatus) profileStatus.textContent = '';
                }, 3000);
              }
            })
            .catch((err) => {
              showProfileError(err && err.message ? err.message : 'Failed to save.');
            })
            .finally(() => {
              if (profileSaveBtn) {
                profileSaveBtn.disabled = false;
                profileSaveBtn.textContent = 'Save';
              }
            });
        });
      }

      function authedFetch(path, init = {}) {
        return fetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // V-204 — email preferences live wire.
      const emailPrefsList = root.querySelector('[data-list="email-prefs"]');
      const emailPrefsStatus = root.querySelector('[data-field="email-prefs-status"]');

      function setEmailPrefsState(prefs) {
        if (!emailPrefsList) return;
        const inputs = emailPrefsList.querySelectorAll('input[type="checkbox"][data-event-type]');
        inputs.forEach((input) => {
          input.disabled = false;
          const eventType = input.getAttribute('data-event-type');
          const pref = prefs.find((p) => p.event_type === eventType);
          input.checked = pref ? pref.opted_in : true;
        });
        if (emailPrefsStatus) {
          emailPrefsStatus.textContent =
            'Toggle off any lifecycle email you do not want. Changes save automatically.';
        }
      }

      function loadEmailPrefs() {
        if (!token || !emailPrefsList) return;
        authedFetch('/v1/account/email-preferences', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => setEmailPrefsState(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load email preferences (" + msg + ').');
          });
      }

      function saveEmailPref(eventType, optedIn) {
        if (!token) return;
        authedFetch('/v1/account/email-preferences', {
          method: 'PUT',
          body: JSON.stringify({ event_type: eventType, opted_in: optedIn }),
        })
          .then((r) => {
            if (r.status === 204 || r.ok) return null;
            return Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(() => {
            showBanner('Email preference saved.');
            setTimeout(hideBanner, 2000);
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't save email preference (" + msg + ').');
          });
      }

      if (emailPrefsList) {
        emailPrefsList.addEventListener('change', (ev) => {
          const target = ev.target;
          if (
            !(target instanceof HTMLInputElement) ||
            target.type !== 'checkbox' ||
            !target.getAttribute('data-event-type')
          )
            return;
          const eventType = target.getAttribute('data-event-type');
          if (eventType) saveEmailPref(eventType, target.checked);
        });
      }

      // V-216 — audit log live wire.
      const auditList = root.querySelector('[data-list="audit-log"]');

      function fmtAction(action) {
        return action.replace(/[._]/g, ' ');
      }

      function renderAudit(entries) {
        if (!auditList) return;
        if (entries.length === 0) {
          auditList.innerHTML =
            '<li class="py-3 text-sm text-slate-500">No recent activity yet — your first key mint, session create, or other account event will appear here.</li>';
          return;
        }
        auditList.innerHTML = entries
          .map((entry) => {
            const targetFrag = entry.target_resource_id
              ? '<p class="mt-1 font-mono text-[11px] text-slate-500">' +
                escapeHtml(entry.target_resource_id) +
                '</p>'
              : '';
            return (
              '<li class="flex items-start justify-between gap-4 py-3">' +
              '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-slate-500">' +
              escapeHtml(fmtIso(entry.timestamp)) +
              '</p>' +
              '<p class="mt-1 text-sm text-slate-900">' +
              '<code class="font-mono text-xs text-oxblood-700">' +
              escapeHtml(entry.action) +
              '</code>' +
              '</p>' +
              targetFrag +
              '</div>' +
              '<span class="text-xs text-slate-400">' +
              escapeHtml(fmtAction(entry.actor_type)) +
              '</span></li>'
            );
          })
          .join('');
      }

      function loadAudit() {
        if (!token || !auditList) return;
        authedFetch('/v1/account/audit-log?limit=20', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => renderAudit(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load audit log (" + msg + ').');
          });
      }

      // V-355 — active sign-ins live wire.
      const webSessionsList = root.querySelector('[data-list="web-sessions"]');
      const webSessionsEmpty = root.querySelector('[data-field="web-sessions-empty"]');
      const webSessionsStatus = root.querySelector('[data-field="web-sessions-status"]');
      const webSessionsRevokeAllBtn = root.querySelector(
        '[data-button="web-sessions-revoke-all"]',
      );

      function fmtRelative(iso) {
        if (!iso) return '—';
        const t = new Date(iso).getTime();
        const ms = Date.now() - t;
        if (ms < 60_000) return 'just now';
        const min = Math.floor(ms / 60_000);
        if (min < 60) return min + 'm ago';
        const hr = Math.floor(min / 60);
        if (hr < 24) return hr + 'h ago';
        const d = Math.floor(hr / 24);
        return d + 'd ago';
      }

      function renderWebSessions(sessions) {
        if (!webSessionsList) return;
        if (sessions.length === 0) {
          webSessionsList.innerHTML =
            '<li class="py-3 text-sm text-slate-500">No active sign-ins.</li>';
          if (webSessionsRevokeAllBtn) webSessionsRevokeAllBtn.hidden = true;
          if (webSessionsStatus) webSessionsStatus.textContent = '';
          return;
        }
        webSessionsList.innerHTML = sessions
          .map((s) => {
            const label =
              escapeHtml(s.os) + ' · ' + escapeHtml(s.browser) + (s.current ? ' · current' : '');
            const meta =
              'Last used ' +
              escapeHtml(fmtRelative(s.last_used_at)) +
              ' · expires ' +
              escapeHtml(fmtIso(s.expires_at));
            const action = s.current
              ? '<span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">current</span>'
              : '<button type="button" class="btn-secondary text-sm text-red-700" data-revoke-id="' +
                escapeHtml(s.id) +
                '">Revoke</button>';
            return (
              '<li class="flex items-start justify-between gap-6 py-3">' +
              '<div><p class="text-sm font-medium text-slate-900">' +
              label +
              '</p><p class="mt-1 text-xs text-slate-500">' +
              meta +
              '</p></div>' +
              action +
              '</li>'
            );
          })
          .join('');
        const others = sessions.filter((s) => !s.current).length;
        if (webSessionsRevokeAllBtn) webSessionsRevokeAllBtn.hidden = others === 0;
        if (webSessionsStatus)
          webSessionsStatus.textContent =
            sessions.length + (sessions.length === 1 ? ' active session' : ' active sessions');
      }

      function loadWebSessions() {
        if (!token || !webSessionsList) return;
        if (webSessionsEmpty) webSessionsEmpty.classList.add('hidden');
        authedFetch('/v1/account/web-sessions', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => renderWebSessions(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load active sign-ins (" + msg + ').');
          });
      }

      function revokeWebSession(id) {
        authedFetch('/v1/account/web-sessions/' + encodeURIComponent(id), {
          method: 'DELETE',
        })
          .then((r) => {
            if (r.status === 204 || r.ok) return null;
            return Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(() => {
            showBanner('Session revoked.');
            setTimeout(hideBanner, 2000);
            loadWebSessions();
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't revoke session (" + msg + ').');
          });
      }

      if (webSessionsList) {
        webSessionsList.addEventListener('click', (ev) => {
          const target = ev.target;
          if (!target || !target.closest) return;
          const btn = target.closest('[data-revoke-id]');
          if (!btn) return;
          const id = btn.getAttribute('data-revoke-id');
          if (!id) return;
          if (!window.confirm('Revoke this sign-in? It will need to sign in again.')) return;
          revokeWebSession(id);
        });
      }

      if (webSessionsRevokeAllBtn) {
        webSessionsRevokeAllBtn.addEventListener('click', () => {
          if (
            !window.confirm(
              'Sign out of every other browser? You will stay signed in here.',
            )
          )
            return;
          authedFetch('/v1/account/web-sessions?keep=current', { method: 'DELETE' })
            .then((r) =>
              r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)),
            )
            .then((body) => {
              showBanner('Signed out of ' + (body.revoked || 0) + ' other sessions.');
              setTimeout(hideBanner, 3000);
              loadWebSessions();
            })
            .catch((err) => {
              const msg = err && err.message ? err.message : 'network error';
              showBanner("Couldn't bulk-revoke (" + msg + ').');
            });
        });
      }

      // V-079 — change password trigger via password-reset request.
      function changePassword() {
        if (!token) {
          showBanner('Sign in to change password.');
          return;
        }
        // Email comes from the JWT-mirrored web session; the customer-
        // dashboard fetches /v1/account when that endpoint exists. For
        // V-217, prompt for the email so the password-reset link goes
        // to the right address. Self-derived email comes via /v1/account
        // follow-up.
        const email = window.prompt('Enter your account email to send the password-reset link:');
        if (!email || !email.trim()) return;
        showBanner('Sending password-reset email…');
        fetch(apiBaseUrl + '/v1/auth/password-reset/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email.trim() }),
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then(() => {
            showBanner('Password-reset email sent. Check your inbox.');
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't send password-reset (" + msg + ').');
          });
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action="change-password"]');
        if (!btn) return;
        ev.preventDefault();
        changePassword();
      });

      // V-353h — MFA section live wire.
      const mfaStatusBadge = root.querySelector('[data-field="mfa-status-badge"]');
      const mfaEnrollSection = root.querySelector('[data-section="mfa-enroll"]');
      const mfaEnrollStep = root.querySelector('[data-section="mfa-enroll-step"]');
      const mfaRecoverySection = root.querySelector('[data-section="mfa-recovery"]');
      const mfaEnrolledSection = root.querySelector('[data-section="mfa-enrolled"]');
      const mfaStepUpSection = root.querySelector('[data-section="mfa-step-up"]');
      const mfaQrTarget = root.querySelector('[data-field="mfa-qr"]');
      const mfaSecretEl = root.querySelector('[data-field="mfa-secret-base32"]');
      const mfaVerifyInput = root.querySelector('[data-field="mfa-verify-code"]');
      const mfaError = root.querySelector('[data-field="mfa-error"]');
      const mfaRecoveryList = root.querySelector('[data-list="mfa-recovery-codes"]');
      const mfaEnrolledAt = root.querySelector('[data-field="mfa-enrolled-at"]');
      const mfaLastUsed = root.querySelector('[data-field="mfa-last-used"]');
      const mfaRecoveryRemaining = root.querySelector('[data-field="mfa-recovery-remaining"]');
      const mfaStepUpInput = root.querySelector('[data-field="mfa-step-up-code"]');
      const mfaStepUpError = root.querySelector('[data-field="mfa-step-up-error"]');

      let pendingStepUpAction = null; // 'disable' | 'regenerate' | null

      function showHidden(el, hidden) {
        if (!el) return;
        if (hidden) el.classList.add('hidden');
        else el.classList.remove('hidden');
      }
      function showMfaError(msg) {
        if (!mfaError) return;
        mfaError.textContent = msg;
        mfaError.classList.remove('hidden');
      }
      function clearMfaError() {
        if (!mfaError) return;
        mfaError.textContent = '';
        mfaError.classList.add('hidden');
      }
      function showStepUpError(msg) {
        if (!mfaStepUpError) return;
        mfaStepUpError.textContent = msg;
        mfaStepUpError.classList.remove('hidden');
      }
      function clearStepUpError() {
        if (!mfaStepUpError) return;
        mfaStepUpError.textContent = '';
        mfaStepUpError.classList.add('hidden');
      }

      function renderQrFor(otpauthUri) {
        if (!mfaQrTarget) return;
        // Use a Google Charts QR fallback for the browser-side render.
        // Chosen because it's serverless + no extra JS dep + Driftstack
        // has no need for a custom-stylized QR. The otpauth URI is
        // not sensitive once shown to the user (the customer is the
        // adversary here? — no, the BROWSER is rendering for the
        // legitimate user). Use a non-Google service if Google Charts
        // ever shuts down.
        const url =
          'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' +
          encodeURIComponent(otpauthUri);
        mfaQrTarget.innerHTML =
          '<img src="' + escapeHtml(url) + '" alt="MFA QR code" class="h-full w-full object-contain" />';
      }

      function setMfaState(status) {
        if (mfaStatusBadge) {
          if (status.enrolled) {
            mfaStatusBadge.textContent = 'enrolled';
            mfaStatusBadge.classList.remove('bg-slate-100', 'text-slate-600');
            mfaStatusBadge.classList.add('bg-emerald-50', 'text-emerald-700');
          } else {
            mfaStatusBadge.textContent = 'not enrolled';
            mfaStatusBadge.classList.add('bg-slate-100', 'text-slate-600');
            mfaStatusBadge.classList.remove('bg-emerald-50', 'text-emerald-700');
          }
        }
        showHidden(mfaEnrollSection, status.enrolled);
        showHidden(mfaEnrolledSection, !status.enrolled);
        if (status.enrolled) {
          if (mfaEnrolledAt)
            mfaEnrolledAt.textContent = status.enrolled_at
              ? fmtIso(status.enrolled_at)
              : '—';
          if (mfaLastUsed)
            mfaLastUsed.textContent = status.last_used_at
              ? fmtIso(status.last_used_at)
              : 'never';
          if (mfaRecoveryRemaining)
            mfaRecoveryRemaining.textContent = String(status.unused_recovery_codes);
        }
      }

      function loadMfa() {
        if (!token) return;
        authedFetch('/v1/account/mfa', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then(setMfaState)
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load MFA status (" + msg + ').');
          });
      }

      function startEnrollment() {
        clearMfaError();
        authedFetch('/v1/account/mfa/enroll', { method: 'POST' })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            renderQrFor(body.otpauth_uri);
            if (mfaSecretEl) mfaSecretEl.textContent = body.secret_base32;
            showHidden(mfaEnrollStep, false);
            if (mfaVerifyInput) mfaVerifyInput.value = '';
          })
          .catch((err) => showMfaError(err.message || 'Enroll failed.'));
      }

      function verifyEnrollment() {
        clearMfaError();
        const code = (mfaVerifyInput && mfaVerifyInput.value || '').trim();
        if (!/^\d{6}$/.test(code)) {
          showMfaError('Enter a 6-digit code from your authenticator.');
          return;
        }
        authedFetch('/v1/account/mfa/verify', {
          method: 'POST',
          body: JSON.stringify({ code }),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            // Render recovery codes once.
            if (mfaRecoveryList) {
              mfaRecoveryList.innerHTML = (body.recovery_codes || [])
                .map(
                  (c) =>
                    '<li class="rounded bg-white px-2 py-1 ring-1 ring-amber-200">' +
                    escapeHtml(c) +
                    '</li>',
                )
                .join('');
            }
            showHidden(mfaRecoverySection, false);
            showHidden(mfaEnrollStep, true);
          })
          .catch((err) => showMfaError(err.message || 'Verify failed.'));
      }

      function copyRecoveryCodes() {
        if (!mfaRecoveryList) return;
        const codes = Array.from(
          mfaRecoveryList.querySelectorAll('li'),
        ).map((li) => li.textContent || '');
        navigator.clipboard
          .writeText(codes.join('\n'))
          .then(() => showBanner('Recovery codes copied to clipboard.'))
          .catch(() => showBanner("Copy failed. Select + copy manually."));
      }

      function downloadRecoveryCodes() {
        if (!mfaRecoveryList) return;
        const codes = Array.from(
          mfaRecoveryList.querySelectorAll('li'),
        ).map((li) => li.textContent || '');
        const text =
          'Driftstack — MFA recovery codes\n' +
          'Generated ' +
          new Date().toISOString() +
          '\n\nEach code works once. Store somewhere safe.\n\n' +
          codes.join('\n') +
          '\n';
        const blob = new Blob([text], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'driftstack-recovery-codes.txt';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      function acknowledgeRecoveryCodes() {
        showHidden(mfaRecoverySection, true);
        if (mfaRecoveryList) mfaRecoveryList.innerHTML = '';
        loadMfa();
      }

      function openStepUp(action) {
        pendingStepUpAction = action;
        clearStepUpError();
        if (mfaStepUpInput) mfaStepUpInput.value = '';
        showHidden(mfaStepUpSection, false);
      }
      function closeStepUp() {
        pendingStepUpAction = null;
        clearStepUpError();
        showHidden(mfaStepUpSection, true);
      }

      function submitStepUp() {
        clearStepUpError();
        const raw = (mfaStepUpInput && mfaStepUpInput.value || '').trim();
        if (!raw) {
          showStepUpError('Enter a 6-digit code or recovery code.');
          return;
        }
        const isCode = /^\d{6}$/.test(raw);
        const body = isCode ? { code: raw } : { recovery_code: raw };
        authedFetch('/v1/auth/mfa/step-up', {
          method: 'POST',
          body: JSON.stringify(body),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then(() => {
            const action = pendingStepUpAction;
            closeStepUp();
            if (action === 'disable') performDisable();
            else if (action === 'regenerate') performRegenerate();
          })
          .catch((err) => showStepUpError(err.message || 'Step-up failed.'));
      }

      function performDisable() {
        authedFetch('/v1/account/mfa', {
          method: 'DELETE',
          body: JSON.stringify({ confirm: 'disable-mfa' }),
        })
          .then((r) => {
            if (r.status === 204 || r.ok) return null;
            return r
              .json()
              .catch(() => ({}))
              .then((b) => {
                if (b && b.requires_mfa_step_up) {
                  openStepUp('disable');
                  throw new Error('__step_up__');
                }
                throw new Error(b.detail || 'HTTP ' + r.status);
              });
          })
          .then(() => {
            showBanner('Two-factor authentication disabled.');
            loadMfa();
          })
          .catch((err) => {
            if (err && err.message === '__step_up__') return;
            showBanner('Disable failed: ' + (err && err.message ? err.message : 'network'));
          });
      }

      function performRegenerate() {
        authedFetch('/v1/account/mfa/recovery-codes/regenerate', { method: 'POST' })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            if (mfaRecoveryList) {
              mfaRecoveryList.innerHTML = (body.recovery_codes || [])
                .map(
                  (c) =>
                    '<li class="rounded bg-white px-2 py-1 ring-1 ring-amber-200">' +
                    escapeHtml(c) +
                    '</li>',
                )
                .join('');
            }
            showHidden(mfaRecoverySection, false);
            loadMfa();
          })
          .catch((err) =>
            showBanner('Regenerate failed: ' + (err && err.message ? err.message : 'network')),
          );
      }

      // Wire MFA buttons.
      const mfaStart = root.querySelector('[data-button="mfa-start"]');
      if (mfaStart) mfaStart.addEventListener('click', startEnrollment);
      const mfaVerifyBtn = root.querySelector('[data-button="mfa-verify"]');
      if (mfaVerifyBtn) mfaVerifyBtn.addEventListener('click', verifyEnrollment);
      const mfaDisable = root.querySelector('[data-button="mfa-disable"]');
      if (mfaDisable)
        mfaDisable.addEventListener('click', () => {
          if (
            !window.confirm(
              'Disable two-factor authentication? You will be asked for a fresh code first.',
            )
          )
            return;
          performDisable();
        });
      const mfaRegen = root.querySelector('[data-button="mfa-regenerate"]');
      if (mfaRegen)
        mfaRegen.addEventListener('click', () => {
          if (
            !window.confirm(
              'Regenerate recovery codes? Old codes are invalidated immediately.',
            )
          )
            return;
          performRegenerate();
        });
      const mfaCopy = root.querySelector('[data-button="mfa-recovery-copy"]');
      if (mfaCopy) mfaCopy.addEventListener('click', copyRecoveryCodes);
      const mfaDownload = root.querySelector('[data-button="mfa-recovery-download"]');
      if (mfaDownload) mfaDownload.addEventListener('click', downloadRecoveryCodes);
      const mfaAck = root.querySelector('[data-button="mfa-recovery-acknowledge"]');
      if (mfaAck) mfaAck.addEventListener('click', acknowledgeRecoveryCodes);
      const mfaStepUpSubmit = root.querySelector('[data-button="mfa-step-up-submit"]');
      if (mfaStepUpSubmit) mfaStepUpSubmit.addEventListener('click', submitStepUp);
      const mfaStepUpCancel = root.querySelector('[data-button="mfa-step-up-cancel"]');
      if (mfaStepUpCancel) mfaStepUpCancel.addEventListener('click', closeStepUp);

      if (!token) {
        showBanner('Sign in to see live preferences + recent activity.');
        return;
      }

      loadEmailPrefs();
      loadAudit();
      loadWebSessions();
      loadMfa();
    })();
  </script>
</DashboardLayout>
