---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-217 — progressive-enhancement live wiring against:
//   - /v1/account/email-preferences (V-204) — list + PUT per-event toggles
//   - /v1/account/me/bundled-llm-status — consent + month-to-date usage
//   - /v1/account/me/bundled-llm-settings — PATCH consent + monthly cap
//
// SSG renders mocks; inline <script> reads ds_web_session_token from
// localStorage and replaces the live sections. The security surfaces
// (change password V-079, MFA V-353h, active sign-ins V-355, connected
// accounts, recent activity V-216, and the danger zone) moved to
// /security (security.astro) with the 2026-07-03 design-system v2
// split.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

// V-204 opt-outable email events. Mirrors OptOutableEmailEventSchema.
const EMAIL_EVENTS = [
  {
    type: 'signup-welcome',
    label: 'Signup welcome',
    description: 'A welcome email sent once, after you verify your address.',
  },
  {
    type: 'session-failed-first',
    label: 'First session failure',
    description: 'One-time notice the first time a session fails on this account.',
  },
  {
    type: 'session-success-first',
    label: 'First session success',
    description:
      'A one-time email after your first successful session. You won\'t get emails for later sessions.',
  },
  {
    type: 'tier-changed',
    label: 'Subscription tier changed',
    description: 'Confirmation when your plan changes through the Stripe portal.',
  },
  {
    type: 'billing-receipt',
    label: 'Billing receipts',
    description: 'A receipt for each invoice. Stripe\'s own receipts are sent either way.',
  },
  {
    type: 'billing-renewal-reminder',
    label: 'Renewal reminder',
    description:
      'A reminder about 7 days before each renewal so you can update your payment method or change plan in time.',
  },
] as const;
---

<DashboardLayout title="Settings">
  <div class="mx-auto max-w-3xl px-6 py-10" data-page="settings">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="page-kicker" data-field="header-account">
        Account
      </p>
      <h1 class="page-title">Settings</h1>
      <p class="page-lede">
        Account profile, email notifications, and your Anthropic API key.
        Changes here affect all sessions, profiles, and webhooks under this
        account. AI billing controls are available below.
      </p>
      <p class="mt-2 text-sm text-tk-ink-3">
        Security, sign-ins &amp; danger zone moved to
        <a href="/security/" class="text-tk-accent-text underline">Privacy &amp; security</a>.
      </p>
    </header>

    {/*
      2026-06-24 — the legacy "Profile" section (Name + Email inputs seeded
      from the mock account, with a no-op "Save changes" button) was removed.
      It was dead scaffolding superseded by the live "Display & locale"
      section below (data-region="profile"), which wires display name /
      timezone / slug / region / avatar to PATCH /v1/account/me. The header
      above shows the live account identity. No mock-account literal ships.
    */}

    {/* Profile basics (V-352 — name + timezone) */}
    <section class="dashboard-card mt-6" data-region="profile">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-inset text-tk-ink-2 ring-1 ring-tk-border">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          </svg>
        </span>
        Display &amp; locale
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Avatar, display name, timezone and preferred data region. Your
        timezone is saved for your own use through the API; times shown here
        are in UTC.
      </p>
      <form data-form="profile" class="mt-6 space-y-4">
        {/* V-352b — avatar upload */}
        <div class="flex items-center gap-4">
          <div
            data-field="avatar-preview"
            class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border border-tk-border bg-tk-surface text-xs text-tk-ink-3"
          >
            no avatar
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <label
                data-field="avatar-upload-label"
                class="btn-secondary inline-flex cursor-pointer text-sm"
                for="profile-avatar-input"
              >
                Upload image
              </label>
              <input
                id="profile-avatar-input"
                data-field="avatar-input"
                type="file"
                accept="image/png,image/jpeg,image/webp"
                class="hidden"
              />
              <button
                type="button"
                data-button="avatar-remove"
                class="btn-secondary text-sm text-tk-err-text"
                hidden
              >
                Remove
              </button>
            </div>
            {/* S30 2026-07-07 (founder decision: soften) — avatars live
                on Cloudflare R2 in the default jurisdiction (EU + US
                replication), so the "(EU)" tag over-claimed. */}
            <p class="text-xs text-tk-ink-3">
              PNG, JPEG or WebP, up to 2 MB. Stored privately.
            </p>
            <p data-field="avatar-source" class="text-xs text-tk-ink-3">No avatar set.</p>
            <p
              data-field="avatar-status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              class="hidden rounded border border-tk-border bg-tk-raised px-2 py-1 text-xs text-tk-ink-2"
            ></p>
            <p
              data-field="avatar-error"
              role="alert"
              aria-live="assertive"
              aria-atomic="true"
              class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-2 py-1 text-xs text-tk-err-text"
            ></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-name">
            Display name
          </label>
          <input
            id="profile-name"
            data-field="profile-name"
            type="text"
            disabled
            title="Sign in and wait for your current profile to load"
            placeholder="Optional — leave blank to use your email"
            class="form-input mt-1"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-timezone">
            Timezone
          </label>
          <input
            id="profile-timezone"
            data-field="profile-timezone"
            type="text"
            disabled
            title="Sign in and wait for your current profile to load"
            placeholder="Europe/Amsterdam"
            class="form-input mt-1"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            For example <code class="font-mono">Europe/Amsterdam</code> or
            <code class="font-mono">America/Los_Angeles</code>. Leave blank for UTC.
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-slug">
            Account handle
          </label>
          <input
            id="profile-slug"
            data-field="profile-slug"
            type="text"
            disabled
            title="Sign in and wait for your current profile to load"
            inputmode="text"
            autocomplete="off"
            placeholder="acme-corp"
            class="form-input mt-1 font-mono"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            3–32 characters: lowercase letters, numbers and hyphens. A short
            unique name for your account that you can use instead of the
            account ID. Leave blank to keep using the ID.
          </p>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="profile-region">
            Preferred data region
          </label>
          <select
            id="profile-region"
            data-field="profile-region"
            disabled
            title="Sign in and wait for your current profile to load"
            class="form-input mt-1"
          >
            <option value="">— no preference —</option>
            <option value="us">us — Americas</option>
            <option value="eu">eu — Europe</option>
            <option value="apac">apac — Asia-Pacific</option>
          </select>
          <p class="mt-1 text-xs text-tk-ink-3">
            This is a preference only and doesn't change where your data is
            stored today. See <a href="https://driftstack.io/trust/sub-processors/" class="text-tk-accent-text underline">driftstack.io/trust/sub-processors</a> for where data is processed.
          </p>
        </div>
        <p
          data-field="profile-error"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
          class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-3 py-2 text-sm text-tk-err-text"
        ></p>
        <div class="flex items-center justify-between border-t border-tk-border pt-4">
          <span
            data-field="profile-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="text-xs text-tk-ink-3"
          ></span>
          <button
            type="submit"
            data-button="profile-save"
            class="btn-primary"
            disabled
            title="Sign in and wait for your current profile to load"
          >
            Save
          </button>
        </div>
      </form>
    </section>

    <!-- Bundled AI billing — live consent, cap, and month-to-date usage. -->
    <section class="dashboard-card mt-6" data-region="bundled-llm">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-inset text-tk-ink-2 ring-1 ring-tk-border">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
        </span>
        Bundled AI billing
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Builder and Scale use a flat <strong class="font-medium text-tk-ink-2">$0.10 per agent turn</strong>;
        Enterprise uses your contracted custom rate. If you've saved your own Anthropic
        API key, it's used first, billed by Anthropic, and doesn't count toward this limit.
      </p>

      <div data-bundled-state="loading" class="mt-6 text-sm text-tk-ink-3">
        Loading AI billing settings…
      </div>

      <div data-bundled-state="error" class="mt-6 hidden rounded-md border border-tk-err/30 bg-tk-err/10 px-3 py-3">
        <p class="text-sm text-tk-err-text" data-bundled-load-error>
          We couldn't load your AI billing settings. No setting was changed.
        </p>
        <button type="button" data-bundled-retry class="mt-2 text-sm font-medium text-tk-accent-text hover:underline">
          Try again
        </button>
      </div>

      <div data-bundled-state="ready" class="mt-6 hidden">
        <dl class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-md border border-tk-border bg-tk-bg px-3 py-3">
            <dt class="text-xs text-tk-ink-3">Used this month</dt>
            <dd class="mt-1 text-lg font-semibold text-tk-ink" data-field="bundled-used">—</dd>
          </div>
          <div class="rounded-md border border-tk-border bg-tk-bg px-3 py-3">
            <dt class="text-xs text-tk-ink-3">Remaining</dt>
            <dd class="mt-1 text-lg font-semibold text-tk-ink" data-field="bundled-remaining">—</dd>
          </div>
          <div class="rounded-md border border-tk-border bg-tk-bg px-3 py-3">
            <dt class="text-xs text-tk-ink-3">Monthly reset</dt>
            <dd class="mt-1 text-sm font-medium text-tk-ink" data-field="bundled-reset">—</dd>
          </div>
        </dl>
      </div>

      <p
        data-bundled-other-workspace
        class="mt-6 hidden rounded-md border border-tk-border bg-tk-bg px-3 py-2 text-sm text-tk-ink-2"
      >
        AI settings belong to each account, and the numbers above are your own. Switch to your own
        workspace to change them.
      </p>

      <form data-bundled-form class="mt-6 space-y-5">
        <label class="flex items-start gap-3">
          <input
            type="checkbox"
            data-field="bundled-consent"
            class="mt-0.5"
            disabled
            title="Sign in and wait for AI billing settings to load"
          />
          <span class="text-sm text-tk-ink-2">
            <strong class="block font-medium text-tk-ink">Enable bundled AI</strong>
            Let the AI agent use Driftstack's built-in AI when you haven't saved your own Anthropic key.
          </span>
        </label>

        <div>
          <label for="bundled-cap-usd" class="block text-sm font-medium text-tk-ink-2">
            Monthly bundled AI limit (USD)
          </label>
          <div class="mt-1 flex max-w-xs items-center rounded border border-tk-border bg-tk-inset focus-within:border-tk-accent focus-within:ring-1 focus-within:ring-tk-accent/40">
            <span class="pl-3 text-sm text-tk-ink-3" aria-hidden="true">$</span>
            <input
              id="bundled-cap-usd"
              data-field="bundled-cap-usd"
              type="number"
              inputmode="decimal"
              min="0"
              max="100"
              step="0.01"
              disabled
              title="Sign in and wait for AI billing settings to load"
              class="w-full border-0 bg-transparent px-2 py-2 text-sm text-tk-ink focus:outline-none focus:ring-0"
            />
          </div>
          <p class="mt-1 text-xs text-tk-ink-3">
            Up to $100. A $0 limit stops all bundled AI use, even when it's enabled.
          </p>
          <p data-bundled-cap-kept class="mt-1 hidden text-xs text-tk-ink-3">
            Your current limit was set before new limits were capped at $100. You can keep it or
            lower it, but not raise it.
          </p>
        </div>

        <p
          data-bundled-error
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
          class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-3 py-2 text-sm text-tk-err-text"
        ></p>
        <div class="flex items-center justify-between border-t border-tk-border pt-4">
          <span
            data-bundled-status
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="text-xs text-tk-ink-3"
          >Sign in to load AI billing settings.</span>
          <button
            type="submit"
            data-bundled-save
            class="btn-primary"
            disabled
            title="Sign in and wait for AI billing settings to load"
          >Save AI settings</button>
        </div>
      </form>
    </section>

    {/*
      2026-05-22 — V-666 BYOK Anthropic key UI. Customer can store
      their own Anthropic API key so the AI agent runs on their
      budget (instead of Driftstack's bundled fallback). The
      ciphertext is AES-256-GCM encrypted with MFA_ENCRYPTION_KEY
      server-side; plaintext leaves the browser exactly once on PUT.
      Three actions surface here: Save (PUT), Test (POST /test), Clear
      (DELETE). The GET /byok-anthropic-key endpoint returns status and
      timestamps only — never the plaintext or a prefix, even to the owner.
    */}
    <section class="dashboard-card mt-6" data-region="byok-anthropic">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-inset text-tk-ink-2 ring-1 ring-tk-border">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="12" r="7" />
            <path d="M16 12h6M19 9v6" />
          </svg>
        </span>
        Your own Anthropic API key
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Use your own Anthropic key so AI agent usage is billed to your Anthropic account.
        It's stored encrypted, and we never read or log the key after you save it.
        <a
          href="https://console.anthropic.com/settings/keys"
          target="_blank"
          rel="noopener noreferrer"
          class="text-tk-accent-text hover:underline"
        >Generate a key →</a>
      </p>

      <div data-byok-state="loading" class="mt-6 text-sm text-tk-ink-3">
        Checking key status…
      </div>

      <div data-byok-state="empty" class="mt-6 hidden">
        <p class="text-sm text-tk-ink-2">No key saved. AI agent sessions use Driftstack's built-in AI instead (if your plan includes it).</p>
      </div>

      <div data-byok-state="set" class="mt-6 hidden space-y-2">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-full border border-tk-ready/30 bg-tk-ready/15 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-ready-text">
            Active
          </span>
          <span class="text-sm text-tk-ink-2">
            Key set <time data-byok-set-at>—</time>; last used
            <time data-byok-last-used-at>never</time>
          </span>
        </div>
      </div>

      {/* S35 2026-07-07 (frontend audit) — dedicated load-failure
          state. A transient non-2xx on the status GET used to fall back
          to the 'empty' panel, telling a customer WITH a stored key
          "No key on file" — a false claim about their credential. */}
      <div data-byok-state="error" class="mt-6 hidden">
        <p class="text-sm text-tk-ink-2">
          Couldn't check your key status just now — this is a loading problem,
          not a missing key. Your stored key (if any) is untouched.
          <button type="button" data-byok-retry class="text-tk-accent-text hover:underline">
            Try again
          </button>
        </p>
      </div>

      <div
        data-byok-error
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="mt-6 hidden rounded-md bg-tk-accent/10 px-3 py-2 text-sm text-tk-accent-text"
      ></div>

      <form data-byok-form class="mt-6 flex flex-wrap items-center gap-3" autocomplete="off">
        <label for="byok-key" class="sr-only">Anthropic API key</label>
        <input
          id="byok-key"
          type="password"
          name="byok-key"
          disabled
          title="Sign in to save an Anthropic API key"
          placeholder="sk-ant-..."
          autocomplete="off"
          spellcheck="false"
          class="form-input w-auto min-w-[240px] flex-1 font-mono"
        />
        <button
          type="submit"
          class="btn-primary"
          disabled
          title="Sign in to save an Anthropic API key"
        >Save key</button>
        <button
          type="button"
          data-byok-test
          class="btn-secondary"
          disabled
          aria-describedby="byok-test-help"
          title="Save a key before testing"
        >Test stored key</button>
        <button
          type="button"
          data-byok-clear
          class="text-sm text-tk-err-text hover:underline"
          disabled
          title="No stored key to clear"
        >
          Clear
        </button>
      </form>

      <p id="byok-test-help" class="mt-3 text-xs text-tk-ink-3">
        After saving, Test stored key makes a small request to Anthropic to check the key
        works. Clear deletes the saved key; the AI agent then uses Driftstack's built-in
        AI (if your plan includes it).
      </p>
    </section>

    {/* Email notifications (V-204 — live-wired) */}
    <section class="dashboard-card mt-6" data-region="email-prefs">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-inset text-tk-ink-2 ring-1 ring-tk-border">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" /><polyline points="22,6 12,13 2,6" />
          </svg>
        </span>
        Email notifications
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Security and billing emails (verification, password reset, failed
        payments, support replies) are always sent. The emails below are
        optional — switch off any you don't want.
      </p>
      <p class="mt-2 text-sm text-tk-ink-3">
        When you cancel, the only email you may get is "Subscription tier
        changed" below. If you switch that off, you won't get an email when
        your subscription ends. The change still shows on your Billing page
        and in your audit log.
      </p>
      <div class="mt-6 space-y-3" data-list="email-prefs">
        {
          EMAIL_EVENTS.map((event) => (
            <label class="flex items-start gap-3">
              <input
                type="checkbox"
                data-event-type={event.type}
                checked
                class="mt-0.5"
                disabled
              />
              <span class="text-sm text-tk-ink-2">
                <strong class="block font-medium text-tk-ink">{event.label}</strong>
                {event.description}
              </span>
            </label>
          ))
        }
      </div>
      <p
        class="mt-4 text-xs text-tk-ink-3"
        data-field="email-prefs-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        Sign in to load live preferences.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="settings"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = (() => {
        try {
          return localStorage.getItem('ds_web_session_token');
        } catch {
          return null;
        }
      })();
      const SETTINGS_TIMEOUT_MS = 15_000;
      const BYOK_TEST_REASON_MAX_CHARS = 300;
      let bannerGeneration = 0;

      function boundedFetch(url, init = {}) {
        return window.driftstackFetchWithDeadline(url, init, SETTINGS_TIMEOUT_MS);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      function showBanner(text) {
        const generation = ++bannerGeneration;
        if (!banner) return generation;
        banner.textContent = text;
        banner.classList.remove('hidden');
        return generation;
      }
      function hideBanner(expectedGeneration) {
        if (expectedGeneration !== undefined && expectedGeneration !== bannerGeneration) return;
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      // V-352c / V-298a — wire the profile (name + timezone + slug) form.
      const profileForm = root.querySelector('[data-form="profile"]');
      const profileNameInput = root.querySelector('[data-field="profile-name"]');
      const profileTzInput = root.querySelector('[data-field="profile-timezone"]');
      const profileSlugInput = root.querySelector('[data-field="profile-slug"]');
      const profileRegionInput = root.querySelector('[data-field="profile-region"]');
      const profileError = root.querySelector('[data-field="profile-error"]');
      const profileStatus = root.querySelector('[data-field="profile-status"]');
      const profileSaveBtn = root.querySelector('[data-button="profile-save"]');
      let profileSaveInFlight = false;
      let profileHydrated = false;
      let profileEditedBeforeHydration = false;
      let profileStatusGeneration = 0;
      let profileUnavailableReason = token
        ? 'Wait for your current profile to load'
        : 'Sign in to edit your profile';

      function syncProfileControls() {
        const controls = [
          profileNameInput,
          profileTzInput,
          profileSlugInput,
          profileRegionInput,
        ];
        const controlsDisabled = profileSaveInFlight || !profileHydrated;
        const reason = profileSaveInFlight ? 'Wait for the current profile save to finish' : profileUnavailableReason;
        for (const control of controls) {
          if (!control) continue;
          control.disabled = controlsDisabled;
          control.title = controlsDisabled ? reason : '';
        }
        if (profileSaveBtn) {
          profileSaveBtn.disabled = controlsDisabled;
          profileSaveBtn.title = controlsDisabled ? reason : '';
          profileSaveBtn.toggleAttribute('aria-busy', profileSaveInFlight);
        }
      }

      syncProfileControls();

      function showProfileError(msg) {
        if (!profileError) return;
        profileError.textContent = msg;
        profileError.classList.remove('hidden');
      }

      function showProfileStatus(msg, clearAfterMs = 0) {
        const generation = ++profileStatusGeneration;
        if (!profileStatus) return;
        profileStatus.textContent = msg;
        if (clearAfterMs > 0) {
          window.setTimeout(() => {
            if (profileStatus && generation === profileStatusGeneration) {
              profileStatus.textContent = '';
            }
          }, clearAfterMs);
        }
      }

      for (const control of [
        profileNameInput,
        profileTzInput,
        profileSlugInput,
        profileRegionInput,
      ]) {
        if (!control) continue;
        const markProfileEdited = () => {
          if (!profileHydrated) profileEditedBeforeHydration = true;
        };
        control.addEventListener('input', markProfileEdited);
        control.addEventListener('change', markProfileEdited);
      }

      // V-352b — avatar elements + helpers.
      const avatarPreview = root.querySelector('[data-field="avatar-preview"]');
      const avatarInput = root.querySelector('[data-field="avatar-input"]');
      const avatarUploadLabel = root.querySelector('[data-field="avatar-upload-label"]');
      const avatarRemoveBtn = root.querySelector('[data-button="avatar-remove"]');
      const avatarSourceLabel = root.querySelector('[data-field="avatar-source"]');
      const avatarStatus = root.querySelector('[data-field="avatar-status"]');
      const avatarError = root.querySelector('[data-field="avatar-error"]');
      let avatarUploadInFlight = false;
      let avatarRemoveInFlight = false;
      let currentAvatarSource = 'none';
      let avatarSnapshotKnown = false;

      function setAvatarMutationBusy(kind) {
        if (avatarInput) avatarInput.disabled = true;
        if (avatarUploadLabel) {
          avatarUploadLabel.setAttribute('aria-disabled', 'true');
          avatarUploadLabel.classList.remove('cursor-pointer');
          avatarUploadLabel.classList.add('cursor-not-allowed', 'opacity-60');
          if (kind === 'upload') {
            avatarUploadLabel.setAttribute('aria-busy', 'true');
            avatarUploadLabel.textContent = 'Uploading…';
          }
        }
        if (avatarRemoveBtn) {
          avatarRemoveBtn.disabled = true;
          if (kind === 'remove') {
            avatarRemoveBtn.setAttribute('aria-busy', 'true');
            avatarRemoveBtn.textContent = 'Removing…';
          }
        }
      }

      function clearAvatarMutationBusy() {
        if (avatarInput) avatarInput.disabled = false;
        if (avatarUploadLabel) {
          avatarUploadLabel.removeAttribute('aria-disabled');
          avatarUploadLabel.removeAttribute('aria-busy');
          avatarUploadLabel.classList.add('cursor-pointer');
          avatarUploadLabel.classList.remove('cursor-not-allowed', 'opacity-60');
          avatarUploadLabel.textContent = 'Upload image';
        }
        if (avatarRemoveBtn) {
          avatarRemoveBtn.disabled = false;
          avatarRemoveBtn.removeAttribute('aria-busy');
          avatarRemoveBtn.textContent = 'Remove';
        }
      }

      function showAvatarError(msg) {
        if (!avatarError) return;
        avatarError.textContent = msg;
        avatarError.classList.remove('hidden');
      }
      function clearAvatarError() {
        if (!avatarError) return;
        avatarError.textContent = '';
        avatarError.classList.add('hidden');
      }

      function showAvatarStatus(msg) {
        if (!avatarStatus) return;
        avatarStatus.textContent = msg;
        avatarStatus.classList.remove('hidden');
      }
      function clearAvatarStatus() {
        if (!avatarStatus) return;
        avatarStatus.textContent = '';
        avatarStatus.classList.add('hidden');
      }

      function normalizedAvatarSource(me) {
        if (me && ['user', 'idp', 'none'].includes(me.avatar_source)) {
          return me.avatar_source;
        }
        // Backward-compatible during a staggered dashboard/API rollout.
        return me && me.avatar_url ? 'user' : 'none';
      }

      function setAvatarPreview(url, source = 'none') {
        currentAvatarSource = source;
        if (!avatarPreview) return;
        if (url) {
          avatarPreview.innerHTML =
            '<img src="' +
            escapeHtml(url) +
            '" alt="avatar" class="h-full w-full object-cover" />';
        } else {
          avatarPreview.innerHTML = 'no avatar';
        }
        if (avatarRemoveBtn) avatarRemoveBtn.hidden = source !== 'user';
        if (avatarSourceLabel) {
          avatarSourceLabel.textContent =
            source === 'user'
              ? 'Uploaded by you. Remove restores your linked-account image when available.'
              : source === 'idp'
                ? 'From your linked sign-in. Upload an image to replace it.'
                : 'No avatar set.';
        }
      }

      function fetchCurrentAccount() {
        return boundedFetch(apiBaseUrl + '/v1/account/me', {
          headers: { authorization: 'Bearer ' + token },
        }).then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
        );
      }

      function accountMatchesProfile(account, desired) {
        for (const field of ['name', 'timezone', 'slug', 'region']) {
          if (!Object.prototype.hasOwnProperty.call(desired, field)) continue;
          if ((account[field] ?? null) !== desired[field]) return false;
        }
        return true;
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = reader.result;
            if (typeof result !== 'string') {
              reject(new Error('Failed to read file.'));
              return;
            }
            // Strip the data:<mime>;base64, prefix.
            const idx = result.indexOf(',');
            resolve(idx >= 0 ? result.slice(idx + 1) : result);
          };
          reader.onerror = () => reject(new Error('Failed to read file.'));
          reader.readAsDataURL(file);
        });
      }

      // Load current profile values (GET /v1/account/me).
      if (token && profileNameInput && profileTzInput) {
        fetchCurrentAccount()
          .then((me) => {
            if (!me) return;
            if (!profileEditedBeforeHydration) {
              profileNameInput.value = me.name || '';
              profileTzInput.value = me.timezone || '';
              if (profileSlugInput) profileSlugInput.value = me.slug || '';
              if (profileRegionInput) profileRegionInput.value = me.region || '';
            }
            profileHydrated = true;
            profileUnavailableReason = '';
            syncProfileControls();
            // audit w2flmiw48 #3 — the header account-id used to be seeded
            // from the mock account and never overwritten by live data (so
            // every customer saw the mock id). Populate it from /account/me.
            // (The legacy mock-seeded email input was removed 2026-06-24.)
            if (me.id) {
              const headerAcct = document.querySelector('[data-field="header-account"]');
              if (headerAcct) headerAcct.textContent = 'Account · ' + me.id.slice(0, 16) + '…';
            }
            // V-352b — initial avatar preview.
            avatarSnapshotKnown = true;
            setAvatarPreview(me.avatar_url || null, normalizedAvatarSource(me));
          })
          .catch((err) => {
            profileHydrated = false;
            profileUnavailableReason = 'Reload to try loading your current profile again';
            syncProfileControls();
            showProfileError(
              requestErrorMessage(
                err,
                "Couldn't load your profile, so editing is unavailable. Reload to try again.",
              ),
            );
          });
      }

      // V-352b — avatar upload handler.
      if (avatarInput) {
        avatarInput.addEventListener('change', (ev) => {
          if (avatarUploadInFlight || avatarRemoveInFlight) return;
          clearAvatarError();
          clearAvatarStatus();
          const target = ev.target;
          if (!(target instanceof HTMLInputElement)) return;
          const file = target.files && target.files[0];
          if (!file) return;
          if (!token) {
            showAvatarError('Sign in to upload an avatar.');
            target.value = '';
            return;
          }
          if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
            showAvatarError('Only PNG, JPEG, or WebP allowed.');
            target.value = '';
            return;
          }
          if (file.size > 2 * 1024 * 1024) {
            showAvatarError('Image is over 2 MB.');
            target.value = '';
            return;
          }
          avatarUploadInFlight = true;
          const sourceBeforeUpload = currentAvatarSource;
          const snapshotKnownBeforeUpload = avatarSnapshotKnown;
          setAvatarMutationBusy('upload');
          fileToBase64(file)
            .then((b64) =>
              boundedFetch(apiBaseUrl + '/v1/account/me/avatar', {
                method: 'POST',
                headers: {
                  'content-type': 'application/json',
                  authorization: 'Bearer ' + token,
                },
                body: JSON.stringify({
                  content_type: file.type,
                  data_base64: b64,
                }),
              }),
            )
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
            )
            .then((body) => {
              avatarSnapshotKnown = true;
              setAvatarPreview(body.avatar_url || null, 'user');
              showAvatarStatus('Avatar uploaded.');
            })
            .catch((err) => {
              if (!err || err.name !== 'AbortError') {
                showAvatarError(requestErrorMessage(err, 'Upload failed.'));
                return;
              }
              return fetchCurrentAccount()
                .then((me) => {
                  const source = normalizedAvatarSource(me);
                  avatarSnapshotKnown = true;
                  setAvatarPreview(me.avatar_url || null, source);
                  if (
                    snapshotKnownBeforeUpload &&
                    source === 'user' &&
                    sourceBeforeUpload !== 'user'
                  ) {
                    showAvatarStatus(
                      'The request took too long, but your new avatar is now showing. No need to upload it again.',
                    );
                    return;
                  }
                  showAvatarError(
                    source === 'user'
                      ? 'The request took too long. We refreshed your avatar — check the image before trying again.'
                      : "The request took too long and we couldn't confirm the upload. We refreshed your avatar — try again only if the new image isn't shown.",
                  );
                })
                .catch(() => {
                  showAvatarError(
                    "The request took too long and we couldn't check the result. Reload the page and check your avatar before trying again.",
                  );
                });
            })
            .finally(() => {
              avatarUploadInFlight = false;
              clearAvatarMutationBusy();
              target.value = '';
            });
        });
      }

      // V-352b — avatar remove handler.
      if (avatarRemoveBtn) {
        avatarRemoveBtn.addEventListener('click', () => {
          if (avatarRemoveInFlight || avatarUploadInFlight) return;
          clearAvatarError();
          clearAvatarStatus();
          if (!token) {
            showAvatarError('Sign in to remove your avatar.');
            return;
          }
          avatarRemoveInFlight = true;
          setAvatarMutationBusy('remove');
          boundedFetch(apiBaseUrl + '/v1/account/me/avatar', {
            method: 'DELETE',
            headers: { authorization: 'Bearer ' + token },
          })
            .then((r) => {
              if (r.status === 204 || r.ok) return null;
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
            })
            .then(() => {
              return fetchCurrentAccount()
                .then((me) => {
                  avatarSnapshotKnown = true;
                  setAvatarPreview(me.avatar_url || null, normalizedAvatarSource(me));
                  showAvatarStatus(
                    me.avatar_source === 'idp'
                      ? 'Uploaded avatar removed. Your linked-account image is now shown.'
                      : 'Uploaded avatar removed.',
                  );
                })
                .catch(() => {
                  setAvatarPreview(null, 'none');
                  showAvatarStatus(
                    'Uploaded avatar removed. Reload to restore any linked-account image.',
                  );
                });
            })
            .catch((err) => {
              if (!err || err.name !== 'AbortError') {
                showAvatarError(requestErrorMessage(err, 'Remove failed.'));
                return;
              }
              return fetchCurrentAccount()
                .then((me) => {
                  const source = normalizedAvatarSource(me);
                  avatarSnapshotKnown = true;
                  setAvatarPreview(me.avatar_url || null, source);
                  if (source !== 'user') {
                    showAvatarStatus(
                      source === 'idp'
                        ? 'The request took too long, but your avatar was removed. Your linked-account image is now shown.'
                        : 'The request took too long, but your avatar was removed.',
                    );
                    return;
                  }
                  showAvatarError(
                    "The request took too long and your avatar is still there. It's safe to try again.",
                  );
                })
                .catch(() => {
                  showAvatarError(
                    "The request took too long and we couldn't check the result. Reload the page and check your avatar before trying again.",
                  );
                });
            })
            .finally(() => {
              avatarRemoveInFlight = false;
              clearAvatarMutationBusy();
            });
        });
      }

      if (profileForm) {
        profileForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (profileSaveInFlight) return;
          if (profileError) {
            profileError.classList.add('hidden');
            profileError.textContent = '';
          }
          if (!token) {
            showProfileError('Sign in to update your profile.');
            return;
          }
          if (!profileHydrated) {
            showProfileError(
              'Wait for your current profile to load before saving. Reload if loading failed.',
            );
            return;
          }
          const name = profileNameInput.value.trim();
          const tz = profileTzInput.value.trim();
          const slug = profileSlugInput ? profileSlugInput.value.trim() : '';
          profileSaveInFlight = true;
          syncProfileControls();
          if (profileSaveBtn) {
            profileSaveBtn.textContent = 'Saving…';
          }
          const body = {
            name: name.length > 0 ? name : null,
            timezone: tz.length > 0 ? tz : null,
          };
          // V-298a — only include slug when the input exists; the backend
          // refines reject of "no fields" still allows name/timezone-only.
          if (profileSlugInput) {
            body.slug = slug.length > 0 ? slug : null;
          }
          // V-298b — region from select; '' = no preference (null).
          if (profileRegionInput) {
            const region = profileRegionInput.value || '';
            body.region = region.length > 0 ? region : null;
          }
          boundedFetch(apiBaseUrl + '/v1/account/me', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify(body),
          })
            .then((r) => {
              if (r.ok) {
                // The profile response body is unused. Accepted status is the
                // save boundary; malformed JSON must not turn a committed
                // profile update into retry guidance.
                return;
              }
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
            })
            .then(() => {
              showProfileStatus('Saved.', 3000);
            })
            .catch((err) => {
              if (!err || err.name !== 'AbortError') {
                showProfileError(requestErrorMessage(err, 'Failed to save.'));
                return;
              }
              return fetchCurrentAccount()
                .then((account) => {
                  if (accountMatchesProfile(account, body)) {
                    showProfileStatus(
                      'Saved. The request took too long, but your profile shows your changes.',
                      6000,
                    );
                    return;
                  }
                  showProfileError(
                    "The request took too long and your profile doesn't show your changes yet. Your edits are still here — check them before trying again.",
                  );
                })
                .catch(() => {
                  showProfileError(
                    "The request took too long and we couldn't check whether it saved. Your edits are still here — copy them, then reload to check before trying again.",
                  );
                });
            })
            .finally(() => {
              profileSaveInFlight = false;
              syncProfileControls();
              if (profileSaveBtn) {
                profileSaveBtn.textContent = 'Save';
              }
            });
        });
      }

      function authedFetch(path, init = {}) {
        return boundedFetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // Bundled AI billing — authoritative status + explicit consent/cap save.
      const bundledForm = root.querySelector('[data-bundled-form]');
      const bundledConsent = root.querySelector('[data-field="bundled-consent"]');
      const bundledCapUsd = root.querySelector('[data-field="bundled-cap-usd"]');
      const bundledCapKept = root.querySelector('[data-bundled-cap-kept]');
      const bundledSave = root.querySelector('[data-bundled-save]');
      const bundledLoading = root.querySelector('[data-bundled-state="loading"]');
      const bundledReady = root.querySelector('[data-bundled-state="ready"]');
      const bundledErrorState = root.querySelector('[data-bundled-state="error"]');
      const bundledLoadError = root.querySelector('[data-bundled-load-error]');
      const bundledOtherWorkspace = root.querySelector('[data-bundled-other-workspace]');

      // The AI settings read and write the SIGNED-IN account only; the server
      // refuses a save that names another workspace. In a team workspace the
      // form therefore shows your own settings, read-only, with a note.
      function actingInOtherWorkspace() {
        try {
          const headers =
            typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {};
          return Boolean(headers && headers['x-driftstack-account']);
        } catch {
          return false;
        }
      }
      const bundledRetry = root.querySelector('[data-bundled-retry]');
      const bundledError = root.querySelector('[data-bundled-error]');
      const bundledStatus = root.querySelector('[data-bundled-status]');
      const bundledUsed = root.querySelector('[data-field="bundled-used"]');
      const bundledRemaining = root.querySelector('[data-field="bundled-remaining"]');
      const bundledReset = root.querySelector('[data-field="bundled-reset"]');
      const bundledCurrency = new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
      let bundledKnown = false;
      let bundledSaving = false;
      let bundledLoadGeneration = 0;
      // A new limit is at most $100 (BUNDLED_CAP_MAX_NEW_WRITE_CENTS on the server).
      // A limit already stored above that is kept: it may be saved unchanged or
      // lowered, never raised. So the highest value this form may send is the
      // larger of $100 and the limit last loaded from the server.
      const BUNDLED_CAP_NEW_MAX_CENTS = 10_000;
      let bundledLoadedCapCents = 0;

      function bundledCapCeilingCents() {
        return Math.max(BUNDLED_CAP_NEW_MAX_CENTS, bundledLoadedCapCents);
      }

      // The server refuses a limit it will not store as a validation problem
      // naming monthly_cap_usd_cents. Its text is written for API callers (it
      // names the field in cents), so the form says the same rule in dollars.
      function isBundledCapRefusal(response, body) {
        if (response.status !== 400 || !body || typeof body !== 'object') return false;
        if (body.type !== 'https://errors.driftstack.dev/validation-failed') return false;
        const fieldErrors =
          body.issues && typeof body.issues === 'object' ? body.issues.fieldErrors : undefined;
        const capErrors =
          fieldErrors && typeof fieldErrors === 'object'
            ? fieldErrors.monthly_cap_usd_cents
            : undefined;
        return Array.isArray(capErrors) && capErrors.length > 0;
      }

      const BUNDLED_CAP_REFUSED_MESSAGE =
        'That limit was not accepted. New limits are at most $100, and a limit already above $100 can be kept or lowered, but not raised.';

      function isBundledStatus(body) {
        return (
          body !== null &&
          typeof body === 'object' &&
          typeof body.consent === 'boolean' &&
          Number.isInteger(body.cap_cents) &&
          body.cap_cents >= 0 &&
          body.cap_cents <= 1_000_000 &&
          Number.isInteger(body.used_this_month_cents) &&
          body.used_this_month_cents >= 0 &&
          Number.isInteger(body.remaining_cents) &&
          body.remaining_cents >= 0 &&
          typeof body.month_started_at === 'string' &&
          Number.isFinite(Date.parse(body.month_started_at))
        );
      }

      function setBundledPanel(panel) {
        if (bundledLoading) bundledLoading.classList.toggle('hidden', panel !== 'loading');
        if (bundledReady) bundledReady.classList.toggle('hidden', panel !== 'ready');
        if (bundledErrorState) bundledErrorState.classList.toggle('hidden', panel !== 'error');
      }

      function showBundledError(message) {
        if (!bundledError) return;
        bundledError.textContent = message;
        bundledError.classList.remove('hidden');
      }

      function hideBundledError() {
        if (!bundledError) return;
        bundledError.textContent = '';
        bundledError.classList.add('hidden');
      }

      function syncBundledControls() {
        const authenticated = Boolean(token);
        const otherWorkspace = actingInOtherWorkspace();
        const disabled = !authenticated || !bundledKnown || bundledSaving || otherWorkspace;
        const reason = bundledSaving
          ? 'Wait for the current AI settings save to finish'
          : !authenticated
            ? 'Sign in to manage AI billing settings'
            : otherWorkspace
              ? 'Switch to your own workspace to change AI settings'
              : !bundledKnown
                ? 'Wait for AI billing settings to load'
                : '';
        if (bundledOtherWorkspace) {
          bundledOtherWorkspace.classList.toggle('hidden', !(authenticated && otherWorkspace));
        }
        if (bundledConsent) {
          bundledConsent.disabled = disabled;
          bundledConsent.title = reason;
        }
        if (bundledCapUsd) {
          bundledCapUsd.disabled = disabled;
          bundledCapUsd.title = reason;
        }
        if (bundledSave) {
          bundledSave.disabled = disabled;
          bundledSave.title = reason;
          bundledSave.toggleAttribute('aria-busy', bundledSaving);
          bundledSave.textContent = bundledSaving ? 'Saving…' : 'Save AI settings';
        }
      }

      function renderBundledStatus(status) {
        bundledKnown = true;
        if (bundledConsent) bundledConsent.checked = status.consent;
        bundledLoadedCapCents = status.cap_cents;
        if (bundledCapUsd) {
          // The max follows the loaded limit: the form has no novalidate, so a
          // kept limit above $100 under a $100 max would stop the browser from
          // submitting the form at all, even when only consent changed.
          bundledCapUsd.max = (bundledCapCeilingCents() / 100).toFixed(2);
          bundledCapUsd.value = (status.cap_cents / 100).toFixed(2);
        }
        if (bundledCapKept) {
          bundledCapKept.classList.toggle('hidden', status.cap_cents <= BUNDLED_CAP_NEW_MAX_CENTS);
        }
        if (bundledUsed) {
          bundledUsed.textContent = bundledCurrency.format(status.used_this_month_cents / 100);
        }
        if (bundledRemaining) {
          bundledRemaining.textContent = bundledCurrency.format(status.remaining_cents / 100);
        }
        if (bundledReset) {
          const start = new Date(status.month_started_at);
          const nextMonth = new Date(
            Date.UTC(start.getUTCFullYear(), start.getUTCMonth() + 1, 1),
          );
          bundledReset.textContent = nextMonth.toLocaleDateString(undefined, {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          });
        }
        if (bundledStatus) {
          bundledStatus.textContent = status.consent
            ? "Bundled AI is used when you haven't saved your own Anthropic key."
            : 'Bundled AI is off. Sessions using your own Anthropic key are unaffected.';
        }
        hideBundledError();
        setBundledPanel('ready');
        syncBundledControls();
      }

      async function fetchBundledStatus() {
        const response = await authedFetch('/v1/account/me/bundled-llm-status', {
          method: 'GET',
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw window.driftstackResponseError(response, body);
        if (!isBundledStatus(body)) throw new Error('Invalid AI billing status response.');
        return body;
      }

      async function loadBundledLlm() {
        if (!token || !bundledForm) return undefined;
        const generation = ++bundledLoadGeneration;
        bundledKnown = false;
        syncBundledControls();
        setBundledPanel('loading');
        hideBundledError();
        try {
          const status = await fetchBundledStatus();
          if (generation !== bundledLoadGeneration) return undefined;
          renderBundledStatus(status);
          return status;
        } catch (err) {
          if (generation !== bundledLoadGeneration) return undefined;
          bundledKnown = false;
          if (bundledLoadError) {
            bundledLoadError.textContent = requestErrorMessage(
              err,
              "We couldn't load your AI billing settings. No setting was changed.",
            );
          }
          if (bundledStatus) bundledStatus.textContent = 'AI billing settings are unavailable.';
          setBundledPanel('error');
          syncBundledControls();
          return undefined;
        }
      }

      function desiredBundledSettings() {
        const raw = bundledCapUsd ? bundledCapUsd.value.trim() : '';
        const ceilingCents = bundledCapCeilingCents();
        const invalid =
          ceilingCents > BUNDLED_CAP_NEW_MAX_CENTS
            ? 'Enter a limit from $0 up to your current ' +
              bundledCurrency.format(ceilingCents / 100) +
              ' limit, with at most two decimal places.'
            : 'Enter a limit from $0 to $100 with at most two decimal places.';
        if (!/^(?:0|[1-9]\d{0,4})(?:\.\d{1,2})?$/.test(raw)) throw new Error(invalid);
        const cents = Math.round(Number(raw) * 100);
        if (!Number.isInteger(cents) || cents < 0 || cents > ceilingCents) {
          throw new Error(invalid);
        }
        return {
          consent: Boolean(bundledConsent && bundledConsent.checked),
          monthly_cap_usd_cents: cents,
        };
      }

      if (bundledRetry) bundledRetry.addEventListener('click', loadBundledLlm);

      if (bundledForm) {
        bundledForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!token || !bundledKnown || bundledSaving || actingInOtherWorkspace()) return;
          let desired;
          try {
            desired = desiredBundledSettings();
          } catch (err) {
            showBundledError(err instanceof Error ? err.message : 'Enter a valid monthly limit.');
            return;
          }

          bundledSaving = true;
          let mutationAccepted = false;
          hideBundledError();
          syncBundledControls();
          try {
            const response = await authedFetch('/v1/account/me/bundled-llm-settings', {
              method: 'PATCH',
              body: JSON.stringify(desired),
            });
            const body = await response.json().catch(() => ({}));
            if (!response.ok) {
              if (isBundledCapRefusal(response, body)) {
                const refused = new Error(BUNDLED_CAP_REFUSED_MESSAGE);
                refused.bundledCapRefused = true;
                throw refused;
              }
              throw window.driftstackResponseError(response, body);
            }
            mutationAccepted = true;

            const live = await fetchBundledStatus();
            renderBundledStatus(live);
            if (
              live.consent === desired.consent &&
              live.cap_cents === desired.monthly_cap_usd_cents
            ) {
              const noticeGeneration = showBanner('AI billing settings saved.');
              setTimeout(() => hideBanner(noticeGeneration), 3000);
            } else {
              showBundledError(
                "The saved settings don't match what you entered. Check the current values before trying again.",
              );
            }
          } catch (err) {
            if (err && err.name === 'AbortError') {
              try {
                const live = await fetchBundledStatus();
                renderBundledStatus(live);
                if (
                  live.consent === desired.consent &&
                  live.cap_cents === desired.monthly_cap_usd_cents
                ) {
                  const noticeGeneration = showBanner(
                    'AI billing settings saved. The request took too long, but your settings show the change.',
                  );
                  setTimeout(() => hideBanner(noticeGeneration), 5000);
                } else {
                  showBundledError(
                    "The request took too long and the save didn't go through. The form now shows your current settings — check them before trying again.",
                  );
                }
              } catch {
                bundledKnown = false;
                if (bundledLoadError) {
                  bundledLoadError.textContent =
                    "The request took too long and we couldn't refresh your settings. Reload to check before trying again.";
                }
                if (bundledStatus) {
                  bundledStatus.textContent = "We couldn't confirm the AI billing save.";
                }
                setBundledPanel('error');
              }
            } else if (err && err.bundledCapRefused === true) {
              // The stored limit may have changed elsewhere since this form
              // loaded, so reload it: the next save then starts from the limit
              // the server actually holds.
              try {
                renderBundledStatus(await fetchBundledStatus());
                showBundledError(
                  BUNDLED_CAP_REFUSED_MESSAGE + ' The form now shows your current settings.',
                );
              } catch {
                showBundledError(BUNDLED_CAP_REFUSED_MESSAGE);
              }
            } else if (mutationAccepted) {
              bundledKnown = false;
              if (bundledLoadError) {
                bundledLoadError.textContent =
                  "Your settings were saved, but we couldn't refresh them. Reload to check before making the same change again.";
              }
              if (bundledStatus) bundledStatus.textContent = 'AI billing settings need a refresh.';
              setBundledPanel('error');
            } else {
              showBundledError(
                requestErrorMessage(err, 'Could not save AI billing settings. Try again.'),
              );
            }
          } finally {
            bundledSaving = false;
            syncBundledControls();
          }
        });
      }

      syncBundledControls();

      // V-204 — email preferences live wire.
      const emailPrefsList = root.querySelector('[data-list="email-prefs"]');
      const emailPrefsStatus = root.querySelector('[data-field="email-prefs-status"]');
      const emailPrefsInFlight = new WeakSet();

      function setEmailPrefsState(prefs) {
        if (!emailPrefsList) return;
        const inputs = emailPrefsList.querySelectorAll('input[type="checkbox"][data-event-type]');
        inputs.forEach((input) => {
          input.disabled = false;
          input.indeterminate = false;
          delete input.dataset.outcomeUnknown;
          const eventType = input.getAttribute('data-event-type');
          const pref = prefs.find((p) => p.event_type === eventType);
          input.checked = pref ? pref.opted_in : true;
        });
        if (emailPrefsStatus) {
          emailPrefsStatus.textContent =
            "Switch off any email you don't want. Changes save automatically.";
        }
      }

      function fetchEmailPrefs() {
        return authedFetch('/v1/account/email-preferences', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => body.data || []);
      }

      function loadEmailPrefs() {
        if (!token || !emailPrefsList) return;
        fetchEmailPrefs()
          .then((prefs) => setEmailPrefsState(prefs))
          .catch((err) => {
            const msg = requestErrorMessage(err, 'Could not load email preferences. Try again.');
            showBanner("Couldn't load email preferences (" + msg + ').');
          });
      }

      function saveEmailPref(eventType, optedIn, input) {
        if (!token) return;
        if (input && emailPrefsInFlight.has(input)) return;
        if (input) {
          emailPrefsInFlight.add(input);
          input.disabled = true;
          input.indeterminate = false;
          delete input.dataset.outcomeUnknown;
          input.setAttribute('aria-busy', 'true');
        }
        authedFetch('/v1/account/email-preferences', {
          method: 'PUT',
          body: JSON.stringify({ event_type: eventType, opted_in: optedIn }),
        })
          .then((r) => {
            if (r.status === 204 || r.ok) return null;
            return Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(() => {
            const noticeGeneration = showBanner('Email preference saved.');
            setTimeout(() => hideBanner(noticeGeneration), 2000);
          })
          .catch((err) => {
            if (err && err.name === 'AbortError' && input) {
              return fetchEmailPrefs()
                .then((prefs) => {
                  const livePref = prefs.find((pref) => pref.event_type === eventType);
                  const liveOptedIn = livePref ? livePref.opted_in : true;
                  input.checked = liveOptedIn;
                  if (liveOptedIn === optedIn) {
                    const noticeGeneration = showBanner(
                      'Email preference saved. The request took too long, but the setting shows your change.',
                    );
                    setTimeout(() => hideBanner(noticeGeneration), 5000);
                    return;
                  }
                  showBanner(
                    "The request took too long and the save didn't go through. The checkbox now shows your current setting — check it before trying again.",
                  );
                })
                .catch(() => {
                  input.indeterminate = true;
                  input.dataset.outcomeUnknown = 'true';
                  showBanner(
                    "The request took too long and we couldn't check whether it saved. Reload to check before changing this setting again.",
                  );
                });
            }
            // The checkbox already flipped optimistically on 'change' —
            // revert it so the displayed state matches what the server
            // actually has, instead of silently lying about whether the
            // customer is opted in/out of this email.
            if (input) input.checked = !optedIn;
            const msg = requestErrorMessage(err, 'Could not save the email preference. Try again.');
            showBanner("Couldn't save email preference (" + msg + ').');
          })
          .finally(() => {
            if (input) {
              emailPrefsInFlight.delete(input);
              input.disabled = input.dataset.outcomeUnknown === 'true';
              input.removeAttribute('aria-busy');
            }
          });
      }

      if (emailPrefsList) {
        emailPrefsList.addEventListener('change', (ev) => {
          const target = ev.target;
          if (
            !(target instanceof HTMLInputElement) ||
            target.type !== 'checkbox' ||
            !target.getAttribute('data-event-type')
          )
            return;
          const eventType = target.getAttribute('data-event-type');
          if (eventType) saveEmailPref(eventType, target.checked, target);
        });
      }

      // 2026-05-22 — V-666 BYOK Anthropic key wiring. Three actions:
      //   Save → PUT /v1/account/me/byok-anthropic-key
      //   Test → POST /v1/account/me/byok-anthropic-key/test
      //   Clear → DELETE /v1/account/me/byok-anthropic-key
      // Status fetch on load: GET returns metadata only (has_key +
      // set_at + last_used_at); never plaintext or a prefix. Plaintext goes over the
      // wire exactly once (Save), never re-displayed.
      const byokForm = document.querySelector('[data-byok-form]');
      const byokInput = document.querySelector('#byok-key');
      const byokSaveBtn = byokForm && byokForm.querySelector('button[type="submit"]');
      const byokTestBtn = document.querySelector('[data-byok-test]');
      const byokClearBtn = document.querySelector('[data-byok-clear]');
      const byokError = document.querySelector('[data-byok-error]');
      const byokStateLoading = document.querySelector('[data-byok-state="loading"]');
      const byokStateEmpty = document.querySelector('[data-byok-state="empty"]');
      const byokStateSet = document.querySelector('[data-byok-state="set"]');
      // S35 2026-07-07 (frontend audit) — 4th state: load failure.
      const byokStateError = document.querySelector('[data-byok-state="error"]');
      const byokRetryBtn = document.querySelector('[data-byok-retry]');
      const byokSetAt = document.querySelector('[data-byok-set-at]');
      const byokLastUsedAt = document.querySelector('[data-byok-last-used-at]');
      let byokActionInFlight = null;
      let byokTestFeedbackGeneration = 0;
      let byokLoadGeneration = 0;
      let byokMetadata = { hasKey: false, setAt: null, lastUsedAt: null };
      let byokMetadataKnown = false;

      function syncByokActionControls() {
        const busy = byokActionInFlight !== null;
        const authenticated = Boolean(token);
        const hasStoredKey = byokMetadataKnown && byokMetadata.hasKey;
        if (byokInput) {
          byokInput.disabled = busy || !authenticated;
          byokInput.title = busy
            ? 'Wait for the current key action to finish'
            : authenticated
              ? ''
              : 'Sign in to save an Anthropic API key';
        }
        if (byokSaveBtn) {
          byokSaveBtn.disabled = busy || !authenticated;
          byokSaveBtn.toggleAttribute('aria-busy', byokActionInFlight === 'save');
          byokSaveBtn.title = busy
            ? 'Wait for the current key action to finish'
            : authenticated
              ? ''
              : 'Sign in to save an Anthropic API key';
        }
        if (byokTestBtn) {
          byokTestBtn.disabled = busy || !hasStoredKey;
          byokTestBtn.toggleAttribute('aria-busy', byokActionInFlight === 'test');
          byokTestBtn.title = busy
            ? 'Wait for the current key action to finish'
            : hasStoredKey
              ? 'Check that your saved key works'
              : byokMetadataKnown
                ? 'Save a key before testing'
                : 'Wait for the key status to load';
        }
        if (byokClearBtn) {
          byokClearBtn.disabled = busy || !hasStoredKey;
          byokClearBtn.toggleAttribute('aria-busy', byokActionInFlight === 'clear');
          byokClearBtn.title = busy
            ? 'Wait for the current key action to finish'
            : hasStoredKey
              ? 'Delete your saved key'
              : byokMetadataKnown
                ? 'No stored key to clear'
                : 'Wait for the key status to load';
        }
      }

      syncByokActionControls();

      function beginByokAction(action) {
        if (byokActionInFlight !== null) return false;
        byokActionInFlight = action;
        byokTestFeedbackGeneration += 1;
        if (byokTestBtn) byokTestBtn.textContent = 'Test stored key';
        syncByokActionControls();
        return true;
      }

      function endByokAction(action) {
        if (byokActionInFlight !== action) return;
        byokActionInFlight = null;
        syncByokActionControls();
      }

      function showByokTestFeedback(label) {
        if (!byokTestBtn) return;
        const generation = ++byokTestFeedbackGeneration;
        byokTestBtn.textContent = label;
        setTimeout(() => {
          if (generation !== byokTestFeedbackGeneration) return;
          byokTestBtn.textContent = 'Test stored key';
          syncByokActionControls();
        }, 2000);
      }

      function byokShowState(name) {
        [byokStateLoading, byokStateEmpty, byokStateSet, byokStateError].forEach((el) => {
          if (el) el.classList.add('hidden');
        });
        const el = document.querySelector('[data-byok-state="' + name + '"]');
        if (el) el.classList.remove('hidden');
      }
      function byokShowError(msg) {
        if (!byokError) return;
        byokError.textContent = msg;
        byokError.classList.remove('hidden');
      }
      function byokHideError() {
        if (byokError) byokError.classList.add('hidden');
      }

      function loadByokAnthropic() {
        if (!token) return;
        const loadGeneration = ++byokLoadGeneration;
        byokMetadataKnown = false;
        syncByokActionControls();
        byokShowState('loading');
        return boundedFetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key', {
          headers: { authorization: 'Bearer ' + token },
        })
          .then((r) => {
            if (r.status === 404) return null; // empty (no key set)
            // S35 2026-07-07 (frontend audit) — parse-safe: a 5xx
            // from a gateway carries an HTML body, so r.json() itself
            // rejects; .catch(() => ({})) keeps the HTTP status as the
            // surfaced error instead of a JSON-parse one.
            if (!r.ok)
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
            return r.json();
          })
          .then((body) => {
            if (loadGeneration !== byokLoadGeneration) return undefined;
            byokHideError();
            if (body === null || body.has_key !== true) {
              byokMetadata = { hasKey: false, setAt: null, lastUsedAt: null };
              byokMetadataKnown = true;
              syncByokActionControls();
              byokShowState('empty');
              return byokMetadata;
            }
            const setAt = typeof body.set_at === 'string' ? body.set_at : null;
            const lastUsedAt = typeof body.last_used_at === 'string' ? body.last_used_at : null;
            byokMetadata = { hasKey: true, setAt, lastUsedAt };
            byokMetadataKnown = true;
            syncByokActionControls();
            if (byokSetAt) {
              const d = setAt ? new Date(setAt) : null;
              byokSetAt.dateTime = d && !Number.isNaN(d.getTime()) ? d.toISOString() : '';
              byokSetAt.textContent =
                d && !Number.isNaN(d.getTime()) ? d.toISOString().slice(0, 10) : 'unknown';
            }
            if (byokLastUsedAt) {
              const d = lastUsedAt ? new Date(lastUsedAt) : null;
              byokLastUsedAt.dateTime = d && !Number.isNaN(d.getTime()) ? d.toISOString() : '';
              byokLastUsedAt.textContent =
                d && !Number.isNaN(d.getTime()) ? d.toISOString().slice(0, 10) : 'never';
            }
            byokShowState('set');
            return byokMetadata;
          })
          .catch((err) => {
            if (loadGeneration !== byokLoadGeneration) return undefined;
            // S35 2026-07-07 (frontend audit) — a load FAILURE is
            // not an empty keyring: showing 'empty' here told a customer
            // with a stored key "No key on file" on any transient non-2xx.
            byokShowError(requestErrorMessage(err, "Couldn't check whether a key is saved. Try again."));
            byokMetadataKnown = false;
            syncByokActionControls();
            byokShowState('error');
            return undefined;
          });
      }

      if (byokRetryBtn) byokRetryBtn.addEventListener('click', loadByokAnthropic);

      if (byokForm) {
        byokForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!byokInput) return;
          if (!token) {
            byokShowError('Sign in to save an Anthropic API key.');
            return;
          }
          const key = byokInput.value.trim();
          if (key.length === 0) {
            byokShowError('Paste an Anthropic API key first.');
            return;
          }
          if (!beginByokAction('save')) return;
          byokHideError();
          const previousMetadataKnown = byokMetadataKnown;
          const previousHadKey = byokMetadata.hasKey;
          const previousSetAt = byokMetadata.setAt;
          if (byokSaveBtn) {
            byokSaveBtn.textContent = 'Saving…';
          }
          boundedFetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key', {
            method: 'PUT',
            headers: {
              authorization: 'Bearer ' + token,
              'content-type': 'application/json',
            },
            body: JSON.stringify({ api_key: key }),
          })
            .then((r) => {
              // S35 2026-07-07 (frontend audit) — parse-safe non-2xx
              // handling (HTML error bodies reject r.json()).
              if (!r.ok)
                return r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
              // The PUT response body is unused. Trust accepted status before
              // clearing the plaintext field and refreshing authoritative
              // metadata; malformed JSON cannot invite a duplicate secret save.
              return;
            })
            .then(() => {
              if (byokInput) byokInput.value = '';
              return loadByokAnthropic();
            })
            .catch(async (err) => {
              if (err && err.name === 'AbortError') {
                const refreshed = await loadByokAnthropic();
                const priorMs = previousSetAt === null ? null : Date.parse(previousSetAt);
                const nextMs = refreshed?.setAt ? Date.parse(refreshed.setAt) : Number.NaN;
                const advanced =
                  previousMetadataKnown &&
                  refreshed?.hasKey === true &&
                  Number.isFinite(nextMs) &&
                  (!previousHadKey ||
                    (priorMs !== null && Number.isFinite(priorMs) && nextMs > priorMs));
                if (advanced) {
                  byokInput.value = '';
                  byokShowError(
                    'Your key was probably saved — the request just took too long to respond. Use Test stored key to confirm; only save again if that test fails.',
                  );
                } else if (refreshed !== undefined) {
                  byokShowError(
                    "The request took too long and we can't tell if your key was saved. Your entry is still here. Wait a moment, check the status above, and try again only if it still shows no key.",
                  );
                } else {
                  byokShowError(
                    "The request took too long and we couldn't check whether your key was saved. Your entry is still here. Reload to check the status before trying again.",
                  );
                }
                return;
              }
              byokShowError(requestErrorMessage(err, "Couldn't save the key. Try again."));
            })
            .finally(() => {
              if (byokSaveBtn) {
                byokSaveBtn.textContent = 'Save key';
              }
              endByokAction('save');
            });
        });
      }

      if (byokTestBtn) {
        byokTestBtn.addEventListener('click', () => {
          if (!token) return;
          if (!byokMetadataKnown || !byokMetadata.hasKey) {
            byokShowError('Save the key and wait for its status to load before testing.');
            return;
          }
          if (!beginByokAction('test')) return;
          byokTestBtn.textContent = 'Testing…';
          byokHideError();
          boundedFetch(apiBaseUrl + '/v1/account/me/byok-anthropic-key/test', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + token },
          })
            .then((r) =>
              // S35 2026-07-07 (frontend audit) — parse-safe non-2xx.
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
            )
            .then((body) => {
              showByokTestFeedback(body.ok === true ? 'Test ✓' : 'Test ⚠');
              if (body.ok !== true) {
                const reason = typeof body.reason === 'string' ? body.reason.trim() : '';
                byokShowError(
                  reason.length > 0 && reason.length <= BYOK_TEST_REASON_MAX_CHARS
                    ? reason
                    : "Anthropic didn't accept the saved key. Check it, or create a new key, and try again.",
                );
              }
            })
            .catch((err) => {
              showByokTestFeedback('Test ⚠');
              byokShowError(requestErrorMessage(err, "Couldn't test the key. Try again."));
            })
            .finally(() => {
              endByokAction('test');
            });
        });
      }

      if (byokClearBtn) {
        byokClearBtn.addEventListener('click', async () => {
          if (!token) return;
          if (!beginByokAction('clear')) return;
          try {
            if (!(await window.driftstackConfirm(
              "Delete your saved Anthropic key? The AI agent will use Driftstack's built-in AI instead (if your plan includes it).",
              { confirmLabel: 'Clear key', destructive: true },
            ))) return;
            const response = await boundedFetch(
              apiBaseUrl + '/v1/account/me/byok-anthropic-key',
              {
                method: 'DELETE',
                headers: { authorization: 'Bearer ' + token },
              },
            );
            // S35 2026-07-07 (frontend audit) — parse-safe non-2xx.
            if (!response.ok && response.status !== 404) {
              const body = await response.json().catch(() => ({}));
              throw window.driftstackResponseError(response, body);
            }
            await loadByokAnthropic();
          } catch (err) {
            if (err && err.name === 'AbortError') {
              const refreshed = await loadByokAnthropic();
              if (refreshed?.hasKey === false) {
                byokShowError(
                  'Your key was probably deleted — the request just took too long to respond, and no key is saved now. No need to try again.',
                );
              } else if (refreshed?.hasKey === true) {
                byokShowError(
                  'The request took too long and your key is still saved. Wait a moment and try again only if it still shows as saved.',
                );
              } else {
                byokShowError(
                  "The request took too long and we couldn't check whether your key was deleted. Reload to check before trying again.",
                );
              }
            } else {
              byokShowError(requestErrorMessage(err, "Couldn't delete the key. Try again."));
            }
          } finally {
            endByokAction('clear');
          }
        });
      }

      // 2026-09-21 (stage 2) — measured in a real browser (not assumed):
      // this page's own two calls to window.dashboardHydrated() were both
      // silent no-ops. DashboardLayout defines window.dashboardHydrated in
      // its OWN <script>, which sits after </main> — after every slotted
      // page's inline <script>, this one included — in document order.
      // A parser-blocking <script> runs synchronously as the HTML parser
      // reaches it, and even a queueMicrotask callback queued from inside
      // it still runs before the parser advances to that later <script>,
      // so both the old synchronous call below and the old
      // queueMicrotask(...) wrapper found window.dashboardHydrated
      // undefined every single time and silently did nothing — this page
      // reveals ONLY via the layout's 1200ms safety-cap timer, on every
      // load, regardless of how fast the network actually is. Confirmed by
      // instrumenting a real dev-server load (negative control: reverted
      // this fix, re-measured, restored it): reveal landed at ~1224ms
      // here vs. ~20-136ms on pages that gate the same call behind an
      // async fetch (e.g. billing.astro), where the network round-trip
      // alone outlasts the rest of the document's parse. DOMContentLoaded
      // fires only after the whole document — every parser-blocking
      // script included — has run, so by then window.dashboardHydrated is
      // guaranteed to exist; deferring to it (or calling immediately if
      // parsing has somehow already finished) fixes both call sites
      // without touching the shared layout script other pages already
      // rely on.
      function callDashboardHydrated() {
        function fire() {
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fire, { once: true });
        } else {
          fire();
        }
      }

      if (!token) {
        showBanner('Sign in to see live preferences + recent activity.');
        callDashboardHydrated();
        return;
      }

      loadEmailPrefs();
      loadBundledLlm();
      loadByokAnthropic();
      // 2026-05-21 — opacity-gate signal. Three loaders fire in parallel
      // without returning promises (legacy shape). Fire the reveal as
      // soon as the document is ready (see callDashboardHydrated above)
      // rather than waiting the 1200ms safety cap. Fields populate as
      // each request resolves.
      callDashboardHydrated();
    })();
  </script>
</DashboardLayout>
