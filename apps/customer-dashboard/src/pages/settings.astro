---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_ACCOUNT } from '../data/mocks.ts';

// V-217 — progressive-enhancement live wiring against:
//   - /v1/account/email-preferences (V-204) — list + PUT per-event toggles
//   - /v1/account/audit-log (V-216) — recent customer-visible events
//   - /v1/auth/password-reset/request (V-079) — change-password trigger
//
// SSG renders mocks; inline <script> reads ds_web_session_token from
// localStorage and replaces the live sections. Profile + Active
// sign-ins remain on mock — those wires land in follow-up slices
// (/v1/account profile endpoint doesn't exist yet; sign-in tracking
// is a separate concern).

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';

// V-204 opt-outable email events. Mirrors OptOutableEmailEventSchema.
const EMAIL_EVENTS = [
  {
    type: 'signup-welcome',
    label: 'Signup welcome',
    description: 'Once-after-verification onboarding email.',
  },
  {
    type: 'session-failed-first',
    label: 'First session failure',
    description: 'One-time notice the first time a session fails on this account.',
  },
  {
    type: 'session-success-first',
    label: 'First session success',
    description:
      'One-time activation email after your first session completes successfully. Subsequent sessions don\'t notify; the dashboard takes over.',
  },
  {
    type: 'tier-changed',
    label: 'Subscription tier changed',
    description: 'Confirmation when your tier changes via the Stripe portal.',
  },
  {
    type: 'trial-pack-purchased',
    label: 'Trial pack purchased',
    description: 'Confirmation after the $2.99 checkout succeeds.',
  },
  {
    type: 'trial-pack-expired',
    label: 'Trial pack expired',
    description: 'Notice when the 14-day trial-pack window closes.',
  },
  {
    type: 'billing-receipt',
    label: 'Billing receipts',
    description: 'Per-invoice receipt emails. Stripe receipts continue regardless.',
  },
  {
    type: 'billing-renewal-reminder',
    label: 'Renewal reminder',
    description:
      'Heads-up email ~7 days before each subscription renewal so you can update payment method or change tier ahead of time.',
  },
] as const;
---

<DashboardLayout title="Settings">
  <div class="mx-auto max-w-3xl px-6 py-10" data-page="settings">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-slate-500" data-field="header-account">
        Account · {MOCK_ACCOUNT.id.slice(0, 16)}…
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Settings</h1>
      <p class="mt-2 max-w-prose text-sm text-slate-500">
        Account profile, security, and the danger zone. Changes here affect
        all sessions, profiles, and webhooks under this account.
      </p>
    </header>

    <!-- Profile -->
    <section class="dashboard-card">
      <h2 class="text-lg font-semibold text-slate-900">Profile</h2>
      <p class="mt-2 text-sm text-slate-500">
        Display name + email shown on invoices and webhook delivery audit logs.
      </p>
      <div class="mt-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="name">Name</label>
          <input
            id="name"
            type="text"
            value={MOCK_ACCOUNT.name ?? ''}
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="email">Email</label>
          <input
            id="email"
            type="email"
            value={MOCK_ACCOUNT.email}
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <p class="mt-1 text-xs text-slate-500">
            Verified {fmtIso(MOCK_ACCOUNT.emailVerifiedAt)}. Changing email
            triggers re-verification.
          </p>
        </div>
        <button class="btn-primary mt-2">Save changes</button>
        <p class="text-xs text-slate-400">
          Profile editing endpoint lands as a follow-up slice; saves are
          currently no-op.
        </p>
      </div>
    </section>

    <!-- Security -->
    <section class="dashboard-card mt-6">
      <h2 class="text-lg font-semibold text-slate-900">Security</h2>
      <p class="mt-2 text-sm text-slate-500">Password + recovery options.</p>
      <div class="mt-6 space-y-3">
        <button type="button" data-action="change-password" class="btn-secondary inline-flex">
          Change password
        </button>
        <p class="text-xs text-slate-500">
          We email you a magic link to confirm. The link expires after 15
          minutes; old sessions stay signed in until they naturally expire.
        </p>
      </div>
    </section>

    <!-- Sessions / devices -->
    <section class="dashboard-card mt-6">
      <h2 class="text-lg font-semibold text-slate-900">Active sign-ins</h2>
      <p class="mt-2 text-sm text-slate-500">
        Browser sessions where you're signed in to the dashboard. Distinct
        from your driver sessions on /sessions.
      </p>
      <ul class="mt-6 divide-y divide-slate-100">
        <li class="flex items-start justify-between gap-6 py-3">
          <div>
            <p class="text-sm font-medium text-slate-900">macOS · Safari · current</p>
            <p class="mt-1 text-xs text-slate-500">
              Signed in {fmtIso('2026-05-04T08:00:00Z')} · IP omitted from
              dashboard for privacy
            </p>
          </div>
          <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">
            current
          </span>
        </li>
      </ul>
      <p class="mt-4 text-xs text-slate-400">
        Sign-in tracking endpoint lands as a follow-up slice; current entry is
        scaffolding.
      </p>
    </section>

    <!-- Profile basics (V-352 — name + timezone) -->
    <section class="dashboard-card mt-6" data-region="profile">
      <h2 class="text-lg font-semibold text-slate-900">Profile</h2>
      <p class="mt-2 text-sm text-slate-500">
        Display name + timezone. Used by the dashboard + outbound emails to
        render timestamps in your local time.
      </p>
      <form data-form="profile" class="mt-6 space-y-4">
        <!-- V-352b — avatar upload -->
        <div class="flex items-center gap-4">
          <div
            data-field="avatar-preview"
            class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border border-slate-200 bg-slate-100 text-xs text-slate-400"
          >
            no avatar
          </div>
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <label
                class="btn-secondary inline-flex cursor-pointer text-sm"
                for="profile-avatar-input"
              >
                Upload image
              </label>
              <input
                id="profile-avatar-input"
                data-field="avatar-input"
                type="file"
                accept="image/png,image/jpeg,image/webp"
                class="hidden"
              />
              <button
                type="button"
                data-button="avatar-remove"
                class="btn-secondary text-sm text-red-700"
                hidden
              >
                Remove
              </button>
            </div>
            <p class="text-xs text-slate-500">
              PNG, JPEG, or WebP. Max 2 MB. Stored on Cloudflare R2 (EU).
            </p>
            <p
              data-field="avatar-error"
              class="hidden rounded border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-700"
            ></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="profile-name">
            Display name
          </label>
          <input
            id="profile-name"
            data-field="profile-name"
            type="text"
            placeholder="Optional — leave blank to use your email"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="profile-timezone">
            Timezone (IANA)
          </label>
          <input
            id="profile-timezone"
            data-field="profile-timezone"
            type="text"
            placeholder="Europe/Amsterdam"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <p class="mt-1 text-xs text-slate-500">
            IANA name like <code class="font-mono">Europe/Amsterdam</code> or
            <code class="font-mono">America/Los_Angeles</code>. Leave blank for UTC.
          </p>
        </div>
        <p
          data-field="profile-error"
          class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        ></p>
        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
          <span data-field="profile-status" class="text-xs text-slate-500"></span>
          <button
            type="submit"
            data-button="profile-save"
            class="btn-primary"
          >
            Save
          </button>
        </div>
      </form>
    </section>

    <!-- Email notifications (V-204 — live-wired) -->
    <section class="dashboard-card mt-6" data-region="email-prefs">
      <h2 class="text-lg font-semibold text-slate-900">Email notifications</h2>
      <p class="mt-2 text-sm text-slate-500">
        Security + financial emails (signup verification, password reset,
        billing failure, subscription cancellation, support replies) always
        go out. Below are the optional lifecycle emails — toggle off any
        you don't want.
      </p>
      <div class="mt-6 space-y-3" data-list="email-prefs">
        {
          EMAIL_EVENTS.map((event) => (
            <label class="flex items-start gap-3">
              <input
                type="checkbox"
                data-event-type={event.type}
                checked
                class="mt-0.5"
                disabled
              />
              <span class="text-sm text-slate-700">
                <strong class="block font-medium text-slate-900">{event.label}</strong>
                {event.description}
              </span>
            </label>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-slate-400" data-field="email-prefs-status">
        Sign in to load live preferences.
      </p>
    </section>

    <!-- Audit log (V-216 — live-wired) -->
    <section class="dashboard-card mt-6" data-region="audit-log">
      <h2 class="text-lg font-semibold text-slate-900">Recent activity</h2>
      <p class="mt-2 text-sm text-slate-500">
        API key mints + revokes, session lifecycle events, and other account
        changes. Newest first; filtered to your own account.
      </p>
      <ul class="mt-6 divide-y divide-slate-100" data-list="audit-log">
        <li class="py-3 text-sm text-slate-500" data-field="audit-empty">
          Sign in to load recent activity.
        </li>
      </ul>
    </section>

    <!-- Danger zone -->
    <section class="mt-10 rounded-lg border border-red-200 bg-red-50 p-6">
      <h2 class="text-lg font-semibold text-red-900">Danger zone</h2>
      <p class="mt-2 text-sm text-red-800">
        Account deletion is irreversible. All sessions, profiles, API keys,
        and webhook endpoints are immediately revoked. Recordings are hard-
        deleted from R2 within 14 days. Invoice history retained per EU tax
        law (10 years) — not deletable on request.
      </p>
      <p class="mt-3 text-xs text-red-800">
        Pre-launch: deletion is processed by emailing
        <a
          href="mailto:support@driftstack.dev?subject=Account%20deletion%20request"
          class="underline">support@driftstack.dev</a
        >. Self-service deletion endpoint lands post-launch.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="settings"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      // V-352c — wire the profile (name + timezone) form.
      const profileForm = root.querySelector('[data-form="profile"]');
      const profileNameInput = root.querySelector('[data-field="profile-name"]');
      const profileTzInput = root.querySelector('[data-field="profile-timezone"]');
      const profileError = root.querySelector('[data-field="profile-error"]');
      const profileStatus = root.querySelector('[data-field="profile-status"]');
      const profileSaveBtn = root.querySelector('[data-button="profile-save"]');

      function showProfileError(msg) {
        if (!profileError) return;
        profileError.textContent = msg;
        profileError.classList.remove('hidden');
      }

      // V-352b — avatar elements + helpers.
      const avatarPreview = root.querySelector('[data-field="avatar-preview"]');
      const avatarInput = root.querySelector('[data-field="avatar-input"]');
      const avatarRemoveBtn = root.querySelector('[data-button="avatar-remove"]');
      const avatarError = root.querySelector('[data-field="avatar-error"]');

      function showAvatarError(msg) {
        if (!avatarError) return;
        avatarError.textContent = msg;
        avatarError.classList.remove('hidden');
      }
      function clearAvatarError() {
        if (!avatarError) return;
        avatarError.textContent = '';
        avatarError.classList.add('hidden');
      }

      function setAvatarPreview(url) {
        if (!avatarPreview) return;
        if (url) {
          avatarPreview.innerHTML =
            '<img src="' +
            escapeHtml(url) +
            '" alt="avatar" class="h-full w-full object-cover" />';
          if (avatarRemoveBtn) avatarRemoveBtn.hidden = false;
        } else {
          avatarPreview.innerHTML = 'no avatar';
          if (avatarRemoveBtn) avatarRemoveBtn.hidden = true;
        }
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = reader.result;
            if (typeof result !== 'string') {
              reject(new Error('Failed to read file.'));
              return;
            }
            // Strip the data:<mime>;base64, prefix.
            const idx = result.indexOf(',');
            resolve(idx >= 0 ? result.slice(idx + 1) : result);
          };
          reader.onerror = () => reject(new Error('Failed to read file.'));
          reader.readAsDataURL(file);
        });
      }

      // Load current profile values (GET /v1/account/me).
      if (token && profileNameInput && profileTzInput) {
        fetch(apiBaseUrl + '/v1/account/me', {
          headers: { authorization: 'Bearer ' + token },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((me) => {
            if (!me) return;
            if (me.name) profileNameInput.value = me.name;
            if (me.timezone) profileTzInput.value = me.timezone;
            // V-352b — initial avatar preview.
            setAvatarPreview(me.avatar_url || null);
          })
          .catch(() => {
            /* leave inputs blank */
          });
      }

      // V-352b — avatar upload handler.
      if (avatarInput) {
        avatarInput.addEventListener('change', (ev) => {
          clearAvatarError();
          const target = ev.target;
          if (!(target instanceof HTMLInputElement)) return;
          const file = target.files && target.files[0];
          if (!file) return;
          if (!token) {
            showAvatarError('Sign in to upload an avatar.');
            target.value = '';
            return;
          }
          if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
            showAvatarError('Only PNG, JPEG, or WebP allowed.');
            target.value = '';
            return;
          }
          if (file.size > 2 * 1024 * 1024) {
            showAvatarError('Image is over 2 MB.');
            target.value = '';
            return;
          }
          fileToBase64(file)
            .then((b64) =>
              fetch(apiBaseUrl + '/v1/account/me/avatar', {
                method: 'POST',
                headers: {
                  'content-type': 'application/json',
                  authorization: 'Bearer ' + token,
                },
                body: JSON.stringify({
                  content_type: file.type,
                  data_base64: b64,
                }),
              }),
            )
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              setAvatarPreview(body.avatar_url || null);
            })
            .catch((err) => {
              showAvatarError(err && err.message ? err.message : 'Upload failed.');
            })
            .finally(() => {
              target.value = '';
            });
        });
      }

      // V-352b — avatar remove handler.
      if (avatarRemoveBtn) {
        avatarRemoveBtn.addEventListener('click', () => {
          clearAvatarError();
          if (!token) {
            showAvatarError('Sign in to remove your avatar.');
            return;
          }
          fetch(apiBaseUrl + '/v1/account/me/avatar', {
            method: 'DELETE',
            headers: { authorization: 'Bearer ' + token },
          })
            .then((r) => {
              if (r.status === 204 || r.ok) return null;
              return r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
            })
            .then(() => {
              setAvatarPreview(null);
            })
            .catch((err) => {
              showAvatarError(err && err.message ? err.message : 'Remove failed.');
            });
        });
      }

      if (profileForm) {
        profileForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (profileError) {
            profileError.classList.add('hidden');
            profileError.textContent = '';
          }
          if (!token) {
            showProfileError('Sign in to update your profile.');
            return;
          }
          const name = profileNameInput.value.trim();
          const tz = profileTzInput.value.trim();
          if (profileSaveBtn) {
            profileSaveBtn.disabled = true;
            profileSaveBtn.textContent = 'Saving…';
          }
          fetch(apiBaseUrl + '/v1/account/me', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify({
              name: name.length > 0 ? name : null,
              timezone: tz.length > 0 ? tz : null,
            }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              if (profileStatus) {
                profileStatus.textContent = 'Saved.';
                window.setTimeout(() => {
                  if (profileStatus) profileStatus.textContent = '';
                }, 3000);
              }
            })
            .catch((err) => {
              showProfileError(err && err.message ? err.message : 'Failed to save.');
            })
            .finally(() => {
              if (profileSaveBtn) {
                profileSaveBtn.disabled = false;
                profileSaveBtn.textContent = 'Save';
              }
            });
        });
      }

      function authedFetch(path, init = {}) {
        return fetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // V-204 — email preferences live wire.
      const emailPrefsList = root.querySelector('[data-list="email-prefs"]');
      const emailPrefsStatus = root.querySelector('[data-field="email-prefs-status"]');

      function setEmailPrefsState(prefs) {
        if (!emailPrefsList) return;
        const inputs = emailPrefsList.querySelectorAll('input[type="checkbox"][data-event-type]');
        inputs.forEach((input) => {
          input.disabled = false;
          const eventType = input.getAttribute('data-event-type');
          const pref = prefs.find((p) => p.event_type === eventType);
          input.checked = pref ? pref.opted_in : true;
        });
        if (emailPrefsStatus) {
          emailPrefsStatus.textContent =
            'Toggle off any lifecycle email you do not want. Changes save automatically.';
        }
      }

      function loadEmailPrefs() {
        if (!token || !emailPrefsList) return;
        authedFetch('/v1/account/email-preferences', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => setEmailPrefsState(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load email preferences (" + msg + ').');
          });
      }

      function saveEmailPref(eventType, optedIn) {
        if (!token) return;
        authedFetch('/v1/account/email-preferences', {
          method: 'PUT',
          body: JSON.stringify({ event_type: eventType, opted_in: optedIn }),
        })
          .then((r) => {
            if (r.status === 204 || r.ok) return null;
            return Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(() => {
            showBanner('Email preference saved.');
            setTimeout(hideBanner, 2000);
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't save email preference (" + msg + ').');
          });
      }

      if (emailPrefsList) {
        emailPrefsList.addEventListener('change', (ev) => {
          const target = ev.target;
          if (
            !(target instanceof HTMLInputElement) ||
            target.type !== 'checkbox' ||
            !target.getAttribute('data-event-type')
          )
            return;
          const eventType = target.getAttribute('data-event-type');
          if (eventType) saveEmailPref(eventType, target.checked);
        });
      }

      // V-216 — audit log live wire.
      const auditList = root.querySelector('[data-list="audit-log"]');

      function fmtAction(action) {
        return action.replace(/[._]/g, ' ');
      }

      function renderAudit(entries) {
        if (!auditList) return;
        if (entries.length === 0) {
          auditList.innerHTML =
            '<li class="py-3 text-sm text-slate-500">No recent activity yet — your first key mint, session create, or other account event will appear here.</li>';
          return;
        }
        auditList.innerHTML = entries
          .map((entry) => {
            const targetFrag = entry.target_resource_id
              ? '<p class="mt-1 font-mono text-[11px] text-slate-500">' +
                escapeHtml(entry.target_resource_id) +
                '</p>'
              : '';
            return (
              '<li class="flex items-start justify-between gap-4 py-3">' +
              '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-slate-500">' +
              escapeHtml(fmtIso(entry.timestamp)) +
              '</p>' +
              '<p class="mt-1 text-sm text-slate-900">' +
              '<code class="font-mono text-xs text-oxblood-700">' +
              escapeHtml(entry.action) +
              '</code>' +
              '</p>' +
              targetFrag +
              '</div>' +
              '<span class="text-xs text-slate-400">' +
              escapeHtml(fmtAction(entry.actor_type)) +
              '</span></li>'
            );
          })
          .join('');
      }

      function loadAudit() {
        if (!token || !auditList) return;
        authedFetch('/v1/account/audit-log?limit=20', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => renderAudit(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load audit log (" + msg + ').');
          });
      }

      // V-079 — change password trigger via password-reset request.
      function changePassword() {
        if (!token) {
          showBanner('Sign in to change password.');
          return;
        }
        // Email comes from the JWT-mirrored web session; the customer-
        // dashboard fetches /v1/account when that endpoint exists. For
        // V-217, prompt for the email so the password-reset link goes
        // to the right address. Self-derived email comes via /v1/account
        // follow-up.
        const email = window.prompt('Enter your account email to send the password-reset link:');
        if (!email || !email.trim()) return;
        showBanner('Sending password-reset email…');
        fetch(apiBaseUrl + '/v1/auth/password-reset/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email.trim() }),
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then(() => {
            showBanner('Password-reset email sent. Check your inbox.');
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't send password-reset (" + msg + ').');
          });
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action="change-password"]');
        if (!btn) return;
        ev.preventDefault();
        changePassword();
      });

      if (!token) {
        showBanner('Sign in to see live preferences + recent activity.');
        return;
      }

      loadEmailPrefs();
      loadAudit();
    })();
  </script>
</DashboardLayout>
