---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_PROFILES, MOCK_USAGE_SUMMARY } from '../data/mocks.ts';
import {
  ARCHETYPE_REGISTRY,
  LOCKED_ARCHETYPE_ID,
  LOCKED_ARCHETYPE_DISPLAY_LABEL,
  PROFILES_PER_TIER,
  STORAGE_SOFT_WARN_FRACTION,
  TIER_STORAGE_BYTES_CAP,
  archetypeDisplayLabel,
  type AccountTier,
} from '@driftstack/api-types';

// The customer-selectable device catalogue = registry entries with status
// 'launch' or 'available' (NOT internal 'reference' / unpopulated 'planned').
// The picker grows automatically as Agent-1 populates more devices. The
// gui-firstrun-archetype-options-registry-invariant guard keeps the GUI in
// sync with this same set.
const SELECTABLE_ARCHETYPES = ARCHETYPE_REGISTRY.filter(
  (a) => a.status === 'launch' || a.status === 'available',
);

// Friendly labels for EVERY known archetype (not just the selectable set — a
// profile may carry an older/other slug), injected into the client script so
// the profile list renders the SAME labels as the server. Derived through
// archetypeDisplayLabel() so it stays the registry's single source of truth;
// an unknown slug falls back to its raw id client-side.
const ARCHETYPE_LABELS = Object.fromEntries(
  ARCHETYPE_REGISTRY.map((a) => [a.id, archetypeDisplayLabel(a.id)]),
);

// V-136 — uses the locked PROFILES_PER_TIER constant from
// @driftstack/api-types as single source of truth.
//
// V-284 — progressive-enhancement wiring. Reads ds_web_session_token,
// fetches /v1/profiles + /v1/account/me to compute live count vs tier
// cap, wires create + delete actions. Falls back to mock-rendered list
// when token absent or fetch fails (consistent with sessions.astro,
// billing.astro etc).

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().slice(0, 10);
}

const tier: AccountTier = MOCK_USAGE_SUMMARY.tier;
const profileLimit = PROFILES_PER_TIER[tier];
const profileCount = MOCK_PROFILES.length;
const atLimit = profileLimit !== 'custom' && profileCount >= profileLimit;
const limitDisplay = profileLimit === 'custom' ? 'Custom' : profileLimit.toString();

const TIER_DISPLAY_ORDER: ReadonlyArray<{ id: AccountTier; label: string }> = [
  { id: 'solo_manual', label: 'Personal' },
  { id: 'team_manual', label: 'Team' },
  { id: 'agency_manual', label: 'Agency' },
  { id: 'api_starter', label: 'API Starter' },
  { id: 'api_builder', label: 'API Builder' },
  { id: 'api_scale', label: 'API Scale' },
  { id: 'enterprise', label: 'Enterprise' },
];

// The per-tier ceiling card already prints a "profiles" unit sub-label, so
// the value line is just the count (or "custom") — otherwise the unit doubles
// up ("500 profiles" over "profiles").
function fmtLimit(value: number | 'custom'): string {
  return value === 'custom' ? 'custom' : value.toString();
}

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Profiles">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="profiles">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-tk-ink-3" data-field="tier-line">{MOCK_USAGE_SUMMARY.tier} tier</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Profiles</h1>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Persistent identity slots that survive across sessions. Each profile carries its own
          cookies, localStorage, and last-used timestamp. Sessions can be created against a profile
          or anonymously.
        </p>
        {/* 2026-05-24 — device chip surfaces the archetype profiles run as. */}
        <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-tk-border bg-tk-surface px-2.5 py-1 text-xs text-tk-ink-2">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent" aria-hidden="true">
            <rect x="6" y="2" width="12" height="20" rx="2.5" />
            <circle cx="12" cy="18" r="0.75" fill="currentColor" />
          </svg>
          {LOCKED_ARCHETYPE_DISPLAY_LABEL}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button type="button" class="btn-secondary" data-show-import>Import</button>
        <button type="button" class="btn-primary" data-show-create>New profile</button>
      </div>
    </header>

    <p class="mb-2 text-sm text-tk-ink-3" data-field="usage-line">
      <strong class="font-medium text-tk-ink" data-field="count">{profileCount}</strong> of
      <strong class="font-medium text-tk-ink" data-field="limit">{limitDisplay}</strong>
      profile slots used.
      {atLimit && <span class="text-red-700"> · tier limit reached</span>}
    </p>
    {/* doc-150 item 5 — account storage total (sum of every profile's
        size_bytes). item 6 — per-account storage QUOTA: used / tier-cap %
        with a soft (>=80%) warn + an over-cap state. Both hidden until
        hydration fills them in (no meaningful SSR value without live data;
        the cap depends on the live tier from /v1/account/me). Enforced
        server-side at session-launch; enterprise is soft-only (no hard
        block, so the over-cap bar reads as a warning, not a stop). */}
    <div class="mb-6 hidden" data-field="storage-line">
      <p class="text-sm text-tk-ink-3">
        <strong class="font-medium text-tk-ink" data-field="storage-total">—</strong>
        of
        <strong class="font-medium text-tk-ink" data-field="storage-cap">—</strong>
        used across your profiles
        <span data-field="storage-pct" class="text-tk-ink-3"></span>
        <span data-field="storage-warn" class="hidden font-medium"></span>
      </p>
      <div class="mt-2 h-2 w-full max-w-md overflow-hidden rounded-full bg-tk-bg" role="presentation">
        <div data-field="storage-bar" class="h-full w-0 rounded-full bg-tk-accent transition-[width]"></div>
      </div>
    </div>

    <!--
      V-470 — Snapshot capture form, hidden by default. Reveals when a
      profile row's "Snapshot" button is clicked. Replaces the earlier
      window.prompt flow (some browsers block prompts in non-
      interactive contexts; inline form is keyboard-accessible).
    -->
    <div
      data-snapshot-form-wrap
      class="mb-8 hidden rounded-lg border border-tk-border bg-tk-surface p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
            <circle cx="12" cy="13" r="4" />
          </svg>
        </span>
        <span class="text-tk-ink">Capture snapshot of <span data-snapshot-source-name class="font-mono"></span></span>
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Snapshots are immutable point-in-time copies. The original profile
        keeps evolving; the snapshot is frozen. Restore from
        <a href="/snapshots" class="text-tk-accent underline">/snapshots</a>
        later.
      </p>
      <form data-snapshot-form class="mt-4 space-y-4">
        <div>
          <label for="snapshot-label" class="block text-sm font-medium text-tk-ink-2">
            Snapshot label
          </label>
          <input
            id="snapshot-label"
            data-snapshot-label-input
            type="text"
            required
            placeholder='e.g. "before-migration", "post-login-state"'
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            Surface why you captured this. Useful when a profile has many
            snapshots and you're picking one to restore.
          </p>
        </div>
        <div>
          <label for="snapshot-description" class="block text-sm font-medium text-tk-ink-2">
            Description (optional)
          </label>
          <input
            id="snapshot-description"
            data-snapshot-description-input
            type="text"
            placeholder="What state was the profile in?"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="btn-primary" data-snapshot-submit>Capture snapshot</button>
          <button
            type="button"
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
            data-snapshot-cancel
          >
            Cancel
          </button>
          <span data-snapshot-error class="hidden text-sm text-rose-700"></span>
        </div>
      </form>
    </div>

    <!--
      V-480 — Import form. Reveals when "Import" is clicked. Accepts a
      v1 envelope JSON (paste or file upload), optional name override.
    -->
    <div
      data-import-form-wrap
      class="mb-8 hidden rounded-lg border border-tk-border bg-tk-surface p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
        </span>
        Import profile from JSON
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Paste a v1 envelope (from another profile's Export action) or upload a
        <code class="font-mono text-xs">.json</code> file. Tier-cap + name-conflict
        rules match creating a fresh profile.
      </p>
      <form data-import-form class="mt-4 space-y-4">
        <div>
          <label for="import-file" class="block text-sm font-medium text-tk-ink-2">
            Upload envelope (.json)
          </label>
          <input
            id="import-file"
            data-import-file-input
            type="file"
            accept="application/json,.json"
            class="mt-1 block text-sm text-tk-ink-2 file:mr-3 file:rounded-md file:border-0 file:bg-tk-surface file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-tk-ink-2 hover:file:bg-tk-raised"
          />
        </div>
        <div>
          <label for="import-text" class="block text-sm font-medium text-tk-ink-2">
            Or paste envelope JSON
          </label>
          <textarea
            id="import-text"
            data-import-text-input
            rows="6"
            placeholder='{"version":1,"exported_at":"…","source_profile_id":"prof_…","source_account_id":"…","profile":{"name":"…","archetype":"…","description":null}}'
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 font-mono text-xs"
          ></textarea>
        </div>
        <div>
          <label for="import-name-override" class="block text-sm font-medium text-tk-ink-2">
            Rename on import (optional)
          </label>
          <input
            id="import-name-override"
            data-import-name-override-input
            type="text"
            placeholder="leave blank to keep the envelope's name"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="btn-primary" data-import-submit>Import</button>
          <button
            type="button"
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
            data-import-cancel
          >
            Cancel
          </button>
          <span data-import-error class="hidden text-sm text-rose-700"></span>
        </div>
      </form>
    </div>

    <!-- V-284 — Create form, hidden by default -->
    <div
      data-create-form-wrap
      class="mb-8 hidden rounded-lg border border-tk-border bg-tk-surface p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="7" r="4" />
            <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
            <path d="M19 8v6M22 11h-6" />
          </svg>
        </span>
        Create a new profile
      </h2>
      <form data-create-form class="mt-4 space-y-4">
        {/* 2026-05-30 — archetype PICKER. The platform models a device
            MATRIX, not one device; the customer-selectable catalogue derives
            from ARCHETYPE_REGISTRY (status launch|available) so more devices
            appear here automatically as their fingerprint atlases land. */}
        <div class="rounded-md border border-tk-border bg-tk-bg p-3" data-archetype-card>
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="2" width="14" height="20" rx="2.5" />
                <circle cx="12" cy="18" r="0.75" fill="currentColor" />
                <line x1="10" y1="5" x2="14" y2="5" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <label
                for="profile-archetype"
                class="font-mono text-xs uppercase tracking-widest text-tk-ink-3"
                >Device archetype</label
              >
              <select
                id="profile-archetype"
                name="archetype"
                data-archetype-select
                class="mt-1 w-full rounded-md border border-tk-border bg-tk-bg px-3 py-2 text-sm text-tk-ink focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-glow-red"
              >
                {
                  SELECTABLE_ARCHETYPES.map((a) => (
                    <option value={a.id} selected={a.id === LOCKED_ARCHETYPE_ID}>
                      {a.displayLabel}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
          <p class="mt-2 text-xs text-tk-ink-3">
            The iPhone/iOS/Safari fingerprint sessions on this profile emulate.
            More devices roll out here as their fingerprint profiles land.
          </p>
        </div>
        <div>
          <label for="profile-name" class="block text-sm font-medium text-tk-ink-2">Name</label>
          <input
            id="profile-name"
            name="name"
            type="text"
            required
            placeholder="e.g. shopper-account-1, signup-test"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            Unique within your account. Use a name that surfaces purpose ("shopper-acctA",
            "staging-smoke") for easier triage later.
          </p>
        </div>
        <div>
          <label for="profile-description" class="block text-sm font-medium text-tk-ink-2"
            >Description (optional)</label
          >
          <input
            id="profile-description"
            name="description"
            type="text"
            placeholder="Returning-visitor profile for the checkout flow"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm"
          />
        </div>
        {/* 2026-05-24 — default proxy selection. Pulls from saved /v1/proxies;
            empty list collapses to a hint pointing at /proxies. Test button
            will call a server-side reachability + UDP-ASSOCIATE check when
            the endpoint lands; for now opens the proxies page in a new tab. */}
        <div>
          <label for="profile-proxy" class="block text-sm font-medium text-tk-ink-2">
            Default proxy (optional)
          </label>
          <div class="mt-1 flex flex-wrap items-stretch gap-2">
            <select
              id="profile-proxy"
              name="default_proxy_id"
              class="flex-1 min-w-[14rem] rounded-md border border-tk-border bg-tk-surface px-3 py-2 text-sm"
              data-create-proxy-picker
            >
              <option value="">— none (attach per-session) —</option>
            </select>
            <button
              type="button"
              class="rounded-md border border-tk-border bg-tk-surface px-3 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg disabled:opacity-50"
              data-create-proxy-test
              disabled
            >
              Test proxy
            </button>
          </div>
          <p class="mt-1 text-xs text-tk-ink-3" data-create-proxy-hint>
            Saved proxies attach automatically when a session is created against this
            profile. Manage saved configs from <a href="/proxies" class="text-tk-accent underline">/proxies</a>.
          </p>
          <p class="mt-2 hidden text-xs" data-create-proxy-result role="status"></p>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="btn-primary" data-create-submit>Create profile</button>
          <button
            type="button"
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
            data-create-cancel
          >
            Cancel
          </button>
          <span data-create-error class="hidden text-sm text-rose-700"></span>
        </div>
      </form>
    </div>

    {/*
      2026-05-21 — list renders empty SSR; JS hydration fills with real
      data from /v1/profiles. Pre-hydration shows a 3-row skeleton so
      the page has the right vertical footprint without flashing
      scaffolding mock data. Login gate in DashboardLayout means
      unauthenticated visitors never get here; authed visitors see the
      skeleton for the ~100ms it takes /v1/profiles to come back.
    */}
    {/* Client-side name/description filter — paid tiers carry 50–500
        profiles, so scrolling to find one is painful. Hidden until there
        are profiles to filter (toggled in renderProfiles). */}
    <div data-profiles-search-wrap class="mb-4 hidden">
      <input
        type="search"
        data-profiles-search
        placeholder="Search profiles by name…  ( /  to focus)"
        aria-label="Search profiles by name"
        class="w-full rounded-md border border-tk-border bg-tk-bg px-3 py-2 text-sm text-tk-ink placeholder:text-tk-ink-3 focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-glow-red"
      />
    </div>
    <ul
      data-list
      class="divide-y divide-slate-200 rounded-lg border border-tk-border bg-tk-surface"
    >
      {[0, 1, 2].map(() => (
        <li
          data-skeleton="true"
          class="flex items-start justify-between gap-6 px-6 py-4"
          aria-hidden="true"
        >
          <div class="min-w-0 flex-1 space-y-2">
            <div class="h-4 w-40 animate-pulse rounded bg-tk-hover" />
            <div class="h-3 w-60 animate-pulse rounded bg-tk-hover" />
            <div class="h-3 w-32 animate-pulse rounded bg-tk-hover" />
          </div>
          <div class="h-8 w-24 shrink-0 animate-pulse rounded bg-tk-hover" />
        </li>
      ))}
    </ul>

    {/* Shown when a search term matches no profiles (distinct from the
        data-empty "no profiles yet" state, which would be misleading). */}
    <p
      data-no-matches
      class="mt-4 hidden rounded-lg border border-dashed border-tk-border bg-tk-bg px-6 py-8 text-center text-sm text-tk-ink-3"
    >
      No profiles match your search.
    </p>

    <!-- V-284 — empty state matches the V-275 GUI ProfilesView pattern (oxblood icon + body + CTA) -->
    <div
      data-empty
      class:list={[
        'flex flex-col items-center justify-center gap-4 rounded-lg border border-dashed border-tk-border bg-tk-bg px-8 py-16 text-center',
        profileCount === 0 ? '' : 'hidden',
      ]}
    >
      <div class="flex h-12 w-12 items-center justify-center rounded-md bg-tk-accent/10 text-tk-accent">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </div>
      <div class="flex flex-col gap-1">
        <h3 class="text-base font-medium tracking-tight text-tk-ink">No profiles yet</h3>
        <p class="max-w-md text-sm text-tk-ink-2">
          A profile is a persistent identity — cookies, localStorage, IndexedDB — reused across
          sessions. Bind a session to a profile to keep login state, returning-visitor signals, and
          stealth fingerprints stable between runs.
        </p>
      </div>
      <button type="button" class="btn-primary" data-show-create>Create your first profile</button>
      <p class="text-xs text-tk-ink-3">
        Sessions without a profile start ephemeral — fresh state every run.
      </p>
    </div>

    {/* 2026-05-22 — profile-limits section refresh. Was a bare 2-col
        dl; now a tier-card grid with the active tier highlighted +
        a bar showing your current spot in the ladder. The active
        tier is hydrated client-side from /v1/account/me; default
        until then is no highlight. */}
    <section class="mt-12 rounded-xl border border-tk-border bg-tk-surface/40 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">Profile limits</p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight text-tk-ink">Per-tier ceiling</h2>
          <p class="mt-1 max-w-prose text-sm text-tk-ink-3">
            Enforced server-side at session creation. Upgrade if you need more headroom.
          </p>
        </div>
        <a
          href="/select-tier"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-md border border-tk-accent/40 bg-tk-accent/10 px-3 py-1.5 text-sm font-medium text-tk-accent hover:bg-tk-accent/20"
        >
          Compare tiers →
        </a>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          TIER_DISPLAY_ORDER.map((entry) => (
            <div
              data-tier-card={entry.id}
              class="rounded-lg border border-tk-border bg-tk-bg p-4 transition-colors"
            >
              <p class="font-mono text-[10px] uppercase tracking-widest text-tk-ink-3">
                {entry.label}
              </p>
              <p class="mt-2 text-2xl font-semibold text-tk-ink">
                {fmtLimit(PROFILES_PER_TIER[entry.id])}
              </p>
              <p class="text-xs text-tk-ink-3">profiles</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Enterprise tier offers custom per-workload limits —{' '}
        <a href="mailto:sales@driftstack.dev" class="text-tk-accent hover:underline">
          contact sales
        </a>.
      </p>
    </section>
  </div>

  <!--
 — progressive-enhancement script. Live-fetches /v1/profiles +
    /v1/account/me; wires create + delete actions.
  -->
  <script is:inline define:vars={{ apiBaseUrl, archetypeLabels: ARCHETYPE_LABELS, storageCaps: TIER_STORAGE_BYTES_CAP, storageSoftFraction: STORAGE_SOFT_WARN_FRACTION }}>
    (function () {
      const root = document.querySelector('[data-page="profiles"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const formWrap = root.querySelector('[data-create-form-wrap]');
      const form = root.querySelector('[data-create-form]');
      const createSubmit = root.querySelector('[data-create-submit]');
      const createCancel = root.querySelector('[data-create-cancel]');
      const createError = root.querySelector('[data-create-error]');
      const showCreateBtns = root.querySelectorAll('[data-show-create]');
      const token = localStorage.getItem('ds_web_session_token');
      // doc-150 item 6 — live account tier, captured from /v1/account/me on
      // refresh. Drives the storage-quota cap lookup in renderStorageTotal.
      // Null until the first /v1/account/me resolves → the quota bar stays
      // collapsed (we don't guess a cap).
      let currentTier = null;

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }
      // doc-150 item 5/6 — human-readable byte size. null/undefined → "—" (never
      // saved). BINARY units (1024-based, KiB/MiB/GiB) so the quota cap renders
      // the EXACT plan number: TIER_STORAGE_BYTES_CAP is declared in GiB
      // (N * 2**30), so a decimal (1000-based) basis would show "1 GiB" as
      // "1.1 GB" (~7% high) and overstate the customer's allowance. The used
      // bytes go through this same function, so used + cap share one basis and
      // the % / bar stay correct. 1 decimal place above KiB. Negative /
      // non-finite → "—".
      function fmtBytes(n) {
        if (typeof n !== 'number' || !isFinite(n) || n < 0) return '—';
        if (n < 1024) return n + ' B';
        const units = ['KiB', 'MiB', 'GiB', 'TiB'];
        let v = n / 1024;
        let i = 0;
        while (v >= 1024 && i < units.length - 1) {
          v /= 1024;
          i++;
        }
        return v.toFixed(1) + ' ' + units[i];
      }

      // Labels injected from the registry-derived archetypeLabels map (the
      // server's archetypeDisplayLabel() source of truth), so every selectable
      // archetype renders friendly. An unknown/aged-out slug falls back to raw.
      function archetypeLabel(slug) {
        return (archetypeLabels && archetypeLabels[slug]) || slug;
      }

      function organizationChips(p) {
        const tags = Array.isArray(p.tags) ? p.tags : [];
        const folder = typeof p.folder === 'string' && p.folder.length > 0 ? p.folder : null;
        if (!folder && tags.length === 0) return '';
        const chip = (label) =>
          '<span class="rounded-full border border-tk-border bg-tk-bg px-2 py-0.5 text-xs text-tk-ink-2">' +
          escapeHtml(label) +
          '</span>';
        return (
          '<p class="mt-2 flex flex-wrap items-center gap-1.5" data-profile-organization>' +
          (folder ? chip('\uD83D\uDCC1 ' + folder) : '') +
          tags.map(chip).join('') +
          '</p>'
        );
      }

      function profileLi(p) {
        return (
          '<li data-profile-search="' +
          escapeHtml(
            (
              (p.name || '') +
              ' ' +
              (p.description || '') +
              ' ' +
              // Organization metadata (migration 0076) joins the search
              // haystack — find a profile by its folder or a tag.
              (p.folder || '') +
              ' ' +
              (Array.isArray(p.tags) ? p.tags.join(' ') : '')
            ).toLowerCase(),
          ) +
          '" class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-tk-ink">' +
          escapeHtml(p.name) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(p.id) +
          '</p>' +
          (p.description
            ? '<p class="mt-2 text-sm text-tk-ink-2">' + escapeHtml(p.description) + '</p>'
            : '') +
          // Organization chips (read-only here — organizing lives in the
          // GUI hub; a pre-0076 server omits the fields and the row just
          // renders without chips).
          organizationChips(p) +
          '<p class="mt-2 text-xs text-tk-ink-3">Archetype: ' +
          escapeHtml(archetypeLabel(p.archetype)) +
          ' · last used ' +
          escapeHtml(fmtIso(p.last_used_at)) +
          // doc-150 item 5 — per-profile sealed-store size. A pre-save / pre-
          // column profile omits size_bytes → fmtBytes renders "—".
          ' · storage ' +
          escapeHtml(fmtBytes(typeof p.size_bytes === 'number' ? p.size_bytes : null)) +
          '</p></div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          // 2026-05-20 — antidetect-browser-style Launch primary CTA
          // (closes the fa8cb83a profile-launch arc: POST /v1/profiles/
          // :id/launch returns a fresh session_id; the actual browser
          // session lives in the desktop GUI client, so the dashboard
          // mints the session + surfaces it as a session-id reference
          // that the customer opens via `driftstack sessions navigate
          // <id>` or the GUI's Sessions tab).
          '<button type="button" data-launch="' +
          escapeHtml(p.id) +
          '" data-launch-name="' +
          escapeHtml(p.name) +
          '" class="text-sm font-medium text-tk-accent hover:underline">Launch</button>' +
          '<button type="button" data-clone="' +
          escapeHtml(p.id) +
          '" data-clone-name="' +
          escapeHtml(p.name) +
          '" class="text-sm text-tk-accent hover:underline">Clone</button>' +
          '<button type="button" data-export="' +
          escapeHtml(p.id) +
          '" data-export-name="' +
          escapeHtml(p.name) +
          '" class="text-sm text-tk-accent hover:underline">Export</button>' +
          // 2026-05-22 — V-666 transfer-to-account. Recipient pastes
          // their account_id from /settings; this profile moves to
          // them (delete from source on success).
          '<button type="button" data-transfer="' +
          escapeHtml(p.id) +
          '" data-transfer-name="' +
          escapeHtml(p.name) +
          '" class="text-sm text-tk-accent hover:underline">Transfer</button>' +
          '<button type="button" data-snapshot="' +
          escapeHtml(p.id) +
          '" data-snapshot-name="' +
          escapeHtml(p.name) +
          '" class="text-sm text-tk-accent hover:underline">Snapshot</button>' +
          '<button type="button" data-delete="' +
          escapeHtml(p.id) +
          '" data-delete-name="' +
          escapeHtml(p.name) +
          '" class="text-sm text-rose-700 hover:underline">Delete</button>' +
          '</div></li>'
        );
      }

      function authedFetch(path, init) {
        return fetch(apiBaseUrl + path, {
          ...(init || {}),
          headers: {
            ...((init && init.headers) || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — propagate the active "act as" team-owner
            // selection so reads + writes scope to the chosen owner.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        });
      }

      // doc-150 item 6 — fetch the account's ENTIRE profile set by walking the
      // cursor (`/v1/profiles` paginates at 50/default, 100/max). The storage
      // meter sums size_bytes across ALL profiles, so a first-page-only fetch
      // understated the used-bytes + the quota %/bar for accounts with >50
      // profiles. We page at the 100 max to minimise round-trips, and cap the
      // walk defensively so a server `has_more` that never clears can't loop
      // forever (1000 pages × 100 = 100k profiles — far beyond any real tier).
      function fetchAllProfiles() {
        const all = [];
        function page(cursor) {
          const qs = '?limit=100' + (cursor ? '&cursor=' + encodeURIComponent(cursor) : '');
          return authedFetch('/v1/profiles' + qs)
            .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
            .then((body) => {
              const data = (body && body.data) || [];
              for (let i = 0; i < data.length; i++) all.push(data[i]);
              if (body && body.has_more && body.next_cursor && all.length < 100000) {
                return page(body.next_cursor);
              }
              return all;
            });
        }
        return page(null);
      }

      function refresh() {
        if (!token) return;
        const profilesP = fetchAllProfiles();
        const meP = authedFetch('/v1/account/me')
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .catch(() => null);
        return Promise.all([profilesP, meP])
          .then(([profiles, me]) => {
            // doc-150 item 6 — capture the live tier BEFORE renderProfiles so
            // renderStorageTotal (called inside it) can resolve the storage cap.
            if (me && me.tier) currentTier = me.tier;
            renderProfiles(profiles);
            if (me) {
              renderUsage(me, profiles.length);
              // 2026-05-22 — highlight the customer's current tier card
              // in the per-tier ceiling grid. Adds the glow-red accent;
              // every other card stays neutral so the active tier
              // jumps out visually.
              if (me.tier) {
                const card = root.querySelector(
                  '[data-tier-card="' + me.tier + '"]',
                );
                if (card instanceof HTMLElement) {
                  card.classList.remove('border-tk-border', 'bg-tk-bg');
                  card.classList.add(
                    'border-tk-accent/50',
                    'bg-tk-accent/5',
                    'ring-1',
                    'ring-tk-accent/30',
                  );
                  const label = card.querySelector('p:first-child');
                  if (label) label.textContent += ' · current';
                }
              }
            }
            hideBanner();
          })
          .catch((err) => {
            showBanner(
              "Couldn't load profiles (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          })
          .finally(function () {
            // 2026-05-21 — signal the layout's opacity-gate that the
            // primary fetch resolved. Skeleton <li>s are already
            // swapped at this point (success path) or the banner
            // explains the failure (catch path); either way reveal.
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      // Client-side profile filter (matches name + description). Hides
      // non-matching rendered rows + shows the data-no-matches state when a
      // non-empty search matches nothing. Re-applied after every render so
      // it survives the create / clone / delete refreshes.
      function applyProfilesSearch() {
        const input = root.querySelector('[data-profiles-search]');
        const noMatches = root.querySelector('[data-no-matches]');
        const q = input && input.value ? input.value.trim().toLowerCase() : '';
        const rows = list.querySelectorAll('li[data-profile-search]');
        if (rows.length === 0) return;
        let visible = 0;
        rows.forEach(function (li) {
          const show =
            q === '' || (li.getAttribute('data-profile-search') || '').indexOf(q) !== -1;
          li.classList.toggle('hidden', !show);
          if (show) visible++;
        });
        const noMatch = q !== '' && visible === 0;
        list.classList.toggle('hidden', noMatch);
        if (noMatches) noMatches.classList.toggle('hidden', !noMatch);
      }

      const profilesSearchInput = root.querySelector('[data-profiles-search]');
      if (profilesSearchInput) {
        profilesSearchInput.addEventListener('input', applyProfilesSearch);
      }

      // "/" focuses the profile search (GitHub / Slack / Linear / admin
      // accounts convention — same handler as accounts.astro). Skips when
      // already typing in a field, and no-ops while the search is hidden
      // (the wrap is hidden until at least one profile exists).
      document.addEventListener('keydown', (ev) => {
        if (ev.key !== '/' || ev.metaKey || ev.ctrlKey || ev.altKey) return;
        const target = ev.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
        if (target instanceof HTMLElement && target.isContentEditable) return;
        const searchWrap = root.querySelector('[data-profiles-search-wrap]');
        if (!searchWrap || searchWrap.classList.contains('hidden')) return;
        if (profilesSearchInput instanceof HTMLInputElement) {
          ev.preventDefault();
          profilesSearchInput.focus();
          profilesSearchInput.select();
        }
      });

      // doc-150 item 5 — account storage total = sum of every profile's
      // size_bytes (non-numeric / pre-save profiles contribute 0). item 6 —
      // per-account QUOTA: used / tier-cap %, a soft warn at >=80%, and an
      // over-cap state. The cap comes from the live tier (storageCaps map,
      // injected from TIER_STORAGE_BYTES_CAP); compute-on-read mirrors the
      // server's computeAccountStorageState. The whole block stays hidden when
      // there are no profiles, and the bar/cap stay collapsed until the live
      // tier is known (currentTier null → no cap to compare against).
      function renderStorageTotal(profiles) {
        const storageLine = root.querySelector('[data-field="storage-line"]');
        const storageTotal = root.querySelector('[data-field="storage-total"]');
        const storageCapEl = root.querySelector('[data-field="storage-cap"]');
        const storagePct = root.querySelector('[data-field="storage-pct"]');
        const storageWarn = root.querySelector('[data-field="storage-warn"]');
        const storageBar = root.querySelector('[data-field="storage-bar"]');
        if (!storageLine || !storageTotal) return;
        if (!Array.isArray(profiles) || profiles.length === 0) {
          storageLine.classList.add('hidden');
          return;
        }
        const total = profiles.reduce(
          (sum, p) => sum + (typeof p.size_bytes === 'number' && p.size_bytes > 0 ? p.size_bytes : 0),
          0,
        );
        storageTotal.textContent = fmtBytes(total);

        // Quota: only renders the cap leg once the live tier is known. Enterprise
        // is soft-only (server never hard-blocks it), so its over-cap state reads
        // as a warning, not a stop.
        const cap =
          currentTier && storageCaps && typeof storageCaps[currentTier] === 'number'
            ? storageCaps[currentTier]
            : null;
        const isEnterprise = currentTier === 'enterprise';
        if (cap && cap > 0) {
          const fraction = total / cap;
          const pct = Math.round(fraction * 100);
          if (storageCapEl) storageCapEl.textContent = fmtBytes(cap);
          if (storagePct) storagePct.textContent = ' (' + pct + '%)';
          if (storageBar) {
            // Bar width clamps at 100% even when over-cap (the warn label carries
            // the overage); color shifts to rose at the soft threshold + over-cap.
            storageBar.style.width = Math.min(100, pct) + '%';
            storageBar.classList.remove('bg-tk-accent', 'bg-amber-500', 'bg-rose-600');
            if (fraction >= 1) storageBar.classList.add('bg-rose-600');
            else if (fraction >= storageSoftFraction) storageBar.classList.add('bg-amber-500');
            else storageBar.classList.add('bg-tk-accent');
          }
          if (storageWarn) {
            if (fraction >= 1) {
              storageWarn.textContent = isEnterprise
                ? ' · over your plan allowance — contact sales to raise it'
                : ' · storage limit reached — delete a profile or upgrade to launch new profile sessions';
              storageWarn.className = 'font-medium text-rose-700';
              storageWarn.classList.remove('hidden');
            } else if (fraction >= storageSoftFraction) {
              storageWarn.textContent = ' · approaching your storage limit';
              storageWarn.className = 'font-medium text-amber-700';
              storageWarn.classList.remove('hidden');
            } else {
              storageWarn.classList.add('hidden');
              storageWarn.textContent = '';
            }
          }
        } else {
          // Tier/cap not yet known — show the total without the quota leg.
          if (storageCapEl) storageCapEl.textContent = '—';
          if (storagePct) storagePct.textContent = '';
          if (storageWarn) {
            storageWarn.classList.add('hidden');
            storageWarn.textContent = '';
          }
          if (storageBar) storageBar.style.width = '0%';
        }
        storageLine.classList.remove('hidden');
      }

      function renderProfiles(profiles) {
        const searchWrap = root.querySelector('[data-profiles-search-wrap]');
        renderStorageTotal(profiles);
        if (profiles.length === 0) {
          list.classList.add('hidden');
          empty.classList.remove('hidden');
          if (searchWrap) searchWrap.classList.add('hidden');
        } else {
          empty.classList.add('hidden');
          list.classList.remove('hidden');
          list.innerHTML = profiles.map(profileLi).join('');
          wireDeleteButtons();
          wireCloneButtons();
          wireSnapshotButtons();
          wireExportButtons();
          wireTransferButtons();
          wireLaunchButtons();
          if (searchWrap) searchWrap.classList.remove('hidden');
          applyProfilesSearch();
        }
      }

      // V-480 — Export button: GETs the envelope, triggers a JSON
      // download via Blob + a synthetic anchor click. No server-side
      // attachment headers needed; the dashboard owns the file naming.
      function wireExportButtons() {
        const buttons = list.querySelectorAll('[data-export]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-export');
            const name = btn.getAttribute('data-export-name') || 'profile';
            if (!id) return;
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = 'Exporting…';
            authedFetch('/v1/profiles/' + encodeURIComponent(id) + '/export')
              .then((r) =>
                r.ok
                  ? r.json()
                  : r
                      .json()
                      .catch(() => ({}))
                      .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
              )
              .then((envelope) => {
                const text = JSON.stringify(envelope, null, 2);
                const blob = new Blob([text], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                const safeName = name.replace(/[^a-zA-Z0-9_.-]/g, '_');
                a.download = 'driftstack-profile-' + safeName + '.json';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showBanner('Exported "' + name + '".');
              })
              .catch((err) => {
                showBanner(
                  'Export failed: ' + (err && err.message ? err.message : 'network error'),
                );
              })
              .finally(() => {
                btn.disabled = false;
                btn.textContent = original;
              });
          });
        });
      }

      // 2026-05-22 — V-666 transfer-to-account. Confirms with the
      // operator (transfer is destructive on source) + prompts for
      // recipient account id + POSTs the new endpoint.
      function wireTransferButtons() {
        const buttons = list.querySelectorAll('[data-transfer]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-transfer');
            const name = btn.getAttribute('data-transfer-name') || 'profile';
            if (!id) return;
            const recipientRaw = await window.driftstackPrompt(
              'Transfer "' +
                name +
                '" to another Driftstack account.\n\n' +
                "Paste the recipient's account id (they can copy it from /settings).\n" +
                'Format: acc_<uuid>',
              { placeholder: 'acc_<uuid>', confirmLabel: 'Continue' },
            );
            if (!recipientRaw) return;
            const recipient = recipientRaw.trim();
            if (!/^acc_[0-9a-f-]{36}$/.test(recipient)) {
              showBanner('Recipient id must be in the form acc_<uuid>.');
              return;
            }
            const proceed = await window.driftstackConfirm(
              'This will move "' +
                name +
                '" to ' +
                recipient +
                '.\n\n' +
                'The profile will be removed from YOUR account and counts toward the ' +
                "recipient's tier limit + monthly import quota. Continue?",
              { confirmLabel: 'Transfer' },
            );
            if (!proceed) {
              return;
            }
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = 'Transferring…';
            authedFetch('/v1/profiles/' + encodeURIComponent(id) + '/transfer', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ recipient_account_id: recipient }),
            })
              .then((r) =>
                r.ok
                  ? r.json()
                  : r
                      .json()
                      .catch(() => ({}))
                      .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
              )
              .then(() => {
                showBanner('Transferred "' + name + '" to ' + recipient + '.');
                if (typeof load === 'function') load();
              })
              .catch((err) => {
                showBanner(
                  'Transfer failed: ' + (err && err.message ? err.message : 'network error'),
                );
              })
              .finally(() => {
                btn.disabled = false;
                btn.textContent = original;
              });
          });
        });
      }

      function renderUsage(me, count) {
        const tierLine = root.querySelector('[data-field="tier-line"]');
        const countEl = root.querySelector('[data-field="count"]');
        const limitEl = root.querySelector('[data-field="limit"]');
        const usageLine = root.querySelector('[data-field="usage-line"]');
        if (tierLine) tierLine.textContent = (me.tier || '—') + ' tier';
        if (countEl) countEl.textContent = String(count);
        const cap = me.profile_cap;
        if (limitEl) {
          limitEl.textContent = cap === null || cap === undefined ? 'Custom' : String(cap);
        }
        if (usageLine && cap !== null && cap !== undefined && count >= cap) {
          if (!usageLine.querySelector('[data-cap-flag]')) {
            const span = document.createElement('span');
            span.setAttribute('data-cap-flag', '');
            span.className = 'text-red-700';
            span.textContent = ' · tier limit reached';
            usageLine.appendChild(span);
          }
        }
      }

      // V-470 — snapshot capture flow now uses an inline form instead
      // of window.prompt. The form is shared across all profile rows;
      // a single state variable tracks which profile is being captured.
      const snapshotFormWrap = root.querySelector('[data-snapshot-form-wrap]');
      const snapshotForm = root.querySelector('[data-snapshot-form]');
      const snapshotLabelInput = root.querySelector('[data-snapshot-label-input]');
      const snapshotDescInput = root.querySelector('[data-snapshot-description-input]');
      const snapshotSourceName = root.querySelector('[data-snapshot-source-name]');
      const snapshotError = root.querySelector('[data-snapshot-error]');
      const snapshotSubmit = root.querySelector('[data-snapshot-submit]');
      const snapshotCancel = root.querySelector('[data-snapshot-cancel]');
      let snapshotPending = null; // { id, name } | null

      function showSnapshotForm(id, name) {
        snapshotPending = { id: id, name: name };
        if (snapshotSourceName) snapshotSourceName.textContent = name;
        if (snapshotLabelInput) {
          snapshotLabelInput.value = '';
          snapshotLabelInput.focus();
        }
        if (snapshotDescInput) snapshotDescInput.value = '';
        if (snapshotError) {
          snapshotError.classList.add('hidden');
          snapshotError.textContent = '';
        }
        if (snapshotFormWrap) snapshotFormWrap.classList.remove('hidden');
        if (formWrap) formWrap.classList.add('hidden');
      }
      function hideSnapshotForm() {
        snapshotPending = null;
        if (snapshotFormWrap) snapshotFormWrap.classList.add('hidden');
      }
      if (snapshotCancel) snapshotCancel.addEventListener('click', hideSnapshotForm);
      if (snapshotForm) {
        snapshotForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!snapshotPending || !snapshotLabelInput) return;
          const label = snapshotLabelInput.value.trim();
          const description = snapshotDescInput
            ? snapshotDescInput.value.trim()
            : '';
          if (!label) {
            if (snapshotError) {
              snapshotError.textContent = 'Label is required.';
              snapshotError.classList.remove('hidden');
            }
            return;
          }
          if (snapshotError) {
            snapshotError.classList.add('hidden');
            snapshotError.textContent = '';
          }
          if (snapshotSubmit) {
            snapshotSubmit.disabled = true;
            snapshotSubmit.textContent = 'Capturing…';
          }
          const payload = { label: label };
          if (description) payload.description = description;
          const pendingId = snapshotPending.id;
          authedFetch('/v1/profiles/' + encodeURIComponent(pendingId) + '/snapshots', {
            method: 'POST',
            body: JSON.stringify(payload),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              hideSnapshotForm();
              showBanner('Snapshot captured: ' + (body.label || '(no label)'));
            })
            .catch((err) => {
              if (snapshotError) {
                snapshotError.textContent =
                  err && err.message ? err.message : 'Snapshot failed.';
                snapshotError.classList.remove('hidden');
              }
            })
            .finally(() => {
              if (snapshotSubmit) {
                snapshotSubmit.disabled = false;
                snapshotSubmit.textContent = 'Capture snapshot';
              }
            });
        });
      }

      // V-312 — snapshot-button wiring. Opens the inline form;
      // form-submit POSTs /v1/profiles/:id/snapshots.
      function wireSnapshotButtons() {
        const buttons = list.querySelectorAll('[data-snapshot]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-snapshot');
            const name = btn.getAttribute('data-snapshot-name') || '(unnamed)';
            if (!id) return;
            showSnapshotForm(id, name);
          });
        });
      }

      // V-313 — clone-button wiring. POSTs /v1/profiles/:id/clone with
      // an empty body; server auto-derives "${source} (copy)" / (copy 2)
      // / ... naming.
      function wireCloneButtons() {
        const buttons = list.querySelectorAll('[data-clone]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-clone');
            const name = btn.getAttribute('data-clone-name') || '(unnamed)';
            if (!(await window.driftstackConfirm('Clone profile "' + name + '"?', { confirmLabel: 'Clone' })))
              return;
            btn.disabled = true;
            btn.textContent = 'Cloning…';
            authedFetch('/v1/profiles/' + encodeURIComponent(id) + '/clone', {
              method: 'POST',
              body: JSON.stringify({}),
            })
              .then((r) =>
                r.ok
                  ? r.json()
                  : r
                      .json()
                      .catch(() => ({}))
                      .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
              )
              .then((body) => {
                showBanner('Cloned to "' + (body.name || 'new profile') + '".');
                return refresh();
              })
              .catch((err) => {
                showBanner('Clone failed: ' + (err && err.message ? err.message : 'network'));
                btn.disabled = false;
                btn.textContent = 'Clone';
              });
          });
        });
      }

      // 2026-05-20 — POST /v1/profiles/:id/launch wires the antidetect-
      // browser one-shot launch (fa8cb83a): server inherits the
      // archetype + stamps {profile_id, profile_name} in session
      // metadata + bumps last_used_at fire-and-forget. Returns the
      // fresh session_id; the actual browser is the desktop GUI client.
      function wireLaunchButtons() {
        const buttons = list.querySelectorAll('[data-launch]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-launch');
            const name = btn.getAttribute('data-launch-name') || '(unnamed)';
            btn.disabled = true;
            btn.textContent = 'Launching…';
            authedFetch('/v1/profiles/' + encodeURIComponent(id) + '/launch', {
              method: 'POST',
              body: JSON.stringify({}),
            })
              .then((r) =>
                r.ok
                  ? r.json()
                  : r
                      .json()
                      .catch(() => ({}))
                      .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
              )
              .then((body) => {
                // 2026-05-20 — surface a clickable driftstack://session/
                // open?session_id=<id> deep-link so the customer's
                // desktop client (Tauri) handles the handoff in one
                // click. The desktop's V-328 deep-link plugin already
                // registers the scheme + dispatches via dispatchDeepLink
                // (lib/deep-link.ts:'session-open' kind). If the
                // customer hasn't installed the GUI, the OS surfaces
                // its own "no app handles this URL" prompt — same UX
                // any custom-scheme link gets. Banner uses innerHTML
                // (not textContent) for this branch only; name +
                // sessionId are escapeHtml'd; the deep-link host is
                // hard-coded so XSS is bounded.
                const sessionId = body.id || '';
                if (banner && sessionId.length > 0) {
                  const deepLink =
                    'driftstack://session/open?session_id=' + encodeURIComponent(sessionId);
                  banner.innerHTML =
                    'Launched "' +
                    escapeHtml(name) +
                    '" → session ' +
                    escapeHtml(sessionId) +
                    '. <a href="' +
                    escapeHtml(deepLink) +
                    '" class="font-medium text-tk-accent underline">Open in desktop client</a>.';
                  banner.classList.remove('hidden');
                } else {
                  showBanner('Launched "' + name + '" → session ' + (sessionId || '(?)') + '.');
                }
                btn.disabled = false;
                btn.textContent = 'Launch';
                return refresh();
              })
              .catch((err) => {
                showBanner('Launch failed: ' + (err && err.message ? err.message : 'network'));
                btn.disabled = false;
                btn.textContent = 'Launch';
              });
          });
        });
      }

      function wireDeleteButtons() {
        const buttons = list.querySelectorAll('[data-delete]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-delete');
            const name = btn.getAttribute('data-delete-name') || '(unnamed)';
            const ok = await window.driftstackConfirm(
              'Delete profile "' +
                name +
                '"? It moves to the recycle bin — you can restore it within 30 days, after which it is permanently purged. Sessions currently using this profile will fail until you restore it.',
              { confirmLabel: 'Delete' },
            );
            if (!ok) return;
            btn.disabled = true;
            btn.textContent = 'Deleting…';
            authedFetch('/v1/profiles/' + encodeURIComponent(id), { method: 'DELETE' })
              .then((r) => {
                if (!r.ok && r.status !== 204) {
                  return r
                    .json()
                    .catch(() => ({}))
                    .then((b) =>
                      Promise.reject(new Error(b.detail || 'HTTP ' + r.status)),
                    );
                }
                return refresh();
              })
              .catch((err) => {
                showBanner(
                  'Delete failed: ' + (err && err.message ? err.message : 'network error'),
                );
                btn.disabled = false;
                btn.textContent = 'Delete';
              });
          });
        });
      }

      function showCreate() {
        if (!token) {
          showBanner('Sign in to create profiles.');
          return;
        }
        formWrap.classList.remove('hidden');
        const nameInput = form.querySelector('input[name="name"]');
        if (nameInput) nameInput.focus();
        // 2026-05-24 — hydrate the proxy picker from /v1/proxies on open.
        hydrateProxyPicker();
      }

      // Proxy-picker hydration + test-button wiring for the create-profile
      // form. Pulls the customer's saved configs from the LIVE account-proxies
      // API (/v1/account/me/proxies) — the same source the /proxies page and
      // the desktop app use. Falls back gracefully (leaves "none") on error.
      const proxyPicker = root.querySelector('[data-create-proxy-picker]');
      const proxyTestBtn = root.querySelector('[data-create-proxy-test]');
      const proxyResult = root.querySelector('[data-create-proxy-result]');
      const proxyHint = root.querySelector('[data-create-proxy-hint]');
      let proxyPickerHydrated = false;
      async function hydrateProxyPicker() {
        if (proxyPickerHydrated || !proxyPicker) return;
        try {
          const res = await fetch(apiBaseUrl + '/v1/account/me/proxies', {
            headers: { authorization: 'Bearer ' + token },
          });
          if (!res.ok) {
            // Unauthed / error → leave the "none" option.
            return;
          }
          const body = await res.json();
          const items = Array.isArray(body) ? body : body.data || [];
          if (items.length === 0) {
            if (proxyHint) {
              proxyHint.innerHTML =
                'No saved proxies yet. <a href="/proxies" class="text-tk-accent underline">Add a SOCKS5 / OpenVPN / WireGuard config →</a>';
            }
            return;
          }
          for (const p of items) {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.textContent =
              (p.label || p.id) +
              (p.scheme ? ' · ' + p.scheme : '') +
              (p.host ? ' · ' + p.host + ':' + p.port : '');
            proxyPicker.appendChild(opt);
          }
          proxyPickerHydrated = true;
        } catch (_err) {
          // Network error — silent; UX falls back to "none" option.
        }
      }
      if (proxyPicker) {
        proxyPicker.addEventListener('change', function () {
          if (proxyTestBtn) proxyTestBtn.disabled = proxyPicker.value === '';
          if (proxyResult) {
            proxyResult.classList.add('hidden');
            proxyResult.textContent = '';
          }
        });
      }
      if (proxyTestBtn) {
        proxyTestBtn.addEventListener('click', async function () {
          if (!proxyPicker || proxyPicker.value === '' || !proxyResult) return;
          proxyTestBtn.disabled = true;
          proxyResult.classList.remove('hidden');
          proxyResult.className = 'mt-2 text-xs text-tk-ink-3';
          proxyResult.textContent = 'Testing reachability…';
          // POST /v1/account/me/proxies/:id/test — server-side TCP-reachability
          // probe (SSRF-guarded). 200 with { ok, latency_ms } on success, or
          // { ok:false, reason } when the proxy is unreachable.
          try {
            const res = await fetch(
              apiBaseUrl +
                '/v1/account/me/proxies/' +
                encodeURIComponent(proxyPicker.value) +
                '/test',
              { method: 'POST', headers: { authorization: 'Bearer ' + token } },
            );
            const body = await res.json().catch(() => ({}));
            if (res.ok && body.ok) {
              proxyResult.className = 'mt-2 text-xs text-emerald-300';
              proxyResult.textContent =
                'Reachable' +
                (typeof body.latency_ms === 'number' ? ' · ' + body.latency_ms + 'ms' : '');
            } else {
              proxyResult.className = 'mt-2 text-xs text-tk-ink-3';
              proxyResult.textContent =
                'Unreachable' +
                (body.reason ? ' · ' + body.reason : body.detail ? ' · ' + body.detail : '');
            }
          } catch (_e) {
            proxyResult.className = 'mt-2 text-xs text-tk-accent-soft';
            proxyResult.textContent = 'Could not reach the test endpoint. Try again.';
          } finally {
            proxyTestBtn.disabled = false;
          }
        });
      }
      function hideCreate() {
        formWrap.classList.add('hidden');
        createError.classList.add('hidden');
        createError.textContent = '';
        form.reset();
      }

      showCreateBtns.forEach((btn) => btn.addEventListener('click', showCreate));
      createCancel.addEventListener('click', hideCreate);

      // V-480 — Import flow wiring.
      const importFormWrap = root.querySelector('[data-import-form-wrap]');
      const importForm = root.querySelector('[data-import-form]');
      const importFileInput = root.querySelector('[data-import-file-input]');
      const importTextInput = root.querySelector('[data-import-text-input]');
      const importNameOverrideInput = root.querySelector('[data-import-name-override-input]');
      const importError = root.querySelector('[data-import-error]');
      const importSubmit = root.querySelector('[data-import-submit]');
      const importCancel = root.querySelector('[data-import-cancel]');
      const showImportBtn = root.querySelector('[data-show-import]');

      function showImport() {
        if (!token) {
          showBanner('Sign in to import profiles.');
          return;
        }
        if (importFormWrap) importFormWrap.classList.remove('hidden');
        if (formWrap) formWrap.classList.add('hidden');
        if (importTextInput) importTextInput.focus();
      }
      function hideImport() {
        if (importFormWrap) importFormWrap.classList.add('hidden');
        if (importError) {
          importError.classList.add('hidden');
          importError.textContent = '';
        }
        if (importForm) importForm.reset();
      }
      function showImportError(msg) {
        if (!importError) return;
        importError.textContent = msg;
        importError.classList.remove('hidden');
      }

      if (showImportBtn) showImportBtn.addEventListener('click', showImport);
      if (importCancel) importCancel.addEventListener('click', hideImport);

      // File input populates the textarea; either source is acceptable.
      if (importFileInput) {
        importFileInput.addEventListener('change', (ev) => {
          const target = ev.target;
          if (!(target instanceof HTMLInputElement)) return;
          const file = target.files && target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = () => {
            if (importTextInput && typeof reader.result === 'string') {
              importTextInput.value = reader.result;
            }
          };
          reader.onerror = () => showImportError('Failed to read file.');
          reader.readAsText(file);
        });
      }

      if (importForm) {
        importForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (importError) {
            importError.classList.add('hidden');
            importError.textContent = '';
          }
          const text = importTextInput ? importTextInput.value.trim() : '';
          if (!text) {
            showImportError('Paste an envelope JSON or upload a .json file.');
            return;
          }
          let envelope;
          try {
            envelope = JSON.parse(text);
          } catch (e) {
            showImportError('Could not parse JSON: ' + (e && e.message ? e.message : ''));
            return;
          }
          const nameOverride =
            importNameOverrideInput && importNameOverrideInput.value.trim().length > 0
              ? importNameOverrideInput.value.trim()
              : undefined;
          const payload = { envelope: envelope };
          if (nameOverride !== undefined) payload.name_override = nameOverride;
          if (importSubmit) {
            importSubmit.disabled = true;
            importSubmit.textContent = 'Importing…';
          }
          authedFetch('/v1/profiles/import', {
            method: 'POST',
            body: JSON.stringify(payload),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              hideImport();
              showBanner('Imported as "' + (body.name || 'new profile') + '".');
              return refresh();
            })
            .catch((err) => {
              showImportError(err && err.message ? err.message : 'Import failed.');
            })
            .finally(() => {
              if (importSubmit) {
                importSubmit.disabled = false;
                importSubmit.textContent = 'Import';
              }
            });
        });
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        createError.classList.add('hidden');
        createError.textContent = '';
        const fd = new FormData(form);
        const name = (fd.get('name') || '').toString().trim();
        const description = (fd.get('description') || '').toString().trim();
        const archetype = (fd.get('archetype') || '').toString().trim();
        const defaultProxyId = (fd.get('default_proxy_id') || '').toString().trim();
        if (!name) return;
        const payload = { name: name };
        if (description) payload.description = description;
        if (archetype) payload.archetype = archetype;
        // 2026-05-24 — forward-compat: include the chosen default proxy so it
        // persists server-side once the saved-proxy storage + profile
        // default-proxy field land (EG-API-1.6). The server currently strips
        // unknown keys, so this is a harmless no-op until then; we ALSO stash
        // the choice in localStorage (below) so the selection isn't lost.
        if (defaultProxyId) payload.default_proxy_id = defaultProxyId;
        createSubmit.disabled = true;
        createSubmit.textContent = 'Creating…';
        authedFetch('/v1/profiles', {
          method: 'POST',
          body: JSON.stringify(payload),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) =>
                    Promise.reject(new Error(b.detail || 'HTTP ' + r.status)),
                  ),
          )
          .then((created) => {
            // Persist the default-proxy choice client-side keyed by the new
            // profile id, mirroring the GUI's profile-bindings pattern, so
            // the selection survives until server-side persistence lands.
            if (defaultProxyId && created && created.id) {
              try {
                localStorage.setItem(
                  'ds_profile_default_proxy_' + created.id,
                  defaultProxyId,
                );
              } catch (_e) {
                /* storage unavailable — non-fatal */
              }
            }
            hideCreate();
            return refresh();
          })
          .catch((err) => {
            createError.textContent = err && err.message ? err.message : 'Create failed.';
            createError.classList.remove('hidden');
          })
          .finally(() => {
            createSubmit.disabled = false;
            createSubmit.textContent = 'Create profile';
          });
      });

      if (!token) {
        showBanner('Sign in to see live profiles. Showing preview data below.');
        return;
      }

      void refresh();
    })();
  </script>
</DashboardLayout>
