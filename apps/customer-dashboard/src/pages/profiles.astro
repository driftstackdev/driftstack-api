---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_PROFILES, MOCK_USAGE_SUMMARY } from '../data/mocks.ts';
import {
  PROFILES_PER_TIER,
  archetypeDisplayLabel,
  type AccountTier,
} from '@driftstack/api-types';

// V-136 — uses the locked PROFILES_PER_TIER constant from
// @driftstack/api-types as single source of truth (no more hardcoded
// `profileLimit = 100`). The customer-facing display also passes
// archetype ids through `archetypeDisplayLabel` so customers see
// "iPhone 16 Pro / iOS 18.7 / Safari 26.4" rather than the raw
// `iphone16pro_ios18_7_safari26_4` identifier.

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().slice(0, 10);
}

const tier: AccountTier = MOCK_USAGE_SUMMARY.tier;
const profileLimit = PROFILES_PER_TIER[tier];
const profileCount = MOCK_PROFILES.length;
const atLimit =
  profileLimit !== 'custom' && profileCount >= profileLimit;
const limitDisplay = profileLimit === 'custom' ? 'Custom' : profileLimit.toString();

// Surface the full per-tier limit table in the footer. Order matches
// AccountTierSchema declaration order so customers see Manual ladder
// first then API ladder then Enterprise.
const TIER_DISPLAY_ORDER: ReadonlyArray<{ id: AccountTier; label: string }> = [
  { id: 'solo_manual', label: 'Solo Manual' },
  { id: 'team_manual', label: 'Team Manual' },
  { id: 'agency_manual', label: 'Agency Manual' },
  { id: 'api_starter', label: 'API Starter' },
  { id: 'api_builder', label: 'API Builder' },
  { id: 'api_scale', label: 'API Scale' },
  { id: 'enterprise', label: 'Enterprise' },
];

function fmtLimit(value: number | 'custom'): string {
  return value === 'custom' ? 'custom' : `${value.toString()} profiles`;
}
---

<DashboardLayout title="Profiles">
  <div class="mx-auto max-w-5xl px-6 py-10">
    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-slate-500">{MOCK_USAGE_SUMMARY.tier} tier</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Profiles</h1>
        <p class="mt-2 max-w-prose text-sm text-slate-500">
          Persistent identity slots that survive across sessions. Each profile
          carries its own cookies, localStorage, and lastUsedAt timestamp.
          Sessions can be created against a profile or anonymously.
        </p>
      </div>
      <a
        href="#"
        class:list={['btn-primary shrink-0', atLimit && 'pointer-events-none opacity-50']}
        aria-disabled={atLimit ? 'true' : undefined}
      >
        New profile
      </a>
    </header>

    <p class="mb-6 text-sm text-slate-500">
      <strong class="font-medium text-slate-900">{profileCount}</strong> of
      <strong class="font-medium text-slate-900">{limitDisplay}</strong>
      profile slots used.
      {atLimit && <span class="text-red-700"> · tier limit reached</span>}
    </p>

    {
      profileCount === 0 ? (
        <div class="dashboard-card text-center">
          <h2 class="text-lg font-semibold text-slate-900">No profiles yet</h2>
          <p class="mx-auto mt-2 max-w-prose text-sm text-slate-500">
            Profiles let you persist cookies + localStorage across sessions for
            recurring workloads. Create one now — sessions can attach to a
            profile or run anonymously.
          </p>
          <a href="#" class="btn-primary mt-6 inline-flex">
            Create your first profile
          </a>
        </div>
      ) : (
        <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
          {MOCK_PROFILES.map((profile) => (
            <li class="flex items-start justify-between gap-6 px-6 py-4">
              <div class="min-w-0">
                <p class="text-base font-medium text-slate-900">{profile.name}</p>
                <p class="mt-1 font-mono text-xs text-slate-500">{profile.id}</p>
                {profile.description && (
                  <p class="mt-2 text-sm text-slate-600">{profile.description}</p>
                )}
                <p class="mt-2 text-xs text-slate-500">
                  Archetype: {archetypeDisplayLabel(profile.archetype)} · last used{' '}
                  {fmtIso(profile.last_used_at)}
                </p>
              </div>
              <div class="flex shrink-0 flex-col items-end gap-2">
                <a href={`#edit-${profile.id}`} class="text-sm text-oxblood-700 hover:underline">
                  Edit
                </a>
                <a href={`#delete-${profile.id}`} class="text-sm text-red-700 hover:underline">
                  Delete
                </a>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <section class="mt-10">
      <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">
        Profile limits
      </p>
      <p class="mt-2 max-w-prose text-sm text-slate-500">
        Enforced server-side at session creation. If your workload needs more,
        upgrade your tier:
      </p>
      <dl class="mt-4 grid gap-x-8 gap-y-2 text-sm md:grid-cols-2">
        {
          TIER_DISPLAY_ORDER.map((entry) => (
            <div class="flex justify-between border-b border-slate-100 pb-2">
              <dt class="text-slate-600">{entry.label}</dt>
              <dd class="font-mono text-slate-900">
                {fmtLimit(PROFILES_PER_TIER[entry.id])}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</DashboardLayout>
