---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { resolveApiBaseUrl } from '../../lib/api-base-url';

// AI-B4 — recipe detail view. Consumes GET /v1/recipes/:id (the full
// recipe incl. the replayable intent_log) — the endpoint shipped with
// the server + all 3 SDKs + docs but had no dashboard consumer; the
// /recipes list rows link here so a customer can inspect a recipe's
// intent steps before keeping or deleting it. Read + delete only —
// recipe EXECUTION stays gated on the harness executor, so there is no
// run/replay control.
//
// SSR (prerender=false): the recipe id is a runtime path param. The
// inline script reads ds_web_session_token, fetches the recipe, and
// paints one [data-state] section (loading → loaded / not-found /
// error / needs-signin).

export const prerender = false;
const { id } = Astro.params;
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Recipe">
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-10" data-page="recipe-detail">
      <div class="mb-6">
        <a href="/recipes" class="text-sm text-ink-muted hover:text-glow-red hover:underline"
          >← Recipes</a
        >
      </div>

      <div
        data-banner
        class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
        role="status"
      >
      </div>

      {/* Loading — visible on first paint until the fetch resolves. */}
      <div data-state="loading" class="rounded-lg border border-white/10 bg-surface-raised px-6 py-16 text-center text-sm text-ink-muted">
        Loading recipe…
      </div>

      {/* Needs sign-in. */}
      <div data-state="needs-signin" class="hidden rounded-lg border border-white/10 bg-surface-raised px-6 py-16 text-center text-sm text-ink-muted">
        <p class="text-ink-primary font-medium">Sign in to view this recipe</p>
        <p class="mt-1"><a data-signin-link href="/login" class="text-glow-red underline">Sign in</a></p>
      </div>

      {/* Not found (404 or cross-account). */}
      <div data-state="not-found" class="hidden rounded-lg border border-dashed border-white/10 bg-surface-raised px-6 py-16 text-center text-sm text-ink-muted">
        <p class="text-ink-primary font-medium">Recipe not found</p>
        <p class="mt-1">It may have been deleted, or it belongs to another account. <a href="/recipes" class="text-glow-red underline">Back to recipes</a>.</p>
      </div>

      {/* Generic error. */}
      <div data-state="error" class="hidden rounded-lg border border-white/10 bg-surface-raised px-6 py-16 text-center text-sm text-ink-muted">
        <p class="text-ink-primary font-medium">Couldn't load this recipe</p>
        <p data-error-detail class="mt-1"></p>
      </div>

      {/* Loaded. */}
      <div data-state="loaded" class="hidden">
        <header class="mb-6">
          <h1 data-recipe-label class="text-3xl font-semibold tracking-tight text-ink-primary"></h1>
          <p data-recipe-id class="mt-1 font-mono text-xs text-ink-muted"></p>
          <p data-recipe-description class="mt-3 hidden max-w-prose text-sm text-ink-secondary"></p>
        </header>

        <dl class="mb-8 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-xs text-ink-muted">
          <dt>Source session</dt>
          <dd data-recipe-source class="font-mono text-ink-primary">—</dd>
          <dt>Steps</dt>
          <dd data-recipe-intent-count class="text-ink-primary">—</dd>
          <dt>Created</dt>
          <dd data-recipe-created class="text-ink-primary">—</dd>
          <dt>Updated</dt>
          <dd data-recipe-updated class="text-ink-primary">—</dd>
        </dl>

        <h2 class="mb-3 text-lg font-semibold tracking-tight text-ink-primary">Intent steps</h2>
        <ol data-intent-list class="mb-8 space-y-2"></ol>
        <p data-intent-empty class="mb-8 hidden text-sm text-ink-muted">
          This recipe has no recorded intent steps (it was captured from a manual-only
          session).
        </p>

        <button
          type="button"
          data-delete
          class="rounded-lg border border-rose-700/40 px-4 py-2 text-sm text-rose-700 hover:bg-rose-700/10"
          >Delete recipe</button
        >
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, recipeId: id }}>
    (function () {
      const root = document.querySelector('[data-page="recipe-detail"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function show(state) {
        root.querySelectorAll('[data-state]').forEach((el) => {
          el.classList.toggle('hidden', el.getAttribute('data-state') !== state);
        });
      }
      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 16).replace('T', ' ');
      }

      function authedFetch(path, init) {
        return fetch(apiBaseUrl + path, {
          ...(init || {}),
          headers: {
            ...((init && init.headers) || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        });
      }

      // Render an AgentIntent (navigate / interact / wait / capture) as a
      // readable, NON-lossy summary. Unknown kinds fall back to compact
      // JSON so a future intent shape is never silently dropped.
      function intentSummary(it) {
        if (!it || typeof it !== 'object') return escapeHtml(String(it));
        switch (it.kind) {
          case 'navigate':
            return 'Navigate to ' + escapeHtml(it.url || '');
          case 'interact':
            return (
              'Interact — ' +
              escapeHtml(it.action || '') +
              (it.selector ? ' on ' + escapeHtml(it.selector) : '') +
              (it.value ? ' = ' + escapeHtml(it.value) : '')
            );
          case 'wait':
            return (
              'Wait for ' +
              escapeHtml(it.condition || '') +
              (it.selector ? ' (' + escapeHtml(it.selector) + ')' : '') +
              (it.timeoutMs ? ' · up to ' + escapeHtml(String(it.timeoutMs)) + 'ms' : '')
            );
          case 'capture':
            return 'Capture ' + escapeHtml(it.capture || '');
          default:
            return escapeHtml(JSON.stringify(it));
        }
      }

      function intentKind(it) {
        return it && typeof it === 'object' && it.kind ? String(it.kind) : 'step';
      }

      function renderRecipe(r) {
        root.querySelector('[data-recipe-label]').textContent = r.label || '(no label)';
        root.querySelector('[data-recipe-id]').textContent = r.id || '';
        const desc = root.querySelector('[data-recipe-description]');
        if (r.description) {
          desc.textContent = r.description;
          desc.classList.remove('hidden');
        }
        root.querySelector('[data-recipe-source]').textContent =
          r.agent_session_id === null || r.agent_session_id === undefined
            ? '(source session deleted)'
            : r.agent_session_id;
        root.querySelector('[data-recipe-intent-count]').textContent =
          r.intent_count === 1 ? '1 step' : (r.intent_count || 0) + ' steps';
        root.querySelector('[data-recipe-created]').textContent = fmtIso(r.created_at);
        root.querySelector('[data-recipe-updated]').textContent = fmtIso(r.updated_at);

        const list = root.querySelector('[data-intent-list]');
        const log = Array.isArray(r.intent_log) ? r.intent_log : [];
        if (log.length === 0) {
          list.classList.add('hidden');
          root.querySelector('[data-intent-empty]').classList.remove('hidden');
        } else {
          list.innerHTML = log
            .map(
              (it, i) =>
                '<li class="flex items-start gap-3 rounded-lg border border-white/10 bg-surface-raised px-4 py-3">' +
                '<span class="mt-0.5 shrink-0 font-mono text-xs text-ink-muted">' +
                (i + 1) +
                '</span>' +
                '<div class="min-w-0">' +
                '<span class="rounded bg-surface-base px-2 py-0.5 font-mono text-xs text-ink-secondary">' +
                escapeHtml(intentKind(it)) +
                '</span>' +
                '<p class="mt-1 text-sm text-ink-primary">' +
                intentSummary(it) +
                '</p></div></li>',
            )
            .join('');
        }
        show('loaded');
      }

      function wireDelete() {
        const btn = root.querySelector('[data-delete]');
        if (!btn) return;
        btn.addEventListener('click', async () => {
          const confirmed = await window.driftstackConfirm(
            'Delete this recipe? This cannot be undone.',
            { confirmLabel: 'Delete' },
          );
          if (!confirmed) return;
          btn.disabled = true;
          btn.textContent = 'Deleting…';
          authedFetch('/v1/recipes/' + encodeURIComponent(recipeId), { method: 'DELETE' })
            .then((r) => {
              if (r.status === 204) {
                window.location.href = '/recipes';
                return;
              }
              showBanner('Delete failed: HTTP ' + r.status);
              btn.disabled = false;
              btn.textContent = 'Delete recipe';
            })
            .catch((err) => {
              showBanner('Delete failed: ' + (err && err.message ? err.message : 'network error'));
              btn.disabled = false;
              btn.textContent = 'Delete recipe';
            });
        });
      }

      wireDelete();

      if (!token) {
        const signin = root.querySelector('[data-signin-link]');
        if (signin) signin.setAttribute('href', '/login?next=' + encodeURIComponent('/recipes/' + recipeId));
        show('needs-signin');
        if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
        return;
      }

      authedFetch('/v1/recipes/' + encodeURIComponent(recipeId))
        .then((r) => {
          if (r.status === 404) {
            show('not-found');
            return null;
          }
          if (!r.ok) {
            root.querySelector('[data-error-detail]').textContent = 'HTTP ' + r.status;
            show('error');
            return null;
          }
          return r.json();
        })
        .then((body) => {
          if (body) renderRecipe(body);
        })
        .catch((err) => {
          root.querySelector('[data-error-detail]').textContent =
            err && err.message ? err.message : 'network error';
          show('error');
        })
        .finally(function () {
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
        });
    })();
  </script>
</DashboardLayout>
