---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-217 (split 2026-07-03) — the security surfaces moved out of
// settings.astro to this dedicated /security page with the
// design-system v2 redesign. Progressive-enhancement live wiring
// against:
//   - /v1/account/audit-log (V-216) — recent customer-visible events
//   - /v1/auth/password-reset/request (V-079) — change-password trigger
//
// Surfaces here: change password (V-079), two-factor authentication
// (V-353h), active sign-ins (V-355), connected accounts
// (V-667.C-followup), recent activity (V-216), and the danger zone.
// SSG renders mocks; inline <script> reads ds_web_session_token from
// localStorage and replaces the live sections.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Privacy & security">
  <div class="mx-auto max-w-4xl px-6 py-10" data-page="security">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-tk-ink-3" data-field="header-account">
        Account
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Privacy &amp; security</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Password, two-factor authentication, active sign-ins, connected
        accounts, and control over your data. Changes here affect all
        sessions, profiles, and webhooks under this account.
      </p>
    </header>

    {/* Your-data-is-sealed trust surface (demo-concepts arc, 2026-06-12).
        Every claim mirrors the verified architecture: sealed client-encrypted
        profiles (profile-store), per-tenant cryptographic key isolation,
        audited secret access. Static truth — no API call needed. */}
    <section class="mt-10 rounded-xl border border-tk-border bg-gradient-to-br from-tk-accent/5 to-transparent p-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        </span>
        <div>
          <h2 class="text-lg font-semibold text-tk-ink">Your data is sealed</h2>
          <p class="text-sm text-tk-ink-2">
            Profiles are client-encrypted — Driftstack moves opaque bytes and can't read them.
          </p>
        </div>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-tk-border bg-tk-surface p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">Profile encryption</p>
          <p class="mt-1.5 text-sm font-semibold text-tk-ink">AES-256-GCM, sealed</p>
          <p class="mt-1 text-xs leading-relaxed text-tk-ink-3">
            Encrypted before it reaches us; the server stores ciphertext only.
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">Tenant isolation</p>
          <p class="mt-1.5 text-sm font-semibold text-tk-ink">Cryptographic</p>
          <p class="mt-1 text-xs leading-relaxed text-tk-ink-3">
            A wrong account cannot decrypt your data — enforced by math, not policy.
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">Secret access</p>
          <p class="mt-1.5 text-sm font-semibold text-tk-ink">Always audited</p>
          <p class="mt-1 text-xs leading-relaxed text-tk-ink-3">
            Every credential read lands in your <a href="/audit-log" class="text-tk-accent-text underline">audit log</a>.
          </p>
        </div>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Full model at
        <a href="https://driftstack.dev/trust/security-overview" class="text-tk-accent-text underline">driftstack.dev/trust</a>
        · your data, your call — export or delete anytime from
        <a href="#danger-zone" class="text-tk-accent-text underline">the danger zone</a>.
      </p>
    </section>

    {/* 2026-05-23 — icon on the Security section header. */}
    <!-- Security -->
    <section class="dashboard-card mt-6">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </span>
        Security
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">Password + recovery options.</p>
      <div class="mt-6 space-y-3">
        <button type="button" data-action="change-password" class="btn-secondary inline-flex">
          Change password
        </button>
        <p class="text-xs text-tk-ink-3">
          We email you a magic link to confirm. The link expires after 60
          minutes; old sessions stay signed in until they naturally expire.
        </p>
      </div>
    </section>

    <!-- Two-factor authentication (V-353h) -->
    <section class="dashboard-card mt-6" data-region="mfa">
      <div class="flex items-start justify-between gap-6">
        <div>
          <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </span>
            Two-factor authentication
          </h2>
          <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
            Add a TOTP code from your authenticator app on top of your password.
            Recovery codes are issued at enrollment — store them somewhere safe;
            without your authenticator AND your recovery codes, account access
            requires support intervention.
          </p>
        </div>
        <span
          data-field="mfa-status-badge"
          class="shrink-0 rounded-full bg-tk-surface px-2 py-1 text-xs font-medium text-tk-ink-2"
        >
          loading…
        </span>
      </div>

      <!-- Enroll flow (hidden when already enrolled). -->
      <div class="mt-6 hidden space-y-4" data-section="mfa-enroll">
        <p class="text-sm text-tk-ink-2">
          Click <strong>Set up</strong> to generate a fresh secret. Scan the QR
          (or paste the manual-entry secret into your authenticator app), then
          enter the 6-digit code to confirm.
        </p>
        <button type="button" data-button="mfa-start" class="btn-primary text-sm">
          Set up two-factor authentication
        </button>

        <!-- Hidden until /enroll fires. -->
        <div class="hidden space-y-4 rounded-lg border border-tk-border bg-tk-bg p-4" data-section="mfa-enroll-step">
          <p class="text-sm text-tk-ink-2">
            Open your authenticator app (1Password, Authy, Google Authenticator, etc.)
            and either scan the QR or paste the manual secret.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
            <div
              class="flex h-44 w-44 shrink-0 items-center justify-center rounded-md border border-tk-border bg-tk-surface p-2"
              data-field="mfa-qr"
            >
              <span class="text-xs text-tk-ink-3">QR will render here</span>
            </div>
            <div class="min-w-0 flex-1">
              <label class="block text-xs font-medium uppercase tracking-wide text-tk-ink-3"
                >Manual secret</label>
              <code
                data-field="mfa-secret-base32"
                class="mt-1 block break-all rounded bg-tk-surface px-2 py-1 font-mono text-xs text-tk-ink ring-1 ring-slate-200"
              >—</code>
              <p class="mt-2 text-xs text-tk-ink-3">
                SHA-1 / 30s / 6-digit (RFC 6238 defaults; every authenticator app
                supports).
              </p>
            </div>
          </div>
          <div class="border-t border-tk-border pt-3">
            <label class="block text-sm font-medium text-tk-ink-2" for="mfa-verify-code">
              Enter the 6-digit code from your app to confirm
            </label>
            <div class="mt-2 flex items-center gap-2">
              <input
                id="mfa-verify-code"
                data-field="mfa-verify-code"
                type="text"
                inputmode="numeric"
                pattern="[0-9]{6}"
                maxlength="6"
                placeholder="123456"
                class="w-32 rounded-md border border-tk-border px-3 py-2 font-mono text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
              />
              <button type="button" data-button="mfa-verify" class="btn-primary text-sm">
                Confirm + finish
              </button>
            </div>
            <p
              data-field="mfa-error"
              class="mt-2 hidden rounded border border-tk-err/30 bg-tk-err/10 px-2 py-1 text-xs text-tk-err-text"
            ></p>
          </div>
        </div>

      </div>

      <!-- One-shot recovery-codes reveal. Hidden until /verify (enroll
           flow) or /recovery-codes/regenerate (enrolled flow) returns 10
           fresh codes. S35 2026-07-07 (fable-frontend-audit): this panel
           MUST stay a direct child of the mfa region — it used to live
           inside data-section="mfa-enroll", which setMfaState() hides for
           enrolled users, so regenerated codes (old ones already
           invalidated server-side) rendered into an invisible subtree. -->
      <div class="mt-6 hidden rounded-lg border border-tk-accent/30 bg-tk-accent/10 p-4" data-section="mfa-recovery">
        <p class="text-sm font-medium text-tk-accent-text">
          Save your recovery codes — these are shown ONCE
        </p>
        <p class="mt-1 text-xs text-tk-accent-text">
          Each code works once. Store them somewhere safe (password manager,
          printed copy, secure note). Without your authenticator AND these
          codes, account access requires support intervention.
        </p>
        <ul
          class="mt-3 grid grid-cols-2 gap-2 font-mono text-sm text-tk-accent-text"
          data-list="mfa-recovery-codes"
        ></ul>
        <div class="mt-3 flex flex-wrap gap-2">
          <button
            type="button"
            data-button="mfa-recovery-copy"
            class="btn-secondary text-xs"
          >
            Copy all
          </button>
          <button
            type="button"
            data-button="mfa-recovery-download"
            class="btn-secondary text-xs"
          >
            Download .txt
          </button>
          <button
            type="button"
            data-button="mfa-recovery-acknowledge"
            class="btn-primary text-xs"
          >
            I've saved them
          </button>
        </div>
      </div>

      <!-- Enrolled-state controls (hidden when not enrolled). -->
      <div class="mt-6 hidden space-y-4" data-section="mfa-enrolled">
        <dl class="grid grid-cols-2 gap-3 text-sm">
          <dt class="text-tk-ink-3">Enrolled</dt>
          <dd class="font-mono text-xs text-tk-ink-2" data-field="mfa-enrolled-at">—</dd>
          <dt class="text-tk-ink-3">Last used</dt>
          <dd class="font-mono text-xs text-tk-ink-2" data-field="mfa-last-used">—</dd>
          <dt class="text-tk-ink-3">Recovery codes</dt>
          <dd class="text-xs text-tk-ink-2">
            <span data-field="mfa-recovery-remaining">—</span> unused of 10
          </dd>
        </dl>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-button="mfa-regenerate" class="btn-secondary text-sm">
            Regenerate recovery codes
          </button>
          <button type="button" data-button="mfa-disable" class="btn-secondary text-sm text-tk-err-text">
            Disable two-factor
          </button>
        </div>
        <p class="text-xs text-tk-ink-3">
          Disabling clears your TOTP secret + invalidates all recovery codes.
          Requires a fresh authenticator code (step-up reauth) to confirm.
        </p>
      </div>

      <!-- Step-up reauth modal-ish prompt. S24: the legacy text-oxblood-900
           literals (#4f242b, ~1.5:1 on the dark accent wash — invisible)
           moved to tk-accent-text, matching the mfa-recovery panel on the
           same accent/10 wash. -->
      <div class="mt-6 hidden rounded-lg border border-tk-accent/30 bg-tk-accent/10 p-4" data-section="mfa-step-up">
        <p class="text-sm font-medium text-tk-accent-text">
          Confirm with your authenticator
        </p>
        <p class="mt-1 text-xs text-tk-accent-text">
          Enter a fresh 6-digit code (or a recovery code) to continue.
        </p>
        <div class="mt-3 flex items-center gap-2">
          <input
            data-field="mfa-step-up-code"
            type="text"
            inputmode="numeric"
            maxlength="11"
            placeholder="123456 or recovery"
            aria-label="MFA step-up code"
            class="w-44 rounded-md border border-tk-accent/40 px-3 py-2 font-mono text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
          <button type="button" data-button="mfa-step-up-submit" class="btn-primary text-sm">
            Confirm
          </button>
          <button type="button" data-button="mfa-step-up-cancel" class="btn-secondary text-sm">
            Cancel
          </button>
        </div>
        <p
          data-field="mfa-step-up-error"
          class="mt-2 hidden rounded border border-tk-err/30 bg-tk-err/10 px-2 py-1 text-xs text-tk-err-text"
        ></p>
      </div>
    </section>

    <!-- Sessions / devices (V-355) -->
    <section class="dashboard-card mt-6" data-region="web-sessions">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
          </svg>
        </span>
        Active sign-ins
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        Browser sessions where you're signed in to the dashboard. Distinct
        from the automation sessions you run in the Driftstack desktop app.
      </p>
      <ul class="mt-6 divide-y divide-tk-border" data-list="web-sessions">
        <li class="py-3 text-sm text-tk-ink-3" data-field="web-sessions-empty">
          Sign in to load your active sessions.
        </li>
      </ul>
      <div class="mt-4 flex items-center justify-between gap-3 border-t border-tk-border pt-4">
        <p
          data-field="web-sessions-status"
          class="text-xs text-tk-ink-3"
        ></p>
        <button
          type="button"
          data-button="web-sessions-revoke-all"
          class="btn-secondary text-sm text-tk-err-text"
          hidden
        >
          Sign out everywhere else
        </button>
      </div>
      <p class="mt-3 text-xs text-tk-ink-3">
        IP omitted for privacy. The "current" session is the one you're using
        right now and can't be revoked from this list — sign out from the menu
        instead.
      </p>
    </section>

    <!-- Connected accounts (V-667.C-followup — live-wired) -->
    <section class="dashboard-card mt-6" data-region="oauth-links">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
        </span>
        Connected accounts
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        IDPs (Google / GitHub) linked to your account. Each link lets you
        sign in via that provider. Revoking the link on the provider side
        (e.g. Google → Security → Third-party access) automatically marks
        it inactive here on next sign-in attempt; password sign-in
        continues to work either way.
      </p>
      <ul class="mt-6 divide-y divide-tk-border" data-list="oauth-links">
        <li class="py-3 text-sm text-tk-ink-3" data-field="oauth-links-empty">
          Sign in to load your linked accounts.
        </li>
      </ul>
      <p class="mt-3 text-xs text-tk-ink-3" data-field="oauth-links-disabled" hidden>
        Sign-in-with-Google / GitHub isn't configured on this server.
        Password sign-in continues to work.
      </p>
    </section>

    <!-- Audit log (V-216 — live-wired) -->
    <section class="dashboard-card mt-6" data-region="audit-log">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
        </span>
        Recent activity
      </h2>
      <p class="mt-2 text-sm text-tk-ink-3">
        API key mints + revokes, session lifecycle events, and other account
        changes. Newest first; filtered to your own account.
      </p>
      <ul class="mt-6 divide-y divide-tk-border" data-list="audit-log">
        <li class="py-3 text-sm text-tk-ink-3" data-field="audit-empty">
          Sign in to load recent activity.
        </li>
      </ul>
    </section>

    <!-- Danger zone. S24: err-toned TEXT reads tk-err-text (the raw err
         token is a fill tone, 3.9–4.3:1 as small light-mode text); the
         err/30 border + err/10 wash keep the raw token. -->
    <section id="danger-zone" class="mt-10 rounded-lg border border-tk-err/30 bg-tk-err/10 p-6">
      <h2 class="text-lg font-semibold text-tk-err-text">Danger zone</h2>
      <p class="mt-2 text-sm text-tk-err-text">
        Account deletion is irreversible. All sessions, profiles, API keys,
        and webhook endpoints are immediately revoked, and stored account
        data is purged on the schedule in the privacy policy. Invoice
        history retained per Dutch tax law (7 years) — not deletable on
        request.
      </p>
      <p class="mt-3 text-xs text-tk-err-text">
        Deletion is currently processed by emailing
        <a
          href="mailto:support@driftstack.dev?subject=Account%20deletion%20request"
          class="underline">support@driftstack.dev</a
        > so we can confirm + walk the data-portability export with
        you before the irreversible step.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="security"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');
      const SECURITY_TIMEOUT_MS = 15_000;
      let passwordResetInFlight = false;
      // Captured from the /v1/account/me load below so the change-password
      // flow doesn't re-prompt the signed-in customer for an email they
      // could mistype (a typo silently fails — the server returns
      // { sent: true } for ANY address as anti-enumeration).
      let accountEmail = null;
      let bannerGeneration = 0;

      function showBanner(text) {
        const generation = ++bannerGeneration;
        if (!banner) return generation;
        banner.textContent = text;
        banner.classList.remove('hidden');
        return generation;
      }
      function hideBanner(expectedGeneration) {
        if (expectedGeneration !== undefined && expectedGeneration !== bannerGeneration) return;
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function boundedFetch(url, init = {}) {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), SECURITY_TIMEOUT_MS);
        return fetch(url, { ...init, signal: controller.signal })
          .catch((err) => {
            if (err && err.name === 'AbortError') {
              throw new Error('Request took too long. Check your connection and try again.');
            }
            throw err;
          })
          .finally(() => window.clearTimeout(timeout));
      }

      // Load the account identity (GET /v1/account/me).
      if (token) {
        boundedFetch(apiBaseUrl + '/v1/account/me', {
          headers: { authorization: 'Bearer ' + token },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((me) => {
            if (!me) return;
            // Capture the account email for the change-password flow so we
            // don't re-prompt the customer for an address we already know.
            if (me.email) accountEmail = me.email;
            // Populate the header account-id from live data (mirrors
            // settings.astro — audit w2flmiw48 #3).
            if (me.id) {
              const headerAcct = document.querySelector('[data-field="header-account"]');
              if (headerAcct) headerAcct.textContent = 'Account · ' + me.id.slice(0, 16) + '…';
            }
          })
          .catch(() => {
            /* leave the header as-is */
          });
      }

      function authedFetch(path, init = {}) {
        return boundedFetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // V-216 — audit log live wire.
      const auditList = root.querySelector('[data-list="audit-log"]');

      function fmtAction(action) {
        return action.replace(/[._]/g, ' ');
      }

      function renderAudit(entries) {
        if (!auditList) return;
        if (entries.length === 0) {
          auditList.innerHTML =
            '<li class="py-3 text-sm text-tk-ink-3">No recent activity yet — your first key mint, session create, or other account event will appear here.</li>';
          return;
        }
        auditList.innerHTML = entries
          .map((entry) => {
            const targetFrag = entry.target_resource_id
              ? '<p class="mt-1 font-mono text-[11px] text-tk-ink-3">' +
                escapeHtml(entry.target_resource_id) +
                '</p>'
              : '';
            return (
              '<li class="flex items-start justify-between gap-4 py-3">' +
              '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-tk-ink-3">' +
              escapeHtml(fmtIso(entry.timestamp)) +
              '</p>' +
              '<p class="mt-1 text-sm text-tk-ink">' +
              '<code class="font-mono text-xs text-tk-accent-text">' +
              escapeHtml(entry.action) +
              '</code>' +
              '</p>' +
              targetFrag +
              '</div>' +
              '<span class="text-xs text-tk-ink-3">' +
              escapeHtml(fmtAction(entry.actor_type)) +
              '</span></li>'
            );
          })
          .join('');
      }

      function loadAudit() {
        if (!token || !auditList) return;
        authedFetch('/v1/account/audit-log?limit=20', { method: 'GET' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => renderAudit(body.data || []))
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load audit log (" + msg + ').');
          });
      }

      // V-667.C-followup — connected accounts live wire.
      // Calls /v1/account/me/oauth-links; route returns 404 when the
      // server hasn't yet been wired with OAUTH_CLIENT_* env vars,
      // which we surface as the "not yet enabled" empty state rather
      // than a banner.
      const oauthLinksList = root.querySelector('[data-list="oauth-links"]');
      const oauthLinksDisabled = root.querySelector('[data-field="oauth-links-disabled"]');

      function providerLabel(p) {
        if (p === 'google') return 'Google';
        if (p === 'github') return 'GitHub';
        return p;
      }

      // Upstream revoke/manage URL per provider. Customer-side
      // revocation flows go through the provider's own permissions
      // page; Driftstack just observes the revoke on next sign-in
      // attempt and stamps last_revoked_at. Deep-linking here saves
      // the customer hunting through the provider's settings.
      function providerManageUrl(p) {
        if (p === 'google') return 'https://myaccount.google.com/permissions';
        if (p === 'github') return 'https://github.com/settings/applications';
        return null;
      }

      function renderOauthLinks(links) {
        if (!oauthLinksList) return;
        if (links.length === 0) {
          oauthLinksList.innerHTML =
            '<li class="py-3 text-sm text-tk-ink-3">No third-party sign-in linked yet. Sign in with Google or GitHub from /login to link.</li>';
          return;
        }
        oauthLinksList.innerHTML = links
          .map((link) => {
            const lastLogin = link.last_login_at
              ? 'last sign-in ' + escapeHtml(fmtRelative(link.last_login_at))
              : 'never used';
            const revokedFrag = link.last_revoked_at
              ? ' · <span class="text-tk-busy-text">revoked upstream — sign in to re-link</span>'
              : '';
            const manageUrl = providerManageUrl(link.provider);
            const manageFrag = manageUrl
              ? '<a href="' +
                escapeHtml(manageUrl) +
                '" target="_blank" rel="noopener noreferrer" class="shrink-0 text-xs text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Manage on ' +
                escapeHtml(providerLabel(link.provider)) +
                ' ↗</a>'
              : '';
            return (
              '<li class="flex items-start justify-between gap-4 py-3">' +
              '<div class="min-w-0">' +
              '<p class="text-sm font-medium text-tk-ink">' +
              escapeHtml(providerLabel(link.provider)) +
              '</p>' +
              '<p class="mt-1 text-xs text-tk-ink-3">' +
              escapeHtml(link.provider_email || '(email withheld by provider)') +
              ' · linked ' +
              escapeHtml(fmtIso(link.linked_at)) +
              ' · ' +
              lastLogin +
              revokedFrag +
              '</p>' +
              '</div>' +
              manageFrag +
              '</li>'
            );
          })
          .join('');
      }

      function loadOauthLinks() {
        if (!token || !oauthLinksList) return;
        authedFetch('/v1/account/me/oauth-links', { method: 'GET' })
          .then((r) => {
            if (r.status === 404) {
              // Route not registered — operator hasn't wired
              // OAUTH_CLIENT_* yet. Surface a quiet hint, hide the list.
              if (oauthLinksList) oauthLinksList.hidden = true;
              if (oauthLinksDisabled) oauthLinksDisabled.hidden = false;
              return null;
            }
            if (!r.ok) return Promise.reject(new Error('HTTP ' + r.status));
            return r.json();
          })
          .then((body) => {
            if (body) renderOauthLinks(body.data || []);
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't load connected accounts (" + msg + ').');
          });
