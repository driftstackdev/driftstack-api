---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-184a — onboarding flow Tier 1 scaffolding. Minimal placeholder
// UX; full Tier 3 visual lands as V-184b draft for founder review.
//
// Flow: signup → verify-email → welcome → select-tier → first-session.
// Each page uses localStorage.ds_web_session_token for cross-page state.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Sign up" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="signup"
  >
    <p class="section-label">Create account</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink-primary" style="letter-spacing: -0.02em;">
      Sign up
    </h1>
    <p class="mt-3 text-sm text-ink-secondary">
      Create your Driftstack account. After signup we'll email you a verification code; one signup
      per email.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form data-form="signup" class="space-y-5">
        <div>
          <label class="form-label" for="signup-email">Email</label>
          <input
            id="signup-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label class="form-label" for="signup-name">Name (optional)</label>
          <input
            id="signup-name"
            name="name"
            type="text"
            autocomplete="name"
            class="form-input"
            placeholder="Jane Doe"
          />
        </div>
        <div>
          <label class="form-label" for="signup-password">Password</label>
          <input
            id="signup-password"
            name="password"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
            class="form-input"
            placeholder="••••••••••••"
          />
          <p class="form-helper">12+ characters. Use a passphrase.</p>
        </div>
        <button type="submit" class="btn-primary w-full">Create account</button>
      </form>

      <p class="mt-6 text-xs text-ink-muted">
        Already have an account? <a
          data-login-link
          href="/login"
          class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft">Sign in</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="signup"]');
      if (!root) return;
      const form = root.querySelector('[data-form="signup"]');
      const banner = root.querySelector('[data-banner]');
      const loginLink = root.querySelector('[data-login-link]');

      // V-269 — preserve ?next= when bouncing the user to /login.
      const params = new URLSearchParams(window.location.search);
      const nextRaw = params.get('next');
      if (nextRaw && loginLink) {
        loginLink.setAttribute('href', '/login?next=' + encodeURIComponent(nextRaw));
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const payload = {
          email: fd.get('email'),
          password: fd.get('password'),
        };
        const name = fd.get('name');
        if (name) payload.name = name;

        fetch(apiBaseUrl + '/v1/auth/signup', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
          credentials: 'include',
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r.json().then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            // Stash the email for the verify page (no token yet — that
            // comes from /v1/auth/verify-email). debug_token is exposed
            // in test/dev mode for paste-in convenience.
            sessionStorage.setItem('ds_signup_email', payload.email);
            if (body.debug_token) {
              sessionStorage.setItem('ds_debug_verify_token', body.debug_token);
            }
            // V-267 — pass through the ?next= deep link so flows that
            // brought the user to signup (e.g. GUI activation at
            // /cli/authorize) can resume after verify-email completes.
            const params = new URLSearchParams(window.location.search);
            const next = params.get('next');
            const verifyUrl = next
              ? '/verify-email?next=' + encodeURIComponent(next)
              : '/verify-email';
            window.location.href = verifyUrl;
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Signup failed.');
          });
      });
    })();
  </script>
</DashboardLayout>
