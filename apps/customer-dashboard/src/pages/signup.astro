---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// Account onboarding flow.
// Flow: signup → verify-email → welcome → select-tier → dashboard.
// Each page uses localStorage.ds_web_session_token for cross-page state.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Sign up" withSidebar={false}>
  <script is:inline>
    // Audit 2026-07-07 (same class as the /login authed-redirect fix): an
    // already-authenticated visitor (session token in localStorage) must NOT see
    // the Create-account form — bounce them to the dashboard (or same-origin
    // ?next=). DashboardLayout's pre-paint auth gate is gated on withSidebar, so it
    // never runs on this withSidebar={false} page. Loop-safe: the dashboard
    // re-validates the token and bounces a stale one back to /login (clearing it).
    (function () {
      try {
        var t = localStorage.getItem('ds_web_session_token');
        if (!t || t.length === 0) return;
        var raw = new URLSearchParams(location.search).get('next') || '/';
        var dest = raw.charAt(0) === '/' && raw.charAt(1) !== '/' ? raw : '/';
        location.replace(dest);
      } catch (_) {
        /* localStorage blocked → fall through and show the form */
      }
    })();
  </script>
  {/* 2026-05-22 — hero-glow atmosphere on signup surface matches the
      marketing site + login page. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
      data-page="signup"
    >
    <p class="section-label">Create account</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Sign up
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      Create your Driftstack account. After signup we'll email you a verification code; one signup
      per email.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div
        data-signup-unknown
        class="mb-5 hidden rounded-lg border border-tk-border bg-tk-surface px-4 py-4"
      >
        <h2 class="text-sm font-semibold text-tk-ink">Check your inbox first</h2>
        <p class="mt-2 text-sm text-tk-ink-2">
          Account creation may already have completed and sent a verification email. Continue to
          verification to enter or resend the code without submitting this signup again.
        </p>
        <a
          data-continue-verification
          href="/verify-email/"
          class="btn-primary mt-4 flex w-full items-center justify-center"
          >Continue to email verification</a
        >
      </div>

      <form data-form="signup" class="space-y-5">
        <div>
          <label class="form-label" for="signup-email">Email</label>
          <input
            id="signup-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label class="form-label" for="signup-name">Name (optional)</label>
          <input
            id="signup-name"
            name="name"
            type="text"
            autocomplete="name"
            class="form-input"
            placeholder="Jane Doe"
          />
        </div>
        <div>
          <label class="form-label" for="signup-password">Password</label>
          <input
            id="signup-password"
            name="password"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
            class="form-input"
            placeholder="••••••••••••"
          />
          <p class="form-helper">12+ characters. Use a passphrase.</p>
        </div>
        <button type="submit" class="btn-primary w-full">Create account</button>
      </form>

      <!-- F-7 — divider between password + IDP signup paths. Same
           shape as /login so the surfaces feel uniform. -->
      <div data-oauth-divider class="mt-6 flex items-center gap-3 text-xs text-tk-ink-3">
        <span class="h-px flex-1 bg-tk-hover"></span>
        <span>or</span>
        <span class="h-px flex-1 bg-tk-hover"></span>
      </div>

      <!-- V-667.C — sign-up-with-IDP. Same /v1/auth/oauth-client/start
           endpoint the /login surface uses; linkOrCreateAccount on
           the service side handles new-account creation transparently.
           2026-05-16 follow-up: one-click signup parity with /login
           per founder direction (Issue 7 industry-standard pattern). -->
      <div class="mt-5 flex flex-col gap-2" data-oauth-buttons>
        <button
          type="button"
          data-oauth="google"
          class="btn-secondary w-full text-sm inline-flex items-center justify-center gap-2.5"
          aria-label="Sign up with Google"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          Sign up with Google
        </button>
        <button
          type="button"
          data-oauth="github"
          class="btn-secondary w-full text-sm inline-flex items-center justify-center gap-2.5"
          aria-label="Sign up with GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 015.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .3.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
            ></path>
          </svg>
          Sign up with GitHub
        </button>
      </div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Already have an account? <a
          data-login-link
          href="/login/"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Sign in</a
        >.
      </p>
    </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="signup"]');
      if (!root) return;

      // Open-redirect guard for ?next= — inline copy of src/lib/safe-next.ts
      // (unit-tested in safe-next.test.ts; kept inline because <script
      // is:inline define:vars> can't import). Reduces ?next= to a same-origin
      // relative path, else '/'. Used for the login-link forward, the
      // verify-email forward, and the OAuth redirect_to below.
      function safeNextPath(next, origin) {
        if (typeof next !== 'string' || next.length === 0) return '/';
        let u;
        try {
          u = new URL(next, origin);
        } catch (e) {
          return '/';
        }
        if (u.origin !== origin) return '/';
        const p = u.pathname + u.search + u.hash;
        if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
        return p;
      }

      const form = root.querySelector('[data-form="signup"]');
      const banner = root.querySelector('[data-banner]');
      const loginLink = root.querySelector('[data-login-link]');
      const unknownRecovery = root.querySelector('[data-signup-unknown]');
      const continueVerification = root.querySelector('[data-continue-verification]');
      const oauthButtonsGroup = root.querySelector('[data-oauth-buttons]');
      const oauthDivider = root.querySelector('[data-oauth-divider]');

      // V-269 — preserve ?next= when bouncing the user to /login.
      const params = new URLSearchParams(window.location.search);
      const nextRaw = params.get('next');
      if (nextRaw && loginLink) {
        loginLink.setAttribute(
          'href',
          '/login/?next=' + encodeURIComponent(safeNextPath(nextRaw, window.location.origin)),
        );
      }

      function verificationUrl() {
        const next = safeNextPath(nextRaw, window.location.origin);
        return nextRaw ? '/verify-email/?next=' + encodeURIComponent(next) : '/verify-email/';
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Problem-type URI for the "email already registered" 409. Matched on
      // the body `type` (not the human detail string).
      const EMAIL_ALREADY_REGISTERED_TYPE =
        'https://errors.driftstack.dev/email-already-registered';

      // Render the already-registered banner with inline "Sign in" + "Reset
      // password" actions (carrying the entered email through), so a
      // returning user has a path forward instead of a plain dead message.
      function showAlreadyRegistered(email) {
        const q = email ? '?email=' + encodeURIComponent(email) : '';
        banner.textContent = '';
        const msg = document.createElement('span');
        msg.textContent = 'An account with this email already exists. ';
        const signIn = document.createElement('a');
        signIn.href = '/login/' + q;
        signIn.className =
          'text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2';
        signIn.textContent = 'Sign in';
        const sep = document.createElement('span');
        sep.textContent = ' or ';
        const reset = document.createElement('a');
        reset.href = '/forgot-password/' + q;
        reset.className =
          'text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2';
        reset.textContent = 'reset your password';
        const tail = document.createElement('span');
        tail.textContent = '.';
        banner.append(msg, signIn, sep, reset, tail);
        banner.classList.remove('hidden');
      }

      // Server-side ValidationError carries the zod issues in
      // `extensions.issues` (shape: { formErrors: string[],
      // fieldErrors: Record<string, string[]> }). Surface those
      // per-field instead of the generic "One or more fields failed
      // validation" detail (Issue 2 — wave 1085+).
      function formatValidationIssues(issues) {
        if (!issues || typeof issues !== 'object') return null;
        const fieldErrors = issues.fieldErrors || {};
        const formErrors = issues.formErrors || [];
        const parts = [];
        for (const [field, msgs] of Object.entries(fieldErrors)) {
          if (!Array.isArray(msgs) || msgs.length === 0) continue;
          const label =
            field === 'email'
              ? 'Email'
              : field === 'password'
                ? 'Password'
                : field === 'name'
                  ? 'Name'
                  : field;
          const friendly = msgs
            .map((m) => {
              // Zod default messages → customer-friendly.
              if (/Invalid email/i.test(m)) return 'must be a valid email address';
              if (/at least 12/i.test(m)) return 'must be at least 12 characters';
              if (/at most 128/i.test(m)) return 'must be at most 128 characters';
              if (/at most 254/i.test(m)) return 'must be 254 characters or fewer';
              if (/at most 120/i.test(m)) return 'must be 120 characters or fewer';
              return m;
            })
            .join('; ');
          parts.push(label + ' ' + friendly + '.');
        }
        for (const m of formErrors) parts.push(m);
        return parts.length > 0 ? parts.join(' ') : null;
      }

      // Disable submit + show a pending label while signup is in flight
      // (prevents a double-submit creating a confusing "already exists"
      // error, and gives the user click feedback).
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitLabel = submitBtn ? submitBtn.textContent : '';
      const SIGNUP_REQUEST_TIMEOUT_MS = 15_000;
      const SIGNUP_STORAGE_PROBE_KEY = 'ds_signup_storage_probe';
      let signupInFlight = false;
      let signupOutcomeUnknown = false;
      function setSubmitting(on) {
        if (!submitBtn) return;
        submitBtn.disabled = on;
        submitBtn.setAttribute('aria-busy', on ? 'true' : 'false');
        submitBtn.textContent = on ? 'Creating account…' : submitLabel;
      }

      function writeSignupState(key, value) {
        try {
          const expected = String(value);
          sessionStorage.setItem(key, expected);
          return sessionStorage.getItem(key) === expected;
        } catch (_) {
          return false;
        }
      }

      function removeSignupState(key) {
        try {
          sessionStorage.removeItem(key);
          return sessionStorage.getItem(key) === null;
        } catch (_) {
          return false;
        }
      }

      function canPersistSignupState() {
        const sentinel = String(Date.now()) + ':' + Math.random();
        if (!writeSignupState(SIGNUP_STORAGE_PROBE_KEY, sentinel)) return false;
        return removeSignupState(SIGNUP_STORAGE_PROBE_KEY);
      }

      function persistSignupState(email, debugToken) {
        if (!writeSignupState('ds_signup_email', email)) return false;
        if (typeof debugToken === 'string' && debugToken.length > 0) {
          return writeSignupState('ds_debug_verify_token', debugToken);
        }
        return removeSignupState('ds_debug_verify_token');
      }

      function showTerminalSignupRecovery(email, message) {
        signupOutcomeUnknown = true;
        const emailStored = writeSignupState('ds_signup_email', email);
        const passwordInput = form.querySelector('input[name="password"]');
        if (passwordInput) passwordInput.value = '';
        form.classList.add('hidden');
        if (oauthDivider) oauthDivider.classList.add('hidden');
        if (oauthButtonsGroup) oauthButtonsGroup.classList.add('hidden');
        if (continueVerification) continueVerification.setAttribute('href', verificationUrl());
        if (unknownRecovery) unknownRecovery.classList.remove('hidden');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.setAttribute('aria-busy', 'false');
          submitBtn.textContent = 'Continue to verification';
        }
        setOauthButtonsDisabled(true);
        showBanner(
          message +
            (emailStored
              ? ''
              : ' Browser site storage is unavailable, so enter your email manually on the verification page.'),
        );
      }

      function showSignupOutcomeUnknown(email) {
        showTerminalSignupRecovery(
          email,
          'Account-creation outcome is unknown after the request timed out. The server may already have created your account and sent its verification email. Do not submit this signup again on this page. Check your inbox and spam folder, then continue to email verification to enter or resend the code.',
        );
      }

      function showAcceptedSignupRecovery(email) {
        showTerminalSignupRecovery(
          email,
          'Your account was created, but this page could not complete the verification handoff. Do not submit this signup again. Check your inbox and spam folder, then continue to email verification to enter or resend the code.',
        );
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        if (signupOutcomeUnknown) return;
        if (signupInFlight) return;
        if (oauthStartInFlight) return;
        banner.classList.add('hidden');
        if (!canPersistSignupState()) {
          showBanner(
            'Browser site storage is unavailable. Enable site storage and try again. No account-creation request was sent, and your entries are still here.',
          );
          return;
        }
        signupInFlight = true;
        setSubmitting(true);
        setOauthButtonsDisabled(true);
        const fd = new FormData(form);
        const payload = {
          email: fd.get('email'),
          password: fd.get('password'),
        };
        const name = fd.get('name');
        if (name) payload.name = name;
        let signupAccepted = false;
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), SIGNUP_REQUEST_TIMEOUT_MS);

        fetch(apiBaseUrl + '/v1/auth/signup', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
          credentials: 'include',
          signal: controller.signal,
        })
          .then((r) => {
            if (r.ok) {
              // Account creation is irreversible. Once the server accepts it,
              // parsing or browser-storage failures must never invite a replay.
              signupAccepted = true;
              return r.json();
            }
            return r
              .json()
              .catch(() => ({}))
              .then((b) => {
                // Per-field validation errors take precedence over the
                // generic detail string (Issue 2 wave 1085+).
                const specific = formatValidationIssues(b.extensions && b.extensions.issues);
                const err = specific
                  ? Object.assign(new Error(specific), { customerSafe: true })
                  : window.driftstackResponseError(r, b);
                // Carry the problem type so the catch can branch (e.g.
                // email-already-registered → inline sign-in/reset links).
                err.problemType = b.type;
                return Promise.reject(err);
              });
          })
          .then((body) => {
            // Stash the email for the verify page (no token yet — that
            // comes from /v1/auth/verify-email). debug_token is exposed
            // in test/dev mode for paste-in convenience.
            if (!body || typeof body !== 'object') {
              throw new Error('Signup returned an invalid response.');
            }
            if (!persistSignupState(payload.email, body.debug_token)) {
              throw new Error('Signup state could not be persisted.');
            }
            // V-267 — pass through the ?next= deep link so flows that
            // brought the user to signup (e.g. GUI activation at
            // /cli/authorize) can resume after verify-email completes.
            window.location.href = verificationUrl();
          })
          .catch((err) => {
            if (signupAccepted) {
              showAcceptedSignupRecovery(payload.email);
              return;
            }
            // Email already registered → inline sign-in / reset links that
            // carry the entered email, not a dead text banner.
            if (err && err.problemType === EMAIL_ALREADY_REGISTERED_TYPE) {
              showAlreadyRegistered(payload.email);
              return;
            }
            if (controller.signal.aborted) {
              showSignupOutcomeUnknown(payload.email);
              return;
            }
            showBanner(window.driftstackRequestErrorMessage(err, 'Signup failed.'));
          })
          .finally(() => {
            clearTimeout(timeoutId);
            signupInFlight = false;
            if (!signupOutcomeUnknown) {
              setSubmitting(false);
              setOauthButtonsDisabled(false);
            }
          });
      });

      // V-667.C — OAuth signup. Mirror of /login click handler:
      // /v1/auth/oauth-client/start { provider, redirect_to } → take
      // the returned authorize_url and redirect the browser to it.
      const oauthButtons = root.querySelectorAll('[data-oauth]');
      const OAUTH_REQUEST_TIMEOUT_MS = 15_000;
      let oauthStartInFlight = false;
      function setOauthButtonsDisabled(disabled, activeButton) {
        oauthButtons.forEach((button) => {
          button.disabled = disabled;
          button.setAttribute(
            'aria-busy',
            disabled && button === activeButton ? 'true' : 'false',
          );
        });
      }
      oauthButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const provider = btn.getAttribute('data-oauth');
          if (signupOutcomeUnknown) return;
          if (!provider || oauthStartInFlight) return;
          if (signupInFlight) return;
          banner.classList.add('hidden');
          oauthStartInFlight = true;
          setOauthButtonsDisabled(true, btn);
          if (submitBtn) submitBtn.disabled = true;
          // Preserve ?next= through the OAuth round-trip so deep links
          // resume after the IDP redirect.
          const params = new URLSearchParams(window.location.search);
          // Origin-prefix the sanitized next so redirect_to is a full
          // same-origin URL — matches login.astro and satisfies the API's
          // /start z.string().url() (a bare relative path would 400).
          const redirectTo =
            window.location.origin + safeNextPath(params.get('next'), window.location.origin);
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), OAUTH_REQUEST_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/oauth-client/start', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ provider, redirect_to: redirectTo }),
            credentials: 'include',
            signal: controller.signal,
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
            )
            .then((body) => {
              const authorizeUrl = window.driftstackTrustedRedirectUrl(body.authorize_url, [
                'https://accounts.google.com',
                'https://github.com',
              ]);
              if (authorizeUrl) {
                window.location.href = authorizeUrl;
              } else {
                showBanner('OAuth start returned an invalid authorize URL.');
              }
            })
            .catch((err) => {
              showBanner(
                controller.signal.aborted
                  ? 'Signup provider took too long. Check your connection and try again.'
                  : window.driftstackRequestErrorMessage(err, 'OAuth start failed.'),
              );
            })
            .finally(() => {
              clearTimeout(timeoutId);
              oauthStartInFlight = false;
              setOauthButtonsDisabled(false);
              if (submitBtn) submitBtn.disabled = false;
            });
        });
      });
    })();
  </script>
</DashboardLayout>
