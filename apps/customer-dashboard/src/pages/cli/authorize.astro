---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// V-267 — Browser-OAuth confirmation page for the GUI client
// activation flow (paired with V-266 backend cli-authorize routes).
//
// Flow:
//   1. GUI opens this URL with `?code=…&state=…` query params.
//   2. Page checks localStorage.ds_web_session_token — if missing,
//      redirects to /signup?next=<this-url> (Sign in lands when the
//      login page exists; for now, signup completes a session as well).
//   3. Page requires the separate verification code displayed only by
//      the initiating desktop app.
//   4. On Authorize: POST /v1/auth/cli-authorize/bind-device-code with
//      `Bearer <session-token>` + `{code, state, user_code}`. Server
//      verifies the code and stages an encrypted key for exchange.
//   5. Success screen: "Authorized — return to the desktop app."
//
// Per V-266: this page is the ONLY surface where a customer's web
// session converts a CLI authorization code into a GUI-paired API key.
// The plaintext key never traverses this page.

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Authorize desktop client" withSidebar={false}>
  <div class="mx-auto max-w-md px-6 py-16" data-page="cli-authorize">
    <header class="text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Desktop client</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight text-tk-ink">
        Authorize this device?
      </h1>
    </header>

    <div
      data-state="loading"
      class="mt-8 flex justify-center py-8 text-sm text-tk-ink-3"
    >
      Checking authorization request…
    </div>

    <div data-state="missing" class="mt-8 hidden">
      <div class="rounded-lg border border-tk-accent/30 bg-tk-accent/10 px-4 py-3 text-sm text-tk-accent-text">
        This page expects an authorization code in the URL. Open it from the Driftstack
        desktop app's "Sign in with browser" button.
      </div>
      <a href="/" class="mt-6 block text-center text-sm text-tk-accent-text underline">
        Return to dashboard
      </a>
    </div>

    <div data-state="needs-signin" class="mt-8 hidden">
      <p class="text-sm text-tk-ink-2">
        Sign in to your Driftstack account to authorize this desktop client.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <a
          data-signup-link
          href="/signup/"
          class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-center text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
          >Create account</a
        >
        <a data-signin-link href="/login/" class="btn-primary text-center">Sign in</a>
      </div>
      <p class="mt-3 text-xs text-tk-ink-3 text-center">
        You'll be brought back to this page automatically.
      </p>
    </div>

    <div data-state="confirm" class="mt-8 hidden">
      <p class="text-sm text-tk-ink-2">
        The Driftstack desktop client is requesting a restricted device key bound to your
        account. It remains active until you revoke it from <a href="/api-keys/" class="text-tk-accent-text underline">API keys</a>.
      </p>
      <label class="mt-6 block text-sm font-medium text-tk-ink-2">
        Verification code from the desktop app
        <input
          data-user-code
          type="text"
          inputmode="text"
          autocomplete="one-time-code"
          autocapitalize="characters"
          spellcheck="false"
          maxlength="9"
          placeholder="XXXX-XXXX"
          aria-describedby="device-code-help device-code-error"
          aria-invalid="false"
          class="mt-2 block w-full rounded-md border border-tk-border bg-tk-bg px-3 py-2 text-center font-mono text-lg uppercase tracking-[0.18em] text-tk-ink"
        />
      </label>
      <p id="device-code-error" data-user-code-error class="mt-2 hidden text-xs text-tk-err-text" role="alert">
        Enter the 8-character code shown in the Driftstack desktop app.
      </p>
      <p id="device-code-help" class="mt-3 text-xs text-tk-ink-3">
        Only continue if you started this sign-in yourself. Never use a code sent by
        another person.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <button
          type="button"
          data-cancel
          class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
        >
          Cancel
        </button>
        <button type="button" data-authorize class="btn-primary">
          Authorize
        </button>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Authorizing will mint a new restricted API key named "Desktop client".
      </p>
    </div>

    <div data-state="success" class="mt-8 hidden">
      <div class="rounded-lg border border-tk-ready/30 bg-tk-ready/10 px-4 py-4 text-center text-sm text-tk-ready-text">
        <p class="font-medium">Desktop client authorized.</p>
        <p class="mt-1 text-tk-ready-text" data-deep-link-status>
          Returning you to the Driftstack desktop app…
        </p>
      </div>
      <p class="mt-4 text-center text-xs text-tk-ink-3" data-fallback-hint>
        The desktop app should reopen automatically. If it doesn't, switch back to it
        manually — it will pick up the credentials on the next poll.
      </p>
      <a href="/api-keys/" class="mt-6 block text-center text-sm text-tk-accent-text underline">
        View your API keys
      </a>
    </div>

    <div data-state="error" class="mt-8 hidden">
      <div
        data-error-message
        class="rounded-lg border border-tk-err/30 bg-tk-err/10 px-4 py-3 text-sm text-tk-err-text"
      ></div>
      <button
        type="button"
        data-retry
        class="btn-primary mt-6 block w-full text-center"
      >
        Try again
      </button>
    </div>

    <!-- 2026-05-20 — Legal acceptance gate. The bind endpoint returns
         409 LegalAcceptanceRequired with the pending docs in the
         problem-extensions; this section renders them with an
         accept-all button so the customer can clear the gate inline
         instead of bouncing through a separate page. -->
    <div data-state="legal-accept" class="mt-8 hidden">
      <div class="rounded-lg border border-tk-err/30 bg-tk-err/10 px-4 py-4 text-sm text-tk-err-text">
        <p class="font-medium">Please review and accept the following before authorizing:</p>
        <ul data-legal-pending-list class="mt-3 space-y-2"></ul>
      </div>
      <div class="mt-6 flex items-center gap-3">
        <button type="button" data-legal-accept-all class="btn-primary">
          Accept all and authorize
        </button>
        <span data-legal-status class="text-xs text-tk-ink-3"></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="cli-authorize"]');
      if (!root) return;
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const state = params.get('state');
      let sessionToken = (() => {
        try {
          return window.localStorage.getItem('ds_web_session_token') ?? null;
        } catch {
          return null;
        }
      })();

      const sections = {
        loading: root.querySelector('[data-state="loading"]'),
        missing: root.querySelector('[data-state="missing"]'),
        needsSignin: root.querySelector('[data-state="needs-signin"]'),
        confirm: root.querySelector('[data-state="confirm"]'),
        success: root.querySelector('[data-state="success"]'),
        error: root.querySelector('[data-state="error"]'),
        legalAccept: root.querySelector('[data-state="legal-accept"]'),
      };

      // Map data-state attribute (kebab-case) to the section key
      // (camelCase). 2026-05-20 — earlier rev called show('needs-signin')
      // / show('legal-accept') which never matched the keys (which are
      // 'needsSignin' / 'legalAccept'), so the function hid every
      // section + the page rendered blank under the header. Caught by
      // the cli-authorize.test.ts integration test.
      const KEY_BY_STATE = {
        loading: 'loading',
        missing: 'missing',
        'needs-signin': 'needsSignin',
        confirm: 'confirm',
        success: 'success',
        error: 'error',
        'legal-accept': 'legalAccept',
      };

      function show(name) {
        const target = KEY_BY_STATE[name] ?? name;
        for (const key of Object.keys(sections)) {
          const el = sections[key];
          if (!el) continue;
          if (key === target) el.classList.remove('hidden');
          else el.classList.add('hidden');
        }
      }

      function showError(message) {
        const errEl = sections.error.querySelector('[data-error-message]');
        if (errEl) errEl.textContent = message;
        show('error');
      }

      // 1. Validate code + state
      if (!code || !state) {
        show('missing');
        return;
      }

      function showNeedsSignin() {
        const signinLink = sections.needsSignin.querySelector('[data-signin-link]');
        const signupLink = sections.needsSignin.querySelector('[data-signup-link]');
        const next = encodeURIComponent(window.location.pathname + window.location.search);
        if (signinLink) signinLink.setAttribute('href', '/login?next=' + next);
        if (signupLink) signupLink.setAttribute('href', '/signup?next=' + next);
        show('needs-signin');
      }

      function invalidateSession() {
        sessionToken = null;
        try {
          window.localStorage.removeItem('ds_web_session_token');
        } catch {
          /* storage may be unavailable; the in-memory gate still closes */
        }
        showNeedsSignin();
      }

      // 2. Sign-in gate (token absent locally → straight to sign-in).
      // A stale/expired token is detected when the bind itself returns
      // 401; that path wipes localStorage + redirects to sign-in.
      // Earlier rev added a preflight /v1/account/me check but the
      // extra round-trip was causing the confirm UI to never render
      // for some accounts; reverting to the simpler shape.
      if (!sessionToken) {
        showNeedsSignin();
        return;
      }

      // 3. Confirmation UI. The device code remains in the URL for record
      // lookup, but cannot authorize without the separate device-displayed
      // human verification code.
      const userCodeInput = sections.confirm.querySelector('[data-user-code]');
      const userCodeError = sections.confirm.querySelector('[data-user-code-error]');
      show('confirm');

      // 4. Wire buttons
      const authorizeBtn = sections.confirm.querySelector('[data-authorize]');
      const cancelBtn = sections.confirm.querySelector('[data-cancel]');
      const retryBtn = sections.error.querySelector('[data-retry]');
      const AUTHORIZE_TIMEOUT_MS = 15_000;
      let authorizeInFlight = false;
      let authorizeOutcomeUnknown = false;
      let authorizeResponseAccepted = false;

      function normalizedUserCode() {
        const compact = String(userCodeInput && userCodeInput.value ? userCodeInput.value : '')
          .trim()
          .toUpperCase()
          .replace(/[\s-]+/g, '');
        return compact.length === 8 ? compact.slice(0, 4) + '-' + compact.slice(4) : '';
      }

      if (userCodeInput) {
        userCodeInput.addEventListener('input', function () {
          if (userCodeError) userCodeError.classList.add('hidden');
          userCodeInput.setAttribute('aria-invalid', 'false');
        });
      }

      function returnToDesktop(delayMs) {
        window.setTimeout(() => {
          try {
            const target =
              'driftstack://auth/callback?code=' +
              encodeURIComponent(code) +
              '&state=' +
              encodeURIComponent(state);
            window.location.assign(target);
          } catch (_) {
            /* swallow — the desktop poller remains the fallback */
          }
        }, delayMs);
      }

      // Server's document_key values are 'tos' | 'privacy' | 'dpa' |
      // 'aup' but the marketing-site URL slug for the terms-of-service
      // page is 'terms', not 'tos'. Remap so links resolve; pass
      // through the others (they already match).
      const DOC_URL_SLUG = { tos: 'terms' };
      function urlSlug(key) {
        return DOC_URL_SLUG[key] ?? key;
      }
      // Friendly label per document. The server's `title` field
      // historically only carried the document_key (e.g. 'tos') which
      // reads ugly; map to human titles when present.
      const DOC_LABEL = {
        tos: 'Terms of Service',
        privacy: 'Privacy Policy',
        dpa: 'Data Processing Addendum',
        aup: 'Acceptable Use Policy',
      };
      function docLabel(doc) {
        return DOC_LABEL[doc.document_key] ?? doc.title ?? doc.document_key;
      }

      // 2026-05-20 — stash the pending list in a closure variable so
      // the "Accept all" click handler reads the canonical
      // {document_key, current_version} pairs that came back from
      // /v1/auth/cli-authorize/bind-device-code's 409 body. Earlier rev tried to
      // reconstruct document_key by parsing the rendered <a href>,
      // which broke for tos (URL slug is /legal/terms/, document_key
      // is 'tos') and lost version precision on text-node parsing.
      let pendingAcceptances = [];
      function showLegalAccept(pending) {
        pendingAcceptances = pending;
        legalReloadOnly = false;
        acceptAllBtn.textContent = 'Accept all and authorize';
        acceptAllBtn.removeAttribute('title');
        const list = sections.legalAccept.querySelector('[data-legal-pending-list]');
        if (!list) return;
        list.innerHTML = '';
        pending.forEach(function (doc) {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2';
          const dot = document.createElement('span');
          dot.className = 'inline-block size-1.5 rounded-full bg-tk-err';
          const a = document.createElement('a');
          a.href = 'https://driftstack.dev/legal/' + urlSlug(doc.document_key) + '/';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-tk-err-text underline underline-offset-4 hover:text-tk-ink';
          a.textContent = docLabel(doc);
          const ver = document.createElement('span');
          ver.className = 'text-xs text-tk-err-text';
          ver.textContent = '(v' + doc.current_version + ')';
          li.append(dot, a, ver);
          list.append(li);
        });
        show('legal-accept');
      }

      function authorize() {
        if (!sessionToken) {
          showNeedsSignin();
          return;
        }
        if (authorizeInFlight) return;
        const userCode = normalizedUserCode();
        if (!/^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$/.test(userCode)) {
          if (userCodeError) userCodeError.classList.remove('hidden');
          if (userCodeInput) userCodeInput.setAttribute('aria-invalid', 'true');
          if (userCodeInput) userCodeInput.focus();
          return;
        }
        authorizeInFlight = true;
        authorizeOutcomeUnknown = false;
        authorizeResponseAccepted = false;
        retryBtn.textContent = 'Try again';
        retryBtn.removeAttribute('title');
        authorizeBtn.disabled = true;
        authorizeBtn.setAttribute('aria-busy', 'true');
        authorizeBtn.textContent = 'Authorizing…';
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), AUTHORIZE_TIMEOUT_MS);
        fetch(apiBaseUrl + '/v1/auth/cli-authorize/bind-device-code', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            authorization: 'Bearer ' + sessionToken,
          },
          body: JSON.stringify({ code: code, state: state, user_code: userCode }),
          signal: controller.signal,
        })
          .then((r) => {
            // The bind response payload is unused. A 2xx means the one-time
            // device code may be consumed; parsing JSON after that point
            // cannot be allowed to manufacture a retry path.
            if (r.ok) {
              authorizeResponseAccepted = true;
              return;
            }
            if (r.status === 401) {
              invalidateSession();
              return Promise.reject(new Error('__needs_signin__'));
            }
            return r.json().then((b) => {
              // 2026-05-20 — surface the legal-acceptance gate as a
              // first-class flow instead of a raw error message. The
              // problem-detail JSON carries `pending_acceptances` on
              // its `extensions` block; render them inline + retry
              // bind after the customer accepts.
              // RFC-7807 problem body: server's ApiError.toProblem()
              // SPREADS extensions to the top level of the JSON
              // (...this.extensions), so the array lives at b.pending_acceptances
              // — NOT nested under b.extensions. Earlier rev looked
              // for the nested shape + always fell through to the
              // generic error path, which is why the customer saw
              // the raw "Operation requires acceptance of 4 document(s)"
              // message instead of the inline accept-all UI.
              const pending =
                b && Array.isArray(b.pending_acceptances) ? b.pending_acceptances : null;
              if (pending && pending.length > 0) {
                showLegalAccept(pending);
                return Promise.reject(new Error('__legal_accept_required__'));
              }
              return Promise.reject(window.driftstackResponseError(r, b));
            });
          })
          .then(() => {
            show('success');
            // V-328e — fire the OS deep-link redirect to hand off the
            // authorization to the desktop app's onOpenUrl listener
            // (V-328). The polling fallback in browser-sign-in.ts
            // continues to work for installs where the URL scheme
            // registration didn't take. Brief delay so the user sees
            // the success confirmation before the OS hand-off swap
            // takes focus away from the browser.
            returnToDesktop(600);
          })
          .catch((err) => {
            if (
              err &&
              (err.message === '__legal_accept_required__' || err.message === '__needs_signin__')
            )
              return;
            if (authorizeResponseAccepted) {
              authorizeOutcomeUnknown = true;
              retryBtn.textContent = 'Return to desktop';
              retryBtn.title = 'Check the desktop app without sending this authorization again';
              showError(
                'Authorization was accepted, but this page could not finish the desktop handoff. Return to the desktop app and wait for its existing poll. Do not retry this link; if the app does not connect, start a fresh browser sign-in from the desktop app.',
              );
              return;
            }
            if (err && err.name === 'AbortError') {
              authorizeOutcomeUnknown = true;
              retryBtn.textContent = 'Return to desktop';
              retryBtn.title = 'Check the desktop app without sending this authorization again';
              showError(
                'The authorization response timed out, so it may already have completed. Return to the desktop app and wait for its existing poll. Do not retry this link; if the app does not connect, start a fresh browser sign-in from the desktop app.',
              );
              return;
            }
            showError(
              window.driftstackRequestErrorMessage(
                err,
                'Authorization failed. Start a fresh browser sign-in from the desktop app.',
              ),
            );
          })
          .finally(() => {
            window.clearTimeout(timeout);
            authorizeInFlight = false;
            authorizeBtn.disabled = false;
            authorizeBtn.setAttribute('aria-busy', 'false');
            authorizeBtn.textContent = 'Authorize';
          });
      }

      authorizeBtn.addEventListener('click', authorize);
      retryBtn.addEventListener('click', function () {
        if (authorizeOutcomeUnknown) {
          returnToDesktop(0);
          return;
        }
        authorize();
      });
      cancelBtn.addEventListener('click', () => {
        window.location.href = '/';
      });

      // 2026-05-20 — Accept-all wiring. POST /v1/legal/accept for each
      // pending doc; on full success, transparently retry the bind so
      // the customer doesn't have to click Authorize twice.
      const acceptAllBtn = sections.legalAccept.querySelector('[data-legal-accept-all]');
      const acceptStatus = sections.legalAccept.querySelector('[data-legal-status]');
      const LEGAL_ACCEPT_TIMEOUT_MS = 15_000;
      let legalAcceptInFlight = false;
      let legalReloadOnly = false;

      function fetchCliLegalWithDeadline(url, init) {
        return window.driftstackFetchWithDeadline(
          url,
          init,
          LEGAL_ACCEPT_TIMEOUT_MS,
        );
      }

      function fetchCliRequiredLegal() {
        return fetchCliLegalWithDeadline(apiBaseUrl + '/v1/legal/required', {
          headers: { authorization: 'Bearer ' + sessionToken },
        })
          .then(function (r) {
            if (!r.ok) throw new Error('Failed to load legal documents (HTTP ' + r.status + ').');
            return r.json();
          })
          .then(function (body) {
            return Array.isArray(body && body.data) ? body.data : [];
          });
      }

      function postCliLegalAcceptance(doc) {
        return fetchCliLegalWithDeadline(apiBaseUrl + '/v1/legal/accept', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            authorization: 'Bearer ' + sessionToken,
          },
          body: JSON.stringify({
            document_key: doc.document_key,
            version: doc.current_version,
            content_hash: doc.content_hash,
          }),
        });
      }

      function finishCliLegalAcceptance() {
        pendingAcceptances = [];
        acceptStatus.textContent = 'Accepted. Authorizing…';
        show('confirm');
        authorize();
      }

      function requireCliLegalReload() {
        legalReloadOnly = true;
        acceptAllBtn.disabled = false;
        acceptAllBtn.textContent = 'Reload to verify';
        acceptAllBtn.title = 'Reload before sending any legal acceptance again';
        acceptStatus.textContent =
          'Acceptance outcome is unknown. Reload to check what remains before authorizing.';
      }

      function reconcileCliLegalAcceptance(attempted) {
        return fetchCliRequiredLegal()
          .then(function (remaining) {
            if (remaining.length === 0) {
              finishCliLegalAcceptance();
              return;
            }
            const remainingKeys = new Set(
              remaining.map(function (doc) {
                return doc.document_key;
              }),
            );
            const recordedCount = attempted.filter(function (doc) {
              return !remainingKeys.has(doc.document_key);
            }).length;
            showLegalAccept(remaining);
            acceptAllBtn.textContent = 'Accept remaining and authorize';
            acceptStatus.textContent =
              recordedCount > 0
                ? recordedCount +
                  ' accepted; ' +
                  remaining.length +
                  (remaining.length === 1
                    ? ' document still requires acceptance. '
                    : ' documents still require acceptance. ') +
                  'Only the remaining documents will be sent.'
                : 'No acceptance was confirmed. Review the remaining documents before retrying.';
          })
          .catch(function () {
            requireCliLegalReload();
          });
      }

      acceptAllBtn.addEventListener('click', function () {
        if (legalReloadOnly) {
          window.location.reload();
          return;
        }
        if (pendingAcceptances.length === 0 || legalAcceptInFlight) return;
        const attempted = pendingAcceptances.slice();
        legalAcceptInFlight = true;
        acceptAllBtn.disabled = true;
        acceptAllBtn.setAttribute('aria-busy', 'true');
        acceptAllBtn.removeAttribute('title');
        acceptStatus.textContent = 'Recording acceptance…';
        // /v1/legal/accept REQUIRES content_hash (64-char SHA-256
        // hex) — that field isn't in the LegalAcceptanceRequiredError's
        // pending_acceptances extension, so fetch the canonical
        // /v1/legal/required entries first to get each hash, then
        // POST each acceptance with its matching {key, version, hash}.
        fetchCliRequiredLegal()
          .then(function (required) {
            const attemptedKeys = new Set(
              attempted.map(function (doc) {
                return doc.document_key;
              }),
            );
            const canonical = required.filter(function (doc) {
              return attemptedKeys.has(doc.document_key);
            });
            return Promise.allSettled(canonical.map(postCliLegalAcceptance));
          })
          .then(function (results) {
            const allOk = results.every(function (result) {
              return result.status === 'fulfilled' && result.value.ok;
            });
            if (allOk) {
              finishCliLegalAcceptance();
              return;
            }
            return reconcileCliLegalAcceptance(attempted);
          })
          .catch(function (err) {
            // The only rejection outside allSettled is the initial
            // canonical GET, so no acceptance POST was sent and retry is safe.
            acceptStatus.textContent = window.driftstackRequestErrorMessage(
              err,
              'Could not load the current legal documents. No acceptance was sent; retry is safe.',
            );
          })
          .finally(function () {
            legalAcceptInFlight = false;
            if (!legalReloadOnly) acceptAllBtn.disabled = false;
            acceptAllBtn.setAttribute('aria-busy', 'false');
          });
      });
    })();
  </script>
</DashboardLayout>
