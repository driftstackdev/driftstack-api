---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// V-267 — Browser-OAuth confirmation page for the GUI client
// activation flow (paired with V-266 backend cli-authorize routes).
//
// Flow:
//   1. GUI opens this URL with `?code=…&state=…` query params.
//   2. Page checks localStorage.ds_web_session_token — if missing,
//      redirects to /signup?next=<this-url> (Sign in lands when the
//      login page exists; for now, signup completes a session as well).
//   3. Page shows a confirmation: "Authorize Driftstack desktop client?"
//      with the code's first 6 chars + the account email.
//   4. On Authorize: POST /v1/auth/cli-authorize/bind with
//      `Bearer <session-token>` + `{code, state}`. Server mints a key,
//      stores plaintext for the GUI's next exchange poll.
//   5. Success screen: "Authorized — return to the desktop app."
//
// Per V-266: this page is the ONLY surface where a customer's web
// session converts a CLI authorization code into a GUI-paired API key.
// The plaintext key never traverses this page.

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Authorize desktop client" withSidebar={false}>
  <div class="mx-auto max-w-md px-6 py-16" data-page="cli-authorize">
    <header class="text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Desktop client</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight text-ink-primary">
        Authorize this device?
      </h1>
    </header>

    <div
      data-state="loading"
      class="mt-8 flex justify-center py-8 text-sm text-ink-muted"
    >
      Checking authorization request…
    </div>

    <div data-state="missing" class="mt-8 hidden">
      <div class="rounded-lg border border-glow-red/30 bg-glow-red/10 px-4 py-3 text-sm text-glow-red-soft">
        This page expects an authorization code in the URL. Open it from the Driftstack
        desktop app's "Sign in with browser" button.
      </div>
      <a href="/" class="mt-6 block text-center text-sm text-glow-red underline">
        Return to dashboard
      </a>
    </div>

    <div data-state="needs-signin" class="mt-8 hidden">
      <p class="text-sm text-ink-secondary">
        Sign in to your Driftstack account to authorize this desktop client.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <a
          data-signup-link
          href="/signup"
          class="rounded-md border border-white/10 bg-surface-raised px-4 py-2 text-center text-sm font-medium text-ink-secondary hover:bg-surface-base"
          >Create account</a
        >
        <a data-signin-link href="/login" class="btn-primary text-center">Sign in</a>
      </div>
      <p class="mt-3 text-xs text-ink-muted text-center">
        You'll be brought back to this page automatically.
      </p>
    </div>

    <div data-state="confirm" class="mt-8 hidden">
      <p class="text-sm text-ink-secondary">
        The Driftstack desktop client on this device is requesting an API key bound to
        your account. The key gives the desktop app the same access as your web session
        and remains active until you revoke it from <a href="/api-keys" class="text-glow-red underline">API keys</a>.
      </p>
      <div class="mt-6 rounded-md border border-white/10 bg-surface-base px-4 py-3">
        <div class="flex items-center justify-between gap-4 text-xs text-ink-muted">
          <span>Authorization code</span>
          <span class="font-mono text-ink-secondary" data-code-preview></span>
        </div>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <button
          type="button"
          data-cancel
          class="rounded-md border border-white/10 bg-surface-raised px-4 py-2 text-sm font-medium text-ink-secondary hover:bg-surface-base"
        >
          Cancel
        </button>
        <button type="button" data-authorize class="btn-primary">
          Authorize
        </button>
      </div>
      <p class="mt-4 text-xs text-ink-muted">
        Authorizing will mint a new API key named "Desktop client" with the same scope
        as your dashboard session.
      </p>
    </div>

    <div data-state="success" class="mt-8 hidden">
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 px-4 py-4 text-center text-sm text-emerald-200">
        <p class="font-medium">Desktop client authorized.</p>
        <p class="mt-1 text-emerald-800" data-deep-link-status>
          Returning you to the Driftstack desktop app…
        </p>
      </div>
      <p class="mt-4 text-center text-xs text-ink-muted" data-fallback-hint>
        The desktop app should reopen automatically. If it doesn't, switch back to it
        manually — it will pick up the credentials on the next poll.
      </p>
      <a href="/api-keys" class="mt-6 block text-center text-sm text-glow-red underline">
        View your API keys
      </a>
    </div>

    <div data-state="error" class="mt-8 hidden">
      <div
        data-error-message
        class="rounded-lg border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-200"
      ></div>
      <button
        type="button"
        data-retry
        class="btn-primary mt-6 block w-full text-center"
      >
        Try again
      </button>
    </div>

    <!-- 2026-05-20 — Legal acceptance gate. The bind endpoint returns
         409 LegalAcceptanceRequired with the pending docs in the
         problem-extensions; this section renders them with an
         accept-all button so the customer can clear the gate inline
         instead of bouncing through a separate page. -->
    <div data-state="legal-accept" class="mt-8 hidden">
      <div class="rounded-lg border border-rose-400/30 bg-rose-400/10 px-4 py-4 text-sm text-rose-200">
        <p class="font-medium">Please review and accept the following before authorizing:</p>
        <ul data-legal-pending-list class="mt-3 space-y-2"></ul>
      </div>
      <div class="mt-6 flex items-center gap-3">
        <button type="button" data-legal-accept-all class="btn-primary">
          Accept all and authorize
        </button>
        <span data-legal-status class="text-xs text-ink-muted"></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="cli-authorize"]');
      if (!root) return;
      const params = new URLSearchParams(window.location.search);
      const code = params.get('code');
      const state = params.get('state');
      const sessionToken =
        window.localStorage.getItem('ds_web_session_token') ?? null;

      const sections = {
        loading: root.querySelector('[data-state="loading"]'),
        missing: root.querySelector('[data-state="missing"]'),
        needsSignin: root.querySelector('[data-state="needs-signin"]'),
        confirm: root.querySelector('[data-state="confirm"]'),
        success: root.querySelector('[data-state="success"]'),
        error: root.querySelector('[data-state="error"]'),
        legalAccept: root.querySelector('[data-state="legal-accept"]'),
      };

      function show(name) {
        for (const key of Object.keys(sections)) {
          const el = sections[key];
          if (!el) continue;
          if (key === name) el.classList.remove('hidden');
          else el.classList.add('hidden');
        }
      }

      function showError(message) {
        const errEl = sections.error.querySelector('[data-error-message]');
        if (errEl) errEl.textContent = message;
        show('error');
      }

      // 1. Validate code + state
      if (!code || !state) {
        show('missing');
        return;
      }

      function showNeedsSignin() {
        const signinLink = sections.needsSignin.querySelector('[data-signin-link]');
        const signupLink = sections.needsSignin.querySelector('[data-signup-link]');
        const next = encodeURIComponent(window.location.pathname + window.location.search);
        if (signinLink) signinLink.setAttribute('href', '/login?next=' + next);
        if (signupLink) signupLink.setAttribute('href', '/signup?next=' + next);
        show('needs-signin');
      }

      // 2. Sign-in gate (token absent locally).
      if (!sessionToken) {
        showNeedsSignin();
        return;
      }

      // 2b. 2026-05-20 — verify the token is actually valid server-side
      // before showing the "Authorize this device?" confirm. A stale /
      // expired token in localStorage previously slipped through and
      // the customer saw the confirm UI even though they weren't
      // actually signed in; authorize-button click then 401'd into a
      // generic error.
      show('loading');
      fetch(apiBaseUrl + '/v1/account/me', {
        headers: { authorization: 'Bearer ' + sessionToken },
      })
        .then((r) => {
          if (r.status === 401) {
            try {
              window.localStorage.removeItem('ds_web_session_token');
            } catch (_) {
              /* localStorage may be blocked — harmless */
            }
            showNeedsSignin();
            return null;
          }
          if (!r.ok) {
            showError('Sign-in check failed (HTTP ' + r.status + '). Try again in a moment.');
            return null;
          }
          // 3. Confirmation UI
          const codePreview = sections.confirm.querySelector('[data-code-preview]');
          if (codePreview) codePreview.textContent = code.slice(0, 6) + '…';
          show('confirm');
          return null;
        })
        .catch(() => {
          showError("Couldn't reach the API to verify your session. Check your connection.");
        });

      // 4. Wire buttons
      const authorizeBtn = sections.confirm.querySelector('[data-authorize]');
      const cancelBtn = sections.confirm.querySelector('[data-cancel]');
      const retryBtn = sections.error.querySelector('[data-retry]');

      function showLegalAccept(pending) {
        const list = sections.legalAccept.querySelector('[data-legal-pending-list]');
        if (!list) return;
        list.innerHTML = '';
        pending.forEach(function (doc) {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2';
          const dot = document.createElement('span');
          dot.className = 'inline-block size-1.5 rounded-full bg-rose-300';
          const a = document.createElement('a');
          a.href = 'https://driftstack.dev/legal/' + doc.document_key + '/';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-rose-100 underline underline-offset-4 hover:text-white';
          a.textContent = doc.title || doc.document_key;
          const ver = document.createElement('span');
          ver.className = 'text-xs text-rose-300';
          ver.textContent = '(v' + doc.current_version + ')';
          li.append(dot, a, ver);
          list.append(li);
        });
        show('legal-accept');
      }

      function authorize() {
        authorizeBtn.disabled = true;
        authorizeBtn.textContent = 'Authorizing…';
        fetch(apiBaseUrl + '/v1/auth/cli-authorize/bind', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            authorization: 'Bearer ' + sessionToken,
          },
          body: JSON.stringify({ code: code, state: state }),
        })
          .then((r) => {
            if (r.ok) return r.json();
            return r.json().then((b) => {
              // 2026-05-20 — surface the legal-acceptance gate as a
              // first-class flow instead of a raw error message. The
              // problem-detail JSON carries `pending_acceptances` on
              // its `extensions` block; render them inline + retry
              // bind after the customer accepts.
              // RFC-7807 problem body: server's ApiError.toProblem()
              // SPREADS extensions to the top level of the JSON
              // (...this.extensions), so the array lives at b.pending_acceptances
              // — NOT nested under b.extensions. Earlier rev looked
              // for the nested shape + always fell through to the
              // generic error path, which is why the customer saw
              // the raw "Operation requires acceptance of 4 document(s)"
              // message instead of the inline accept-all UI.
              const pending =
                b && Array.isArray(b.pending_acceptances) ? b.pending_acceptances : null;
              if (pending && pending.length > 0) {
                showLegalAccept(pending);
                return Promise.reject(new Error('__legal_accept_required__'));
              }
              return Promise.reject(new Error(b.detail || 'HTTP ' + r.status));
            });
          })
          .then(() => {
            show('success');
            // V-328e — fire the OS deep-link redirect to hand off the
            // authorization to the desktop app's onOpenUrl listener
            // (V-328). The polling fallback in browser-sign-in.ts
            // continues to work for installs where the URL scheme
            // registration didn't take. Brief delay so the user sees
            // the success confirmation before the OS hand-off swap
            // takes focus away from the browser.
            window.setTimeout(() => {
              try {
                const target =
                  'driftstack://auth/callback?code=' +
                  encodeURIComponent(code) +
                  '&state=' +
                  encodeURIComponent(state);
                window.location.assign(target);
              } catch (_) {
                /* swallow — fallback hint already visible */
              }
            }, 600);
          })
          .catch((err) => {
            if (err && err.message === '__legal_accept_required__') return;
            showError(err && err.message ? err.message : 'Authorization failed.');
          })
          .finally(() => {
            authorizeBtn.disabled = false;
            authorizeBtn.textContent = 'Authorize';
          });
      }

      authorizeBtn.addEventListener('click', authorize);
      retryBtn.addEventListener('click', authorize);
      cancelBtn.addEventListener('click', () => {
        window.location.href = '/';
      });

      // 2026-05-20 — Accept-all wiring. POST /v1/legal/accept for each
      // pending doc; on full success, transparently retry the bind so
      // the customer doesn't have to click Authorize twice.
      const acceptAllBtn = sections.legalAccept.querySelector('[data-legal-accept-all]');
      const acceptStatus = sections.legalAccept.querySelector('[data-legal-status]');
      acceptAllBtn.addEventListener('click', function () {
        const list = sections.legalAccept.querySelector('[data-legal-pending-list]');
        const items = list ? list.querySelectorAll('a') : [];
        if (items.length === 0) return;
        const pending = [];
        items.forEach(function (a) {
          // Reconstruct document_key + version from the href + text.
          const m = a.href.match(/\/legal\/([a-z-]+)\//);
          const v = (a.nextSibling && a.nextSibling.textContent ? a.nextSibling.textContent : '')
            .replace(/[^0-9.]/g, '');
          if (m && v) pending.push({ document_key: m[1], version: v });
        });
        acceptAllBtn.disabled = true;
        acceptStatus.textContent = 'Recording acceptance…';
        Promise.all(
          pending.map(function (doc) {
            return fetch(apiBaseUrl + '/v1/legal/accept', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                authorization: 'Bearer ' + sessionToken,
              },
              body: JSON.stringify({
                document_key: doc.document_key,
                version: doc.version,
              }),
            });
          }),
        )
          .then(function (responses) {
            const allOk = responses.every(function (r) {
              return r.ok;
            });
            if (!allOk) {
              acceptStatus.textContent = 'One or more acceptances failed — please retry.';
              acceptAllBtn.disabled = false;
              return;
            }
            acceptStatus.textContent = 'Accepted. Authorizing…';
            // Show the confirm UI again briefly + auto-fire the bind.
            show('confirm');
            authorize();
          })
          .catch(function () {
            acceptStatus.textContent = 'Network error — please retry.';
            acceptAllBtn.disabled = false;
          });
      });
    })();
  </script>
</DashboardLayout>
