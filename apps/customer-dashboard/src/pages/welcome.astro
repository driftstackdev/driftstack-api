---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// Onboarding step 3 — brief intro + CTA to tier-select. R6 polish:
// section-label header + auth-card style hero offer + step-list
// what-happens-next + cleaner visual hierarchy.
---

<DashboardLayout title="Welcome" withSidebar={false}>
  {/* 2026-05-23 — hero-glow + gradient-text on the welcome surface
      so the moment a customer creates their account, they see the
      same brand atmosphere as the marketing site. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl px-6 py-16 animate-fade-up" data-page="welcome">
    <p class="section-label">Welcome</p>
    <h1
      class="mt-5 text-4xl font-semibold tracking-tight md:text-5xl"
      style="letter-spacing: -0.02em;"
    >
      
        Your account is ready.
      
    </h1>
    <p class="mt-4 text-tk-ink-2 leading-relaxed">
      Driftstack gives you an iPhone Safari browser running in the
      cloud — every website it visits sees a genuine iPhone, not a bot.
      Pick how you'd like to start:
    </p>

    <ul class="mt-8 space-y-4">
      <li class="auth-card">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-lg font-semibold text-tk-ink">Start free</h2>
          <span class="font-mono text-sm text-tk-accent-text">$0 · no card</span>
        </div>
        <p class="mt-2 text-sm text-tk-ink-2 leading-relaxed">
          Your account is already on the free plan: 1 profile, 1 concurrent
          session of up to 20 minutes. No subscription, no expiry — the best way to
          try Driftstack before committing. Launch the desktop app and choose browser sign-in;
          that provisions a restricted device credential for the app, not a customer API key.
        </p>
        <a href="/" class="btn-primary mt-4 inline-flex">
          Go to your dashboard
        </a>
      </li>
      <li class="card p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-lg font-semibold text-tk-ink">Pick a tier</h2>
          <span class="font-mono text-sm text-tk-ink-3">$79–$1,499 / mo</span>
        </div>
        <p class="mt-2 text-sm text-tk-ink-2 leading-relaxed">
          Upgrade to a paid plan for more concurrency, more profiles, customer API
          keys, and SDK automation — Personal for hand-
          driven sessions, all the way up to API Scale for high-volume
          automation. Cancel anytime.
        </p>
        <a href="/select-tier/" class="btn-secondary mt-4 inline-flex">View tiers</a>
      </li>
    </ul>

    <section
      aria-label="What happens next"
      class="mt-12 rounded-xl border border-tk-border bg-tk-bg/60 backdrop-blur-sm p-6"
    >
      <p class="section-label">What happens next</p>
      <ol class="mt-5 space-y-4 text-sm text-tk-ink-2">
        <li class="flex gap-4">
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-tk-accent/40 bg-tk-accent/10 font-mono text-xs text-tk-accent-text"
            >1</span
          >
          <span class="leading-relaxed">
            Start free with no card — or pick a paid tier and we'll send you
            to Stripe to confirm payment. Your card details stay between you
            and Stripe — we never see them.
          </span>
        </li>
        <li class="flex gap-4">
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-tk-accent/40 bg-tk-accent/10 font-mono text-xs text-tk-accent-text"
            >2</span
          >
          <span class="leading-relaxed">
            Download the Driftstack desktop app and choose browser sign-in.
            Driftstack provisions a restricted device credential for the app;
            that's where Free customers launch and drive iPhone Safari sessions.
          </span>
        </li>
        <li class="flex gap-4">
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-tk-accent/40 bg-tk-accent/10 font-mono text-xs text-tk-accent-text"
            >3</span
          >
          <span class="leading-relaxed">
            On an API-enabled paid tier, create a customer API key for SDK
            automation. Customer keys can be revoked or rotated any time;
            Free desktop sign-in does not require one.
          </span>
        </li>
      </ol>
    </section>

    <p class="mt-8 text-xs text-tk-ink-3">
      Already know what you want? <a
        href="/"
        class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
      >
        Skip to dashboard
      </a>.
    </p>
    </div>
  </div>

  <script is:inline>
    // Defensive redirect: if user lands here without a token, send to
    // /signup/. (Direct nav to /welcome shouldn't normally happen.)
    (function () {
      let token = null;
      try {
        token = localStorage.getItem('ds_web_session_token');
      } catch {
        token = null;
      }
      if (!token) window.location.replace('/signup/');
    })();
  </script>
</DashboardLayout>
