---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// Onboarding step 3 — brief intro + CTA to tier-select. R6 polish:
// section-label header + auth-card style hero offer + step-list
// what-happens-next + cleaner visual hierarchy.
---

<DashboardLayout title="Welcome" withSidebar={false}>
  {/* 2026-05-23 — hero-glow + gradient-text on the welcome surface
      so the moment a customer creates their account, they see the
      same brand atmosphere as the marketing site. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl px-6 py-16 animate-fade-up" data-page="welcome">
    <p class="section-label">Welcome</p>
    <h1
      class="mt-5 text-4xl font-semibold tracking-tight md:text-5xl"
      style="letter-spacing: -0.02em;"
    >
      <span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">
        Your account is ready.
      </span>
    </h1>
    <p class="mt-4 text-ink-secondary leading-relaxed">
      Driftstack runs iPhone Safari sessions on real WebKit — the same
      engine every iPhone uses, so your sessions look indistinguishable
      from a physical phone. Pick how you'd like to start:
    </p>

    <ul class="mt-8 space-y-4">
      <li class="auth-card">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-lg font-semibold text-ink-primary">Trial pack</h2>
          <span class="font-mono text-sm text-glow-red-soft">$2.99 · one-time</span>
        </div>
        <p class="mt-2 text-sm text-ink-secondary leading-relaxed">
          16 hours of session time. No subscription, no auto-renewal.
          14-day window. The best way to try Driftstack before committing —
          most first-time customers start here.
        </p>
        <a href="/select-tier?focus=trial" class="btn-primary mt-4 inline-flex">
          Start trial pack
        </a>
      </li>
      <li class="card p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-lg font-semibold text-ink-primary">Pick a tier</h2>
          <span class="font-mono text-sm text-ink-muted">$79–$1,499 / mo</span>
        </div>
        <p class="mt-2 text-sm text-ink-secondary leading-relaxed">
          Skip the trial and subscribe right away — Solo Manual for hand-
          driven sessions, all the way up to API Scale for high-volume
          automation. Cancel anytime.
        </p>
        <a href="/select-tier" class="btn-secondary mt-4 inline-flex">View tiers</a>
      </li>
    </ul>

    <section
      aria-label="What happens next"
      class="mt-12 rounded-xl border border-white/10 bg-surface-base/60 backdrop-blur-sm p-6"
    >
      <p class="section-label">What happens next</p>
      <ol class="mt-5 space-y-4 text-sm text-ink-secondary">
        <li class="flex gap-4">
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-glow-red/40 bg-glow-red/10 font-mono text-xs text-glow-red"
            >1</span
          >
          <span class="leading-relaxed">
            We'll send you to Stripe to confirm payment. Your card details
            stay between you and Stripe — we never see them.
          </span>
        </li>
        <li class="flex gap-4">
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-glow-red/40 bg-glow-red/10 font-mono text-xs text-glow-red"
            >2</span
          >
          <span class="leading-relaxed">
            Back here, you'll create your first session — an iPhone
            Safari instance with optional SOCKS5 / OpenVPN / WireGuard
            egress per profile.
          </span>
        </li>
        <li class="flex gap-4">
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-glow-red/40 bg-glow-red/10 font-mono text-xs text-glow-red"
            >3</span
          >
          <span class="leading-relaxed">
            We'll create your first API key automatically. You can revoke
            or rotate it any time on the API keys page.
          </span>
        </li>
      </ol>
    </section>

    <p class="mt-8 text-xs text-ink-muted">
      Already know what you want? <a
        href="/"
        class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft"
      >
        Skip to dashboard
      </a>.
    </p>
    </div>
  </div>

  <script is:inline>
    // Defensive redirect: if user lands here without a token, send to
    // /signup. (Direct nav to /welcome shouldn't normally happen.)
    (function () {
      const token = localStorage.getItem('ds_web_session_token');
      if (!token) window.location.replace('/signup');
    })();
  </script>
</DashboardLayout>
