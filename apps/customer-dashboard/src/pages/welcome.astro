---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-184a — onboarding step 3. Brief intro + CTA to tier-select.
// Tier 3 visual UX (full brand intro + "what you'll do next" content)
// surfaces in V-184b draft.
---

<DashboardLayout title="Welcome" withSidebar={false}>
  <div class="mx-auto max-w-2xl px-6 py-16" data-page="welcome">
    <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Welcome</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">
      Your account is ready.
    </h1>
    <p class="mt-4 text-slate-600">
      Driftstack runs real iPhone Safari sessions — same WebKit C++ engine, same
      fingerprint surface as a physical iPhone. Pick how you want to start:
    </p>

    <ul class="mt-8 space-y-4">
      <li class="rounded-lg border border-oxblood-200 bg-white p-5">
        <h2 class="text-lg font-semibold text-slate-900">Trial pack — $2.99</h2>
        <p class="mt-2 text-sm text-slate-600">
          16 hours of session time. One-time. No subscription. Best path to
          evaluate before committing.
        </p>
        <a href="/select-tier?focus=trial" class="btn-primary mt-4 inline-flex">
          Start trial pack
        </a>
      </li>
      <li class="rounded-lg border border-slate-200 bg-white p-5">
        <h2 class="text-lg font-semibold text-slate-900">Pick a tier</h2>
        <p class="mt-2 text-sm text-slate-600">
          Skip the trial and go straight to a paid subscription — Solo Manual
          for human-driven sessions through to API Scale for high-volume
          automation.
        </p>
        <a href="/select-tier" class="btn-secondary mt-4 inline-flex">View tiers</a>
      </li>
    </ul>

    <p class="mt-8 text-xs text-slate-500">
      Already know what you want? <a href="/" class="text-oxblood-700 underline">
        Skip to dashboard
      </a>.
    </p>
  </div>

  <script is:inline>
    // Defensive redirect: if user lands here without a token, send to
    // /signup. (Direct nav to /welcome shouldn't normally happen.)
    (function () {
      const token = localStorage.getItem('ds_web_session_token');
      if (!token) window.location.replace('/signup');
    })();
  </script>
</DashboardLayout>
