---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_SESSIONS, MOCK_USAGE_SUMMARY } from '../data/mocks.ts';

// V-134 scaffolding. Real reads against /v1/sessions land later.

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function fmtDuration(ms: number | null): string {
  if (ms === null) return '—';
  const sec = Math.floor(ms / 1000);
  const min = Math.floor(sec / 60);
  const hr = Math.floor(min / 60);
  if (hr > 0) return `${hr.toString()}h ${(min % 60).toString()}m`;
  if (min > 0) return `${min.toString()}m ${(sec % 60).toString()}s`;
  return `${sec.toString()}s`;
}

const STATUS_BADGE_CLASS: Record<string, string> = {
  creating: 'bg-amber-50 text-amber-700',
  ready: 'bg-emerald-50 text-emerald-700',
  busy: 'bg-blue-50 text-blue-700',
  destroyed: 'bg-slate-100 text-slate-600',
  errored: 'bg-red-50 text-red-700',
};

const activeSessions = MOCK_SESSIONS.filter(
  (s) => s.status !== 'destroyed' && s.status !== 'errored',
);
const recentClosedSessions = MOCK_SESSIONS.filter(
  (s) => s.status === 'destroyed' || s.status === 'errored',
);
---

<DashboardLayout title="Sessions">
  <div class="mx-auto max-w-5xl px-6 py-10">
    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-slate-500">
          {MOCK_USAGE_SUMMARY.concurrent_now} active · {MOCK_USAGE_SUMMARY.concurrent_limit} concurrent
          cap
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Sessions</h1>
        <p class="mt-2 max-w-prose text-sm text-slate-500">
          Live sessions you're driving plus recent destroyed/errored ones.
          Sessions are the only billing meter — you pay for concurrent caps,
          not duration or per-call.
        </p>
      </div>
      <a href="#new" class="btn-primary shrink-0">New session</a>
    </header>

    <!-- Concurrent meter -->
    <div class="mb-10 dashboard-card">
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">
        Concurrent capacity
      </p>
      <div class="mt-4 flex items-center gap-4">
        <p class="font-mono text-3xl font-semibold text-slate-900">
          {MOCK_USAGE_SUMMARY.concurrent_now}
          <span class="text-base font-normal text-slate-500">
            / {MOCK_USAGE_SUMMARY.concurrent_limit}
          </span>
        </p>
        <div class="h-2 flex-1 overflow-hidden rounded bg-slate-100">
          <div
            class="h-full bg-oxblood-700"
            style={`width: ${((MOCK_USAGE_SUMMARY.concurrent_now / MOCK_USAGE_SUMMARY.concurrent_limit) * 100).toString()}%`}
          />
        </div>
      </div>
      <p class="mt-3 text-xs text-slate-500">
        Once this hits your tier cap, new session creates return 429 with a
        retry-after hint. Upgrade your tier to lift the cap.
      </p>
    </div>

    <!-- Active sessions -->
    <section>
      <h2 class="mb-4 text-lg font-semibold text-slate-900">
        Active ({activeSessions.length.toString()})
      </h2>
      {
        activeSessions.length === 0 ? (
          <p class="text-sm text-slate-500">No sessions running.</p>
        ) : (
          <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
            {activeSessions.map((session) => (
              <li class="flex items-start justify-between gap-6 px-6 py-4">
                <div class="min-w-0">
                  <div class="flex items-center gap-3">
                    <p class="font-mono text-sm font-medium text-slate-900">
                      {session.id}
                    </p>
                    <span
                      class:list={[
                        'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                        STATUS_BADGE_CLASS[session.status],
                      ]}
                    >
                      {session.status}
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500">
                    Archetype <code class="font-mono">{session.archetype}</code> · started{' '}
                    {fmtIso(session.created_at)}
                    {session.profile_id !== null && (
                      <>
                        {' · profile '}
                        <code class="font-mono">{session.profile_id.slice(0, 16)}…</code>
                      </>
                    )}
                  </p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  <a href={`#detail-${session.id}`} class="text-sm text-oxblood-700 hover:underline">
                    Open
                  </a>
                  <a href={`#destroy-${session.id}`} class="text-sm text-red-700 hover:underline">
                    Destroy
                  </a>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- Recent closed -->
    <section class="mt-12">
      <h2 class="mb-4 text-lg font-semibold text-slate-900">
        Recent ({recentClosedSessions.length.toString()})
      </h2>
      {
        recentClosedSessions.length === 0 ? (
          <p class="text-sm text-slate-500">No recent sessions.</p>
        ) : (
          <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
            {recentClosedSessions.map((session) => (
              <li class="flex items-start justify-between gap-6 px-6 py-4">
                <div class="min-w-0">
                  <div class="flex items-center gap-3">
                    <p class="font-mono text-sm text-slate-700">{session.id}</p>
                    <span
                      class:list={[
                        'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                        STATUS_BADGE_CLASS[session.status],
                      ]}
                    >
                      {session.status}
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500">
                    Ran {fmtDuration(session.duration_ms)} · destroyed{' '}
                    {fmtIso(session.destroyed_at)}
                  </p>
                </div>
                <a href={`#replay-${session.id}`} class="text-sm text-oxblood-700 hover:underline">
                  View recording
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <p class="mt-8 text-xs text-slate-500">
      Recordings retained 90 days hot, archived to R2 after that. Admin-only
      access initially per ADR-006; customer-facing recording UI lands when
      the V-040 R2 mirror ships.
    </p>
  </div>
</DashboardLayout>
