---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_SESSIONS, MOCK_USAGE_SUMMARY } from '../data/mocks.ts';
import { TIER_CONCURRENT_SESSION_LIMITS } from '@driftstack/api-types';

// V-180 — progressive-enhancement wiring against /v1/sessions, mirrors
// the V-171 /usage pattern. SSG renders mock; inline <script> replaces
// the lists with live data when ds_web_session_token is in localStorage.
// Banners cover: no-token / fetch-error / live-loaded states.
//
// V-186 — concurrent meter now wired live. concurrent_now is computed
// from /v1/sessions response (count of status in [creating, ready,
// busy]). concurrent_limit comes from /v1/usage.tier mapped via
// TIER_CONCURRENT_SESSION_LIMITS imported from @driftstack/api-types.
// Both fetches run in parallel; meter updates as soon as the slower
// of the two settles.

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

function fmtDuration(ms: number | null): string {
  if (ms === null) return '—';
  const sec = Math.floor(ms / 1000);
  const min = Math.floor(sec / 60);
  const hr = Math.floor(min / 60);
  if (hr > 0) return `${hr.toString()}h ${(min % 60).toString()}m`;
  if (min > 0) return `${min.toString()}m ${(sec % 60).toString()}s`;
  return `${sec.toString()}s`;
}

const STATUS_BADGE_CLASS: Record<string, string> = {
  creating: 'bg-glow-red/10 text-glow-red',
  ready: 'bg-emerald-400/10 text-emerald-300',
  busy: 'bg-blue-50 text-blue-700',
  destroyed: 'bg-surface-raised text-ink-secondary',
  errored: 'bg-red-50 text-red-700',
};

const activeSessions = MOCK_SESSIONS.filter(
  (s) => s.status !== 'destroyed' && s.status !== 'errored',
);
const recentClosedSessions = MOCK_SESSIONS.filter(
  (s) => s.status === 'destroyed' || s.status === 'errored',
);

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
const tierConcurrentLimits = TIER_CONCURRENT_SESSION_LIMITS;
---

<DashboardLayout title="Sessions">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="sessions">
    <!--
 — banner is hidden by default (mock-rendered SSG path);
      progressive-enhance script reveals + populates on fetch
      success/failure / no-token state.
    -->
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
      role="status"
    ></div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-ink-muted" data-field="header-summary">
          <span data-field="header-now">{MOCK_USAGE_SUMMARY.concurrent_now}</span> active · <span
            data-field="header-cap">{MOCK_USAGE_SUMMARY.concurrent_limit}</span> concurrent cap
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">Sessions</span></h1>
        <p class="mt-2 max-w-prose text-sm text-ink-muted">
          Live sessions you're driving plus recent destroyed/errored ones.
          Sessions are the only billing meter — you pay for concurrent caps,
          not duration or per-call.
        </p>
      </div>
      <!--
        V-348 — sessions are minted via the SDK or GUI client, not
        the dashboard. The dashboard is read-only for sessions
        (filtering / pagination / view individual). The button
        points at the quickstart so customers can find the SDK
        flow.
      -->
      <a
        href="https://docs.driftstack.dev/quickstart/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary shrink-0"
      >
        How to start a session →
      </a>
    </header>

    {/* 2026-05-23 — icon on concurrent meter card. */}
    <!-- Concurrent meter -->
    <div class="mb-10 dashboard-card">
      <div class="flex items-center justify-between">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">
          Concurrent capacity
        </p>
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </span>
      </div>
      <div class="mt-4 flex items-center gap-4">
        <p class="font-mono text-3xl font-semibold text-ink-primary">
          <span data-field="meter-now">{MOCK_USAGE_SUMMARY.concurrent_now}</span>
          <span class="text-base font-normal text-ink-muted">
            / <span data-field="meter-cap">{MOCK_USAGE_SUMMARY.concurrent_limit}</span>
          </span>
        </p>
        <div class="h-2 flex-1 overflow-hidden rounded bg-surface-raised">
          <div
            data-field="meter-bar"
            class="h-full bg-oxblood-700"
            style={`width: ${((MOCK_USAGE_SUMMARY.concurrent_now / MOCK_USAGE_SUMMARY.concurrent_limit) * 100).toString()}%`}
          />
        </div>
      </div>
      <p class="mt-3 text-xs text-ink-muted">
        Once this hits your tier cap, new session creates return 429 with a
        retry-after hint. Upgrade your tier to lift the cap.
      </p>
    </div>

    <!-- Wave 1086+ — first-session API key reveal. The first-session
         flow stashes the auto-minted plaintext in sessionStorage as
         ds_first_api_key_plaintext + redirects here with ?onboarded=1.
         If the customer never sees that plaintext we've handed them an
         account they can't use the SDK from (server returns the key
         ONCE then hashes it). This reveal surfaces it inline, with
         the same "shown once" framing as /api-keys. -->
    {/* 2026-05-23 — icon on first-API-key reveal panel. */}
    <div
      data-first-key-reveal
      class="mb-8 hidden rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-emerald-200">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-400/20 ring-1 ring-emerald-400/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="12" r="7" />
            <path d="M16 12h6M19 9v6" />
          </svg>
        </span>
        Your first API key — copy it now
      </h2>
      <p class="mt-2 text-sm text-emerald-200">
        This is the only time the full key is shown. Use it in the
        <code class="font-mono">Authorization: Bearer …</code> header of every SDK
        call. Store it in your secret manager
        (1Password, a git-ignored <code class="font-mono">.env</code>, or similar)
        before dismissing.
      </p>
      <pre
        data-first-key-plaintext
        class="mt-4 overflow-x-auto rounded border border-emerald-400/30 bg-surface-raised px-4 py-3 font-mono text-sm text-ink-primary"></pre>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" class="btn-primary" data-first-key-copy>Copy to clipboard</button>
        <button
          type="button"
          class="rounded-md border border-emerald-400/40 bg-surface-raised px-4 py-2 text-sm font-medium text-emerald-200 hover:bg-emerald-100"
          data-first-key-dismiss
        >
          Dismiss — I've saved it
        </button>
        <span data-first-key-copy-feedback class="hidden text-xs text-emerald-300">Copied.</span>
        <a
          href="/api-keys"
          class="ml-auto text-xs text-emerald-300 underline underline-offset-4 hover:text-emerald-200"
        >
          Manage API keys →
        </a>
      </div>
    </div>

    <!-- Wave 1119 / Slice 1119.5 B3 — "what to do next" banner. Surfaces
         right after the customer completes the /first-session flow
         (?onboarded=1 query param OR ds_first_api_key_plaintext present
         in sessionStorage). Without this the post-onboarding cliff was
         steep — the customer landed on /sessions seeing the first-key
         reveal but no guidance on what to actually DO with the key.
         Three concrete next actions: (1) wire the key into the SDK
         quickstart, (2) drive the session via the GUI client, (3)
         browse the SDK reference. Dismissal persists via sessionStorage
         flag so a page reload doesn't re-show. -->
    {/* 2026-05-23 — icon on Next-steps onboarding panel. */}
    <div
      data-next-steps
      class="mb-8 hidden rounded-lg border border-glow-red/30 bg-glow-red/5 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-primary">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-glow-red/15 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </span>
        Next steps — your account is ready to drive
      </h2>
      <p class="mt-2 text-sm text-ink-secondary">
        Your first session is live and your API key is saved. Pick one of
        these to take the next step:
      </p>
      <ul class="mt-4 space-y-3 text-sm text-ink-secondary">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 font-mono text-xs text-glow-red">→</span>
          <span>
            <a
              href="https://docs.driftstack.dev/quickstart/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-ink-primary underline underline-offset-4 hover:text-glow-red"
            >
              SDK quickstart
            </a>
            — paste your API key into a 10-line snippet and watch the
            session navigate, fill a form, and return the page state.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 font-mono text-xs text-glow-red">→</span>
          <span>
            <a
              href="/usage"
              class="font-medium text-ink-primary underline underline-offset-4 hover:text-glow-red"
            >
              Track usage
            </a>
            — concurrent sessions, capture volume, and the billing
            dimensions that count against your tier in real time.
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 font-mono text-xs text-glow-red">→</span>
          <span>
            <a
              href="https://docs.driftstack.dev/api/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-ink-primary underline underline-offset-4 hover:text-glow-red"
            >
              API reference
            </a>
            — the full intent vocabulary (navigate / fill_form / login /
            search / extract) and what each capture surfaces.
          </span>
        </li>
      </ul>
      <div class="mt-4 flex items-center gap-3">
        <button
          type="button"
          class="rounded-md border border-white/15 bg-surface-raised px-4 py-2 text-sm font-medium text-ink-secondary hover:border-white/25 hover:text-ink-primary"
          data-next-steps-dismiss
        >
          Got it — dismiss
        </button>
      </div>
    </div>

    {/* 2026-05-23 — icon + pulsing dot accent on Active sessions
        header to signal liveness. */}
    <!-- Active sessions -->
    <section>
      <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-ink-primary">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        Active (<span data-count="active">{activeSessions.length.toString()}</span>)
      </h2>
      {/*
        2026-05-21 — list renders skeleton placeholders SSR; JS
        hydrates real /v1/sessions data. Same approach as profiles.astro
        3b5ccb77 — pre-hydration the customer no longer sees fake
        scaffolding session IDs / archetypes from MOCK_SESSIONS, just a
        loading skeleton for the ~100ms /v1/sessions roundtrip. The
        MOCK_SESSIONS.filter() variables stay intact so the W786 parity
        pin keeps matching; they're just no longer used to render <li>.
      */}
      <p data-empty="active" class="hidden text-sm text-ink-muted">No sessions running.</p>
      <ul
        data-list="active"
        class="divide-y divide-slate-200 rounded-lg border border-white/10 bg-surface-raised"
      >
        {[0, 1].map(() => (
          <li
            data-skeleton="true"
            class="flex items-start justify-between gap-6 px-6 py-4"
            aria-hidden="true"
          >
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-4 w-56 animate-pulse rounded bg-white/10" />
              <div class="h-3 w-72 animate-pulse rounded bg-white/5" />
            </div>
            <div class="h-8 w-16 shrink-0 animate-pulse rounded bg-white/5" />
          </li>
        ))}
      </ul>
    </section>

    <!-- Recent closed -->
    <section class="mt-12">
      <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-ink-primary">
        <span class="inline-block h-2 w-2 rounded-full bg-slate-500" aria-hidden="true"></span>
        Recent (<span data-count="recent">{recentClosedSessions.length.toString()}</span>)
      </h2>
      <p data-empty="recent" class="hidden text-sm text-ink-muted">No recent sessions.</p>
      <ul
        data-list="recent"
        class="divide-y divide-slate-200 rounded-lg border border-white/10 bg-surface-raised"
      >
        {[0, 1].map(() => (
          <li
            data-skeleton="true"
            class="flex items-start justify-between gap-6 px-6 py-4"
            aria-hidden="true"
          >
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-4 w-56 animate-pulse rounded bg-white/10" />
              <div class="h-3 w-64 animate-pulse rounded bg-white/5" />
            </div>
            <div class="h-4 w-24 shrink-0 animate-pulse rounded bg-white/5" />
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-8 text-xs text-ink-muted">
      Recordings retained 90 days hot, archived to R2 after that. Admin-only
      access initially per ADR-006; customer-facing recording UI lands when
      the V-040 R2 mirror ships.
    </p>
  </div>

  <!--
 — progressive-enhancement script. Reads ds_web_session_token
    from localStorage, fetches /v1/sessions, replaces the active +
    recent lists. Falls back to mock-rendered lists when token is
 absent or fetch fails. Mirrors /usage pattern.
  -->
  <script is:inline define:vars={{ apiBaseUrl, tierConcurrentLimits }}>
    (function () {
      const root = document.querySelector('[data-page="sessions"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

// Wave 1119 / Slice 1119.5 B3 — post-onboarding "what to do next"
      // banner. Trigger: URL ?onboarded=1 (set by the /first-session
      // redirect) OR the presence of ds_first_api_key_plaintext in
      // sessionStorage (same window, fallback for non-URL-driven nav).
      // Dismissal persists via ds_next_steps_dismissed in
      // sessionStorage so a refresh doesn't re-show the banner.
      (function showNextStepsBanner() {
        const urlOnboarded = new URLSearchParams(window.location.search).get('onboarded') === '1';
        const stashedKey = sessionStorage.getItem('ds_first_api_key_plaintext');
        const dismissed = sessionStorage.getItem('ds_next_steps_dismissed') === '1';
        if (dismissed) return;
        if (!urlOnboarded && !stashedKey) return;
        const banner = root.querySelector('[data-next-steps]');
        const dismissBtn = root.querySelector('[data-next-steps-dismiss]');
        if (!banner || !dismissBtn) return;
        banner.classList.remove('hidden');
        dismissBtn.addEventListener('click', () => {
          sessionStorage.setItem('ds_next_steps_dismissed', '1');
          banner.classList.add('hidden');
        });
      })();

      // Wave 1086+ — first-session API key reveal. Reads the plaintext
      // stashed by /first-session in sessionStorage; surfaces it inline
      // with copy + dismiss. Cleared from sessionStorage on dismiss so
      // a subsequent page reload doesn't re-show it (the server has
      // already hashed the key — there's no recovery if the customer
      // didn't copy it the first time).
      (function showFirstKeyReveal() {
        const stashedKey = sessionStorage.getItem('ds_first_api_key_plaintext');
        if (!stashedKey) return;
        const reveal = root.querySelector('[data-first-key-reveal]');
        const plaintextEl = root.querySelector('[data-first-key-plaintext]');
        const copyBtn = root.querySelector('[data-first-key-copy]');
        const copyFb = root.querySelector('[data-first-key-copy-feedback]');
        const dismissBtn = root.querySelector('[data-first-key-dismiss]');
        if (!reveal || !plaintextEl || !copyBtn || !dismissBtn) return;
        plaintextEl.textContent = stashedKey;
        reveal.classList.remove('hidden');
        copyBtn.addEventListener('click', () => {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(stashedKey).then(() => {
              if (copyFb) {
                copyFb.classList.remove('hidden');
                window.setTimeout(() => copyFb.classList.add('hidden'), 2000);
              }
            });
          }
        });
        dismissBtn.addEventListener('click', () => {
          sessionStorage.removeItem('ds_first_api_key_plaintext');
          reveal.classList.add('hidden');
        });
      })();

      const STATUS_BADGE_CLASS = {
        creating: 'bg-glow-red/10 text-glow-red',
        ready: 'bg-emerald-400/10 text-emerald-300',
        busy: 'bg-blue-50 text-blue-700',
        destroyed: 'bg-surface-raised text-ink-secondary',
        errored: 'bg-red-50 text-red-700',
      };

      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }
      function fmtDuration(ms) {
        if (ms === null || ms === undefined) return '—';
        const sec = Math.floor(ms / 1000);
        const min = Math.floor(sec / 60);
        const hr = Math.floor(min / 60);
        if (hr > 0) return hr + 'h ' + (min % 60) + 'm';
        if (min > 0) return min + 'm ' + (sec % 60) + 's';
        return sec + 's';
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function activeLi(s) {
        const profileFrag =
          s.profile_id !== null && s.profile_id !== undefined
            ? ' · profile <code class="font-mono">' + escapeHtml(s.profile_id.slice(0, 16)) + '…</code>'
            : '';
        // Arc 5 EGRESS eg.5 — proxy-warning indicator. When the
        // harness reports warnings on this session's egress
        // capabilities (e.g. udp_unsupported_by_proxy,
        // dns_remote_resolve_unsupported_by_proxy), surface a small
        // badge on the row so the customer sees the issue without
        // opening a detail panel.
        const warnings =
          s.egress_capabilities && Array.isArray(s.egress_capabilities.warnings)
            ? s.egress_capabilities.warnings
            : [];
        const warningBadge =
          warnings.length > 0
            ? '<span class="inline-flex rounded-full bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-amber-400" title="' +
              escapeHtml(warnings.join(', ')) +
              '">⚠ proxy ' +
              warnings.length +
              '</span>'
            : '';
        return (
          '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<div class="flex items-center gap-3">' +
          '<p class="font-mono text-sm font-medium text-ink-primary">' +
          escapeHtml(s.id) +
          '</p>' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (STATUS_BADGE_CLASS[s.status] || '') +
          '">' +
          escapeHtml(s.status) +
          '</span>' +
          warningBadge +
          '</div>' +
          '<p class="mt-1 text-xs text-ink-muted">Archetype <code class="font-mono">' +
          escapeHtml(s.archetype) +
          '</code> · started ' +
          escapeHtml(fmtIso(s.created_at)) +
          profileFrag +
          '</p></div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<a href="#detail-' +
          escapeHtml(s.id) +
          '" class="text-sm text-glow-red hover:underline">Open</a>' +
          '<a href="#destroy-' +
          escapeHtml(s.id) +
          '" class="text-sm text-red-700 hover:underline">Destroy</a>' +
          '</div></li>'
        );
      }

      function recentLi(s) {
        const durationMs =
          s.created_at && s.destroyed_at
            ? new Date(s.destroyed_at).getTime() - new Date(s.created_at).getTime()
            : null;
        // Arc 5 EGRESS eg.5.b — same proxy-warning badge as active
        // rows. Closed sessions can carry warnings from the harness
        // report, and customers reviewing recent runs need the same
        // at-a-glance health cue.
        const warnings =
          s.egress_capabilities && Array.isArray(s.egress_capabilities.warnings)
            ? s.egress_capabilities.warnings
            : [];
        const warningBadge =
          warnings.length > 0
            ? '<span class="inline-flex rounded-full bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-amber-400" title="' +
              escapeHtml(warnings.join(', ')) +
              '">⚠ proxy ' +
              warnings.length +
              '</span>'
            : '';
        return (
          '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<div class="flex items-center gap-3">' +
          '<p class="font-mono text-sm text-ink-secondary">' +
          escapeHtml(s.id) +
          '</p>' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (STATUS_BADGE_CLASS[s.status] || '') +
          '">' +
          escapeHtml(s.status) +
          '</span>' +
          warningBadge +
          '</div>' +
          '<p class="mt-1 text-xs text-ink-muted">Ran ' +
          escapeHtml(fmtDuration(durationMs)) +
          ' · destroyed ' +
          escapeHtml(fmtIso(s.destroyed_at)) +
          '</p></div>' +
          '<a href="#replay-' +
          escapeHtml(s.id) +
          '" class="text-sm text-glow-red hover:underline">View recording</a>' +
          '</li>'
        );
      }

      function renderList(selector, sessions, kind) {
        const ul = root.querySelector('[data-list="' + kind + '"]');
        const empty = root.querySelector('[data-empty="' + kind + '"]');
        const count = root.querySelector('[data-count="' + kind + '"]');
        if (count) count.textContent = sessions.length.toString();
        if (sessions.length === 0) {
          ul.classList.add('hidden');
          empty.classList.remove('hidden');
          return;
        }
        empty.classList.add('hidden');
        ul.classList.remove('hidden');
        const liFn = kind === 'active' ? activeLi : recentLi;
        ul.innerHTML = sessions.map(liFn).join('');
      }

      function setText(field, text) {
        const el = root.querySelector('[data-field="' + field + '"]');
        if (el) el.textContent = text;
      }

      // V-186 — concurrent meter wiring. concurrent_now derived from
      // the live /v1/sessions response (active states), concurrent_limit
      // from /v1/usage.tier mapped via tierConcurrentLimits. We update
      // each meter half independently so a partial failure (e.g. usage
      // 5xx) still surfaces the active count from sessions.
      function updateMeter(now, cap) {
        if (now !== null) {
          setText('header-now', String(now));
          setText('meter-now', String(now));
        }
        if (cap !== null) {
          setText('header-cap', String(cap));
          setText('meter-cap', String(cap));
        }
        const bar = root.querySelector('[data-field="meter-bar"]');
        if (bar && now !== null && cap !== null && cap > 0) {
          const pct = Math.min(100, Math.max(0, (now / cap) * 100));
          bar.style.width = pct.toFixed(1) + '%';
        }
      }

      if (!token) {
        showBanner('Sign in to see live sessions. Showing preview data below.');
        return;
      }

      let currentNow = null;
      let currentCap = null;

      const sessionsP = fetch(apiBaseUrl + '/v1/sessions', {
        headers: {
          authorization: 'Bearer ' + token,
          ...(typeof window.driftstackActAsHeaders === 'function'
            ? window.driftstackActAsHeaders()
            : {}),
        },
        credentials: 'include',
      })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
        .then((body) => {
          const sessions = body.data || [];
          const active = sessions.filter(
            (s) => s.status !== 'destroyed' && s.status !== 'errored',
          );
          const recent = sessions.filter(
            (s) => s.status === 'destroyed' || s.status === 'errored',
          );
          renderList('active', active, 'active');
          renderList('recent', recent, 'recent');
          currentNow = active.length;
          updateMeter(currentNow, currentCap);
          if (sessions.length === 0) {
            showBanner('No sessions yet — create one to get started.');
          }
        })
        .catch((err) => {
          showBanner(
            "Couldn't load live sessions (" +
              (err && err.message ? err.message : 'network error') +
              '). Showing preview data below.',
          );
        });

      const usageP = fetch(apiBaseUrl + '/v1/usage', {
        headers: {
          authorization: 'Bearer ' + token,
          ...(typeof window.driftstackActAsHeaders === 'function'
            ? window.driftstackActAsHeaders()
            : {}),
        },
        credentials: 'include',
      })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
        .then((body) => {
          const tier = body && body.tier ? body.tier : null;
          const cap = tier && tierConcurrentLimits[tier] ? tierConcurrentLimits[tier] : null;
          if (cap !== null) {
            currentCap = cap;
            updateMeter(currentNow, currentCap);
          }
        })
        .catch(() => {
          // Usage failure is non-fatal — leave the cap as the SSG
          // mock value rather than hiding it.
        });

      void Promise.all([sessionsP, usageP]).finally(function () {
        // 2026-05-21 — signal the layout's opacity-gate that the
        // primary /v1/sessions + /v1/usage fetches resolved (success or
        // failure). Skeleton <li>s already swapped via sessionsP's then.
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
      });
    })();
  </script>
</DashboardLayout>
