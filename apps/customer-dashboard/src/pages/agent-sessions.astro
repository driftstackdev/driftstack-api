---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { resolveApiBaseUrl } from '../lib/api-base-url';

// v2-#8 Wave 2.C sub-slice 8.24 — agent-sessions page scaffold.
//
// Customer-facing surface for the AI chat + manual side-by-side
// feature. Reads from POST/GET /v1/agent-sessions; sub-slices 8.25
// through 8.28 will fill in the ModeSelector / TakeoverHandbackButtons
// / TranscriptStream / BundledLlmStatusPanel / MessageComposer
// inline blocks below.
//
// Activation gate: same pattern as v2-#8 sub-slice 8.20.h — the
// page renders the empty state + "Feature not enabled" banner when
// POST /v1/agent-sessions returns 503 FeatureUnavailable.

const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Agent sessions">
  <div class="mx-auto max-w-4xl px-6 py-10" data-page="agent-sessions">
    {/* 2026-05-22 — ChatGPT-style hero. Centered headline + tagline +
        prompt-suggestion grid. The actual composer + create-session
        form lives below, but this hero is the first thing customers
        see and tells them clearly what the agent can do. */}
    <header class="mb-8 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-glow-red/10 ring-1 ring-glow-red/30">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-glow-red" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
        </svg>
      </div>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink-primary">
        What can I help you automate?
      </h1>
      <p class="mt-2 max-w-prose text-sm text-ink-muted mx-auto">
        Describe a task in plain English. The AI plans the steps; your remote browser
        carries them out, live. Take over with one click whenever you want.
      </p>
    </header>

    <div
      data-banner-feature-unavailable
      class="mb-6 hidden rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200"
      role="status"
    >
      <strong>Feature not enabled in this deployment.</strong>
      The AI agent layer requires an LLM key path (BYOK or bundled) to be configured.
      Two self-serve options:
      <a
        href="https://docs.driftstack.dev/api/byok-anthropic/"
        class="underline hover:text-amber-100"
        target="_blank"
        rel="noopener noreferrer"
        data-link="byok-anthropic">bring your own Anthropic key</a
      > (encrypted at rest)
      or
      <a
        href="https://docs.driftstack.dev/api/bundled-llm/"
        class="underline hover:text-amber-100"
        target="_blank"
        rel="noopener noreferrer"
        data-link="bundled-llm">opt into the deployment's bundled-LLM budget</a
      > (Anthropic, pre-paid by Driftstack).
      Either path activates this surface.
    </div>

    <div
      data-banner-unauthenticated
      class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
      role="status"
    >
      Sign in to start an agent session.
    </div>

    {/* 2026-05-22 — recent sessions history. Auto-populated by the
        inline script from GET /v1/agent-sessions (Slice 3 list
        endpoint). Hidden when the customer has no sessions yet so
        the create-form below is the primary CTA on first visit. */}
    <section
      data-section="recent-sessions"
      class="mb-8 hidden rounded-lg border border-white/10 bg-surface-raised/50 p-5"
    >
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
          Recent agent sessions
        </h2>
        <span data-recent-count class="text-xs text-ink-muted">—</span>
      </div>
      <ul data-recent-list class="mt-4 divide-y divide-white/5">
        {/* Rows rendered by JS — see the script section. */}
      </ul>
    </section>

    {/* 2026-05-22 — prompt suggestion cards. ChatGPT-style 4-up
        grid; click prefills the composer + focuses it (customer
        edits before submit). Real-world examples customers
        actually run rather than generic "ask me anything". */}
    <section class="mb-8">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <button
          type="button"
          data-prompt-suggestion="Log in to my Gmail and reply to messages from contact@example.com with a polite acknowledgement."
          class="rounded-lg border border-white/10 bg-surface-raised/50 p-4 text-left hover:border-glow-red/40 hover:bg-surface-raised"
        >
          <p class="text-2xl">📧</p>
          <p class="mt-2 text-sm font-medium text-ink-primary">Triage email</p>
          <p class="mt-1 text-xs text-ink-muted">Reply to messages from a specific sender.</p>
        </button>
        <button
          type="button"
          data-prompt-suggestion="Take a full-page screenshot of https://example.com/dashboard and describe what's visible on it."
          class="rounded-lg border border-white/10 bg-surface-raised/50 p-4 text-left hover:border-glow-red/40 hover:bg-surface-raised"
        >
          <p class="text-2xl">📸</p>
          <p class="mt-2 text-sm font-medium text-ink-primary">Audit a page</p>
          <p class="mt-1 text-xs text-ink-muted">Screenshot + describe what the agent sees.</p>
        </button>
        <button
          type="button"
          data-prompt-suggestion="Fill the contact form at https://example.com/contact with name 'Casey Demo', email 'casey@example.com', and message 'Test from Driftstack', then submit."
          class="rounded-lg border border-white/10 bg-surface-raised/50 p-4 text-left hover:border-glow-red/40 hover:bg-surface-raised"
        >
          <p class="text-2xl">✍️</p>
          <p class="mt-2 text-sm font-medium text-ink-primary">Fill a form</p>
          <p class="mt-1 text-xs text-ink-muted">Multi-field form completion + submit.</p>
        </button>
        <button
          type="button"
          data-prompt-suggestion="Navigate to my LinkedIn inbox and tell me how many unread messages I have."
          class="rounded-lg border border-white/10 bg-surface-raised/50 p-4 text-left hover:border-glow-red/40 hover:bg-surface-raised"
        >
          <p class="text-2xl">🔍</p>
          <p class="mt-2 text-sm font-medium text-ink-primary">Quick lookup</p>
          <p class="mt-1 text-xs text-ink-muted">Navigate + report what's there.</p>
        </button>
      </div>
    </section>

    {/* 2026-05-22 — ChatGPT-style centered composer card. Replaces
        the old 3-column ModeSelector + Mode form. Mode chips
        compact above the textarea; composer takes the focus. */}
    <section data-section="composer" class="mb-6">
      <form
        data-form="create-session"
        class="rounded-2xl border border-white/10 bg-surface-raised shadow-lg shadow-glow-red/5 focus-within:border-glow-red/40 focus-within:ring-1 focus-within:ring-glow-red/20 transition-colors"
      >
        <div class="px-5 pt-4">
          {/* Mode chip-bar (was the radio form below; now inline). */}
          <div
            class="inline-flex rounded-md border border-white/10 bg-surface-base p-0.5 text-xs"
            role="radiogroup"
            aria-label="Session mode"
          >
            <label class="cursor-pointer">
              <input type="radio" name="mode" value="ai" class="peer sr-only" />
              <span class="inline-flex items-center gap-1.5 rounded-md px-3 py-1 text-ink-muted peer-checked:bg-glow-red/15 peer-checked:text-glow-red">
                <span class="text-[10px] uppercase tracking-wide">AI</span>
              </span>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mode" value="pair" class="peer sr-only" checked />
              <span class="inline-flex items-center gap-1.5 rounded-md px-3 py-1 text-ink-muted peer-checked:bg-glow-red/15 peer-checked:text-glow-red">
                <span class="text-[10px] uppercase tracking-wide">Pair</span>
              </span>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="mode" value="manual" class="peer sr-only" />
              <span class="inline-flex items-center gap-1.5 rounded-md px-3 py-1 text-ink-muted peer-checked:bg-glow-red/15 peer-checked:text-glow-red">
                <span class="text-[10px] uppercase tracking-wide">Manual</span>
              </span>
            </label>
            <span class="ml-2 inline-flex items-center text-[10px] text-ink-muted">
              <span data-mode-hint>Pair · AI plans, you can take over anytime</span>
            </span>
          </div>
        </div>
        <textarea
          name="initial_task"
          rows="4"
          maxlength="8000"
          placeholder="Describe what you want the agent to do…
e.g. 'Open my Gmail and reply to support@example.com with a polite acknowledgement'"
          class="w-full resize-none bg-transparent px-5 py-4 text-base text-ink-primary placeholder-slate-500 focus:outline-none"
        ></textarea>
        <div class="flex items-center justify-between gap-3 border-t border-white/5 px-5 py-3">
          <div class="flex items-center gap-2 text-[11px] text-ink-muted">
            <kbd class="rounded border border-slate-700 bg-slate-900/80 px-1.5 py-0.5 font-mono">⌘</kbd>
            <kbd class="rounded border border-slate-700 bg-slate-900/80 px-1.5 py-0.5 font-mono">↵</kbd>
            <span>to start the session</span>
          </div>
          <button
            type="submit"
            class="inline-flex items-center gap-1.5 rounded-md bg-glow-red px-5 py-2 text-sm font-medium text-white shadow-sm hover:bg-glow-red/90"
          >
            Start session
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </form>
      <p class="mt-3 text-center text-xs text-ink-muted">
        Sessions live for 24h by default · billed only while active · cancel
        anytime · <a href="/select-tier" class="text-glow-red hover:underline">tier limits</a>
      </p>
    </section>

    {/* Legacy 3-col panel preserved for active-session takeover / bundled-LLM
        status / livekit-info; visually demoted below the chat-first hero
        above + only shown when the customer has an active session. */}
    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Main panel (active-session block; create form was lifted to the
           ChatGPT-style composer above). -->
      <section class="lg:col-span-2 space-y-6">

        <!-- 8.26 TakeoverHandbackButtons + 8.27 TranscriptStream slots; populated
             when the dashboard creates / selects a session. -->
        <div
          data-section="active-session"
          class="hidden rounded-lg border border-white/10 bg-surface-raised p-5"
        >
          <div class="flex items-center justify-between gap-4">
            <p class="font-mono text-xs text-ink-secondary" data-field="active-session-id">—</p>
            <span
              data-field="pair-mode-state"
              class="inline-flex rounded-full bg-white/5 px-2 py-0.5 text-xs font-medium text-ink-secondary"
            ></span>
          </div>

          <!-- 8.26 TakeoverHandbackButtons slot -->
          <div class="mt-4 flex gap-2" data-section="takeover-handback">
            <button
              data-action="takeover"
              type="button"
              class="hidden rounded-md border border-glow-red/30 bg-glow-red/10 px-4 py-2 text-sm font-medium text-glow-red hover:bg-glow-red/20"
            >
              Take over
            </button>
            <button
              data-action="handback"
              type="button"
              class="hidden rounded-md border border-white/10 bg-surface-base px-4 py-2 text-sm font-medium text-ink-primary hover:bg-surface-raised"
            >
              Hand back
            </button>
          </div>

          <!-- 8.27 TranscriptStream slot -->
          <ul
            data-list="transcript"
            class="mt-4 max-h-96 space-y-2 overflow-y-auto rounded border border-white/10 bg-surface-base p-3"
            aria-live="polite"
            aria-label="Agent session transcript"
          >
            <li class="text-xs italic text-ink-muted">Transcript will appear here…</li>
          </ul>

          <!-- 8.28.b MessageComposer slot -->
          <form data-form="message" class="mt-4 flex gap-2">
            <input
              type="text"
              name="user_message"
              placeholder="Tell the AI what to do…"
              aria-label="Message to the AI agent"
              class="flex-1 rounded-md border border-white/10 bg-surface-base px-3 py-2 text-sm shadow-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red/30"
            />
            <button
              type="submit"
              class="rounded-md bg-glow-red px-4 py-2 text-sm font-medium text-white hover:bg-glow-red/90"
            >
              Send
            </button>
          </form>
        </div>
      </section>

      <!-- 8.28 BundledLlmStatusPanel slot (right rail) -->
      <aside class="space-y-4" data-section="bundled-llm-status">
        <div class="rounded-lg border border-white/10 bg-surface-raised p-5">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
            Bundled LLM status
          </h2>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex items-center justify-between">
              <dt class="text-ink-muted">Consent</dt>
              <dd data-field="consent" class="font-mono text-xs text-ink-secondary">—</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-ink-muted">Monthly cap</dt>
              <dd data-field="cap" class="font-mono text-xs text-ink-secondary">—</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-ink-muted">Used this month</dt>
              <dd data-field="used" class="font-mono text-xs text-ink-secondary">—</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-ink-muted">Remaining</dt>
              <dd data-field="remaining" class="font-mono text-xs text-ink-secondary">—</dd>
            </div>
          </dl>
        </div>

        <!--
          LK arc — Live video info card. Surfaces whether the
          current session has a LiveKit join URL available + a
          one-click link to the integration guide. Empty (hidden)
          by default; the dashboard JS reveals it after session
          create when the response carries the `livekit` field.
        -->
        <div
          class="hidden rounded-lg border border-white/10 bg-surface-raised p-5"
          data-section="livekit-info"
        >
          <h2 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">
            Live video
          </h2>
          <p class="mt-3 text-xs text-ink-secondary">
            This session publishes its browser video stream to a per-Mac
            LiveKit room. Subscribe from the desktop GUI client or via
            <a
              href="https://docs.driftstack.dev/guides/live-video/"
              class="underline hover:text-glow-red"
              target="_blank"
              rel="noopener noreferrer">livekit-client</a
            >.
          </p>
          <dl class="mt-3 space-y-1.5 text-xs">
            <div class="flex flex-col">
              <dt class="text-ink-muted">Room</dt>
              <dd
                data-field="livekit-room"
                class="overflow-x-auto whitespace-nowrap font-mono text-ink-secondary"
              ></dd>
            </div>
            <div class="flex flex-col">
              <dt class="text-ink-muted">WebSocket URL</dt>
              <dd
                data-field="livekit-ws-url"
                class="overflow-x-auto whitespace-nowrap font-mono text-ink-secondary"
              ></dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="agent-sessions"]');
      if (!root) return;
      const featureBanner = root.querySelector('[data-banner-feature-unavailable]');
      const authBanner = root.querySelector('[data-banner-unauthenticated]');
      const token = localStorage.getItem('ds_web_session_token');
      if (!token) {
        if (authBanner) authBanner.classList.remove('hidden');
        return;
      }

      // Best-effort probe: hit the create-session disabled-stub via OPTIONS
      // semantics replacement — actually just attempt to read the
      // bundled-llm-status endpoint, which surfaces 503 in the same
      // posture when the activation gate is off.
      fetch(apiBaseUrl + '/v1/account/me/bundled-llm-status', {
        headers: { authorization: 'Bearer ' + token },
      })
        .then((res) => {
          if (res.status === 503) {
            if (featureBanner) featureBanner.classList.remove('hidden');
          }
        })
        .catch(() => {
          /* swallow — network issues handled separately */
        })
        .finally(() => {
          // 2026-05-21 — opacity-gate hydrate signal (same pattern
          // as the other dashboard pages).
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // 2026-05-22 — recent agent sessions list. Fetches the new
      // GET /v1/agent-sessions endpoint, renders each row as a
      // clickable link to the workbench detail page. Hidden when
      // the customer has no past sessions (lets the create form
      // dominate on first visit).
      const recentSection = root.querySelector('[data-section="recent-sessions"]');
      const recentList = root.querySelector('[data-recent-list]');
      const recentCount = root.querySelector('[data-recent-count]');
      function escHtmlForRecent(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }
      function fmtRecentAge(iso) {
        if (!iso) return '—';
        const ms = Date.now() - new Date(iso).getTime();
        if (!Number.isFinite(ms) || ms < 0) return '—';
        const min = Math.floor(ms / 60000);
        if (min < 60) return min.toString() + 'm ago';
        const hr = Math.floor(min / 60);
        if (hr < 48) return hr.toString() + 'h ago';
        const days = Math.floor(hr / 24);
        return days.toString() + 'd ago';
      }
      const STATUS_BADGE = {
        active: 'bg-emerald-500/15 text-emerald-300',
        closed: 'bg-slate-700/40 text-slate-300',
        paused: 'bg-amber-500/15 text-amber-300',
        errored: 'bg-rose-500/15 text-rose-300',
      };
      fetch(apiBaseUrl + '/v1/agent-sessions', {
        headers: { authorization: 'Bearer ' + token },
      })
        .then((r) => (r.ok ? r.json() : Promise.resolve({ data: [] })))
        .then((body) => {
          const data = Array.isArray(body.data) ? body.data : [];
          if (data.length === 0 || !recentList || !recentSection) return;
          if (recentCount)
            recentCount.textContent =
              data.length.toString() + ' session' + (data.length === 1 ? '' : 's');
          recentList.innerHTML = data
            .map((s) => {
              const id = escHtmlForRecent(s.id || '');
              const mode = escHtmlForRecent(s.mode || 'ai');
              const status = escHtmlForRecent(s.status || 'active');
              const badge =
                STATUS_BADGE[status] || 'bg-slate-700/40 text-slate-300';
              const age = escHtmlForRecent(fmtRecentAge(s.created_at));
              const tokens =
                typeof s.tokens_used === 'number'
                  ? s.tokens_used.toLocaleString()
                  : '—';
              return (
                '<li class="py-3 flex items-center justify-between gap-4 hover:bg-white/5 px-2 -mx-2 rounded">' +
                '<a href="/agent-sessions/' +
                id +
                '" class="flex-1 min-w-0">' +
                '<p class="font-mono text-xs text-ink-muted truncate">' +
                id +
                '</p>' +
                '<p class="mt-0.5 text-xs text-ink-muted">' +
                age +
                ' · ' +
                tokens +
                ' tokens</p>' +
                '</a>' +
                '<span class="inline-flex items-center gap-1.5 rounded-full bg-glow-red/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-glow-red">' +
                mode +
                '</span>' +
                '<span class="inline-flex items-center rounded-full ' +
                badge +
                ' px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide">' +
                status +
                '</span>' +
                '</li>'
              );
            })
            .join('');
          recentSection.classList.remove('hidden');
        })
        .catch(() => {
          /* swallow — feature might be 503 in this deployment */
        });

      // v2-#8 Wave 2.C sub-slice 8.25 — create-session form wiring.
      // POSTs to /v1/agent-sessions with the selected mode; on
      // success, populates the active-session block + reveals it.
      const createForm = root.querySelector('[data-form="create-session"]');
      const activeSection = root.querySelector('[data-section="active-session"]');
      const activeIdEl = root.querySelector('[data-field="active-session-id"]');
      const stateEl = root.querySelector('[data-field="pair-mode-state"]');
      const takeoverBtn = root.querySelector('[data-action="takeover"]');
      const handbackBtn = root.querySelector('[data-action="handback"]');

      // v2-#8 Wave 2.C sub-slice 8.26 — render the takeover/handback
      // buttons based on the current pair_mode_state.kind. Mirrors
      // the design doc 8.23 §"TakeoverHandbackButtons.astro": the
      // active action depends on the state-machine discriminator.
      function renderTakeoverHandback(state, mode) {
        if (mode !== 'pair' || !state || !takeoverBtn || !handbackBtn) {
          if (takeoverBtn) takeoverBtn.classList.add('hidden');
          if (handbackBtn) handbackBtn.classList.add('hidden');
          return;
        }
        const kind = state.kind;
        if (kind === 'ai-driving' || kind === 'takeover-queued') {
          takeoverBtn.classList.remove('hidden');
          handbackBtn.classList.add('hidden');
        } else if (kind === 'human-driving' || kind === 'handback-queued') {
          takeoverBtn.classList.add('hidden');
          handbackBtn.classList.remove('hidden');
        } else {
          // takeover-pending / handback-pending — neither button
          // active; the state badge above carries the spinner-state.
          takeoverBtn.classList.add('hidden');
          handbackBtn.classList.add('hidden');
        }
      }

      let activeSessionId = null;
      let activeMode = null;

      // 2026-05-22 — ChatGPT-style prompt-suggestion chips. Click
      // prefills the textarea + focuses it so the customer can
      // edit before pressing Start.
      const composerTa = root.querySelector('textarea[name="initial_task"]');
      document.querySelectorAll('[data-prompt-suggestion]').forEach((el) => {
        el.addEventListener('click', () => {
          const text = el.getAttribute('data-prompt-suggestion') ?? '';
          if (composerTa && text.length > 0) {
            composerTa.value = text;
            composerTa.focus();
          }
        });
      });

      // Mode-hint label updates as the radio chip changes. Same
      // shape across the three modes; tells the customer in one
      // sentence what they signed up for.
      const modeHint = root.querySelector('[data-mode-hint]');
      const MODE_HINT = {
        ai: 'AI · Driftstack writes the plan + executes',
        pair: 'Pair · AI plans, you can take over anytime',
        manual: 'Manual · you click; agent watches',
      };
      root.querySelectorAll('input[name="mode"]').forEach((el) => {
        el.addEventListener('change', () => {
          if (modeHint && el.checked) modeHint.textContent = MODE_HINT[el.value] ?? '';
        });
      });

      // ⌘+Enter sends the composer (same convention as the workbench).
      if (composerTa) {
        composerTa.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' && (ev.metaKey || ev.ctrlKey)) {
            ev.preventDefault();
            createForm?.dispatchEvent(new Event('submit', { cancelable: true }));
          }
        });
      }

      if (createForm) {
        createForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const fd = new FormData(createForm);
          const mode = fd.get('mode') ?? 'pair';
          fetch(apiBaseUrl + '/v1/agent-sessions', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify({ mode }),
          })
            .then((r) => {
              if (r.status === 503) {
                if (featureBanner) featureBanner.classList.remove('hidden');
                throw new Error('feature-unavailable');
              }
              if (!r.ok) {
                // Non-503 4xx / 5xx — surface a typed toast so the
                // customer sees an HTTP code (the form silently
                // failing was hostile).
                const httpStatus = r.status;
                throw new Error('http ' + httpStatus);
              }
              return r.json();
            })
            .then((session) => {
              activeSessionId = session.id;
              activeMode = session.mode;
              if (activeIdEl) activeIdEl.textContent = session.id;
              const initialState =
                session.mode === 'pair' ? { kind: 'ai-driving' } : null;
              if (stateEl) stateEl.textContent = initialState ? initialState.kind : '';
              renderTakeoverHandback(initialState, session.mode);
              if (activeSection) activeSection.classList.remove('hidden');
              // LK arc — surface the optional `livekit` field when
              // the deployment is LK-ready. Card stays hidden when
              // session.livekit is absent (pre-LK deployment OR no
              // Mac registered yet).
              renderLivekitInfo(session.livekit);
              // Wave 2.C sub-slice 8.27 — start the SSE transcript
              // stream now that we have a valid session id.
              createForm.dispatchEvent(
                new CustomEvent('agent-session-created', { detail: { id: session.id } }),
              );
            })
            .catch((err) => {
              const msg = err && err.message ? String(err.message) : '';
              // feature-unavailable: the banner reveal above is the
              // canonical UX; no toast needed (the banner is more
              // informative than a transient toast).
              if (msg === 'feature-unavailable') return;
              if (msg.startsWith('http ')) {
                showToast('error', 'Session create failed (HTTP ' + msg.slice(5) + ').');
              } else {
                showToast('error', 'Session create failed — network error.');
              }
            });
        });
      }

      // LK arc — render the optional `livekit` field from the
      // session-create response. The card lives in the right rail;
      // visibility flips based on whether the server included the
      // field. Two displayed values: room name + ws_url (the join
      // info needed to subscribe via livekit-client). Token is
      // intentionally NOT surfaced here — the dashboard is a
      // presentational consumer; the desktop GUI client does the
      // actual subscribe.
      function renderLivekitInfo(livekit) {
        const card = root.querySelector('[data-section="livekit-info"]');
        if (!card) return;
        if (livekit && typeof livekit.room === 'string' && typeof livekit.ws_url === 'string') {
          const roomEl = card.querySelector('[data-field="livekit-room"]');
          const wsEl = card.querySelector('[data-field="livekit-ws-url"]');
          if (roomEl) roomEl.textContent = livekit.room;
          if (wsEl) wsEl.textContent = livekit.ws_url;
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      }

      // v2-#8 Wave 2.C sub-slice 8.26.b — toast surface for typed
      // 409 PairModeStateInvalidTransitionError. The route returns
      // RFC 7807 problem+json with `from` + `transition` extension
      // fields naming the conflict precisely; we surface those to
      // the customer instead of silently swallowing.
      function showToast(kind, message) {
        const container = ensureToastContainer();
        const toast = document.createElement('div');
        const bg =
          kind === 'error'
            ? 'bg-red-500/10 border-red-500/30 text-red-200'
            : kind === 'warn'
              ? 'bg-amber-500/10 border-amber-500/30 text-amber-200'
              : 'bg-white/5 border-white/10 text-ink-secondary';
        toast.className =
          'pointer-events-auto rounded-md border px-4 py-2 text-sm shadow-lg ' + bg;
        toast.setAttribute('data-toast', kind);
        toast.textContent = message;
        container.appendChild(toast);
        // Auto-dismiss after 6s.
        setTimeout(() => {
          toast.remove();
        }, 6000);
      }
      function ensureToastContainer() {
        let c = root.querySelector('[data-toast-container]');
        if (c) return c;
        c = document.createElement('div');
        c.setAttribute('data-toast-container', '');
        c.className =
          'pointer-events-none fixed bottom-4 right-4 z-50 flex max-w-md flex-col gap-2';
        root.appendChild(c);
        return c;
      }

      function describePairModeError(body) {
        // RFC 7807 problem-json shape: { type, title, status, detail,
        // from?, transition? }. The typed error class extracts the
        // last two fields on the SDK side; here we render a customer-
        // visible message.
        const from = body && typeof body.from === 'string' ? body.from : 'unknown state';
        const transition =
          body && typeof body.transition === 'string' ? body.transition : 'unknown transition';
        return (
          'Cannot ' +
          transition.replace(/-request$/, '') +
          ' from ' +
          from +
          " — refresh to see the session's current state."
        );
      }

      // v2-#8 Wave 2.C sub-slice 8.26 + 8.26.b — takeover button click.
      if (takeoverBtn) {
        takeoverBtn.addEventListener('click', () => {
          if (!activeSessionId) return;
          const clientId = 'web-' + token.slice(0, 12);
          fetch(apiBaseUrl + '/v1/agent-sessions/' + activeSessionId + '/takeover', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify({ client_id: clientId }),
          })
            .then((r) => r.json().then((body) => ({ status: r.status, body })))
            .then(({ status, body }) => {
              if (status === 200 && body.pair_mode_state) {
                if (stateEl) stateEl.textContent = body.pair_mode_state.kind;
                renderTakeoverHandback(body.pair_mode_state, activeMode);
              } else if (
                status === 409 &&
                body &&
                typeof body.type === 'string' &&
                body.type.indexOf('pair-mode-invalid-transition') !== -1
              ) {
                showToast('warn', describePairModeError(body));
              } else if (status >= 400) {
                showToast('error', 'Takeover failed (HTTP ' + status + ').');
              }
            })
            .catch(() => {
              showToast('error', 'Takeover failed — network error.');
            });
        });
      }

      if (handbackBtn) {
        handbackBtn.addEventListener('click', () => {
          if (!activeSessionId) return;
          fetch(apiBaseUrl + '/v1/agent-sessions/' + activeSessionId + '/handback', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify({}),
          })
            .then((r) => r.json().then((body) => ({ status: r.status, body })))
            .then(({ status, body }) => {
              if (status === 200 && body.pair_mode_state) {
                if (stateEl) stateEl.textContent = body.pair_mode_state.kind;
                renderTakeoverHandback(body.pair_mode_state, activeMode);
              } else if (
                status === 409 &&
                body &&
                typeof body.type === 'string' &&
                body.type.indexOf('pair-mode-invalid-transition') !== -1
              ) {
                showToast('warn', describePairModeError(body));
              } else if (status >= 400) {
                showToast('error', 'Handback failed (HTTP ' + status + ').');
              }
            })
            .catch(() => {
              showToast('error', 'Handback failed — network error.');
            });
        });
      }

      // v2-#8 Wave 2.C sub-slice 8.27 — TranscriptStream SSE consumer.
      // Honors v2-#19 Last-Event-ID for resume after disconnect. The
      // server publishes transcript-append events on
      // GET /v1/agent-sessions/:id/transcript (SSE).
      const transcriptList = root.querySelector('[data-list="transcript"]');
      let evtSource = null;
      function startTranscriptStream(sessionId) {
        if (evtSource) {
          evtSource.close();
          evtSource = null;
        }
        if (transcriptList) {
          // Clear the placeholder "Transcript will appear here…".
          transcriptList.innerHTML = '';
        }
        // EventSource doesn't support custom Authorization headers.
        // The server-side route accepts the bearer token via cookie OR
        // a query string param (?ds_token=) as a fallback for SSE
        // clients — pin the route layer's contract here.
        const url =
          apiBaseUrl +
          '/v1/agent-sessions/' +
          encodeURIComponent(sessionId) +
          '/transcript?ds_token=' +
          encodeURIComponent(token);
        evtSource = new EventSource(url);
        evtSource.addEventListener('transcript.entry', (ev) => {
          let entry = null;
          try {
            const parsed = JSON.parse(ev.data);
            entry = parsed.entry;
          } catch {
            return;
          }
          if (!entry || !transcriptList) return;
          const li = document.createElement('li');
          const role = entry.role || 'unknown';
          // TranscriptEntry.role union is 'user' | 'agent' | 'operator'
          // (apps/server/src/services/agent-decomposer.ts). The type
          // definition explicitly says "dashboard UI branches on this so
          // manual-driven turns render distinctly" — a pre-2026-05-19
          // version of this handler fell through to the unknown-role
          // bg-white/5 styling for operator entries, which contradicted
          // the type contract. Operator turns now get their own slate-
          // toned chip so manual-mode actions are visually distinct
          // from agent-driven ones.
          li.className =
            'rounded px-2 py-1 text-xs ' +
            (role === 'user'
              ? 'self-end bg-glow-red/10 text-ink-primary'
              : role === 'agent'
                ? 'bg-amber-500/5 text-amber-200'
                : role === 'operator'
                  ? 'bg-sky-500/10 text-sky-200'
                  : 'bg-white/5 text-ink-secondary');
          li.dataset.role = role;
          li.textContent = '[' + role + '] ' + (entry.body || '');
          transcriptList.appendChild(li);
          // Auto-scroll to bottom.
          transcriptList.scrollTop = transcriptList.scrollHeight;
        });
        evtSource.addEventListener('error', () => {
          // Surface a small disconnect indicator; let the browser's
          // EventSource auto-reconnect handle re-establishment.
          if (transcriptList && transcriptList.lastElementChild) {
            const note = document.createElement('li');
            note.className = 'text-xs italic text-ink-muted';
            note.textContent = '(stream reconnecting…)';
            transcriptList.appendChild(note);
          }
        });
      }

      // Wire stream start into the session-create flow + reset on
      // beforeunload to prevent the EventSource from outliving the page.
      const _originalSubmit = createForm
        ? createForm.addEventListener.bind(createForm)
        : null;
      if (createForm) {
        createForm.addEventListener('agent-session-created', (ev) => {
          if (ev.detail && ev.detail.id) {
            startTranscriptStream(ev.detail.id);
          }
        });
      }
      window.addEventListener('beforeunload', () => {
        if (evtSource) {
          evtSource.close();
          evtSource = null;
        }
      });

      // v2-#8 Wave 2.C sub-slice 8.28 — BundledLlmStatusPanel reader.
      // Fetches the current state on page-load (when the customer has
      // a token) and renders consent / cap / used into the right rail.
      const consentEl = root.querySelector('[data-field="consent"]');
      const capEl = root.querySelector('[data-field="cap"]');
      const usedEl = root.querySelector('[data-field="used"]');
      const remainingEl = root.querySelector('[data-field="remaining"]');
      fetch(apiBaseUrl + '/v1/account/me/bundled-llm-status', {
        headers: { authorization: 'Bearer ' + token },
      })
        .then((r) => (r.ok ? r.json() : null))
        .then((status) => {
          if (!status) return;
          if (consentEl) consentEl.textContent = status.consent ? 'opted in' : 'not enabled';
          if (capEl) {
            // GET /v1/account/me/bundled-llm-status returns `cap_cents`,
            // NOT `monthly_cap_usd_cents` (that field name is on the
            // settings endpoint). Reading the wrong field made the cap
            // render as "$0.00" for every customer on this panel.
            const cents = status.cap_cents ?? 0;
            capEl.textContent = '$' + (cents / 100).toFixed(2);
          }
          if (usedEl) {
            const cents = status.used_this_month_cents ?? 0;
            usedEl.textContent = '$' + (cents / 100).toFixed(2);
          }
          if (remainingEl) {
            // remaining_cents is returned by the same endpoint —
            // pre-derived as Math.max(0, cap - used) so the dashboard
            // doesn't have to compute it locally. Surfacing it is the
            // most-actionable number on the panel (customers care
            // about "how much can I still spend?" more than "what's
            // my cap?").
            const cents = status.remaining_cents ?? 0;
            remainingEl.textContent = '$' + (cents / 100).toFixed(2);
          }
        })
        .catch(() => {
          /* swallow */
        });

      // v2-#8 Wave 2.C sub-slice 8.28.b — MessageComposer.
      const msgForm = root.querySelector('[data-form="message"]');
      if (msgForm) {
        msgForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!activeSessionId) return;
          const fd = new FormData(msgForm);
          const userMessage = fd.get('user_message');
          if (!userMessage || typeof userMessage !== 'string') return;
          fetch(apiBaseUrl + '/v1/agent-sessions/' + activeSessionId + '/message', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify({ user_message: userMessage }),
          })
            .then((r) => r.json().then((body) => ({ status: r.status, body })))
            .then(({ status, body }) => {
              if (status === 402) {
                // BundledLlmBudgetExhausted / BundledLlmConsentRequired
                // — highlight the right-rail panel so the customer
                // sees the recovery CTA there + show a toast naming
                // the specific reason (the ring alone reads as visual
                // noise without context).
                const aside = root.querySelector('[data-section="bundled-llm-status"]');
                if (aside) {
                  aside.classList.add('ring-2', 'ring-amber-500/50');
                }
                const detail =
                  body && typeof body.detail === 'string'
                    ? body.detail
                    : 'Bundled-LLM budget required — see right rail.';
                showToast('warn', detail);
              } else if (status >= 400) {
                showToast('error', 'Message failed (HTTP ' + status + ').');
              }
              // Clear input on every settled state — the SSE stream
              // publishes the next entry.
              msgForm.reset();
            })
            .catch(() => {
              showToast('error', 'Message failed — network error.');
            });
        });
      }
    })();
  </script>
</DashboardLayout>
