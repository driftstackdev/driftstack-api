---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-184a — onboarding step 2. Consume verification token, store
// resulting web-session token in localStorage, redirect to /welcome.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Verify email" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="verify-email"
  >
    <p class="section-label">Step 2 of 4</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink-primary" style="letter-spacing: -0.02em;">
      Verify your email
    </h1>
    <p class="mt-3 text-sm text-ink-secondary" data-field="intro">
      We sent a verification token to <span data-field="email" class="font-mono text-glow-red-soft"
        >your email</span
      >. Paste it below to activate your account.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form data-form="verify" class="space-y-5">
        <div>
          <label class="form-label" for="verify-token"> Verification token </label>
          <input
            id="verify-token"
            name="token"
            type="text"
            required
            autocomplete="one-time-code"
            class="form-input font-mono tracking-wider"
            placeholder="Paste your code"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Verify + continue</button>
      </form>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-ink-muted">
        <span>Token expired or never arrived?</span>
        <button
          type="button"
          data-action="resend"
          class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft disabled:cursor-not-allowed disabled:text-ink-muted disabled:no-underline"
        >
          Resend verification email
        </button>
        <span data-field="resend-status" class="hidden text-emerald-300" role="status"></span>
        <span
          >or <a
            href="/signup"
            class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft"
            >restart signup</a
          >.</span
        >
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="verify-email"]');
      if (!root) return;
      const form = root.querySelector('[data-form="verify"]');
      const banner = root.querySelector('[data-banner]');
      const emailEl = root.querySelector('[data-field="email"]');
      const tokenInput = root.querySelector('#verify-token');

      const email = sessionStorage.getItem('ds_signup_email');
      if (email && emailEl) emailEl.textContent = email;
      // V-184a.B — when the user clicks the link in the verify
      // email, the token is already in `?token=…`. Pre-fill the
      // form + auto-submit so they don't have to paste it. The
      // form stays visible as a fallback for the rare case where
      // a recipient mail client mangles the link or the page is
      // hit without the query param.
      const params = new URLSearchParams(window.location.search);
      const linkToken = params.get('token');
      // Pre-fill debug_token from signup response in test/dev mode
      // (kept for back-compat — the URL token wins when both
      // are present).
      const debugToken = sessionStorage.getItem('ds_debug_verify_token');
      const prefill = linkToken ?? debugToken;
      if (prefill && tokenInput) tokenInput.value = prefill;
      if (linkToken) {
        const intro = root.querySelector('[data-field="intro"]');
        if (intro) intro.textContent = 'Verifying your email — one moment…';
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function submitToken(token) {
        banner.classList.add('hidden');

        fetch(apiBaseUrl + '/v1/auth/verify-email', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token }),
          credentials: 'include',
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r.json().then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
            }
            // Cleanup signup-stage state.
            sessionStorage.removeItem('ds_signup_email');
            sessionStorage.removeItem('ds_debug_verify_token');
            // V-267 — honor ?next= round-trip from /cli/authorize and
            // any other deep-link entry. Falls back to /welcome for the
            // first-time onboarding flow.
            const params = new URLSearchParams(window.location.search);
            const next = params.get('next');
            window.location.href = next ? next : '/welcome';
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Verification failed.');
          });
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const fd = new FormData(form);
        const token = fd.get('token');
        if (typeof token === 'string' && token.length > 0) submitToken(token);
      });

      // V-184a.B — auto-submit when the link in the email carried
      // the token. The form stays mounted so failures show the
      // banner + the user can correct or paste manually.
      if (linkToken && linkToken.length > 0) {
        submitToken(linkToken);
      }

      // #187 — self-service resend of the signup-verification email.
      // The signup flow stashes the user's email in sessionStorage
      // under `ds_signup_email`; if it's absent we prompt for it
      // before posting. Server is shape-stable, so the success message
      // is identical regardless of whether the email matched.
      const resendBtn = root.querySelector('[data-action="resend"]');
      const resendStatus = root.querySelector('[data-field="resend-status"]');
      if (resendBtn) {
        resendBtn.addEventListener('click', () => {
          banner.classList.add('hidden');
          let resendEmail = sessionStorage.getItem('ds_signup_email');
          if (!resendEmail) {
            resendEmail = window.prompt('Email address used at signup:') || '';
            resendEmail = resendEmail.trim();
            if (!resendEmail) return;
          }
          resendBtn.disabled = true;
          fetch(apiBaseUrl + '/v1/auth/resend-verification', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: resendEmail }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              if (resendStatus) {
                resendStatus.textContent = 'Sent — check your inbox.';
                resendStatus.classList.remove('hidden');
              }
              // Re-enable after 60s so accidental double-clicks don't
              // burn through the per-IP 3/min cap on the server side.
              window.setTimeout(() => {
                resendBtn.disabled = false;
              }, 60_000);
            })
            .catch((err) => {
              resendBtn.disabled = false;
              showBanner(err && err.message ? err.message : 'Resend failed.');
            });
        });
      }
    })();
  </script>
</DashboardLayout>
