---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-184a — onboarding step 2. Consume verification token, store
// resulting web-session token in localStorage, redirect to /welcome.

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<DashboardLayout title="Verify email" withSidebar={false}>
  <div class="mx-auto max-w-md px-6 py-16" data-page="verify-email">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Verify your email</h1>
    <p class="mt-3 text-sm text-slate-600">
      We sent a verification token to <span data-field="email" class="font-mono">your email</span>.
      Paste it below to activate your account.
    </p>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
      role="status"
    >
    </div>

    <form data-form="verify" class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700" for="verify-token">
          Verification token
        </label>
        <input
          id="verify-token"
          name="token"
          type="text"
          required
          autocomplete="one-time-code"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm"
        />
      </div>
      <button type="submit" class="btn-primary w-full">Verify + continue</button>
    </form>

    <p class="mt-6 text-xs text-slate-500">
      Token expired? <a href="/signup" class="text-oxblood-700 underline">Restart signup</a>.
      (Resend-link flow lands in a future iteration.)
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="verify-email"]');
      if (!root) return;
      const form = root.querySelector('[data-form="verify"]');
      const banner = root.querySelector('[data-banner]');
      const emailEl = root.querySelector('[data-field="email"]');
      const tokenInput = root.querySelector('#verify-token');

      const email = sessionStorage.getItem('ds_signup_email');
      if (email && emailEl) emailEl.textContent = email;
      // Pre-fill debug_token from signup response in test/dev mode.
      const debugToken = sessionStorage.getItem('ds_debug_verify_token');
      if (debugToken && tokenInput) tokenInput.value = debugToken;

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const token = fd.get('token');

        fetch(apiBaseUrl + '/v1/auth/verify-email', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token }),
          credentials: 'include',
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
            }
            // Cleanup signup-stage state.
            sessionStorage.removeItem('ds_signup_email');
            sessionStorage.removeItem('ds_debug_verify_token');
            // V-267 — honor ?next= round-trip from /cli/authorize and
            // any other deep-link entry. Falls back to /welcome for the
            // first-time onboarding flow.
            const params = new URLSearchParams(window.location.search);
            const next = params.get('next');
            window.location.href = next ? next : '/welcome';
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Verification failed.');
          });
      });
    })();
  </script>
</DashboardLayout>
