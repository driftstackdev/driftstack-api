---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-184a — onboarding step 2. Consume verification token, store
// resulting web-session token in localStorage, redirect to /welcome.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Verify email" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="verify-email"
  >
    <p class="section-label">Step 2 of 4</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Verify your email
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      We sent a verification link to <span data-field="email" class="font-mono text-tk-accent-text"
        >your email</span
      >. Click it to activate your account.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div
        data-verify-unknown
        class="mb-5 rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
        hidden
      >
        <a
          data-link="verify-timeout-login"
          href="/login"
          class="btn-primary flex w-full items-center justify-center"
          >Continue to sign in</a
        >
        <p class="mt-3 text-xs text-tk-ink-3">
          If sign-in says the account is still unverified, use “Resend verification email” below.
        </p>
      </div>

      <!-- Issue 3 wave 1085+ — when ?token= is present in the URL
           (the link in the verification email), the form below is
           HIDDEN and the page shows "Verifying… one moment" while
           the auto-submit completes. The form is revealed as a
           manual fallback only when auto-verify fails OR when the
           page is reached without a token in the URL. -->
      <form data-form="verify" class="space-y-5" data-form-fallback hidden>
        <div>
          <label class="form-label" for="verify-token"> Verification token </label>
          <input
            id="verify-token"
            name="token"
            type="text"
            required
            autocomplete="one-time-code"
            class="form-input font-mono tracking-wider"
            placeholder="Paste your code"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Verify + continue</button>
      </form>

      <!-- Auto-verify in-progress indicator. Visible only while the
           ?token= URL path is mid-submit. Replaced by the form on
           failure or by the redirect on success. -->
      <div data-field="auto-verify-spinner" class="text-center" hidden>
        <p class="text-sm text-tk-ink-2">
          <span class="inline-block animate-pulse">●</span> Verifying your account…
        </p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-tk-ink-3">
        <span>Token expired or never arrived?</span>
        <button
          type="button"
          data-action="resend"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2 disabled:cursor-not-allowed disabled:text-tk-ink-3 disabled:no-underline"
        >
          Resend verification email
        </button>
        <span data-field="resend-status" class="hidden text-tk-ready-text" role="status"></span>
        <span
          >or <a
            href="/signup"
            class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
            >restart signup</a
          >.</span
        >
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="verify-email"]');
      if (!root) return;

      // Open-redirect guard for ?next= — inline copy of src/lib/safe-next.ts
      // (unit-tested in safe-next.test.ts; kept inline because <script
      // is:inline define:vars> can't import). Reduces ?next= to a same-origin
      // relative path, else '/', so /verify-email?next=https://evil.com can't
      // bounce a just-verified user off-site.
      function safeNextPath(next, origin) {
        if (typeof next !== 'string' || next.length === 0) return '/';
        let u;
        try {
          u = new URL(next, origin);
        } catch (e) {
          return '/';
        }
        if (u.origin !== origin) return '/';
        const p = u.pathname + u.search + u.hash;
        if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
        return p;
      }

      const form = root.querySelector('[data-form="verify"]');
      const banner = root.querySelector('[data-banner]');
      const emailEl = root.querySelector('[data-field="email"]');
      const tokenInput = root.querySelector('#verify-token');
      const unknownRecovery = root.querySelector('[data-verify-unknown]');
      const unknownLoginLink = root.querySelector('[data-link="verify-timeout-login"]');

      const email = sessionStorage.getItem('ds_signup_email');
      if (email && emailEl) emailEl.textContent = email;
      const formEl = root.querySelector('[data-form-fallback]');
      const spinnerEl = root.querySelector('[data-field="auto-verify-spinner"]');
      const introEl = root.querySelector('[data-field="intro"]');
      // Issue 3 wave 1085+ — when the user clicks the link in the verify
      // email, the token is already in `?token=…`. Auto-submit
      // immediately and HIDE the form (replace with a spinner). The
      // form is unhidden as a manual fallback only when:
      //   (a) auto-submit fails (showFallback() below)
      //   (b) the page is reached without a token in the URL
      const params = new URLSearchParams(window.location.search);
      const linkToken = params.get('token');
      const debugToken = sessionStorage.getItem('ds_debug_verify_token');
      const prefill = linkToken ?? debugToken;
      if (prefill && tokenInput) tokenInput.value = prefill;
      if (linkToken) {
        // Auto-verify path: show spinner, keep form hidden.
        if (spinnerEl) spinnerEl.hidden = false;
        if (introEl) introEl.textContent = 'Verifying your account…';
      } else {
        // No token in URL: surface the form as the manual fallback.
        if (formEl) formEl.hidden = false;
      }

      function showFallback() {
        // Reveal the manual code-paste form (the auto-verify path failed
        // OR the user landed without a token).
        if (formEl) formEl.hidden = false;
        if (spinnerEl) spinnerEl.hidden = true;
        if (introEl) {
          introEl.textContent =
            'Auto-verify failed. Paste the token from your email below to continue.';
        }
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      const verifySubmit = form.querySelector('button[type="submit"]');
      const verifySubmitText = verifySubmit ? verifySubmit.textContent : '';
      const VERIFY_REQUEST_TIMEOUT_MS = 15_000;
      let verifyInFlight = false;
      let verifyOutcomeUnknown = false;
      function setVerifyBusy(busy) {
        form.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (tokenInput) tokenInput.disabled = busy || verifyOutcomeUnknown;
        if (verifySubmit) {
          verifySubmit.disabled = busy || verifyOutcomeUnknown;
          verifySubmit.textContent = busy
            ? 'Verifying…'
            : verifyOutcomeUnknown
              ? 'Verification outcome unknown'
              : verifySubmitText;
        }
      }

      function submitToken(token) {
        if (verifyInFlight || verifyOutcomeUnknown) return Promise.resolve(false);
        verifyInFlight = true;
        setVerifyBusy(true);
        banner.classList.add('hidden');
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), VERIFY_REQUEST_TIMEOUT_MS);

        return fetch(apiBaseUrl + '/v1/auth/verify-email', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token }),
          credentials: 'include',
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r.json().then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
              // audit w2flmiw48 #2 — clear the previous user's per-session overrides
              // (acting-as + staff/team flags) so a fresh session can't inherit them.
              localStorage.removeItem('ds_act_as_account');
              localStorage.removeItem('ds_is_team_user');
              localStorage.removeItem('ds_is_staff_user');
            }
            // Cleanup signup-stage state.
            sessionStorage.removeItem('ds_signup_email');
            sessionStorage.removeItem('ds_debug_verify_token');
            // V-267 — honor ?next= round-trip from /cli/authorize and
            // any other deep-link entry. Falls back to /welcome for the
            // first-time onboarding flow.
            const params = new URLSearchParams(window.location.search);
            const rawNext = params.get('next');
            const next = safeNextPath(rawNext, window.location.origin);
            // Gate on the RAW presence to preserve the /welcome onboarding
            // fallback; navigate the sanitized same-origin value.
            window.location.href = rawNext ? next : '/welcome';
          })
          .catch((err) => {
            if (controller.signal.aborted) {
              verifyOutcomeUnknown = true;
              if (formEl) formEl.hidden = true;
              if (spinnerEl) spinnerEl.hidden = true;
              if (unknownRecovery) unknownRecovery.hidden = false;
              if (introEl) introEl.textContent = 'Email-verification outcome unknown';
              const rawNext = params.get('next');
              const next = safeNextPath(rawNext, window.location.origin);
              if (unknownLoginLink) {
                unknownLoginLink.setAttribute(
                  'href',
                  rawNext ? '/login?next=' + encodeURIComponent(next) : '/login',
                );
              }
              showBanner(
                'Email-verification outcome is unknown after the request timed out. The server may already have verified your account, consumed this one-time token, and created a session whose credential did not reach this browser. Do not submit this token again. Continue to sign in; if the account is still unverified, resend the verification email below.',
              );
              return;
            }
            showBanner(
              err && err.message
                ? err.message
                : 'Verification failed.',
            );
            // If auto-verify (link-click) failed, reveal the manual
            // fallback form so the user has a recovery path.
            showFallback();
          })
          .finally(() => {
            clearTimeout(timeoutId);
            verifyInFlight = false;
            setVerifyBusy(false);
          });
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const fd = new FormData(form);
        const token = fd.get('token');
        if (typeof token === 'string' && token.length > 0) submitToken(token);
      });

      // V-184a.B — auto-submit when the link in the email carried
      // the token. The form stays mounted so failures show the
      // banner + the user can correct or paste manually.
      if (linkToken && linkToken.length > 0) {
        submitToken(linkToken);
      }

      // #187 — self-service resend of the signup-verification email.
      // The signup flow stashes the user's email in sessionStorage
      // under `ds_signup_email`; if it's absent we prompt for it
      // before posting. Server is shape-stable, so the success message
      // is identical regardless of whether the email matched.
      const resendBtn = root.querySelector('[data-action="resend"]');
      const resendStatus = root.querySelector('[data-field="resend-status"]');
      const RESEND_REQUEST_TIMEOUT_MS = 15_000;
      let resendInFlight = false;
      if (resendBtn) {
        resendBtn.addEventListener('click', async () => {
          if (resendInFlight) return;
          resendInFlight = true;
          resendBtn.disabled = true;
          resendBtn.setAttribute('aria-busy', 'true');
          banner.classList.add('hidden');
          let resendEmail = sessionStorage.getItem('ds_signup_email');
          if (!resendEmail) {
            resendEmail =
              (await window.driftstackPrompt('Email address used at signup:', {
                placeholder: 'you@example.com',
              })) || '';
            resendEmail = resendEmail.trim();
            if (!resendEmail) {
              resendInFlight = false;
              resendBtn.disabled = false;
              resendBtn.setAttribute('aria-busy', 'false');
              return;
            }
          }
          if (resendStatus) {
            resendStatus.textContent = 'Sending…';
            resendStatus.classList.remove('hidden');
          }
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), RESEND_REQUEST_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/resend-verification', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: resendEmail }),
            signal: controller.signal,
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              if (resendStatus) {
                resendStatus.textContent = 'Sent — check your inbox.';
                resendStatus.classList.remove('hidden');
              }
              // Re-enable after 60s so accidental double-clicks don't
              // burn through the per-IP 3/min cap on the server side.
              resendBtn.setAttribute('aria-busy', 'false');
              window.setTimeout(() => {
                resendInFlight = false;
                resendBtn.disabled = false;
              }, 60_000);
            })
            .catch((err) => {
              resendInFlight = false;
              resendBtn.disabled = false;
              resendBtn.setAttribute('aria-busy', 'false');
              showBanner(
                controller.signal.aborted
                  ? 'Resending took too long. Check your connection and try again.'
                  : err && err.message
                    ? err.message
                    : 'Resend failed.',
              );
            })
            .finally(() => clearTimeout(timeoutId));
        });
      }
    })();
  </script>
</DashboardLayout>
