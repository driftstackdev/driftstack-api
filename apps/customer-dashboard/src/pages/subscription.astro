---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_SUBSCRIPTION } from '../data/mocks.ts';

// V-134 scaffolding. Real reads against /v1/billing land later.
// /subscription is a deeper drill-down from /billing — plan history,
// upgrade/downgrade preview, full invoice list. /billing stays the
// at-a-glance card; /subscription is for the detail.

interface MockPlanHistoryEntry {
  date: string;
  from_tier: string | null;
  to_tier: string;
  reason: 'signup' | 'upgrade' | 'downgrade' | 'tier_rename';
}

const PLAN_HISTORY: MockPlanHistoryEntry[] = [
  { date: '2026-04-15T09:00:00Z', from_tier: null, to_tier: 'free', reason: 'signup' },
  { date: '2026-04-22T14:00:00Z', from_tier: 'free', to_tier: 'api_starter', reason: 'upgrade' },
  { date: '2026-05-01T10:30:00Z', from_tier: 'api_starter', to_tier: 'api_builder', reason: 'upgrade' },
];

interface MockInvoice {
  id: string;
  date: string;
  amount_cents: number;
  status: 'paid' | 'open' | 'void';
  pdf_url: string;
}

const INVOICES: MockInvoice[] = [
  { id: 'in_test_3', date: '2026-05-01T00:00:00Z', amount_cents: 49900, status: 'paid', pdf_url: '#' },
  { id: 'in_test_2', date: '2026-04-22T14:00:00Z', amount_cents: 14900, status: 'paid', pdf_url: '#' },
  { id: 'in_test_1', date: '2026-04-15T09:00:00Z', amount_cents: 299, status: 'paid', pdf_url: '#' },
];

function fmtIsoDay(iso: string): string {
  return new Date(iso).toISOString().slice(0, 10);
}

function fmtUsd(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}

const REASON_LABEL: Record<MockPlanHistoryEntry['reason'], string> = {
  signup: 'Initial signup',
  upgrade: 'Upgraded',
  downgrade: 'Downgraded',
  tier_rename: 'Tier renamed (no price change)',
};

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Subscription">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <header class="mb-10">
      <p class="text-sm text-tk-ink-3">
        <a href="/billing" class="text-tk-accent hover:underline">← Back to billing</a>
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-tk-ink">Subscription</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Plan history, change-plan preview, and the full invoice list. For
        quick subscription state see <a href="/billing" class="text-tk-accent underline">/billing</a>.
      </p>
    </header>

    {/* 2026-05-23 — icon header on Current plan card. */}
    <!-- Current plan -->
    <section class="dashboard-card">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <path d="M2 10h20" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Current plan</p>
          <h2 class="mt-2 text-2xl font-semibold text-tk-ink" data-field="sub-tier">
            {MOCK_SUBSCRIPTION ? MOCK_SUBSCRIPTION.tier : 'No subscription'}
          </h2>
        </div>
      </div>
      {
        MOCK_SUBSCRIPTION && (
          <p class="mt-2 text-sm text-tk-ink-2" data-field="sub-summary">
            Status <span class="font-mono">{MOCK_SUBSCRIPTION.status}</span> · renews{' '}
            {MOCK_SUBSCRIPTION.current_period_end
              ? fmtIsoDay(MOCK_SUBSCRIPTION.current_period_end)
              : '—'}
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#upgrade" class="btn-primary">Upgrade plan</a>
        <a href="#downgrade" class="btn-secondary">Downgrade plan</a>
        <a href="#portal" class="btn-secondary">Open Stripe portal</a>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Upgrades take effect immediately and prorate your remaining period.
        Downgrades take effect at the end of the current period — you keep
        your current cap until renewal.
      </p>
    </section>

    {/* 2026-05-23 — icon header on the plan-history card. */}
    <!-- Plan history -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Plan history</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Tier changes</h2>
        </div>
      </div>
      <ol class="mt-6 space-y-3">
        {
          PLAN_HISTORY.slice()
            .reverse()
            .map((entry) => (
              <li class="flex items-start gap-4 border-b border-slate-100 pb-3 last:border-b-0">
                <time class="shrink-0 font-mono text-xs text-tk-ink-3" datetime={entry.date}>
                  {fmtIsoDay(entry.date)}
                </time>
                <p class="text-sm text-tk-ink-2">
                  <span class="font-medium text-tk-ink">{REASON_LABEL[entry.reason]}</span>
                  {entry.from_tier !== null && (
                    <>
                      : <code class="font-mono">{entry.from_tier}</code> →{' '}
                    </>
                  )}
                  {entry.from_tier === null && ': '}
                  <code class="font-mono">{entry.to_tier}</code>
                </p>
              </li>
            ))
        }
      </ol>
    </section>

    {/* 2026-05-23 — icon header on the invoices card. */}
    <!-- Invoices -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 13h6M9 17h4" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Invoices</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">All invoices</h2>
        </div>
      </div>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-tk-border text-left text-xs font-medium uppercase tracking-wide text-tk-ink-3">
              <th class="py-2 pr-4">Date</th>
              <th class="py-2 pr-4">Invoice</th>
              <th class="py-2 pr-4">Amount</th>
              <th class="py-2 pr-4">Status</th>
              <th class="py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              INVOICES.map((invoice) => (
                <tr>
                  <td class="py-3 pr-4 text-tk-ink-2">{fmtIsoDay(invoice.date)}</td>
                  <td class="py-3 pr-4 font-mono text-xs text-tk-ink-2">{invoice.id}</td>
                  <td class="py-3 pr-4 font-mono text-tk-ink">
                    {fmtUsd(invoice.amount_cents)}
                  </td>
                  <td class="py-3 pr-4">
                    <span
                      class:list={[
                        'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                        invoice.status === 'paid'
                          ? 'bg-emerald-400/10 text-emerald-300'
                          : invoice.status === 'open'
                            ? 'bg-tk-accent/10 text-tk-accent'
                            : 'bg-tk-surface text-tk-ink-2',
                      ]}
                    >
                      {invoice.status}
                    </span>
                  </td>
                  <td class="py-3 text-right">
                    <a href={invoice.pdf_url} class="text-sm text-tk-accent hover:underline">
                      Download PDF
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Invoice PDFs hosted by Stripe with permanent URLs. Bookmark for
        accounting; we don't expire them.
      </p>
    </section>
  </div>

  {/*
    2026-05-21 — minimal real-data hydration: reads ds_web_session_token
    from localStorage, fetches /v1/billing, and updates the "Current
    plan" header + summary. Plan history + invoices stay MOCK for now
    (the dashboard surfaces them but the API doesn't expose either
    yet); they'll get their own hydration pass once /v1/billing/history
    + /v1/billing/invoices land. Same `.finally(window.dashboardHydrated)`
    pattern as the rest of the dashboard pages.
  */}
  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      function setText(field, value) {
        const el = document.querySelector('[data-field="' + field + '"]');
        if (el && typeof value === 'string') el.textContent = value;
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }
      let token = null;
      try {
        token = localStorage.getItem('ds_web_session_token');
      } catch (_) {
        /* swallow */
      }
      if (!token) return;
      fetch(apiBaseUrl + '/v1/billing', {
        headers: {
          authorization: 'Bearer ' + token,
          ...(typeof window.driftstackActAsHeaders === 'function'
            ? window.driftstackActAsHeaders()
            : {}),
        },
        credentials: 'include',
      })
        .then((r) =>
          r.ok
            ? r.json()
            : // W277.C — surface problem+json `detail` so the customer-
              // visible error message is the server's reason, not a bare
              // HTTP status. Falls through to "HTTP 5xx" if body isn't
              // a Problem (e.g. infra-level error before the handler).
              r
                .json()
                .catch(() => ({}))
                .then((body) => Promise.reject(new Error(body.detail || 'HTTP ' + r.status))),
        )
        .then((body) => {
          if (body.subscription) {
            setText('sub-tier', body.subscription.tier);
            const summary =
              'Status ' +
              body.subscription.status +
              ' · renews ' +
              fmtIso(body.subscription.current_period_end);
            setText('sub-summary', summary);
          } else {
            setText('sub-tier', 'No subscription');
            setText('sub-summary', 'Upgrade to a paid tier to unlock concurrent caps.');
          }
        })
        .catch(() => {
          /* leave MOCK as fallback */
        })
        .finally(() => {
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });
    })();
  </script>
</DashboardLayout>
