---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_SUBSCRIPTION } from '../data/mocks.ts';

// V-134 scaffolding. Real reads against /v1/billing land later.
// /subscription is a deeper drill-down from /billing — plan history,
// upgrade/downgrade preview, full invoice list. /billing stays the
// at-a-glance card; /subscription is for the detail.

interface MockPlanHistoryEntry {
  date: string;
  from_tier: string | null;
  to_tier: string;
  reason: 'signup' | 'upgrade' | 'downgrade' | 'tier_rename';
}

const PLAN_HISTORY: MockPlanHistoryEntry[] = [
  { date: '2026-04-15T09:00:00Z', from_tier: null, to_tier: 'trial_pack', reason: 'signup' },
  { date: '2026-04-22T14:00:00Z', from_tier: 'trial_pack', to_tier: 'api_starter', reason: 'upgrade' },
  { date: '2026-05-01T10:30:00Z', from_tier: 'api_starter', to_tier: 'api_builder', reason: 'upgrade' },
];

interface MockInvoice {
  id: string;
  date: string;
  amount_cents: number;
  status: 'paid' | 'open' | 'void';
  pdf_url: string;
}

const INVOICES: MockInvoice[] = [
  { id: 'in_test_3', date: '2026-05-01T00:00:00Z', amount_cents: 49900, status: 'paid', pdf_url: '#' },
  { id: 'in_test_2', date: '2026-04-22T14:00:00Z', amount_cents: 14900, status: 'paid', pdf_url: '#' },
  { id: 'in_test_1', date: '2026-04-15T09:00:00Z', amount_cents: 299, status: 'paid', pdf_url: '#' },
];

function fmtIsoDay(iso: string): string {
  return new Date(iso).toISOString().slice(0, 10);
}

function fmtUsd(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}

const REASON_LABEL: Record<MockPlanHistoryEntry['reason'], string> = {
  signup: 'Initial signup',
  upgrade: 'Upgraded',
  downgrade: 'Downgraded',
  tier_rename: 'Tier renamed (no price change)',
};
---

<DashboardLayout title="Subscription">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <header class="mb-10">
      <p class="text-sm text-slate-500">
        <a href="/billing" class="text-oxblood-700 hover:underline">← Back to billing</a>
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Subscription</h1>
      <p class="mt-2 max-w-prose text-sm text-slate-500">
        Plan history, change-plan preview, and the full invoice list. For
        quick subscription state see <a href="/billing" class="text-oxblood-700 underline">/billing</a>.
      </p>
    </header>

    <!-- Current plan -->
    <section class="dashboard-card">
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Current plan</p>
      <h2 class="mt-2 text-2xl font-semibold text-slate-900">
        {MOCK_SUBSCRIPTION ? MOCK_SUBSCRIPTION.tier : 'No subscription'}
      </h2>
      {
        MOCK_SUBSCRIPTION && (
          <p class="mt-2 text-sm text-slate-600">
            Status <span class="font-mono">{MOCK_SUBSCRIPTION.status}</span> · renews{' '}
            {MOCK_SUBSCRIPTION.current_period_end
              ? fmtIsoDay(MOCK_SUBSCRIPTION.current_period_end)
              : '—'}
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#upgrade" class="btn-primary">Upgrade plan</a>
        <a href="#downgrade" class="btn-secondary">Downgrade plan</a>
        <a href="#portal" class="btn-secondary">Open Stripe portal</a>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        Upgrades take effect immediately and prorate your remaining period.
        Downgrades take effect at the end of the current period — you keep
        your current cap until renewal.
      </p>
    </section>

    <!-- Plan history -->
    <section class="dashboard-card mt-6">
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Plan history</p>
      <h2 class="mt-2 text-xl font-semibold text-slate-900">Tier changes</h2>
      <ol class="mt-6 space-y-3">
        {
          PLAN_HISTORY.slice()
            .reverse()
            .map((entry) => (
              <li class="flex items-start gap-4 border-b border-slate-100 pb-3 last:border-b-0">
                <time class="shrink-0 font-mono text-xs text-slate-500" datetime={entry.date}>
                  {fmtIsoDay(entry.date)}
                </time>
                <p class="text-sm text-slate-700">
                  <span class="font-medium text-slate-900">{REASON_LABEL[entry.reason]}</span>
                  {entry.from_tier !== null && (
                    <>
                      : <code class="font-mono">{entry.from_tier}</code> →{' '}
                    </>
                  )}
                  {entry.from_tier === null && ': '}
                  <code class="font-mono">{entry.to_tier}</code>
                </p>
              </li>
            ))
        }
      </ol>
    </section>

    <!-- Invoices -->
    <section class="dashboard-card mt-6">
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Invoices</p>
      <h2 class="mt-2 text-xl font-semibold text-slate-900">All invoices</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
              <th class="py-2 pr-4">Date</th>
              <th class="py-2 pr-4">Invoice</th>
              <th class="py-2 pr-4">Amount</th>
              <th class="py-2 pr-4">Status</th>
              <th class="py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              INVOICES.map((invoice) => (
                <tr>
                  <td class="py-3 pr-4 text-slate-700">{fmtIsoDay(invoice.date)}</td>
                  <td class="py-3 pr-4 font-mono text-xs text-slate-700">{invoice.id}</td>
                  <td class="py-3 pr-4 font-mono text-slate-900">
                    {fmtUsd(invoice.amount_cents)}
                  </td>
                  <td class="py-3 pr-4">
                    <span
                      class:list={[
                        'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                        invoice.status === 'paid'
                          ? 'bg-emerald-50 text-emerald-700'
                          : invoice.status === 'open'
                            ? 'bg-amber-50 text-amber-700'
                            : 'bg-slate-100 text-slate-600',
                      ]}
                    >
                      {invoice.status}
                    </span>
                  </td>
                  <td class="py-3 text-right">
                    <a href={invoice.pdf_url} class="text-sm text-oxblood-700 hover:underline">
                      Download PDF
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        Invoice PDFs hosted by Stripe with permanent URLs. Bookmark for
        accounting; we don't expire them.
      </p>
    </section>
  </div>
</DashboardLayout>
