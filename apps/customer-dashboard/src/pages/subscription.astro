---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_SUBSCRIPTION, TIER_DISPLAY_NAMES } from '../data/mocks.ts';

// V-134 scaffolding. Real reads against /v1/billing land later.
// /subscription is a deeper drill-down from /billing — plan history,
// upgrade/downgrade preview, full invoice list. /billing stays the
// at-a-glance card; /subscription is for the detail.

// 2026-06-24 — the API does not yet expose per-account plan history or
// an invoice list (no /v1/billing/history or /v1/billing/invoices). The
// hardcoded plan-history + invoice arrays that used to live here shipped
// fabricated dollar amounts, statuses, and dead download links to every
// customer. They've been removed; both sections now render honest empty
// states until the real read endpoints land. The live "Current plan"
// hydration from /v1/billing (below) is unaffected.

function fmtIsoDay(iso: string): string {
  return new Date(iso).toISOString().slice(0, 10);
}

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Subscription">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <header class="mb-10">
      <p class="text-sm text-tk-ink-3">
        <a href="/billing" class="text-tk-accent hover:underline">← Back to billing</a>
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-tk-ink">Subscription</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Plan history, change-plan preview, and the full invoice list. For
        quick subscription state see <a href="/billing" class="text-tk-accent underline">/billing</a>.
      </p>
    </header>

    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    {/* 2026-05-23 — icon header on Current plan card. */}
    <!-- Current plan -->
    <section class="dashboard-card">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <path d="M2 10h20" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Current plan</p>
          <h2 class="mt-2 text-2xl font-semibold text-tk-ink" data-field="sub-tier">
            {MOCK_SUBSCRIPTION ? TIER_DISPLAY_NAMES[MOCK_SUBSCRIPTION.tier] : 'No subscription'}
          </h2>
        </div>
      </div>
      {
        MOCK_SUBSCRIPTION && (
          <p class="mt-2 text-sm text-tk-ink-2" data-field="sub-summary">
            Status <span class="font-mono">{MOCK_SUBSCRIPTION.status}</span> · renews{' '}
            {MOCK_SUBSCRIPTION.current_period_end
              ? fmtIsoDay(MOCK_SUBSCRIPTION.current_period_end)
              : '—'}
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/select-tier" class="btn-primary">Upgrade plan</a>
        <a href="/select-tier" class="btn-secondary">Downgrade plan</a>
        <button type="button" class="btn-secondary" data-action="portal">Open Stripe portal</button>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Upgrades take effect immediately and prorate your remaining period.
        Downgrades take effect at the end of the current period — you keep
        your current cap until renewal.
      </p>
    </section>

    {/* 2026-05-23 — icon header on the plan-history card. */}
    <!-- Plan history -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Plan history</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Tier changes</h2>
        </div>
      </div>
      <p class="mt-6 text-sm text-tk-ink-3">Plan history isn't available yet.</p>
    </section>

    {/* 2026-05-23 — icon header on the invoices card. */}
    <!-- Invoices -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 13h6M9 17h4" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Invoices</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">All invoices</h2>
        </div>
      </div>
      <p class="mt-6 text-sm text-tk-ink-3">No invoices yet.</p>
    </section>
  </div>

  {/*
    2026-05-21 — minimal real-data hydration: reads ds_web_session_token
    from localStorage, fetches /v1/billing, and updates the "Current
    plan" header + summary. Plan history + invoices render honest empty
    states (the API doesn't expose either yet); they'll hydrate once
    /v1/billing/history + /v1/billing/invoices land. Same
    `.finally(window.dashboardHydrated)` pattern as the rest of the
    dashboard pages.
  */}
  <script is:inline define:vars={{ apiBaseUrl, tierDisplayNames: TIER_DISPLAY_NAMES }}>
    (function () {
      function setText(field, value) {
        const el = document.querySelector('[data-field="' + field + '"]');
        if (el && typeof value === 'string') el.textContent = value;
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }
      // Backend tier id → human plan name so the customer sees "API
      // Builder", not the raw "api_builder" id (same mapping billing.astro
      // uses). Falls back to the raw id if the table ever lacks a key.
      function tierLabel(t) {
        return (t && tierDisplayNames[t]) || t || '—';
      }
      const banner = document.querySelector('[data-banner]');
      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      let token = null;
      try {
        token = localStorage.getItem('ds_web_session_token');
      } catch (_) {
        /* swallow */
      }

      // Wire the "Open Stripe portal" button: POST /v1/billing/portal-session
      // then redirect to the returned Stripe URL (mirrors billing.astro's
      // handlePortal). Wired regardless of token so it shows a banner rather
      // than silently no-oping when signed out. (Upgrade/Downgrade are plain
      // links to /select-tier — the working checkout page.)
      const portalBtn = document.querySelector('[data-action="portal"]');
      function handlePortal() {
        if (!token) {
          showBanner('Sign in to manage billing.');
          return;
        }
        fetch(apiBaseUrl + '/v1/billing/portal-session', {
          method: 'POST',
          headers: {
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
          body: '{}',
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (body.portal_url) window.location.href = body.portal_url;
          })
          .catch((err) => {
            showBanner(
              "Couldn't open Stripe portal (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          });
      }
      if (portalBtn) portalBtn.addEventListener('click', handlePortal);

      if (!token) return;
      fetch(apiBaseUrl + '/v1/billing', {
        headers: {
          authorization: 'Bearer ' + token,
          ...(typeof window.driftstackActAsHeaders === 'function'
            ? window.driftstackActAsHeaders()
            : {}),
        },
        credentials: 'include',
      })
        .then((r) =>
          r.ok
            ? r.json()
            : // W277.C — surface problem+json `detail` so the customer-
              // visible error message is the server's reason, not a bare
              // HTTP status. Falls through to "HTTP 5xx" if body isn't
              // a Problem (e.g. infra-level error before the handler).
              r
                .json()
                .catch(() => ({}))
                .then((body) => {
                  const e = new Error(body.detail || 'HTTP ' + r.status);
                  e.status = r.status;
                  return Promise.reject(e);
                }),
        )
        .then((body) => {
          if (body.subscription) {
            setText('sub-tier', tierLabel(body.subscription.tier));
            const summary =
              'Status ' +
              body.subscription.status +
              ' · renews ' +
              fmtIso(body.subscription.current_period_end);
            setText('sub-summary', summary);
          } else {
            setText('sub-tier', 'No subscription');
            setText('sub-summary', 'Upgrade to a paid tier to unlock concurrent caps.');
          }
        })
        .catch((err) => {
          // Don't leave the SSG MOCK subscription on screen — a real customer
          // reads the fabricated api_builder/active card as their actual plan.
          // 503 = billing not configured (current prod posture) → pending-setup.
          if (err && err.status === 503) {
            setText('sub-tier', 'Billing setup pending');
            setText('sub-summary', 'Billing isn’t fully configured yet — check back soon.');
          } else {
            setText('sub-tier', 'No subscription');
            setText('sub-summary', 'Couldn’t load your live subscription — reload to try again.');
          }
        })
        .finally(() => {
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });
    })();
  </script>
</DashboardLayout>
