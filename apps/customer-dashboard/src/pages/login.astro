---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-269 — Sign-in page for returning customers. Pairs with the V-184a
// signup flow + the V-267 cli/authorize deep-link round-trip.
//
// POSTs to /v1/auth/login (V-079) which returns a web session token.
// The token lands in localStorage under `ds_web_session_token` —
// identical key to signup → verify-email so cross-page reads
// "just work" for already-existing pages (dashboard, /cli/authorize,
// /api-keys, etc.).
//
// Honors `?next=` for deep-link round-trip from /cli/authorize and
// any future deep-link entry points; falls back to "/" for the typical
// "I came here from the marketing site" path.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Sign in" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="login"
  >
    <p class="section-label">Returning customer</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink-primary" style="letter-spacing: -0.02em;">
      Sign in
    </h1>
    <p class="mt-3 text-sm text-ink-secondary">
      Welcome back. Sign in with the email and password from your Driftstack account.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form data-form="login" class="space-y-5">
        <div>
          <label class="form-label" for="login-email">Email</label>
          <input
            id="login-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label class="form-label" for="login-password">Password</label>
          <input
            id="login-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="form-input"
            placeholder="••••••••"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Sign in</button>
      </form>

      <p class="mt-6 text-xs text-ink-muted">
        <a href="/forgot-password" class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft"
          >Forgot your password?</a
        >
      </p>

      <p class="mt-3 text-xs text-ink-muted">
        <a
          href="/auth/magic-link-request"
          class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft"
          >Sign in with a magic link instead</a
        >.
      </p>

      <p class="mt-3 text-xs text-ink-muted">
        No account yet? <a
          data-signup-link
          href="/signup"
          class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft">Create one</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="login"]');
      if (!root) return;
      const form = root.querySelector('[data-form="login"]');
      const banner = root.querySelector('[data-banner]');
      const signupLink = root.querySelector('[data-signup-link]');

      // V-269 — preserve ?next= when bouncing the user to /signup so a
      // returning user who clicks "Create one" doesn't lose their deep-
      // link target.
      const params = new URLSearchParams(window.location.search);
      const next = params.get('next');
      if (next && signupLink) {
        signupLink.setAttribute('href', '/signup?next=' + encodeURIComponent(next));
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const payload = {
          email: fd.get('email'),
          password: fd.get('password'),
        };

        fetch(apiBaseUrl + '/v1/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .then((b) =>
                    Promise.reject(new Error(b.detail || 'HTTP ' + r.status.toString())),
                  ),
          )
          .then((body) => {
            // V-353d — /v1/auth/login returns a discriminated union:
            // either `{ session: ... }` (no MFA enrolled) or
            // `{ mfa_required: true, challenge_token, ... }`. Until
            // the MFA challenge UI lands, surface the second branch
            // as a clear banner so MFA-enrolled users aren't silently
            // redirected to / with no session set (which would bounce
            // straight back to /login).
            if (body && body.mfa_required === true) {
              showBanner(
                'This account has MFA enabled. The web-based MFA challenge ' +
                  'UI is not available yet — please sign in via the API or ' +
                  'temporarily disable MFA from the CLI (see /docs/api-keys).',
              );
              return;
            }
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
            }
            // Honor ?next= round-trip; fall back to / for the typical
            // post-login landing.
            window.location.href = next ? next : '/';
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Sign-in failed.');
          });
      });
    })();
  </script>
</DashboardLayout>
