---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-269 — Sign-in page for returning customers. Pairs with the V-184a
// signup flow + the V-267 cli/authorize deep-link round-trip.
//
// POSTs to /v1/auth/login (V-079) which returns a web session token.
// The token lands in localStorage under `ds_web_session_token` —
// identical key to signup → verify-email so cross-page reads
// "just work" for already-existing pages (dashboard, /cli/authorize,
// /api-keys, etc.).
//
// Honors `?next=` for deep-link round-trip from /cli/authorize and
// any future deep-link entry points; falls back to "/" for the typical
// "I came here from the marketing site" path.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Sign in" withSidebar={false}>
  <script is:inline>
    // Bug fix (founder 2026-07-07): "shows login page when it already has a
    // session". An already-authenticated visitor (session token in localStorage)
    // must NOT see the sign-in form — bounce them to the dashboard (or ?next=).
    // The DashboardLayout pre-paint auth block is gated on `withSidebar`, so it
    // never runs on this withSidebar={false} page; this login-local guard fills
    // that gap. Loop-safe: the dashboard re-validates the token and bounces a
    // stale one back to /login (clearing it), so a bad token can't ping-pong.
    // Same-origin ?next only (open-redirect guard: reject //host and absolute
    // URLs). Runs pre-paint (first node in the body) so the form never flashes.
    (function () {
      try {
        var t = localStorage.getItem('ds_web_session_token');
        if (!t || t.length === 0) return;
        var raw = new URLSearchParams(location.search).get('next') || '/';
        var dest = raw.charAt(0) === '/' && raw.charAt(1) !== '/' ? raw : '/';
        location.replace(dest);
      } catch (_) {
        /* localStorage blocked → fall through and show the form */
      }
    })();
  </script>
  {/* 2026-05-22 — hero-glow atmosphere on the login surface so the
      sign-in moment shares the same visual family as the marketing
      site (customers arriving from the marketing CTA shouldn't feel
      a tonal jump). */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
      data-page="login"
    >
    <p class="section-label">Returning customer</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Sign in
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      Welcome back. Sign in with the email and password from your Driftstack account.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <!-- Unverified-email recovery. Hidden until /v1/auth/login returns
           403 EmailNotVerified; then this surfaces a resend action + a link
           to /verify-email so the customer isn't stranded on a dead banner
           (the common "lost the verification email" onboarding dead-end). -->
      <div data-verify-prompt class="banner-warn mb-5 hidden" role="status">
        <p>Your email isn't verified yet. Verify it before signing in.</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button type="button" data-resend-verification class="btn-secondary text-sm">
            Resend verification email
          </button>
          <a
            data-verify-link
            href="/verify-email"
            class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2 text-xs"
            >Enter a verification code</a
          >
        </div>
        <p data-resend-status class="mt-2 text-xs text-tk-ink-3"></p>
      </div>

      <form data-form="login" class="space-y-5">
        <div>
          <label class="form-label" for="login-email">Email</label>
          <input
            id="login-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label class="form-label" for="login-password">Password</label>
          <input
            id="login-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="form-input"
            placeholder="••••••••"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Sign in</button>
      </form>

      <!-- W528 — MFA challenge step. Hidden until /v1/auth/login returns
           { mfa_required: true, challenge_token }; then the password form
           hides and this one shows. Submits POST /v1/auth/mfa/challenge
           with { challenge_token, code } (or { recovery_code } when the
           recovery toggle is active) → { session } → same redirect path
           as a plain login. Pre-W528 this branch dead-ended with a banner
           telling the customer to use the API instead — an MFA-enrolled
           customer could not sign in to the dashboard at all. -->
      <!-- novalidate: this form has TWO inputs (authenticator code + recovery
           code), only one visible at a time via the toggle. Native HTML5
           constraint validation runs on the HIDDEN input too, so a partial code
           left in the display:none field would silently block Verify (the browser
           can't focus/report on a hidden field). The submit handler already
           validates the ACTIVE method in JS with a friendly inline message, so
           native validation is redundant here. (audit 2026-07-07) -->
      <form data-form="mfa" novalidate class="hidden space-y-5" aria-label="Two-factor verification">
        <p class="text-sm text-tk-ink-2">
          Enter the 6-digit code from your authenticator app.
        </p>
        <div data-mfa-code-row>
          <label class="form-label" for="login-mfa-code">Authentication code</label>
          <input
            id="login-mfa-code"
            name="mfa-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            maxlength="6"
            class="form-input font-mono tracking-widest"
            placeholder="123456"
          />
        </div>
        <div data-mfa-recovery-row class="hidden">
          <label class="form-label" for="login-mfa-recovery">Recovery code</label>
          <input
            id="login-mfa-recovery"
            name="mfa-recovery"
            type="text"
            autocomplete="off"
            class="form-input font-mono"
            placeholder="xxxx-xxxx-xxxx"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Verify</button>
        <p class="text-xs text-tk-ink-3">
          Lost your device?
          <button
            type="button"
            data-mfa-toggle-recovery
            class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >Use a recovery code instead</button>
        </p>
      </form>

      <p class="mt-6 text-xs text-tk-ink-3">
        <a href="/forgot-password" class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >Forgot your password?</a
        >
      </p>

      <p class="mt-3 text-xs text-tk-ink-3">
        <a
          href="/auth/magic-link-request"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >Sign in with a magic link instead</a
        >.
      </p>

      <!-- V-667.C — sign-in-with-IDP. Buttons trigger a POST to
           /v1/auth/oauth-client/start which returns an authorize_url;
           the page redirects window.location to it.
           2026-05-16 founder feedback: text-only buttons read less
           professional than peer sign-in surfaces (Stripe / Linear /
           Vercel). Inline brand SVGs (Google G multi-color, GitHub
           octocat single-color) placed before the label; aria-hidden
           since the button carries the full aria-label. -->
      <div class="mt-5 flex flex-col gap-2" data-oauth-buttons>
        <button
          type="button"
          data-oauth="google"
          class="btn-secondary w-full text-sm inline-flex items-center justify-center gap-2.5"
          aria-label="Sign in with Google"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          Sign in with Google
        </button>
        <button
          type="button"
          data-oauth="github"
          class="btn-secondary w-full text-sm inline-flex items-center justify-center gap-2.5"
          aria-label="Sign in with GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 015.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .3.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
            ></path>
          </svg>
          Sign in with GitHub
        </button>
      </div>

      <p class="mt-3 text-xs text-tk-ink-3">
        No account yet? <a
          data-signup-link
          href="/signup"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Create one</a
        >.
      </p>
    </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="login"]');
      if (!root) return;

      // Open-redirect guard for ?next=. Reduces any next to a SAME-ORIGIN
      // relative path (else '/'), so /login?next=https://evil.com can't bounce
      // a signed-in user off-site. Inline copy of src/lib/safe-next.ts (the
      // unit-tested canonical version — safe-next.test.ts covers the bypasses,
      // incl. the //-pathname one); kept inline because a <script is:inline
      // define:vars> block can't import. Uses the URL parser, not a regex.
      function safeNextPath(next, origin) {
        if (typeof next !== 'string' || next.length === 0) return '/';
        let u;
        try {
          u = new URL(next, origin);
        } catch (e) {
          return '/';
        }
        if (u.origin !== origin) return '/';
        const p = u.pathname + u.search + u.hash;
        if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
        return p;
      }

      const form = root.querySelector('[data-form="login"]');
      const banner = root.querySelector('[data-banner]');
      const signupLink = root.querySelector('[data-signup-link]');
      const verifyPrompt = root.querySelector('[data-verify-prompt]');
      const verifyLink = root.querySelector('[data-verify-link]');
      const resendBtn = root.querySelector('[data-resend-verification]');
      const resendStatus = root.querySelector('[data-resend-status]');
      const RESEND_REQUEST_TIMEOUT_MS = 15_000;
      let resendInFlight = false;
      let resendOutcomeUnknown = false;

      // Problem-type URI the server returns when login is refused because
      // the account's email isn't verified (403). Matched on the body
      // `type` (not the human detail string, which can change).
      const EMAIL_NOT_VERIFIED_TYPE = 'https://errors.driftstack.dev/email-not-verified';

      // V-269 — preserve ?next= when bouncing the user to /signup so a
      // returning user who clicks "Create one" doesn't lose their deep-
      // link target.
      const params = new URLSearchParams(window.location.search);
      // Sanitized once here; every downstream use (signup-link forward, the
      // post-login window.location.href, and the OAuth redirect_to) consumes
      // this same-origin-only value. Gate the signup-link on the RAW presence
      // (preserve "only forward when a next was supplied") but forward the
      // sanitized value.
      const rawNext = params.get('next');
      const next = safeNextPath(rawNext, window.location.origin);
      if (rawNext && signupLink) {
        signupLink.setAttribute('href', '/signup?next=' + encodeURIComponent(next));
      }

      // Prefill the email from ?email= (carried over from the signup
      // "already registered → sign in" link) so the customer doesn't retype.
      const prefillEmail = params.get('email');
      if (prefillEmail) {
        const emailInput = root.querySelector('#login-email');
        if (emailInput && !emailInput.value) emailInput.value = prefillEmail;
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Disable submit + show a pending label while the login request is in
      // flight (prevents double-submit, gives the user click feedback).
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitLabel = submitBtn ? submitBtn.textContent : '';
      const LOGIN_REQUEST_TIMEOUT_MS = 15_000;
      let loginInFlight = false;
      function setSubmitting(on) {
        if (!submitBtn) return;
        submitBtn.disabled = on;
        submitBtn.setAttribute('aria-busy', on ? 'true' : 'false');
        submitBtn.textContent = on ? 'Signing in…' : submitLabel;
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        if (loginInFlight) return;
        if (oauthStartInFlight || mfaInFlight) return;
        banner.classList.add('hidden');
        loginInFlight = true;
        setSubmitting(true);
        setOauthButtonsDisabled(true);
        const fd = new FormData(form);
        const payload = {
          email: fd.get('email'),
          password: fd.get('password'),
        };
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), LOGIN_REQUEST_TIMEOUT_MS);

        fetch(apiBaseUrl + '/v1/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => {
                    // Carry the problem `type` + status on the rejected
                    // error so the catch can branch (e.g. email-not-verified
                    // → resend path) instead of showing a dead banner.
                    const err = new Error(b.detail || 'HTTP ' + r.status.toString());
                    err.problemType = b.type;
                    err.status = r.status;
                    err.email = payload.email;
                    return Promise.reject(err);
                  }),
          )
          .then((body) => {
            // V-353d — /v1/auth/login returns a discriminated union:
            // either `{ session: ... }` (no MFA enrolled) or
            // `{ mfa_required: true, challenge_token, ... }`. W528 —
            // the second branch now opens the MFA challenge step (was a
            // dead-end use-the-API-instead banner that locked
            // MFA-enrolled customers out of the dashboard entirely).
            if (body && body.mfa_required === true) {
              startMfaChallenge(body.challenge_token);
              return;
            }
            completeSession(body);
          })
          .catch((err) => {
            // Email-not-verified (403): surface the resend path instead of
            // a dead banner. Stash the entered email so /verify-email and
            // the resend action prefill it.
            if (err && err.problemType === EMAIL_NOT_VERIFIED_TYPE) {
              showEmailNotVerified(err.email || payload.email);
              return;
            }
            showBanner(
              controller.signal.aborted
                ? 'Sign-in took too long. Check your connection and try again.'
                : err && err.message
                  ? err.message
                  : 'Sign-in failed.',
            );
          })
          .finally(() => {
            clearTimeout(timeoutId);
            loginInFlight = false;
            setSubmitting(false);
            setOauthButtonsDisabled(false);
          });
      });

      // Reveal the unverified-email recovery block + wire the resend action.
      function showEmailNotVerified(email) {
        banner.classList.add('hidden');
        if (email) {
          try {
            sessionStorage.setItem('ds_signup_email', email);
          } catch (_) {
            /* sessionStorage blocked — verify-email falls back to its own copy */
          }
        }
        if (verifyLink) {
          verifyLink.setAttribute(
            'href',
            next && next !== '/' ? '/verify-email?next=' + encodeURIComponent(next) : '/verify-email',
          );
        }
        if (verifyPrompt) verifyPrompt.classList.remove('hidden');
      }

      if (resendBtn) {
        resendBtn.addEventListener('click', () => {
          if (resendInFlight || resendOutcomeUnknown) return;
          const email = (form.querySelector('#login-email') || {}).value || '';
          if (!email.trim()) {
            if (resendStatus) resendStatus.textContent = 'Enter your email above first.';
            return;
          }
          resendInFlight = true;
          resendBtn.disabled = true;
          resendBtn.setAttribute('aria-busy', 'true');
          if (resendStatus) resendStatus.textContent = 'Sending…';
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), RESEND_REQUEST_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/resend-verification', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: email.trim() }),
            signal: controller.signal,
          })
            .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
            .then(() => {
              if (resendStatus)
                resendStatus.textContent =
                  'Verification email sent. Check your inbox, then enter the code.';
            })
            .catch(() => {
              if (controller.signal.aborted) {
                resendOutcomeUnknown = true;
                if (resendStatus)
                  resendStatus.textContent =
                    'Delivery is unknown after the request timed out. The server may already have sent a verification email. Do not resend again on this page. Check your inbox and spam folder; if multiple messages arrive, use the newest one. Reload only if nothing arrives.';
                return;
              }
              if (resendStatus)
                resendStatus.textContent = "Couldn't resend right now — try again shortly.";
            })
            .finally(() => {
              clearTimeout(timeoutId);
              resendInFlight = false;
              resendBtn.disabled = resendOutcomeUnknown;
              resendBtn.setAttribute('aria-busy', 'false');
            });
        });
      }

      // Shared session-completion path: plain login + MFA challenge both
      // land here with { session: { token } }.
      function completeSession(body) {
        const session = (body && body.session) || {};
        if (session.token) {
          localStorage.setItem('ds_web_session_token', session.token);
          // audit w2flmiw48 #2 — a fresh session must not inherit the PREVIOUS user's
          // per-session overrides (acting-as account + cached staff/team flags); on a
          // shared browser that leaks User A's x-driftstack-account header + staff
          // shortcut to User B until /account/me corrects it. Clear them on every login.
          localStorage.removeItem('ds_act_as_account');
          localStorage.removeItem('ds_is_team_user');
          localStorage.removeItem('ds_is_staff_user');
        }
        // Honor ?next= round-trip; fall back to / for the typical
        // post-login landing.
        window.location.href = next ? next : '/';
      }

      // ── W528 — MFA challenge step ──────────────────────────────────
      const mfaForm = root.querySelector('[data-form="mfa"]');
      const mfaCodeRow = root.querySelector('[data-mfa-code-row]');
      const mfaRecoveryRow = root.querySelector('[data-mfa-recovery-row]');
      const mfaToggle = root.querySelector('[data-mfa-toggle-recovery]');
      const mfaCodeInput = root.querySelector('#login-mfa-code');
      const mfaRecoveryInput = root.querySelector('#login-mfa-recovery');
      let mfaChallengeToken = null;
      let mfaUsingRecovery = false;
      let mfaInFlight = false;

      function startMfaChallenge(challengeToken) {
        mfaChallengeToken = challengeToken;
        form.classList.add('hidden');
        mfaForm.classList.remove('hidden');
        if (mfaCodeInput) mfaCodeInput.focus();
      }

      if (mfaToggle) {
        mfaToggle.addEventListener('click', () => {
          mfaUsingRecovery = !mfaUsingRecovery;
          mfaCodeRow.classList.toggle('hidden', mfaUsingRecovery);
          mfaRecoveryRow.classList.toggle('hidden', !mfaUsingRecovery);
          mfaToggle.textContent = mfaUsingRecovery
            ? 'Use an authenticator code instead'
            : 'Use a recovery code instead';
          const active = mfaUsingRecovery ? mfaRecoveryInput : mfaCodeInput;
          if (active) active.focus();
        });
      }

      if (mfaForm) {
        const mfaSubmit = mfaForm.querySelector('button[type="submit"]');
        const mfaSubmitLabel = mfaSubmit ? mfaSubmit.textContent : '';
        const MFA_REQUEST_TIMEOUT_MS = 15_000;
        mfaForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (mfaInFlight) return;
          if (loginInFlight || oauthStartInFlight) return;
          banner.classList.add('hidden');
          const code = mfaCodeInput ? mfaCodeInput.value.trim() : '';
          const recovery = mfaRecoveryInput ? mfaRecoveryInput.value.trim() : '';
          const payload = mfaUsingRecovery
            ? { challenge_token: mfaChallengeToken, recovery_code: recovery }
            : { challenge_token: mfaChallengeToken, code: code };
          if (mfaUsingRecovery ? recovery.length === 0 : !/^\d{6}$/.test(code)) {
            showBanner(
              mfaUsingRecovery
                ? 'Enter one of your recovery codes.'
                : 'Enter the 6-digit code from your authenticator app.',
            );
            return;
          }
          mfaInFlight = true;
          setOauthButtonsDisabled(true);
          if (mfaSubmit) {
            mfaSubmit.disabled = true;
            mfaSubmit.setAttribute('aria-busy', 'true');
            mfaSubmit.textContent = 'Verifying…';
          }
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), MFA_REQUEST_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/mfa/challenge', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal,
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .then((b) =>
                      Promise.reject(new Error(b.detail || 'HTTP ' + r.status.toString())),
                    ),
            )
            .then((body) => completeSession(body))
            .catch((err) => {
              showBanner(
                controller.signal.aborted
                  ? 'Verification took too long. Check your connection and try again.'
                  : err && err.message
                    ? err.message
                    : 'Verification failed. Try again.',
              );
            })
            .finally(() => {
              clearTimeout(timeoutId);
              mfaInFlight = false;
              setOauthButtonsDisabled(false);
              if (mfaSubmit) {
                mfaSubmit.disabled = false;
                mfaSubmit.setAttribute('aria-busy', 'false');
                mfaSubmit.textContent = mfaSubmitLabel;
              }
            });
        });
      }

      // V-667.C — bind OAuth provider buttons. On click, POST
      // /v1/auth/oauth-client/start { provider, redirect_to } → take
      // the authorize_url and let the browser navigate there. The
      // server sets the HTTP-only PKCE cookie via Set-Cookie on this
      // same response. Errors surface in the banner.
      const oauthButtons = root.querySelectorAll('[data-oauth]');
      const OAUTH_REQUEST_TIMEOUT_MS = 15_000;
      let oauthStartInFlight = false;
      function setOauthButtonsDisabled(disabled, activeButton) {
        oauthButtons.forEach((button) => {
          button.disabled = disabled;
          button.setAttribute(
            'aria-busy',
            disabled && button === activeButton ? 'true' : 'false',
          );
        });
      }
      oauthButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          banner.classList.add('hidden');
          const provider = btn.getAttribute('data-oauth');
          if (!provider) return;
          if (oauthStartInFlight) return;
          if (loginInFlight || mfaInFlight) return;
          oauthStartInFlight = true;
          setOauthButtonsDisabled(true, btn);
          if (submitBtn) submitBtn.disabled = true;
          const mfaSubmit = mfaForm && mfaForm.querySelector('button[type="submit"]');
          if (mfaSubmit) mfaSubmit.disabled = true;
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), OAUTH_REQUEST_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/oauth-client/start', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            credentials: 'include', // PKCE cookie round-trip
            body: JSON.stringify({
              provider,
              redirect_to:
                window.location.origin + (next ? next : '/'),
            }),
            signal: controller.signal,
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              if (typeof body.authorize_url === 'string') {
                window.location.href = body.authorize_url;
              } else {
                showBanner('OAuth start failed: missing authorize_url');
              }
            })
            .catch((err) => {
              showBanner(
                controller.signal.aborted
                  ? 'Sign-in provider took too long. Check your connection and try again.'
                  : err && err.message
                    ? err.message
                    : 'OAuth start failed.',
              );
            })
            .finally(() => {
              clearTimeout(timeoutId);
              oauthStartInFlight = false;
              setOauthButtonsDisabled(false);
              if (submitBtn) submitBtn.disabled = false;
              if (mfaSubmit) mfaSubmit.disabled = false;
            });
        });
      });
    })();
  </script>
</DashboardLayout>
