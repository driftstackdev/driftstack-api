---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-269 — Sign-in page for returning customers. Pairs with the V-184a
// signup flow + the V-267 cli/authorize deep-link round-trip.
//
// POSTs to /v1/auth/login (V-079) which returns a web session token.
// The token lands in localStorage under `ds_web_session_token` —
// identical key to signup → verify-email so cross-page reads
// "just work" for already-existing pages (dashboard, /cli/authorize,
// /api-keys, etc.).
//
// Honors `?next=` for deep-link round-trip from /cli/authorize and
// any future deep-link entry points; falls back to "/" for the typical
// "I came here from the marketing site" path.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Sign in" withSidebar={false}>
  <div class="mx-auto max-w-md px-6 py-16" data-page="login">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Sign in</h1>
    <p class="mt-3 text-sm text-slate-600">
      Welcome back. Sign in with the email and password from your Driftstack account.
    </p>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
      role="status"
    >
    </div>

    <form data-form="login" class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700" for="login-email">Email</label>
        <input
          id="login-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700" for="login-password">Password</label
        >
        <input
          id="login-password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <button type="submit" class="btn-primary w-full">Sign in</button>
    </form>

    <p class="mt-4 text-xs text-slate-500">
      <a href="/forgot-password" class="text-oxblood-700 underline">Forgot your password?</a>
    </p>

    <p class="mt-3 text-xs text-slate-500">
      No account yet? <a data-signup-link href="/signup" class="text-oxblood-700 underline"
        >Create one</a
      >.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="login"]');
      if (!root) return;
      const form = root.querySelector('[data-form="login"]');
      const banner = root.querySelector('[data-banner]');
      const signupLink = root.querySelector('[data-signup-link]');

      // V-269 — preserve ?next= when bouncing the user to /signup so a
      // returning user who clicks "Create one" doesn't lose their deep-
      // link target.
      const params = new URLSearchParams(window.location.search);
      const next = params.get('next');
      if (next && signupLink) {
        signupLink.setAttribute('href', '/signup?next=' + encodeURIComponent(next));
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const payload = {
          email: fd.get('email'),
          password: fd.get('password'),
        };

        fetch(apiBaseUrl + '/v1/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .then((b) =>
                    Promise.reject(new Error(b.detail || 'HTTP ' + r.status.toString())),
                  ),
          )
          .then((body) => {
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
            }
            // Honor ?next= round-trip; fall back to / for the typical
            // post-login landing.
            window.location.href = next ? next : '/';
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Sign-in failed.');
          });
      });
    })();
  </script>
</DashboardLayout>
