---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import {
  MAX_SESSION_MINUTES_PER_TIER,
  PROFILES_PER_TIER,
  PROXIES_PER_TIER,
  TIER_CONCURRENT_SESSION_LIMITS,
  TIER_FEATURES,
  TIER_STORAGE_BYTES_CAP,
  type AccountTier,
} from '@driftstack/api-types';

// V-184a — onboarding step 4 and the post-onboarding plan picker.
// The comparison rows below are derived from the same api-types tables
// enforced by the server, so checkout decisions never depend on copied caps.
//
// "Change plan" reuse: this same page is reachable from /billing
// "Change plan" link (post-onboarding). Every account starts on the
// perpetual free tier; the cards below upgrade to a paid tier.
//
// V-501 — disabled-while-pending guards on checkout buttons; copy
// micro-polish (cancel-anytime line, clearer "what changes" framing).

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

const TIERS: {
  id: AccountTier;
  label: string;
  price: string;
  ladder: string;
  /** Monthly amount in cents — used by the crypto checkout path. All
   *  tiers clear NowPayments' $19.16 USD-equivalent minimum. */
  priceCents: number;
}[] = [
  { id: 'solo_manual', label: 'Personal', price: '$79/mo', ladder: 'Manual', priceCents: 7900 },
  { id: 'team_manual', label: 'Team', price: '$249/mo', ladder: 'Manual', priceCents: 24900 },
  { id: 'agency_manual', label: 'Agency', price: '$699/mo', ladder: 'Manual', priceCents: 69900 },
  { id: 'api_starter', label: 'API Starter', price: '$149/mo', ladder: 'API', priceCents: 14900 },
  { id: 'api_builder', label: 'API Builder', price: '$499/mo', ladder: 'API', priceCents: 49900 },
  { id: 'api_scale', label: 'API Scale', price: '$1,499/mo', ladder: 'API', priceCents: 149900 },
];

// 2026-06-30 — tier id → human label, passed into the client script so the
// "already subscribed" branch (see the inline script below) can render
// "You're on the API Builder plan" instead of the raw "api_builder" id.
const TIER_LABELS: Record<string, string> = Object.fromEntries(
  TIERS.map((t) => [t.id, t.label]),
);

function storageLabel(tier: AccountTier): string {
  return `${String(TIER_STORAGE_BYTES_CAP[tier] / 2 ** 30)} GiB`;
}

function proxyLabel(tier: AccountTier): string {
  const cap = PROXIES_PER_TIER[tier];
  return cap === 'custom' ? 'Custom' : String(cap);
}

function durationLabel(tier: AccountTier): string {
  const minutes = MAX_SESSION_MINUTES_PER_TIER[tier];
  return minutes === null ? 'Unlimited' : `${String(minutes)} min`;
}

function accessLabel(tier: AccountTier): string {
  const features = TIER_FEATURES[tier];
  if (features.apiAccess && features.vpnEgress) return 'API + VPN';
  if (features.apiAccess) return 'API';
  if (features.vpnEgress) return 'VPN';
  return 'Desktop only';
}

function aiLabel(tier: AccountTier): string {
  const features = TIER_FEATURES[tier];
  if (!features.aiAgent || features.llmBilling === null) return 'Not included';
  if (features.llmBilling === 'byok_only') return 'BYOK';
  if (features.llmBilling === 'byok_or_bundled') return 'BYOK or $0.10/turn';
  return 'BYOK or contracted bundled';
}
---

<DashboardLayout title="Select tier" withSidebar={false}>
  {/* 2026-05-22 — atmospheric glow behind the tier-select hero (same
      family as the marketing pages + dashboard overview). Sits on a
      relative wrapper so it doesn't overflow the page bounds. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-16" data-page="select-tier">
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Choose your tier</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink md:text-4xl">
        Pick a plan.
      </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      Every tier runs the same verified browser engine and can use every
      currently available archetype. Operational limits and optional capabilities
      differ — compare concurrency, profiles, storage, saved proxies, access,
      and AI billing below. Cancel or downgrade anytime — your plan stays active
      through the end of the period you've already paid for. We don't
      provide automatic refunds for unused time. If you're an EU/UK
      consumer and want to cancel within 14 days of first subscribing,
      contact <a href="mailto:support@driftstack.dev" class="text-tk-accent-text underline">support@driftstack.dev</a>
      and we'll handle it case by case. Crypto payments are non-refundable.
    </p>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-tk-accent/30 bg-tk-accent/10 px-4 py-3 text-sm text-tk-accent-text"
      role="status"
    >
    </div>

    {/* 2026-05-27 — current-plan note. Every account starts on the
        perpetual free tier (1 profile, 1 session, 20-min cap). Picking a
        card below upgrades to a paid tier; there is no purchase step to
        stay free. (The one-time entry pack was retired alongside the
        free tier — its checkout endpoint no longer exists.) */}
    <!-- Free-tier note — replaced with the real current-plan summary
         client-side when the account already has an active/trialing
         subscription (see the inline script's applySubscriptionState). -->
    <div class="mt-8 rounded-lg border border-tk-border bg-tk-surface p-6" data-plan-note>
      <h2 class="flex items-center gap-2 text-xl font-semibold text-tk-ink">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <span data-field="plan-note-title">You're on the free plan</span>
      </h2>
      <p class="mt-2 text-sm text-tk-ink-2" data-field="plan-note-body">
        Free includes 1 profile, 1 concurrent session, and sessions up
        to 20 minutes each in the desktop GUI — no card required, and it
        never expires. API access, VPN egress, and the AI agent require a
        paid tier.
      </p>
    </div>

    {/* 2026-05-22 — paid tier grid: each card opens with a ladder
        icon (manual = user, api = code-brackets) for a visual anchor. */}
    <!-- Paid tier grid -->
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        TIERS.map((t) => (
          <div class="relative rounded-lg border border-tk-border bg-tk-surface p-5 hover:border-tk-accent/30 transition-colors">
            <div class="flex items-center justify-between">
              <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">{t.ladder}</p>
              <div class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 text-tk-accent ring-1 ring-tk-accent/30">
                {t.ladder === 'Manual' ? (
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="7" r="4" />
                    <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
              </div>
            </div>
            <h3 class="mt-2 text-lg font-semibold text-tk-ink">{t.label}</h3>
            <p class="mt-1 text-2xl font-semibold text-tk-ink">{t.price}</p>
            <dl class="mt-4 space-y-1 text-sm text-tk-ink-2">
              <div class="flex justify-between">
                <dt>Concurrent</dt>
                <dd class="font-mono">{TIER_CONCURRENT_SESSION_LIMITS[t.id].toString()}</dd>
              </div>
              <div class="flex justify-between">
                <dt>Profiles</dt>
                <dd class="font-mono">
                  {String(PROFILES_PER_TIER[t.id])}
                </dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>Session duration</dt>
                <dd class="font-mono text-right">{durationLabel(t.id)}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>Profile storage</dt>
                <dd class="font-mono text-right">{storageLabel(t.id)}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>Saved proxies</dt>
                <dd class="font-mono text-right">{proxyLabel(t.id)}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>Access</dt>
                <dd class="font-mono text-right">{accessLabel(t.id)}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt>AI agent</dt>
                <dd class="font-mono text-right">{aiLabel(t.id)}</dd>
              </div>
            </dl>
            <button
              type="button"
              data-action="buy-tier"
              data-tier={t.id}
              class="btn-secondary mt-4 w-full"
              disabled
              aria-disabled="true"
              title="Sign in and wait for live billing to load"
            >
              Start {t.label}
            </button>
            <button
              type="button"
              data-action="buy-tier-crypto"
              data-tier={t.id}
              data-tier-label={t.label}
              data-tier-price-cents={t.priceCents.toString()}
              class="mt-2 w-full text-xs text-tk-ink-3 hover:text-tk-accent-text"
              disabled
              aria-disabled="true"
              title="Sign in and wait for live billing to load"
            >
              or pay with crypto →
            </button>
          </div>
        ))
      }
    </div>

    {/* 2026-05-21 — V-666.D shared crypto checkout modal. Single modal
        for all 4 tier cards; the click handler reads data-tier +
        data-tier-label + data-tier-price-cents off the source button
        + POSTs /v1/billing/crypto-checkout. The modal is indexed by
        tier — each card supplies its own price_cents. */}
    <div
      data-crypto-modal
      class="fixed inset-0 z-50 hidden items-center justify-center bg-tk-bg/80 backdrop-blur-md p-6"
      role="dialog"
      aria-modal="true"
      aria-labelledby="crypto-modal-title"
    >
      <div class="rounded-lg border border-tk-border bg-tk-surface p-6 max-w-md w-full">
        <div class="flex items-start justify-between gap-4">
          <h3 id="crypto-modal-title" class="text-lg font-semibold text-tk-ink">
            Pay <span data-field="crypto-tier-label">—</span> with crypto
          </h3>
          <button
            type="button"
            data-crypto-modal-close
            aria-label="Close"
            class="text-tk-ink-3 hover:text-tk-ink"
          >
            ✕
          </button>
        </div>
        <div data-crypto-modal-loading class="mt-6 text-sm text-tk-ink-3">
          Minting payment address…
        </div>
        <div
          data-crypto-modal-error
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
          class="mt-6 hidden rounded-md bg-tk-accent/10 px-3 py-2 text-sm text-tk-accent-text"
        ></div>
        <div data-crypto-modal-ready class="mt-6 hidden">
          <p class="text-sm text-tk-ink-2">
            Send exactly{' '}
            <span data-field="crypto-amount" class="font-mono text-tk-ink">—</span>{' '}
            <span data-field="crypto-currency" class="font-mono text-tk-ink uppercase">—</span>{' '}
            to:
          </p>
          <div class="mt-3 break-all rounded-md bg-tk-bg px-3 py-2 font-mono text-xs text-tk-ink">
            <span data-field="crypto-address">—</span>
          </div>
          <button
            type="button"
            data-crypto-copy
            aria-label="Copy payment address"
            aria-live="polite"
            aria-atomic="true"
            class="mt-3 text-sm text-tk-accent-text hover:underline"
          >
            Copy address
          </button>
          <p class="mt-4 text-xs text-tk-ink-3">
            Order <code data-field="crypto-order-id" class="font-mono">—</code> · once your
            transaction is detected (usually within minutes), your subscription activates
            automatically. You can close this window — your order is tracked even if you
            navigate away. Crypto payments are final and non-refundable.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-xs text-tk-ink-3">
      Enterprise tier (~$4,000/mo, custom) — <a href="mailto:sales@driftstack.dev" class="text-tk-accent-text underline">contact sales</a>.
    </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, tierLabels: TIER_LABELS }}>
    (function () {
      const root = document.querySelector('[data-page="select-tier"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = (() => {
        try {
          return localStorage.getItem('ds_web_session_token');
        } catch {
          return null;
        }
      })();

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      const AUTHED_REQUEST_TIMEOUT_MS = 15_000;
      const ownedRequestControllers = new Set();
      function authedFetch(path, init = {}) {
        // Mutations below already own an AbortSignal because their busy-state
        // lease needs the same deadline. Reads without one still need a hard
        // transport bound: otherwise the initial subscription check can hang
        // forever and leave an existing subscriber looking eligible to start a
        // second Checkout. Track only controllers created here so pagehide can
        // cancel an orphaned read without interfering with caller-owned work.
        const ownsController = !init.signal;
        const controller = ownsController ? new AbortController() : null;
        const signal = init.signal || controller.signal;
        const timeout = ownsController
          ? window.setTimeout(() => controller.abort(), AUTHED_REQUEST_TIMEOUT_MS)
          : null;
        if (controller) ownedRequestControllers.add(controller);
        let cleaned = false;
        function cleanupOwnedRequest() {
          if (cleaned || !ownsController) return;
          cleaned = true;
          if (timeout !== null) window.clearTimeout(timeout);
          if (controller) ownedRequestControllers.delete(controller);
        }
        return fetch(apiBaseUrl + path, {
          ...init,
          signal,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
          },
          credentials: 'include',
        }).then(
          (response) => {
            // Fetch resolves when response HEADERS arrive, not when JSON/text
            // finishes. Keep the owned deadline armed through body decoding so
            // the initial subscription hydrate cannot hang forever on a
            // truncated/stalled response and leave every tier looking eligible.
            // Caller-owned mutation signals are intentionally untouched: their
            // withBusy/crypto leases already span the complete operation.
            if (!ownsController) return response;
            if (response.body === null) {
              cleanupOwnedRequest();
              return response;
            }
            let wrappedBodyMethod = false;
            ['arrayBuffer', 'blob', 'formData', 'json', 'text'].forEach((method) => {
              const original = response[method];
              if (typeof original !== 'function') return;
              wrappedBodyMethod = true;
              response[method] = function () {
                let decoded;
                try {
                  decoded = original.apply(response, arguments);
                } catch (error) {
                  cleanupOwnedRequest();
                  throw error;
                }
                return Promise.resolve(decoded).finally(cleanupOwnedRequest);
              };
            });
            if (!wrappedBodyMethod) cleanupOwnedRequest();
            return response;
          },
          (error) => {
            cleanupOwnedRequest();
            throw error;
          },
        );
      }
      window.addEventListener('pagehide', () => {
        stopCryptoOrderPolling();
        ownedRequestControllers.forEach((controller) => controller.abort());
        ownedRequestControllers.clear();
      });

      // V-501 — disable a button while its checkout-session call is in
      // flight so the customer can't double-click and create two Stripe
      // sessions. Original label restored on error so they can retry.
      const CHECKOUT_TIMEOUT_MS = 15_000;
      const busyCheckoutButtons = new WeakSet();
      let checkoutInFlightButton = null;
      function withBusy(btn, work) {
        if (busyCheckoutButtons.has(btn)) return Promise.resolve();
        if (checkoutInFlightButton !== null) return Promise.resolve();
        busyCheckoutButtons.add(btn);
        checkoutInFlightButton = btn;
        const buttonStates = Array.from(tierButtons).map((button) => ({
          button,
          disabled: button.disabled,
          text: button.textContent,
          title: button.getAttribute('title'),
        }));
        tierButtons.forEach((button) => {
          button.disabled = true;
          button.setAttribute('aria-disabled', 'true');
          button.setAttribute('title', 'Wait for the active checkout request to finish.');
        });
        const original = btn.textContent;
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = 'Redirecting…';
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), CHECKOUT_TIMEOUT_MS);
        return Promise.resolve()
          .then(() => work(controller.signal))
          .catch((err) => {
            if (err && err.name === 'AbortError') {
              const timeoutError = new Error(
                'The billing request took too long. Check your connection and try again.',
              );
              timeoutError.name = 'AbortError';
              throw timeoutError;
            }
            throw err;
          })
          .finally(() => {
            window.clearTimeout(timeout);
            busyCheckoutButtons.delete(btn);
            checkoutInFlightButton = null;
            btn.setAttribute('aria-busy', 'false');
            btn.textContent = original;
            buttonStates.forEach(({ button, disabled, text, title }) => {
              button.disabled = disabled;
              button.textContent = text;
              button.removeAttribute('aria-disabled');
              if (title === null) button.removeAttribute('title');
              else button.setAttribute('title', title);
            });
            if (isActiveSubscription(currentSubscription)) {
              applySubscriptionState(currentSubscription);
            }
          });
      }

      // 2026-06-30 — double-subscribe fix (finding #1). An already-subscribed
      // customer must change plans through the Stripe Customer Portal
      // (in-place proration), never by starting a brand-new Checkout
      // session — Stripe Checkout in `subscription` mode does not
      // dedupe against an existing subscription and would mint a
      // SECOND concurrent one (double billing). `currentSubscription`
      // is populated best-effort from GET /v1/billing below; the
      // server independently rejects a stray checkout-session call
      // with 409 even if this client-side state is stale/bypassed.
      let currentSubscription = null;
      function isActiveSubscription(sub) {
        return !!sub && (sub.status === 'active' || sub.status === 'trialing');
      }

      const tierButtons = root.querySelectorAll('[data-action="buy-tier"]');
      const cryptoBtns = root.querySelectorAll('[data-action="buy-tier-crypto"]');
      const cryptoLinksByTier = new Map();
      const checkoutKeysByTier = new Map();
      const SELF_ACCOUNT_ID_RE =
        /^acc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
      const cryptoIntentLocksAvailable =
        typeof navigator.locks === 'object' &&
        navigator.locks !== null &&
        typeof navigator.locks.request === 'function';
      const selectedWorkspaceAccountId = (() => {
        try {
          const headers =
            typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {};
          const value = headers && headers['x-driftstack-account'];
          return typeof value === 'string' ? value : '';
        } catch {
          return '';
        }
      })();
      const cryptoWorkspaceSupported = selectedWorkspaceAccountId.length === 0;
      let authoritativeSelfAccountId = null;
      let billingDataAvailable = false;
      let billingUnavailableReason = token
        ? 'Wait for live billing to load'
        : 'Sign in to choose a paid plan';

      function cryptoCheckoutUnavailableReason() {
        if (!cryptoWorkspaceSupported) {
          return 'Switch the workspace picker to Self before starting a payment.';
        }
        if (!cryptoIntentLocksAvailable) {
          return 'Secure crypto checkout needs browser cross-tab locking support.';
        }
        return billingUnavailableReason;
      }

      function cryptoCheckoutDisabled() {
        return (
          !billingDataAvailable ||
          !cryptoWorkspaceSupported ||
          !cryptoIntentLocksAvailable ||
          authoritativeSelfAccountId === null ||
          isActiveSubscription(currentSubscription)
        );
      }

      function setBillingAuthority(available, reason = '') {
        billingDataAvailable = available;
        if (reason) billingUnavailableReason = reason;
        tierButtons.forEach((button) => {
          button.disabled = !available;
          if (available) {
            button.removeAttribute('aria-disabled');
            button.removeAttribute('title');
          } else {
            button.setAttribute('aria-disabled', 'true');
            button.title = billingUnavailableReason;
          }
        });
        cryptoBtns.forEach((button) => {
          const disabled =
            !available ||
            !cryptoWorkspaceSupported ||
            !cryptoIntentLocksAvailable ||
            authoritativeSelfAccountId === null;
          button.disabled = disabled;
          if (!disabled) {
            button.removeAttribute('aria-disabled');
            button.removeAttribute('title');
          } else {
            button.setAttribute('aria-disabled', 'true');
            button.title = cryptoCheckoutUnavailableReason();
          }
        });
      }

      setBillingAuthority(false);

      function checkoutKeyFor(tier) {
        const existing = checkoutKeysByTier.get(tier);
        if (existing) return existing;
        const key =
          window.crypto && typeof window.crypto.randomUUID === 'function'
            ? window.crypto.randomUUID()
            : 'checkout-' + Date.now() + '-' + Math.random().toString(36).slice(2);
        checkoutKeysByTier.set(tier, key);
        return key;
      }

      function applySubscriptionState(sub) {
        currentSubscription = sub;
        if (!isActiveSubscription(sub)) return;

        const label = (sub.tier && tierLabels[sub.tier]) || sub.tier;
        const titleEl = root.querySelector('[data-field="plan-note-title"]');
        const bodyEl = root.querySelector('[data-field="plan-note-body"]');
        if (titleEl) titleEl.textContent = "You're on the " + label + ' plan';
        if (bodyEl) {
          bodyEl.textContent =
            'Your ' +
            label +
            ' plan is ' +
            sub.status +
            (sub.cancel_at_period_end ? ' (cancels at the end of the current period)' : '') +
            '. Pick a different tier below to switch plans — plan changes go through the' +
            ' Stripe customer portal so any price difference is prorated automatically.';
        }

        tierButtons.forEach((btn) => {
          const tier = btn.getAttribute('data-tier');
          const cryptoLink = cryptoLinksByTier.get(tier);
          if (tier === sub.tier) {
            btn.textContent = 'Current plan';
            btn.disabled = true;
            btn.setAttribute('aria-disabled', 'true');
            btn.title = 'This is your current plan';
            btn.classList.add('opacity-60', 'cursor-not-allowed');
            if (cryptoLink) {
              cryptoLink.classList.add('hidden');
              cryptoLink.disabled = true;
              cryptoLink.setAttribute('aria-disabled', 'true');
              cryptoLink.title = 'Use the Stripe billing portal to change an active plan';
            }
          } else {
            btn.textContent = 'Switch to this plan';
            // Starting a NEW crypto order while already on a paid Stripe
            // subscription is the same double-subscribe risk class — hide
            // it too; switching plans goes through the portal above.
            if (cryptoLink) {
              cryptoLink.classList.add('hidden');
              cryptoLink.disabled = true;
              cryptoLink.setAttribute('aria-disabled', 'true');
              cryptoLink.title = 'Use the Stripe billing portal to change an active plan';
            }
          }
        });
      }

      tierButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!token) {
            showBanner('Sign up first.');
            return;
          }
          if (!billingDataAvailable) {
            showBanner('Wait for live billing to load. Reload if loading failed.');
            return;
          }
          const tier = btn.getAttribute('data-tier');

          if (isActiveSubscription(currentSubscription)) {
            if (tier === currentSubscription.tier) return; // "Current plan" — disabled, no-op.
            withBusy(btn, (signal) =>
              authedFetch('/v1/billing/portal-session', { method: 'POST', body: '{}', signal })
                .then((r) =>
                  r.ok
                    ? r.json()
                    : r
                        .json()
                        .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
                )
                .then((body) => {
                  // Finding #20 — don't leave the button stuck on
                  // "Redirecting…" forever if the 200 body is malformed
                  // and has no portal_url; throw so withBusy's .catch
                  // restores the button and the banner shows an error.
                  const portalUrl = window.driftstackTrustedRedirectUrl(body.portal_url, [
                    'https://billing.stripe.com',
                  ]);
                  if (!portalUrl) throw new Error('No valid portal URL returned.');
                  window.location.href = portalUrl;
                }),
            ).catch((err) => {
              showBanner(
                "Couldn't open the billing portal (" +
                  window.driftstackRequestErrorMessage(
                    err,
                    "Couldn't open the billing portal. Try again.",
                  ) +
                  ').',
              );
            });
            return;
          }

          const checkoutKey = checkoutKeyFor(tier);
          withBusy(btn, (signal) =>
            authedFetch('/v1/billing/checkout-session', {
              method: 'POST',
              signal,
              headers: { 'idempotency-key': checkoutKey },
              body: JSON.stringify({
                tier,
                billing_period: 'monthly',
                success_url: window.location.origin + '/?subscribed=' + tier,
                cancel_url: window.location.origin + '/select-tier',
              }),
            })
              .then((r) => {
                // An HTTP response settles this attempt. Only a transport
                // failure keeps the key so a retry replays Stripe's result.
                checkoutKeysByTier.delete(tier);
                // Wave 1086+ B1 client-side leg: 404/503 on /v1/billing/*
                // means billing isn't wired (DRIFTSTACK_TIER_PRICE_IDS
                // env var missing). Surface a customer-friendly message
                // instead of "HTTP 404", which reads as a broken site.
                if (r.status === 404 || r.status === 503) {
                  return Promise.reject(
                    window.driftstackResponseError(r, {
                      detail:
                        'Card checkout is unavailable on this server. Use crypto checkout if it is offered below, or email billing@driftstack.dev.',
                    }),
                  );
                }
                // 2026-06-30 — surface a 409 double-subscribe rejection (the
                // server-side backstop for finding #1) with an honest
                // message rather than a bare "HTTP 409".
                if (r.status === 409) {
                  return Promise.reject(
                    window.driftstackResponseError(r, {
                      detail:
                        'You already have an active subscription. Use the billing portal to change plans.',
                    }),
                  );
                }
                return r.ok
                  ? r.json()
                  : r
                      .json()
                      .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
              })
              .then((body) => {
                // Finding #20 — a 200 with no checkout_url (malformed/
                // altered response) must not leave the button stuck on
                // "Redirecting…" with no way to retry; throw so
                // withBusy's .catch resets it and shows an error.
                const checkoutUrl = window.driftstackTrustedRedirectUrl(body.checkout_url, [
                  'https://checkout.stripe.com',
                ]);
                if (!checkoutUrl) throw new Error('No valid checkout URL returned.');
                window.location.href = checkoutUrl;
              }),
          ).catch((err) => {
            showBanner(
              "Couldn't start checkout (" +
                window.driftstackRequestErrorMessage(
                  err,
                  "Couldn't start checkout. Try again.",
                ) +
                ').',
            );
          });
        });
      });

      // 2026-05-21 — V-666.D crypto checkout per-tier. Each tier card
      // has a small "or pay with crypto →" link beneath the primary
      // Stripe button; clicking opens the shared modal + POSTs
      // /v1/billing/crypto-checkout with the tier's price_cents. All
      // tiers clear NowPayments' $19.16 USD-equivalent floor.
      cryptoBtns.forEach((btn) => {
        const tier = btn.getAttribute('data-tier');
        if (tier) cryptoLinksByTier.set(tier, btn);
      });
      const cryptoModal = root.querySelector('[data-crypto-modal]');
      const cryptoLoading = root.querySelector('[data-crypto-modal-loading]');
      const cryptoError = root.querySelector('[data-crypto-modal-error]');
      const cryptoReady = root.querySelector('[data-crypto-modal-ready]');
      const cryptoCloseBtn = root.querySelector('[data-crypto-modal-close]');
      const cryptoCopyBtn = root.querySelector('[data-crypto-copy]');
      let cryptoCopyInFlight = false;
      let cryptoPayableAddress = null;
      let cryptoCopyGeneration = 0;
      let cryptoCopyResetTimer = null;

      function resetCryptoCopyFeedback() {
        if (!cryptoCopyBtn) return;
        if (cryptoCopyResetTimer !== null) window.clearTimeout(cryptoCopyResetTimer);
        cryptoCopyResetTimer = null;
        cryptoCopyBtn.textContent = 'Copy address';
        cryptoCopyBtn.setAttribute('aria-label', 'Copy payment address');
      }

      function showCryptoCopyResult(label, ariaLabel, generation) {
        if (!cryptoCopyBtn || generation !== cryptoCopyGeneration) return;
        resetCryptoCopyFeedback();
        cryptoCopyBtn.textContent = label;
        cryptoCopyBtn.setAttribute('aria-label', ariaLabel);
        cryptoCopyResetTimer = window.setTimeout(() => {
          if (generation === cryptoCopyGeneration) resetCryptoCopyFeedback();
        }, 2200);
      }

      function syncCryptoCopyAvailability() {
        if (!cryptoCopyBtn) return;
        const hasPayableAddress =
          typeof cryptoPayableAddress === 'string' && cryptoPayableAddress.length > 0;
        cryptoCopyBtn.disabled = cryptoCopyInFlight || !hasPayableAddress;
        cryptoCopyBtn.setAttribute('aria-busy', cryptoCopyInFlight ? 'true' : 'false');
        if (cryptoCopyInFlight && hasPayableAddress) {
          cryptoCopyBtn.title = 'Wait for the previous copy request to finish.';
        } else {
          cryptoCopyBtn.removeAttribute('title');
        }
      }

      function invalidateCryptoCopyTarget() {
        cryptoCopyGeneration += 1;
        cryptoPayableAddress = null;
        resetCryptoCopyFeedback();
        // Presentation ownership can change while the platform clipboard write
        // is still pending. Keep the transport latch until that exact promise
        // settles so a late old-address write can never overtake a new copy.
        syncCryptoCopyAvailability();
      }

      function setCryptoCopyTarget(address) {
        cryptoPayableAddress = address;
        syncCryptoCopyAvailability();
      }

      // One browser key represents one logical crypto-order intent. The key
      // survives ambiguous transport outcomes and remains attached while the
      // order is pending / confirming / partial. A paid / failed / cancelled
      // order retires only its exact key so a later explicit click can create
      // a genuinely new order. Web Locks serialize the read/create/rotate +
      // POST sequence across tabs; without that origin-wide primitive the
      // checkout fails closed rather than racing two non-refundable addresses.
      const cryptoOrderCache = new Map();
      let cryptoRequestInFlight = false;
      let cryptoPollTimer = null;
      let cryptoExpiryTimer = null;
      let cryptoPollGeneration = 0;

      const CRYPTO_TERMINAL_STATUSES = new Set(['paid', 'failed', 'cancelled']);
      const CRYPTO_NON_PAYABLE_STATUSES = new Set([
        'confirming',
        'partial',
        ...CRYPTO_TERMINAL_STATUSES,
      ]);

      function cryptoIntentScope(tier) {
        if (!authoritativeSelfAccountId) return null;
        return {
          accountId: authoritativeSelfAccountId,
          tier,
          storageKey: 'ds_crypto_idem_v2:' + authoritativeSelfAccountId + ':' + tier,
          lockName: 'driftstack:crypto-checkout:' + authoritativeSelfAccountId + ':' + tier,
        };
      }

      function newCryptoIntentKey() {
        return typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
          ? 'crypto-intent-' + crypto.randomUUID()
          : 'crypto-intent-' + Date.now().toString() + '-' + Math.random().toString(36).slice(2);
      }

      function readOrCreateCryptoIntentKey(tier) {
        const scope = cryptoIntentScope(tier);
        if (!scope) return null;
        try {
          const existing = localStorage.getItem(scope.storageKey);
          if (existing) {
            const parsed = JSON.parse(existing);
            if (
              !parsed ||
              typeof parsed !== 'object' ||
              parsed.version !== 2 ||
              parsed.account_id !== scope.accountId ||
              parsed.product !== scope.tier ||
              typeof parsed.idempotency_key !== 'string' ||
              !/^[\x21-\x7e]{1,255}$/.test(parsed.idempotency_key)
            ) {
              return null;
            }
            return parsed.idempotency_key;
          }
          const key = newCryptoIntentKey();
          const encoded = JSON.stringify({
            version: 2,
            account_id: scope.accountId,
            product: scope.tier,
            idempotency_key: key,
          });
          localStorage.setItem(scope.storageKey, encoded);
          return localStorage.getItem(scope.storageKey) === encoded ? key : null;
        } catch {
          return null;
        }
      }

      function compareRetireCryptoIntentKey(tier, expectedKey) {
        const scope = cryptoIntentScope(tier);
        if (!scope) return false;
        try {
          const encoded = localStorage.getItem(scope.storageKey);
          if (!encoded) return false;
          const parsed = JSON.parse(encoded);
          if (
            !parsed ||
            typeof parsed !== 'object' ||
            parsed.version !== 2 ||
            parsed.account_id !== scope.accountId ||
            parsed.product !== scope.tier ||
            parsed.idempotency_key !== expectedKey
          ) {
            return false;
          }
          localStorage.removeItem(scope.storageKey);
          return localStorage.getItem(scope.storageKey) === null;
        } catch {
          return false;
        }
      }

      function withCryptoIntentLock(tier, work, signal) {
        if (!cryptoIntentLocksAvailable) {
          return Promise.reject(new Error('Secure crypto checkout needs browser locking support.'));
        }
        const scope = cryptoIntentScope(tier);
        if (!scope) {
          return Promise.reject(new Error('The signed-in account could not be verified.'));
        }
        return signal
          ? navigator.locks.request(
              scope.lockName,
              { mode: 'exclusive', signal },
              work,
            )
          : navigator.locks.request(scope.lockName, { mode: 'exclusive' }, work);
      }
      const CRYPTO_TIMEOUT_MS = 15_000;
      const CRYPTO_STATUS_POLL_MS = 5_000;
      const CRYPTO_MAX_TIMER_MS = 2_147_483_647;

      function setCryptoText(key, value) {
        const el = root.querySelector('[data-field="' + key + '"]');
        if (el && typeof value === 'string') el.textContent = value;
      }
      function showCryptoModal() {
        if (!cryptoModal) return;
        cryptoModal.classList.remove('hidden');
        cryptoModal.classList.add('flex');
      }
      function hideCryptoModal() {
        if (!cryptoModal) return;
        stopCryptoOrderPolling();
        invalidateCryptoCopyTarget();
        cryptoModal.classList.add('hidden');
        cryptoModal.classList.remove('flex');
      }
      function showCryptoError(msg) {
        if (!cryptoLoading || !cryptoError || !cryptoReady) return;
        cryptoLoading.classList.add('hidden');
        cryptoReady.classList.add('hidden');
        cryptoError.textContent = msg;
        cryptoError.classList.remove('hidden');
      }

      function stopCryptoOrderPolling() {
        cryptoPollGeneration += 1;
        if (cryptoPollTimer !== null) window.clearTimeout(cryptoPollTimer);
        if (cryptoExpiryTimer !== null) window.clearTimeout(cryptoExpiryTimer);
        cryptoPollTimer = null;
        cryptoExpiryTimer = null;
      }

      function hideCryptoPaymentAddress(message) {
        stopCryptoOrderPolling();
        invalidateCryptoCopyTarget();
        setCryptoText('crypto-amount', '—');
        setCryptoText('crypto-currency', '—');
        setCryptoText('crypto-address', '—');
        showCryptoError(message);
      }

      function cryptoStatusMessage(status, orderId) {
        if (status === 'confirming') {
          return (
            'Order ' +
            orderId +
            ' is confirming on-chain. Do not send another payment or start another order.'
          );
        }
        if (status === 'partial') {
          return (
            'Order ' +
            orderId +
            ' received a partial payment. Do not send again here; contact billing@driftstack.dev.'
          );
        }
        if (status === 'paid') {
          return 'Order ' + orderId + ' is paid. Its payment address is now closed.';
        }
        if (status === 'failed') {
          return 'Order ' + orderId + ' is closed. Start a new payment to receive a new address.';
        }
        return 'Order ' + orderId + ' was cancelled. Start a new payment to receive a new address.';
      }

      function validateCryptoCheckoutBody(body, expectedTier) {
        if (!body || typeof body !== 'object') return null;
        if (
          typeof body.order_id !== 'string' ||
          !/^ord_[A-Za-z0-9_-]{1,96}$/.test(body.order_id) ||
          body.product !== expectedTier ||
          (body.provider !== 'stub' && body.provider !== 'nowpayments')
        ) {
          return null;
        }
        if (
          ![
            'pending',
            'confirming',
            'partial',
            'paid',
            'failed',
            'cancelled',
          ].includes(body.status)
        ) {
          return null;
        }
        return body;
      }

      function normalizePositiveCryptoAmount(value) {
        const text = typeof value === 'number' ? String(value) : value;
        if (
          typeof text !== 'string' ||
          text.length < 1 ||
          text.length > 64 ||
          !/^(?:0|[1-9][0-9]*)(?:\.[0-9]+)?$/.test(text)
        ) {
          return null;
        }
        const numeric = Number(text);
        return Number.isFinite(numeric) && numeric > 0 ? text : null;
      }

      function validateCryptoPaymentCandidate(body) {
        if (body.provider !== 'nowpayments') return null;
        if (
          typeof body.payment_address !== 'string' ||
          !/^[\x21-\x7e]{1,256}$/.test(body.payment_address) ||
          typeof body.pay_currency !== 'string' ||
          !/^[A-Za-z0-9_-]{2,32}$/.test(body.pay_currency)
        ) {
          return null;
        }
        const payAmount = normalizePositiveCryptoAmount(body.pay_amount);
        if (payAmount === null) return null;
        return {
          payAmount,
          payCurrency: body.pay_currency,
          paymentAddress: body.payment_address,
        };
      }

      function validateCryptoOrderAuthority(body, entry) {
        if (
          !body ||
          typeof body !== 'object' ||
          body.order_id !== entry.orderId ||
          body.product !== entry.tier ||
          ![
            'pending',
            'confirming',
            'partial',
            'paid',
            'failed',
            'cancelled',
          ].includes(body.status)
        ) {
          return null;
        }
        if (body.status !== 'pending') return { status: body.status, expiresAtMs: null };
        if (typeof body.expires_at !== 'string') return null;
        const expiresAtMs = Date.parse(body.expires_at);
        if (!Number.isFinite(expiresAtMs) || expiresAtMs <= Date.now()) return null;
        return { status: body.status, expiresAtMs };
      }

      async function readCryptoOrderAuthority(entry, signal) {
        const res = await authedFetch(
          '/v1/billing/crypto-orders/' + encodeURIComponent(entry.orderId),
          signal ? { method: 'GET', signal } : { method: 'GET' },
        );
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw window.driftstackResponseError(res, body);
        const authority = validateCryptoOrderAuthority(body, entry);
        if (!authority) throw new Error('Crypto order authority response was incomplete.');
        return authority;
      }

      function armCryptoExpiryDeadline(entry, expiresAtMs, generation) {
        if (generation !== cryptoPollGeneration) return;
        if (cryptoExpiryTimer !== null) window.clearTimeout(cryptoExpiryTimer);
        const remaining = expiresAtMs - Date.now();
        if (remaining <= 0) {
          hideCryptoPaymentAddress(
            'Order ' +
              entry.orderId +
              ' reached its payment deadline. Reopen checkout to verify it before sending.',
          );
          return;
        }
        cryptoExpiryTimer = window.setTimeout(() => {
          if (generation !== cryptoPollGeneration) return;
          if (Date.now() < expiresAtMs) {
            armCryptoExpiryDeadline(entry, expiresAtMs, generation);
            return;
          }
          hideCryptoPaymentAddress(
            'Order ' +
              entry.orderId +
              ' reached its payment deadline. Reopen checkout to verify it before sending.',
          );
        }, Math.min(remaining, CRYPTO_MAX_TIMER_MS));
      }

      function startCryptoOrderPolling(entry, initialExpiresAtMs) {
        stopCryptoOrderPolling();
        const generation = cryptoPollGeneration;
        armCryptoExpiryDeadline(entry, initialExpiresAtMs, generation);

        const poll = async () => {
          if (generation !== cryptoPollGeneration) return;
          try {
            const authority = await readCryptoOrderAuthority(entry);
            if (generation !== cryptoPollGeneration) return;
            if (authority.status === 'pending') {
              armCryptoExpiryDeadline(entry, authority.expiresAtMs, generation);
              cryptoPollTimer = window.setTimeout(poll, CRYPTO_STATUS_POLL_MS);
              return;
            }
            if (!CRYPTO_NON_PAYABLE_STATUSES.has(authority.status)) {
              throw new Error('Crypto order returned an unknown status.');
            }

            const cached = cryptoOrderCache.get(entry.tier);
            if (cached && cached.orderId === entry.orderId) cryptoOrderCache.delete(entry.tier);
            hideCryptoPaymentAddress(cryptoStatusMessage(authority.status, entry.orderId));
            if (CRYPTO_TERMINAL_STATUSES.has(authority.status)) {
              await withCryptoIntentLock(entry.tier, () =>
                compareRetireCryptoIntentKey(entry.tier, entry.idempotencyKey),
              );
            }
          } catch (err) {
            if (generation !== cryptoPollGeneration) return;
            hideCryptoPaymentAddress(
              window.driftstackRequestErrorMessage(
                err,
                'Order status could not be verified. Do not send payment until you reopen checkout.',
              ),
            );
          }
        };

        cryptoPollTimer = window.setTimeout(poll, CRYPTO_STATUS_POLL_MS);
      }

      cryptoBtns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!token) {
            showBanner('Sign in to pay with crypto.');
            return;
          }
          if (!cryptoWorkspaceSupported) {
            showBanner('Switch the workspace picker to Self before starting a payment.');
            return;
          }
          if (!cryptoIntentLocksAvailable) {
            showBanner('Secure crypto checkout needs browser cross-tab locking support.');
            return;
          }
          if (!billingDataAvailable) {
            showBanner('Wait for live billing to load. Reload if loading failed.');
            return;
          }
          if (isActiveSubscription(currentSubscription)) {
            showBanner('Use the Stripe billing portal to change an active plan.');
            return;
          }
          if (cryptoRequestInFlight) return; // guard: a mint is already in flight.
          const tier = btn.getAttribute('data-tier');
          const tierLabel = btn.getAttribute('data-tier-label') ?? tier;
          const priceCents = Number(btn.getAttribute('data-tier-price-cents'));
          if (!tier || !Number.isFinite(priceCents)) return;
          if (!cryptoLoading || !cryptoError || !cryptoReady) return;
          setCryptoText('crypto-tier-label', tierLabel);
          cryptoError.classList.add('hidden');
          stopCryptoOrderPolling();
          invalidateCryptoCopyTarget();
          cryptoLoading.classList.remove('hidden');
          cryptoReady.classList.add('hidden');
          setCryptoText('crypto-amount', '—');
          setCryptoText('crypto-currency', '—');
          setCryptoText('crypto-address', '—');
          showCryptoModal();
          cryptoRequestInFlight = true;
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          const controller = new AbortController();
          const timeout = window.setTimeout(() => controller.abort(), CRYPTO_TIMEOUT_MS);
          try {
            await withCryptoIntentLock(
              tier,
              async () => {
                let idempotencyKey = readOrCreateCryptoIntentKey(tier);
                if (!idempotencyKey) {
                  showCryptoError(
                    'Secure crypto checkout needs browser site storage to prevent duplicate payment orders. Enable site storage and try again.',
                  );
                  return;
                }

                // At most one successor is allowed in this click. The first
                // terminal response proves the persisted intent is finished;
                // retiring that exact key and issuing one fresh request fulfils
                // the customer's explicit Pay click without looping through a
                // corrupt or unexpectedly terminal response forever.
                for (let attempt = 0; attempt < 2; attempt += 1) {
                  const res = await authedFetch('/v1/billing/crypto-checkout', {
                    method: 'POST',
                    signal: controller.signal,
                    headers: {
                      'content-type': 'application/json',
                      'idempotency-key': idempotencyKey,
                    },
                    body: JSON.stringify({
                      product: tier,
                      price_cents: priceCents,
                      price_currency: 'USD',
                    }),
                  });
                  const decoded = await res.json().catch(() => ({}));
                  if (!res.ok) {
                    showCryptoError(
                      window.driftstackRequestErrorMessage(
                        window.driftstackResponseError(res, decoded),
                        'Could not start crypto checkout. Try again.',
                      ),
                    );
                    return;
                  }
                  const body = validateCryptoCheckoutBody(decoded, tier);
                  if (!body) {
                    showCryptoError(
                      'Crypto checkout returned an incomplete response. Try again with the same payment intent.',
                    );
                    return;
                  }

                  if (CRYPTO_TERMINAL_STATUSES.has(body.status)) {
                    cryptoOrderCache.delete(tier);
                    hideCryptoPaymentAddress(cryptoStatusMessage(body.status, body.order_id));
                    const retired = compareRetireCryptoIntentKey(tier, idempotencyKey);
                    if (!retired) {
                      showCryptoError(
                        'The completed payment intent could not be retired safely. Reload before starting another payment.',
                      );
                      return;
                    }
                    if (attempt === 0) {
                      idempotencyKey = readOrCreateCryptoIntentKey(tier);
                      if (!idempotencyKey) {
                        showCryptoError(
                          'Secure crypto checkout needs browser site storage to start a new payment.',
                        );
                        return;
                      }
                      cryptoLoading.classList.remove('hidden');
                      cryptoError.classList.add('hidden');
                      continue;
                    }
                    return;
                  }

                  if (body.status === 'confirming' || body.status === 'partial') {
                    cryptoOrderCache.delete(tier);
                    hideCryptoPaymentAddress(cryptoStatusMessage(body.status, body.order_id));
                    return;
                  }

                  if (body.provider === 'stub') {
                    cryptoOrderCache.delete(tier);
                    showCryptoError(
                      'Crypto checkout is unavailable on this server. Use card checkout, or email ' +
                        'billing@driftstack.dev with order_id ' +
                        body.order_id +
                        ' for manual payment instructions.',
                    );
                    return;
                  }

                  const candidate = validateCryptoPaymentCandidate(body);
                  if (!candidate) {
                    cryptoOrderCache.delete(tier);
                    hideCryptoPaymentAddress(
                      'Crypto checkout returned malformed payment details. Do not send payment; retry with the same payment intent.',
                    );
                    return;
                  }

                  const cacheEntry = {
                    payAmount: candidate.payAmount,
                    payCurrency: candidate.payCurrency,
                    paymentAddress: candidate.paymentAddress,
                    orderId: body.order_id,
                    idempotencyKey,
                    tier,
                  };
                  let authority;
                  try {
                    // The POST address is only a candidate. Before it can enter
                    // the DOM/clipboard, re-read the exact account-owned order
                    // and prove product, pending status, and a future deadline.
                    authority = await readCryptoOrderAuthority(cacheEntry, controller.signal);
                  } catch (err) {
                    hideCryptoPaymentAddress(
                      window.driftstackRequestErrorMessage(
                        err,
                        'Order status could not be verified. Do not send payment; retry with the same payment intent.',
                      ),
                    );
                    return;
                  }
                  if (CRYPTO_TERMINAL_STATUSES.has(authority.status)) {
                    cryptoOrderCache.delete(tier);
                    hideCryptoPaymentAddress(
                      cryptoStatusMessage(authority.status, cacheEntry.orderId),
                    );
                    const retired = compareRetireCryptoIntentKey(tier, idempotencyKey);
                    if (!retired) {
                      showCryptoError(
                        'The completed payment intent could not be retired safely. Reload before starting another payment.',
                      );
                      return;
                    }
                    if (attempt === 0) {
                      idempotencyKey = readOrCreateCryptoIntentKey(tier);
                      if (!idempotencyKey) {
                        showCryptoError(
                          'Secure crypto checkout needs browser site storage to start a new payment.',
                        );
                        return;
                      }
                      cryptoLoading.classList.remove('hidden');
                      cryptoError.classList.add('hidden');
                      continue;
                    }
                    return;
                  }
                  if (authority.status === 'confirming' || authority.status === 'partial') {
                    cryptoOrderCache.delete(tier);
                    hideCryptoPaymentAddress(
                      cryptoStatusMessage(authority.status, cacheEntry.orderId),
                    );
                    return;
                  }

                  cryptoOrderCache.set(tier, cacheEntry);
                  cryptoLoading.classList.add('hidden');
                  cryptoError.classList.add('hidden');
                  setCryptoText('crypto-amount', cacheEntry.payAmount);
                  setCryptoText('crypto-currency', cacheEntry.payCurrency);
                  setCryptoText('crypto-address', cacheEntry.paymentAddress);
                  setCryptoText('crypto-order-id', cacheEntry.orderId);
                  setCryptoCopyTarget(cacheEntry.paymentAddress);
                  cryptoReady.classList.remove('hidden');
                  startCryptoOrderPolling(cacheEntry, authority.expiresAtMs);
                  return;
                }
              },
              controller.signal,
            );
          } catch (err) {
            showCryptoError(
              err && err.name === 'AbortError'
                ? 'Minting the payment address took too long. Check your connection and try again.'
                : window.driftstackRequestErrorMessage(
                    err,
                    'Could not start crypto checkout. Try again.',
                  ),
            );
          } finally {
            window.clearTimeout(timeout);
            cryptoRequestInFlight = false;
            btn.disabled = cryptoCheckoutDisabled();
            btn.setAttribute('aria-busy', 'false');
          }
        });
      });

      if (cryptoCloseBtn) cryptoCloseBtn.addEventListener('click', hideCryptoModal);
      if (cryptoModal) {
        cryptoModal.addEventListener('click', (e) => {
          if (e.target === cryptoModal) hideCryptoModal();
        });
      }
      if (cryptoCopyBtn) {
        cryptoCopyBtn.addEventListener('click', async () => {
          const address = cryptoPayableAddress;
          if (!address || cryptoCopyBtn.disabled || cryptoCopyInFlight) return;
          const generation = ++cryptoCopyGeneration;
          cryptoCopyInFlight = true;
          resetCryptoCopyFeedback();
          cryptoCopyBtn.textContent = 'Copying…';
          cryptoCopyBtn.setAttribute('aria-label', 'Copying payment address');
          cryptoCopyBtn.disabled = true;
          cryptoCopyBtn.setAttribute('aria-busy', 'true');
          try {
            await window.driftstackWriteClipboard(address);
            showCryptoCopyResult('Copied ✓', 'Payment address copied', generation);
          } catch {
            showCryptoCopyResult(
              'Copy failed',
              'Could not copy payment address; select it manually',
              generation,
            );
            if (generation === cryptoCopyGeneration) {
              showBanner('Copy failed. Select the payment address manually.');
            }
          } finally {
            // No newer write can start while the latch is true, so this exact
            // owner always releases it. Presentation generation independently
            // decides whether its feedback is still allowed to render.
            cryptoCopyInFlight = false;
            syncCryptoCopyAvailability();
          }
        });
      }

      // Finding #1 — load the account's live billing state so an
      // already-subscribed customer sees "Switch to this plan" /
      // portal-routed CTAs instead of fresh "Start <tier>" Checkout
      // buttons. Checkout stays fail-closed until this authoritative read
      // succeeds: the Stripe 409 is a backstop, while crypto orders are a
      // separate non-refundable payment path.
      if (!token) {
        showBanner('Sign in to choose a paid plan.');
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
        return;
      }
      if (!cryptoWorkspaceSupported) {
        setBillingAuthority(
          false,
          'Switch the workspace picker to Self before starting a payment.',
        );
        showBanner(
          'Plan purchases are self-workspace only. Switch the workspace picker to Self before starting a payment.',
        );
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
        return;
      }

      const selfAccountPromise = authedFetch('/v1/account/me', { method: 'GET' }).then(
        async (response) => {
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw window.driftstackResponseError(response, body);
          if (!body || typeof body !== 'object' || !SELF_ACCOUNT_ID_RE.test(body.id || '')) {
            throw new Error('The signed-in account identity response was incomplete.');
          }
          return body.id;
        },
      );
      const billingPromise = authedFetch('/v1/billing', { method: 'GET' }).then(
        async (response) => {
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw window.driftstackResponseError(response, body);
          if (
            !body ||
            typeof body !== 'object' ||
            !Object.prototype.hasOwnProperty.call(body, 'subscription')
          ) {
            throw new Error('The billing response was incomplete.');
          }
          return body;
        },
      );

      Promise.all([selfAccountPromise, billingPromise])
        .then(([selfAccountId, body]) => {
          authoritativeSelfAccountId = selfAccountId;
          setBillingAuthority(true);
          applySubscriptionState(body.subscription || null);
        })
        .catch((err) => {
          authoritativeSelfAccountId = null;
          setBillingAuthority(false, 'Reload to try loading live billing again');
          const reason = window.driftstackRequestErrorMessage(
            err,
            "Couldn't load live billing.",
          );
          showBanner(reason + ' Purchases remain unavailable; reload to try again.');
        })
        .finally(() => {
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });
    })();
  </script>
</DashboardLayout>
