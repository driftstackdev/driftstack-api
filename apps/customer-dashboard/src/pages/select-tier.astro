---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import {
  PROFILES_PER_TIER,
  TIER_CONCURRENT_SESSION_LIMITS,
  type AccountTier,
} from '@driftstack/api-types';

// V-184a — onboarding step 4. Tier picker. Tier 1 minimal placeholder
// surface — full Tier 3 visual (feature comparison table, tier
// highlights, AI-agent gating row, etc.) lands in V-184b draft.
//
// "Change plan" reuse: this same page is reachable from /billing
// "Change plan" link (post-onboarding). Every account starts on the
// perpetual free tier; the cards below upgrade to a paid tier.
//
// V-501 — disabled-while-pending guards on checkout buttons; copy
// micro-polish (cancel-anytime line, clearer "what changes" framing).

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

// Tier 1 placeholder list — V-184b will replace with rich comparison
// surface. Pulled from api-types so values stay aligned with backend.
const TIERS: {
  id: AccountTier;
  label: string;
  price: string;
  ladder: string;
  /** Monthly amount in cents — used by the crypto checkout path. All
   *  tiers clear NowPayments' $19.16 USD-equivalent minimum. */
  priceCents: number;
}[] = [
  { id: 'solo_manual', label: 'Solo Manual', price: '$79/mo', ladder: 'Manual', priceCents: 7900 },
  { id: 'team_manual', label: 'Team Manual', price: '$249/mo', ladder: 'Manual', priceCents: 24900 },
  { id: 'agency_manual', label: 'Agency Manual', price: '$699/mo', ladder: 'Manual', priceCents: 69900 },
  { id: 'api_starter', label: 'API Starter', price: '$149/mo', ladder: 'API', priceCents: 14900 },
  { id: 'api_builder', label: 'API Builder', price: '$499/mo', ladder: 'API', priceCents: 49900 },
  { id: 'api_scale', label: 'API Scale', price: '$1,499/mo', ladder: 'API', priceCents: 149900 },
];
---

<DashboardLayout title="Select tier" withSidebar={false}>
  {/* 2026-05-22 — atmospheric glow behind the tier-select hero (same
      family as the marketing pages + dashboard overview). Sits on a
      relative wrapper so it doesn't overflow the page bounds. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-16" data-page="select-tier">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Choose your tier</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink-primary md:text-4xl">
        Pick a plan.
      </h1>
    <p class="mt-3 text-sm text-ink-secondary">
      All tiers run the same engine. Only concurrent caps and profile
      counts change between them — there's no fingerprint or feature
      gating. Cancel or downgrade anytime; if you cancel within the
      first 14 days of a billing cycle we refund the unused remainder
      pro-rated to the day.
    </p>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-glow-red/30 bg-glow-red/10 px-4 py-3 text-sm text-glow-red-soft"
      role="status"
    >
    </div>

    {/* 2026-05-27 — current-plan note. Every account starts on the
        perpetual free tier (1 profile, manual-only, no API). Picking a
        card below upgrades to a paid tier; there is no purchase step to
        stay free. (The one-time entry pack was retired alongside the
        free tier — its checkout endpoint no longer exists.) */}
    <!-- Free-tier note -->
    <div class="mt-8 rounded-lg border border-white/10 bg-surface-raised p-6">
      <h2 class="flex items-center gap-2 text-xl font-semibold text-ink-primary">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        You're on the free plan
      </h2>
      <p class="mt-2 text-sm text-ink-secondary">
        Free includes 1 profile, 1 concurrent session, and manual-only
        sessions — no card required, and it never expires. Upgrade below
        for more concurrency, more profiles, and API access.
      </p>
    </div>

    {/* 2026-05-22 — paid tier grid: each card opens with a ladder
        icon (manual = user, api = code-brackets) for a visual anchor. */}
    <!-- Paid tier grid -->
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        TIERS.map((t) => (
          <div class="relative rounded-lg border border-white/10 bg-surface-raised p-5 hover:border-glow-red/30 transition-colors">
            <div class="flex items-center justify-between">
              <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{t.ladder}</p>
              <div class="flex h-7 w-7 items-center justify-center rounded-md bg-glow-red/10 text-glow-red ring-1 ring-glow-red/30">
                {t.ladder === 'Manual' ? (
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="7" r="4" />
                    <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
              </div>
            </div>
            <h3 class="mt-2 text-lg font-semibold text-ink-primary">{t.label}</h3>
            <p class="mt-1 text-2xl font-semibold text-ink-primary">{t.price}</p>
            <dl class="mt-4 space-y-1 text-sm text-ink-secondary">
              <div class="flex justify-between">
                <dt>Concurrent</dt>
                <dd class="font-mono">{TIER_CONCURRENT_SESSION_LIMITS[t.id].toString()}</dd>
              </div>
              <div class="flex justify-between">
                <dt>Profiles</dt>
                <dd class="font-mono">
                  {String(PROFILES_PER_TIER[t.id])}
                </dd>
              </div>
            </dl>
            <button
              type="button"
              data-action="buy-tier"
              data-tier={t.id}
              class="btn-secondary mt-4 w-full"
            >
              Start {t.label}
            </button>
            <button
              type="button"
              data-action="buy-tier-crypto"
              data-tier={t.id}
              data-tier-label={t.label}
              data-tier-price-cents={t.priceCents.toString()}
              class="mt-2 w-full text-xs text-ink-muted hover:text-glow-red"
            >
              or pay with crypto →
            </button>
          </div>
        ))
      }
    </div>

    {/* 2026-05-21 — V-666.D shared crypto checkout modal. Single modal
        for all 4 tier cards; the click handler reads data-tier +
        data-tier-label + data-tier-price-cents off the source button
        + POSTs /v1/billing/crypto-checkout. The modal is indexed by
        tier — each card supplies its own price_cents. */}
    <div
      data-crypto-modal
      class="fixed inset-0 z-50 hidden items-center justify-center bg-surface-base/80 backdrop-blur-md p-6"
      role="dialog"
      aria-modal="true"
      aria-labelledby="crypto-modal-title"
    >
      <div class="rounded-lg border border-white/10 bg-surface-raised p-6 max-w-md w-full">
        <div class="flex items-start justify-between gap-4">
          <h3 id="crypto-modal-title" class="text-lg font-semibold text-ink-primary">
            Pay <span data-field="crypto-tier-label">—</span> with crypto
          </h3>
          <button
            type="button"
            data-crypto-modal-close
            aria-label="Close"
            class="text-ink-muted hover:text-ink-primary"
          >
            ✕
          </button>
        </div>
        <div data-crypto-modal-loading class="mt-6 text-sm text-ink-muted">
          Minting payment address…
        </div>
        <div
          data-crypto-modal-error
          class="mt-6 hidden rounded-md bg-glow-red/10 px-3 py-2 text-sm text-glow-red"
        ></div>
        <div data-crypto-modal-ready class="mt-6 hidden">
          <p class="text-sm text-ink-secondary">
            Send exactly{' '}
            <span data-field="crypto-amount" class="font-mono text-ink-primary">—</span>{' '}
            <span data-field="crypto-currency" class="font-mono text-ink-primary uppercase">—</span>{' '}
            to:
          </p>
          <div class="mt-3 break-all rounded-md bg-surface-inset px-3 py-2 font-mono text-xs text-ink-primary">
            <span data-field="crypto-address">—</span>
          </div>
          <button
            type="button"
            data-crypto-copy
            class="mt-3 text-sm text-glow-red hover:underline"
          >
            Copy address
          </button>
          <p class="mt-4 text-xs text-ink-muted">
            Order <code data-field="crypto-order-id" class="font-mono">—</code> · once your
            transaction is detected (usually within minutes), your subscription activates
            automatically. You can close this window — your order is tracked even if you
            navigate away.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-xs text-ink-muted">
      Enterprise tier (~$4,000/mo, custom) — <a href="mailto:sales@driftstack.dev" class="text-glow-red underline">contact sales</a>.
    </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="select-tier"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function authedFetch(path, init = {}) {
        return fetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
          },
          credentials: 'include',
        });
      }

      // V-501 — disable a button while its checkout-session call is in
      // flight so the customer can't double-click and create two Stripe
      // sessions. Original label restored on error so they can retry.
      function withBusy(btn, work) {
        if (btn.disabled) return Promise.resolve();
        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Redirecting…';
        return Promise.resolve()
          .then(work)
          .catch((err) => {
            btn.disabled = false;
            btn.textContent = original;
            throw err;
          });
      }

      const tierButtons = root.querySelectorAll('[data-action="buy-tier"]');
      tierButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!token) {
            showBanner('Sign up first.');
            return;
          }
          const tier = btn.getAttribute('data-tier');
          withBusy(btn, () =>
            authedFetch('/v1/billing/checkout-session', {
              method: 'POST',
              body: JSON.stringify({
                tier,
                billing_period: 'monthly',
                success_url: window.location.origin + '/first-session?subscribed=' + tier,
                cancel_url: window.location.origin + '/select-tier',
              }),
            })
              .then((r) => {
                // Wave 1086+ B1 client-side leg: 404/503 on /v1/billing/*
                // means billing isn't wired (DRIFTSTACK_TIER_PRICE_IDS
                // env var missing). Surface a customer-friendly message
                // instead of "HTTP 404", which reads as a broken site.
                if (r.status === 404 || r.status === 503) {
                  return Promise.reject(
                    new Error(
                      'Billing setup is still in progress on this server. Check back shortly — you can keep exploring the dashboard in the meantime.',
                    ),
                  );
                }
                return r.ok
                  ? r.json()
                  : r.json().then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
              })
              .then((body) => {
                if (body.checkout_url) window.location.href = body.checkout_url;
              }),
          ).catch((err) => {
            showBanner(
              "Couldn't start checkout (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          });
        });
      });

      // 2026-05-21 — V-666.D crypto checkout per-tier. Each tier card
      // has a small "or pay with crypto →" link beneath the primary
      // Stripe button; clicking opens the shared modal + POSTs
      // /v1/billing/crypto-checkout with the tier's price_cents. All
      // tiers clear NowPayments' $19.16 USD-equivalent floor.
      const cryptoBtns = root.querySelectorAll('[data-action="buy-tier-crypto"]');
      const cryptoModal = root.querySelector('[data-crypto-modal]');
      const cryptoLoading = root.querySelector('[data-crypto-modal-loading]');
      const cryptoError = root.querySelector('[data-crypto-modal-error]');
      const cryptoReady = root.querySelector('[data-crypto-modal-ready]');
      const cryptoCloseBtn = root.querySelector('[data-crypto-modal-close]');
      const cryptoCopyBtn = root.querySelector('[data-crypto-copy]');

      function setCryptoText(key, value) {
        const el = root.querySelector('[data-field="' + key + '"]');
        if (el && typeof value === 'string') el.textContent = value;
      }
      function showCryptoModal() {
        if (!cryptoModal) return;
        cryptoModal.classList.remove('hidden');
        cryptoModal.classList.add('flex');
      }
      function hideCryptoModal() {
        if (!cryptoModal) return;
        cryptoModal.classList.add('hidden');
        cryptoModal.classList.remove('flex');
      }
      function showCryptoError(msg) {
        if (!cryptoLoading || !cryptoError || !cryptoReady) return;
        cryptoLoading.classList.add('hidden');
        cryptoReady.classList.add('hidden');
        cryptoError.textContent = msg;
        cryptoError.classList.remove('hidden');
      }

      cryptoBtns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!token) {
            showBanner('Sign in to pay with crypto.');
            return;
          }
          const tier = btn.getAttribute('data-tier');
          const tierLabel = btn.getAttribute('data-tier-label') ?? tier;
          const priceCents = Number(btn.getAttribute('data-tier-price-cents'));
          if (!tier || !Number.isFinite(priceCents)) return;
          if (!cryptoLoading || !cryptoError || !cryptoReady) return;
          setCryptoText('crypto-tier-label', tierLabel);
          cryptoLoading.classList.remove('hidden');
          cryptoError.classList.add('hidden');
          cryptoReady.classList.add('hidden');
          showCryptoModal();
          try {
            const idempotencyKey =
              typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
                ? 'crypto-tier-' + crypto.randomUUID()
                : 'crypto-tier-' + Date.now().toString();
            const res = await authedFetch('/v1/billing/crypto-checkout', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                'idempotency-key': idempotencyKey,
              },
              body: JSON.stringify({
                product: tier,
                price_cents: priceCents,
                price_currency: 'USD',
              }),
            });
            const body = await res.json().catch(() => ({}));
            if (!res.ok) {
              showCryptoError(body.detail || 'HTTP ' + res.status);
              return;
            }
            if (body.provider === 'stub' || !body.payment_address) {
              showCryptoError(
                "Crypto checkout isn't fully live yet — please email " +
                  'billing@driftstack.dev with your order_id ' +
                  (body.order_id || 'unknown') +
                  ' for manual wire instructions.',
              );
              return;
            }
            cryptoLoading.classList.add('hidden');
            setCryptoText('crypto-amount', String(body.pay_amount));
            setCryptoText('crypto-currency', body.pay_currency);
            setCryptoText('crypto-address', body.payment_address);
            setCryptoText('crypto-order-id', body.order_id);
            cryptoReady.classList.remove('hidden');
          } catch (err) {
            showCryptoError(err && err.message ? err.message : 'network error');
          }
        });
      });

      if (cryptoCloseBtn) cryptoCloseBtn.addEventListener('click', hideCryptoModal);
      if (cryptoModal) {
        cryptoModal.addEventListener('click', (e) => {
          if (e.target === cryptoModal) hideCryptoModal();
        });
      }
      if (cryptoCopyBtn) {
        cryptoCopyBtn.addEventListener('click', async () => {
          const addr = root.querySelector('[data-field="crypto-address"]');
          if (!addr || !addr.textContent || !navigator.clipboard) return;
          try {
            await navigator.clipboard.writeText(addr.textContent);
            cryptoCopyBtn.textContent = 'Copied ✓';
            setTimeout(() => {
              cryptoCopyBtn.textContent = 'Copy address';
            }, 2000);
          } catch (_) {
            /* swallow */
          }
        });
      }
    })();
  </script>
</DashboardLayout>
