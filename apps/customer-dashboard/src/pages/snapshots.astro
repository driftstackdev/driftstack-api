---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-375 — Profile snapshots management page. Cross-account list of
// every snapshot the calling account owns, with Restore + Delete
// actions. Capture happens on /profiles (per-row Snapshot button).
//
// Progressive enhancement: page renders an empty/zero state on
// first paint; the inline script reads ds_web_session_token,
// fetches /v1/profile-snapshots, and hydrates the list. Falls back
// to the empty state when token absent or fetch fails.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Snapshots">
  {/* 2026-05-24 — hero-glow atmosphere matches brand surface. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 py-10" data-page="snapshots">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
      role="status"
    >
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">Profile snapshots</span></h1>
      <p class="mt-2 max-w-prose text-sm text-ink-muted">
        Immutable point-in-time copies of saved profiles. Capture from <a
          href="/profiles"
          class="text-glow-red underline">/profiles</a
        >; restore here to clone a snapshot back into a new profile, or delete a snapshot
        when you no longer need it. Restoring counts against your profile tier cap and
        rejects on name conflict — the same way creating a profile does.
      </p>
    </header>

    <!--
      V-470 — Restore form, hidden by default. Reveals when a snapshot
      row's "Restore" button is clicked. Replaces the earlier
      window.prompt flow.
    -->
    <div
      data-restore-form-wrap
      class="mb-8 hidden rounded-lg border border-white/10 bg-surface-raised p-6"
    >
      <h2 class="text-lg font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">Restore from snapshot</span></h2>
      <p class="mt-2 text-sm text-ink-muted">
        Restoring creates a new profile populated with the snapshot's frozen
        state. Counts against your tier's profile cap and rejects on name
        conflict.
      </p>
      <dl
        data-restore-source
        class="mt-4 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-xs text-ink-muted"
      >
        <dt>Source profile</dt>
        <dd data-restore-source-name class="font-mono text-ink-primary">—</dd>
        <dt>Snapshot label</dt>
        <dd data-restore-source-label class="font-mono text-ink-primary">—</dd>
      </dl>
      <form data-restore-form class="mt-4 space-y-4">
        <div>
          <label for="restore-name" class="block text-sm font-medium text-ink-secondary">
            New profile name
          </label>
          <input
            id="restore-name"
            data-restore-name-input
            type="text"
            required
            class="mt-1 w-full rounded-md border border-white/10 px-3 py-2 text-sm"
          />
          <p class="mt-1 text-xs text-ink-muted">
            Default suggestion is the source profile name + " (restored)". Edit
            to whatever surfaces the purpose for your team.
          </p>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="btn-primary" data-restore-submit>Restore</button>
          <button
            type="button"
            class="rounded-md border border-white/10 bg-surface-raised px-4 py-2 text-sm font-medium text-ink-secondary hover:bg-surface-base"
            data-restore-cancel
          >
            Cancel
          </button>
          <span data-restore-error class="hidden text-sm text-rose-700"></span>
        </div>
      </form>
    </div>

    <ul
      data-list
      class="mb-10 hidden divide-y divide-slate-200 rounded-lg border border-white/10 bg-surface-raised"
    >
    </ul>

    {/* 2026-05-23 — empty state with icon + structured headline. */}
    <div
      data-empty
      class="mb-10 rounded-lg border border-dashed border-white/10 bg-surface-raised px-6 py-16 text-center text-sm text-ink-muted"
    >
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
          <circle cx="12" cy="13" r="4" />
        </svg>
      </div>
      <p class="text-ink-primary font-medium">No snapshots yet</p>
      <p class="mt-1">Capture one from <a href="/profiles" class="text-glow-red underline">/profiles</a>.</p>
    </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="snapshots"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 16).replace('T', ' ');
      }

      function authedFetch(path, init) {
        return fetch(apiBaseUrl + path, {
          ...(init || {}),
          headers: {
            ...((init && init.headers) || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        });
      }

      function snapshotLi(s) {
        return (
          '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-ink-primary">' +
          escapeHtml(s.label || '(no label)') +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-ink-muted">' +
          escapeHtml(s.id) +
          '</p>' +
          (s.description
            ? '<p class="mt-2 text-sm text-ink-secondary">' + escapeHtml(s.description) + '</p>'
            : '') +
          '<p class="mt-2 text-xs text-ink-muted">From ' +
          escapeHtml(s.parent_name) +
          (s.parent_profile_id === null ? ' <em>(parent profile deleted)</em>' : '') +
          ' · captured ' +
          escapeHtml(fmtIso(s.captured_at)) +
          '</p></div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<button type="button" data-restore="' +
          escapeHtml(s.id) +
          '" data-restore-from="' +
          escapeHtml(s.parent_name) +
          '" data-restore-label="' +
          escapeHtml(s.label || '') +
          '" class="text-sm text-glow-red hover:underline">Restore</button>' +
          '<button type="button" data-delete="' +
          escapeHtml(s.id) +
          '" data-delete-label="' +
          escapeHtml(s.label || '(no label)') +
          '" class="text-sm text-rose-700 hover:underline">Delete</button>' +
          '</div></li>'
        );
      }

      function refresh() {
        if (!token) return;
        return authedFetch('/v1/profile-snapshots')
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => render(body.data || []))
          .then(() => hideBanner())
          .catch((err) => {
            showBanner(
              "Couldn't load snapshots (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          })
          .finally(function () {
            // 2026-05-21 — opacity-gate hydrate signal.
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function render(snapshots) {
        if (snapshots.length === 0) {
          list.classList.add('hidden');
          empty.classList.remove('hidden');
          return;
        }
        empty.classList.add('hidden');
        list.classList.remove('hidden');
        list.innerHTML = snapshots.map(snapshotLi).join('');
        wireRestoreButtons();
        wireDeleteButtons();
      }

      // V-470 — restore flow uses an inline form instead of
      // window.prompt. Form state is shared; a single pending id
      // tracks which snapshot is being restored.
      const restoreFormWrap = root.querySelector('[data-restore-form-wrap]');
      const restoreForm = root.querySelector('[data-restore-form]');
      const restoreNameInput = root.querySelector('[data-restore-name-input]');
      const restoreSourceName = root.querySelector('[data-restore-source-name]');
      const restoreSourceLabel = root.querySelector('[data-restore-source-label]');
      const restoreError = root.querySelector('[data-restore-error]');
      const restoreSubmit = root.querySelector('[data-restore-submit]');
      const restoreCancel = root.querySelector('[data-restore-cancel]');
      let restorePending = null; // { id, from, label } | null

      function showRestoreForm(id, from, label) {
        restorePending = { id: id, from: from, label: label };
        if (restoreSourceName) restoreSourceName.textContent = from || '(deleted)';
        if (restoreSourceLabel) restoreSourceLabel.textContent = label || '—';
        if (restoreNameInput) {
          restoreNameInput.value = (from || 'profile') + ' (restored)';
          restoreNameInput.focus();
          restoreNameInput.select();
        }
        if (restoreError) {
          restoreError.classList.add('hidden');
          restoreError.textContent = '';
        }
        if (restoreFormWrap) {
          restoreFormWrap.classList.remove('hidden');
          restoreFormWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      function hideRestoreForm() {
        restorePending = null;
        if (restoreFormWrap) restoreFormWrap.classList.add('hidden');
      }
      if (restoreCancel) restoreCancel.addEventListener('click', hideRestoreForm);
      if (restoreForm) {
        restoreForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!restorePending || !restoreNameInput) return;
          const name = restoreNameInput.value.trim();
          if (!name) {
            if (restoreError) {
              restoreError.textContent = 'Name is required.';
              restoreError.classList.remove('hidden');
            }
            return;
          }
          if (restoreError) {
            restoreError.classList.add('hidden');
            restoreError.textContent = '';
          }
          if (restoreSubmit) {
            restoreSubmit.disabled = true;
            restoreSubmit.textContent = 'Restoring…';
          }
          const pendingId = restorePending.id;
          authedFetch('/v1/profile-snapshots/' + encodeURIComponent(pendingId) + '/restore', {
            method: 'POST',
            body: JSON.stringify({ name: name }),
          })
            .then(async (r) => {
              if (r.ok) {
                const body = await r.json();
                hideRestoreForm();
                showBanner('Restored to new profile: ' + (body.name || name));
                return refresh();
              }
              let msg;
              try {
                const body = await r.json();
                msg = body.detail || body.title || 'HTTP ' + r.status;
              } catch (_e) {
                msg = 'HTTP ' + r.status;
              }
              if (restoreError) {
                restoreError.textContent = msg;
                restoreError.classList.remove('hidden');
              }
            })
            .catch((err) => {
              if (restoreError) {
                restoreError.textContent =
                  err && err.message ? err.message : 'Restore failed.';
                restoreError.classList.remove('hidden');
              }
            })
            .finally(() => {
              if (restoreSubmit) {
                restoreSubmit.disabled = false;
                restoreSubmit.textContent = 'Restore';
              }
            });
        });
      }

      function wireRestoreButtons() {
        list.querySelectorAll('[data-restore]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-restore');
            const from = btn.getAttribute('data-restore-from') || '';
            const label = btn.getAttribute('data-restore-label') || '';
            if (!id) return;
            showRestoreForm(id, from, label);
          });
        });
      }

      function wireDeleteButtons() {
        list.querySelectorAll('[data-delete]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete');
            const label = btn.getAttribute('data-delete-label') || '(unnamed)';
            if (!window.confirm('Delete snapshot "' + label + '"? This cannot be undone.')) {
              return;
            }
            authedFetch('/v1/profile-snapshots/' + encodeURIComponent(id), {
              method: 'DELETE',
            })
              .then((r) => {
                if (r.status === 204) {
                  showBanner('Snapshot deleted.');
                  return refresh();
                }
                showBanner('Delete failed: HTTP ' + r.status);
              })
              .catch((err) => {
                showBanner(
                  'Delete failed: ' + (err && err.message ? err.message : 'network error'),
                );
              });
          });
        });
      }

      refresh();
    })();
  </script>
</DashboardLayout>
