---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// W472 — team-invite acceptance landing page.
//
// The invite email links here (`${DASHBOARD_ORIGIN}/team/accept?token=...`,
// built in apps/server/src/services/team-members.ts). Before this page existed
// that link 404'd — invitees could not complete acceptance (a live break of the
// team-invite flow; the backend route + email + docs all referenced this page,
// but the page itself was never created).
//
// Flow: read ?token= → POST /v1/team/invites/accept { token } → the server
// validates the 256-bit single-use, email-bound, 7-day token and joins the
// invitee to the team. The route is requireAuth, so a 401 means the invitee
// isn't signed in yet — we surface a sign-in/sign-up prompt (matching the invite
// email's "you'll be prompted to sign up first" note). Modeled on
// auth/oauth-client/confirm-merge.astro (same token → POST → navigate pattern).

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Accept team invite" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="team-accept"
  >
    <p class="section-label">Team invite</p>
    <h1
      class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink"
      style="letter-spacing: -0.02em;"
    >
      Joining the team…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Accepting your invite. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>
      <div
        data-accept-unknown
        class="mb-5 hidden rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
      >
        <a href="/team/" class="btn-primary flex w-full items-center justify-center"
          >Open Team to check access</a
        >
      </div>
      <p class="mt-6 hidden text-xs text-tk-ink-3" data-field="signin-hint">
        Not signed in? <a
          href="/login/"
          data-link="signin"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Sign in</a
        > or <a
          href="/signup/"
          data-link="signup"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >create your account</a
        > with the email the invite was sent to. We'll bring you straight back here to finish.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="team-accept"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const intro = root.querySelector('[data-field="intro"]');
      const signinHint = root.querySelector('[data-field="signin-hint"]');
      const unknownRecovery = root.querySelector('[data-accept-unknown]');
      const ACCEPT_TIMEOUT_MS = 15_000;

      // Carry the current invite URL (/team/accept?token=…) through
      // sign-in / sign-up as ?next= so the invitee returns here and
      // acceptance auto-completes — rather than landing on the
      // dashboard home with the token gone. Both /login and /signup
      // honour a safeNext-guarded ?next= round-trip (login.astro /
      // signup.astro), and thread it through verify-email, so a
      // not-signed-in invitee resumes the flow seamlessly. The accept
      // route is requireAuth and the token is single-use, email-bound,
      // and 7-day-expiring, so the round-trip is safe.
      try {
        const here = window.location.pathname + window.location.search;
        const next = encodeURIComponent(here);
        const signinLink = root.querySelector('[data-link="signin"]');
        const signupLink = root.querySelector('[data-link="signup"]');
        if (signinLink) signinLink.setAttribute('href', '/login?next=' + next);
        if (signupLink) signupLink.setAttribute('href', '/signup?next=' + next);
      } catch (_) {
        /* leave the bare /login + /signup fallbacks in place */
      }

      function showBanner(text, showSignin) {
        if (intro) intro.textContent = '';
        banner.textContent = text;
        banner.classList.remove('hidden');
        if (showSignin && signinHint) signinHint.classList.remove('hidden');
      }

      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');
      if (!token || token.length === 0) {
        showBanner("Missing 'token' query parameter. Click the link in your team-invite email.", false);
        return;
      }

      // The accept route is requireAuth (reads the Bearer header, no
      // cookie auth) — without a web-session token the POST always
      // 401s. Read ds_web_session_token from localStorage like the
      // other authed dashboard pages (billing.astro etc). If absent,
      // show the sign-in hint and don't fire a request that's
      // guaranteed to fail.
      let sessionToken = null;
      try {
        sessionToken = localStorage.getItem('ds_web_session_token');
      } catch (_) {
        /* private mode / disabled storage */
      }
      if (!sessionToken) {
        showBanner('You need to be signed in to accept this invite.', true);
        return;
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), ACCEPT_TIMEOUT_MS);
      fetch(apiBaseUrl + '/v1/team/invites/accept', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          authorization: 'Bearer ' + sessionToken,
        },
        credentials: 'include',
        body: JSON.stringify({ token: token }),
        signal: controller.signal,
      })
        .then((r) => {
          if (r.ok) return r.json();
          if (r.status === 401) {
            return Promise.reject(
              Object.assign(new Error('You need to be signed in to accept this invite.'), {
                needsSignin: true,
              }),
            );
          }
          return r
            .json()
            .catch(() => ({}))
            .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
        })
        .then(() => {
          window.location.href = '/team/';
        })
        .catch((err) => {
          if (err && err.name === 'AbortError') {
            if (unknownRecovery) unknownRecovery.classList.remove('hidden');
            showBanner(
              'Invite-acceptance outcome is unknown after the request timed out. The server may already have joined you to the team and consumed this single-use invite. Do not reload or submit this link again. Open Team to check access; if access is absent, ask the team owner for a new invite.',
              false,
            );
            return;
          }
          const needsSignin = !!(err && err.needsSignin);
          showBanner(
            needsSignin
              ? 'You need to be signed in to accept this invite.'
              : window.driftstackRequestErrorMessage(
                  err,
                  'Could not accept the invite. Ask the team owner for a new link if it has expired.',
                ),
            needsSignin,
          );
        })
        .finally(() => window.clearTimeout(timeout));
    })();
  </script>
</DashboardLayout>
