---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-181 — progressive-enhancement wiring against /v1/webhooks,
// mirrors V-180 /sessions pattern. SSR renders loading skeletons for
// instant paint; the inline <script> below replaces them with live
// data when ds_web_session_token is in localStorage.
//
// S32 2026-07-07 (fable-frontend-audit) — removed the MOCK_WEBHOOKS /
// MockWebhookEndpoint / frontmatter fmtIsoDay block: it was never
// rendered (the template ships skeletons, not the mock), yet the
// list-fetch error path told the customer "showing preview data
// below" — pointing at data that did not exist. V-185 also added the
// real delivery_counts to /v1/webhooks, so the "counts coming soon"
// framing is obsolete; the cards render live counts.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Webhooks">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="webhooks">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    ></div>

    <header class="mb-10 flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="text-sm text-tk-ink-3">
          HMAC-SHA256-signed event delivery · 5-minute timestamp tolerance
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">
          Webhook endpoints
        </h1>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Subscribe to session lifecycle + quota events. Each endpoint gets
          its own signing secret; verify with the SDK's
          <code class="font-mono">verifyWebhookSignature</code> helper.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        {/* Fleet v2 (slice 3.6) — contextual docs deep-link. */}
        <a
          href="https://docs.driftstack.dev/webhooks/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          Docs
        </a>
        <button type="button" data-show-create class="btn-primary">New endpoint</button>
      </div>
    </header>

    <!--
 — Create-endpoint form. Hidden by default; reveals when
      "New endpoint" is clicked. Posts to POST /v1/webhooks. On
 success the secret is shown ONCE — same pattern as the
      api-key reveal pane.
    -->
    <div data-create-wrap class="mb-8 hidden rounded-lg border border-tk-border bg-tk-surface p-6">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </span>
        New webhook endpoint
      </h2>
      <form data-create-form class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="webhook-url">
            URL
          </label>
          <input
            id="webhook-url"
            name="url"
            type="url"
            required
            placeholder="https://hooks.example.com/driftstack"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
          <p class="mt-1 text-xs text-tk-ink-3">
            HTTPS required. The endpoint must respond 2xx within 10s for delivery to count
            as successful.
          </p>
        </div>
        <div>
          <span class="block text-sm font-medium text-tk-ink-2">Events to subscribe to</span>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm text-tk-ink-2">
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.completed" checked
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.completed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.failed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.failed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="api_key.revoked"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">api_key.revoked</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="quota.warning_80pct"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">quota.warning_80pct</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="quota.exceeded"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">quota.exceeded</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.egress_capability_changed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.egress_capability_changed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="crypto.order.paid"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">crypto.order.paid</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="crypto.order.failed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">crypto.order.failed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.challenge_detected"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.challenge_detected</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.profile_save_failed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.profile_save_failed</span>
            </label>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="webhook-description">
            Description (optional)
          </label>
          <input
            id="webhook-description"
            name="description"
            type="text"
            placeholder="production hook for the EU region"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
        </div>
        <p
          data-create-error
          class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-3 py-2 text-sm text-tk-err-text"
        ></p>
        <div class="flex justify-end gap-3 border-t border-tk-border pt-4">
          <button
            type="button"
            data-create-cancel
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-create-submit
            class="btn-primary"
          >
            Create endpoint
          </button>
        </div>
      </form>
    </div>

    <!--
      Post-create reveal pane — the secret is shown ONCE. Same posture
 as the api-key reveal.
    -->
    <div
      data-create-reveal
      class="mb-8 hidden rounded-lg border border-tk-ready/30 bg-tk-ready/10 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ready-text">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-ready/15 ring-1 ring-tk-ready/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12l2 2 4-4" />
            <circle cx="12" cy="12" r="9" />
          </svg>
        </span>
        Endpoint created
      </h2>
      <p class="mt-1 text-sm text-tk-ready-text">
        Copy this signing secret now — it won't be shown again. Use it with the SDK's
        <code class="font-mono">verifyWebhookSignature</code> helper to authenticate
        incoming deliveries.
      </p>
      <pre
        data-reveal-secret
        class="mt-3 overflow-x-auto rounded border border-tk-ready/30 bg-tk-surface px-3 py-2 font-mono text-xs text-tk-ink"
      ></pre>
      <button
        type="button"
        data-reveal-dismiss
        class="btn-secondary mt-4"
      >
        I've copied it
      </button>
    </div>

    <!--
      V-475 — rotate-secret in-page reveal. Replaces the window.prompt
      shown in earlier slices; some browsers block prompts in
      non-interactive contexts (incognito, autofill blockers, etc.).
      Inline reveal is keyboard-accessible + paste-target-friendly.
    -->
    <div
      data-rotate-reveal
      class="mb-8 hidden rounded-lg border border-tk-accent/40 bg-tk-accent/10 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-accent-text">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/15 ring-1 ring-tk-accent/40">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 4 1 10 7 10" />
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
          </svg>
        </span>
        Signing secret rotated
      </h2>
      <p class="mt-1 text-sm text-tk-accent-text">
        Copy the new secret now — it won't be shown again. The old secret stays
        valid for the grace window below; roll your verifier forward before
        then or the next delivery will fail signature check.
      </p>
      <p class="mt-3 text-xs font-mono uppercase tracking-widest text-tk-busy-text">
        Endpoint
      </p>
      <p data-rotate-endpoint-id class="mt-1 font-mono text-xs text-tk-ink"></p>
      <p class="mt-3 text-xs font-mono uppercase tracking-widest text-tk-busy-text">
        New secret
      </p>
      <pre
        data-rotate-secret
        class="mt-1 overflow-x-auto rounded border border-tk-accent/30 bg-tk-surface px-3 py-2 font-mono text-xs text-tk-ink"
      ></pre>
      <p class="mt-3 text-xs font-mono uppercase tracking-widest text-tk-busy-text">
        Old secret valid until
      </p>
      <p data-rotate-grace-expires class="mt-1 text-sm text-tk-ink"></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" data-rotate-copy class="btn-primary text-sm">
          Copy secret
        </button>
        <button type="button" data-rotate-dismiss class="btn-secondary text-sm">
          I've saved it
        </button>
      </div>
    </div>

    <!--
 — Edit-endpoint form. Hidden by default; reveals when a
 row's "Edit" button is clicked. Mirrors the create form
      shape; PATCHes the live endpoint instead of POSTing a new one.
    -->
    <div
      data-edit-wrap
      class="mb-8 hidden rounded-lg border border-blue-200 bg-tk-accent/10/30 p-6"
    >
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
          </svg>
        </span>
        Edit endpoint <span data-edit-id class="font-mono text-xs text-tk-ink-3"></span>
      </h2>
      <form data-edit-form class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="edit-webhook-url">
            URL
          </label>
          <input
            id="edit-webhook-url"
            name="url"
            type="url"
            required
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
        </div>
        <div>
          <span class="block text-sm font-medium text-tk-ink-2">Events to subscribe to</span>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm text-tk-ink-2">
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.completed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.completed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.failed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.failed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="api_key.revoked"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">api_key.revoked</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="quota.warning_80pct"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">quota.warning_80pct</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="quota.exceeded"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">quota.exceeded</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.egress_capability_changed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.egress_capability_changed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="crypto.order.paid"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">crypto.order.paid</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="crypto.order.failed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">crypto.order.failed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.challenge_detected"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.challenge_detected</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.profile_save_failed"
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
              />
              <span class="font-mono text-xs">session.profile_save_failed</span>
            </label>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="edit-webhook-description">
            Description
          </label>
          <input
            id="edit-webhook-description"
            name="description"
            type="text"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
        </div>
        <div>
          <label class="inline-flex items-center gap-2 text-sm text-tk-ink-2">
            <input
              type="checkbox"
              name="active"
              data-edit-active
              class="rounded border-tk-border text-tk-accent focus:ring-tk-accent/30"
            />
            Active (uncheck to pause delivery without deleting)
          </label>
        </div>
        <p
          data-edit-error
          class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-3 py-2 text-sm text-tk-err-text"
        ></p>
        <div class="flex justify-end gap-3 border-t border-blue-100 pt-4">
          <button
            type="button"
            data-edit-cancel
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-edit-submit
            class="btn-primary"
          >
            Save changes
          </button>
        </div>
      </form>
    </div>

    {/*
      2026-05-21 — empty state hidden by default; list SSR-renders 2
      skeleton <li> placeholders. JS hydrates real /v1/webhooks data
      and reveals the empty state if the list is empty. Same skeleton-
      flash treatment as profiles 3b5ccb77 / sessions c5a50f56 /
      api-keys 12566e61.
    */}
    {/* 2026-05-22 — empty state gets an icon + warmer copy. Same
        pattern as the workbench empty hint; visual anchor before
        the CTA so the card doesn't feel like a dead end. */}
    <div data-empty class="dashboard-card hidden text-center">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold tracking-tight text-tk-ink">No webhook endpoints yet</h2>
      <p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">
        Subscribe to events when sessions complete, fail, crypto orders settle,
        or quota thresholds trip. POST + URL + event list = endpoint.
      </p>
      {/* S32 2026-07-07 (fable-frontend-audit) — was <a href="#new">, a
          dead anchor (no #new target, no handler): the primary CTA for
          every zero-endpoint customer did nothing. Now the same
          data-show-create trigger the header button uses. */}
      <button type="button" data-show-create class="btn-primary mt-6 inline-flex"
        >Create endpoint</button
      >
    </div>
    <ul data-list class="space-y-4">
      {[0, 1].map(() => (
        <li data-skeleton="true" class="dashboard-card" aria-hidden="true">
          <div class="flex items-start justify-between gap-6">
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-4 w-72 animate-pulse rounded bg-tk-hover" />
              <div class="h-3 w-64 animate-pulse rounded bg-tk-hover" />
              <div class="h-3 w-56 animate-pulse rounded bg-tk-hover" />
            </div>
            <div class="h-6 w-16 shrink-0 animate-pulse rounded bg-tk-hover" />
          </div>
          <div class="mt-4 grid grid-cols-3 gap-2 border-t border-tk-border pt-4">
            <div class="h-6 animate-pulse rounded bg-tk-hover" />
            <div class="h-6 animate-pulse rounded bg-tk-hover" />
            <div class="h-6 animate-pulse rounded bg-tk-hover" />
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-xs text-tk-ink-3">
      Failed deliveries retry 5× with exponential backoff before landing in
      the DLQ. DLQ entries are admin-replayable; no auto-retry past the
      initial attempts to avoid storm-on-recovery patterns.
    </p>
  </div>

  <!--
 — progressive-enhancement script. Reads
    ds_web_session_token from localStorage, fetches /v1/webhooks,
    replaces the endpoint list with live data. Falls back to
    mock-rendered list when token absent or fetch fails. Mirrors
 /sessions pattern.
  -->
  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="webhooks"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const ul = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const token = localStorage.getItem('ds_web_session_token');

      // V-347 — wire the create form.
      // S32 2026-07-07 — querySelectorAll: both the header button and the
      // empty-state CTA carry data-show-create (querySelector wired only
      // the first).
      const showCreateBtns = root.querySelectorAll('[data-show-create]');
      const createWrap = root.querySelector('[data-create-wrap]');
      const createForm = root.querySelector('[data-create-form]');
      const createCancel = root.querySelector('[data-create-cancel]');
      const createSubmit = root.querySelector('[data-create-submit]');
      const createError = root.querySelector('[data-create-error]');
      const createReveal = root.querySelector('[data-create-reveal]');
      const revealSecret = root.querySelector('[data-reveal-secret]');
      const revealDismiss = root.querySelector('[data-reveal-dismiss]');

      function showCreate() {
        if (!token) {
          showBanner('Sign in to create webhook endpoints.');
          return;
        }
        if (createWrap) createWrap.classList.remove('hidden');
        if (createReveal) createReveal.classList.add('hidden');
        // Wipe the previously-revealed signing secret from the DOM (hiding the
        // pane left the full plaintext secret recoverable via devtools until
        // navigation — defeats the show-once guarantee).
        if (revealSecret) revealSecret.textContent = '';
      }
      function hideCreate() {
        if (createWrap) createWrap.classList.add('hidden');
        if (createForm) createForm.reset();
        if (createReveal) createReveal.classList.add('hidden');
        if (revealSecret) revealSecret.textContent = '';
        if (createError) {
          createError.classList.add('hidden');
          createError.textContent = '';
        }
      }
      function showCreateError(msg) {
        if (!createError) return;
        createError.textContent = msg;
        createError.classList.remove('hidden');
      }

      showCreateBtns.forEach((b) => b.addEventListener('click', showCreate));
      if (createCancel) createCancel.addEventListener('click', hideCreate);
      if (revealDismiss) {
        revealDismiss.addEventListener('click', () => {
          if (createReveal) createReveal.classList.add('hidden');
          // Refresh the endpoint list now that the user has saved the secret.
          window.location.reload();
        });
      }
      if (createForm) {
        createForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (createError) {
            createError.classList.add('hidden');
            createError.textContent = '';
          }
          const fd = new FormData(createForm);
          const url = (fd.get('url') || '').toString().trim();
          const description = (fd.get('description') || '').toString().trim();
          const events = fd.getAll('event').map((v) => v.toString());
          if (!url) {
            showCreateError('URL is required.');
            return;
          }
          if (events.length === 0) {
            showCreateError('Pick at least one event.');
            return;
          }
          if (createSubmit) {
            createSubmit.disabled = true;
            createSubmit.textContent = 'Creating…';
          }
          fetch(apiBaseUrl + '/v1/webhooks', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
            body: JSON.stringify({
              url: url,
              events: events,
              description: description.length > 0 ? description : null,
            }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              hideCreate();
              // S32 2026-07-07 (fable-frontend-audit) — re-enable the submit
              // button on SUCCESS too (only the .catch did before), or the
              // form is stuck on 'Creating…' after the first create and a
              // second endpoint can never be submitted without a reload.
              if (createSubmit) {
                createSubmit.disabled = false;
                createSubmit.textContent = 'Create endpoint';
              }
              if (createReveal && revealSecret) {
                revealSecret.textContent = body.secret || '(no secret returned)';
                createReveal.classList.remove('hidden');
              }
              // The endpoint list refreshes when the user dismisses the reveal
              // ("I've copied it") — NOT on a timer. The server returns the signing
              // secret exactly once; a timed reload would wipe it before a slow
              // copy (password manager / interruption) → permanent loss.
            })
            .catch((err) => {
              showCreateError(err && err.message ? err.message : 'Failed to create endpoint.');
              if (createSubmit) {
                createSubmit.disabled = false;
                createSubmit.textContent = 'Create endpoint';
              }
            });
        });
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function fmtIsoDay(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }

      function endpointCard(e) {
        const events = (e.events || [])
          .map(
            (ev) =>
              '<span class="rounded bg-tk-surface px-2 py-0.5 font-mono text-xs text-tk-ink-2">' +
              escapeHtml(ev) +
              '</span>',
          )
          .join('');
        const description = e.description
          ? '<p class="mt-2 text-sm text-tk-ink-2">' + escapeHtml(e.description) + '</p>'
          : '';
        const activeBadge =
          'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (e.active ? 'bg-tk-ready/10 text-tk-ready-text' : 'bg-tk-surface text-tk-ink-2');
        // V-185 — aggregate delivery counts now in /v1/webhooks
        // response. Falls back to zeros if missing.
        const counts = e.delivery_counts || { delivered: 0, failed: 0, dlq: 0 };
        const dlqClass = counts.dlq > 0 ? 'text-tk-err-text' : 'text-tk-ink-3';
        // S32 2026-07-07 (fable-frontend-audit) — was a dead #requeue-<id>
        // anchor (no handler, no such endpoint): there is no bulk-requeue
        // API — replay is per-delivery. This now opens the delivery log
        // filtered to the failed deliveries, where each row has a working
        // Replay button (data-open-deliveries is wired by
        // wireDeliveryToggles to expand + load the log).
        const requeueLink =
          counts.dlq > 0
            ? '<button type="button" data-open-deliveries="' +
              escapeHtml(e.id) +
              '" data-open-deliveries-status="dlq" class="text-sm font-medium text-tk-err-text hover:underline">Review DLQ (' +
              counts.dlq +
              ')</button>'
            : '';
        return (
          '<li class="dashboard-card">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<div class="flex items-center gap-3">' +
          '<p class="truncate font-mono text-sm text-tk-ink">' +
          escapeHtml(e.url) +
          '</p>' +
          '<span class="' +
          activeBadge +
          '">' +
          (e.active ? 'active' : 'paused') +
          '</span>' +
          // V-359 — rotation-in-flight indicator. When the endpoint is
          // dual-signing, surface the grace expiry inline so customers
          // know how long they have to roll the new secret across
          // their verifier infra.
          (e.rotation_grace_expires_at
            ? '<span class="rounded-full bg-tk-accent/10 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-busy-text" title="Old secret stays valid until this time. Roll your verifier forward before then.">rotating · ends ' +
              escapeHtml(fmtIsoDay(e.rotation_grace_expires_at)) +
              '</span>'
            : '') +
          '</div>' +
          description +
          '<p class="mt-2 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(e.id) +
          ' · created ' +
          escapeHtml(fmtIsoDay(e.created_at)) +
          ' · ' +
          (e.consecutive_failures || 0) +
          ' consecutive failure(s)' +
          // /v1/webhooks returns last_success_at + last_failure_at —
          // surfacing the most-recent success answers "is my webhook
          // working?" without the customer drilling into deliveries.
          // Null means no success ever recorded (new endpoint, or
          // an endpoint that's always failed); omit the segment in
          // that case rather than rendering "—" which reads ambiguous.
          (e.last_success_at
            ? ' · last success ' + escapeHtml(fmtIsoDay(e.last_success_at))
            : '') +
          '</p>' +
          '</div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<button type="button" data-edit="' +
          escapeHtml(e.id) +
          '" class="text-sm text-tk-accent-text hover:underline">Edit</button>' +
          '<button type="button" data-test="' +
          escapeHtml(e.id) +
          '" class="text-sm text-tk-accent-text hover:underline">Send test</button>' +
          '<button type="button" data-rotate="' +
          escapeHtml(e.id) +
          '" class="text-sm text-tk-accent-text hover:underline">Rotate secret</button>' +
          '<button type="button" data-delete="' +
          escapeHtml(e.id) +
          '" class="text-sm text-tk-err-text hover:underline">Delete</button>' +
          '</div></div>' +
          '<div class="mt-4 flex flex-wrap gap-1.5">' +
          events +
          '</div>' +
          '<dl class="mt-4 grid grid-cols-3 gap-2 border-t border-tk-border pt-4 text-center">' +
          '<div><dt class="text-xs text-tk-ink-3">Delivered</dt>' +
          '<dd class="mt-1 font-mono text-lg font-medium text-tk-ready-text">' +
          counts.delivered.toLocaleString('en-US') +
          '</dd></div>' +
          '<div><dt class="text-xs text-tk-ink-3">Failed</dt>' +
          '<dd class="mt-1 font-mono text-lg font-medium text-tk-accent-text">' +
          counts.failed.toLocaleString('en-US') +
          '</dd></div>' +
          '<div><dt class="text-xs text-tk-ink-3">DLQ</dt>' +
          '<dd class="mt-1 font-mono text-lg font-medium ' +
          dlqClass +
          '">' +
          counts.dlq.toLocaleString('en-US') +
          '</dd></div>' +
          '</dl>' +
          '<div class="mt-4 flex items-center justify-between">' +
          '<button type="button" data-toggle-deliveries="' +
          escapeHtml(e.id) +
          '" class="text-sm text-tk-accent-text hover:underline">View delivery log →</button>' +
          requeueLink +
          '</div>' +
          '<div data-deliveries="' +
          escapeHtml(e.id) +
          '" class="hidden mt-4 border-t border-tk-border pt-4">' +
          '<p class="text-sm text-tk-ink-3">Loading deliveries…</p>' +
          '</div>' +
          '</li>'
        );
      }

      function fmtIsoMin(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function deliveryRow(d) {
        const statusBadge =
          'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ';
        const statusClass =
          d.status === 'delivered'
            ? statusBadge + 'bg-tk-ready/10 text-tk-ready-text'
            : d.status === 'pending' || d.status === 'in_flight'
              ? statusBadge + 'bg-tk-accent/10 text-tk-accent-text'
              : d.status === 'failed'
                ? statusBadge + 'bg-tk-busy/10 text-tk-busy-text'
                : statusBadge + 'bg-tk-err/10 text-tk-err-text';
        const replayBtn =
          d.status === 'failed' || d.status === 'dlq' || d.status === 'delivered'
            ? '<button type="button" data-replay="' +
              escapeHtml(d.id) +
              '" class="text-xs text-tk-accent-text hover:underline">Replay</button>'
            : '';
        return (
          '<li class="flex items-start justify-between gap-3 py-2 text-sm">' +
          '<div class="min-w-0 flex-1">' +
          '<div class="flex flex-wrap items-center gap-2">' +
          '<span class="' +
          statusClass +
          '">' +
          escapeHtml(d.status) +
          '</span>' +
          '<span class="font-mono text-xs text-tk-ink-2">' +
          escapeHtml(d.event_type) +
          '</span>' +
          '<span class="text-xs text-tk-ink-3">' +
          escapeHtml(fmtIsoMin(d.created_at)) +
          '</span>' +
          '</div>' +
          (d.last_error
            ? '<p class="mt-1 text-xs text-tk-err-text">' + escapeHtml(d.last_error) + '</p>'
            : '') +
          '</div>' +
          replayBtn +
          '</li>'
        );
      }

      // V-403 + V-443 — delivery-log status filter + cursor pagination.
      // Backend accepts ?status= + ?cursor= on /v1/webhooks/:id/deliveries.
      // V-443 stores a `cursor` per endpoint in a closure-scoped Map so
      // the Load-more button can append the next page without re-fetching
      // the whole list. Filter changes reset the cursor + clear append
      // state.
      const deliveriesPager = new Map();
      // S32 — Map<endpointId, latest-request-seq> for the race guard.
      const deliveriesSeq = new Map();
      // Map<endpointId, { items: [], cursor: string|null, status: string }>

      function buildFilterBar(endpointId, status) {
        return (
          '<div class="mb-3 flex items-center gap-2 text-xs text-tk-ink-3">' +
          '<label for="status-' +
          escapeHtml(endpointId) +
          '">Filter:</label>' +
          '<select id="status-' +
          escapeHtml(endpointId) +
          '" data-deliveries-filter="' +
          escapeHtml(endpointId) +
          '" class="rounded-md border border-tk-border px-2 py-1 text-xs">' +
          ['', 'pending', 'in_flight', 'delivered', 'failed', 'dlq']
            .map((s) => {
              const sel = s === (status || '') ? ' selected' : '';
              const label = s === '' ? 'All statuses' : s;
              return '<option value="' + escapeHtml(s) + '"' + sel + '>' + escapeHtml(label) + '</option>';
            })
            .join('') +
          '</select></div>'
        );
      }

      function renderDeliveries(container, endpointId, state) {
        const filterBar = buildFilterBar(endpointId, state.status);
        let body;
        if (state.items.length === 0) {
          body =
            '<p class="text-sm text-tk-ink-3">No deliveries' +
            (state.status ? ' with status "' + escapeHtml(state.status) + '"' : '') +
            '.</p>';
        } else {
          const list =
            '<ul class="divide-y divide-tk-border">' +
            state.items.map(deliveryRow).join('') +
            '</ul>';
          const moreBtn = state.cursor
            ? '<button type="button" data-load-more-deliveries="' +
              escapeHtml(endpointId) +
              '" class="mt-3 text-sm text-tk-accent-text hover:underline">Load more</button>'
            : '';
          body = list + moreBtn;
        }
        container.innerHTML = filterBar + body;
        // Re-wire filter + load-more (innerHTML reset wipes listeners).
        const sel = container.querySelector('[data-deliveries-filter]');
        if (sel) {
          sel.addEventListener('change', () => {
            // Filter change resets pager state + re-fetches first page.
            deliveriesPager.delete(endpointId);
            loadDeliveries(endpointId, container, sel.value);
          });
        }
        const loadMore = container.querySelector('[data-load-more-deliveries]');
        if (loadMore) {
          loadMore.addEventListener('click', () => {
            loadMoreDeliveries(endpointId, container);
          });
        }
        wireReplayButtons(container);
      }

      function loadDeliveries(endpointId, container, status) {
        if (!token) return;
        // S32 2026-07-07 (fable-frontend-audit) — request-generation guard:
        // changing the filter while a fetch is in flight left two live
        // requests, and a stale (slower, unfiltered) response landing last
        // would silently revert the customer's selection. Stamp each load
        // and drop any response that isn't the latest for this endpoint.
        const seq = (deliveriesSeq.get(endpointId) || 0) + 1;
        deliveriesSeq.set(endpointId, seq);
        const queryParts = ['limit=20'];
        if (status) queryParts.push('status=' + encodeURIComponent(status));
        container.innerHTML =
          buildFilterBar(endpointId, status) + '<p class="text-sm text-tk-ink-3">Loading…</p>';
        const sel = container.querySelector('[data-deliveries-filter]');
        if (sel) {
          sel.addEventListener('change', () => {
            deliveriesPager.delete(endpointId);
            loadDeliveries(endpointId, container, sel.value);
          });
        }
        fetch(
          apiBaseUrl +
            '/v1/webhooks/' +
            encodeURIComponent(endpointId) +
            '/deliveries?' +
            queryParts.join('&'),
          {
            headers: {
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
          },
        )
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            // Drop a stale response (a newer filter/load fired after this).
            if (deliveriesSeq.get(endpointId) !== seq) return;
            const state = {
              items: body.data || [],
              cursor: body.has_more ? body.next_cursor : null,
              status: status || '',
            };
            deliveriesPager.set(endpointId, state);
            renderDeliveries(container, endpointId, state);
          })
          .catch((err) => {
            if (deliveriesSeq.get(endpointId) !== seq) return;
            container.innerHTML =
              '<p class="text-sm text-tk-err-text">Failed to load deliveries: ' +
              escapeHtml(err && err.message ? err.message : 'network error') +
              '</p>';
          });
      }

      function loadMoreDeliveries(endpointId, container) {
        if (!token) return;
        const state = deliveriesPager.get(endpointId);
        if (!state || !state.cursor) return;
        const queryParts = ['limit=20', 'cursor=' + encodeURIComponent(state.cursor)];
        if (state.status) queryParts.push('status=' + encodeURIComponent(state.status));
        // Optimistic UI: dim the Load-more button while fetching.
        const btn = container.querySelector('[data-load-more-deliveries]');
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Loading…';
        }
        fetch(
          apiBaseUrl +
            '/v1/webhooks/' +
            encodeURIComponent(endpointId) +
            '/deliveries?' +
            queryParts.join('&'),
          {
            headers: {
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
          },
        )
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            const next = {
              items: state.items.concat(body.data || []),
              cursor: body.has_more ? body.next_cursor : null,
              status: state.status,
            };
            deliveriesPager.set(endpointId, next);
            renderDeliveries(container, endpointId, next);
          })
          .catch((err) => {
            if (btn) {
              btn.disabled = false;
              btn.textContent = 'Load more';
            }
            // Surface error in the banner; preserve the existing list.
            const banner = root.querySelector('[data-banner]');
            if (banner) {
              banner.textContent =
                'Failed to load more deliveries: ' +
                (err && err.message ? err.message : 'network error');
              banner.classList.remove('hidden');
            }
          });
      }

      function wireReplayButtons(scope) {
        const buttons = scope.querySelectorAll('[data-replay]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-replay');
            btn.disabled = true;
            btn.textContent = 'Replaying…';
            fetch(apiBaseUrl + '/v1/webhook-deliveries/' + encodeURIComponent(id) + '/replay', {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                'content-type': 'application/json',
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
              body: '{}',
            })
              .then((r) => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                btn.textContent = 'Replayed ✓';
                btn.classList.add('text-tk-ready-text');
              })
              .catch((err) => {
                btn.disabled = false;
                btn.textContent = 'Replay';
                showBanner('Replay failed: ' + (err && err.message ? err.message : 'network error'));
              });
          });
        });
      }

      function wireDeliveryToggles() {
        const buttons = ul.querySelectorAll('[data-toggle-deliveries]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-toggle-deliveries');
            const container = ul.querySelector('[data-deliveries="' + id + '"]');
            if (!container) return;
            const isHidden = container.classList.contains('hidden');
            if (isHidden) {
              container.classList.remove('hidden');
              btn.textContent = 'Hide delivery log';
              loadDeliveries(id, container);
            } else {
              container.classList.add('hidden');
              btn.textContent = 'View delivery log →';
            }
          });
        });
        // S32 2026-07-07 (fable-frontend-audit) — the "Review DLQ" card
        // link expands the delivery log pre-filtered to the dead-lettered
        // deliveries, where each row's Replay button works (replacing the
        // old dead #requeue anchor).
        ul.querySelectorAll('[data-open-deliveries]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-open-deliveries');
            const status = btn.getAttribute('data-open-deliveries-status') || '';
            const container = ul.querySelector('[data-deliveries="' + id + '"]');
            const toggle = ul.querySelector('[data-toggle-deliveries="' + id + '"]');
            if (!container) return;
            container.classList.remove('hidden');
            if (toggle) toggle.textContent = 'Hide delivery log';
            deliveriesPager.delete(id);
            loadDeliveries(id, container, status);
            container.scrollIntoView({ block: 'nearest' });
          });
        });
      }

      // V-351b — wire the Edit form.
      const editWrap = root.querySelector('[data-edit-wrap]');
      const editForm = root.querySelector('[data-edit-form]');
      const editCancel = root.querySelector('[data-edit-cancel]');
      const editSubmit = root.querySelector('[data-edit-submit]');
      const editError = root.querySelector('[data-edit-error]');
      const editIdEl = root.querySelector('[data-edit-id]');
      let editingEndpoint = null;

      function showEditError(msg) {
        if (!editError) return;
        editError.textContent = msg;
        editError.classList.remove('hidden');
      }
      function hideEdit() {
        if (editWrap) editWrap.classList.add('hidden');
        if (editForm) editForm.reset();
        if (editError) {
          editError.classList.add('hidden');
          editError.textContent = '';
        }
        editingEndpoint = null;
      }
      if (editCancel) editCancel.addEventListener('click', hideEdit);

      function startEdit(endpoint) {
        editingEndpoint = endpoint;
        if (editIdEl) editIdEl.textContent = endpoint.id;
        const urlInput = editForm.querySelector('input[name="url"]');
        const descInput = editForm.querySelector('input[name="description"]');
        const activeInput = editForm.querySelector('[data-edit-active]');
        if (urlInput) urlInput.value = endpoint.url;
        if (descInput) descInput.value = endpoint.description || '';
        if (activeInput) activeInput.checked = endpoint.active === true;
        // Pre-check the events the endpoint already subscribes to.
        const eventChecks = editForm.querySelectorAll('input[name="event"]');
        eventChecks.forEach((cb) => {
          cb.checked = (endpoint.events || []).includes(cb.value);
        });
        if (editWrap) editWrap.classList.remove('hidden');
        if (createWrap) createWrap.classList.add('hidden');
        editWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function wireEditButtons() {
        const buttons = ul.querySelectorAll('[data-edit]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-edit');
            if (!id) return;
            // Look up the full endpoint shape from the live data we
            // last rendered. Cheap re-fetch keeps the form in sync
            // with current state in case it changed since the last
            // render.
            fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(id), {
              headers: {
                authorization: 'Bearer ' + token,
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
            })
              .then((r) =>
                r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)),
              )
              .then((endpoint) => startEdit(endpoint))
              .catch((err) => {
                showBanner(
                  'Failed to load endpoint for edit: ' +
                    (err && err.message ? err.message : 'network error'),
                );
              });
          });
        });
      }

      if (editForm) {
        editForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!editingEndpoint) return;
          if (editError) {
            editError.classList.add('hidden');
            editError.textContent = '';
          }
          const fd = new FormData(editForm);
          const url = (fd.get('url') || '').toString().trim();
          const description = (fd.get('description') || '').toString().trim();
          const events = fd.getAll('event').map((v) => v.toString());
          const active = fd.get('active') === 'on';
          if (!url) {
            showEditError('URL is required.');
            return;
          }
          if (events.length === 0) {
            showEditError('Pick at least one event.');
            return;
          }
          if (editSubmit) {
            editSubmit.disabled = true;
            editSubmit.textContent = 'Saving…';
          }
          fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(editingEndpoint.id), {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
            body: JSON.stringify({
              url: url,
              events: events,
              description: description.length > 0 ? description : null,
              active: active,
            }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              hideEdit();
              window.location.reload();
            })
            .catch((err) => {
              showEditError(err && err.message ? err.message : 'Failed to save changes.');
              if (editSubmit) {
                editSubmit.disabled = false;
                editSubmit.textContent = 'Save changes';
              }
            });
        });
      }

      // V-347b — wire the per-row Delete buttons. DELETE
      // /v1/webhooks/:id is admin-only on team-scoped requests
      // (V-326e5); the act-as helper handles team scope.
      function wireDeleteButtons() {
        const buttons = ul.querySelectorAll('[data-delete]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-delete');
            if (!id) return;
            const confirmed = await window.driftstackConfirm(
              'Delete webhook endpoint ' + id + '? This cannot be undone.',
              { confirmLabel: 'Delete', destructive: true },
            );
            if (!confirmed) {
              return;
            }
            btn.disabled = true;
            btn.textContent = 'Deleting…';
            fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(id), {
              method: 'DELETE',
              headers: {
                authorization: 'Bearer ' + token,
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
            })
              .then((r) => {
                if (!r.ok && r.status !== 204) {
                  return r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
                }
                window.location.reload();
              })
              .catch((err) => {
                showBanner('Delete failed: ' + (err && err.message ? err.message : 'network error'));
                btn.disabled = false;
                btn.textContent = 'Delete';
              });
          });
        });
      }

      // V-359 — wire the per-row "Rotate secret" buttons. Generates
      // a fresh signing secret with a 24h grace during which both the
      // old + new secrets are accepted.
      //
      // V-475 — plaintext lands in an in-page reveal pane (not a
      // window.prompt). Some browsers block prompts in non-interactive
      // contexts (incognito mode, autofill blockers, etc.) — and even
      // when shown, prompts aren't keyboard-accessible for paste.
      const rotateRevealEl = root.querySelector('[data-rotate-reveal]');
      const rotateSecretEl = root.querySelector('[data-rotate-secret]');
      const rotateEndpointIdEl = root.querySelector('[data-rotate-endpoint-id]');
      const rotateGraceEl = root.querySelector('[data-rotate-grace-expires]');
      const rotateCopyBtn = root.querySelector('[data-rotate-copy]');
      const rotateDismissBtn = root.querySelector('[data-rotate-dismiss]');

      function showRotateReveal(endpointId, secret, graceExpiresAt) {
        if (!rotateRevealEl || !rotateSecretEl) return;
        if (rotateEndpointIdEl) rotateEndpointIdEl.textContent = endpointId;
        rotateSecretEl.textContent = secret;
        if (rotateGraceEl) {
          rotateGraceEl.textContent = new Date(graceExpiresAt).toLocaleString();
        }
        rotateRevealEl.classList.remove('hidden');
        rotateRevealEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function hideRotateReveal() {
        if (!rotateRevealEl || !rotateSecretEl) return;
        rotateRevealEl.classList.add('hidden');
        // Clear secret from DOM so it isn't recoverable post-dismiss.
        rotateSecretEl.textContent = '';
        if (rotateEndpointIdEl) rotateEndpointIdEl.textContent = '';
        if (rotateGraceEl) rotateGraceEl.textContent = '';
      }

      if (rotateDismissBtn) {
        rotateDismissBtn.addEventListener('click', () => {
          hideRotateReveal();
          window.location.reload();
        });
      }
      if (rotateCopyBtn) {
        rotateCopyBtn.addEventListener('click', () => {
          if (!rotateSecretEl) return;
          const secret = rotateSecretEl.textContent || '';
          if (!secret) return;
          navigator.clipboard
            .writeText(secret)
            .then(() => {
              const orig = rotateCopyBtn.textContent;
              rotateCopyBtn.textContent = 'Copied ✓';
              window.setTimeout(() => {
                rotateCopyBtn.textContent = orig;
              }, 1500);
            })
            .catch(() => {
              showBanner('Copy failed. Select the secret manually.');
            });
        });
      }

      function wireRotateButtons() {
        const buttons = ul.querySelectorAll('[data-rotate]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-rotate');
            if (!id) return;
            if (
              !(await window.driftstackConfirm(
                'Rotate signing secret for ' +
                  id +
                  '?\n\nThe new secret is shown ONCE. The old secret stays active for 24h so your verifier can roll forward without dropped deliveries.',
                { confirmLabel: 'Rotate secret', destructive: true },
              ))
            ) {
              return;
            }
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = 'Rotating…';
            fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(id) + '/rotate-secret', {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
            })
              .then((r) =>
                r.ok
                  ? r.json()
                  : r
                      .json()
                      .catch(() => ({}))
                      .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
              )
              .then((body) => {
                showRotateReveal(id, body.secret, body.grace_expires_at);
              })
              .catch((err) => {
                showBanner(
                  'Rotate failed: ' + (err && err.message ? err.message : 'network error'),
                );
              })
              .finally(() => {
                btn.disabled = false;
                btn.textContent = original;
              });
          });
        });
      }

      // V-356 — wire the per-row "Send test" buttons. POSTs to
      // /v1/webhooks/:id/test which enqueues a synthetic test.ping
      // delivery on the endpoint regardless of subscription.
      function wireTestButtons() {
        const buttons = ul.querySelectorAll('[data-test]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-test');
            if (!id) return;
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = 'Sending…';
            fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(id) + '/test', {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
            })
              .then((r) => {
                if (!r.ok && r.status !== 202) {
                  return r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
                }
                showBanner(
                  'Test event queued. Check your endpoint and the delivery log to confirm receipt.',
                );
              })
              .catch((err) => {
                showBanner(
                  'Test send failed: ' +
                    (err && err.message ? err.message : 'network error'),
                );
              })
              .finally(() => {
                btn.disabled = false;
                btn.textContent = original;
              });
          });
        });
      }

      if (!token) {
        // S32 2026-07-07 (fable-frontend-audit) — no preview data exists;
        // show the empty state, not a promise of data below.
        ul.classList.add('hidden');
        empty.classList.remove('hidden');
        showBanner('Sign in to see and manage your webhook endpoints.');
        return;
      }

      fetch(apiBaseUrl + '/v1/webhooks', {
        // Every mutation (create/edit/delete/rotate/test) carries the act-as
        // team header; the LIST must too, or acting-as a team renders the
        // USER's own endpoints while mutations target the TEAM's — you'd edit
        // what you can't see.
        headers: {
          authorization: 'Bearer ' + token,
          ...(typeof window.driftstackActAsHeaders === 'function'
            ? window.driftstackActAsHeaders()
            : {}),
        },
        credentials: 'include',
      })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
        .then((body) => {
          const endpoints = body.data || [];
          if (endpoints.length === 0) {
            ul.classList.add('hidden');
            empty.classList.remove('hidden');
          } else {
            empty.classList.add('hidden');
            ul.classList.remove('hidden');
            ul.innerHTML = endpoints.map(endpointCard).join('');
            wireDeliveryToggles();
            wireDeleteButtons();
            wireEditButtons();
            wireTestButtons();
            wireRotateButtons();
          }
          // S32 2026-07-07 (fable-frontend-audit) — the old success banner
          // claimed delivery counts are "not exposed via /v1/webhooks",
          // but V-185 added delivery_counts and the cards render them; the
          // banner contradicted the page. No banner on a clean load.
        })
        .catch((err) => {
          // S32 2026-07-07 (fable-frontend-audit) — the old copy said
          // "Showing preview data below", but no preview data is ever
          // rendered (MOCK_WEBHOOKS was dead code) — the customer was left
          // staring at loading skeletons forever. Show an honest error
          // state instead.
          ul.classList.add('hidden');
          empty.classList.add('hidden');
          showBanner(
            "Couldn't load your webhook endpoints (" +
              (err && err.message ? err.message : 'network error') +
              '). Refresh to try again.',
          );
        })
        .finally(function () {
          // 2026-05-21 — signal the layout's opacity-gate that the
          // primary /v1/webhooks fetch resolved (success or failure).
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });
    })();
  </script>
</DashboardLayout>
