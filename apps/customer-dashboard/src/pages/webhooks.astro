---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-181 — progressive-enhancement wiring against /v1/webhooks,
// mirrors V-180 /sessions pattern. SSG renders mock for instant
// paint; inline <script> replaces the endpoint list with live data
// when ds_web_session_token is in localStorage.
//
// Live /v1/webhooks response shape DOES include endpoint metadata
// (URL, events, active, description, consecutive_failures,
// last_success_at, last_failure_at, created_at) but does NOT
// include aggregate delivery_counts (delivered/failed/dlq). The
// mock displays delivery_counts; in live mode we render dashes for
// those cells and surface a note ("Delivery counts coming soon").
// Adding a delivery-aggregation endpoint is a separate V-NNN.

interface MockWebhookEndpoint {
  id: string;
  url: string;
  events: ReadonlyArray<string>;
  active: boolean;
  description: string | null;
  created_at: string;
  delivery_counts: { delivered: number; failed: number; dlq: number };
}

const MOCK_WEBHOOKS: MockWebhookEndpoint[] = [
  {
    id: 'whk_00000000-0000-4000-8000-0000000000d1',
    url: 'https://hooks.example.test/driftstack',
    events: ['session.completed', 'session.failed', 'quota.warning_80pct'],
    active: true,
    description: 'production hook',
    created_at: '2026-04-15T09:30:00Z',
    delivery_counts: { delivered: 4321, failed: 12, dlq: 1 },
  },
  {
    id: 'whk_00000000-0000-4000-8000-0000000000d2',
    url: 'https://staging.example.test/driftstack',
    events: ['session.completed'],
    active: false,
    description: 'staging — paused while testing',
    created_at: '2026-04-22T15:00:00Z',
    delivery_counts: { delivered: 213, failed: 0, dlq: 0 },
  },
];

function fmtIsoDay(iso: string): string {
  return new Date(iso).toISOString().slice(0, 10);
}

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<DashboardLayout title="Webhooks">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="webhooks">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
      role="status"
    ></div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-slate-500">
          HMAC-SHA256-signed event delivery · 5-minute timestamp tolerance
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">
          Webhook endpoints
        </h1>
        <p class="mt-2 max-w-prose text-sm text-slate-500">
          Subscribe to session lifecycle + quota events. Each endpoint gets
          its own signing secret; verify with the SDK's
          <code class="font-mono">verifyWebhookSignature</code> helper.
        </p>
      </div>
      <button type="button" data-show-create class="btn-primary shrink-0">New endpoint</button>
    </header>

    <!--
      V-347 — Create-endpoint form. Hidden by default; reveals when
      "New endpoint" is clicked. Posts to POST /v1/webhooks. On
      success the secret is shown ONCE — same pattern as the V-296
      api-key reveal pane.
    -->
    <div data-create-wrap class="mb-8 hidden rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-slate-900">New webhook endpoint</h2>
      <form data-create-form class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="webhook-url">
            URL
          </label>
          <input
            id="webhook-url"
            name="url"
            type="url"
            required
            placeholder="https://hooks.example.com/driftstack"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
          <p class="mt-1 text-xs text-slate-500">
            HTTPS required. The endpoint must respond 2xx within 10s for delivery to count
            as successful.
          </p>
        </div>
        <div>
          <span class="block text-sm font-medium text-slate-700">Events to subscribe to</span>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-700">
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.completed" checked
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              <span class="font-mono text-xs">session.completed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.failed"
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              <span class="font-mono text-xs">session.failed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="api_key.revoked"
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              <span class="font-mono text-xs">api_key.revoked</span>
            </label>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="webhook-description">
            Description (optional)
          </label>
          <input
            id="webhook-description"
            name="description"
            type="text"
            placeholder="production hook for the EU region"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <p
          data-create-error
          class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        ></p>
        <div class="flex justify-end gap-3 border-t border-slate-100 pt-4">
          <button
            type="button"
            data-create-cancel
            class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-create-submit
            class="btn-primary"
          >
            Create endpoint
          </button>
        </div>
      </form>
    </div>

    <!--
      Post-create reveal pane — the secret is shown ONCE. Same posture
      as the V-296 api-key reveal.
    -->
    <div
      data-create-reveal
      class="mb-8 hidden rounded-lg border border-emerald-200 bg-emerald-50 p-6"
    >
      <h2 class="text-lg font-semibold text-emerald-900">Endpoint created</h2>
      <p class="mt-1 text-sm text-emerald-800">
        Copy this signing secret now — it won't be shown again. Use it with the SDK's
        <code class="font-mono">verifyWebhookSignature</code> helper to authenticate
        incoming deliveries.
      </p>
      <pre
        data-reveal-secret
        class="mt-3 overflow-x-auto rounded border border-emerald-200 bg-white px-3 py-2 font-mono text-xs text-slate-900"
      ></pre>
      <button
        type="button"
        data-reveal-dismiss
        class="btn-secondary mt-4"
      >
        I've copied it
      </button>
    </div>

    <!--
      V-351b — Edit-endpoint form. Hidden by default; reveals when a
      row's "Edit" button is clicked. Mirrors the V-347 create form
      shape; PATCHes the live endpoint instead of POSTing a new one.
    -->
    <div
      data-edit-wrap
      class="mb-8 hidden rounded-lg border border-blue-200 bg-blue-50/30 p-6"
    >
      <h2 class="text-lg font-semibold text-slate-900">
        Edit endpoint <span data-edit-id class="font-mono text-xs text-slate-500"></span>
      </h2>
      <form data-edit-form class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="edit-webhook-url">
            URL
          </label>
          <input
            id="edit-webhook-url"
            name="url"
            type="url"
            required
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <span class="block text-sm font-medium text-slate-700">Events to subscribe to</span>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-700">
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.completed"
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              <span class="font-mono text-xs">session.completed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="session.failed"
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              <span class="font-mono text-xs">session.failed</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="event" value="api_key.revoked"
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              <span class="font-mono text-xs">api_key.revoked</span>
            </label>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="edit-webhook-description">
            Description
          </label>
          <input
            id="edit-webhook-description"
            name="description"
            type="text"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <label class="inline-flex items-center gap-2 text-sm text-slate-700">
            <input
              type="checkbox"
              name="active"
              data-edit-active
              class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
            />
            Active (uncheck to pause delivery without deleting)
          </label>
        </div>
        <p
          data-edit-error
          class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        ></p>
        <div class="flex justify-end gap-3 border-t border-blue-100 pt-4">
          <button
            type="button"
            data-edit-cancel
            class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-edit-submit
            class="btn-primary"
          >
            Save changes
          </button>
        </div>
      </form>
    </div>

    <div
      data-empty
      class:list={['dashboard-card text-center', MOCK_WEBHOOKS.length === 0 ? '' : 'hidden']}
    >
      <h2 class="text-lg font-semibold text-slate-900">No webhook endpoints</h2>
      <p class="mx-auto mt-2 max-w-prose text-sm text-slate-500">
        Subscribe to events when sessions complete, fail, or quota thresholds trip. POST + URL +
        event list = endpoint.
      </p>
      <a href="#new" class="btn-primary mt-6 inline-flex">Create endpoint</a>
    </div>
    <ul data-list class:list={['space-y-4', MOCK_WEBHOOKS.length === 0 ? 'hidden' : '']}>
      {
        MOCK_WEBHOOKS.map((endpoint) => (
            <li class="dashboard-card">
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0">
                  <div class="flex items-center gap-3">
                    <p class="truncate font-mono text-sm text-slate-900">
                      {endpoint.url}
                    </p>
                    <span
                      class:list={[
                        'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                        endpoint.active
                          ? 'bg-emerald-50 text-emerald-700'
                          : 'bg-slate-100 text-slate-600',
                      ]}
                    >
                      {endpoint.active ? 'active' : 'paused'}
                    </span>
                  </div>
                  {endpoint.description && (
                    <p class="mt-2 text-sm text-slate-600">{endpoint.description}</p>
                  )}
                  <p class="mt-2 font-mono text-xs text-slate-500">
                    {endpoint.id} · created {fmtIsoDay(endpoint.created_at)}
                  </p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  <a href={`#edit-${endpoint.id}`} class="text-sm text-oxblood-700 hover:underline">
                    Edit
                  </a>
                  <a href={`#delete-${endpoint.id}`} class="text-sm text-red-700 hover:underline">
                    Delete
                  </a>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {endpoint.events.map((event) => (
                  <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700">
                    {event}
                  </span>
                ))}
              </div>

              <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-slate-100 pt-4 text-center">
                <div>
                  <dt class="text-xs text-slate-500">Delivered</dt>
                  <dd class="mt-1 font-mono text-lg font-medium text-emerald-700">
                    {endpoint.delivery_counts.delivered.toLocaleString('en-US')}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs text-slate-500">Failed</dt>
                  <dd class="mt-1 font-mono text-lg font-medium text-amber-700">
                    {endpoint.delivery_counts.failed.toLocaleString('en-US')}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs text-slate-500">DLQ</dt>
                  <dd
                    class:list={[
                      'mt-1 font-mono text-lg font-medium',
                      endpoint.delivery_counts.dlq > 0 ? 'text-red-700' : 'text-slate-400',
                    ]}
                  >
                    {endpoint.delivery_counts.dlq.toLocaleString('en-US')}
                  </dd>
                </div>
              </dl>

              <div class="mt-4 flex items-center justify-between">
                <a
                  href={`#deliveries-${endpoint.id}`}
                  class="text-sm text-oxblood-700 hover:underline"
                >
                  View delivery log →
                </a>
                {endpoint.delivery_counts.dlq > 0 && (
                  <a
                    href={`#requeue-${endpoint.id}`}
                    class="text-sm font-medium text-red-700 hover:underline"
                  >
                    Requeue DLQ ({endpoint.delivery_counts.dlq.toString()})
                  </a>
                )}
              </div>
            </li>
          ))
      }
    </ul>

    <p class="mt-8 text-xs text-slate-500">
      Failed deliveries retry 5× with exponential backoff before landing in
      the DLQ. DLQ entries are admin-replayable; no auto-retry past the
      initial attempts to avoid storm-on-recovery patterns.
    </p>
  </div>

  <!--
    V-181 — progressive-enhancement script. Reads
    ds_web_session_token from localStorage, fetches /v1/webhooks,
    replaces the endpoint list with live data. Falls back to
    mock-rendered list when token absent or fetch fails. Mirrors
    V-180 /sessions pattern.
  -->
  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="webhooks"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const ul = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const token = localStorage.getItem('ds_web_session_token');

      // V-347 — wire the create form.
      const showCreateBtn = root.querySelector('[data-show-create]');
      const createWrap = root.querySelector('[data-create-wrap]');
      const createForm = root.querySelector('[data-create-form]');
      const createCancel = root.querySelector('[data-create-cancel]');
      const createSubmit = root.querySelector('[data-create-submit]');
      const createError = root.querySelector('[data-create-error]');
      const createReveal = root.querySelector('[data-create-reveal]');
      const revealSecret = root.querySelector('[data-reveal-secret]');
      const revealDismiss = root.querySelector('[data-reveal-dismiss]');

      function showCreate() {
        if (!token) {
          showBanner('Sign in to create webhook endpoints.');
          return;
        }
        if (createWrap) createWrap.classList.remove('hidden');
        if (createReveal) createReveal.classList.add('hidden');
      }
      function hideCreate() {
        if (createWrap) createWrap.classList.add('hidden');
        if (createForm) createForm.reset();
        if (createError) {
          createError.classList.add('hidden');
          createError.textContent = '';
        }
      }
      function showCreateError(msg) {
        if (!createError) return;
        createError.textContent = msg;
        createError.classList.remove('hidden');
      }

      if (showCreateBtn) showCreateBtn.addEventListener('click', showCreate);
      if (createCancel) createCancel.addEventListener('click', hideCreate);
      if (revealDismiss) {
        revealDismiss.addEventListener('click', () => {
          if (createReveal) createReveal.classList.add('hidden');
        });
      }
      if (createForm) {
        createForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (createError) {
            createError.classList.add('hidden');
            createError.textContent = '';
          }
          const fd = new FormData(createForm);
          const url = (fd.get('url') || '').toString().trim();
          const description = (fd.get('description') || '').toString().trim();
          const events = fd.getAll('event').map((v) => v.toString());
          if (!url) {
            showCreateError('URL is required.');
            return;
          }
          if (events.length === 0) {
            showCreateError('Pick at least one event.');
            return;
          }
          if (createSubmit) {
            createSubmit.disabled = true;
            createSubmit.textContent = 'Creating…';
          }
          fetch(apiBaseUrl + '/v1/webhooks', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
            body: JSON.stringify({
              url: url,
              events: events,
              description: description.length > 0 ? description : null,
            }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then((body) => {
              hideCreate();
              if (createReveal && revealSecret) {
                revealSecret.textContent = body.secret || '(no secret returned)';
                createReveal.classList.remove('hidden');
              }
              // Reload to refresh the endpoint list.
              window.setTimeout(() => window.location.reload(), 8000);
            })
            .catch((err) => {
              showCreateError(err && err.message ? err.message : 'Failed to create endpoint.');
              if (createSubmit) {
                createSubmit.disabled = false;
                createSubmit.textContent = 'Create endpoint';
              }
            });
        });
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function fmtIsoDay(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }

      function endpointCard(e) {
        const events = (e.events || [])
          .map(
            (ev) =>
              '<span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700">' +
              escapeHtml(ev) +
              '</span>',
          )
          .join('');
        const description = e.description
          ? '<p class="mt-2 text-sm text-slate-600">' + escapeHtml(e.description) + '</p>'
          : '';
        const activeBadge =
          'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (e.active ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600');
        // V-185 — aggregate delivery counts now in /v1/webhooks
        // response. Falls back to zeros if missing.
        const counts = e.delivery_counts || { delivered: 0, failed: 0, dlq: 0 };
        const dlqClass = counts.dlq > 0 ? 'text-red-700' : 'text-slate-400';
        const requeueLink =
          counts.dlq > 0
            ? '<a href="#requeue-' +
              escapeHtml(e.id) +
              '" class="text-sm font-medium text-red-700 hover:underline">Requeue DLQ (' +
              counts.dlq +
              ')</a>'
            : '';
        return (
          '<li class="dashboard-card">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<div class="flex items-center gap-3">' +
          '<p class="truncate font-mono text-sm text-slate-900">' +
          escapeHtml(e.url) +
          '</p>' +
          '<span class="' +
          activeBadge +
          '">' +
          (e.active ? 'active' : 'paused') +
          '</span></div>' +
          description +
          '<p class="mt-2 font-mono text-xs text-slate-500">' +
          escapeHtml(e.id) +
          ' · created ' +
          escapeHtml(fmtIsoDay(e.created_at)) +
          ' · ' +
          (e.consecutive_failures || 0) +
          ' consecutive failure(s)</p>' +
          '</div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<button type="button" data-edit="' +
          escapeHtml(e.id) +
          '" class="text-sm text-oxblood-700 hover:underline">Edit</button>' +
          '<button type="button" data-delete="' +
          escapeHtml(e.id) +
          '" class="text-sm text-red-700 hover:underline">Delete</button>' +
          '</div></div>' +
          '<div class="mt-4 flex flex-wrap gap-1.5">' +
          events +
          '</div>' +
          '<dl class="mt-4 grid grid-cols-3 gap-2 border-t border-slate-100 pt-4 text-center">' +
          '<div><dt class="text-xs text-slate-500">Delivered</dt>' +
          '<dd class="mt-1 font-mono text-lg font-medium text-emerald-700">' +
          counts.delivered.toLocaleString('en-US') +
          '</dd></div>' +
          '<div><dt class="text-xs text-slate-500">Failed</dt>' +
          '<dd class="mt-1 font-mono text-lg font-medium text-amber-700">' +
          counts.failed.toLocaleString('en-US') +
          '</dd></div>' +
          '<div><dt class="text-xs text-slate-500">DLQ</dt>' +
          '<dd class="mt-1 font-mono text-lg font-medium ' +
          dlqClass +
          '">' +
          counts.dlq.toLocaleString('en-US') +
          '</dd></div>' +
          '</dl>' +
          '<div class="mt-4 flex items-center justify-between">' +
          '<button type="button" data-toggle-deliveries="' +
          escapeHtml(e.id) +
          '" class="text-sm text-oxblood-700 hover:underline">View delivery log →</button>' +
          requeueLink +
          '</div>' +
          '<div data-deliveries="' +
          escapeHtml(e.id) +
          '" class="hidden mt-4 border-t border-slate-100 pt-4">' +
          '<p class="text-sm text-slate-500">Loading deliveries…</p>' +
          '</div>' +
          '</li>'
        );
      }

      function fmtIsoMin(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function deliveryRow(d) {
        const statusBadge =
          'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ';
        const statusClass =
          d.status === 'delivered'
            ? statusBadge + 'bg-emerald-50 text-emerald-700'
            : d.status === 'pending' || d.status === 'in_flight'
              ? statusBadge + 'bg-amber-50 text-amber-700'
              : d.status === 'failed'
                ? statusBadge + 'bg-orange-50 text-orange-700'
                : statusBadge + 'bg-red-50 text-red-700';
        const replayBtn =
          d.status === 'failed' || d.status === 'dlq' || d.status === 'delivered'
            ? '<button type="button" data-replay="' +
              escapeHtml(d.id) +
              '" class="text-xs text-oxblood-700 hover:underline">Replay</button>'
            : '';
        return (
          '<li class="flex items-start justify-between gap-3 py-2 text-sm">' +
          '<div class="min-w-0 flex-1">' +
          '<div class="flex flex-wrap items-center gap-2">' +
          '<span class="' +
          statusClass +
          '">' +
          escapeHtml(d.status) +
          '</span>' +
          '<span class="font-mono text-xs text-slate-700">' +
          escapeHtml(d.event_type) +
          '</span>' +
          '<span class="text-xs text-slate-500">' +
          escapeHtml(fmtIsoMin(d.created_at)) +
          '</span>' +
          '</div>' +
          (d.last_error
            ? '<p class="mt-1 text-xs text-red-700">' + escapeHtml(d.last_error) + '</p>'
            : '') +
          '</div>' +
          replayBtn +
          '</li>'
        );
      }

      function loadDeliveries(endpointId, container) {
        if (!token) return;
        container.innerHTML = '<p class="text-sm text-slate-500">Loading…</p>';
        fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(endpointId) + '/deliveries?limit=20', {
          headers: {
            authorization: 'Bearer ' + token,
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            const deliveries = body.data || [];
            if (deliveries.length === 0) {
              container.innerHTML = '<p class="text-sm text-slate-500">No deliveries recorded yet for this endpoint.</p>';
              return;
            }
            container.innerHTML =
              '<ul class="divide-y divide-slate-100">' + deliveries.map(deliveryRow).join('') + '</ul>';
            wireReplayButtons(container);
          })
          .catch((err) => {
            container.innerHTML =
              '<p class="text-sm text-red-700">Failed to load deliveries: ' +
              escapeHtml(err && err.message ? err.message : 'network error') +
              '</p>';
          });
      }

      function wireReplayButtons(scope) {
        const buttons = scope.querySelectorAll('[data-replay]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-replay');
            btn.disabled = true;
            btn.textContent = 'Replaying…';
            fetch(apiBaseUrl + '/v1/webhook-deliveries/' + encodeURIComponent(id) + '/replay', {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                'content-type': 'application/json',
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
              body: '{}',
            })
              .then((r) => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                btn.textContent = 'Replayed ✓';
                btn.classList.add('text-emerald-700');
              })
              .catch((err) => {
                btn.disabled = false;
                btn.textContent = 'Replay';
                showBanner('Replay failed: ' + (err && err.message ? err.message : 'network error'));
              });
          });
        });
      }

      function wireDeliveryToggles() {
        const buttons = ul.querySelectorAll('[data-toggle-deliveries]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-toggle-deliveries');
            const container = ul.querySelector('[data-deliveries="' + id + '"]');
            if (!container) return;
            const isHidden = container.classList.contains('hidden');
            if (isHidden) {
              container.classList.remove('hidden');
              btn.textContent = 'Hide delivery log';
              loadDeliveries(id, container);
            } else {
              container.classList.add('hidden');
              btn.textContent = 'View delivery log →';
            }
          });
        });
      }

      // V-351b — wire the Edit form.
      const editWrap = root.querySelector('[data-edit-wrap]');
      const editForm = root.querySelector('[data-edit-form]');
      const editCancel = root.querySelector('[data-edit-cancel]');
      const editSubmit = root.querySelector('[data-edit-submit]');
      const editError = root.querySelector('[data-edit-error]');
      const editIdEl = root.querySelector('[data-edit-id]');
      let editingEndpoint = null;

      function showEditError(msg) {
        if (!editError) return;
        editError.textContent = msg;
        editError.classList.remove('hidden');
      }
      function hideEdit() {
        if (editWrap) editWrap.classList.add('hidden');
        if (editForm) editForm.reset();
        if (editError) {
          editError.classList.add('hidden');
          editError.textContent = '';
        }
        editingEndpoint = null;
      }
      if (editCancel) editCancel.addEventListener('click', hideEdit);

      function startEdit(endpoint) {
        editingEndpoint = endpoint;
        if (editIdEl) editIdEl.textContent = endpoint.id;
        const urlInput = editForm.querySelector('input[name="url"]');
        const descInput = editForm.querySelector('input[name="description"]');
        const activeInput = editForm.querySelector('[data-edit-active]');
        if (urlInput) urlInput.value = endpoint.url;
        if (descInput) descInput.value = endpoint.description || '';
        if (activeInput) activeInput.checked = endpoint.active === true;
        // Pre-check the events the endpoint already subscribes to.
        const eventChecks = editForm.querySelectorAll('input[name="event"]');
        eventChecks.forEach((cb) => {
          cb.checked = (endpoint.events || []).includes(cb.value);
        });
        if (editWrap) editWrap.classList.remove('hidden');
        if (createWrap) createWrap.classList.add('hidden');
        editWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function wireEditButtons() {
        const buttons = ul.querySelectorAll('[data-edit]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-edit');
            if (!id) return;
            // Look up the full endpoint shape from the live data we
            // last rendered. Cheap re-fetch keeps the form in sync
            // with current state in case it changed since the last
            // render.
            fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(id), {
              headers: {
                authorization: 'Bearer ' + token,
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
            })
              .then((r) =>
                r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)),
              )
              .then((endpoint) => startEdit(endpoint))
              .catch((err) => {
                showBanner(
                  'Failed to load endpoint for edit: ' +
                    (err && err.message ? err.message : 'network error'),
                );
              });
          });
        });
      }

      if (editForm) {
        editForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!editingEndpoint) return;
          if (editError) {
            editError.classList.add('hidden');
            editError.textContent = '';
          }
          const fd = new FormData(editForm);
          const url = (fd.get('url') || '').toString().trim();
          const description = (fd.get('description') || '').toString().trim();
          const events = fd.getAll('event').map((v) => v.toString());
          const active = fd.get('active') === 'on';
          if (!url) {
            showEditError('URL is required.');
            return;
          }
          if (events.length === 0) {
            showEditError('Pick at least one event.');
            return;
          }
          if (editSubmit) {
            editSubmit.disabled = true;
            editSubmit.textContent = 'Saving…';
          }
          fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(editingEndpoint.id), {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
            body: JSON.stringify({
              url: url,
              events: events,
              description: description.length > 0 ? description : null,
              active: active,
            }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
            )
            .then(() => {
              hideEdit();
              window.location.reload();
            })
            .catch((err) => {
              showEditError(err && err.message ? err.message : 'Failed to save changes.');
              if (editSubmit) {
                editSubmit.disabled = false;
                editSubmit.textContent = 'Save changes';
              }
            });
        });
      }

      // V-347b — wire the per-row Delete buttons. DELETE
      // /v1/webhooks/:id is admin-only on team-scoped requests
      // (V-326e5); the act-as helper handles team scope.
      function wireDeleteButtons() {
        const buttons = ul.querySelectorAll('[data-delete]');
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete');
            if (!id) return;
            if (!window.confirm('Delete webhook endpoint ' + id + '? This cannot be undone.')) {
              return;
            }
            btn.disabled = true;
            btn.textContent = 'Deleting…';
            fetch(apiBaseUrl + '/v1/webhooks/' + encodeURIComponent(id), {
              method: 'DELETE',
              headers: {
                authorization: 'Bearer ' + token,
                ...(typeof window.driftstackActAsHeaders === 'function'
                  ? window.driftstackActAsHeaders()
                  : {}),
              },
            })
              .then((r) => {
                if (!r.ok && r.status !== 204) {
                  return r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
                }
                window.location.reload();
              })
              .catch((err) => {
                showBanner('Delete failed: ' + (err && err.message ? err.message : 'network error'));
                btn.disabled = false;
                btn.textContent = 'Delete';
              });
          });
        });
      }

      if (!token) {
        showBanner('Sign in to see live webhook endpoints. Showing preview data below.');
        return;
      }

      fetch(apiBaseUrl + '/v1/webhooks', {
        headers: { authorization: 'Bearer ' + token },
        credentials: 'include',
      })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
        .then((body) => {
          const endpoints = body.data || [];
          if (endpoints.length === 0) {
            ul.classList.add('hidden');
            empty.classList.remove('hidden');
          } else {
            empty.classList.add('hidden');
            ul.classList.remove('hidden');
            ul.innerHTML = endpoints.map(endpointCard).join('');
            wireDeliveryToggles();
            wireDeleteButtons();
            wireEditButtons();
          }
          showBanner(
            'Live data loaded. Aggregate delivery counts (delivered/failed/DLQ) not yet exposed via /v1/webhooks — coming soon.',
          );
        })
        .catch((err) => {
          showBanner(
            "Couldn't load live webhooks (" +
              (err && err.message ? err.message : 'network error') +
              '). Showing preview data below.',
          );
        });
    })();
  </script>
</DashboardLayout>
