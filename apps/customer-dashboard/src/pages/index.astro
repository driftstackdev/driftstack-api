---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-316 — wires the dashboard home page to live data. Replaces the
// V-099 mock-data scaffolding. Reads:
//   - GET /v1/account/me (account + concurrent caps + profile count)
//   - GET /v1/api-keys
//   - GET /v1/sessions
//   - GET /v1/billing
//   - GET /v1/usage (session-hours stat) + GET /v1/usage/series?days=14
//     (the 14-day mini chart; honest empty state while the V-014/V-015
//     usage_records writers are unwired and totals are all zero)
//   - GET /v1/team/members (onboarding "invite your team" step; the
//     account_owner gate 403s members/non-team tiers → step hidden)
//   - GET /v1/status (PUBLIC status pill — no Authorization header)
// Each call is independent; failures in one section don't blank the
// rest. Render is client-side so the dashboard server stays static
// (Astro's hybrid mode is intentionally avoided here).

import { resolveApiBaseUrl } from '../lib/api-base-url';
import { TIER_DISPLAY_NAMES } from '../data/mocks.ts';
import { ARCHETYPE_REGISTRY, archetypeDisplayLabel } from '@driftstack/api-types';
const apiBaseUrl = resolveApiBaseUrl();

// Friendly archetype labels (slug → "iPhone 17 / iOS 18.7 / Safari 26.4"),
// derived from the registry + injected into the client script so the active-
// session preview never shows a customer a raw slug.
const ARCHETYPE_LABELS = Object.fromEntries(
  ARCHETYPE_REGISTRY.map((a) => [a.id, archetypeDisplayLabel(a.id)]),
);
---

<DashboardLayout title="Overview">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="overview">
    {/* Fleet v2 (2026-07-02) — calm accent-token backdrop (the old
        hard-coded brand-red radials are retired; ambience follows the
        data-accent axis at low alpha). */}
    <div
      class="relative -mx-6 -mt-10 mb-6 overflow-hidden px-6 pb-8 pt-10"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 -z-10"
        style="background: radial-gradient(ellipse 60% 80% at 0% 0%, var(--accent-soft), transparent 70%);"
      ></div>
      <header class="relative flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-sm text-tk-ink-3">Welcome back</p>
          <h1
            data-account-name
            class="mt-1 truncate text-3xl font-semibold tracking-tight text-tk-ink"
          >
            —
          </h1>
        </div>
        <div class="flex items-center gap-3">
          {/* Fleet v2 (2026-07-02) — platform-status pill. Hydrated from the
              PUBLIC GET /v1/status (no Authorization header); stays hidden
              on fetch failure (fail-open, matching the endpoint's posture). */}
          <a
            data-status-widget
            href="https://status.driftstack.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center gap-1.5 rounded-full border border-tk-border bg-tk-surface px-2.5 py-1 text-xs text-tk-ink-2 hover:text-tk-ink"
          >
            <span data-status-dot class="status-dot status-dot--ready"></span>
            <span data-status-text>—</span>
          </a>
          <span
            data-account-tier
            class="rounded-full border border-tk-accent/30 bg-tk-accent/10 px-3 py-1 text-xs font-medium uppercase tracking-wide text-tk-accent-text"
          >
            —
          </span>
          <a
            href="https://docs.driftstack.dev/quickstart/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Get the app
          </a>
        </div>
      </header>
    </div>

    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-busy/30 bg-tk-busy/10 px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    {/* Fleet v2 (2026-07-02) — onboarding checklist, mirroring the desktop
        app's FirstRunWizard order: get the app → connect it (sign-in mints
        an API key via /cli/authorize, or paste one from /api-keys) → run a
        first session → invite the team. Steps derive from the fetches this
        page already makes (+ /v1/team/members, hidden on 403 for non-team
        tiers). Auto-hides once every visible step is done, or on dismiss
        (localStorage ds_onboarding_dismissed). */}
    <section data-onboarding class="panel mb-6 hidden">
      <h2 class="panel-title">
        Get set up
        <span class="flex-1"></span>
        <button
          type="button"
          data-onboarding-dismiss
          class="text-xs font-normal text-tk-ink-3 hover:text-tk-ink"
        >
          Dismiss
        </button>
      </h2>
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <li data-onboarding-step="app" class="flex items-start gap-2.5 text-sm">
          <span data-step-marker class="badge-count mt-0.5">1</span>
          <span>
            <a
              href="https://docs.driftstack.dev/quickstart/"
              target="_blank"
              rel="noopener noreferrer"
              data-onboarding-app-link
              class="font-medium text-tk-ink hover:text-tk-accent-text">Get the desktop app</a
            >
            <span class="mt-0.5 block text-xs text-tk-ink-3">Sessions are driven there.</span>
          </span>
        </li>
        <li data-onboarding-step="key" class="flex items-start gap-2.5 text-sm">
          <span data-step-marker class="badge-count mt-0.5">2</span>
          <span>
            <a href="/api-keys/" class="font-medium text-tk-ink hover:text-tk-accent-text"
              >Connect the app</a
            >
            <span class="mt-0.5 block text-xs text-tk-ink-3"
              >Sign in from the app, or paste an API key.</span
            >
          </span>
        </li>
        <li data-onboarding-step="session" class="flex items-start gap-2.5 text-sm">
          <span data-step-marker class="badge-count mt-0.5">3</span>
          <span>
            <span class="font-medium text-tk-ink">Run your first session</span>
            <span class="mt-0.5 block text-xs text-tk-ink-3">An iPhone, on demand.</span>
          </span>
        </li>
        <li data-onboarding-step="team" class="hidden items-start gap-2.5 text-sm">
          <span data-step-marker class="badge-count mt-0.5">4</span>
          <span>
            <a href="/team/" class="font-medium text-tk-ink hover:text-tk-accent-text"
              >Invite your team</a
            >
            <span class="mt-0.5 block text-xs text-tk-ink-3">Roles + seats.</span>
          </span>
        </li>
      </ol>
    </section>

    {/* Fleet v2 (2026-07-02) — founder-locked stat row: Active sessions
        (with cap meter — per ADR-004 the concurrent cap is the ONLY
        meter) · Profiles · Session hours this cycle (total, no cap) ·
        Plan. The API-keys count moved into the Mint-API-key quick
        action below. */}
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="stat-card">
        <p class="stat-label">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
          Active sessions
        </p>
        <p class="stat-value">
          <span data-stat-concurrent>—</span><span class="text-base font-normal text-tk-ink-3">
            / <span data-stat-concurrent-cap>—</span></span
          >
        </p>
        <div class="meter"><span data-stat-concurrent-meter class="meter-fill" style="width: 0%"></span></div>
        <p class="stat-sub">running now · concurrent cap is the only meter</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4" />
            <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
          </svg>
          Profiles
        </p>
        <p class="stat-value">
          <span data-stat-profiles>—</span><span
            data-stat-profiles-cap
            class="text-base font-normal text-tk-ink-3"></span>
        </p>
        <div class="meter"><span data-stat-profiles-meter class="meter-fill" style="width: 0%"></span></div>
        <p class="stat-sub">saved identities</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
          </svg>
          Session hours
        </p>
        <p class="stat-value"><span data-stat-hours>—</span></p>
        <p class="stat-sub">this billing cycle</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <path d="M2 10h20" />
          </svg>
          Plan
        </p>
        <p class="stat-value"><span data-stat-plan>—</span></p>
        <p data-stat-plan-sub class="stat-sub">&nbsp;</p>
      </div>
    </section>

    {/* 2026-05-22 — quick actions row. Surfaces the four most-
        common operations as full-card buttons so a customer landing
        on the dashboard can act in one click without hunting in
        the side nav. */}
    {/* Your-data-is-sealed trust surface (demo-concepts arc, 2026-06-12).
        Every claim mirrors the verified architecture: sealed client-encrypted
        profiles (profile-store), per-tenant cryptographic key isolation,
        audited secret access. Static truth — no API call needed. */}
    <section class="mt-10 rounded-xl border border-tk-border bg-gradient-to-br from-tk-accent/5 to-transparent p-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        </span>
        <div>
          <h2 class="text-lg font-semibold text-tk-ink">Your data is sealed</h2>
          <p class="text-sm text-tk-ink-2">
            Profiles are client-encrypted — Driftstack moves opaque bytes and can't read them.
          </p>
        </div>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-tk-border bg-tk-surface p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">Profile encryption</p>
          <p class="mt-1.5 text-sm font-semibold text-tk-ink">AES-256-GCM, sealed</p>
          <p class="mt-1 text-xs leading-relaxed text-tk-ink-3">
            Encrypted before it reaches us; the server stores ciphertext only.
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">Tenant isolation</p>
          <p class="mt-1.5 text-sm font-semibold text-tk-ink">Cryptographic</p>
          <p class="mt-1 text-xs leading-relaxed text-tk-ink-3">
            A wrong account cannot decrypt your data — enforced by math, not policy.
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-4">
          <p class="font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">Secret access</p>
          <p class="mt-1.5 text-sm font-semibold text-tk-ink">Always audited</p>
          <p class="mt-1 text-xs leading-relaxed text-tk-ink-3">
            Every credential read lands in your <a href="/audit-log/" class="text-tk-accent-text underline">audit log</a>.
          </p>
        </div>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        Full model at
        <a href="https://driftstack.dev/trust/security-overview/" class="text-tk-accent-text underline">driftstack.dev/trust</a>
        · your data, your call — export or delete anytime from
        <a href="/settings/" class="text-tk-accent-text underline">Settings</a>.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </span>
        Quick actions
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href="https://docs.driftstack.dev/quickstart/"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-tk-border bg-tk-surface p-4 hover:border-tk-accent/40 hover:bg-tk-surface/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-tk-accent/10 text-tk-accent">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
              </svg>
            </span>
            <p class="font-medium text-tk-ink">Get the app</p>
          </div>
          <p class="mt-2 text-xs text-tk-ink-3">Launch iPhone sessions from the desktop app.</p>
        </a>
        <a
          href="/team/"
          class="group rounded-lg border border-tk-border bg-tk-surface p-4 hover:border-tk-accent/40 hover:bg-tk-surface/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-tk-accent/10 text-tk-accent">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </span>
            <p class="font-medium text-tk-ink">Invite your team</p>
          </div>
          <p class="mt-2 text-xs text-tk-ink-3">Share access with roles + seats.</p>
        </a>
        <a
          href="/api-keys/"
          class="group rounded-lg border border-tk-border bg-tk-surface p-4 hover:border-tk-accent/40 hover:bg-tk-surface/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-tk-accent/10 text-tk-accent">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="12" r="7" />
                <path d="M16 12h6M19 9v6" />
              </svg>
            </span>
            <p class="font-medium text-tk-ink">Mint API key</p>
          </div>
          <p class="mt-2 text-xs text-tk-ink-3">
            For SDK + CLI integrations. <span data-stat-api-keys>—</span> active.
          </p>
        </a>
        <a
          href="https://docs.driftstack.dev/quickstart/"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-tk-border bg-tk-surface p-4 hover:border-tk-accent/40 hover:bg-tk-surface/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-tk-accent/10 text-tk-accent">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
            </span>
            <p class="font-medium text-tk-ink">Read the quickstart</p>
          </div>
          <p class="mt-2 text-xs text-tk-ink-3">10-min walkthrough on docs.</p>
        </a>
      </div>
    </section>

    {/* Fleet v2 (2026-07-02) — blueprint row2: read-only session
        visibility (left; sessions are DRIVEN in the desktop app) +
        14-day usage mini chart and plan panel (right). */}
    <section class="mt-10 grid gap-4 lg:grid-cols-[1.5fr_1fr]">
      <div class="panel">
        <h2 class="panel-title">
          Active sessions
          <span class="flex-1"></span>
          <span class="text-xs font-normal text-tk-ink-3">Drive sessions in the desktop app</span>
        </h2>
        <div data-sessions-empty class="hidden text-sm text-tk-ink-3">
          No sessions running right now.
        </div>
        <ul
          data-sessions-list
          class="hidden divide-y divide-tk-border rounded-lg border border-tk-border bg-tk-surface"
        >
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <div class="panel">
          <h2 class="panel-title">Session hours · last 14 days</h2>
          {/* Dependency-free bar chart (blueprint recipe): the script fills
              [data-usage-chart] with height-percentage bars from
              /v1/usage/series. All-zero series (the expected prod state
              until the V-014/V-015 usage writers land) renders the honest
              empty state instead of a fabricated flat line. */}
          <div data-usage-chart class="hidden h-[90px] items-end gap-1.5" aria-hidden="true"></div>
          <div data-usage-legend class="mt-2 hidden justify-between text-[11px] text-tk-ink-3"></div>
          <div data-usage-empty class="hidden text-sm text-tk-ink-3">
            No usage recorded this period yet.
          </div>
        </div>
        <div class="panel">
          <h2 class="panel-title">Plan</h2>
          <div data-subscription-empty class="hidden text-sm text-tk-ink-3">
            No active subscription. <a href="/select-tier/" class="text-tk-accent-text hover:underline">Pick a tier →</a>
          </div>
          <div data-subscription-card class="hidden">
            <p
              data-subscription-line
              class="font-mono text-xs uppercase tracking-widest text-tk-ink-3"
            >
            </p>
            <p data-subscription-period class="mt-3 text-sm text-tk-ink-2"></p>
            <a href="/billing/" class="btn-secondary mt-4 inline-flex w-full justify-center">Manage billing</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script
    is:inline
    define:vars={{
      apiBaseUrl,
      tierDisplayNames: TIER_DISPLAY_NAMES,
      archetypeLabels: ARCHETYPE_LABELS,
    }}
  >
    (function () {
      const root = document.querySelector('[data-page="overview"]');
      if (!root) return;
      const OVERVIEW_TIMEOUT_MS = 15_000;

      function boundedFetch(url, init = {}) {
        return window.driftstackFetchWithDeadline(url, init, OVERVIEW_TIMEOUT_MS);
      }

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function showBanner(msg) {
        const b = root.querySelector('[data-banner]');
        if (!b) return;
        b.textContent = msg;
        b.classList.remove('hidden');
      }

      // Fleet v2 (2026-07-02) — per-status badge classes on the two-axis
      // status tokens (ready/busy/err flip with data-mode, unlike the old
      // hard-coded emerald/blue/red Tailwind literals that broke in light
      // mode). The 5-value catalog matches the SessionStatus union —
      // creating / ready / busy / destroyed / errored — and must stay
      // complete: an uncatalogued status would render unstyled.
      const STATUS_BADGE_CLASS = {
        creating: 'bg-tk-accent/10 text-tk-accent-text',
        ready: 'bg-tk-ready/10 text-tk-ready-text',
        busy: 'bg-tk-busy/10 text-tk-busy-text',
        destroyed: 'bg-tk-hover text-tk-ink-2',
        errored: 'bg-tk-err/10 text-tk-err-text',
      };

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }

      function fmtIsoDay(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }

      // Map the backend tier id to its human plan name (Personal / Team /
      // Agency / API Starter …) so the customer never sees a raw id like
      // "solo_manual". Falls back to the id if an unknown tier appears.
      function tierLabel(t) {
        return (t && tierDisplayNames[t]) || t || '—';
      }

      // Map an archetype slug to its friendly label via the injected registry
      // map; em-dash for a session with no archetype, raw slug if unknown.
      function archetypeLabel(slug) {
        if (!slug) return '—';
        return (archetypeLabels && archetypeLabels[slug]) || slug;
      }

      const token = getToken();
      if (!token) {
        // 2026-05-19 — dashboard hard-redirects to /login when there's
        // no session token, instead of rendering a "Sign in to see
        // live account data" banner over the page's placeholder
        // mock-data UI. Mock-data UI is a development affordance only;
        // production-side it reads as broken to unauthed visitors.
        const next = encodeURIComponent(window.location.pathname + window.location.search);
        window.location.replace('/login/?next=' + next);
        return;
      }
      // Fleet v2 (2026-07-02) — post-checkout landing. /select-tier's
      // Stripe success_url returns the customer to /?subscribed=<tier>
      // (the old /first-session landing was retired with the
      // account-portal IA); greet the new subscription inline.
      try {
        const sub = new URLSearchParams(location.search).get('subscribed');
        if (sub) {
          showBanner(
            'Your ' + tierLabel(sub) + ' subscription is active — welcome aboard. ' +
              'Install the desktop app to start your first session.',
          );
        }
      } catch (_) {
        /* greeting is best-effort */
      }

      // Fleet v2 (2026-07-02) — onboarding checklist state. Mirrors the
      // desktop FirstRunWizard order (app → connect → session → team).
      // null = not yet known; the panel renders once key+session settle so
      // there is no flash for fully-onboarded accounts. 'app' is not
      // server-verifiable — a click on the download link marks it done
      // (localStorage ds_onboarding_app_clicked).
      const onboarding = { app: false, key: null, session: null, team: null };
      let onboardingDismissed = false;
      try {
        onboarding.app = localStorage.getItem('ds_onboarding_app_clicked') === '1';
        onboardingDismissed = localStorage.getItem('ds_onboarding_dismissed') === '1';
      } catch (_) {
        /* defaults */
      }

      function renderOnboarding() {
        const panel = root.querySelector('[data-onboarding]');
        if (!panel) return;
        if (onboardingDismissed) {
          panel.classList.add('hidden');
          return;
        }
        // Wait for the server-derived steps before first paint.
        if (onboarding.key === null || onboarding.session === null) return;
        const done = { app: onboarding.app, key: onboarding.key, session: onboarding.session };
        const teamKnown = onboarding.team !== null;
        if (teamKnown) done.team = onboarding.team;
        for (const step of ['app', 'key', 'session', 'team']) {
          const li = panel.querySelector('[data-onboarding-step="' + step + '"]');
          if (!li) continue;
          if (step === 'team') {
            if (!teamKnown) continue; // stays hidden (403 / non-team tier)
            li.classList.remove('hidden');
            li.classList.add('flex');
          }
          const marker = li.querySelector('[data-step-marker]');
          if (marker && done[step]) {
            marker.textContent = '✓';
            marker.classList.add('bg-tk-ready/15', 'text-tk-ready-text');
            li.setAttribute('data-step-done', 'true');
          }
        }
        const allDone = Object.keys(done).every(function (k) {
          return done[k];
        });
        panel.classList.toggle('hidden', allDone);
      }

      const onboardingDismissBtn = root.querySelector('[data-onboarding-dismiss]');
      if (onboardingDismissBtn) {
        onboardingDismissBtn.addEventListener('click', function () {
          onboardingDismissed = true;
          try {
            localStorage.setItem('ds_onboarding_dismissed', '1');
          } catch (_) {
            /* session-only dismiss */
          }
          renderOnboarding();
        });
      }
      const onboardingAppLink = root.querySelector('[data-onboarding-app-link]');
      if (onboardingAppLink) {
        onboardingAppLink.addEventListener('click', function () {
          onboarding.app = true;
          try {
            localStorage.setItem('ds_onboarding_app_clicked', '1');
          } catch (_) {
            /* session-only */
          }
          renderOnboarding();
        });
      }

      // V-331 — pick up the X-Driftstack-Account header from the
      // shared helper installed by DashboardLayout. Self-scope returns
      // {} so the request behaves identically when not "acting as".
      const actAs =
        typeof window.driftstackActAsHeaders === 'function'
          ? window.driftstackActAsHeaders()
          : {};
      const headers = {
        Authorization: 'Bearer ' + token,
        accept: 'application/json',
        ...actAs,
      };

      async function getJson(path) {
        let r;
        try {
          r = await boundedFetch(apiBaseUrl + path, { headers });
        } catch (err) {
          if (err && err.name === 'AbortError') {
            throw new Error('Request timed out. Try again.');
          }
          throw err;
        }
        if (!r.ok) {
          // Surface the server's problem+json `detail` (W151/W152 baseline)
          // rather than the internal path + raw status, so a visible
          // failure reads as a human message ("Your session has expired.")
          // instead of "/v1/account/me returned 500".
          const b = await r.json().catch(function () {
            return {};
          });
          throw window.driftstackResponseError(r, b);
        }
        return r.json();
      }

      // ─── /v1/account/me ────────────────────────────────────────────────
      getJson('/v1/account/me')
        .then(function (me) {
          const nameEl = root.querySelector('[data-account-name]');
          if (nameEl) nameEl.textContent = me.name || me.email || '—';
          const tierEl = root.querySelector('[data-account-tier]');
          if (tierEl) tierEl.textContent = tierLabel(me.tier);

          const concurrent = root.querySelector('[data-stat-concurrent]');
          if (concurrent) concurrent.textContent = String(me.concurrent_session_active ?? 0);
          const concurrentCap = root.querySelector('[data-stat-concurrent-cap]');
          if (concurrentCap) concurrentCap.textContent = String(me.concurrent_session_cap ?? '—');

          const profiles = root.querySelector('[data-stat-profiles]');
          if (profiles) profiles.textContent = String(me.profile_count ?? 0);
          const profilesCap = root.querySelector('[data-stat-profiles-cap]');
          if (profilesCap && me.profile_cap != null) profilesCap.textContent = ' / ' + me.profile_cap;

          // Fleet v2 — cap meters. Width clamps to [0,100]; a missing or
          // zero cap leaves the track empty rather than dividing by zero.
          function setMeter(sel, active, cap) {
            const el = root.querySelector(sel);
            if (!el) return;
            const a = Number(active);
            const c = Number(cap);
            if (!isFinite(a) || !isFinite(c) || c <= 0) return;
            el.style.width = Math.max(0, Math.min(100, (a / c) * 100)) + '%';
          }
          setMeter(
            '[data-stat-concurrent-meter]',
            me.concurrent_session_active,
            me.concurrent_session_cap,
          );
          setMeter('[data-stat-profiles-meter]', me.profile_count, me.profile_cap);

          // Fleet v2 — plan stat card (tier from /v1/account/me; the
          // status sub-line hydrates from /v1/billing below).
          const planEl = root.querySelector('[data-stat-plan]');
          if (planEl) planEl.textContent = tierLabel(me.tier);
        })
        .catch(function (err) {
          showBanner(
            'Could not load your account: ' +
              window.driftstackRequestErrorMessage(
                err,
                'Could not load your account. Try again.',
              ),
          );
        })
        .finally(function () {
          // 2026-05-21 — DashboardLayout opacity-gate signal. The Overview
          // fans out 4 parallel fetches (account/me, api-keys, sessions,
          // billing); /v1/account/me is the primary one driving the
          // headline stats, so we reveal as soon as it resolves rather
          // than waiting for all four.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // ─── /v1/api-keys ──────────────────────────────────────────────────
      getJson('/v1/api-keys')
        .then(function (resp) {
          const keys = Array.isArray(resp.data) ? resp.data : [];
          const active = keys.filter(function (k) {
            return !k.revoked_at;
          }).length;
          const el = root.querySelector('[data-stat-api-keys]');
          if (el) el.textContent = String(active);
          // Onboarding: any active key = the app can connect (the browser
          // sign-in mints one; manual paste requires one).
          onboarding.key = active > 0;
          renderOnboarding();
        })
        .catch(function () {
          onboarding.key = false;
          renderOnboarding();
        });

      // ─── /v1/sessions ──────────────────────────────────────────────────
      getJson('/v1/sessions')
        .then(function (resp) {
          const all = Array.isArray(resp.data) ? resp.data : [];
          // Onboarding: ANY session ever (terminal ones included) counts as
          // "ran a first session"; non-zero usage below also satisfies it.
          onboarding.session = onboarding.session === true || all.length > 0;
          renderOnboarding();
          const active = all.filter(function (s) {
            return s.status !== 'destroyed' && s.status !== 'errored';
          });
          const empty = root.querySelector('[data-sessions-empty]');
          const list = root.querySelector('[data-sessions-list]');
          if (active.length === 0) {
            if (empty) empty.classList.remove('hidden');
            return;
          }
          if (!list) return;
          list.classList.remove('hidden');
          const html = active
            .slice(0, 5)
            .map(function (s) {
              return (
                '<li class="flex items-center justify-between px-6 py-4">' +
                '<div class="min-w-0">' +
                '<p class="font-mono text-sm text-tk-ink">' +
                escapeHtml(s.id) +
                '</p>' +
                '<p class="mt-1 text-xs text-tk-ink-3">' +
                escapeHtml(archetypeLabel(s.archetype)) +
                ' · started ' +
                escapeHtml(fmtIsoDay(s.created_at)) +
                '</p></div>' +
                '<span class="rounded-full px-2 py-1 text-xs font-medium uppercase tracking-wide ' +
                (STATUS_BADGE_CLASS[s.status] || STATUS_BADGE_CLASS.ready) +
                '">' +
                escapeHtml(s.status || '—') +
                '</span></li>'
              );
            })
            .join('');
          list.innerHTML = html;
        })
        .catch(function () {
          onboarding.session = onboarding.session === true;
          renderOnboarding();
          const empty = root.querySelector('[data-sessions-empty]');
          if (empty) {
            empty.textContent = 'Could not load sessions.';
            empty.classList.remove('hidden');
          }
        });

      // ─── /v1/billing ───────────────────────────────────────────────────
      getJson('/v1/billing')
        .then(function (b) {
          const sub = b.subscription;
          const empty = root.querySelector('[data-subscription-empty]');
          const card = root.querySelector('[data-subscription-card]');
          const planSub = root.querySelector('[data-stat-plan-sub]');
          if (sub) {
            if (card) card.classList.remove('hidden');
            const line = root.querySelector('[data-subscription-line]');
            if (line) line.textContent = tierLabel(sub.tier) + ' · ' + String(sub.status);
            const period = root.querySelector('[data-subscription-period]');
            if (period) period.textContent = 'Period ends ' + fmtIsoDay(sub.current_period_end) + '.';
            if (planSub) planSub.textContent = String(sub.status);
          } else {
            if (empty) empty.classList.remove('hidden');
            if (planSub) planSub.textContent = 'free plan';
          }
        })
        .catch(function () {
          const empty = root.querySelector('[data-subscription-empty]');
          if (empty) {
            empty.textContent = 'Could not load billing.';
            empty.classList.remove('hidden');
          }
        });

      // ─── /v1/usage ─────────────────────────────────────────────────────
      // Session-hours stat: the period's session_minute total. Honest
      // zero — 0.0 h is the expected prod state until the V-014/V-015
      // usage_records writers land.
      getJson('/v1/usage')
        .then(function (u) {
          // UsagePeriodSummary is a flat object: { period_start, period_end,
          // tier, totals: { session_minute, ... } }.
          const totals = (u && u.totals) || {};
          const minutes = Number(totals.session_minute);
          const el = root.querySelector('[data-stat-hours]');
          if (el) el.textContent = isFinite(minutes) ? (minutes / 60).toFixed(1) + ' h' : '0.0 h';
          // Onboarding: recorded usage also proves a first session ran.
          if (isFinite(minutes) && minutes > 0) {
            onboarding.session = true;
            renderOnboarding();
          }
        })
        .catch(function () {
          /* leave dash */
        });

      // ─── /v1/usage/series?days=14 ──────────────────────────────────────
      // 14-day mini chart (blueprint recipe: percentage-height divs, no
      // chart lib). All-zero series → the honest empty state.
      getJson('/v1/usage/series?days=14')
        .then(function (s) {
          // UsageSeriesResponse: { from_date, to_date, buckets: [{ date,
          // totals }] } — one contiguous bucket per UTC day.
          const buckets = s && Array.isArray(s.buckets) ? s.buckets : [];
          const chart = root.querySelector('[data-usage-chart]');
          const legend = root.querySelector('[data-usage-legend]');
          const empty = root.querySelector('[data-usage-empty]');
          const values = buckets.map(function (b) {
            const t = (b && b.totals) || {};
            const v = Number(t.session_minute);
            return isFinite(v) && v > 0 ? v : 0;
          });
          const max = values.reduce(function (m, v) {
            return v > m ? v : m;
          }, 0);
          if (!buckets.length || max <= 0) {
            if (empty) empty.classList.remove('hidden');
            return;
          }
          if (!chart) return;
          chart.classList.remove('hidden');
          chart.classList.add('flex');
          chart.innerHTML = values
            .map(function (v) {
              const pct = Math.max(2, Math.min(100, Math.round((v / max) * 100)));
              return (
                '<span class="flex-1 rounded-t bg-tk-accent/80" style="height: ' + pct + '%"></span>'
              );
            })
            .join('');
          if (legend && buckets.length > 1) {
            legend.classList.remove('hidden');
            legend.classList.add('flex');
            const first = buckets[0] && buckets[0].date;
            const last = buckets[buckets.length - 1] && buckets[buckets.length - 1].date;
            legend.innerHTML =
              '<span>' + escapeHtml(first || '—') + '</span><span>' +
              escapeHtml(last || '—') + '</span>';
          }
        })
        .catch(function () {
          const empty = root.querySelector('[data-usage-empty]');
          if (empty) {
            empty.textContent = 'Could not load usage history.';
            empty.classList.remove('hidden');
          }
        });

      // ─── /v1/team/members ──────────────────────────────────────────────
      // Onboarding "invite your team" step. account_owner-gated: members
      // on someone else's team + non-team tiers get 403 → the catch leaves
      // onboarding.team null and the step stays hidden.
      getJson('/v1/team/members')
        .then(function (resp) {
          const members = Array.isArray(resp.data) ? resp.data : [];
          onboarding.team = members.length > 1;
          renderOnboarding();
        })
        .catch(function () {
          onboarding.team = null;
          renderOnboarding();
        });

      // ─── /v1/status (PUBLIC — no Authorization header) ─────────────────
      // Platform-status pill. Fail-open: any error leaves it hidden, the
      // same posture as the endpoint itself.
      boundedFetch(apiBaseUrl + '/v1/status', { headers: { accept: 'application/json' } })
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (s) {
          if (!s || !s.overall_status) return;
          const widget = root.querySelector('[data-status-widget]');
          const dot = root.querySelector('[data-status-dot]');
          const textEl = root.querySelector('[data-status-text]');
          if (!widget || !dot || !textEl) return;
          const LABEL = {
            operational: 'All systems operational',
            degraded: 'Degraded performance',
            major_outage: 'Major outage',
          };
          const DOT = {
            operational: 'status-dot--ready',
            degraded: 'status-dot--busy',
            major_outage: 'status-dot--err',
          };
          let label = LABEL[s.overall_status] || String(s.overall_status);
          const incidents = Array.isArray(s.recent_incidents) ? s.recent_incidents.length : 0;
          if (incidents > 0) {
            label += ' · ' + incidents + ' recent incident' + (incidents > 1 ? 's' : '');
          }
          dot.classList.remove('status-dot--ready', 'status-dot--busy', 'status-dot--err');
          dot.classList.add(DOT[s.overall_status] || 'status-dot--busy');
          textEl.textContent = label;
          widget.classList.remove('hidden');
          widget.classList.add('inline-flex');
        })
        .catch(function () {
          /* fail-open — pill stays hidden */
        });
    })();
  </script>
</DashboardLayout>
