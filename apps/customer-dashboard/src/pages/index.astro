---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import {
  MOCK_ACCOUNT,
  MOCK_API_KEYS,
  MOCK_PROFILES,
  MOCK_SUBSCRIPTION,
  MOCK_USAGE_SUMMARY,
  MOCK_SESSIONS,
} from '../data/mocks.ts';

// V-099 scaffolding only: mock data on the page. Real reads against
// /v1/billing, /v1/profiles, /v1/api-keys, /v1/sessions, /v1/usage
// land when the dashboard moves past scaffolding.

const activeSessions = MOCK_SESSIONS.filter((s) => s.status !== 'destroyed' && s.status !== 'errored');
---

<DashboardLayout title="Overview">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-10 flex items-center justify-between">
      <div>
        <p class="text-sm text-slate-500">Welcome back</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">
          {MOCK_ACCOUNT.name ?? MOCK_ACCOUNT.email}
        </h1>
      </div>
      <span class="rounded-full bg-oxblood-50 px-3 py-1 text-xs font-medium uppercase tracking-wide text-oxblood-700">
        {MOCK_ACCOUNT.tier}
      </span>
    </header>

    <section class="grid gap-6 md:grid-cols-3">
      <div class="dashboard-card">
        <p class="text-xs font-mono uppercase tracking-widest text-slate-500">Concurrent now</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">
          {MOCK_USAGE_SUMMARY.concurrent_now}
          <span class="text-base font-normal text-slate-500">/ {MOCK_USAGE_SUMMARY.concurrent_limit}</span>
        </p>
        <p class="mt-1 text-sm text-slate-500">live sessions in flight</p>
      </div>
      <div class="dashboard-card">
        <p class="text-xs font-mono uppercase tracking-widest text-slate-500">Profiles</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">{MOCK_PROFILES.length}</p>
        <p class="mt-1 text-sm text-slate-500">persistent identity slots</p>
      </div>
      <div class="dashboard-card">
        <p class="text-xs font-mono uppercase tracking-widest text-slate-500">API keys</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">{MOCK_API_KEYS.length}</p>
        <p class="mt-1 text-sm text-slate-500">active keys</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-slate-900">Active sessions</h2>
      {activeSessions.length === 0 ? (
        <p class="mt-3 text-sm text-slate-500">No sessions running right now.</p>
      ) : (
        <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
          {activeSessions.map((s) => (
            <li class="flex items-center justify-between px-6 py-4">
              <div>
                <p class="font-mono text-sm text-slate-900">{s.id}</p>
                <p class="mt-1 text-xs text-slate-500">{s.archetype} · started {new Date(s.created_at).toISOString()}</p>
              </div>
              <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium uppercase tracking-wide text-emerald-700">
                {s.status}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-slate-900">Subscription</h2>
      {MOCK_SUBSCRIPTION ? (
        <div class="dashboard-card mt-4">
          <p class="font-mono text-xs uppercase tracking-widest text-slate-500">{MOCK_SUBSCRIPTION.tier} · {MOCK_SUBSCRIPTION.status}</p>
          <p class="mt-3 text-sm text-slate-600">
            Period ends {MOCK_SUBSCRIPTION.current_period_end ? new Date(MOCK_SUBSCRIPTION.current_period_end).toISOString().slice(0, 10) : '—'}.
          </p>
          <a href="/billing" class="btn-secondary mt-4 inline-flex">Manage billing</a>
        </div>
      ) : (
        <p class="mt-3 text-sm text-slate-500">No active subscription.</p>
      )}
    </section>
  </div>
</DashboardLayout>
