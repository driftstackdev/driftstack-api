---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-316 — wires the dashboard home page to live data. Replaces the
// V-099 mock-data scaffolding. Reads:
//   - GET /v1/account/me (account + concurrent caps + profile count)
//   - GET /v1/api-keys
//   - GET /v1/sessions
//   - GET /v1/billing
// Each call is independent; failures in one section don't blank the
// rest. Render is client-side so the dashboard server stays static
// (Astro's hybrid mode is intentionally avoided here).

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Overview">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="overview">
    {/* 2026-05-22 — overview header gets a soft glow-red gradient
        backdrop. Visual depth without distracting from the data
        below. */}
    <div
      class="relative -mx-6 -mt-10 mb-6 overflow-hidden px-6 pb-8 pt-10"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 -z-10"
        style="background: radial-gradient(ellipse 60% 80% at 0% 0%, rgba(220, 38, 38, 0.10), transparent 70%), radial-gradient(ellipse 50% 70% at 100% 50%, rgba(220, 38, 38, 0.05), transparent 70%);"
      ></div>
      <header class="relative flex items-center justify-between gap-6">
        <div class="min-w-0">
          <p class="text-sm text-ink-muted">Welcome back</p>
          <h1
            data-account-name
            class="mt-1 truncate bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-3xl font-semibold tracking-tight text-transparent"
          >
            —
          </h1>
        </div>
        <span
          data-account-tier
          class="rounded-full border border-glow-red/30 bg-glow-red/10 px-3 py-1 text-xs font-medium uppercase tracking-wide text-glow-red"
        >
          —
        </span>
      </header>
    </div>

    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-glow-red/30 bg-glow-red/10 px-4 py-3 text-sm text-amber-800"
      role="status"
    >
    </div>

    {/* 2026-05-22 — icons on each stat card for visual anchor.
        Same glow-red square mark used across marketing surface. */}
    <section class="grid gap-6 md:grid-cols-3">
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-muted">Concurrent sessions</p>
          <div class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red ring-1 ring-glow-red/30">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <path d="M8 21h8M12 17v4" />
            </svg>
          </div>
        </div>
        <p class="mt-3 text-3xl font-semibold text-ink-primary">
          <span data-stat-concurrent>—</span>
          <span class="text-base font-normal text-ink-muted">
            / <span data-stat-concurrent-cap>—</span>
          </span>
        </p>
        <p class="mt-1 text-sm text-ink-muted">running now</p>
      </div>
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-muted">Profiles</p>
          <div class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red ring-1 ring-glow-red/30">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="7" r="4" />
              <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
            </svg>
          </div>
        </div>
        <p class="mt-3 text-3xl font-semibold text-ink-primary">
          <span data-stat-profiles>—</span>
          <span data-stat-profiles-cap class="text-base font-normal text-ink-muted"></span>
        </p>
        <p class="mt-1 text-sm text-ink-muted">saved identities</p>
      </div>
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="text-xs font-mono uppercase tracking-widest text-ink-muted">API keys</p>
          <div class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red ring-1 ring-glow-red/30">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="12" r="7" />
              <path d="M16 12h6M19 9v6" />
            </svg>
          </div>
        </div>
        <p class="mt-3 text-3xl font-semibold text-ink-primary"><span data-stat-api-keys>—</span></p>
        <p class="mt-1 text-sm text-ink-muted">active</p>
      </div>
    </section>

    {/* 2026-05-22 — quick actions row. Surfaces the four most-
        common operations as full-card buttons so a customer landing
        on the dashboard can act in one click without hunting in
        the side nav. */}
    <section class="mt-10">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-primary">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </span>
        Quick actions
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href="/agent-sessions"
          class="group rounded-lg border border-white/10 bg-surface-raised p-4 hover:border-glow-red/40 hover:bg-surface-raised/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
              </svg>
            </span>
            <p class="font-medium text-ink-primary">Start an AI session</p>
          </div>
          <p class="mt-2 text-xs text-ink-muted">Plain-English task → agent runs it.</p>
        </a>
        <a
          href="/profiles"
          class="group rounded-lg border border-white/10 bg-surface-raised p-4 hover:border-glow-red/40 hover:bg-surface-raised/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="7" r="4" />
                <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
              </svg>
            </span>
            <p class="font-medium text-ink-primary">New profile</p>
          </div>
          <p class="mt-2 text-xs text-ink-muted">Create a reusable browser identity.</p>
        </a>
        <a
          href="/api-keys"
          class="group rounded-lg border border-white/10 bg-surface-raised p-4 hover:border-glow-red/40 hover:bg-surface-raised/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="12" r="7" />
                <path d="M16 12h6M19 9v6" />
              </svg>
            </span>
            <p class="font-medium text-ink-primary">Mint API key</p>
          </div>
          <p class="mt-2 text-xs text-ink-muted">For SDK + CLI integrations.</p>
        </a>
        <a
          href="https://docs.driftstack.dev/quickstart/"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-white/10 bg-surface-raised p-4 hover:border-glow-red/40 hover:bg-surface-raised/80"
        >
          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-glow-red/10 text-glow-red">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
            </span>
            <p class="font-medium text-ink-primary">Read the quickstart</p>
          </div>
          <p class="mt-2 text-xs text-ink-muted">10-min walkthrough on docs.</p>
        </a>
      </div>
    </section>

    <section class="mt-10">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-ink-primary">Active sessions</h2>
        <a href="/sessions" class="text-sm text-glow-red hover:underline">View all →</a>
      </div>
      <div data-sessions-empty class="mt-3 hidden text-sm text-ink-muted">
        No sessions running right now.
      </div>
      <ul
        data-sessions-list
        class="mt-4 hidden divide-y divide-slate-200 rounded-lg border border-white/10 bg-surface-raised"
      >
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-ink-primary">Subscription</h2>
      <div data-subscription-empty class="mt-3 hidden text-sm text-ink-muted">
        No active subscription. <a href="/select-tier" class="text-glow-red hover:underline">Pick a tier →</a>
      </div>
      <div data-subscription-card class="dashboard-card mt-4 hidden">
        <p
          data-subscription-line
          class="font-mono text-xs uppercase tracking-widest text-ink-muted"
        >
        </p>
        <p data-subscription-period class="mt-3 text-sm text-ink-secondary"></p>
        <a href="/billing" class="btn-secondary mt-4 inline-flex">Manage billing</a>
      </div>
      <div data-trial-pack class="dashboard-card mt-4 hidden border-emerald-400/30 bg-emerald-400/10">
        <p class="font-mono text-xs uppercase tracking-widest text-emerald-300">Trial pack</p>
        <p data-trial-pack-line class="mt-3 text-sm text-emerald-200"></p>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="overview"]');
      if (!root) return;

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function showBanner(msg) {
        const b = root.querySelector('[data-banner]');
        if (!b) return;
        b.textContent = msg;
        b.classList.remove('hidden');
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }

      function fmtIsoDay(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }

      const token = getToken();
      if (!token) {
        // 2026-05-19 — dashboard hard-redirects to /login when there's
        // no session token, instead of rendering a "Sign in to see
        // live account data" banner over the page's placeholder
        // mock-data UI. Mock-data UI is a development affordance only;
        // production-side it reads as broken to unauthed visitors.
        const ret = encodeURIComponent(window.location.pathname + window.location.search);
        window.location.replace('/login?return_to=' + ret);
        return;
      }
      // V-331 — pick up the X-Driftstack-Account header from the
      // shared helper installed by DashboardLayout. Self-scope returns
      // {} so the request behaves identically when not "acting as".
      const actAs =
        typeof window.driftstackActAsHeaders === 'function'
          ? window.driftstackActAsHeaders()
          : {};
      const headers = {
        Authorization: 'Bearer ' + token,
        accept: 'application/json',
        ...actAs,
      };

      async function getJson(path) {
        const r = await fetch(apiBaseUrl + path, { headers });
        if (!r.ok) throw new Error(path + ' returned ' + r.status);
        return r.json();
      }

      // ─── /v1/account/me ────────────────────────────────────────────────
      getJson('/v1/account/me')
        .then(function (me) {
          const nameEl = root.querySelector('[data-account-name]');
          if (nameEl) nameEl.textContent = me.name || me.email || '—';
          const tierEl = root.querySelector('[data-account-tier]');
          if (tierEl) tierEl.textContent = String(me.tier || '—');

          const concurrent = root.querySelector('[data-stat-concurrent]');
          if (concurrent) concurrent.textContent = String(me.concurrent_session_active ?? 0);
          const concurrentCap = root.querySelector('[data-stat-concurrent-cap]');
          if (concurrentCap) concurrentCap.textContent = String(me.concurrent_session_cap ?? '—');

          const profiles = root.querySelector('[data-stat-profiles]');
          if (profiles) profiles.textContent = String(me.profile_count ?? 0);
          const profilesCap = root.querySelector('[data-stat-profiles-cap]');
          if (profilesCap && me.profile_cap != null) profilesCap.textContent = ' / ' + me.profile_cap;
        })
        .catch(function (err) {
          showBanner('Could not load account: ' + err.message);
        })
        .finally(function () {
          // 2026-05-21 — DashboardLayout opacity-gate signal. The Overview
          // fans out 4 parallel fetches (account/me, api-keys, sessions,
          // billing); /v1/account/me is the primary one driving the
          // headline stats, so we reveal as soon as it resolves rather
          // than waiting for all four.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // ─── /v1/api-keys ──────────────────────────────────────────────────
      getJson('/v1/api-keys')
        .then(function (resp) {
          const keys = Array.isArray(resp.data) ? resp.data : [];
          const active = keys.filter(function (k) {
            return !k.revoked_at;
          }).length;
          const el = root.querySelector('[data-stat-api-keys]');
          if (el) el.textContent = String(active);
        })
        .catch(function () {
          /* leave dash */
        });

      // ─── /v1/sessions ──────────────────────────────────────────────────
      getJson('/v1/sessions')
        .then(function (resp) {
          const all = Array.isArray(resp.data) ? resp.data : [];
          const active = all.filter(function (s) {
            return s.status !== 'destroyed' && s.status !== 'errored';
          });
          const empty = root.querySelector('[data-sessions-empty]');
          const list = root.querySelector('[data-sessions-list]');
          if (active.length === 0) {
            if (empty) empty.classList.remove('hidden');
            return;
          }
          if (!list) return;
          list.classList.remove('hidden');
          const html = active
            .slice(0, 5)
            .map(function (s) {
              return (
                '<li class="flex items-center justify-between px-6 py-4">' +
                '<div class="min-w-0">' +
                '<p class="font-mono text-sm text-ink-primary">' +
                escapeHtml(s.id) +
                '</p>' +
                '<p class="mt-1 text-xs text-ink-muted">' +
                escapeHtml(s.archetype || '—') +
                ' · started ' +
                escapeHtml(s.created_at || '') +
                '</p></div>' +
                '<span class="rounded-full bg-emerald-400/10 px-2 py-1 text-xs font-medium uppercase tracking-wide text-emerald-300">' +
                escapeHtml(s.status || '—') +
                '</span></li>'
              );
            })
            .join('');
          list.innerHTML = html;
        })
        .catch(function () {
          const empty = root.querySelector('[data-sessions-empty]');
          if (empty) {
            empty.textContent = 'Could not load sessions.';
            empty.classList.remove('hidden');
          }
        });

      // ─── /v1/billing ───────────────────────────────────────────────────
      getJson('/v1/billing')
        .then(function (b) {
          const sub = b.subscription;
          const empty = root.querySelector('[data-subscription-empty]');
          const card = root.querySelector('[data-subscription-card]');
          if (sub) {
            if (card) card.classList.remove('hidden');
            const line = root.querySelector('[data-subscription-line]');
            if (line) line.textContent = String(sub.tier) + ' · ' + String(sub.status);
            const period = root.querySelector('[data-subscription-period]');
            if (period) period.textContent = 'Period ends ' + fmtIsoDay(sub.current_period_end) + '.';
          } else if (empty) {
            empty.classList.remove('hidden');
          }

          const trial = b.trial_pack;
          if (trial && trial.active) {
            const tEl = root.querySelector('[data-trial-pack]');
            const tLine = root.querySelector('[data-trial-pack-line]');
            if (tEl) tEl.classList.remove('hidden');
            const cents = Number(trial.credit_cents_remaining || 0);
            const dollars = (cents / 100).toFixed(2);
            const exp = trial.expires_at ? ' Expires ' + fmtIsoDay(trial.expires_at) + '.' : '';
            if (tLine) tLine.textContent = '$' + dollars + ' credit remaining.' + exp;
          }
        })
        .catch(function () {
          const empty = root.querySelector('[data-subscription-empty]');
          if (empty) {
            empty.textContent = 'Could not load billing.';
            empty.classList.remove('hidden');
          }
        });
    })();
  </script>
</DashboardLayout>
