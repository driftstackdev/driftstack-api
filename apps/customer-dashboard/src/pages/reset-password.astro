---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-273 — Password-reset confirmation page. Pairs with the V-079
// backend route `POST /v1/auth/password-reset/confirm`.
//
// Flow:
//   1. User clicks the reset link from email; page reads `?token=…`.
//   2. User enters a new password (with confirmation field).
//   3. Page POSTs `{token, new_password}` to the backend.
//   4. Server returns a fresh web session on success; page writes
//      `ds_web_session_token` to localStorage and redirects to /.
//   5. Token is one-shot — second use returns 400.

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<DashboardLayout title="Reset password" withSidebar={false}>
  <div class="mx-auto max-w-md px-6 py-16" data-page="reset-password">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Reset password</h1>
    <p class="mt-3 text-sm text-slate-600">
      Choose a new password for your Driftstack account. The link is single-use; if you need
      another, request one from the
      <a href="/forgot-password" class="text-oxblood-700 underline">forgot-password</a> page.
    </p>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
      role="status"
    >
    </div>

    <div data-missing class="mt-6 hidden rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900">
      No reset token in URL. Open the page from the link in your reset email, or
      <a href="/forgot-password" class="text-oxblood-700 underline">request a new one</a>.
    </div>

    <form data-form class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700" for="reset-password-input"
          >New password</label
        >
        <input
          id="reset-password-input"
          name="password"
          type="password"
          required
          minlength="12"
          autocomplete="new-password"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
        <p class="mt-1 text-xs text-slate-500">12+ characters. Use a passphrase.</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700" for="reset-confirm-input"
          >Confirm new password</label
        >
        <input
          id="reset-confirm-input"
          name="confirm"
          type="password"
          required
          minlength="12"
          autocomplete="new-password"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <button type="submit" class="btn-primary w-full">Reset password + sign in</button>
    </form>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="reset-password"]');
      if (!root) return;
      const form = root.querySelector('[data-form]');
      const banner = root.querySelector('[data-banner]');
      const missing = root.querySelector('[data-missing]');
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');

      if (!token) {
        form.classList.add('hidden');
        missing.classList.remove('hidden');
        return;
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const password = (fd.get('password') || '').toString();
        const confirm = (fd.get('confirm') || '').toString();
        if (password !== confirm) {
          showBanner('Passwords do not match.');
          return;
        }
        if (password.length < 12) {
          showBanner('Password must be at least 12 characters.');
          return;
        }
        fetch(apiBaseUrl + '/v1/auth/password-reset/confirm', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token: token, new_password: password }),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
            }
            window.location.href = '/';
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Reset failed.');
          });
      });
    })();
  </script>
</DashboardLayout>
