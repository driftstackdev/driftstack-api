---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-273 — Password-reset confirmation page. Pairs with the V-079
// backend route `POST /v1/auth/password-reset/confirm`.
//
// Flow:
//   1. User clicks the reset link from email; page reads `?token=…`.
//   2. User enters a new password (with confirmation field).
//   3. Page POSTs `{token, new_password}` to the backend.
//   4. Server returns a session, or an MFA challenge for enrolled accounts.
//   5. The page exchanges TOTP/recovery when required, then stores the session.
//   6. Token is one-shot — second use returns 400; a successful MFA challenge is too.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Reset password" withSidebar={false}>
  {/* 2026-05-24 — hero-glow atmosphere matches brand surface. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
      data-page="reset-password"
    >
    <p class="section-label">New password</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Reset password
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      Choose a new password for your Driftstack account. The link is single-use; if you need
      another, request one from the
      <a
        href="/forgot-password"
        class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
        >forgot-password</a
      > page.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div
        data-unknown-recovery
        class="mb-5 hidden space-y-3 rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
      >
        <a
          href="/login"
          class="btn-primary flex w-full items-center justify-center"
          >Try signing in with the new password</a
        >
        <a
          href="/forgot-password"
          class="btn-secondary flex w-full items-center justify-center"
          >Request a fresh reset link</a
        >
      </div>

      <div
        data-missing
        class="mb-5 hidden rounded-lg border border-tk-err/30 bg-tk-err/10 px-4 py-3 text-sm text-tk-ink-2"
      >
        No reset token in URL. Open the page from the link in your reset email, or
        <a
          href="/forgot-password"
          class="font-medium text-tk-ink underline underline-offset-4 hover:text-tk-accent-text"
          >request a new one</a
        >.
      </div>

      <form
        data-form="reset-mfa"
        novalidate
        class="hidden space-y-5"
        aria-label="Two-factor verification"
      >
        <div>
          <h2 class="text-base font-semibold text-tk-ink">Finish two-factor verification</h2>
          <p class="mt-2 text-sm text-tk-ink-2">
            Your password was changed and previous sessions were signed out. Enter the code from
            your authenticator app. This challenge expires in
            <span data-mfa-expiry class="font-mono">5 minutes</span>.
          </p>
        </div>
        <div data-mfa-code-row>
          <label class="form-label" for="reset-mfa-code">Authentication code</label>
          <input
            id="reset-mfa-code"
            name="mfa-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            class="form-input font-mono tracking-widest"
            placeholder="123456"
          />
        </div>
        <div data-mfa-recovery-row class="hidden">
          <label class="form-label" for="reset-mfa-recovery">Recovery code</label>
          <input
            id="reset-mfa-recovery"
            name="mfa-recovery"
            type="text"
            autocomplete="one-time-code"
            class="form-input font-mono uppercase tracking-wider"
            placeholder="ABCD-EFGHJK"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Verify and sign in</button>
        <button
          type="button"
          data-mfa-toggle-recovery
          class="w-full text-sm text-tk-accent-text underline underline-offset-4"
        >Use a recovery code instead</button>
      </form>

      <form data-form="reset-password" class="space-y-5">
        <div>
          <label class="form-label" for="reset-password-input">New password</label>
          <input
            id="reset-password-input"
            name="password"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
            class="form-input"
            placeholder="••••••••••••"
          />
          <p class="form-helper">12+ characters. Use a passphrase.</p>
        </div>
        <div>
          <label class="form-label" for="reset-confirm-input">Confirm new password</label>
          <input
            id="reset-confirm-input"
            name="confirm"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
            class="form-input"
            placeholder="••••••••••••"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Reset password + sign in</button>
      </form>
    </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="reset-password"]');
      if (!root) return;
      const form = root.querySelector('[data-form="reset-password"]');
      const banner = root.querySelector('[data-banner]');
      const missing = root.querySelector('[data-missing]');
      const unknownRecovery = root.querySelector('[data-unknown-recovery]');
      const mfaForm = root.querySelector('[data-form="reset-mfa"]');
      const mfaCodeRow = root.querySelector('[data-mfa-code-row]');
      const mfaRecoveryRow = root.querySelector('[data-mfa-recovery-row]');
      const mfaCodeInput = root.querySelector('#reset-mfa-code');
      const mfaRecoveryInput = root.querySelector('#reset-mfa-recovery');
      const mfaToggle = root.querySelector('[data-mfa-toggle-recovery]');
      const mfaExpiry = root.querySelector('[data-mfa-expiry]');
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');

      if (!token) {
        form.classList.add('hidden');
        missing.classList.remove('hidden');
        return;
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Disable submit + show a pending label while the reset request is in
      // flight. Toggled ON only after the client-side checks pass (below),
      // so a validation early-return never leaves the button stuck.
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitLabel = submitBtn ? submitBtn.textContent : '';
      const RESET_REQUEST_TIMEOUT_MS = 15_000;
      const MFA_TIMEOUT_MS = 15_000;
      let resetInFlight = false;
      let resetOutcomeUnknown = false;
      let mfaChallengeToken = null;
      let mfaUsingRecovery = false;
      let mfaInFlight = false;
      let mfaOutcomeUnknown = false;
      function setSubmitting(on) {
        if (!submitBtn) return;
        submitBtn.disabled = on || resetOutcomeUnknown;
        submitBtn.setAttribute('aria-busy', on ? 'true' : 'false');
        submitBtn.textContent = on
          ? 'Resetting…'
          : resetOutcomeUnknown
            ? 'Reset outcome unknown'
            : submitLabel;
      }

      function completeSession(session) {
        localStorage.setItem('ds_web_session_token', session.token);
        localStorage.removeItem('ds_act_as_account');
        localStorage.removeItem('ds_is_team_user');
        localStorage.removeItem('ds_is_staff_user');
        window.location.href = '/';
      }

      function startMfaChallenge(body) {
        if (!body.challenge_token) {
          showBanner(
            'Your password was changed, but two-factor verification could not start. Sign in with your new password.',
          );
          return;
        }
        mfaChallengeToken = body.challenge_token;
        mfaOutcomeUnknown = false;
        form.classList.add('hidden');
        banner.classList.add('hidden');
        if (body.challenge_expires_at && mfaExpiry) {
          const minutes = Math.max(
            1,
            Math.round((new Date(body.challenge_expires_at).getTime() - Date.now()) / 60000),
          );
          mfaExpiry.textContent = minutes + (minutes === 1 ? ' minute' : ' minutes');
        }
        if (mfaForm) mfaForm.classList.remove('hidden');
        if (mfaCodeInput) mfaCodeInput.focus();
      }

      if (mfaToggle) {
        mfaToggle.addEventListener('click', () => {
          if (mfaInFlight || mfaOutcomeUnknown) return;
          mfaUsingRecovery = !mfaUsingRecovery;
          mfaCodeRow.classList.toggle('hidden', mfaUsingRecovery);
          mfaRecoveryRow.classList.toggle('hidden', !mfaUsingRecovery);
          mfaToggle.textContent = mfaUsingRecovery
            ? 'Use an authenticator code instead'
            : 'Use a recovery code instead';
          const activeInput = mfaUsingRecovery ? mfaRecoveryInput : mfaCodeInput;
          if (activeInput) activeInput.focus();
        });
      }

      if (mfaForm) {
        const mfaSubmit = mfaForm.querySelector('button[type="submit"]');
        const mfaSubmitLabel = mfaSubmit ? mfaSubmit.textContent : '';
        mfaForm.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!mfaChallengeToken || mfaInFlight || mfaOutcomeUnknown) return;
          const code = mfaCodeInput ? mfaCodeInput.value.trim() : '';
          const recoveryCode = mfaRecoveryInput ? mfaRecoveryInput.value.trim() : '';
          if (mfaUsingRecovery ? recoveryCode.length === 0 : !/^\d{6}$/.test(code)) {
            showBanner(
              mfaUsingRecovery
                ? 'Enter one of your recovery codes.'
                : 'Enter the 6-digit code from your authenticator app.',
            );
            return;
          }
          const payload = mfaUsingRecovery
            ? { challenge_token: mfaChallengeToken, recovery_code: recoveryCode }
            : { challenge_token: mfaChallengeToken, code: code };
          mfaInFlight = true;
          banner.classList.add('hidden');
          if (mfaSubmit) {
            mfaSubmit.disabled = true;
            mfaSubmit.setAttribute('aria-busy', 'true');
            mfaSubmit.textContent = 'Verifying…';
          }
          if (mfaToggle) mfaToggle.disabled = true;
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), MFA_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/mfa/challenge', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
            signal: controller.signal,
          })
            .then((response) =>
              response.ok
                ? response.json()
                : response
                    .json()
                    .catch(() => ({}))
                    .then((problem) =>
                      Promise.reject(new Error(problem.detail || 'HTTP ' + response.status)),
                    ),
            )
            .then((body) => {
              const session = body && body.session;
              if (!session || !session.token)
                throw new Error('The server did not return a session. Sign in again.');
              mfaChallengeToken = null;
              completeSession(session);
            })
            .catch((err) => {
              if (err && err.name === 'AbortError') {
                mfaOutcomeUnknown = true;
                mfaChallengeToken = null;
                mfaForm.classList.add('hidden');
                if (unknownRecovery) unknownRecovery.classList.remove('hidden');
                showBanner(
                  'MFA sign-in outcome is unknown after the request timed out. The server may already have consumed this one-time challenge and created a session whose credential did not reach this browser. Do not submit this code again. Sign in afresh with your new password; if that fails, request a new reset link.',
                );
                return;
              }
              showBanner(err && err.message ? err.message : 'Verification failed. Try again.');
            })
            .finally(() => {
              clearTimeout(timeoutId);
              mfaInFlight = false;
              if (!mfaOutcomeUnknown) {
                if (mfaSubmit) {
                  mfaSubmit.disabled = false;
                  mfaSubmit.removeAttribute('aria-busy');
                  mfaSubmit.textContent = mfaSubmitLabel;
                }
                if (mfaToggle) mfaToggle.disabled = false;
              }
            });
        });
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        if (resetInFlight || resetOutcomeUnknown) return;
        banner.classList.add('hidden');
        const fd = new FormData(form);
        const password = (fd.get('password') || '').toString();
        const confirm = (fd.get('confirm') || '').toString();
        if (password !== confirm) {
          showBanner('Passwords do not match.');
          return;
        }
        if (password.length < 12) {
          showBanner('Password must be at least 12 characters.');
          return;
        }
        resetInFlight = true;
        setSubmitting(true);
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), RESET_REQUEST_TIMEOUT_MS);
        fetch(apiBaseUrl + '/v1/auth/password-reset/confirm', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token: token, new_password: password }),
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            if (body.mfa_required === true) {
              startMfaChallenge(body);
              return;
            }
            const session = body && body.session;
            if (!session || !session.token)
              throw new Error('The server did not return a session. Sign in again.');
            completeSession(session);
          })
          .catch((err) => {
            if (controller.signal.aborted) {
              resetOutcomeUnknown = true;
              form.classList.add('hidden');
              if (unknownRecovery) unknownRecovery.classList.remove('hidden');
              showBanner(
                'Password-reset outcome is unknown because the request timed out. The server may already have changed your password and consumed this one-time link. Do not submit this link again. Try signing in with the new password you just entered. If that fails, request a fresh reset link.',
              );
              return;
            }
            showBanner(
              err && err.message
                ? err.message
                : 'Reset failed.',
            );
          })
          .finally(() => {
            clearTimeout(timeoutId);
            resetInFlight = false;
            setSubmitting(false);
          });
      });
    })();
  </script>
</DashboardLayout>
