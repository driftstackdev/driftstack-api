---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_ACCOUNT, MOCK_SUBSCRIPTION, MOCK_TRIAL_PACK_STATE } from '../data/mocks.ts';

// V-183 — progressive-enhancement wiring against /v1/billing.
// SSG renders mock for instant paint; inline <script> fetches live
// state + replaces card values. Action buttons (portal / trial pack)
// POST to the corresponding billing endpoint + redirect to the
// returned Stripe URL. Mirrors V-180/V-181/V-182.

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().slice(0, 10);
}

function fmtCents(cents: number | null): string {
  if (cents === null) return '—';
  return `$${(cents / 100).toFixed(2)}`;
}

const status = MOCK_SUBSCRIPTION?.status ?? 'no_subscription';
const STATUS_BADGE_CLASS: Record<string, string> = {
  active: 'bg-emerald-400/10 text-emerald-300',
  trialing: 'bg-glow-red/10 text-glow-red',
  past_due: 'bg-red-50 text-red-700',
  canceled: 'bg-surface-raised text-ink-secondary',
  unpaid: 'bg-red-50 text-red-700',
  incomplete: 'bg-glow-red/10 text-glow-red',
  incomplete_expired: 'bg-surface-raised text-ink-secondary',
  paused: 'bg-surface-raised text-ink-secondary',
  no_subscription: 'bg-surface-raised text-ink-secondary',
};

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Billing">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="billing">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-ink-muted" data-field="account-email">Account · {MOCK_ACCOUNT.email}</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">Billing</span></h1>
      <p class="mt-2 max-w-prose text-sm text-ink-muted">
        Manage subscription, payment method, invoices, and trial-pack credit.
        All payment changes redirect to Stripe's secure portal.
      </p>
    </header>

    {/* 2026-05-23 — subscription card gets an icon header for visual
        anchor. Same glow-red square mark family. */}
    <!-- Subscription card -->
    <section class="dashboard-card">
      <div class="flex items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red mt-1">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <path d="M2 10h20" />
            </svg>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Subscription</p>
            <h2 class="mt-2 text-xl font-semibold text-ink-primary" data-field="sub-tier">
              {MOCK_SUBSCRIPTION ? MOCK_SUBSCRIPTION.tier : 'No active subscription'}
            </h2>
          <p class="mt-2 text-sm text-ink-secondary" data-field="sub-summary">
            {
              MOCK_SUBSCRIPTION
                ? `Renews ${fmtIso(MOCK_SUBSCRIPTION.current_period_end)} · ${MOCK_SUBSCRIPTION.cancel_at_period_end ? 'set to cancel at period end' : 'auto-renews'}`
                : 'Upgrade to a paid tier to unlock concurrent caps + archetype access.'
            }
          </p>
          </div>
        </div>
        <span
          data-field="sub-status-badge"
          class:list={[
            'inline-flex shrink-0 rounded-full px-3 py-1 text-xs font-medium uppercase tracking-wide',
            STATUS_BADGE_CLASS[status],
          ]}
        >
          {status.replace(/_/g, ' ')}
        </span>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" class="btn-primary" data-action="portal">Manage in Stripe portal</button>
        <a href="/select-tier" class="btn-secondary">Change plan</a>
        <button
          type="button"
          data-action="cancel"
          class:list={[
            'btn-secondary text-red-700',
            MOCK_SUBSCRIPTION && !MOCK_SUBSCRIPTION.cancel_at_period_end ? '' : 'hidden',
          ]}
        >
          Cancel subscription
        </button>
      </div>
    </section>

    {/* 2026-05-23 — icon header on the trial-pack card. */}
    <!-- Trial pack card -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red mt-1">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 12V8H6a2 2 0 0 1 0-4h12v4" />
              <path d="M4 6v12a2 2 0 0 0 2 2h14v-4" />
              <path d="M18 12a2 2 0 0 0 0 4h4v-4z" />
            </svg>
          </div>
          <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Trial pack</p>
          <h2 class="mt-2 text-xl font-semibold text-ink-primary" data-field="trial-state">
            {
              MOCK_TRIAL_PACK_STATE.active
                ? 'Active'
                : MOCK_TRIAL_PACK_STATE.redeemed
                  ? 'Redeemed'
                  : 'Available'
            }
          </h2>
          <p class="mt-2 text-sm text-ink-secondary" data-field="trial-summary">
            {
              MOCK_TRIAL_PACK_STATE.active
                ? `${fmtCents(MOCK_TRIAL_PACK_STATE.credit_cents_remaining)} of credit remaining · expires ${fmtIso(MOCK_TRIAL_PACK_STATE.expires_at)}`
                : MOCK_TRIAL_PACK_STATE.redeemed
                  ? '$2.99 trial pack already used on this account. Once-per-account; the trial does not refresh.'
                  : 'Buy 16 hours of iPhone Safari sessions for $2.99 — once per account.'
            }
          </p>
          </div>
        </div>
      </div>
      <div
        data-field="trial-buy-wrap"
        class:list={[
          'mt-6 flex flex-wrap items-center gap-3',
          !MOCK_TRIAL_PACK_STATE.active && !MOCK_TRIAL_PACK_STATE.redeemed ? '' : 'hidden',
        ]}
      >
        <button type="button" class="btn-primary" data-action="buy-trial-pack">
          Buy trial pack — $2.99
        </button>
        {/* 2026-05-21 — crypto disabled on trial pack: NowPayments has
            a $19.16 USD-equivalent floor across all currencies, so
            the $2.99 trial would always fail amount_too_low at their
            API. Crypto checkout is offered on /subscription tier
            upgrades instead (Solo Manual $79+ comfortably clears
            the floor). Customer-facing copy makes this explicit. */}
        <p class="text-xs text-ink-muted">
          Card only — crypto checkout requires a $20+ purchase. Available on{' '}
          <a href="/subscription" class="text-glow-red hover:underline">subscription tiers</a>.
        </p>
      </div>
      {/* 2026-05-22 — crypto modal removed alongside the "or pay with
          crypto →" button (81a15517 dropped the button because
          NowPayments' $19.16 USD floor exceeds the $2.99 trial-pack
          price). Crypto checkout lives on /select-tier for $20+ tiers
          per a4460e2a; this billing page is card-only. */}
    </section>

    {/* 2026-05-23 — icon header on the invoices card. */}
    <!-- Invoices placeholder -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 13h6M9 17h4" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Invoices</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">Recent invoices</span></h2>
          <p class="mt-3 text-sm text-ink-muted">
            No invoices yet. Once your subscription renews or the trial pack is
            purchased, invoices appear here. Each invoice carries a permanent
            URL — bookmark for accounting. The full invoice history is also
            accessible via the Stripe Customer Portal link above.
          </p>
        </div>
      </div>
    </section>

    <!-- Tax + receipts hint -->
    <p class="mt-8 text-xs text-ink-muted">
      All prices in USD. VAT/BTW added per region per applicable EU rules.
      Stripe handles tax computation + invoicing per ADR-002.
    </p>
  </div>

  <!--
 — progressive-enhancement script. Reads ds_web_session_token
    from localStorage, fetches /v1/billing for state, wires action
    buttons (portal / trial-pack purchase) to corresponding POST
    endpoints with redirect on response.
  -->
  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="billing"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function setText(field, text) {
        const el = root.querySelector('[data-field="' + field + '"]');
        if (el) el.textContent = text;
      }

      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }
      function fmtCents(cents) {
        if (cents === null || cents === undefined) return '—';
        return '$' + (cents / 100).toFixed(2);
      }

      function authedFetch(path, init = {}) {
        return fetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // Wire action buttons regardless of token state — they show a
      // banner if no token rather than silently no-oping.
      const portalBtn = root.querySelector('[data-action="portal"]');
      const cancelBtn = root.querySelector('[data-action="cancel"]');
      const buyBtn = root.querySelector('[data-action="buy-trial-pack"]');

      function handlePortal() {
        if (!token) {
          showBanner('Sign in to manage billing.');
          return;
        }
        authedFetch('/v1/billing/portal-session', { method: 'POST', body: '{}' })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (body.portal_url) window.location.href = body.portal_url;
          })
          .catch((err) => {
            showBanner(
              "Couldn't open Stripe portal (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          });
      }

      function handleBuyTrialPack() {
        if (!token) {
          showBanner('Sign in to purchase the trial pack.');
          return;
        }
        const successUrl = window.location.origin + '/billing?trial=ok';
        const cancelUrl = window.location.origin + '/billing?trial=cancel';
        authedFetch('/v1/billing/trial-pack', {
          method: 'POST',
          body: JSON.stringify({ success_url: successUrl, cancel_url: cancelUrl }),
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (body.checkout_url) window.location.href = body.checkout_url;
          })
          .catch((err) => {
            showBanner(
              "Couldn't start trial-pack checkout (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          });
      }

      if (portalBtn) portalBtn.addEventListener('click', handlePortal);
      if (cancelBtn) cancelBtn.addEventListener('click', handlePortal); // cancellation goes through Stripe portal
      if (buyBtn) buyBtn.addEventListener('click', handleBuyTrialPack);

      // 2026-05-22 — crypto modal + handlers removed alongside the
      // trial-pack crypto button (81a15517). NowPayments' $19.16 USD
      // floor exceeds the $2.99 trial price; the crypto flow now
      // lives exclusively on /select-tier where every tier clears
      // the floor (a4460e2a).

      if (!token) {
        showBanner('Sign in to see live billing state. Showing preview data below.');
        return;
      }

      // Fetch live billing state.
      // 2026-05-21 — surface the server's problem+json `detail` string
      // (W277.C contract) AND a `status` field on the rejected error
      // so the .catch handler can show a kinder UX for the activation-
      // gate 503 ("Billing not configured yet") vs generic transport
      // errors. Detail wins; status is the fallback.
      authedFetch('/v1/billing', { method: 'GET' })
        .then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((body) => {
                  const err = new Error(body.detail || 'HTTP ' + r.status);
                  err.status = r.status;
                  return Promise.reject(err);
                }),
        )
        .then((body) => {
          // Subscription card.
          if (body.subscription) {
            const sub = body.subscription;
            setText('sub-tier', sub.tier);
            const summary =
              'Renews ' +
              fmtIso(sub.current_period_end) +
              ' · ' +
              (sub.cancel_at_period_end ? 'set to cancel at period end' : 'auto-renews');
            setText('sub-summary', summary);
            setText('sub-status-badge', (sub.status || '').replace(/_/g, ' '));
            // Cancel button visibility.
            if (cancelBtn) {
              if (sub.cancel_at_period_end) cancelBtn.classList.add('hidden');
              else cancelBtn.classList.remove('hidden');
            }
          } else {
            setText('sub-tier', 'No active subscription');
            setText(
              'sub-summary',
              'Upgrade to a paid tier to unlock concurrent caps + archetype access.',
            );
            setText('sub-status-badge', 'no subscription');
            if (cancelBtn) cancelBtn.classList.add('hidden');
          }

          // Trial pack card.
          const tp = body.trial_pack || {};
          let trialState;
          let trialSummary;
          let showBuy = false;
          if (tp.active) {
            trialState = 'Active';
            trialSummary =
              fmtCents(tp.credit_cents_remaining) +
              ' of credit remaining · expires ' +
              fmtIso(tp.expires_at);
          } else if (tp.redeemed) {
            trialState = 'Redeemed';
            trialSummary =
              '$2.99 trial pack already used on this account. Once-per-account; the trial does not refresh.';
          } else {
            trialState = 'Available';
            trialSummary = 'Buy 16 hours of iPhone Safari sessions for $2.99 — once per account.';
            showBuy = true;
          }
          setText('trial-state', trialState);
          setText('trial-summary', trialSummary);
          const buyWrap = root.querySelector('[data-field="trial-buy-wrap"]');
          if (buyWrap) {
            if (showBuy) buyWrap.classList.remove('hidden');
            else buyWrap.classList.add('hidden');
          }
        })
        .catch((err) => {
          // 2026-05-21 — 503 = activation-gate (server-side: Stripe
          // env not fully wired). User shouldn't see "HTTP 503" —
          // soft-message it. Other failures keep the generic shape
          // but surface body.detail via err.message.
          if (err && err.status === 503) {
            showBanner(
              'Live billing is not yet available — Driftstack is finishing Stripe setup. ' +
                'Showing preview data below. We will email you when the live billing surface ships.',
            );
          } else {
            showBanner(
              "Couldn't load live billing (" +
                (err && err.message ? err.message : 'network error') +
                '). Showing preview data below.',
            );
          }
        })
        .finally(function () {
          // 2026-05-21 — signal the layout's opacity-gate that this
          // page's primary fetch resolved (success or failure). The
          // gate reveals <main> once OR after the 1200ms safety cap,
          // whichever fires first.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });
    })();
  </script>
</DashboardLayout>
