---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_ACCOUNT, MOCK_SUBSCRIPTION, TIER_DISPLAY_NAMES } from '../data/mocks.ts';

// V-183 — progressive-enhancement wiring against /v1/billing.
// SSG renders mock for instant paint; inline <script> fetches live
// state + replaces card values. The portal action button POSTs to the
// billing endpoint + redirects to the returned Stripe URL. Mirrors
// V-180/V-181/V-182. (Trial-pack flow retired 2026-05-27.)

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().slice(0, 10);
}

const status = MOCK_SUBSCRIPTION?.status ?? 'no_subscription';
// Fleet v2 (2026-07-02) — the 9-state Stripe lifecycle catalog is
// load-bearing (an uncatalogued status renders unstyled); values sit on
// the two-axis status tokens so badges flip with data-mode instead of
// the old hard-coded emerald/red literals that broke in light mode.
const STATUS_BADGE_CLASS: Record<string, string> = {
  active: 'bg-tk-ready/10 text-tk-ready-text',
  trialing: 'bg-tk-accent/10 text-tk-accent-text',
  past_due: 'bg-tk-err/10 text-tk-err-text',
  canceled: 'bg-tk-hover text-tk-ink-2',
  unpaid: 'bg-tk-err/10 text-tk-err-text',
  incomplete: 'bg-tk-accent/10 text-tk-accent-text',
  incomplete_expired: 'bg-tk-hover text-tk-ink-2',
  paused: 'bg-tk-hover text-tk-ink-2',
  no_subscription: 'bg-tk-hover text-tk-ink-2',
};

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Billing">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="billing">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-tk-ink-3" data-field="account-email">Account · {MOCK_ACCOUNT.email}</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Billing</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Manage subscription, payment method, and invoices.
        All payment changes redirect to Stripe's secure portal.
      </p>
    </header>

    {/* 2026-05-23 — subscription card gets an icon header for visual
        anchor. Same glow-red square mark family. */}
    <!-- Subscription card -->
    <section class="dashboard-card">
      <div class="flex items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <path d="M2 10h20" />
            </svg>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Subscription</p>
            <h2 class="mt-2 text-xl font-semibold text-tk-ink" data-field="sub-tier">
              {MOCK_SUBSCRIPTION ? TIER_DISPLAY_NAMES[MOCK_SUBSCRIPTION.tier] : 'No active subscription'}
            </h2>
          <p class="mt-2 text-sm text-tk-ink-2" data-field="sub-summary">
            {
              MOCK_SUBSCRIPTION
                ? `Renews ${fmtIso(MOCK_SUBSCRIPTION.current_period_end)} · ${MOCK_SUBSCRIPTION.cancel_at_period_end ? 'set to cancel at period end' : 'auto-renews'}`
                : 'Upgrade to a paid tier to unlock concurrent caps + archetype access.'
            }
          </p>
          </div>
        </div>
        <span
          data-field="sub-status-badge"
          class:list={[
            'inline-flex shrink-0 rounded-full px-3 py-1 text-xs font-medium uppercase tracking-wide',
            STATUS_BADGE_CLASS[status],
          ]}
        >
          {status.replace(/_/g, ' ')}
        </span>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" class="btn-primary" data-action="portal">Manage in Stripe portal</button>
        <a href="/select-tier" class="btn-secondary" data-field="plan-cta">Change plan</a>
        <button
          type="button"
          data-action="cancel"
          class:list={[
            'btn-secondary text-red-700',
            MOCK_SUBSCRIPTION && !MOCK_SUBSCRIPTION.cancel_at_period_end ? '' : 'hidden',
          ]}
        >
          Cancel in Stripe portal
        </button>
      </div>
      {/* Finding #9 fix — the cancel button opens the same generic
          Stripe Customer Portal as "Manage in Stripe portal" (Stripe
          doesn't expose a one-click cancel-only deep link through this
          flow); clicking it does NOT cancel anything by itself. The
          button label above says "Cancel in Stripe portal" (not "Cancel
          subscription") and this line spells out the one extra step, so
          a customer can't believe they're cancelled the moment the
          portal opens and then get surprised by the next renewal
          charge. */}
      <p
        data-field="cancel-hint"
        class:list={[
          'mt-2 text-xs text-tk-ink-3',
          MOCK_SUBSCRIPTION && !MOCK_SUBSCRIPTION.cancel_at_period_end ? '' : 'hidden',
        ]}
      >
        Opens the Stripe billing portal in a new step — choose "Cancel plan" there to finish cancelling.
      </p>
      {/* 2026-07-02 (slice 3.3) — plan-change honesty copy, absorbed from
          the retired /subscription page (the account-portal IA folded that
          drill-down into this card; plan history + the full invoice list
          live in the Stripe portal). */}
      <p class="mt-2 text-xs text-tk-ink-3">
        Upgrades take effect immediately and prorate your remaining period.
        Downgrades take effect at the end of the current period — you keep
        your current cap until renewal.
      </p>
    </section>

    {/* 2026-05-23 — icon header on the invoices card. */}
    <!-- Invoices placeholder -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 13h6M9 17h4" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Invoices</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Recent invoices</h2>
          <p class="mt-3 text-sm text-tk-ink-3">
            No invoices yet. Once your subscription renews, invoices appear
            here. Each invoice carries a permanent
            URL — bookmark for accounting. The full invoice history is also
            accessible via the Stripe Customer Portal link above.
          </p>
        </div>
      </div>
    </section>

    {/* Fleet v2 (2026-07-02, slice 3.3) — crypto payments history. The
        top-up orders the GUI's Billing "Orders" tab shows, surfaced on the
        web portal too: GET /v1/billing/crypto-orders (5 most recent).
        Receipt downloads go through an authed fetch → blob (the receipt
        endpoints require the Bearer header, so a plain <a href> would 401). */}
    <!-- Crypto payments -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M9 8h4.5a2 2 0 0 1 0 4H9h5a2 2 0 0 1 0 4H9M12 6v2M12 16v2" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Crypto payments</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Recent orders</h2>
          <p data-crypto-empty class="mt-3 hidden text-sm text-tk-ink-3">
            No crypto payments yet. Pay with crypto from the
            <a href="/select-tier" class="text-tk-accent-text hover:underline">plan picker</a>.
          </p>
          <ul data-crypto-list class="mt-4 hidden divide-y divide-tk-border"></ul>
        </div>
      </div>
    </section>

    <!-- Tax + receipts hint -->
    <p class="mt-8 text-xs text-tk-ink-3">
      All prices in USD. VAT/BTW added per region per applicable EU rules.
      Stripe handles tax computation + invoicing per ADR-002.
    </p>
  </div>

  <!--
 — progressive-enhancement script. Reads ds_web_session_token
    from localStorage, fetches /v1/billing for state, wires action
    the portal button to its POST endpoint with redirect on response.
  -->
  <script is:inline define:vars={{ apiBaseUrl, tierDisplayNames: TIER_DISPLAY_NAMES }}>
    (function () {
      const root = document.querySelector('[data-page="billing"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Backend tier id → human plan name, so the customer sees "Personal"
      // not "solo_manual" on their own billing page.
      function tierLabel(t) {
        return (t && tierDisplayNames[t]) || t || '—';
      }

      function setText(field, text) {
        const el = root.querySelector('[data-field="' + field + '"]');
        if (el) el.textContent = text;
      }

      // Mirrors the frontmatter STATUS_BADGE_CLASS — the SSR class is only
      // ever right for the mock/initial status. Every live-fetch branch below
      // called setText() alone, so the badge TEXT updated but its color stayed
      // frozen at whatever the SSR default rendered (e.g. a real past_due
      // subscriber could see red "past due" text on a green "active" pill).
      // BADGE_TONE_CLASSES lists every class any status ever applies, so we
      // can strip them all before adding the new one.
      const STATUS_BADGE_CLASS = {
        active: 'bg-tk-ready/10 text-tk-ready-text',
        trialing: 'bg-tk-accent/10 text-tk-accent-text',
        past_due: 'bg-tk-err/10 text-tk-err-text',
        canceled: 'bg-tk-hover text-tk-ink-2',
        unpaid: 'bg-tk-err/10 text-tk-err-text',
        incomplete: 'bg-tk-accent/10 text-tk-accent-text',
        incomplete_expired: 'bg-tk-hover text-tk-ink-2',
        paused: 'bg-tk-hover text-tk-ink-2',
        no_subscription: 'bg-tk-hover text-tk-ink-2',
      };
      const BADGE_TONE_CLASSES = Array.from(
        new Set(Object.values(STATUS_BADGE_CLASS).flatMap((c) => c.split(' '))),
      );
      function setStatusBadge(text, toneKey) {
        setText('sub-status-badge', text);
        const el = root.querySelector('[data-field="sub-status-badge"]');
        if (!el) return;
        el.classList.remove(...BADGE_TONE_CLASSES);
        const toneClass = STATUS_BADGE_CLASS[toneKey] || STATUS_BADGE_CLASS.no_subscription;
        el.classList.add(...toneClass.split(' '));
      }

      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }
      function authedFetch(path, init = {}) {
        return fetch(apiBaseUrl + path, {
          ...init,
          headers: {
            ...(init.headers || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            // V-331b — act-as header for team-scoped requests.
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
          credentials: 'include',
        });
      }

      // audit w2flmiw48 #4 — the account-email header was seeded from MOCK_ACCOUNT and
      // never overwritten by live data (every customer saw the mock email). Populate it
      // from /account/me; leave the placeholder on failure / no token.
      if (token) {
        authedFetch('/v1/account/me')
          .then((r) => (r.ok ? r.json() : null))
          .then((me) => {
            if (me && me.email) setText('account-email', 'Account · ' + me.email);
          })
          .catch(() => {
            /* leave the placeholder */
          });
      }

      // Wire action buttons regardless of token state — they show a
      // banner if no token rather than silently no-oping.
      const portalBtn = root.querySelector('[data-action="portal"]');
      const cancelBtn = root.querySelector('[data-action="cancel"]');
      const cancelHint = root.querySelector('[data-field="cancel-hint"]');

      let portalLoading = false;
      function setPortalLoading(loading) {
        portalLoading = loading;
        [portalBtn, cancelBtn].forEach((btn) => {
          if (!btn) return;
          btn.disabled = loading;
          btn.setAttribute('aria-busy', loading ? 'true' : 'false');
        });
        if (portalBtn) {
          portalBtn.textContent = loading ? 'Opening Stripe…' : 'Manage in Stripe portal';
        }
        if (cancelBtn) {
          cancelBtn.textContent = loading ? 'Opening Stripe…' : 'Cancel in Stripe portal';
        }
      }

      async function handlePortal() {
        if (!token) {
          showBanner('Sign in to manage billing.');
          return;
        }
        if (portalLoading) return;
        setPortalLoading(true);
        try {
          const response = await authedFetch('/v1/billing/portal-session', {
            method: 'POST',
            body: '{}',
          });
          if (!response.ok) throw new Error('portal unavailable');
          const body = await response.json();
          if (!body || !body.portal_url) throw new Error('portal URL missing');
          window.location.href = body.portal_url;
        } catch {
          showBanner("Couldn't open Stripe right now — check your connection and try again.");
        } finally {
          setPortalLoading(false);
        }
      }

      if (portalBtn) portalBtn.addEventListener('click', handlePortal);
      if (cancelBtn) cancelBtn.addEventListener('click', handlePortal); // cancellation goes through Stripe portal

      // 2026-05-22 — crypto modal + handlers removed from /billing.
      // The crypto checkout flow lives exclusively on /select-tier,
      // where every tier clears NowPayments' $19.16 USD floor
      // (a4460e2a).

      if (!token) {
        showBanner('Sign in to see live billing state. Showing preview data below.');
        return;
      }

      // Fetch live billing state.
      // 2026-05-21 — surface the server's problem+json `detail` string
      // (W277.C contract) AND a `status` field on the rejected error
      // so the .catch handler can show a kinder UX for the activation-
      // gate 503 ("Billing not configured yet") vs generic transport
      // errors. Detail wins; status is the fallback.
      authedFetch('/v1/billing', { method: 'GET' })
        .then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((body) => {
                  const err = new Error(body.detail || 'HTTP ' + r.status);
                  err.status = r.status;
                  return Promise.reject(err);
                }),
        )
        .then((body) => {
          // Subscription card.
          if (body.subscription) {
            const sub = body.subscription;
            setText('sub-tier', tierLabel(sub.tier));
            const summary =
              'Renews ' +
              fmtIso(sub.current_period_end) +
              ' · ' +
              (sub.cancel_at_period_end ? 'set to cancel at period end' : 'auto-renews');
            setText('sub-summary', summary);
            setStatusBadge((sub.status || '').replace(/_/g, ' '), sub.status);
            // Paid subscriber: portal + (conditionally) cancel apply.
            if (portalBtn) portalBtn.classList.remove('hidden');
            setText('plan-cta', 'Change plan');
            // Cancel button (+ its honesty hint) visibility.
            if (cancelBtn) {
              if (sub.cancel_at_period_end) cancelBtn.classList.add('hidden');
              else cancelBtn.classList.remove('hidden');
            }
            if (cancelHint) {
              if (sub.cancel_at_period_end) cancelHint.classList.add('hidden');
              else cancelHint.classList.remove('hidden');
            }
          } else {
            setText('sub-tier', 'No active subscription');
            setText(
              'sub-summary',
              'Upgrade to a paid tier to unlock concurrent caps + archetype access.',
            );
            setStatusBadge('no subscription', 'no_subscription');
            // No subscription → no Stripe customer/portal and nothing to
            // cancel; hide both so they can't lead to a dead Stripe call.
            // The plan CTA becomes "Choose a plan" (not "Change").
            if (portalBtn) portalBtn.classList.add('hidden');
            if (cancelBtn) cancelBtn.classList.add('hidden');
            if (cancelHint) cancelHint.classList.add('hidden');
            setText('plan-cta', 'Choose a plan');
          }
        })
        .catch((err) => {
          // 2026-05-21 — 503 = activation-gate (server-side: Stripe
          // env not fully wired). User shouldn't see "HTTP 503" —
          // soft-message it. Other failures keep the generic shape
          // but surface body.detail via err.message.
          if (err && err.status === 503) {
            // W588 — billing is activation-gated (Stripe not wired yet). Don't
            // leave the SSG mock subscription (fabricated tier + renew date) on
            // screen — a real customer reads it as their actual plan. Replace
            // the card with an honest "not configured" state.
            showBanner(
              'Live billing is not available yet — Driftstack is finishing Stripe setup. ' +
                'We will email you when it ships. Your account access is unaffected.',
            );
            setText('sub-tier', 'Billing not configured yet');
            setText(
              'sub-summary',
              'Paid-plan billing activates once Stripe setup completes — nothing to pay or manage here yet.',
            );
            setStatusBadge('pending setup', 'no_subscription');
            if (portalBtn) portalBtn.classList.add('hidden');
            if (cancelBtn) cancelBtn.classList.add('hidden');
            if (cancelHint) cancelHint.classList.add('hidden');
          } else {
            // 2026-06-24 — on a generic (non-503) failure, don't leave the
            // SSG mock subscription (fabricated tier + renew date) on screen —
            // a real customer reads it as their actual plan. Neutralize the
            // card the same way the 503 branch does.
            showBanner(
              "Couldn't load live billing (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
            setText('sub-tier', 'Billing state unavailable');
            setText(
              'sub-summary',
              "Couldn't load your live subscription state — reload to try again.",
            );
            setStatusBadge('unavailable', 'no_subscription');
            if (portalBtn) portalBtn.classList.add('hidden');
            if (cancelBtn) cancelBtn.classList.add('hidden');
            if (cancelHint) cancelHint.classList.add('hidden');
          }
        })
        .finally(function () {
          // 2026-05-21 — signal the layout's opacity-gate that this
          // page's primary fetch resolved (success or failure). The
          // gate reveals <main> once OR after the 1200ms safety cap,
          // whichever fires first.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // ─── Crypto payments history (slice 3.3) ──────────────────────────
      // GET /v1/billing/crypto-orders?limit=5 — the same orders the GUI's
      // Billing "Orders" tab lists. Quiet failure: the section keeps its
      // empty state (crypto is optional; a transient error here must not
      // alarm a card-paying customer).
      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }
      // 6-state CryptoOrderStatus catalog (api-types) — an uncatalogued
      // status renders with the muted fallback, never unstyled.
      const CRYPTO_BADGE = {
        pending: 'bg-tk-busy/10 text-tk-busy-text',
        confirming: 'bg-tk-busy/10 text-tk-busy-text',
        paid: 'bg-tk-ready/10 text-tk-ready-text',
        failed: 'bg-tk-err/10 text-tk-err-text',
        partial: 'bg-tk-busy/10 text-tk-busy-text',
        cancelled: 'bg-tk-hover text-tk-ink-2',
      };
      function fmtPrice(cents, currency) {
        const n = Number(cents);
        if (!isFinite(n)) return '—';
        return (n / 100).toFixed(2) + ' ' + String(currency || 'USD');
      }
      authedFetch('/v1/billing/crypto-orders?limit=5', { method: 'GET' })
        .then(function (r) {
          return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
        })
        .then(function (body) {
          const orders = body && Array.isArray(body.orders) ? body.orders : [];
          const list = root.querySelector('[data-crypto-list]');
          const empty = root.querySelector('[data-crypto-empty]');
          if (!orders.length) {
            if (empty) empty.classList.remove('hidden');
            return;
          }
          if (!list) return;
          list.classList.remove('hidden');
          list.innerHTML = orders
            .map(function (o) {
              const badge = CRYPTO_BADGE[o.status] || 'bg-tk-hover text-tk-ink-2';
              const receipt =
                o.status === 'paid'
                  ? '<button type="button" data-crypto-receipt="' +
                    escapeHtml(o.order_id) +
                    '" class="text-xs text-tk-accent-text hover:underline">Receipt (PDF)</button>'
                  : '';
              return (
                '<li class="flex flex-wrap items-center justify-between gap-3 py-3">' +
                '<div class="min-w-0">' +
                '<p class="text-sm font-medium text-tk-ink">' +
                escapeHtml(tierLabel(o.product)) +
                ' · ' +
                escapeHtml(fmtPrice(o.price_cents, o.price_currency)) +
                '</p>' +
                '<p class="mt-0.5 font-mono text-xs text-tk-ink-3">' +
                escapeHtml(o.order_id) +
                ' · ' +
                escapeHtml(fmtIso(o.created_at)) +
                '</p></div>' +
                '<span class="flex items-center gap-3">' +
                receipt +
                '<span class="rounded-full px-2 py-1 text-xs font-medium uppercase tracking-wide ' +
                badge +
                '">' +
                escapeHtml(String(o.status || '—')) +
                '</span></span></li>'
              );
            })
            .join('');
          // Receipt downloads: the endpoint requires the Bearer header, so
          // a plain <a href> would 401 — fetch with auth, then hand the
          // blob to the browser as a download.
          list.querySelectorAll('[data-crypto-receipt]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              const id = btn.getAttribute('data-crypto-receipt');
              authedFetch('/v1/billing/crypto-orders/' + encodeURIComponent(id) + '/receipt.pdf', {
                method: 'GET',
              })
                .then(function (r) {
                  return r.ok ? r.blob() : Promise.reject(new Error('HTTP ' + r.status));
                })
                .then(function (blob) {
                  const url = URL.createObjectURL(blob);
                  const a = document.createElement('a');
                  a.href = url;
                  a.download = 'driftstack-receipt-' + id + '.pdf';
                  document.body.appendChild(a);
                  a.click();
                  a.remove();
                  URL.revokeObjectURL(url);
                })
                .catch(function () {
                  showBanner("Couldn't download the receipt — try again in a moment.");
                });
            });
          });
        })
        .catch(function () {
          const empty = root.querySelector('[data-crypto-empty]');
          if (empty) empty.classList.remove('hidden');
        });
    })();
  </script>
</DashboardLayout>
