---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { resolveApiBaseUrl } from '../lib/api-base-url';

// EG-API-1.5 — customer-facing /proxies page. Library of saved
// SOCKS5/OpenVPN/WireGuard configs (per planning 133 §"Cross-agent
// split" Agent 2 scope: POST/GET/DELETE /v1/proxies). Phase 1 surfaces
// only SOCKS5 in the create form; OpenVPN + WireGuard cards are
// stubbed with "coming in Phase 2/3" labels per planning 133's locked
// roadmap.
//
// Progressive-enhancement pattern same as the other dashboard pages:
// SSG renders empty list + create form; inline <script> wires fetch
// against /v1/proxies (with web-session-token Bearer auth via
// ds_web_session_token). When the backend isn't wired yet (current
// posture), POST 503s and the customer sees a "Saved-proxy storage is
// not yet wired" banner — same activation-gate UX as the rest of the
// dashboard's pre-launch surfaces.

const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Proxies">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="proxies">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
      role="status"
    ></div>

    <header class="mb-10">
      <p class="text-sm text-ink-muted">Egress</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight">Proxies</h1>
      <p class="mt-2 max-w-prose text-sm text-ink-muted">
        Saved proxy configurations you can attach to a session. Sessions
        route all browser traffic through the attached proxy — the target
        site sees the proxy's IP, not Driftstack's Mac-fleet IP. SOCKS5
        with full UDP ASSOCIATE for WebRTC/QUIC, plus OpenVPN (.ovpn) and
        WireGuard (.conf) configs per profile.
      </p>
    </header>

    <section class="mb-12 dashboard-card">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 4v16" />
          </svg>
        </span>
        Saved configs
      </h2>
      <p class="mt-1 text-sm text-ink-muted">
        Reusable proxy configs you've saved. The raw secret material
        (passwords / private keys) is never shown after save — re-enter to
        update.
      </p>
      <p data-empty="proxies" class="mt-4 text-sm text-ink-muted">
        Loading…
      </p>
      <ul
        data-list="proxies"
        class="mt-4 hidden divide-y divide-slate-200 rounded-lg border border-white/10 bg-surface-raised"
      ></ul>
    </section>

    <section class="mb-12 dashboard-card" data-create-form>
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
        </span>
        Add a SOCKS5 proxy
      </h2>
      <p class="mt-1 text-sm text-ink-muted">
        The proxy must support UDP ASSOCIATE so WebRTC traffic routes
        through it; TCP-only SOCKS5 leaks media flows directly.
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">Label</span>
          <input
            id="proxy-label"
            type="text"
            maxlength="120"
            placeholder="team SOCKS5 — london"
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">Host</span>
          <input
            id="proxy-host"
            type="text"
            maxlength="253"
            placeholder="proxy.example.com"
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">Port</span>
          <input
            id="proxy-port"
            type="number"
            min="1"
            max="65535"
            placeholder="1080"
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          />
        </label>
        <div class="block">
          <span class="block text-sm font-medium text-ink-secondary">UDP ASSOCIATE</span>
          <label class="mt-2 flex items-center gap-2 text-sm text-ink-muted">
            <input id="proxy-udp" type="checkbox" checked class="rounded" />
            Required for WebRTC (recommended)
          </label>
        </div>
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">Username (optional)</span>
          <input
            id="proxy-username"
            type="text"
            maxlength="256"
            autocomplete="off"
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">Password (optional)</span>
          <input
            id="proxy-password"
            type="password"
            maxlength="256"
            autocomplete="new-password"
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          />
        </label>
      </div>
      <button
        id="proxy-save-btn"
        type="button"
        class="btn-primary mt-5"
        data-action="save-proxy"
      >
        Save proxy
      </button>
      <p id="proxy-status" class="mt-3 hidden text-sm" role="status"></p>
    </section>

    <!-- Wave 1119+ founder-priority bump (2026-05-16): OpenVPN form
         lit on the dashboard ahead of the harness VM lifecycle so
         customers can stage configs + the server-side validation
         (api-types/egress.ts OpenVpnProxyConfigSchema `client` +
         `remote` directive checks) returns useful errors at the
         API boundary instead of failing inside the per-session VM. -->
    <section class="mb-12 dashboard-card" data-create-openvpn-form>
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 11.8 4.2-1.1 8-6.3 8-11.8V5l-8-3z" />
          </svg>
        </span>
        Add an OpenVPN proxy
      </h2>
      <p class="mt-1 text-sm text-ink-muted">
        Paste the full <code class="font-mono">.ovpn</code> file contents.
        We validate at upload time and parse the full config when a session
        attaches. Max 256 KB.
      </p>
      <div class="mt-5 grid gap-4">
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">Label</span>
          <input
            id="ovpn-label"
            type="text"
            maxlength="120"
            placeholder="team OpenVPN — eu-west"
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-ink-secondary">.ovpn config</span>
          <textarea
            id="ovpn-blob"
            rows="8"
            maxlength="262144"
            placeholder="client&#10;dev tun&#10;remote vpn.example.com 1194&#10;cipher AES-256-GCM&#10;..."
            class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 font-mono text-xs focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
          ></textarea>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="block text-sm font-medium text-ink-secondary">Username (optional)</span>
            <input
              id="ovpn-username"
              type="text"
              maxlength="256"
              autocomplete="off"
              class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
            />
          </label>
          <label class="block">
            <span class="block text-sm font-medium text-ink-secondary">Password (optional)</span>
            <input
              id="ovpn-password"
              type="password"
              maxlength="256"
              autocomplete="new-password"
              class="mt-1 block w-full rounded-md border border-white/15 px-3 py-2 text-sm focus:border-glow-red focus:outline-none focus:ring-1 focus:ring-glow-red"
            />
          </label>
        </div>
      </div>
      <button
        id="ovpn-save-btn"
        type="button"
        class="btn-primary mt-5"
        data-action="save-openvpn"
      >
        Save OpenVPN config
      </button>
      <p id="ovpn-status" class="mt-3 hidden text-sm" role="status"></p>
    </section>

    <section class="mb-12 grid gap-4 sm:grid-cols-2">
      <div class="dashboard-card opacity-70">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">Phase 2</h3>
        <p class="mt-1 text-base font-medium text-ink-primary">OpenVPN — VM harness</p>
        <p class="mt-1 text-xs text-ink-muted">
          Form above accepts <code class="font-mono">.ovpn</code> uploads
          (validation lit). Each session runs in its own Apple
          Virtualization.framework Lightweight VM with OpenVPN client +
          per-session TUN. VM harness ships separately.
        </p>
      </div>
      <div class="dashboard-card opacity-70">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-ink-muted">Phase 3</h3>
        <p class="mt-1 text-base font-medium text-ink-primary">WireGuard</p>
        <p class="mt-1 text-xs text-ink-muted">
          curve25519 keys + endpoint. Same per-session VM as OpenVPN with
          WireGuard client. Ships after Phase 2 OpenVPN stabilizes.
        </p>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="proxies"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const empty = root.querySelector('[data-empty="proxies"]');
      const list = root.querySelector('[data-list="proxies"]');
      const saveBtn = root.querySelector('[data-action="save-proxy"]');
      const status = root.querySelector('#proxy-status');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function setStatus(message, kind) {
        if (!status) return;
        status.classList.remove('hidden', 'text-emerald-300', 'text-red-300', 'text-ink-secondary');
        status.classList.add(
          kind === 'success'
            ? 'text-emerald-300'
            : kind === 'error'
              ? 'text-red-300'
              : 'text-ink-secondary',
        );
        status.textContent = message;
      }

      function renderList(items) {
        if (!list || !empty) return;
        if (items.length === 0) {
          empty.textContent = 'No saved proxies yet.';
          empty.classList.remove('hidden');
          list.classList.add('hidden');
          return;
        }
        empty.classList.add('hidden');
        list.classList.remove('hidden');
        list.innerHTML = items
          .map(
            (p) =>
              '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
              '<div class="min-w-0">' +
              '<p class="text-sm font-medium text-ink-primary">' +
              escapeHtml(p.label) +
              '</p>' +
              '<p class="mt-1 text-xs text-ink-muted">type ' +
              '<code class="font-mono">' +
              escapeHtml(p.type) +
              '</code> · id ' +
              '<code class="font-mono">' +
              escapeHtml(p.id) +
              '</code>' +
              '</p></div>' +
              '<button type="button" data-action="delete-proxy" data-id="' +
              escapeHtml(p.id) +
              '" class="text-sm text-red-700 hover:underline">Delete</button>' +
              '</li>',
          )
          .join('');
      }

      function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) =>
          c === '&'
            ? '&amp;'
            : c === '<'
              ? '&lt;'
              : c === '>'
                ? '&gt;'
                : c === '"'
                  ? '&quot;'
                  : '&#39;',
        );
      }

      async function fetchList() {
        if (!token) {
          showBanner('Sign in to manage saved proxies.');
          renderList([]);
          // 2026-05-21 — opacity-gate hydrate signal even when we
          // short-circuited on missing token; otherwise the page sits
          // at opacity:0 until the 1200ms safety cap.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
          return;
        }
        try {
          const res = await fetch(apiBaseUrl + '/v1/proxies', {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const body = await res.json();
          renderList(body.data || []);
        } catch (err) {
          renderList([]);
          showBanner('Could not load saved proxies (' + ((err && err.message) || 'network') + ').');
        } finally {
          // 2026-05-21 — same opacity-gate signal (success / failure
          // both reach here; the renderList call has run either way).
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        }
      }

      function readNumber(id) {
        const el = root.querySelector('#' + id);
        const v = el && el.value ? Number(el.value) : NaN;
        return Number.isFinite(v) ? v : null;
      }
      function readString(id) {
        const el = root.querySelector('#' + id);
        return el && el.value ? el.value.trim() : '';
      }

      saveBtn?.addEventListener('click', async () => {
        const label = readString('proxy-label');
        const host = readString('proxy-host');
        const port = readNumber('proxy-port');
        const username = readString('proxy-username');
        const password = readString('proxy-password');
        const udpEl = root.querySelector('#proxy-udp');
        const udp_associate = udpEl ? udpEl.checked : true;
        if (!label || !host || port === null) {
          setStatus('Label, host, and port are required.', 'error');
          return;
        }
        if (!token) {
          setStatus('Sign in first.', 'error');
          return;
        }
        saveBtn.setAttribute('disabled', 'true');
        setStatus('Saving…', 'pending');
        try {
          const body = {
            label,
            proxy: {
              type: 'socks5',
              socks5: {
                host,
                port,
                udp_associate,
                ...(username ? { username } : {}),
                ...(password ? { password } : {}),
              },
            },
          };
          const res = await fetch(apiBaseUrl + '/v1/proxies', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          if (res.status === 503) {
            const errBody = await res.json().catch(() => ({}));
            setStatus(
              errBody.detail ||
                'Saved-proxy storage is not yet wired on this server. Check back after the EGRESS Phase 1 backend ships.',
              'error',
            );
          } else if (!res.ok) {
            const errBody = await res.json().catch(() => ({}));
            setStatus(errBody.detail || 'Save failed (HTTP ' + res.status + ').', 'error');
          } else {
            setStatus('Saved.', 'success');
            await fetchList();
          }
        } catch (err) {
          setStatus(
            'Could not reach the API (' + ((err && err.message) || 'network') + ').',
            'error',
          );
        } finally {
          saveBtn.removeAttribute('disabled');
        }
      });

      // Wave 1119+ founder-priority OpenVPN form. Same POST /v1/proxies
      // contract as SOCKS5 — body shape is { label, proxy: {
      // type:'openvpn', openvpn:{ config_blob, username?, password? }
      // } }. Server-side validation (api-types egress.ts directive
      // checks) surfaces missing `client` / `remote` errors here.
      const ovpnSaveBtn = root.querySelector('[data-action="save-openvpn"]');
      const ovpnStatus = root.querySelector('#ovpn-status');

      function setOvpnStatus(message, kind) {
        if (!ovpnStatus) return;
        ovpnStatus.classList.remove(
          'hidden',
          'text-emerald-300',
          'text-red-300',
          'text-ink-secondary',
        );
        ovpnStatus.classList.add(
          kind === 'success'
            ? 'text-emerald-300'
            : kind === 'error'
              ? 'text-red-300'
              : 'text-ink-secondary',
        );
        ovpnStatus.textContent = message;
      }

      ovpnSaveBtn?.addEventListener('click', async () => {
        const label = readString('ovpn-label');
        const blob = readString('ovpn-blob');
        const username = readString('ovpn-username');
        const password = readString('ovpn-password');
        if (!label || !blob) {
          setOvpnStatus('Label and .ovpn config are required.', 'error');
          return;
        }
        if (!token) {
          setOvpnStatus('Sign in first.', 'error');
          return;
        }
        ovpnSaveBtn.setAttribute('disabled', 'true');
        setOvpnStatus('Saving…', 'pending');
        try {
          const body = {
            label,
            proxy: {
              type: 'openvpn',
              openvpn: {
                config_blob: blob,
                ...(username ? { username } : {}),
                ...(password ? { password } : {}),
              },
            },
          };
          const res = await fetch(apiBaseUrl + '/v1/proxies', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          if (res.status === 503) {
            const errBody = await res.json().catch(() => ({}));
            setOvpnStatus(
              errBody.detail ||
                'Saved-proxy storage is not yet wired on this server. Check back after the EGRESS Phase 1 backend ships.',
              'error',
            );
          } else if (res.status === 400) {
            const errBody = await res.json().catch(() => ({}));
            setOvpnStatus(
              errBody.detail ||
                'OpenVPN config rejected — check that `client` and `remote <host> <port>` directives are present.',
              'error',
            );
          } else if (!res.ok) {
            const errBody = await res.json().catch(() => ({}));
            setOvpnStatus(errBody.detail || 'Save failed (HTTP ' + res.status + ').', 'error');
          } else {
            setOvpnStatus('Saved.', 'success');
            await fetchList();
          }
        } catch (err) {
          setOvpnStatus(
            'Could not reach the API (' + ((err && err.message) || 'network') + ').',
            'error',
          );
        } finally {
          ovpnSaveBtn.removeAttribute('disabled');
        }
      });

      // Delegated delete handler.
      list?.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const btn = target.closest('[data-action="delete-proxy"]');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        if (!id || !token) return;
        if (!window.confirm('Delete this saved proxy?')) return;
        try {
          const res = await fetch(apiBaseUrl + '/v1/proxies/' + encodeURIComponent(id), {
            method: 'DELETE',
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          });
          if (res.status === 503) {
            const errBody = await res.json().catch(() => ({}));
            showBanner(
              errBody.detail ||
                'Saved-proxy delete not yet wired (no backend). Check back after EGRESS Phase 1.',
            );
          } else if (!res.ok && res.status !== 204) {
            showBanner('Delete failed (HTTP ' + res.status + ').');
          } else {
            await fetchList();
          }
        } catch (err) {
          showBanner('Could not reach the API (' + ((err && err.message) || 'network') + ').');
        }
      });

      fetchList();
    })();
  </script>
</DashboardLayout>
