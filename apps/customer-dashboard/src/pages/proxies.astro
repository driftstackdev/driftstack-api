---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { resolveApiBaseUrl } from '../lib/api-base-url';

// Customer-facing /proxies page — a library of saved SOCKS5 / OpenVPN
// configs the customer can attach to a session. Wired against the LIVE
// account-proxies API (/v1/account/me/proxies: GET list, POST create,
// DELETE, POST :id/test) — the same backend the desktop app uses, so a
// proxy added here shows up there and vice-versa. (Superseded the old
// /v1/proxies saved-proxies stub, which 503'd "not yet shipped".)
//
// Progressive-enhancement pattern same as the other dashboard pages:
// SSG renders the list + create forms; the inline <script> wires fetch
// with web-session-token Bearer auth (ds_web_session_token). Secrets
// (passwords / .ovpn config) are write-only — wrapped server-side under
// the account key, never echoed back.

const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Proxies">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="proxies">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    ></div>

    <header class="mb-10">
      <p class="text-sm text-tk-ink-3">Egress</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Proxies</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Saved proxy configurations you can attach to a session. Sessions
        route all browser traffic through the attached proxy — the target
        site sees the proxy's IP, not Driftstack's Mac-fleet IP. SOCKS5
        with full UDP ASSOCIATE for WebRTC/QUIC, plus OpenVPN (.ovpn) and
        WireGuard (.conf) configs per profile.
      </p>
    </header>

    <section class="mb-12 dashboard-card">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 4v16" />
          </svg>
        </span>
        Saved configs
      </h2>
      <p class="mt-1 text-sm text-tk-ink-3">
        Reusable proxy configs you've saved. The raw secret material
        (passwords / private keys) is never shown after save — re-enter to
        update.
      </p>
      {/* 2026-05-24 — skeleton row for hydrate-state polish. JS hides
          this on fetch + reveals data-list (or surfaces empty state). */}
      <div data-empty="proxies" class="mt-4 space-y-2">
        <div class="rounded-lg border border-tk-border bg-tk-surface px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="h-3 w-32 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-20 animate-pulse rounded bg-tk-hover"></div>
          </div>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="h-3 w-28 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-24 animate-pulse rounded bg-tk-hover"></div>
          </div>
        </div>
      </div>
      <ul
        data-list="proxies"
        class="mt-4 hidden divide-y divide-slate-200 rounded-lg border border-tk-border bg-tk-surface"
      ></ul>
    </section>

    <section class="mb-12 dashboard-card" data-create-form>
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
        </span>
        Add a SOCKS5 proxy
      </h2>
      <p class="mt-1 text-sm text-tk-ink-3">
        The proxy must support UDP ASSOCIATE so WebRTC traffic routes
        through it; TCP-only SOCKS5 leaks media flows directly.
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Label</span>
          <input
            id="proxy-label"
            type="text"
            maxlength="120"
            placeholder="team SOCKS5 — london"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Host</span>
          <input
            id="proxy-host"
            type="text"
            maxlength="253"
            placeholder="proxy.example.com"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Port</span>
          <input
            id="proxy-port"
            type="number"
            min="1"
            max="65535"
            placeholder="1080"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Username (optional)</span>
          <input
            id="proxy-username"
            type="text"
            maxlength="256"
            autocomplete="off"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Password (optional)</span>
          <input
            id="proxy-password"
            type="password"
            maxlength="256"
            autocomplete="new-password"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
      </div>
      <button
        id="proxy-save-btn"
        type="button"
        class="btn-primary mt-5"
        data-action="save-proxy"
      >
        Save proxy
      </button>
      <p id="proxy-status" class="mt-3 hidden text-sm" role="status"></p>
    </section>

    <!-- Wave 1119+ founder-priority bump (2026-05-16): OpenVPN form
         lit on the dashboard ahead of the harness VM lifecycle so
         customers can stage configs + the server-side validation
         (api-types/egress.ts OpenVpnProxyConfigSchema `client` +
         `remote` directive checks) returns useful errors at the
         API boundary instead of failing inside the per-session VM. -->
    <section class="mb-12 dashboard-card" data-create-openvpn-form>
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 11.8 4.2-1.1 8-6.3 8-11.8V5l-8-3z" />
          </svg>
        </span>
        Add an OpenVPN proxy
      </h2>
      <p class="mt-1 text-sm text-tk-ink-3">
        Paste the full <code class="font-mono">.ovpn</code> file contents.
        We validate at upload time and parse the full config when a session
        attaches. Max 256 KB.
      </p>
      <div class="mt-5 grid gap-4">
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Label</span>
          <input
            id="ovpn-label"
            type="text"
            maxlength="120"
            placeholder="team OpenVPN — eu-west"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">.ovpn config</span>
          <textarea
            id="ovpn-blob"
            rows="8"
            maxlength="262144"
            placeholder="client&#10;dev tun&#10;remote vpn.example.com 1194&#10;cipher AES-256-GCM&#10;..."
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 font-mono text-xs focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          ></textarea>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="block text-sm font-medium text-tk-ink-2">Username (optional)</span>
            <input
              id="ovpn-username"
              type="text"
              maxlength="256"
              autocomplete="off"
              class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            />
          </label>
          <label class="block">
            <span class="block text-sm font-medium text-tk-ink-2">Password (optional)</span>
            <input
              id="ovpn-password"
              type="password"
              maxlength="256"
              autocomplete="new-password"
              class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            />
          </label>
        </div>
      </div>
      <button
        id="ovpn-save-btn"
        type="button"
        class="btn-primary mt-5"
        data-action="save-openvpn"
      >
        Save OpenVPN config
      </button>
      <p id="ovpn-status" class="mt-3 hidden text-sm" role="status"></p>
    </section>

    <section class="mb-12 dashboard-card" data-create-wireguard-form>
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 11.8 4.2-1.1 8-6.3 8-11.8V5l-8-3z" /><path d="M9 12l2 2 4-4" />
          </svg>
        </span>
        Add a WireGuard proxy
      </h2>
      <p class="mt-1 text-sm text-tk-ink-3">
        Paste the full <code class="font-mono">wg0.conf</code>. We extract the
        keys, peer endpoint, and interface address; the private key is stored
        write-only (wrapped server-side, never shown again). Max 16 KB.
      </p>
      <div class="mt-5 grid gap-4">
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">Label</span>
          <input
            id="wg-label"
            type="text"
            maxlength="120"
            placeholder="team WireGuard — nyc"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-tk-ink-2">wg0.conf</span>
          <textarea
            id="wg-conf"
            rows="9"
            maxlength="16384"
            placeholder="[Interface]&#10;PrivateKey = ...&#10;Address = 10.7.0.2/32&#10;DNS = 1.1.1.1&#10;[Peer]&#10;PublicKey = ...&#10;Endpoint = vpn.example.com:51820&#10;AllowedIPs = 0.0.0.0/0"
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 font-mono text-xs focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          ></textarea>
        </label>
      </div>
      <button
        id="wg-save-btn"
        type="button"
        class="btn-primary mt-5"
        data-action="save-wireguard"
      >
        Save WireGuard config
      </button>
      <p id="wg-status" class="mt-3 hidden text-sm" role="status"></p>
    </section>

    <section class="mb-12 grid gap-4 sm:grid-cols-2">
      <div class="dashboard-card opacity-70">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-tk-ink-3">Phase 2</h3>
        <p class="mt-1 text-base font-medium text-tk-ink">OpenVPN — VM harness</p>
        <p class="mt-1 text-xs text-tk-ink-3">
          Form above accepts <code class="font-mono">.ovpn</code> uploads
          (validation lit). Each session runs in its own Apple
          Virtualization.framework Lightweight VM with OpenVPN client +
          per-session TUN. VM harness ships separately.
        </p>
      </div>
      <div class="dashboard-card opacity-70">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-tk-ink-3">Phase 3</h3>
        <p class="mt-1 text-base font-medium text-tk-ink">WireGuard</p>
        <p class="mt-1 text-xs text-tk-ink-3">
          Form above accepts <code class="font-mono">wg0.conf</code> uploads
          (curve25519 keys + endpoint parsed client-side). Same per-session
          Apple Virtualization.framework VM as OpenVPN with a WireGuard client +
          per-session TUN. VM harness ships separately.
        </p>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="proxies"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const empty = root.querySelector('[data-empty="proxies"]');
      const list = root.querySelector('[data-list="proxies"]');
      const saveBtn = root.querySelector('[data-action="save-proxy"]');
      const status = root.querySelector('#proxy-status');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function setStatus(message, kind) {
        if (!status) return;
        status.classList.remove('hidden', 'text-emerald-300', 'text-red-300', 'text-tk-ink-2');
        status.classList.add(
          kind === 'success'
            ? 'text-emerald-300'
            : kind === 'error'
              ? 'text-red-300'
              : 'text-tk-ink-2',
        );
        status.textContent = message;
      }

      function renderList(items) {
        if (!list || !empty) return;
        if (items.length === 0) {
          empty.textContent = 'No saved proxies yet.';
          empty.classList.remove('hidden');
          list.classList.add('hidden');
          return;
        }
        empty.classList.add('hidden');
        list.classList.remove('hidden');
        list.innerHTML = items
          .map(
            (p) =>
              '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
              '<div class="min-w-0">' +
              '<p class="text-sm font-medium text-tk-ink">' +
              escapeHtml(p.label) +
              '</p>' +
              '<p class="mt-1 text-xs text-tk-ink-3">' +
              '<code class="font-mono">' +
              escapeHtml(p.scheme) +
              '</code> · ' +
              '<code class="font-mono">' +
              escapeHtml(p.host) +
              ':' +
              escapeHtml(p.port) +
              '</code>' +
              (p.username ? ' · ' + escapeHtml(p.username) : '') +
              (p.has_secret ? ' · 🔒 config' : p.has_password ? ' · 🔒 auth' : '') +
              '</p>' +
              '<p class="mt-1 hidden text-xs" data-test-result="' +
              escapeHtml(p.id) +
              '" role="status"></p></div>' +
              '<div class="flex shrink-0 items-center gap-3">' +
              '<button type="button" data-action="test-proxy" data-id="' +
              escapeHtml(p.id) +
              '" class="text-sm text-tk-ink-2 hover:text-tk-ink hover:underline">Test</button>' +
              '<button type="button" data-action="delete-proxy" data-id="' +
              escapeHtml(p.id) +
              '" class="text-sm text-red-700 hover:underline">Delete</button>' +
              '</div></li>',
          )
          .join('');
      }

      // A transient load failure (5xx / 401 / network blip) is NOT the
      // same thing as "you have zero saved proxies" — these are egress
      // credentials the customer relies on, and rendering the empty
      // state on a load error reads as data loss. Reserve renderList's
      // empty branch strictly for a successful 200 with an empty array;
      // a failed fetch renders this distinct retry-capable error row
      // instead (matches the sessions.astro pattern of never zeroing
      // the list to a fabricated empty state on failure).
      function renderLoadError() {
        if (!list || !empty) return;
        list.classList.add('hidden');
        empty.classList.remove('hidden');
        empty.innerHTML =
          '<div class="rounded-lg border border-tk-border bg-tk-surface px-4 py-3 text-sm text-tk-ink-2">' +
          "Couldn't load your saved proxies. " +
          '<button type="button" data-action="retry-proxies" class="text-tk-accent underline">Retry</button>' +
          '</div>';
        const retryBtn = empty.querySelector('[data-action="retry-proxies"]');
        if (retryBtn) retryBtn.addEventListener('click', () => fetchList());
      }

      function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) =>
          c === '&'
            ? '&amp;'
            : c === '<'
              ? '&lt;'
              : c === '>'
                ? '&gt;'
                : c === '"'
                  ? '&quot;'
                  : '&#39;',
        );
      }

      async function fetchList() {
        if (!token) {
          showBanner('Sign in to manage saved proxies.');
          renderList([]);
          // 2026-05-21 — opacity-gate hydrate signal even when we
          // short-circuited on missing token; otherwise the page sits
          // at opacity:0 until the 1200ms safety cap.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
          return;
        }
        try {
          const res = await fetch(apiBaseUrl + '/v1/account/me/proxies', {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const body = await res.json();
          renderList(body.data || []);
        } catch (err) {
          renderLoadError();
          showBanner('Could not load saved proxies (' + ((err && err.message) || 'network') + ').');
        } finally {
          // 2026-05-21 — same opacity-gate signal (success / failure
          // both reach here; the renderList call has run either way).
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        }
      }

      function readNumber(id) {
        const el = root.querySelector('#' + id);
        const v = el && el.value ? Number(el.value) : NaN;
        return Number.isFinite(v) ? v : null;
      }
      function readString(id) {
        const el = root.querySelector('#' + id);
        return el && el.value ? el.value.trim() : '';
      }
      // After a successful save the form fields stay populated with no
      // server-side dedup on (scheme, host, port) — a customer who
      // misses the small 'Saved.' status line will likely click Save
      // again and create a duplicate. Clear the relevant inputs once
      // the list has refreshed so 'Saved.' reads as a completed action.
      function clearFields(ids) {
        ids.forEach((id) => {
          const el = root.querySelector('#' + id);
          if (el) el.value = '';
        });
      }

      saveBtn?.addEventListener('click', async () => {
        const label = readString('proxy-label');
        const host = readString('proxy-host');
        const port = readNumber('proxy-port');
        const username = readString('proxy-username');
        const password = readString('proxy-password');
        if (!label || !host || port === null) {
          setStatus('Label, host, and port are required.', 'error');
          return;
        }
        // The <input min="1" max="65535"> only constrains the native
        // stepper/submit-validation UI — this button click handler reads
        // el.value directly, so a typed 0 / negative / >65535 port sailed
        // straight past that and only got caught (unfriendly, post-round-
        // trip) by the server's Zod bound.
        if (!Number.isInteger(port) || port < 1 || port > 65535) {
          setStatus('Port must be a whole number between 1 and 65535.', 'error');
          return;
        }
        if (!token) {
          setStatus('Sign in first.', 'error');
          return;
        }
        saveBtn.setAttribute('disabled', 'true');
        setStatus('Saving…', 'pending');
        try {
          // Live account-proxies API (/v1/account/me/proxies): a flat body,
          // scheme-tagged. password is write-only (wrapped server-side).
          const body = {
            label,
            scheme: 'socks5',
            host,
            port,
            username: username || null,
            password: password || null,
          };
          const res = await fetch(apiBaseUrl + '/v1/account/me/proxies', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          if (!res.ok) {
            const errBody = await res.json().catch(() => ({}));
            setStatus(errBody.detail || 'Save failed (HTTP ' + res.status + ').', 'error');
          } else {
            setStatus('Saved.', 'success');
            await fetchList();
            clearFields(['proxy-label', 'proxy-host', 'proxy-port', 'proxy-username', 'proxy-password']);
          }
        } catch (err) {
          setStatus(
            'Could not reach the API (' + ((err && err.message) || 'network') + ').',
            'error',
          );
        } finally {
          saveBtn.removeAttribute('disabled');
        }
      });

      // Founder-priority OpenVPN form. Same live account-proxies API as
      // SOCKS5 — flat body { label, scheme:'openvpn', host, port,
      // openvpn:{ config_blob, username?, password? } }; host/port are the
      // VPN endpoint parsed from the `remote` directive. Server-side
      // validation (api-types egress.ts directive checks) surfaces missing
      // `client` / `remote` errors here.
      const ovpnSaveBtn = root.querySelector('[data-action="save-openvpn"]');
      const ovpnStatus = root.querySelector('#ovpn-status');

      function setOvpnStatus(message, kind) {
        if (!ovpnStatus) return;
        ovpnStatus.classList.remove(
          'hidden',
          'text-emerald-300',
          'text-red-300',
          'text-tk-ink-2',
        );
        ovpnStatus.classList.add(
          kind === 'success'
            ? 'text-emerald-300'
            : kind === 'error'
              ? 'text-red-300'
              : 'text-tk-ink-2',
        );
        ovpnStatus.textContent = message;
      }

      ovpnSaveBtn?.addEventListener('click', async () => {
        const label = readString('ovpn-label');
        const blob = readString('ovpn-blob');
        const username = readString('ovpn-username');
        const password = readString('ovpn-password');
        if (!label || !blob) {
          setOvpnStatus('Label and .ovpn config are required.', 'error');
          return;
        }
        if (!token) {
          setOvpnStatus('Sign in first.', 'error');
          return;
        }
        // The live API stores the VPN endpoint as host:port (extracted from the
        // `remote <host> <port>` directive — defaults to 1194 when the port is
        // omitted). Surface the missing-remote case before the round-trip.
        const remoteMatch = /^[ \t]*remote[ \t]+(\S+)(?:[ \t]+(\d+))?/m.exec(blob);
        if (!remoteMatch) {
          setOvpnStatus(
            'OpenVPN config needs a `remote <host> <port>` directive (the VPN endpoint).',
            'error',
          );
          return;
        }
        const ovpnHost = remoteMatch[1];
        const ovpnPort = remoteMatch[2] ? Number(remoteMatch[2]) : 1194;
        ovpnSaveBtn.setAttribute('disabled', 'true');
        setOvpnStatus('Saving…', 'pending');
        try {
          const body = {
            label,
            scheme: 'openvpn',
            host: ovpnHost,
            port: ovpnPort,
            openvpn: {
              config_blob: blob,
              ...(username ? { username } : {}),
              ...(password ? { password } : {}),
            },
          };
          const res = await fetch(apiBaseUrl + '/v1/account/me/proxies', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          if (res.status === 400) {
            const errBody = await res.json().catch(() => ({}));
            setOvpnStatus(
              errBody.detail ||
                'OpenVPN config rejected — check that `client` and `remote <host> <port>` directives are present.',
              'error',
            );
          } else if (!res.ok) {
            const errBody = await res.json().catch(() => ({}));
            setOvpnStatus(errBody.detail || 'Save failed (HTTP ' + res.status + ').', 'error');
          } else {
            setOvpnStatus('Saved.', 'success');
            await fetchList();
            clearFields(['ovpn-label', 'ovpn-blob', 'ovpn-username', 'ovpn-password']);
          }
        } catch (err) {
          setOvpnStatus(
            'Could not reach the API (' + ((err && err.message) || 'network') + ').',
            'error',
          );
        } finally {
          ovpnSaveBtn.removeAttribute('disabled');
        }
      });

      // WireGuard form. Parse the pasted wg0.conf client-side (mirrors the
      // desktop app's parse-wireguard) into the structured WireGuardProxyConfig,
      // then POST the flat account-proxies body { label, scheme:'wireguard',
      // host, port, wireguard:{ private_key, peer_public_key, endpoint,
      // allowed_ips, address, dns? } }. host/port = the peer Endpoint host:port.
      const wgSaveBtn = root.querySelector('[data-action="save-wireguard"]');
      const wgStatus = root.querySelector('#wg-status');
      const WG_KEY_RE = /^[A-Za-z0-9+/]{43}=$/;
      const WG_ENDPOINT_RE = /^[A-Za-z0-9.\-:_]+:[0-9]{1,5}$/;

      function setWgStatus(message, kind) {
        if (!wgStatus) return;
        wgStatus.classList.remove('hidden', 'text-emerald-300', 'text-red-300', 'text-tk-ink-2');
        wgStatus.classList.add(
          kind === 'success'
            ? 'text-emerald-300'
            : kind === 'error'
              ? 'text-red-300'
              : 'text-tk-ink-2',
        );
        wgStatus.textContent = message;
      }

      // Pure wg0.conf → structured fields (or null). INI-style; first occurrence
      // of each key wins; comments (# / ;) + section headers skipped.
      function parseWgConf(text) {
        const values = {};
        for (const raw of String(text).split(/\r?\n/)) {
          const line = raw.trim();
          if (!line || line[0] === '#' || line[0] === ';' || line[0] === '[') continue;
          const eq = line.indexOf('=');
          if (eq === -1) continue;
          const key = line.slice(0, eq).trim().toLowerCase();
          const value = line.slice(eq + 1).trim();
          if (key && value && !(key in values)) values[key] = value;
        }
        const privateKey = values['privatekey'] || '';
        const peerPublicKey = values['publickey'] || '';
        const endpoint = values['endpoint'] || '';
        const allowedIps = values['allowedips'] || '0.0.0.0/0';
        const address = values['address'] || '';
        const dns = values['dns'];
        if (!WG_KEY_RE.test(privateKey)) return null;
        if (!WG_KEY_RE.test(peerPublicKey)) return null;
        if (!WG_ENDPOINT_RE.test(endpoint)) return null;
        if (!address) return null;
        const out = {
          private_key: privateKey,
          peer_public_key: peerPublicKey,
          endpoint,
          allowed_ips: allowedIps,
          address,
        };
        if (dns) out.dns = dns;
        return out;
      }

      wgSaveBtn?.addEventListener('click', async () => {
        const label = readString('wg-label');
        const conf = readString('wg-conf');
        if (!label || !conf) {
          setWgStatus('Label and wg0.conf are required.', 'error');
          return;
        }
        if (!token) {
          setWgStatus('Sign in first.', 'error');
          return;
        }
        const wg = parseWgConf(conf);
        if (!wg) {
          setWgStatus(
            'Could not parse wg0.conf — need PrivateKey, [Peer] PublicKey, Endpoint host:port, and an Interface Address.',
            'error',
          );
          return;
        }
        const lastColon = wg.endpoint.lastIndexOf(':');
        const wgHost = wg.endpoint.slice(0, lastColon);
        const wgPort = Number(wg.endpoint.slice(lastColon + 1));
        wgSaveBtn.setAttribute('disabled', 'true');
        setWgStatus('Saving…', 'pending');
        try {
          const body = { label, scheme: 'wireguard', host: wgHost, port: wgPort, wireguard: wg };
          const res = await fetch(apiBaseUrl + '/v1/account/me/proxies', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          if (res.status === 400) {
            const errBody = await res.json().catch(() => ({}));
            setWgStatus(errBody.detail || 'WireGuard config rejected — check the keys + endpoint.', 'error');
          } else if (!res.ok) {
            const errBody = await res.json().catch(() => ({}));
            setWgStatus(errBody.detail || 'Save failed (HTTP ' + res.status + ').', 'error');
          } else {
            setWgStatus('Saved.', 'success');
            await fetchList();
            clearFields(['wg-label', 'wg-conf']);
          }
        } catch (err) {
          setWgStatus('Could not reach the API (' + ((err && err.message) || 'network') + ').', 'error');
        } finally {
          wgSaveBtn.removeAttribute('disabled');
        }
      });

      // Delegated delete handler.
      list?.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        // Test button: POST /v1/account/me/proxies/:id/test — a server-side
        // TCP-reachability probe (SSRF-guarded). Surfaces reachable+latency or
        // unreachable+reason inline per-row.
        const testBtn = target.closest('[data-action="test-proxy"]');
        if (testBtn) {
          const tid = testBtn.getAttribute('data-id');
          if (!tid || !token) return;
          const resultEl = root.querySelector('[data-test-result="' + tid + '"]');
          testBtn.setAttribute('disabled', 'true');
          if (resultEl) {
            resultEl.classList.remove('hidden', 'text-emerald-300', 'text-red-300');
            resultEl.classList.add('text-tk-ink-3');
            resultEl.textContent = 'Testing reachability…';
          }
          try {
            const res = await fetch(
              apiBaseUrl + '/v1/account/me/proxies/' + encodeURIComponent(tid) + '/test',
              {
                method: 'POST',
                headers: { authorization: 'Bearer ' + token },
                credentials: 'include',
              },
            );
            if (resultEl) {
              // Server-side TCP-reachability probe: 200 with { ok, latency_ms }
              // on success, { ok:false, reason } on an unreachable proxy.
              const b = await res.json().catch(() => ({}));
              if (res.ok && b.ok) {
                resultEl.classList.remove('text-tk-ink-3', 'text-red-300');
                resultEl.classList.add('text-emerald-300');
                resultEl.textContent =
                  'Reachable' +
                  (typeof b.latency_ms === 'number' ? ' · ' + b.latency_ms + 'ms' : '');
              } else {
                resultEl.classList.remove('text-tk-ink-3', 'text-emerald-300');
                resultEl.classList.add('text-red-300');
                resultEl.textContent =
                  'Unreachable' + (b.reason ? ' · ' + b.reason : b.detail ? ' · ' + b.detail : '');
              }
            }
          } catch (err) {
            if (resultEl) {
              resultEl.classList.remove('text-tk-ink-3');
              resultEl.classList.add('text-red-300');
              resultEl.textContent = 'Could not reach the test endpoint (' + ((err && err.message) || 'network') + ').';
            }
          } finally {
            testBtn.removeAttribute('disabled');
          }
          return;
        }

        const btn = target.closest('[data-action="delete-proxy"]');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        if (!id || !token) return;
        if (!(await window.driftstackConfirm('Delete this saved proxy?', { confirmLabel: 'Delete' })))
          return;
        try {
          const res = await fetch(
            apiBaseUrl + '/v1/account/me/proxies/' + encodeURIComponent(id),
            {
              method: 'DELETE',
              headers: { authorization: 'Bearer ' + token },
              credentials: 'include',
            },
          );
          if (!res.ok && res.status !== 204) {
            showBanner('Delete failed (HTTP ' + res.status + ').');
          } else {
            await fetchList();
          }
        } catch (err) {
          showBanner('Could not reach the API (' + ((err && err.message) || 'network') + ').');
        }
      });

      fetchList();
    })();
  </script>
</DashboardLayout>
