---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { MOCK_USAGE_SUMMARY } from '../data/mocks.ts';

// V-171 — page progressively enhances from mock-rendered SSG to
// real /v1/usage + /v1/usage/series fetches via inline <script>.
// Render path:
//   1. Astro emits the static HTML using MOCK_USAGE_SUMMARY (below).
//      User sees mock numbers immediately while JS loads.
//   2. <script is:inline> runs on DOMContentLoaded, reads
//      `ds_web_session_token` from localStorage.
//   3. Token present → fetch totals (/v1/usage) + series
//      (/v1/usage/series?days=30) with credentials, replace DOM.
//   4. Token absent → small banner: "Sign in to see live usage."
//      Mock data stays visible as preview. (Production: signup/login
//      UI sets the token; not yet wired — V-NNN follow-on.)
//   5. Fetch fails (network / 401 / 5xx) → small banner
//      "Couldn't load live usage. Showing preview data." Mock stays.
//
// Config: PUBLIC_API_BASE_URL (Astro public env). See
// `src/lib/api-base-url.ts` — dev falls back to localhost:3000;
// prod builds fail fast when the env var is unset (W192).
//
// Today usage_records writers aren't wired (V-014/V-015 amendment),
// so /v1/usage + /v1/usage/series return zeros for everyone. The
// fetch path is real; the data is empty until writers land.

function fmtIsoDay(iso: string): string {
  return new Date(iso).toISOString().slice(0, 10);
}

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

// Mock 30-day series for sparklines. Real source: /v1/usage with
// daily aggregation. Generated deterministically (no Math.random)
// so the rendered SVG is stable across page loads at scaffolding
// time — easier to spot real-data integration regressions later.
function mockSeries(seedBase: number, length: number): number[] {
  const out: number[] = [];
  for (let i = 0; i < length; i += 1) {
    const v = Math.round(seedBase + Math.sin(i * 0.6) * (seedBase * 0.4) + i * (seedBase * 0.02));
    out.push(Math.max(0, v));
  }
  return out;
}

const SERIES_LENGTH = 30;
const series = {
  navigates: mockSeries(40, SERIES_LENGTH),
  interacts: mockSeries(180, SERIES_LENGTH),
  captures: mockSeries(12, SERIES_LENGTH),
  session_minutes: mockSeries(15, SERIES_LENGTH),
};

function sparklinePath(values: number[], width: number, height: number): string {
  if (values.length === 0) return '';
  const max = Math.max(...values, 1);
  const stepX = width / (values.length - 1);
  return values
    .map((v, i) => {
      const x = i * stepX;
      const y = height - (v / max) * height;
      return `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .join(' ');
}

const SPARK_W = 200;
const SPARK_H = 48;
---

<DashboardLayout title="Usage">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="usage">
    <header class="mb-10">
      <p class="text-sm text-tk-ink-3" data-field="period">
        {fmtIsoDay(MOCK_USAGE_SUMMARY.period_start)} → {fmtIsoDay(MOCK_USAGE_SUMMARY.period_end)} ·
        <span data-field="tier">{MOCK_USAGE_SUMMARY.tier}</span> tier
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Usage</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Per-resource counts for the current billing period. None of these
        are billed individually — concurrent cap is the only meter. These
        numbers help you spot abnormal traffic early.
      </p>
    </header>

    <!--
 — banner is hidden by default (mock-rendered SSG path);
      progressive-enhance script reveals + populates on fetch
      success/failure / no-token state.
    -->
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    ></div>

    <!-- Top tiles -->
    <section class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Session minutes</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="session_minute">
          {MOCK_USAGE_SUMMARY.totals.session_minute.toLocaleString('en-US')}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="session_minute"
            d={sparklinePath(series.session_minutes, SPARK_W, SPARK_H)}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Navigates</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="navigate">
          {MOCK_USAGE_SUMMARY.totals.navigate.toLocaleString('en-US')}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="navigate"
            d={sparklinePath(series.navigates, SPARK_W, SPARK_H)}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Interacts</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2a4 4 0 0 0-4 4v6.5a3.5 3.5 0 1 0 7 0V6" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="interact">
          {MOCK_USAGE_SUMMARY.totals.interact.toLocaleString('en-US')}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="interact"
            d={sparklinePath(series.interacts, SPARK_W, SPARK_H)}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Captures</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="captures_total">
          {(
            MOCK_USAGE_SUMMARY.totals.state_capture +
            MOCK_USAGE_SUMMARY.totals.screenshot_capture
          ).toLocaleString('en-US')}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="captures"
            d={sparklinePath(series.captures, SPARK_W, SPARK_H)}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
    </section>

    {/* 2026-05-23 — icon header on the capture-breakdown card. */}
    <!-- Capture breakdown -->
    <section class="mt-10 dashboard-card">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
            <circle cx="12" cy="13" r="4" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Capture breakdown
          </p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Captures by kind</h2>
        </div>
      </div>
      <dl class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="flex justify-between border-b border-slate-100 pb-3">
          <dt class="text-sm text-tk-ink-3">Screenshots</dt>
          <dd class="font-mono text-sm text-tk-ink" data-stat="screenshot_capture">
            {MOCK_USAGE_SUMMARY.totals.screenshot_capture.toLocaleString('en-US')}
          </dd>
        </div>
        <div class="flex justify-between border-b border-slate-100 pb-3">
          <dt class="text-sm text-tk-ink-3">DOM snapshots</dt>
          <dd class="font-mono text-sm text-tk-ink" data-stat="state_capture">
            {MOCK_USAGE_SUMMARY.totals.state_capture.toLocaleString('en-US')}
          </dd>
        </div>
      </dl>
    </section>

    {/* W576 — per-bucket rate-limit panel. Closes the gap the docs called
        out ("the dashboard does not yet render this data visually"): the
        /v1/account/rate-limits read endpoint surfaced per-bucket config +
        overrides since W199, but customers had to curl it. SSG renders the
        skeleton; the inline script populates rows on fetch. */}
    <section class="mt-10 dashboard-card" data-section="rate-limits">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Rate limits</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">
            Per-bucket caps for your account
          </h2>
          <p class="mt-1 max-w-prose text-sm text-tk-ink-3">
            Anti-abuse token buckets — not the pricing meter. Staff-granted
            overrides show with their auto-revert time. Full semantics in the
            <a
              href="https://docs.driftstack.dev/reference/rate-limits/"
              class="text-tk-accent hover:underline">rate-limit reference</a
            >.
          </p>
        </div>
      </div>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-tk-border font-mono text-xs uppercase tracking-widest text-tk-ink-3">
              <th scope="col" class="pb-2 pr-4">Bucket</th>
              <th scope="col" class="pb-2 pr-4">Capacity</th>
              <th scope="col" class="pb-2 pr-4">Refill / s</th>
              <th scope="col" class="pb-2">Source</th>
            </tr>
          </thead>
          <tbody data-rate-limit-rows>
            <tr class="border-b border-white/5">
              <td colspan="4" class="py-3 text-tk-ink-3" data-rate-limit-placeholder>
                Sign in to see your live per-bucket caps.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <p class="mt-8 text-xs text-tk-ink-3">
      None of these counters drive billing. Concurrent caps are the only meter
      per ADR-004. We surface counts so you can spot pipeline regressions —
      e.g. a sudden 10× spike in navigates may indicate a runaway script.
    </p>
  </div>

  <!--
 — progressive-enhancement script. Reads a web-session token
    from localStorage, fetches /v1/usage + /v1/usage/series with
    credentials, replaces tile values + sparkline paths.

    Production wires the token via the (future) signup/login flow that
    sets `localStorage.ds_web_session_token`. Local dev: paste the
    token in DevTools console:
      localStorage.setItem('ds_web_session_token', '<token>')
    then reload.
  -->
  <script is:inline define:vars={{ apiBaseUrl, SPARK_W, SPARK_H }}>
    (function () {
      const root = document.querySelector('[data-page="usage"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      if (!token) {
        showBanner('Sign in to see live usage. Showing preview data below.');
        return;
      }

      const headers = {
        authorization: 'Bearer ' + token,
        // V-331b — act-as header for team-scoped reads.
        ...(typeof window.driftstackActAsHeaders === 'function'
          ? window.driftstackActAsHeaders()
          : {}),
      };

      Promise.all([
        fetch(apiBaseUrl + '/v1/usage', { headers, credentials: 'include' }).then((r) =>
          r.ok ? r.json() : Promise.reject(new Error('summary HTTP ' + r.status)),
        ),
        fetch(apiBaseUrl + '/v1/usage/series?days=30', { headers, credentials: 'include' }).then(
          (r) => (r.ok ? r.json() : Promise.reject(new Error('series HTTP ' + r.status))),
        ),
      ])
        .then(([summary, series]) => {
          // Update period + tier label.
          const tierEl = root.querySelector('[data-field="tier"]');
          if (tierEl) tierEl.textContent = summary.tier;
          const periodEl = root.querySelector('[data-field="period"]');
          if (periodEl) {
            const start = summary.period_start.slice(0, 10);
            const end = summary.period_end.slice(0, 10);
            periodEl.textContent = start + ' → ' + end + ' · ' + summary.tier + ' tier';
          }

          // Update tile totals.
          const totals = summary.totals || {};
          for (const key of [
            'session_minute',
            'navigate',
            'interact',
            'screenshot_capture',
            'state_capture',
          ]) {
            const el = root.querySelector('[data-stat="' + key + '"]');
            if (el) el.textContent = (totals[key] || 0).toLocaleString('en-US');
          }
          // Captures combined tile.
          const capturesTotalEl = root.querySelector('[data-stat="captures_total"]');
          if (capturesTotalEl) {
            capturesTotalEl.textContent = (
              (totals.state_capture || 0) + (totals.screenshot_capture || 0)
            ).toLocaleString('en-US');
          }

          // Build sparkline paths from the series buckets.
          const buckets = series.buckets || [];
          const seriesByMetric = {
            session_minute: buckets.map((b) => (b.totals && b.totals.session_minute) || 0),
            navigate: buckets.map((b) => (b.totals && b.totals.navigate) || 0),
            interact: buckets.map((b) => (b.totals && b.totals.interact) || 0),
            captures: buckets.map(
              (b) =>
                ((b.totals && b.totals.state_capture) || 0) +
                ((b.totals && b.totals.screenshot_capture) || 0),
            ),
          };

          for (const [metric, values] of Object.entries(seriesByMetric)) {
            const path = root.querySelector('[data-spark="' + metric + '"]');
            if (!path) continue;
            const max = Math.max(1, ...values);
            const stepX = SPARK_W / Math.max(1, values.length - 1);
            const d = values
              .map((v, i) => {
                const x = i * stepX;
                const y = SPARK_H - (v / max) * SPARK_H;
                return (i === 0 ? 'M' : 'L') + ' ' + x.toFixed(1) + ' ' + y.toFixed(1);
              })
              .join(' ');
            path.setAttribute('d', d);
          }

          // Empty-data state — let the user know real data is loaded
          // but everything is zero (writers not yet wired).
          const allZero = Object.values(totals).every((v) => !v || v === 0);
          if (allZero) {
            showBanner(
              'Live usage loaded. No activity in the current period yet — counts will populate as you run sessions.',
            );
          }
        })
        .catch((err) => {
          showBanner(
            "Couldn't load live usage (" +
              (err && err.message ? err.message : 'network error') +
              '). Showing preview data below.',
          );
        })
        .finally(function () {
          // 2026-05-21 — signal the layout's opacity-gate that the
          // /v1/usage + /v1/usage/series fetch resolved (success or
          // failure). Otherwise the page sits behind the 1200ms safety
          // cap before revealing.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // W576 — per-bucket rate-limit panel. Independent fetch: a failure
      // here must not affect the usage tiles (and vice-versa).
      function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
          switch (c) {
            case '&':
              return '&amp;';
            case '<':
              return '&lt;';
            case '>':
              return '&gt;';
            case '"':
              return '&quot;';
            default:
              return '&#39;';
          }
        });
      }
      const rlBody = root.querySelector('[data-rate-limit-rows]');
      if (rlBody) {
        fetch(apiBaseUrl + '/v1/account/rate-limits', { headers, credentials: 'include' })
          .then(function (r) {
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(function (data) {
            const buckets = Array.isArray(data.buckets) ? data.buckets : [];
            if (buckets.length === 0) return;
            rlBody.innerHTML = buckets
              .map(function (b) {
                const override = b.source === 'override';
                const src = override
                  ? 'override · reverts ' + escapeHtml(String(b.override_expires_at).slice(0, 10))
                  : 'tier default';
                return (
                  '<tr class="border-b border-white/5">' +
                  '<td class="py-2 pr-4 font-mono text-xs text-tk-ink">' +
                  escapeHtml(b.bucket_key) +
                  '</td>' +
                  '<td class="py-2 pr-4 text-tk-ink">' +
                  escapeHtml(Number(b.capacity).toLocaleString('en-US')) +
                  '</td>' +
                  '<td class="py-2 pr-4 text-tk-ink">' +
                  escapeHtml(String(b.refill_per_second)) +
                  '</td>' +
                  '<td class="py-2 ' +
                  (override ? 'text-tk-accent' : 'text-tk-ink-3') +
                  '">' +
                  src +
                  '</td>' +
                  '</tr>'
                );
              })
              .join('');
          })
          .catch(function () {
            const ph = root.querySelector('[data-rate-limit-placeholder]');
            if (ph) ph.textContent = "Couldn't load rate-limit config — try a reload.";
          });
      }
    })();
  </script>
</DashboardLayout>
