---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-171 — page progressively enhances from a neutral-placeholder SSG
// shell to real /v1/usage + /v1/usage/series fetches via inline
// <script>. Render path:
//   1. Astro emits the static HTML with neutral placeholders ("—"
//      totals + flat sparklines). 2026-06-24 — the SSG no longer
//      paints MOCK_USAGE_SUMMARY numbers; shipping fabricated totals
//      (423/1284/5612…) to every customer read as real usage.
//   2. <script is:inline> runs on DOMContentLoaded, reads
//      `ds_web_session_token` from localStorage.
//   3. Token present → fetch totals (/v1/usage) + series
//      (/v1/usage/series?days=30) with credentials, replace DOM.
//   4. Token absent → small banner: "Sign in to see live usage."
//      Placeholders stay (no fabricated numbers). (Production:
//      signup/login UI sets the token.)
//   5. Fetch fails (network / 401 / 5xx) → small banner
//      "Couldn't load live usage." Placeholders stay (never
//      fabricated numbers).
//
// Config: PUBLIC_API_BASE_URL (Astro public env). See
// `src/lib/api-base-url.ts` — dev falls back to localhost:3000;
// prod builds fail fast when the env var is unset (W192).
//
// Today usage_records writers aren't wired (V-014/V-015 amendment),
// so /v1/usage + /v1/usage/series return zeros for everyone. The
// fetch path is real; the data is empty until writers land.

import { resolveApiBaseUrl } from '../lib/api-base-url';
import { TIER_DISPLAY_NAMES } from '../data/mocks.ts';
const apiBaseUrl = resolveApiBaseUrl();

const SPARK_W = 200;
const SPARK_H = 48;

// Neutral placeholders for the SSG shell — no fabricated data. A flat
// baseline path keeps the sparkline SVGs from collapsing before the
// live series replaces them; the tiles render an em-dash until a
// successful /v1/usage fetch populates real numbers.
const PLACEHOLDER_STAT = '—';
const FLAT_PATH = `M 0 ${(SPARK_H / 2).toFixed(1)} L ${SPARK_W.toFixed(1)} ${(SPARK_H / 2).toFixed(1)}`;
---

<DashboardLayout title="Usage">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="usage">
    <header class="mb-10">
      <p class="text-sm text-tk-ink-3" data-field="period">
        <span data-field="tier">{PLACEHOLDER_STAT}</span> tier · current billing period
      </p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Usage</h1>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Per-resource counts for the current billing period. None of these
        are billed individually — concurrent cap is the only meter. These
        numbers help you spot abnormal traffic early.
      </p>
    </header>

    <!--
 — banner is hidden by default (mock-rendered SSG path);
      progressive-enhance script reveals + populates on fetch
      success/failure / no-token state.
    -->
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    ></div>

    <!-- Top tiles -->
    <section class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Session minutes</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="session_minute">
          {PLACEHOLDER_STAT}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="session_minute"
            d={FLAT_PATH}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Navigates</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="navigate">
          {PLACEHOLDER_STAT}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="navigate"
            d={FLAT_PATH}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Interacts</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2a4 4 0 0 0-4 4v6.5a3.5 3.5 0 1 0 7 0V6" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="interact">
          {PLACEHOLDER_STAT}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="interact"
            d={FLAT_PATH}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
      <div class="dashboard-card">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Captures</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-stat="captures_total">
          {PLACEHOLDER_STAT}
        </p>
        <svg
          viewBox={`0 0 ${SPARK_W.toString()} ${SPARK_H.toString()}`}
          class="mt-3 h-10 w-full text-tk-accent"
          aria-hidden="true"
        >
          <path
            data-spark="captures"
            d={FLAT_PATH}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </div>
    </section>

    {/* Fleet v2 (2026-07-03, slice 3.4) — daily-activity bar chart with a
        7/30/90-day window selector (blueprint recipe: percentage-height
        divs, no chart lib). Bars sum every usage-record type per UTC day.
        An all-zero window renders the honest empty state — the expected
        prod posture until the V-014/V-015 usage writers land. */}
    <!-- Daily activity -->
    <section class="mt-10 dashboard-card" data-section="daily-activity">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-start gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" />
              <path d="M7 15v3M11 11v7M15 13v5M19 7v11" />
            </svg>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Daily activity</p>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">
              All usage events per day
            </h2>
          </div>
        </div>
        <div class="themer" role="group" aria-label="Chart window">
          <button
            type="button"
            class="themer-btn disabled:cursor-not-allowed disabled:opacity-50"
            data-usage-days="7"
            disabled
            aria-disabled="true"
            title="Available after sign-in."
          >7d</button>
          <button
            type="button"
            class="themer-btn disabled:cursor-not-allowed disabled:opacity-50"
            data-usage-days="30"
            aria-pressed="true"
            disabled
            aria-disabled="true"
            title="Available after sign-in."
          >
            30d
          </button>
          <button
            type="button"
            class="themer-btn disabled:cursor-not-allowed disabled:opacity-50"
            data-usage-days="90"
            disabled
            aria-disabled="true"
            title="Available after sign-in."
          >90d</button>
        </div>
      </div>
      <div data-daily-chart class="mt-6 hidden h-[120px] items-end gap-1" aria-hidden="true"></div>
      <div data-daily-legend class="mt-2 hidden justify-between text-[11px] text-tk-ink-3"></div>
      <p data-daily-empty class="mt-6 hidden text-sm text-tk-ink-3">
        No activity recorded in this window yet — bars appear as sessions run.
      </p>
    </section>

    {/* 2026-05-23 — icon header on the capture-breakdown card. */}
    <!-- Capture breakdown -->
    <section class="mt-10 dashboard-card">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
            <circle cx="12" cy="13" r="4" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Capture breakdown
          </p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Captures by kind</h2>
        </div>
      </div>
      <dl class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="flex justify-between border-b border-tk-border pb-3">
          <dt class="text-sm text-tk-ink-3">Screenshots</dt>
          <dd class="font-mono text-sm text-tk-ink" data-stat="screenshot_capture">
            {PLACEHOLDER_STAT}
          </dd>
        </div>
        <div class="flex justify-between border-b border-tk-border pb-3">
          <dt class="text-sm text-tk-ink-3">DOM snapshots</dt>
          <dd class="font-mono text-sm text-tk-ink" data-stat="state_capture">
            {PLACEHOLDER_STAT}
          </dd>
        </div>
      </dl>
    </section>

    {/* W576 — per-bucket rate-limit panel. The
        /v1/account/rate-limits endpoint provides per-bucket config and
        overrides; the SSG shell renders the skeleton and the inline script
        populates rows from the live response. */}
    <section class="mt-10 dashboard-card" data-section="rate-limits">
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Rate limits</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">
            Per-bucket caps for your account
          </h2>
          <p class="mt-1 max-w-prose text-sm text-tk-ink-3">
            Anti-abuse token buckets — not the pricing meter. Staff-granted
            overrides show with their auto-revert time. Full semantics in the
            <a
              href="https://docs.driftstack.dev/reference/rate-limits/"
              class="text-tk-accent-text hover:underline">rate-limit reference</a
            >.
          </p>
        </div>
      </div>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-tk-border font-mono text-xs uppercase tracking-widest text-tk-ink-3">
              <th scope="col" class="pb-2 pr-4">Bucket</th>
              <th scope="col" class="pb-2 pr-4">Capacity</th>
              <th scope="col" class="pb-2 pr-4">Refill / s</th>
              <th scope="col" class="pb-2">Source</th>
            </tr>
          </thead>
          <tbody data-rate-limit-rows>
            <tr class="border-b border-tk-border">
              <td colspan="4" class="py-3 text-tk-ink-3" data-rate-limit-placeholder>
                Sign in to see your live per-bucket caps.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <p class="mt-8 text-xs text-tk-ink-3">
      None of these counters drive billing. Concurrent caps are the only meter
      per ADR-004. We surface counts so you can spot pipeline regressions —
      e.g. a sudden 10× spike in navigates may indicate a runaway script.
    </p>
  </div>

  <!--
 — progressive-enhancement script. Reads a web-session token
    from localStorage, fetches /v1/usage + /v1/usage/series with
    credentials, replaces tile values + sparkline paths.

    Signup/login stores the production web-session token in
    `localStorage.ds_web_session_token`. Local dev: paste the
    token in DevTools console:
      localStorage.setItem('ds_web_session_token', '<token>')
    then reload.
  -->
  <script is:inline define:vars={{ apiBaseUrl, SPARK_W, SPARK_H, tierDisplayNames: TIER_DISPLAY_NAMES }}>
    (function () {
      const root = document.querySelector('[data-page="usage"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      let token = '';
      try {
        token = localStorage.getItem('ds_web_session_token') || '';
      } catch {
        token = '';
      }
      const USAGE_TIMEOUT_MS = 15_000;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, USAGE_TIMEOUT_MS, controller);
      }

      function readJsonResponse(response) {
        if (response.ok) return response.json();
        return response
          .json()
          .catch(() => ({}))
          .then((body) => Promise.reject(window.driftstackResponseError(response, body)));
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Backend tier id → human plan name, so the customer sees "Personal"
      // not "solo_manual" in the period header (mirrors index/billing).
      // Falls back to the raw id if the table ever lacks the key.
      function tierLabel(t) {
        return (t && tierDisplayNames[t]) || t || '—';
      }

      if (!token) {
        showBanner('Sign in to see live usage.');
        if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
        return;
      }

      const headers = {
        authorization: 'Bearer ' + token,
        // V-331b — act-as header for team-scoped reads.
        ...(typeof window.driftstackActAsHeaders === 'function'
          ? window.driftstackActAsHeaders()
          : {}),
      };

      // Fleet v2 (slice 3.4) — daily-activity bar chart. Sums every
      // usage-record type per UTC bucket; re-fetches on the 7/30/90
      // window buttons. All-zero → the honest empty state (expected until
      // the V-014/V-015 writers land). Dependency-free (percentage-height
      // divs), so no chart lib enters the bundle.
      const chartEl = root.querySelector('[data-daily-chart]');
      const chartLegend = root.querySelector('[data-daily-legend]');
      const chartEmpty = root.querySelector('[data-daily-empty]');
      const chartSection = root.querySelector('[data-section="daily-activity"]');
      let chartRequestController = null;
      let chartRequestVersion = 0;

      function setChartBusy(btn) {
        if (chartSection) chartSection.setAttribute('aria-busy', 'true');
        root.querySelectorAll('[data-usage-days]').forEach(function (button) {
          button.removeAttribute('aria-busy');
          const active = button === btn;
          button.disabled = active;
          button.setAttribute('aria-disabled', active ? 'true' : 'false');
          if (active) button.title = 'Loading this usage window.';
          else button.removeAttribute('title');
        });
        if (btn) btn.setAttribute('aria-busy', 'true');
      }

      function clearChartBusy(version) {
        if (version !== chartRequestVersion) return;
        if (chartSection) chartSection.removeAttribute('aria-busy');
        root.querySelectorAll('[data-usage-days]').forEach(function (button) {
          button.removeAttribute('aria-busy');
          button.disabled = false;
          button.setAttribute('aria-disabled', 'false');
          button.removeAttribute('title');
        });
      }

      function showChartLoadFailure() {
        if (chartEl) {
          chartEl.classList.add('hidden');
          chartEl.classList.remove('flex');
        }
        if (chartLegend) chartLegend.classList.add('hidden');
        if (chartEmpty) chartEmpty.classList.add('hidden');
        showBanner("Couldn't load daily activity. Try again.");
      }

      function renderDailyChart(series) {
        if (!chartEl) return;
        const buckets = (series && series.buckets) || [];
        const values = buckets.map((b) => {
          const t = (b && b.totals) || {};
          let sum = 0;
          for (const k in t) sum += Number(t[k]) || 0;
          return sum;
        });
        const max = values.reduce((m, v) => (v > m ? v : m), 0);
        if (!buckets.length || max <= 0) {
          chartEl.classList.add('hidden');
          chartEl.classList.remove('flex');
          if (chartLegend) {
            chartLegend.classList.add('hidden');
            chartLegend.classList.remove('flex');
            chartLegend.innerHTML = '';
          }
          if (chartEmpty) chartEmpty.classList.remove('hidden');
          return;
        }
        if (chartEmpty) chartEmpty.classList.add('hidden');
        chartEl.classList.remove('hidden');
        chartEl.classList.add('flex');
        chartEl.innerHTML = values
          .map((v) => {
            const pct = Math.max(2, Math.min(100, Math.round((v / max) * 100)));
            return '<span class="flex-1 rounded-t bg-tk-accent/80" style="height: ' + pct + '%"></span>';
          })
          .join('');
        if (chartLegend && buckets.length > 1) {
          chartLegend.classList.remove('hidden');
          chartLegend.classList.add('flex');
          const first = buckets[0] && buckets[0].date;
          const last = buckets[buckets.length - 1] && buckets[buckets.length - 1].date;
          chartLegend.innerHTML =
            '<span>' + (first || '—') + '</span><span>' + (last || '—') + '</span>';
        } else if (chartLegend) {
          chartLegend.classList.add('hidden');
          chartLegend.classList.remove('flex');
          chartLegend.innerHTML = '';
        }
      }

      function requestDailyChart(days, btn) {
        if (chartRequestController) chartRequestController.abort();
        const controller = new AbortController();
        chartRequestController = controller;
        const version = ++chartRequestVersion;
        setChartBusy(btn);
        boundedFetch(
          apiBaseUrl + '/v1/usage/series?days=' + days,
          { headers, credentials: 'include' },
          controller,
        )
          .then(readJsonResponse)
          .then((series) => {
            if (version === chartRequestVersion) renderDailyChart(series);
          })
          .catch((err) => {
            if (version === chartRequestVersion && (!err || err.name !== 'AbortError')) {
              showChartLoadFailure();
            }
          })
          .finally(() => {
            clearChartBusy(version);
          });
      }
      root.querySelectorAll('[data-usage-days]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          root.querySelectorAll('[data-usage-days]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b === btn));
          });
          requestDailyChart(btn.getAttribute('data-usage-days'), btn);
        });
      });

      const summaryPromise = boundedFetch(apiBaseUrl + '/v1/usage', {
        headers,
        credentials: 'include',
      }).then(readJsonResponse);
      const initialChartVersion = ++chartRequestVersion;
      const initialChartButton = root.querySelector('[data-usage-days="30"]');
      setChartBusy(initialChartButton);
      const initialSeriesPromise = boundedFetch(apiBaseUrl + '/v1/usage/series?days=30', {
        headers,
        credentials: 'include',
      }).then(readJsonResponse);
      initialSeriesPromise
        .then((series) => {
          if (initialChartVersion === chartRequestVersion) renderDailyChart(series);
        })
        .catch(() => {
          if (initialChartVersion === chartRequestVersion) showChartLoadFailure();
        })
        .finally(() => {
          clearChartBusy(initialChartVersion);
        });

      Promise.all([summaryPromise, initialSeriesPromise])
        .then(([summary, series]) => {
          // Update period + tier label.
          const tierName = tierLabel(summary.tier);
          const tierEl = root.querySelector('[data-field="tier"]');
          if (tierEl) tierEl.textContent = tierName;
          const periodEl = root.querySelector('[data-field="period"]');
          if (periodEl) {
            const start = summary.period_start.slice(0, 10);
            const end = summary.period_end.slice(0, 10);
            periodEl.textContent = start + ' → ' + end + ' · ' + tierName + ' tier';
          }

          // Update tile totals.
          const totals = summary.totals || {};
          for (const key of [
            'session_minute',
            'navigate',
            'interact',
            'screenshot_capture',
            'state_capture',
          ]) {
            const el = root.querySelector('[data-stat="' + key + '"]');
            if (el) el.textContent = (totals[key] || 0).toLocaleString('en-US');
          }
          // Captures combined tile.
          const capturesTotalEl = root.querySelector('[data-stat="captures_total"]');
          if (capturesTotalEl) {
            capturesTotalEl.textContent = (
              (totals.state_capture || 0) + (totals.screenshot_capture || 0)
            ).toLocaleString('en-US');
          }

          // Build sparkline paths from the series buckets.
          const buckets = series.buckets || [];
          const seriesByMetric = {
            session_minute: buckets.map((b) => (b.totals && b.totals.session_minute) || 0),
            navigate: buckets.map((b) => (b.totals && b.totals.navigate) || 0),
            interact: buckets.map((b) => (b.totals && b.totals.interact) || 0),
            captures: buckets.map(
              (b) =>
                ((b.totals && b.totals.state_capture) || 0) +
                ((b.totals && b.totals.screenshot_capture) || 0),
            ),
          };

          for (const [metric, values] of Object.entries(seriesByMetric)) {
            const path = root.querySelector('[data-spark="' + metric + '"]');
            if (!path) continue;
            const max = Math.max(1, ...values);
            const stepX = SPARK_W / Math.max(1, values.length - 1);
            const d = values
              .map((v, i) => {
                const x = i * stepX;
                const y = SPARK_H - (v / max) * SPARK_H;
                return (i === 0 ? 'M' : 'L') + ' ' + x.toFixed(1) + ' ' + y.toFixed(1);
              })
              .join(' ');
            path.setAttribute('d', d);
          }

          // Empty-data state — real data loaded, with no activity in this period.
          const allZero = Object.values(totals).every((v) => !v || v === 0);
          if (allZero) {
            showBanner(
              'Live usage loaded. No activity in the current period yet — counts will populate as you run sessions.',
            );
          }
        })
        .catch((err) => {
          showBanner(
            "Couldn't load live usage (" +
              window.driftstackRequestErrorMessage(err, "Couldn't load live usage. Try again.") +
              ').',
          );
        })
        .finally(function () {
          // 2026-05-21 — signal the layout's opacity-gate that the
          // /v1/usage + /v1/usage/series fetch resolved (success or
          // failure). Otherwise the page sits behind the 1200ms safety
          // cap before revealing.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // W576 — per-bucket rate-limit panel. Independent fetch: a failure
      // here must not affect the usage tiles (and vice-versa).
      function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
          switch (c) {
            case '&':
              return '&amp;';
            case '<':
              return '&lt;';
            case '>':
              return '&gt;';
            case '"':
              return '&quot;';
            default:
              return '&#39;';
          }
        });
      }
      const rlBody = root.querySelector('[data-rate-limit-rows]');
      if (rlBody) {
        boundedFetch(apiBaseUrl + '/v1/account/rate-limits', {
          headers,
          credentials: 'include',
        })
          .then(function (r) {
            return readJsonResponse(r);
          })
          .then(function (data) {
            const buckets = Array.isArray(data.buckets) ? data.buckets : [];
            if (buckets.length === 0) return;
            rlBody.innerHTML = buckets
              .map(function (b) {
                const override = b.source === 'override';
                const src = override
                  ? 'override · reverts ' + escapeHtml(String(b.override_expires_at).slice(0, 10))
                  : 'tier default';
                return (
                  '<tr class="border-b border-tk-border">' +
                  '<td class="py-2 pr-4 font-mono text-xs text-tk-ink">' +
                  escapeHtml(b.bucket_key) +
                  '</td>' +
                  '<td class="py-2 pr-4 text-tk-ink">' +
                  escapeHtml(Number(b.capacity).toLocaleString('en-US')) +
                  '</td>' +
                  '<td class="py-2 pr-4 text-tk-ink">' +
                  escapeHtml(String(b.refill_per_second)) +
                  '</td>' +
                  '<td class="py-2 ' +
                  (override ? 'text-tk-accent-text' : 'text-tk-ink-3') +
                  '">' +
                  src +
                  '</td>' +
                  '</tr>'
                );
              })
              .join('');
          })
          .catch(function () {
            const ph = root.querySelector('[data-rate-limit-placeholder]');
            if (ph) ph.textContent = "Couldn't load rate-limit config — try a reload.";
          });
      }
    })();
  </script>
</DashboardLayout>
