---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// AI-B4 — Recipe library management page. Lists the calling
// account's saved recipes (snapshots of a finished agent-session's
// intent_log), with a Delete action per row. Recipes are created
// from /agent-sessions/:id (the "Save as recipe" flow); execution
// stays gated on the harness executor, so this page is read +
// delete only — there is no run/replay control yet.
//
// Progressive enhancement: page renders an empty/zero state on
// first paint; the inline script reads ds_web_session_token,
// fetches /v1/recipes (cursor-paginated), and hydrates the list.
// Falls back to the empty state when token absent or fetch fails.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Recipes">
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-6 py-10" data-page="recipes">
      <div
        data-banner
        class="mb-6 hidden rounded-lg border border-white/10 bg-surface-base px-4 py-3 text-sm text-ink-secondary"
        role="status"
      >
      </div>

      <header class="mb-10">
        <h1 class="text-3xl font-semibold tracking-tight text-ink-primary">Recipes</h1>
        <p class="mt-2 max-w-prose text-sm text-ink-muted">
          Saved snapshots of a finished agent-session's intent log. Capture one from an <a
            href="/agent-sessions"
            class="text-glow-red underline">agent session</a
          > to replay the same flow later without re-paying the planning cost. Delete a recipe
          here when you no longer need it.
        </p>
      </header>

      <ul
        data-list
        class="mb-6 hidden divide-y divide-slate-200 rounded-lg border border-white/10 bg-surface-raised"
      >
      </ul>

      {/* Cursor-paginated — revealed only while the server reports has_more. */}
      <div data-more-wrap class="mb-10 hidden text-center">
        <button
          type="button"
          data-more
          class="rounded-lg border border-white/10 bg-surface-raised px-4 py-2 text-sm text-ink-secondary hover:text-ink-primary"
          >Load more</button
        >
      </div>

      <div
        data-empty
        class="mb-10 rounded-lg border border-dashed border-white/10 bg-surface-raised px-6 py-16 text-center text-sm text-ink-muted"
      >
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red">
          <svg viewBox="0 0 16 16" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 2.5h8v11l-4-2.5-4 2.5Z" />
          </svg>
        </div>
        <p class="text-ink-primary font-medium">No recipes yet</p>
        <p class="mt-1">Save one from an <a href="/agent-sessions" class="text-glow-red underline">agent session</a>.</p>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="recipes"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const moreWrap = root.querySelector('[data-more-wrap]');
      const moreBtn = root.querySelector('[data-more]');
      const token = localStorage.getItem('ds_web_session_token');

      // Accumulates across "Load more" pages so a delete re-render
      // keeps every page that was already walked.
      let loaded = [];
      let nextCursor = null;

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 16).replace('T', ' ');
      }

      function authedFetch(path, init) {
        return fetch(apiBaseUrl + path, {
          ...(init || {}),
          headers: {
            ...((init && init.headers) || {}),
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        });
      }

      function recipeLi(r) {
        const intents =
          r.intent_count === 1 ? '1 intent' : escapeHtml(String(r.intent_count)) + ' intents';
        const source =
          r.agent_session_id === null
            ? '<em>(source session deleted)</em>'
            : 'from ' + escapeHtml(r.agent_session_id);
        return (
          '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-ink-primary">' +
          escapeHtml(r.label || '(no label)') +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-ink-muted">' +
          escapeHtml(r.id) +
          '</p>' +
          (r.description
            ? '<p class="mt-2 text-sm text-ink-secondary">' + escapeHtml(r.description) + '</p>'
            : '') +
          '<p class="mt-2 text-xs text-ink-muted">' +
          intents +
          ' · ' +
          source +
          ' · created ' +
          escapeHtml(fmtIso(r.created_at)) +
          '</p></div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<button type="button" data-delete="' +
          escapeHtml(r.id) +
          '" data-delete-label="' +
          escapeHtml(r.label || '(no label)') +
          '" class="text-sm text-rose-700 hover:underline">Delete</button>' +
          '</div></li>'
        );
      }

      function render() {
        if (loaded.length === 0) {
          list.classList.add('hidden');
          empty.classList.remove('hidden');
          moreWrap.classList.add('hidden');
          return;
        }
        empty.classList.add('hidden');
        list.classList.remove('hidden');
        list.innerHTML = loaded.map(recipeLi).join('');
        wireDeleteButtons();
        if (nextCursor) {
          moreWrap.classList.remove('hidden');
        } else {
          moreWrap.classList.add('hidden');
        }
      }

      function fetchPage(cursor) {
        if (!token) return Promise.resolve();
        const qs = cursor ? '?cursor=' + encodeURIComponent(cursor) : '';
        return authedFetch('/v1/recipes' + qs)
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            loaded = loaded.concat(body.data || []);
            nextCursor = body.next_cursor || null;
            render();
            hideBanner();
          })
          .catch((err) => {
            showBanner(
              "Couldn't load recipes (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          });
      }

      // A delete invalidates the accumulated cursor walk, so reload
      // from the first page rather than splicing — keeps pagination
      // boundaries honest.
      function reload() {
        loaded = [];
        nextCursor = null;
        return fetchPage(null);
      }

      function wireDeleteButtons() {
        list.querySelectorAll('[data-delete]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete');
            const label = btn.getAttribute('data-delete-label') || '(unnamed)';
            if (!window.confirm('Delete recipe "' + label + '"? This cannot be undone.')) {
              return;
            }
            authedFetch('/v1/recipes/' + encodeURIComponent(id), {
              method: 'DELETE',
            })
              .then((r) => {
                if (r.status === 204) {
                  showBanner('Recipe deleted.');
                  return reload();
                }
                showBanner('Delete failed: HTTP ' + r.status);
              })
              .catch((err) => {
                showBanner(
                  'Delete failed: ' + (err && err.message ? err.message : 'network error'),
                );
              });
          });
        });
      }

      if (moreBtn) {
        moreBtn.addEventListener('click', () => {
          if (nextCursor) fetchPage(nextCursor);
        });
      }

      Promise.resolve(fetchPage(null)).finally(function () {
        // 2026-05-21 — opacity-gate hydrate signal.
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
      });
    })();
  </script>
</DashboardLayout>
