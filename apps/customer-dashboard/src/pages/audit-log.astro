---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-216 — customer-facing audit log.
// V-297 — added export (CSV / JSON) for GDPR Article 20 portability.
// V-354 — filter dropdown + load-more pagination.

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';

const ACTION_LABEL: Record<string, string> = {
  'account.email_verified': 'Email verified',
  'account.login': 'Login',
  'account.logout': 'Logout',
  'account.password_changed': 'Password changed',
  // V-398 — V-353b MFA lifecycle.
  'account.mfa_enrolled': 'MFA enrolled',
  'account.mfa_disabled': 'MFA disabled',
  'account.recovery_code_used': 'MFA recovery code used',
  'api_key.minted': 'API key created',
  'api_key.revoked': 'API key revoked',
  'api_key.rotated': 'API key rotated',
  'session.created': 'Session created',
  'session.destroyed': 'Session destroyed',
  'profile.created': 'Profile created',
  'profile.deleted': 'Profile deleted',
  'subscription.tier_changed': 'Subscription changed',
  'webhook_endpoint.created': 'Webhook created',
  'webhook_endpoint.updated': 'Webhook updated',
  'webhook_endpoint.deleted': 'Webhook deleted',
  // V-398 — V-359 webhook signing-secret rotation.
  'webhook_endpoint.secret_rotated': 'Webhook secret rotated',
  'webhook_delivery.replayed': 'Webhook delivery replayed',
  'team.member_invited': 'Team member invited',
  'team.invite_accepted': 'Team invite accepted',
  'team.member_removed': 'Team member removed',
  'admin.refund_recorded': 'Refund recorded by support',
  'admin.support_note': 'Support note added',
};

// V-354 — preset filters. Each maps to a single AccountAuditAction
// the backend already accepts on `?action=`. The "security" group
// mirrors V-303 catalog intent — login / password / API-key lifecycle
// — but since the backend takes one action at a time and not a list,
// "security" is exposed as several adjacent presets in the dropdown
// rather than one composite filter (composite filter would need a
// backend change; this UI-only slice keeps backend untouched).
const FILTER_OPTIONS = [
  { value: '', label: 'All events' },
  { value: 'account.email_verified', label: 'Email verified' },
  { value: 'account.login', label: 'Logins' },
  { value: 'account.logout', label: 'Logouts' },
  { value: 'account.password_changed', label: 'Password changes' },
  // V-398 — V-353b MFA lifecycle (enroll / disable / recovery use).
  { value: 'account.mfa_enrolled', label: 'MFA enrolled' },
  { value: 'account.mfa_disabled', label: 'MFA disabled' },
  { value: 'account.recovery_code_used', label: 'MFA recovery code used' },
  { value: 'api_key.minted', label: 'API key created' },
  { value: 'api_key.rotated', label: 'API key rotated' },
  { value: 'api_key.revoked', label: 'API key revoked' },
  { value: 'session.created', label: 'Sessions created' },
  { value: 'session.destroyed', label: 'Sessions destroyed' },
  // V-381 — V-313 clone + V-312 snapshot.restore both emit
  // profile.created with a payload tag (cloned_from / restored_from_snapshot);
  // the filter is shared.
  { value: 'profile.created', label: 'Profiles created (incl. clones / snapshot restores)' },
  { value: 'profile.deleted', label: 'Profiles deleted' },
  { value: 'subscription.tier_changed', label: 'Subscription changes' },
  { value: 'webhook_endpoint.created', label: 'Webhooks created' },
  { value: 'webhook_endpoint.updated', label: 'Webhooks updated' },
  { value: 'webhook_endpoint.deleted', label: 'Webhooks deleted' },
  // V-398 — V-359 webhook signing-secret rotation.
  { value: 'webhook_endpoint.secret_rotated', label: 'Webhook secret rotated' },
  { value: 'webhook_delivery.replayed', label: 'Webhook replays' },
  { value: 'team.member_invited', label: 'Team invites sent' },
  { value: 'team.invite_accepted', label: 'Team invites accepted' },
  { value: 'team.member_removed', label: 'Team members removed' },
  // V-398 — staff-touched events surfaced for transparency.
  { value: 'admin.refund_recorded', label: 'Refund recorded by support' },
  { value: 'admin.support_note', label: 'Support note added' },
] as const;
---

<DashboardLayout title="Audit log">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="audit-log">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-slate-500">Account-scoped events · append-only</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Audit log</h1>
        <p class="mt-2 max-w-prose text-sm text-slate-500">
          Every action on your account: API key lifecycle, session activity, subscription changes.
          Export the full history at any time — your data, your file.
        </p>
      </div>
      <div class="flex shrink-0 gap-2">
        <button
          type="button"
          class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-900 hover:bg-slate-50"
          data-export-csv>Export CSV</button
        >
        <button
          type="button"
          class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-900 hover:bg-slate-50"
          data-export-json>Export JSON</button
        >
      </div>
    </header>

    <div class="mb-4 flex flex-wrap items-center gap-3">
      <label class="text-sm font-medium text-slate-700" for="audit-filter">Filter:</label>
      <select
        id="audit-filter"
        data-filter
        class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      >
        {
          FILTER_OPTIONS.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))
        }
      </select>
      <span class="text-xs text-slate-500" data-count>—</span>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
      <ul class="divide-y divide-slate-100" data-list>
        <li class="px-6 py-4 text-sm text-slate-500">Loading audit log…</li>
      </ul>
      <div class="hidden px-6 py-4 text-sm text-slate-500" data-empty>
        No audit entries yet. Events appear here as you take actions on your account.
      </div>
      <div class="hidden border-t border-slate-100 px-6 py-3" data-load-more-row>
        <button
          type="button"
          data-load-more
          class="text-sm font-medium text-oxblood-700 hover:text-oxblood-800 disabled:text-slate-400"
        >
          Load more
        </button>
      </div>
    </div>

    <p class="mt-6 text-xs text-slate-500">
      Exports cap at 10,000 rows per file. Older entries remain accessible via the read endpoint
      (<code class="font-mono">GET /v1/account/audit-log</code>) with cursor pagination. Account,
      billing, and authentication data export on request via <code class="font-mono"
        >privacy@driftstack.dev</code
      >.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, ACTION_LABEL }}>
    (function () {
      const root = document.querySelector('[data-page="audit-log"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const exportCsvBtn = root.querySelector('[data-export-csv]');
      const exportJsonBtn = root.querySelector('[data-export-json]');
      // V-354 — filter + load-more.
      const filterSelect = root.querySelector('[data-filter]');
      const countLabel = root.querySelector('[data-count]');
      const loadMoreRow = root.querySelector('[data-load-more-row]');
      const loadMoreBtn = root.querySelector('[data-load-more]');
      let nextCursor = null;
      let totalRendered = 0;
      let activeFilter = '';
      const PAGE_LIMIT = 50;

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function showBanner(msg) {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove('hidden');
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }

      function fmtTs(iso) {
        const d = new Date(iso);
        return d.toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
      }

      // V-399 — render the payload context inline for actions where
      // a payload tag carries customer-meaningful info. Falls back
      // silently when the payload doesn't carry a known tag.
      function payloadHint(entry) {
        const p = entry.payload;
        if (p == null || typeof p !== 'object') return '';
        switch (entry.action) {
          case 'account.login':
            return p.method ? ' · via ' + escapeHtml(String(p.method)) : '';
          case 'account.recovery_code_used':
            return p.remaining !== undefined
              ? ' · ' + escapeHtml(String(p.remaining)) + ' codes remaining'
              : '';
          case 'profile.created':
            if (p.cloned_from) return ' · cloned from ' + escapeHtml(String(p.cloned_from));
            if (p.restored_from_snapshot)
              return ' · restored from ' + escapeHtml(String(p.restored_from_snapshot));
            return '';
          case 'webhook_endpoint.secret_rotated':
            return p.grace_expires_at
              ? ' · grace ends ' + escapeHtml(String(p.grace_expires_at).slice(0, 19) + ' UTC')
              : '';
          case 'team.member_invited':
            return p.email ? ' · ' + escapeHtml(String(p.email)) : '';
          case 'subscription.tier_changed':
            return p.from && p.to
              ? ' · ' + escapeHtml(String(p.from)) + ' → ' + escapeHtml(String(p.to))
              : '';
          default:
            return '';
        }
      }

      function entryLi(entry) {
        const label = ACTION_LABEL[entry.action] || entry.action;
        return (
          '<li class="px-6 py-3">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<p class="text-sm font-medium text-slate-900">' +
          escapeHtml(label) +
          payloadHint(entry) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-slate-500">' +
          escapeHtml(entry.action) +
          (entry.target_resource_id ? ' · ' + escapeHtml(entry.target_resource_id) : '') +
          '</p></div>' +
          '<span class="shrink-0 text-xs text-slate-500">' +
          escapeHtml(fmtTs(entry.timestamp)) +
          '</span></div></li>'
        );
      }

      function updateCount() {
        if (!countLabel) return;
        const more = nextCursor ? '+' : '';
        const filterTxt = activeFilter ? ' · filtered' : '';
        countLabel.textContent =
          totalRendered === 0
            ? '—'
            : totalRendered + more + ' shown' + filterTxt;
      }

      function setLoadMoreVisible(visible) {
        if (!loadMoreRow) return;
        if (visible) loadMoreRow.classList.remove('hidden');
        else loadMoreRow.classList.add('hidden');
      }

      function buildUrl(cursor) {
        const params = ['limit=' + PAGE_LIMIT];
        if (activeFilter) params.push('action=' + encodeURIComponent(activeFilter));
        if (cursor) params.push('cursor=' + encodeURIComponent(cursor));
        return apiBaseUrl + '/v1/account/audit-log?' + params.join('&');
      }

      function fetchPage(cursor) {
        const token = getToken();
        if (!token) {
          if (list)
            list.innerHTML =
              '<li class="px-6 py-4 text-sm text-slate-500">Sign in to view audit log.</li>';
          setLoadMoreVisible(false);
          return Promise.resolve();
        }
        return fetch(buildUrl(cursor), {
          headers: {
            authorization: 'Bearer ' + token,
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function (body) {
            const entries = body.data || [];
            nextCursor = body.next_cursor || null;
            const isFresh = !cursor;
            if (isFresh) {
              totalRendered = 0;
              if (list) list.innerHTML = '';
            }
            if (entries.length === 0 && isFresh) {
              if (list) list.classList.add('hidden');
              if (empty) empty.classList.remove('hidden');
              setLoadMoreVisible(false);
              updateCount();
              return;
            }
            if (empty) empty.classList.add('hidden');
            if (list) {
              list.classList.remove('hidden');
              const html = entries.map(entryLi).join('');
              list.insertAdjacentHTML('beforeend', html);
            }
            totalRendered += entries.length;
            setLoadMoreVisible(!!nextCursor);
            updateCount();
          })
          .catch(function (err) {
            showBanner(
              "Couldn't load audit log (" +
                (err && err.message ? err.message : 'network error') +
                ').',
            );
          });
      }

      function refresh() {
        nextCursor = null;
        totalRendered = 0;
        return fetchPage(null);
      }

      if (filterSelect) {
        filterSelect.addEventListener('change', function (ev) {
          const target = ev.target;
          if (target instanceof HTMLSelectElement) {
            activeFilter = target.value || '';
            refresh();
          }
        });
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function () {
          if (!nextCursor) return;
          loadMoreBtn.disabled = true;
          loadMoreBtn.textContent = 'Loading…';
          fetchPage(nextCursor).finally(function () {
            loadMoreBtn.disabled = false;
            loadMoreBtn.textContent = 'Load more';
          });
        });
      }

      function downloadExport(format) {
        const token = getToken();
        if (!token) {
          showBanner('Sign in to export audit log.');
          return;
        }
        // Direct fetch + blob download — keeps the auth header out of
        // the URL (a window.location.assign would leak the bearer in
        // browser history if any redirect chain were involved).
        fetch(apiBaseUrl + '/v1/account/audit-log/export?format=' + encodeURIComponent(format), {
          headers: {
            authorization: 'Bearer ' + token,
            ...(typeof window.driftstackActAsHeaders === 'function'
              ? window.driftstackActAsHeaders()
              : {}),
          },
        })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.blob().then(function (blob) {
              const cd = r.headers.get('content-disposition') || '';
              const m = /filename="([^"]+)"/.exec(cd);
              const name = m ? m[1] : 'audit-log.' + format;
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = name;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              URL.revokeObjectURL(url);
            });
          })
          .catch(function (err) {
            showBanner('Export failed (' + (err && err.message ? err.message : 'network error') + ').');
          });
      }

      if (exportCsvBtn) exportCsvBtn.addEventListener('click', function () { downloadExport('csv'); });
      if (exportJsonBtn) exportJsonBtn.addEventListener('click', function () { downloadExport('json'); });

      refresh();
    })();
  </script>
</DashboardLayout>
