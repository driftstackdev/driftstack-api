---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-216 — customer-facing audit log.
// V-297 — added export (CSV / JSON) for GDPR Article 20 portability.
// V-354 — filter dropdown + load-more pagination.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

const ACTION_LABEL: Record<string, string> = {
  'account.email_verified': 'Email verified',
  'account.login': 'Login',
  'account.logout': 'Logout',
  'account.password_changed': 'Password changed',
  'account.web_session_revoked': 'Sign-in revoked',
  // V-398 — V-353b MFA lifecycle.
  'account.mfa_enrolled': 'MFA enrolled',
  'account.mfa_disabled': 'MFA disabled',
  'account.recovery_code_used': 'MFA recovery code used',
  'api_key.minted': 'API key created',
  'api_key.revoked': 'API key revoked',
  'api_key.rotated': 'API key rotated',
  'session.created': 'Session created',
  'session.destroyed': 'Session destroyed',
  'profile.created': 'Profile created',
  'profile.deleted': 'Profile deleted',
  // L4b recycle bin — a trashed profile was restored.
  'profile.restored': 'Profile restored',
  // L4b anti-abuse — a trashed profile was permanently deleted (cap slot freed).
  'profile.purged': 'Profile permanently deleted',
  // V-480 — profile import/export audit entries.
  'profile.exported': 'Profile exported',
  'profile.imported': 'Profile imported',
  'subscription.tier_changed': 'Subscription changed',
  'webhook_endpoint.created': 'Webhook created',
  'webhook_endpoint.updated': 'Webhook updated',
  'webhook_endpoint.deleted': 'Webhook deleted',
  // V-398 — V-359 webhook signing-secret rotation.
  'webhook_endpoint.secret_rotated': 'Webhook secret rotated',
  'webhook_delivery.replayed': 'Webhook delivery replayed',
  'team.member_invited': 'Team member invited',
  'team.invite_accepted': 'Team invite accepted',
  'team.member_removed': 'Team member removed',
  'admin.refund_recorded': 'Refund recorded by support',
  'admin.support_note': 'Support note added',
  // Arc 4 Wave 2.B sub-slice 8.20 (v2-#8) — pair-mode state-machine
  // transitions surfaced on the customer audit log.
  'agent_session.pair_mode.takeover': 'Pair-mode takeover requested',
  'agent_session.pair_mode.handback': 'Pair-mode handback requested',
  'agent_session.pair_mode.timeout': 'Pair-mode heartbeat timeout',
  // Slice 6 follow-up 2026-05-20 — Slice 3 setMode change (Slice 3
  // POST /:id/mode) lands a customer audit row too.
  'agent_session.mode.changed': 'Agent session mode changed',
  // Slice 6 follow-up 2026-05-20 — agent-session lifecycle audit
  // rows for the create + customer-close paths.
  'agent_session.created': 'Agent session created',
  'agent_session.destroyed': 'Agent session destroyed',
  // v2-#5 Q.1.f — per-turn AI agent layer decompose() events.
  // Customer audit log emission only (no separate operator UI per
  // founder verdict 2026-05-17). Customer sees WHICH decomposer
  // ran for each turn — Claude (bundled / BYOK) vs deterministic
  // (rule-based fallback).
  'agent.decompose.claude': 'Agent turn decomposed (Claude)',
  'agent.decompose.deterministic': 'Agent turn decomposed (deterministic)',
  // 2026-05-20 — BYOK Anthropic key-management events. Customer
  // needs to audit every mutation on their stored Anthropic
  // credential. Payload carries the test outcome label on _tested;
  // _set + _cleared have empty payload (no key-prefix per Q2
  // verdict 2026-05-17).
  'account.byok_anthropic_key_set': 'BYOK Anthropic key set / rotated',
  'account.byok_anthropic_key_cleared': 'BYOK Anthropic key cleared',
  'account.byok_anthropic_key_tested': 'BYOK Anthropic key tested',
  // Saved-proxy lifecycle — emitted by the live account-proxies API
  // (POST/DELETE /v1/account/me/proxies) on egress-config changes.
  'proxy.created': 'Saved proxy created',
  'proxy.updated': 'Saved proxy updated',
  'proxy.deleted': 'Saved proxy deleted',
  // 2026-05-20 — bundled-LLM consent toggle.
  'account.bundled_llm_consent_changed': 'Bundled-LLM consent changed',
  // 2026-05-20 — email-preferences opt-in/out toggle.
  'account.email_preferences_changed': 'Email preferences changed',
};

// V-354 — preset filters. Each maps to a single AccountAuditAction
// the backend already accepts on `?action=`. The "security" group
// mirrors V-303 catalog intent — login / password / API-key lifecycle
// — but since the backend takes one action at a time and not a list,
// "security" is exposed as several adjacent presets in the dropdown
// rather than one composite filter (composite filter would need a
// backend change; this UI-only slice keeps backend untouched).
const FILTER_OPTIONS = [
  { value: '', label: 'All events' },
  { value: 'account.email_verified', label: 'Email verified' },
  { value: 'account.login', label: 'Logins' },
  { value: 'account.logout', label: 'Logouts' },
  { value: 'account.password_changed', label: 'Password changes' },
  { value: 'account.web_session_revoked', label: 'Sign-ins revoked' },
  // V-398 — V-353b MFA lifecycle (enroll / disable / recovery use).
  { value: 'account.mfa_enrolled', label: 'MFA enrolled' },
  { value: 'account.mfa_disabled', label: 'MFA disabled' },
  { value: 'account.recovery_code_used', label: 'MFA recovery code used' },
  { value: 'api_key.minted', label: 'API key created' },
  { value: 'api_key.rotated', label: 'API key rotated' },
  { value: 'api_key.revoked', label: 'API key revoked' },
  { value: 'session.created', label: 'Sessions created' },
  { value: 'session.destroyed', label: 'Sessions destroyed' },
  // V-381 — V-313 clone + V-312 snapshot.restore both emit
  // profile.created with a payload tag (cloned_from / restored_from_snapshot);
  // the filter is shared.
  { value: 'profile.created', label: 'Profiles created (incl. clones / snapshot restores)' },
  { value: 'profile.deleted', label: 'Profiles deleted' },
  { value: 'profile.restored', label: 'Profiles restored (recycle bin)' },
  { value: 'profile.purged', label: 'Profiles permanently deleted (recycle bin)' },
  // V-480 — profile import/export audit entries.
  { value: 'profile.exported', label: 'Profiles exported' },
  { value: 'profile.imported', label: 'Profiles imported' },
  { value: 'subscription.tier_changed', label: 'Subscription changes' },
  { value: 'webhook_endpoint.created', label: 'Webhooks created' },
  { value: 'webhook_endpoint.updated', label: 'Webhooks updated' },
  { value: 'webhook_endpoint.deleted', label: 'Webhooks deleted' },
  // V-398 — V-359 webhook signing-secret rotation.
  { value: 'webhook_endpoint.secret_rotated', label: 'Webhook secret rotated' },
  { value: 'webhook_delivery.replayed', label: 'Webhook replays' },
  { value: 'team.member_invited', label: 'Team invites sent' },
  { value: 'team.invite_accepted', label: 'Team invites accepted' },
  { value: 'team.member_removed', label: 'Team members removed' },
  // V-398 — staff-touched events surfaced for transparency.
  { value: 'admin.refund_recorded', label: 'Refund recorded by support' },
  { value: 'admin.support_note', label: 'Support note added' },
  // Arc 4 Wave 2.B sub-slice 8.20 (v2-#8) — pair-mode state-machine
  // transitions. Surfaces every takeover / handback / heartbeat-
  // timeout transition the customer's pair-mode session ran through.
  { value: 'agent_session.pair_mode.takeover', label: 'Pair-mode takeover requested' },
  { value: 'agent_session.pair_mode.handback', label: 'Pair-mode handback requested' },
  { value: 'agent_session.pair_mode.timeout', label: 'Pair-mode heartbeat timeout' },
  { value: 'agent_session.mode.changed', label: 'Agent session mode changed' },
  { value: 'agent_session.created', label: 'Agent session created' },
  { value: 'agent_session.destroyed', label: 'Agent session destroyed' },
  // v2-#5 Q.1.f — agent decomposer per-turn events.
  { value: 'agent.decompose.claude', label: 'Agent turn decomposed (Claude)' },
  { value: 'agent.decompose.deterministic', label: 'Agent turn decomposed (deterministic)' },
  // 2026-05-20 — BYOK Anthropic key-management events.
  { value: 'account.byok_anthropic_key_set', label: 'BYOK Anthropic key set / rotated' },
  { value: 'account.byok_anthropic_key_cleared', label: 'BYOK Anthropic key cleared' },
  { value: 'account.byok_anthropic_key_tested', label: 'BYOK Anthropic key tested' },
  // Saved-proxy lifecycle — emitted by the live account-proxies API.
  { value: 'proxy.created', label: 'Saved proxies created' },
  { value: 'proxy.updated', label: 'Saved proxies updated' },
  { value: 'proxy.deleted', label: 'Saved proxies deleted' },
  // 2026-05-20 — bundled-LLM consent toggle.
  { value: 'account.bundled_llm_consent_changed', label: 'Bundled-LLM consent changes' },
  // 2026-05-20 — email-preferences opt-in/out toggle.
  { value: 'account.email_preferences_changed', label: 'Email preference changes' },
] as const;
---

<DashboardLayout title="Audit log">
  <div class="mx-auto max-w-5xl px-6 py-10" data-page="audit-log">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-tk-ink-3">Account-scoped events · append-only</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Audit log</h1>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Every action on your account: API key lifecycle, session activity, subscription changes.
          Export the full history at any time — your data, your file.
        </p>
      </div>
      {/* 2026-05-24 — download icons on Export CSV / JSON buttons. */}
      <div class="flex shrink-0 gap-2">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink hover:bg-tk-bg"
          data-export-csv
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span data-export-label>Export CSV</span>
        </button>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink hover:bg-tk-bg"
          data-export-json
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span data-export-label>Export JSON</span>
        </button>
      </div>
    </header>

    <!--
      V-484 — extended filter row. Action filter (existing V-354)
      stays at the top; from/to date range + actor type + target id
      land in a collapsible "More filters" panel below to keep the
      common case (action-only filtering) one click.
    -->
    <div class="mb-4 flex flex-wrap items-center gap-3">
      <label class="text-sm font-medium text-tk-ink-2" for="audit-filter">Action:</label>
      <select
        id="audit-filter"
        data-filter
        class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
      >
        {
          FILTER_OPTIONS.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))
        }
      </select>
      <button
        type="button"
        data-show-more-filters
        class="text-sm text-tk-accent-text hover:underline"
      >
        More filters ▾
      </button>
      <span class="text-xs text-tk-ink-3" data-count>—</span>
    </div>

    <details data-more-filters class="mb-4 rounded-lg border border-tk-border bg-tk-bg p-4">
      <summary class="cursor-pointer text-sm font-medium text-tk-ink-2">
        Date range · actor · target resource
      </summary>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
        <div>
          <label for="audit-from" class="block text-xs font-medium text-tk-ink-2">From</label>
          <input
            id="audit-from"
            data-filter-from
            type="datetime-local"
            class="mt-1 w-full rounded-md border border-tk-border px-2 py-1 text-sm"
          />
          <p class="mt-1 text-[11px] text-tk-ink-3">Inclusive lower bound.</p>
        </div>
        <div>
          <label for="audit-to" class="block text-xs font-medium text-tk-ink-2">To</label>
          <input
            id="audit-to"
            data-filter-to
            type="datetime-local"
            class="mt-1 w-full rounded-md border border-tk-border px-2 py-1 text-sm"
          />
          <p class="mt-1 text-[11px] text-tk-ink-3">Inclusive upper bound.</p>
        </div>
        <div>
          <label for="audit-actor" class="block text-xs font-medium text-tk-ink-2">Actor</label>
          <select
            id="audit-actor"
            data-filter-actor
            class="mt-1 w-full rounded-md border border-tk-border bg-tk-surface px-2 py-1 text-sm"
          >
            <option value="">Any</option>
            <option value="customer">Customer (you)</option>
            <option value="system">System</option>
            <option value="staff">Staff (Driftstack support)</option>
          </select>
        </div>
        <div>
          <label for="audit-target" class="block text-xs font-medium text-tk-ink-2"
            >Target resource id</label
          >
          <input
            id="audit-target"
            data-filter-target
            type="text"
            placeholder="e.g. profile_<id>"
            class="mt-1 w-full rounded-md border border-tk-border px-2 py-1 text-sm font-mono"
          />
          <p class="mt-1 text-[11px] text-tk-ink-3">Exact match.</p>
        </div>
      </div>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-apply-filters
          class="rounded-md bg-tk-accent px-3 py-1.5 text-xs font-medium text-white"
        >
          Apply filters
        </button>
        <button
          type="button"
          data-clear-filters
          class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-xs font-medium text-tk-ink-2"
        >
          Clear
        </button>
      </div>
    </details>

    <div class="rounded-lg border border-tk-border bg-tk-surface">
      <ul class="divide-y divide-tk-border" data-list>
        {/* 2026-05-24 — skeleton rows replace plain "Loading…" text for parity
            with /sessions + /api-keys hydrate-state polish. */}
        <li class="px-6 py-4">
          <div class="flex items-center gap-4">
            <div class="h-3 w-24 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-40 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-16 animate-pulse rounded bg-tk-hover"></div>
          </div>
        </li>
        <li class="px-6 py-4">
          <div class="flex items-center gap-4">
            <div class="h-3 w-24 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-32 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-20 animate-pulse rounded bg-tk-hover"></div>
          </div>
        </li>
        <li class="px-6 py-4">
          <div class="flex items-center gap-4">
            <div class="h-3 w-24 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-36 animate-pulse rounded bg-tk-hover"></div>
            <div class="h-3 w-12 animate-pulse rounded bg-tk-hover"></div>
          </div>
        </li>
      </ul>
      {/* 2026-05-23 — empty state with icon for visual interest. */}
      <div class="hidden px-6 py-12 text-center text-sm text-tk-ink-3" data-empty>
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 13h6M9 17h4" />
          </svg>
        </div>
        <p class="text-tk-ink font-medium">No audit entries yet</p>
        <p class="mt-1 text-tk-ink-3">Events appear here as you take actions on your account.</p>
      </div>
      <div class="hidden border-t border-tk-border px-6 py-3" data-load-more-row>
        <button
          type="button"
          data-load-more
          class="text-sm font-medium text-tk-accent-text hover:text-tk-accent-2 disabled:text-tk-ink-3"
        >
          Load more
        </button>
      </div>
    </div>

    <p class="mt-6 text-xs text-tk-ink-3">
      Exports cap at 10,000 rows per file. Older entries remain accessible via the read endpoint
      (<code class="font-mono">GET /v1/account/audit-log</code>) with cursor pagination. Account,
      billing, and authentication data export on request via <code class="font-mono"
        >privacy@driftstack.dev</code
      >.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, ACTION_LABEL }}>
    (function () {
      const root = document.querySelector('[data-page="audit-log"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list]');
      const empty = root.querySelector('[data-empty]');
      const exportCsvBtn = root.querySelector('[data-export-csv]');
      const exportJsonBtn = root.querySelector('[data-export-json]');
      // V-354 — filter + load-more.
      const filterSelect = root.querySelector('[data-filter]');
      const countLabel = root.querySelector('[data-count]');
      const loadMoreRow = root.querySelector('[data-load-more-row]');
      const loadMoreBtn = root.querySelector('[data-load-more]');
      let nextCursor = null;
      let totalRendered = 0;
      let activeFilter = '';
      const PAGE_LIMIT = 50;
      const AUDIT_TIMEOUT_MS = 15_000;
      let pageController = null;
      let loadMoreInFlight = false;
      let exportInFlight = false;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, AUDIT_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function showBanner(msg) {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove('hidden');
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }

      function fmtTs(iso) {
        const d = new Date(iso);
        return d.toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
      }

      // V-399 — render the payload context inline for actions where
      // a payload tag carries customer-meaningful info. Falls back
      // silently when the payload doesn't carry a known tag.
      function payloadHint(entry) {
        const p = entry.payload;
        if (p == null || typeof p !== 'object') return '';
        switch (entry.action) {
          case 'account.login':
            return p.method ? ' · via ' + escapeHtml(String(p.method)) : '';
          case 'account.recovery_code_used':
            return p.remaining !== undefined
              ? ' · ' + escapeHtml(String(p.remaining)) + ' codes remaining'
              : '';
          case 'profile.created':
            if (p.cloned_from) return ' · cloned from ' + escapeHtml(String(p.cloned_from));
            if (p.restored_from_snapshot)
              return ' · restored from ' + escapeHtml(String(p.restored_from_snapshot));
            return '';
          case 'webhook_endpoint.secret_rotated':
            return p.grace_expires_at
              ? ' · grace ends ' + escapeHtml(String(p.grace_expires_at).slice(0, 19) + ' UTC')
              : '';
          case 'team.member_invited':
            return p.email ? ' · ' + escapeHtml(String(p.email)) : '';
          case 'subscription.tier_changed':
            return p.from && p.to
              ? ' · ' + escapeHtml(String(p.from)) + ' → ' + escapeHtml(String(p.to))
              : '';
          default:
            return '';
        }
      }

      function entryLi(entry) {
        const label = ACTION_LABEL[entry.action] || entry.action;
        return (
          '<li class="px-6 py-3">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<p class="text-sm font-medium text-tk-ink">' +
          escapeHtml(label) +
          payloadHint(entry) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(entry.action) +
          (entry.target_resource_id ? ' · ' + escapeHtml(entry.target_resource_id) : '') +
          '</p></div>' +
          '<span class="shrink-0 text-xs text-tk-ink-3">' +
          escapeHtml(fmtTs(entry.timestamp)) +
          '</span></div></li>'
        );
      }

      function updateCount() {
        if (!countLabel) return;
        const more = nextCursor ? '+' : '';
        const filterTxt = activeFilter ? ' · filtered' : '';
        countLabel.textContent =
          totalRendered === 0
            ? '—'
            : totalRendered + more + ' shown' + filterTxt;
      }

      function setLoadMoreVisible(visible) {
        if (!loadMoreRow) return;
        if (visible) loadMoreRow.classList.remove('hidden');
        else loadMoreRow.classList.add('hidden');
      }

      // V-484 — extra filter state held alongside activeFilter.
      let activeFrom = '';
      let activeTo = '';
      let activeActor = '';
      let activeTarget = '';

      function buildUrl(cursor) {
        const params = ['limit=' + PAGE_LIMIT];
        if (activeFilter) params.push('action=' + encodeURIComponent(activeFilter));
        if (cursor) params.push('cursor=' + encodeURIComponent(cursor));
        // V-484 — additional filter query params.
        if (activeFrom) params.push('from=' + encodeURIComponent(activeFrom));
        if (activeTo) params.push('to=' + encodeURIComponent(activeTo));
        if (activeActor) params.push('actor_type=' + encodeURIComponent(activeActor));
        if (activeTarget)
          params.push('target_resource_id=' + encodeURIComponent(activeTarget));
        return apiBaseUrl + '/v1/account/audit-log?' + params.join('&');
      }

      // A failed initial fetch left the SSR skeleton <li>s pulsing
      // forever — the success-only render path is the only one that
      // ever replaces them. Clear the skeleton + show an explicit
      // retry row so the page doesn't look permanently "loading".
      // Only applies to a fresh (cursor-less) load; a failed
      // load-more page leaves the already-rendered entries in place.
      function renderLoadError() {
        if (!list || !empty) return;
        empty.classList.add('hidden');
        list.classList.remove('hidden');
        list.innerHTML =
          '<li class="px-6 py-12 text-center text-sm text-tk-ink-3">' +
          "Couldn't load the audit log. " +
          '<button type="button" data-action="retry-audit-log" class="text-tk-accent-text underline">Retry</button>' +
          '</li>';
        const retryBtn = list.querySelector('[data-action="retry-audit-log"]');
        if (retryBtn)
          retryBtn.addEventListener('click', function () {
            fetchPage(null);
          });
        setLoadMoreVisible(false);
      }

      // Monotonic guard — filterSelect/applyFilters/clearFilters/retry can
      // all fire an overlapping fetchPage(null) before a slower prior call
      // resolves; without this, a stale response landing last would clobber
      // the list (and nextCursor, corrupting pagination) with results for a
      // filter the customer already changed away from.
      let fetchGeneration = 0;
      function fetchPage(cursor) {
        const token = getToken();
        if (!token) {
          if (list)
            list.innerHTML =
              '<li class="px-6 py-4 text-sm text-tk-ink-3">Sign in to view audit log.</li>';
          setLoadMoreVisible(false);
          return Promise.resolve();
        }
        const isFreshLoad = !cursor;
        const myGeneration = ++fetchGeneration;
        if (pageController) pageController.abort();
        const controller = new AbortController();
        pageController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          buildUrl(cursor),
          {
            headers: {
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
          },
          controller,
        )
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function (body) {
            if (myGeneration !== fetchGeneration) return; // superseded by a newer fetchPage
            const entries = body.data || [];
            nextCursor = body.next_cursor || null;
            const isFresh = !cursor;
            if (isFresh) {
              totalRendered = 0;
              if (list) list.innerHTML = '';
            }
            if (entries.length === 0 && isFresh) {
              if (list) list.classList.add('hidden');
              if (empty) empty.classList.remove('hidden');
              setLoadMoreVisible(false);
              updateCount();
              return;
            }
            if (empty) empty.classList.add('hidden');
            if (list) {
              list.classList.remove('hidden');
              const html = entries.map(entryLi).join('');
              list.insertAdjacentHTML('beforeend', html);
            }
            totalRendered += entries.length;
            setLoadMoreVisible(!!nextCursor);
            updateCount();
          })
          .catch(function (err) {
            if (myGeneration !== fetchGeneration) return; // superseded by a newer fetchPage
            if (isFreshLoad) renderLoadError();
            showBanner(
                "Couldn't load audit log (" +
                requestErrorMessage(err, 'Could not load the audit log. Try again.') +
                ').',
            );
          })
          .finally(function () {
            if (myGeneration === fetchGeneration) {
              root.removeAttribute('aria-busy');
              pageController = null;
            }
            // 2026-05-21 — opacity-gate hydrate signal (same pattern
            // as the other dashboard pages).
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function refresh() {
        nextCursor = null;
        totalRendered = 0;
        return fetchPage(null);
      }

      if (filterSelect) {
        filterSelect.addEventListener('change', function (ev) {
          const target = ev.target;
          if (target instanceof HTMLSelectElement) {
            activeFilter = target.value || '';
            refresh();
          }
        });
      }

      // V-484 — wire the "More filters" panel.
      const moreFiltersToggle = root.querySelector('[data-show-more-filters]');
      const moreFiltersDetails = root.querySelector('[data-more-filters]');
      const filterFromInput = root.querySelector('[data-filter-from]');
      const filterToInput = root.querySelector('[data-filter-to]');
      const filterActorSelect = root.querySelector('[data-filter-actor]');
      const filterTargetInput = root.querySelector('[data-filter-target]');
      const applyFiltersBtn = root.querySelector('[data-apply-filters]');
      const clearFiltersBtn = root.querySelector('[data-clear-filters]');

      if (moreFiltersToggle && moreFiltersDetails) {
        moreFiltersToggle.addEventListener('click', function () {
          moreFiltersDetails.open = !moreFiltersDetails.open;
        });
      }

      function localToIso(local) {
        // <input type="datetime-local"> emits "YYYY-MM-DDTHH:MM" in
        // local time; coerce to UTC ISO so the server compares like-
        // for-like.
        if (!local) return '';
        const d = new Date(local);
        if (isNaN(d.getTime())) return '';
        return d.toISOString();
      }

      if (applyFiltersBtn) {
        applyFiltersBtn.addEventListener('click', function () {
          activeFrom = filterFromInput ? localToIso(filterFromInput.value) : '';
          activeTo = filterToInput ? localToIso(filterToInput.value) : '';
          activeActor = filterActorSelect ? filterActorSelect.value || '' : '';
          activeTarget = filterTargetInput
            ? filterTargetInput.value.trim()
            : '';
          refresh();
        });
      }
      if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', function () {
          if (filterFromInput) filterFromInput.value = '';
          if (filterToInput) filterToInput.value = '';
          if (filterActorSelect) filterActorSelect.value = '';
          if (filterTargetInput) filterTargetInput.value = '';
          activeFrom = '';
          activeTo = '';
          activeActor = '';
          activeTarget = '';
          refresh();
        });
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function () {
          if (!nextCursor || loadMoreInFlight) return;
          loadMoreInFlight = true;
          loadMoreBtn.disabled = true;
          loadMoreBtn.setAttribute('aria-busy', 'true');
          loadMoreBtn.textContent = 'Loading…';
          fetchPage(nextCursor).finally(function () {
            loadMoreInFlight = false;
            loadMoreBtn.disabled = false;
            loadMoreBtn.removeAttribute('aria-busy');
            loadMoreBtn.textContent = 'Load more';
          });
        });
      }

      function downloadExport(format) {
        const token = getToken();
        if (!token) {
          showBanner('Sign in to export audit log.');
          return;
        }
        if (exportInFlight) return;
        exportInFlight = true;
        const activeExportBtn = format === 'csv' ? exportCsvBtn : exportJsonBtn;
        [exportCsvBtn, exportJsonBtn].forEach(function (btn) {
          if (!btn) return;
          btn.disabled = true;
          btn.removeAttribute('aria-busy');
        });
        if (activeExportBtn) {
          activeExportBtn.setAttribute('aria-busy', 'true');
          const label = activeExportBtn.querySelector('[data-export-label]');
          if (label) label.textContent = 'Exporting ' + format.toUpperCase() + '…';
        }
        // Direct fetch + blob download — keeps the auth header out of
        // the URL (a window.location.assign would leak the bearer in
        // browser history if any redirect chain were involved).
        boundedFetch(
          apiBaseUrl + '/v1/account/audit-log/export?format=' + encodeURIComponent(format),
          {
            headers: {
              authorization: 'Bearer ' + token,
              ...(typeof window.driftstackActAsHeaders === 'function'
                ? window.driftstackActAsHeaders()
                : {}),
            },
          },
        )
          .then(function (r) {
            if (!r.ok) {
              // Error responses are problem+json, not the export blob —
              // surface the server's `detail` (W151/W152) so a refused
              // export explains why (e.g. an export rate-limit) instead
              // of a bare "HTTP 429".
              return r
                .json()
                .catch(function () {
                  return {};
                })
                .then(function (b) {
                  throw window.driftstackResponseError(r, b);
                });
            }
            return r.blob().then(function (blob) {
              const cd = r.headers.get('content-disposition') || '';
              const m = /filename="([^"]+)"/.exec(cd);
              const name = m ? m[1] : 'audit-log.' + format;
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = name;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              URL.revokeObjectURL(url);
            });
          })
          .catch(function (err) {
            showBanner(
              'Export failed (' +
                requestErrorMessage(err, 'Could not export the audit log. Try again.') +
                ').',
            );
          })
          .finally(function () {
            exportInFlight = false;
            [exportCsvBtn, exportJsonBtn].forEach(function (btn) {
              if (!btn) return;
              btn.disabled = false;
              btn.removeAttribute('aria-busy');
              const label = btn.querySelector('[data-export-label]');
              if (label) label.textContent = btn === exportCsvBtn ? 'Export CSV' : 'Export JSON';
            });
          });
      }

      if (exportCsvBtn) exportCsvBtn.addEventListener('click', function () { downloadExport('csv'); });
      if (exportJsonBtn) exportJsonBtn.addEventListener('click', function () { downloadExport('json'); });

      refresh();
    })();
  </script>
</DashboardLayout>
