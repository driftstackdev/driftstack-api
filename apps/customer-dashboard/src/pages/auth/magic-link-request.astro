---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// #190 — Magic-link REQUEST page (the inbound side of the magic-link
// flow). Pairs with the V-079 backend route
// `POST /v1/auth/magic-link/request`.
//
// Flow:
//   1. User lands here from /login → "Sign in with a magic link instead"
//      or directly via /auth/magic-link-request?email=… deep-link.
//   2. Submits email; server returns `{sent: true, expires_at[, debug_token]}`.
//      The shape is stable regardless of whether the email matches an
//      account (anti-enumeration — same posture as forgot-password).
//   3. Page shows "Check your inbox" + the email used + the expires_at
//      window. The /auth/magic-link consume page handles click-through.
//   4. Dev convenience: when AUTH_EXPOSE_DEBUG_TOKEN=true on the server,
//      a `debug_token` field is surfaced as a paste-into link.
//
// Mirrors forgot-password.astro's shape so the visual + behavior are
// consistent across the two no-leak self-service flows.

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Magic-link sign-in" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="magic-link-request"
  >
    <p class="section-label">Passwordless sign-in</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Email me a sign-in link
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      Skip the password. Enter the email tied to your Driftstack account and we'll send a
      one-shot link that signs you in for the next session.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form data-form class="space-y-5">
        <div>
          <label class="form-label" for="magic-link-email">Email</label>
          <input
            id="magic-link-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Send magic-link</button>
      </form>

      <div
        data-success
        class="mt-6 hidden rounded-lg border border-tk-ready/30 bg-tk-ready/10 p-4 backdrop-blur-sm"
      >
        <h2 class="text-sm font-semibold text-tk-ready-text">Check your inbox</h2>
        <p class="mt-2 text-sm text-tk-ready-text">
          If <span data-success-email class="font-mono text-tk-accent-text"></span> matches a Driftstack
          account, a one-shot sign-in link is on the way. The link expires in <span
            data-success-window
            class="font-mono">15 minutes</span
          >.
        </p>
        <div
          data-debug-token
          class="mt-3 hidden rounded border border-tk-ready/30 bg-tk-bg/40 px-3 py-2 text-xs text-tk-ink-2"
        >
          <span class="font-mono uppercase tracking-wide text-tk-accent-text">Dev mode:</span>
          <a data-debug-link href="#" class="font-mono text-tk-accent-text underline">Open magic-link</a>
        </div>
      </div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Prefer a password? <a
          href="/login"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Back to sign-in</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="magic-link-request"]');
      if (!root) return;
      const form = root.querySelector('[data-form]');
      const banner = root.querySelector('[data-banner]');
      const success = root.querySelector('[data-success]');
      const successEmail = root.querySelector('[data-success-email]');
      const successWindow = root.querySelector('[data-success-window]');
      const debugWrap = root.querySelector('[data-debug-token]');
      const debugLink = root.querySelector('[data-debug-link]');
      const emailInput = root.querySelector('#magic-link-email');
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitLabel = submitBtn ? submitBtn.textContent : '';
      const REQUEST_TIMEOUT_MS = 15_000;

      // Honor ?email= prefill — e.g. from a /login bounce after a failed
      // password attempt where the user wants to try magic-link instead.
      const params = new URLSearchParams(window.location.search);
      const prefill = params.get('email');
      if (prefill && emailInput) emailInput.value = prefill;

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function setSubmitting(on) {
        if (!submitBtn) return;
        submitBtn.disabled = on;
        submitBtn.setAttribute('aria-busy', on ? 'true' : 'false');
        submitBtn.textContent = on ? 'Sending…' : submitLabel;
      }

      let requestInFlight = false;
      let requestOutcomeUnknown = false;
      function showUnknownOutcome(email) {
        requestOutcomeUnknown = true;
        successEmail.textContent = email;
        form.classList.add('hidden');
        success.classList.remove('hidden');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.setAttribute('aria-busy', 'false');
          submitBtn.textContent = 'Check inbox before retrying';
        }
        showBanner(
          'Magic-link delivery is unknown after the request timed out. The server may already have sent the one-shot sign-in email. Do not request another link on this page. Check your inbox and spam folder first; if multiple messages arrive, use the newest one.',
        );
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        // A double-click (or a fast double-Enter) fired this POST twice
        // before the first response swapped the form away — each request
        // mints a NEW valid magic-link token, so the customer's inbox got
        // two working sign-in links instead of one.
        if (requestOutcomeUnknown) return;
        if (requestInFlight) return;
        requestInFlight = true;
        setSubmitting(true);
        banner.classList.add('hidden');
        const email = (new FormData(form).get('email') || '').toString();
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
        fetch(apiBaseUrl + '/v1/auth/magic-link/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email }),
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            successEmail.textContent = email;
            if (body.expires_at) {
              const minutes = Math.max(
                1,
                Math.round((new Date(body.expires_at).getTime() - Date.now()) / 60000),
              );
              successWindow.textContent = minutes + ' minutes';
            }
            if (body.debug_token) {
              debugLink.setAttribute(
                'href',
                '/auth/magic-link?token=' + encodeURIComponent(body.debug_token),
              );
              debugWrap.classList.remove('hidden');
            }
            form.classList.add('hidden');
            success.classList.remove('hidden');
          })
          .catch((err) => {
            if (controller.signal.aborted) {
              showUnknownOutcome(email);
              return;
            }
            showBanner(
              err && err.message ? err.message : 'Request failed.',
            );
          })
          .finally(() => {
            window.clearTimeout(timeout);
            requestInFlight = false;
            if (!requestOutcomeUnknown) setSubmitting(false);
          });
      });
    })();
  </script>
</DashboardLayout>
