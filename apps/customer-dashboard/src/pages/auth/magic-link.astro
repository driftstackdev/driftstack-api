---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// #190 — magic-link consume page. Pairs with the V-079 backend route
// `POST /v1/auth/magic-link/consume`.
//
// Flow:
//   1. User requests a magic-link on /login (forgot-password style).
//   2. Email arrives; clicking the link lands here with ?token=…
//   3. This page POSTs `{ token }` to the backend.
//   4. Server returns a session, or an MFA challenge for enrolled accounts.
//   5. The page exchanges TOTP/recovery when required, then writes the session
//      to localStorage and redirects to / (or the safe ?next= path).
//   6. Token is one-shot — second use returns 400; a successful MFA challenge is too.
//
// The form is rendered as a fallback for the rare case where a mail
// client mangles the link (drops the query string), so the user can
// paste the token manually.

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Magic link" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="magic-link"
  >
    <p class="section-label">Magic-link sign-in</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Signing you in…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Verifying your magic-link token. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div
        data-unknown-recovery
        class="mb-5 hidden rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
      >
        <a href="/login" class="btn-primary flex w-full items-center justify-center"
          >Request a fresh sign-in link</a
        >
      </div>

      <form
        data-form="magic-link-mfa"
        novalidate
        class="hidden space-y-5"
        aria-label="Two-factor verification"
      >
        <div>
          <h2 class="text-base font-semibold text-tk-ink">Finish two-factor verification</h2>
          <p class="mt-2 text-sm text-tk-ink-2">
            Your email link is verified. Enter the code from your authenticator app.
            This challenge expires in <span data-mfa-expiry class="font-mono">5 minutes</span>.
          </p>
        </div>
        <div data-mfa-code-row>
          <label class="form-label" for="magic-link-mfa-code">Authentication code</label>
          <input
            id="magic-link-mfa-code"
            name="mfa-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            class="form-input font-mono tracking-widest"
            placeholder="123456"
          />
        </div>
        <div data-mfa-recovery-row class="hidden">
          <label class="form-label" for="magic-link-mfa-recovery">Recovery code</label>
          <input
            id="magic-link-mfa-recovery"
            name="mfa-recovery"
            type="text"
            autocomplete="one-time-code"
            class="form-input font-mono uppercase tracking-wider"
            placeholder="ABCD-EFGHJK"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Verify and sign in</button>
        <button
          type="button"
          data-mfa-toggle-recovery
          class="w-full text-sm text-tk-accent-text underline underline-offset-4"
        >Use a recovery code instead</button>
      </form>

      <form data-form="magic-link" class="hidden space-y-5" data-state="fallback">
        <p class="text-sm text-tk-ink-2">
          We couldn't find a token in the URL. Paste the one from your magic-link email below
          (everything after <code class="text-tk-accent-text">?token=</code>):
        </p>
        <div>
          <label class="form-label" for="magic-link-token"> Magic-link token </label>
          <input
            id="magic-link-token"
            name="token"
            type="text"
            required
            autocomplete="one-time-code"
            class="form-input font-mono tracking-wider"
            placeholder="Paste your token"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Sign in</button>
      </form>

      <p class="mt-6 text-xs text-tk-ink-3">
        Link expired? Request a fresh one from the
        <a
          href="/login"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">login page</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="magic-link"]');
      if (!root) return;
      const intro = root.querySelector('[data-field="intro"]');
      const banner = root.querySelector('[data-banner]');
      const form = root.querySelector('[data-form="magic-link"]');
      const tokenInput = root.querySelector('#magic-link-token');
      const unknownRecovery = root.querySelector('[data-unknown-recovery]');
      const mfaForm = root.querySelector('[data-form="magic-link-mfa"]');
      const mfaCodeRow = root.querySelector('[data-mfa-code-row]');
      const mfaRecoveryRow = root.querySelector('[data-mfa-recovery-row]');
      const mfaCodeInput = root.querySelector('#magic-link-mfa-code');
      const mfaRecoveryInput = root.querySelector('#magic-link-mfa-recovery');
      const mfaToggle = root.querySelector('[data-mfa-toggle-recovery]');
      const mfaExpiry = root.querySelector('[data-mfa-expiry]');

      const safeNextPath = (next, origin) => {
        if (typeof next !== 'string' || next.length === 0) return '/';
        let u;
        try {
          u = new URL(next, origin);
        } catch (e) {
          return '/';
        }
        if (u.origin !== origin) return '/';
        const p = u.pathname + u.search + u.hash;
        if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
        return p;
      };

      function completeSession(session) {
        localStorage.setItem('ds_web_session_token', session.token);
        localStorage.removeItem('ds_act_as_account');
        localStorage.removeItem('ds_is_team_user');
        localStorage.removeItem('ds_is_staff_user');
        const params = new URLSearchParams(window.location.search);
        window.location.href = safeNextPath(params.get('next'), window.location.origin);
      }

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function showFallbackForm(prefill) {
        if (intro)
          intro.textContent =
            "Couldn't find a token in the URL. Paste it from your email to sign in.";
        if (form) form.classList.remove('hidden');
        if (prefill && tokenInput) tokenInput.value = prefill;
      }

      const consumeSubmit = form ? form.querySelector('button[type="submit"]') : null;
      const consumeSubmitText = consumeSubmit ? consumeSubmit.textContent : '';
      const CONSUME_TIMEOUT_MS = 15_000;
      const MFA_TIMEOUT_MS = 15_000;
      let consumeInFlight = false;
      let consumeOutcomeUnknown = false;
      let mfaChallengeToken = null;
      let mfaUsingRecovery = false;
      let mfaInFlight = false;
      let mfaOutcomeUnknown = false;
      function setConsumeBusy(busy) {
        if (form) form.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (tokenInput) tokenInput.disabled = busy || consumeOutcomeUnknown;
        if (consumeSubmit) {
          consumeSubmit.disabled = busy || consumeOutcomeUnknown;
          consumeSubmit.textContent = busy
            ? 'Signing in…'
            : consumeOutcomeUnknown
              ? 'Sign-in outcome unknown'
              : consumeSubmitText;
        }
      }

      function startMfaChallenge(body) {
        if (!body.challenge_token) {
          showBanner('Two-factor verification could not start. Request a fresh sign-in link.');
          return;
        }
        mfaChallengeToken = body.challenge_token;
        mfaOutcomeUnknown = false;
        if (form) form.classList.add('hidden');
        banner.classList.add('hidden');
        if (intro) intro.textContent = 'Your email link is verified. Finish with your second factor.';
        if (body.challenge_expires_at && mfaExpiry) {
          const minutes = Math.max(
            1,
            Math.round((new Date(body.challenge_expires_at).getTime() - Date.now()) / 60000),
          );
          mfaExpiry.textContent = minutes + (minutes === 1 ? ' minute' : ' minutes');
        }
        if (mfaForm) mfaForm.classList.remove('hidden');
        if (mfaCodeInput) mfaCodeInput.focus();
      }

      if (mfaToggle) {
        mfaToggle.addEventListener('click', () => {
          if (mfaInFlight || mfaOutcomeUnknown) return;
          mfaUsingRecovery = !mfaUsingRecovery;
          mfaCodeRow.classList.toggle('hidden', mfaUsingRecovery);
          mfaRecoveryRow.classList.toggle('hidden', !mfaUsingRecovery);
          mfaToggle.textContent = mfaUsingRecovery
            ? 'Use an authenticator code instead'
            : 'Use a recovery code instead';
          const activeInput = mfaUsingRecovery ? mfaRecoveryInput : mfaCodeInput;
          if (activeInput) activeInput.focus();
        });
      }

      if (mfaForm) {
        const mfaSubmit = mfaForm.querySelector('button[type="submit"]');
        const mfaSubmitLabel = mfaSubmit ? mfaSubmit.textContent : '';
        mfaForm.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!mfaChallengeToken || mfaInFlight || mfaOutcomeUnknown) return;
          const code = mfaCodeInput ? mfaCodeInput.value.trim() : '';
          const recoveryCode = mfaRecoveryInput ? mfaRecoveryInput.value.trim() : '';
          if (mfaUsingRecovery ? recoveryCode.length === 0 : !/^\d{6}$/.test(code)) {
            showBanner(
              mfaUsingRecovery
                ? 'Enter one of your recovery codes.'
                : 'Enter the 6-digit code from your authenticator app.',
            );
            return;
          }
          const payload = mfaUsingRecovery
            ? { challenge_token: mfaChallengeToken, recovery_code: recoveryCode }
            : { challenge_token: mfaChallengeToken, code: code };
          mfaInFlight = true;
          banner.classList.add('hidden');
          if (mfaSubmit) {
            mfaSubmit.disabled = true;
            mfaSubmit.setAttribute('aria-busy', 'true');
            mfaSubmit.textContent = 'Verifying…';
          }
          if (mfaToggle) mfaToggle.disabled = true;
          const controller = new AbortController();
          const timeout = window.setTimeout(() => controller.abort(), MFA_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/mfa/challenge', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
            signal: controller.signal,
          })
            .then((response) =>
              response.ok
                ? response.json()
                : response
                    .json()
                    .catch(() => ({}))
                    .then((problem) =>
                      Promise.reject(new Error(problem.detail || 'HTTP ' + response.status)),
                    ),
            )
            .then((body) => {
              const session = body && body.session;
              if (!session || !session.token)
                throw new Error('The server did not return a session. Sign in again.');
              mfaChallengeToken = null;
              completeSession(session);
            })
            .catch((err) => {
              if (err && err.name === 'AbortError') {
                mfaOutcomeUnknown = true;
                mfaChallengeToken = null;
                mfaForm.classList.add('hidden');
                if (unknownRecovery) unknownRecovery.classList.remove('hidden');
                if (intro) intro.textContent = 'MFA sign-in outcome unknown';
                showBanner(
                  'MFA sign-in outcome is unknown after the request timed out. The server may already have consumed this one-time challenge and created a session whose credential did not reach this browser. Do not submit this code again; request a fresh sign-in link.',
                );
                return;
              }
              showBanner(err && err.message ? err.message : 'Verification failed. Try again.');
            })
            .finally(() => {
              window.clearTimeout(timeout);
              mfaInFlight = false;
              if (!mfaOutcomeUnknown) {
                if (mfaSubmit) {
                  mfaSubmit.disabled = false;
                  mfaSubmit.removeAttribute('aria-busy');
                  mfaSubmit.textContent = mfaSubmitLabel;
                }
                if (mfaToggle) mfaToggle.disabled = false;
              }
            });
        });
      }

      function submitToken(token) {
        if (consumeInFlight || consumeOutcomeUnknown) return Promise.resolve(false);
        consumeInFlight = true;
        setConsumeBusy(true);
        banner.classList.add('hidden');
        if (intro) intro.textContent = 'Signing you in…';

        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), CONSUME_TIMEOUT_MS);

        return fetch(apiBaseUrl + '/v1/auth/magic-link/consume', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token: token }),
          credentials: 'include',
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            if (body.mfa_required === true) {
              startMfaChallenge(body);
              return;
            }
            const session = body && body.session;
            if (!session || !session.token)
              throw new Error('The server did not return a session. Sign in again.');
            completeSession(session);
          })
          .catch((err) => {
            if (err && err.name === 'AbortError') {
              consumeOutcomeUnknown = true;
              if (form) form.classList.add('hidden');
              if (unknownRecovery) unknownRecovery.classList.remove('hidden');
              if (intro) intro.textContent = 'Sign-in outcome unknown';
              showBanner(
                'Magic-link sign-in outcome is unknown after the request timed out. The server may already have consumed this one-time link and created a session whose credential did not reach this browser. Do not try this link again; request a fresh sign-in link.',
              );
              return;
            }
            showFallbackForm(token);
            showBanner(err && err.message ? err.message : 'Magic-link sign-in failed.');
          })
          .finally(() => {
            window.clearTimeout(timeout);
            consumeInFlight = false;
            setConsumeBusy(false);
          });
      }

      const params = new URLSearchParams(window.location.search);
      const linkToken = params.get('token');

      if (linkToken && linkToken.length > 0) {
        submitToken(linkToken);
      } else {
        showFallbackForm(null);
      }

      if (form) {
        form.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const fd = new FormData(form);
          const token = fd.get('token');
          if (typeof token === 'string' && token.length > 0) submitToken(token);
        });
      }
    })();
  </script>
</DashboardLayout>
