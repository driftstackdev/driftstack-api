---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// #190 — magic-link consume page. Pairs with the V-079 backend route
// `POST /v1/auth/magic-link/consume`.
//
// Flow:
//   1. User requests a magic-link on /login (forgot-password style).
//   2. Email arrives; clicking the link lands here with ?token=…
//   3. This page POSTs `{ token }` to the backend.
//   4. Server returns a fresh web session on success; page writes
//      `ds_web_session_token` to localStorage and redirects to /
//      (or ?next= if the original entry round-tripped one).
//   5. Token is one-shot — second use returns 400.
//
// The form is rendered as a fallback for the rare case where a mail
// client mangles the link (drops the query string), so the user can
// paste the token manually.

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Magic link" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="magic-link"
  >
    <p class="section-label">Magic-link sign-in</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Signing you in…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Verifying your magic-link token. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form data-form="magic-link" class="hidden space-y-5" data-state="fallback">
        <p class="text-sm text-tk-ink-2">
          We couldn't find a token in the URL. Paste the one from your magic-link email below
          (everything after <code class="text-tk-accent-text">?token=</code>):
        </p>
        <div>
          <label class="form-label" for="magic-link-token"> Magic-link token </label>
          <input
            id="magic-link-token"
            name="token"
            type="text"
            required
            autocomplete="one-time-code"
            class="form-input font-mono tracking-wider"
            placeholder="Paste your token"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Sign in</button>
      </form>

      <p class="mt-6 text-xs text-tk-ink-3">
        Link expired? Request a fresh one from the
        <a
          href="/login"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">login page</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="magic-link"]');
      if (!root) return;
      const intro = root.querySelector('[data-field="intro"]');
      const banner = root.querySelector('[data-banner]');
      const form = root.querySelector('[data-form="magic-link"]');
      const tokenInput = root.querySelector('#magic-link-token');

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function showFallbackForm(prefill) {
        if (intro)
          intro.textContent =
            "Couldn't find a token in the URL. Paste it from your email to sign in.";
        if (form) form.classList.remove('hidden');
        if (prefill && tokenInput) tokenInput.value = prefill;
      }

      const consumeSubmit = form ? form.querySelector('button[type="submit"]') : null;
      const consumeSubmitText = consumeSubmit ? consumeSubmit.textContent : '';
      let consumeInFlight = false;
      function setConsumeBusy(busy) {
        if (form) form.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (tokenInput) tokenInput.disabled = busy;
        if (consumeSubmit) {
          consumeSubmit.disabled = busy;
          consumeSubmit.textContent = busy ? 'Signing in…' : consumeSubmitText;
        }
      }

      function submitToken(token) {
        if (consumeInFlight) return Promise.resolve(false);
        consumeInFlight = true;
        setConsumeBusy(true);
        banner.classList.add('hidden');
        if (intro) intro.textContent = 'Signing you in…';

        return fetch(apiBaseUrl + '/v1/auth/magic-link/consume', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token: token }),
          credentials: 'include',
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            const session = body.session || {};
            if (session.token) {
              localStorage.setItem('ds_web_session_token', session.token);
              // audit w2flmiw48 #2 — clear the previous user's per-session overrides
              // (acting-as + staff/team flags) so a fresh session can't inherit them.
              localStorage.removeItem('ds_act_as_account');
              localStorage.removeItem('ds_is_team_user');
              localStorage.removeItem('ds_is_staff_user');
            }
            // Open-redirect guard for ?next= — reduce to a SAME-ORIGIN relative path
            // (else '/'), so a magic-link can't bounce a just-authenticated user off-site
            // to a phishing page. Inline copy of src/lib/safe-next.ts (unit-tested),
            // matching login.astro/verify-email.astro; an is:inline script can't import.
            const safeNextPath = (next, origin) => {
              if (typeof next !== 'string' || next.length === 0) return '/';
              let u;
              try {
                u = new URL(next, origin);
              } catch (e) {
                return '/';
              }
              if (u.origin !== origin) return '/';
              const p = u.pathname + u.search + u.hash;
              if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
              return p;
            };
            const params = new URLSearchParams(window.location.search);
            window.location.href = safeNextPath(params.get('next'), window.location.origin);
          })
          .catch((err) => {
            showFallbackForm(token);
            showBanner(err && err.message ? err.message : 'Magic-link sign-in failed.');
          })
          .finally(() => {
            consumeInFlight = false;
            setConsumeBusy(false);
          });
      }

      const params = new URLSearchParams(window.location.search);
      const linkToken = params.get('token');

      if (linkToken && linkToken.length > 0) {
        submitToken(linkToken);
      } else {
        showFallbackForm(null);
      }

      if (form) {
        form.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const fd = new FormData(form);
          const token = fd.get('token');
          if (typeof token === 'string' && token.length > 0) submitToken(token);
        });
      }
    })();
  </script>
</DashboardLayout>
