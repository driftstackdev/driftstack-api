---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

// V-667.C — OAuth-client callback landing page. The IDP redirects
// the user here with ?code=...&state=... after they approve consent.
// This page POSTs the same query params back to /v1/auth/oauth-client
// /callback (server-side; the GET endpoint surfaces outcome via JSON)
// and routes based on the outcome:
//   signed-in-existing-link / created-new-account → /
//   collision-pending-verification → /auth/oauth-client/check-email
//   existing-link-revoked → /login with "re-link or password" prompt
//
// PKCE verifier cookie round-trip is automatic via credentials:'include'.

import { resolveApiBaseUrl } from '../../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Signing you in…" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="oauth-callback"
  >
    <p class="section-label">OAuth callback</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink-primary" style="letter-spacing: -0.02em;">
      Signing you in…
    </h1>
    <p class="mt-3 text-sm text-ink-secondary" data-field="intro">
      Completing the handshake with your identity provider. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div data-success-merge class="hidden rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-4 backdrop-blur-sm">
        <h2 class="text-sm font-semibold text-emerald-300">Check your inbox</h2>
        <p class="mt-2 text-sm text-emerald-100">
          We sent a confirmation link to <span data-merge-email class="font-mono text-glow-red-soft"></span>
          to verify both accounts belong to you. Click the link in that email to finish linking your
          <span data-merge-provider class="font-mono">IDP</span> account.
          The link expires in <span data-merge-window class="font-mono">60 minutes</span>.
        </p>
      </div>

      <p class="mt-6 text-xs text-ink-muted">
        Need to start over? <a
          href="/login"
          class="text-glow-red underline underline-offset-4 hover:text-glow-red-soft">Back to sign-in</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="oauth-callback"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const intro = root.querySelector('[data-field="intro"]');
      const successMerge = root.querySelector('[data-success-merge]');
      const mergeProvider = root.querySelector('[data-merge-provider]');
      const mergeWindow = root.querySelector('[data-merge-window]');

      function showBanner(text) {
        if (intro) intro.textContent = '';
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      const qs = window.location.search;
      if (!qs || qs.length === 0) {
        showBanner('Missing callback parameters.');
        return;
      }

      fetch(apiBaseUrl + '/v1/auth/oauth-client/callback' + qs, {
        method: 'GET',
        credentials: 'include', // PKCE cookie round-trip
      })
        .then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
        )
        .then((body) => {
          if (body.outcome === 'signed-in-existing-link' || body.outcome === 'created-new-account') {
            // The server has minted the session via Set-Cookie or response body
            // (V-667.B-9 next slice: actually mint the web session in the
            // callback handler). For now, navigate to the redirect_to.
            window.location.href = body.redirect_to || '/';
            return;
          }
          if (body.outcome === 'collision-pending-verification') {
            if (intro) intro.textContent = '';
            if (mergeProvider && qs.indexOf('provider=github') >= 0) {
              mergeProvider.textContent = 'GitHub';
            } else if (mergeProvider) {
              mergeProvider.textContent = 'Google';
            }
            if (body.expires_at) {
              const minutes = Math.max(
                1,
                Math.round((new Date(body.expires_at).getTime() - Date.now()) / 60000),
              );
              if (mergeWindow) mergeWindow.textContent = minutes + ' minutes';
            }
            successMerge.classList.remove('hidden');
            return;
          }
          if (body.outcome === 'existing-link-revoked') {
            showBanner(
              'This identity-provider link was previously revoked. Sign in with your password, or click the IDP button on the login page to re-link.',
            );
            return;
          }
          showBanner('Unexpected outcome: ' + (body.outcome || '<missing>'));
        })
        .catch((err) => {
          showBanner(err && err.message ? err.message : 'OAuth callback failed.');
        });
    })();
  </script>
</DashboardLayout>
