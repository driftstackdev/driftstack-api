---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

// V-667.C — OAuth-client callback landing page. The IDP redirects
// the user here with ?code=...&state=... after they approve consent.
// This page POSTs the same query params back to /v1/auth/oauth-client
// /callback (server-side; the GET endpoint surfaces outcome via JSON)
// and routes based on the outcome:
//   signed-in-existing-link / created-new-account → session or mfa_required
//   mfa_required → verify TOTP/recovery, then continue to redirect_to
//   collision-pending-verification → /auth/oauth-client/check-email
//   existing-link-revoked → /login with "re-link or password" prompt
//
// PKCE verifier cookie round-trip is automatic via credentials:'include'.

import { resolveApiBaseUrl } from '../../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Signing you in…" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="oauth-callback"
  >
    <p class="section-label">OAuth callback</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Signing you in…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Completing the handshake with your identity provider. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form
        data-form="oauth-mfa"
        novalidate
        class="hidden space-y-5"
        aria-label="Two-factor verification"
      >
        <div>
          <h2 class="text-base font-semibold text-tk-ink">Finish two-factor verification</h2>
          <p class="mt-2 text-sm text-tk-ink-2">
            Your identity provider is verified. Enter the code from your authenticator app.
            This challenge expires in <span data-mfa-expiry class="font-mono">5 minutes</span>.
          </p>
        </div>
        <div data-mfa-code-row>
          <label class="form-label" for="oauth-mfa-code">Authentication code</label>
          <input
            id="oauth-mfa-code"
            name="mfa-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            class="form-input font-mono tracking-widest"
            placeholder="123456"
          />
        </div>
        <div data-mfa-recovery-row class="hidden">
          <label class="form-label" for="oauth-mfa-recovery">Recovery code</label>
          <input
            id="oauth-mfa-recovery"
            name="mfa-recovery"
            type="text"
            autocomplete="one-time-code"
            class="form-input font-mono uppercase tracking-wider"
            placeholder="ABCD-EFGHJK"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Verify and sign in</button>
        <button
          type="button"
          data-mfa-toggle-recovery
          class="w-full text-sm text-tk-accent-text underline underline-offset-4"
        >Use a recovery code instead</button>
      </form>

      <div
        data-callback-unknown
        class="mb-5 hidden rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
      >
        <a href="/login/" class="btn-primary flex w-full items-center justify-center"
          >Return to sign-in if no email arrives</a
        >
      </div>

      <div data-success-merge class="hidden rounded-lg border border-tk-ready/30 bg-tk-ready/10 p-4 backdrop-blur-sm">
        <h2 class="text-sm font-semibold text-tk-ready-text">Check your inbox</h2>
        <p class="mt-2 text-sm text-tk-ready-text">
          We sent a confirmation link to the email on your existing account
          to verify both accounts belong to you. Click the link in that email to finish linking your
          <span data-merge-provider class="font-mono">IDP</span> account.
          The link expires in <span data-merge-window class="font-mono">60 minutes</span>.
        </p>
      </div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Need to start over? <a
          href="/login/"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Back to sign-in</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="oauth-callback"]');
      if (!root) return;

      // Open-redirect guard for the server-returned redirect_to — inline copy
      // of src/lib/safe-next.ts (unit-tested in safe-next.test.ts; kept inline
      // because <script is:inline define:vars> can't import). The callback JSON
      // echoes back the redirect_to that was round-tripped through the signed
      // OAuth state; reduce it to a same-origin relative path before navigating
      // so a forged /start (off-origin redirect_to) can't bounce a just-signed-in
      // user off-site. Mirrors login/signup/verify-email.
      function safeNextPath(next, origin) {
        if (typeof next !== 'string' || next.length === 0) return '/';
        let u;
        try {
          u = new URL(next, origin);
        } catch (e) {
          return '/';
        }
        if (u.origin !== origin) return '/';
        const p = u.pathname + u.search + u.hash;
        if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
        return p;
      }

      const banner = root.querySelector('[data-banner]');
      const intro = root.querySelector('[data-field="intro"]');
      const unknownRecovery = root.querySelector('[data-callback-unknown]');
      const successMerge = root.querySelector('[data-success-merge]');
      const mergeProvider = root.querySelector('[data-merge-provider]');
      const mergeWindow = root.querySelector('[data-merge-window]');
      const mfaForm = root.querySelector('[data-form="oauth-mfa"]');
      const mfaCodeRow = root.querySelector('[data-mfa-code-row]');
      const mfaRecoveryRow = root.querySelector('[data-mfa-recovery-row]');
      const mfaCodeInput = root.querySelector('#oauth-mfa-code');
      const mfaRecoveryInput = root.querySelector('#oauth-mfa-recovery');
      const mfaToggle = root.querySelector('[data-mfa-toggle-recovery]');
      const mfaExpiry = root.querySelector('[data-mfa-expiry]');
      const CALLBACK_TIMEOUT_MS = 15_000;
      const MFA_TIMEOUT_MS = 15_000;
      let mfaChallengeToken = null;
      let mfaRedirectTo = '/';
      let mfaUsingRecovery = false;
      let mfaInFlight = false;
      let mfaOutcomeUnknown = false;

      function showBanner(text) {
        if (intro) intro.textContent = '';
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function canPersistWebSession() {
        const probeKey = 'ds_web_session_storage_probe';
        try {
          localStorage.setItem(probeKey, '1');
          const persisted = localStorage.getItem(probeKey) === '1';
          localStorage.removeItem(probeKey);
          return persisted;
        } catch {
          try {
            localStorage.removeItem(probeKey);
          } catch {
            // Storage is unavailable; there is no probe value to retain.
          }
          return false;
        }
      }

      function completeSession(token, redirectTo) {
        try {
          localStorage.setItem('ds_web_session_token', token);
          if (localStorage.getItem('ds_web_session_token') !== token) {
            throw new Error('session storage read-back failed');
          }
          // A fresh session must not inherit a previous user's per-session
          // acting-as or cached authorization flags on a shared browser.
          localStorage.removeItem('ds_act_as_account');
          localStorage.removeItem('ds_is_team_user');
          localStorage.removeItem('ds_is_staff_user');
          window.location.href = redirectTo;
        } catch (_) {
          showBanner(
            'Sign-in completed, but this browser could not persist the session. Do not reload this callback. Enable site storage, then start a fresh sign-in.',
          );
        }
      }

      function startMfaChallenge(body) {
        if (!body.challenge_token) {
          showBanner('Two-factor verification could not start. Return to sign-in and try again.');
          return;
        }
        mfaChallengeToken = body.challenge_token;
        mfaRedirectTo = safeNextPath(body.redirect_to, window.location.origin);
        mfaOutcomeUnknown = false;
        banner.classList.add('hidden');
        if (intro) {
          intro.textContent = 'Your identity provider is verified. Finish with your second factor.';
        }
        if (body.challenge_expires_at && mfaExpiry) {
          const minutes = Math.max(
            1,
            Math.round((new Date(body.challenge_expires_at).getTime() - Date.now()) / 60000),
          );
          mfaExpiry.textContent = minutes + (minutes === 1 ? ' minute' : ' minutes');
        }
        mfaForm.classList.remove('hidden');
        if (mfaCodeInput) mfaCodeInput.focus();
      }

      if (mfaToggle) {
        mfaToggle.addEventListener('click', () => {
          if (mfaInFlight || mfaOutcomeUnknown) return;
          mfaUsingRecovery = !mfaUsingRecovery;
          mfaCodeRow.classList.toggle('hidden', mfaUsingRecovery);
          mfaRecoveryRow.classList.toggle('hidden', !mfaUsingRecovery);
          mfaToggle.textContent = mfaUsingRecovery
            ? 'Use an authenticator code instead'
            : 'Use a recovery code instead';
          const activeInput = mfaUsingRecovery ? mfaRecoveryInput : mfaCodeInput;
          if (activeInput) activeInput.focus();
        });
      }

      if (mfaForm) {
        const mfaSubmit = mfaForm.querySelector('button[type="submit"]');
        const mfaSubmitLabel = mfaSubmit ? mfaSubmit.textContent : '';
        mfaForm.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!mfaChallengeToken || mfaInFlight || mfaOutcomeUnknown) return;
          const code = mfaCodeInput ? mfaCodeInput.value.trim() : '';
          const recoveryCode = mfaRecoveryInput ? mfaRecoveryInput.value.trim() : '';
          if (mfaUsingRecovery ? recoveryCode.length === 0 : !/^\d{6}$/.test(code)) {
            showBanner(
              mfaUsingRecovery
                ? 'Enter one of your recovery codes.'
                : 'Enter the 6-digit code from your authenticator app.',
            );
            return;
          }
          if (!canPersistWebSession()) {
            showBanner(
              'Enable browser site storage before completing this one-time MFA sign-in. The challenge has not been consumed, so you can retry after storage is available.',
            );
            return;
          }
          const payload = mfaUsingRecovery
            ? { challenge_token: mfaChallengeToken, recovery_code: recoveryCode }
            : { challenge_token: mfaChallengeToken, code: code };
          mfaInFlight = true;
          banner.classList.add('hidden');
          if (mfaSubmit) {
            mfaSubmit.disabled = true;
            mfaSubmit.setAttribute('aria-busy', 'true');
            mfaSubmit.textContent = 'Verifying…';
          }
          if (mfaToggle) mfaToggle.disabled = true;
          const controller = new AbortController();
          const timeout = window.setTimeout(() => controller.abort(), MFA_TIMEOUT_MS);
          fetch(apiBaseUrl + '/v1/auth/mfa/challenge', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
            signal: controller.signal,
          })
            .then((response) =>
              response.ok
                ? response.json()
                : response
                    .json()
                    .catch(() => ({}))
                    .then((problem) =>
                      Promise.reject(window.driftstackResponseError(response, problem)),
                    ),
            )
            .then((body) => {
              const token = body && body.session && body.session.token;
              if (!token)
                throw Object.assign(
                  new Error('The server did not return a session. Sign in again.'),
                  { customerSafe: true },
                );
              mfaChallengeToken = null;
              completeSession(token, mfaRedirectTo);
            })
            .catch((err) => {
              if (err && err.name === 'AbortError') {
                mfaOutcomeUnknown = true;
                mfaChallengeToken = null;
                mfaForm.classList.add('hidden');
                if (unknownRecovery) {
                  unknownRecovery.classList.remove('hidden');
                  const link = unknownRecovery.querySelector('a');
                  if (link) link.textContent = 'Start a fresh sign-in';
                }
                showBanner(
                  'MFA sign-in outcome is unknown after the request timed out. The server may already have consumed this one-time challenge and created a session whose credential did not reach this browser. Do not submit this code again. Start a fresh sign-in.',
                );
                return;
              }
              showBanner(
                window.driftstackRequestErrorMessage(err, 'Verification failed. Try again.'),
              );
            })
            .finally(() => {
              window.clearTimeout(timeout);
              mfaInFlight = false;
              if (!mfaOutcomeUnknown) {
                if (mfaSubmit) {
                  mfaSubmit.disabled = false;
                  mfaSubmit.removeAttribute('aria-busy');
                  mfaSubmit.textContent = mfaSubmitLabel;
                }
                if (mfaToggle) mfaToggle.disabled = false;
              }
            });
        });
      }

      const qs = window.location.search;
      if (!qs || qs.length === 0) {
        showBanner('Missing callback parameters.');
        return;
      }
      window.history.replaceState(
        window.history.state,
        '',
        window.location.pathname + window.location.hash,
      );
      if (!canPersistWebSession()) {
        showBanner(
          'Enable browser site storage before completing this one-time provider sign-in. The callback code has not been exchanged, so you can retry after storage is available.',
        );
        return;
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), CALLBACK_TIMEOUT_MS);
      fetch(apiBaseUrl + '/v1/auth/oauth-client/callback' + qs, {
        method: 'GET',
        credentials: 'include', // PKCE cookie round-trip
        signal: controller.signal,
      })
        .then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
        )
        .then((body) => {
          if (body.outcome === 'signed-in-existing-link' || body.outcome === 'created-new-account') {
            // 2026-05-19 — server now mints the web session inline in
            // the callback handler. Write the token to localStorage
            // before navigating so the dashboard finds it on landing
            // (otherwise the dashboard surfaces "Sign in to see live
            // account data" because localStorage is empty). Mirrors
            // the password-login flow at login.astro:217.
            if (body.mfa_required === true) {
              startMfaChallenge(body);
              return;
            }
            // Sanitize the server-returned redirect_to to a same-origin path
            // (empty/missing → '/'); never navigate a raw off-origin value.
            if (!body.session_token) {
              showBanner('Sign-in could not be completed. Return to sign-in and try again.');
              return;
            }
            completeSession(
              body.session_token,
              safeNextPath(body.redirect_to, window.location.origin),
            );
            return;
          }
          if (body.outcome === 'collision-pending-verification') {
            if (intro) intro.textContent = '';
            if (mergeProvider && qs.indexOf('provider=github') >= 0) {
              mergeProvider.textContent = 'GitHub';
            } else if (mergeProvider) {
              mergeProvider.textContent = 'Google';
            }
            if (body.expires_at) {
              const minutes = Math.max(
                1,
                Math.round((new Date(body.expires_at).getTime() - Date.now()) / 60000),
              );
              if (mergeWindow) mergeWindow.textContent = minutes + ' minutes';
            }
            successMerge.classList.remove('hidden');
            return;
          }
          if (body.outcome === 'existing-link-revoked') {
            showBanner(
              'This identity-provider link was previously revoked. Sign in with your password, or click the IDP button on the login page to re-link.',
            );
            return;
          }
          showBanner('Unexpected outcome: ' + (body.outcome || '<missing>'));
        })
        .catch((err) => {
          if (err && err.name === 'AbortError') {
            if (unknownRecovery) unknownRecovery.classList.remove('hidden');
            showBanner(
              'OAuth sign-in outcome is unknown after the request timed out. The server may already have exchanged this one-time callback code, created a session whose credential did not reach this browser, or sent an account-link confirmation email. Do not reload or submit this callback URL again. Check your inbox first; if no confirmation email arrives, return to sign-in and start a fresh provider authorization.',
            );
            return;
          }
          showBanner(window.driftstackRequestErrorMessage(err, 'OAuth callback failed.'));
        })
        .finally(() => window.clearTimeout(timeout));
    })();
  </script>
</DashboardLayout>
