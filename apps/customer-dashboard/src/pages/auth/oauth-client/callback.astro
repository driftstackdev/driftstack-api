---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

// V-667.C — OAuth-client callback landing page. The IDP redirects
// the user here with ?code=...&state=... after they approve consent.
// This page POSTs the same query params back to /v1/auth/oauth-client
// /callback (server-side; the GET endpoint surfaces outcome via JSON)
// and routes based on the outcome:
//   signed-in-existing-link / created-new-account → /
//   collision-pending-verification → /auth/oauth-client/check-email
//   existing-link-revoked → /login with "re-link or password" prompt
//
// PKCE verifier cookie round-trip is automatic via credentials:'include'.

import { resolveApiBaseUrl } from '../../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Signing you in…" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="oauth-callback"
  >
    <p class="section-label">OAuth callback</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Signing you in…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Completing the handshake with your identity provider. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div
        data-callback-unknown
        class="mb-5 hidden rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
      >
        <a href="/login" class="btn-primary flex w-full items-center justify-center"
          >Return to sign-in if no email arrives</a
        >
      </div>

      <div data-success-merge class="hidden rounded-lg border border-tk-ready/30 bg-tk-ready/10 p-4 backdrop-blur-sm">
        <h2 class="text-sm font-semibold text-tk-ready-text">Check your inbox</h2>
        <p class="mt-2 text-sm text-tk-ready-text">
          We sent a confirmation link to the email on your existing account
          to verify both accounts belong to you. Click the link in that email to finish linking your
          <span data-merge-provider class="font-mono">IDP</span> account.
          The link expires in <span data-merge-window class="font-mono">60 minutes</span>.
        </p>
      </div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Need to start over? <a
          href="/login"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Back to sign-in</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="oauth-callback"]');
      if (!root) return;

      // Open-redirect guard for the server-returned redirect_to — inline copy
      // of src/lib/safe-next.ts (unit-tested in safe-next.test.ts; kept inline
      // because <script is:inline define:vars> can't import). The callback JSON
      // echoes back the redirect_to that was round-tripped through the signed
      // OAuth state; reduce it to a same-origin relative path before navigating
      // so a forged /start (off-origin redirect_to) can't bounce a just-signed-in
      // user off-site. Mirrors login/signup/verify-email.
      function safeNextPath(next, origin) {
        if (typeof next !== 'string' || next.length === 0) return '/';
        let u;
        try {
          u = new URL(next, origin);
        } catch (e) {
          return '/';
        }
        if (u.origin !== origin) return '/';
        const p = u.pathname + u.search + u.hash;
        if (p.indexOf('/') !== 0 || p.indexOf('//') === 0 || p.indexOf('/\\') === 0) return '/';
        return p;
      }

      const banner = root.querySelector('[data-banner]');
      const intro = root.querySelector('[data-field="intro"]');
      const unknownRecovery = root.querySelector('[data-callback-unknown]');
      const successMerge = root.querySelector('[data-success-merge]');
      const mergeProvider = root.querySelector('[data-merge-provider]');
      const mergeWindow = root.querySelector('[data-merge-window]');
      const CALLBACK_TIMEOUT_MS = 15_000;

      function showBanner(text) {
        if (intro) intro.textContent = '';
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      const qs = window.location.search;
      if (!qs || qs.length === 0) {
        showBanner('Missing callback parameters.');
        return;
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), CALLBACK_TIMEOUT_MS);
      fetch(apiBaseUrl + '/v1/auth/oauth-client/callback' + qs, {
        method: 'GET',
        credentials: 'include', // PKCE cookie round-trip
        signal: controller.signal,
      })
        .then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
        )
        .then((body) => {
          if (body.outcome === 'signed-in-existing-link' || body.outcome === 'created-new-account') {
            // 2026-05-19 — server now mints the web session inline in
            // the callback handler. Write the token to localStorage
            // before navigating so the dashboard finds it on landing
            // (otherwise the dashboard surfaces "Sign in to see live
            // account data" because localStorage is empty). Mirrors
            // the password-login flow at login.astro:217.
            if (body.session_token) {
              try {
                localStorage.setItem('ds_web_session_token', body.session_token);
                // audit w2flmiw48 #2 — clear the previous user's per-session overrides
                // (acting-as + staff/team flags) so a fresh session can't inherit them.
                localStorage.removeItem('ds_act_as_account');
                localStorage.removeItem('ds_is_team_user');
                localStorage.removeItem('ds_is_staff_user');
              } catch (_) {
                // Private mode / disabled storage — sign-in stays
                // bound to the cookie if present; if not, the
                // dashboard will redirect back to /login.
              }
            }
            // Sanitize the server-returned redirect_to to a same-origin path
            // (empty/missing → '/'); never navigate a raw off-origin value.
            window.location.href = safeNextPath(body.redirect_to, window.location.origin);
            return;
          }
          if (body.outcome === 'collision-pending-verification') {
            if (intro) intro.textContent = '';
            if (mergeProvider && qs.indexOf('provider=github') >= 0) {
              mergeProvider.textContent = 'GitHub';
            } else if (mergeProvider) {
              mergeProvider.textContent = 'Google';
            }
            if (body.expires_at) {
              const minutes = Math.max(
                1,
                Math.round((new Date(body.expires_at).getTime() - Date.now()) / 60000),
              );
              if (mergeWindow) mergeWindow.textContent = minutes + ' minutes';
            }
            successMerge.classList.remove('hidden');
            return;
          }
          if (body.outcome === 'existing-link-revoked') {
            showBanner(
              'This identity-provider link was previously revoked. Sign in with your password, or click the IDP button on the login page to re-link.',
            );
            return;
          }
          showBanner('Unexpected outcome: ' + (body.outcome || '<missing>'));
        })
        .catch((err) => {
          if (err && err.name === 'AbortError') {
            if (unknownRecovery) unknownRecovery.classList.remove('hidden');
            showBanner(
              'OAuth sign-in outcome is unknown after the request timed out. The server may already have exchanged this one-time callback code, created a session whose credential did not reach this browser, or sent an account-link confirmation email. Do not reload or submit this callback URL again. Check your inbox first; if no confirmation email arrives, return to sign-in and start a fresh provider authorization.',
            );
            return;
          }
          showBanner(
            err && err.message
              ? err.message
              : 'OAuth callback failed.',
          );
        })
        .finally(() => window.clearTimeout(timeout));
    })();
  </script>
</DashboardLayout>
