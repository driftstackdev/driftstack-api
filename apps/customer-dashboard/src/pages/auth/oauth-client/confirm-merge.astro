---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

// V-667.C Verdict 1 — collision-flow completion page. The user clicks
// the email link with ?token=... → this page POSTs to
// /v1/auth/oauth-client/confirm-merge { token } → server links the
// IDP onto the existing account + returns the new account id.
//
// On success the page navigates to /. On error (expired / consumed
// / invalid) it surfaces a banner with a "request a new link" hint
// pointing back to /login.

import { resolveApiBaseUrl } from '../../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Confirm IDP link" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="oauth-confirm-merge"
  >
    <p class="section-label">Confirm link</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Linking your account…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Confirming the verify-merge token. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <div
        data-merge-unknown
        class="mb-5 hidden rounded-lg border border-tk-border bg-tk-surface px-4 py-4 text-sm text-tk-ink-2"
      >
        <a href="/security/" class="btn-primary flex w-full items-center justify-center"
          >Check connected accounts</a
        >
      </div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Link expired or invalid? Sign in via password + retry the IDP
        button from the <a
          href="/login/"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">login page</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="oauth-confirm-merge"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const intro = root.querySelector('[data-field="intro"]');
      const unknownRecovery = root.querySelector('[data-merge-unknown]');
      const CONFIRM_TIMEOUT_MS = 15_000;

      function showBanner(text) {
        if (intro) intro.textContent = '';
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');
      if (!token || token.length === 0) {
        showBanner("Missing 'token' query parameter. Click the link in the verify-merge email.");
        return;
      }

      const controller = new AbortController();
      let mergeResponseAccepted = false;
      const timeout = window.setTimeout(() => controller.abort(), CONFIRM_TIMEOUT_MS);
      fetch(apiBaseUrl + '/v1/auth/oauth-client/confirm-merge', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ token: token }),
        signal: controller.signal,
      })
        .then((r) => {
          // The successful payload is unused. Treat the 2xx itself as the
          // irreversible handoff so malformed response JSON cannot turn a
          // consumed merge token into retry guidance.
          if (r.ok) {
            mergeResponseAccepted = true;
            return;
          }
          return r
            .json()
            .catch(() => ({}))
            .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
        })
        .then(() => {
          window.location.href = '/';
        })
        .catch((err) => {
          if (mergeResponseAccepted) {
            if (unknownRecovery) unknownRecovery.classList.remove('hidden');
            showBanner(
              'Your identity provider was linked, but this page could not finish opening the dashboard. Do not reload or submit this one-time link again. Check connected accounts in Security before taking any other action.',
            );
            return;
          }
          if (err && err.name === 'AbortError') {
            if (unknownRecovery) unknownRecovery.classList.remove('hidden');
            showBanner(
              'Account-link outcome is unknown after the request timed out. The server may already have consumed this one-time token and linked the identity provider. Do not reload or submit this link again. Check connected accounts in Security; if the provider is absent, sign in with your password and retry its IDP button from Login.',
            );
            return;
          }
          showBanner(
            window.driftstackRequestErrorMessage(
              err,
              'Account linking could not be confirmed. Request a new link and try again.',
            ),
          );
        })
        .finally(() => window.clearTimeout(timeout));
    })();
  </script>
</DashboardLayout>
