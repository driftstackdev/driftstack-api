---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

// V-667.C Verdict 1 — collision-flow completion page. The user clicks
// the email link with ?token=... → this page POSTs to
// /v1/auth/oauth-client/confirm-merge { token } → server links the
// IDP onto the existing account + returns the new account id.
//
// On success the page navigates to /. On error (expired / consumed
// / invalid) it surfaces a banner with a "request a new link" hint
// pointing back to /login.

import { resolveApiBaseUrl } from '../../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Confirm IDP link" withSidebar={false}>
  <div
    class="mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
    data-page="oauth-confirm-merge"
  >
    <p class="section-label">Confirm link</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Linking your account…
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2" data-field="intro">
      Confirming the verify-merge token. One moment.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Link expired or invalid? Sign in via password + retry the IDP
        button from the <a
          href="/login"
          class="text-tk-accent underline underline-offset-4 hover:text-tk-accent-soft">login page</a
        >.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="oauth-confirm-merge"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const intro = root.querySelector('[data-field="intro"]');

      function showBanner(text) {
        if (intro) intro.textContent = '';
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');
      if (!token || token.length === 0) {
        showBanner("Missing 'token' query parameter. Click the link in the verify-merge email.");
        return;
      }

      fetch(apiBaseUrl + '/v1/auth/oauth-client/confirm-merge', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ token: token }),
      })
        .then((r) =>
          r.ok
            ? r.json()
            : r
                .json()
                .catch(() => ({}))
                .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
        )
        .then(() => {
          window.location.href = '/';
        })
        .catch((err) => {
          showBanner(err && err.message ? err.message : 'Merge confirmation failed.');
        });
    })();
  </script>
</DashboardLayout>
