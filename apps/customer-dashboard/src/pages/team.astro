---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-298c / V-326e — wires the page to the live /v1/team/* endpoints.
// Members view shows confirmed memberships; pending invites surfaced
// below. Invite form posts to POST /v1/team/invites; remove posts
// DELETE /v1/team/members/:id.
//
// Auth integration: V-326a–V-326e6 closed the cycle. Members can act
// on the owner's resources via the X-Driftstack-Account header; the
// V-331 picker handles toggling. Reads accept both 'member' and
// 'admin' roles; writes require 'admin'.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Team">
  {/* 2026-05-24 — hero-glow atmosphere matches brand surface. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-10" data-page="team">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    {/* 2026-06-30 — team membership (invite/remove/list) is always
        self-scoped — it does NOT honor the "Acting as" picker (see
        the X-Driftstack-Account OpenAPI note: "/v1/team/* do NOT
        honor the header"). Without this notice, a member who flips
        "Acting as <owner>" and opens /team sees the layout's global
        banner promise that "all actions read + write that team's
        resources" while this page silently manages THEIR OWN team
        instead — contradicting the banner with no error. JS below
        reveals this only while acting-as is active. */}
    <div
      data-self-scoped-notice
      class="mb-6 hidden rounded-lg border border-tk-accent/30 bg-tk-accent/10 px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
      Team membership always manages <strong>your own</strong> account, even while "Acting as"
      another account is selected above — the members and invites below are yours, not theirs.
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-sm text-tk-ink-3">Account-scoped team</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Team</h1>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Members with access to this Driftstack account. Each member uses their own login + their
          own dashboard sessions; API keys remain account-scoped (shared) and admin-gated.
        </p>
      </div>
      <button type="button" data-show-invite class="btn-primary shrink-0">Invite member</button>
    </header>

    <!-- Invite form (hidden by default) -->
    <div
      data-invite-form-wrap
      class="mb-8 hidden rounded-lg border border-tk-border bg-tk-surface p-6"
    >
      <h2 class="text-lg font-semibold tracking-tight text-tk-ink">Invite a member</h2>
      <form data-invite-form class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="invite-email">Email</label>
          <input
            id="invite-email"
            name="email"
            type="email"
            required
            placeholder="teammate@example.com"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="invite-role">Role</label>
          <select
            id="invite-role"
            name="role"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent/30"
          >
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <p
          data-invite-error
          class="hidden rounded border border-tk-err/30 bg-tk-err/10 px-3 py-2 text-sm text-tk-err-text"
        >
        </p>
        <div class="flex justify-end gap-3 border-t border-tk-border pt-4">
          <button
            type="button"
            data-invite-cancel
            class="rounded-md border border-tk-border bg-tk-surface px-4 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-bg"
          >
            Cancel
          </button>
          <button
            type="submit"
            data-invite-submit
            class="inline-flex items-center rounded-md bg-tk-accent px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-tk-accent-strong"
          >
            Send invite
          </button>
        </div>
      </form>
    </div>

    {/* 2026-05-23 — icon + count chip on Members/Invites headers. */}
    <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-tk-ink-3">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent" aria-hidden="true">
        <circle cx="9" cy="7" r="4" />
        <path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
        <circle cx="17" cy="9" r="3" />
        <path d="M16 14a4 4 0 0 1 4 4v3" />
      </svg>
      Members
    </h2>
    <ul
      data-members-list
      class="divide-y divide-tk-border rounded-lg border border-tk-border bg-tk-surface"
    >
      {/* 2026-05-24 — skeleton rows for hydrate-state polish. */}
      <li class="px-6 py-4">
        <div class="flex items-center gap-4">
          <div class="h-3 w-40 animate-pulse rounded bg-tk-hover"></div>
          <div class="h-3 w-16 animate-pulse rounded bg-tk-hover"></div>
        </div>
      </li>
      <li class="px-6 py-4">
        <div class="flex items-center gap-4">
          <div class="h-3 w-32 animate-pulse rounded bg-tk-hover"></div>
          <div class="h-3 w-20 animate-pulse rounded bg-tk-hover"></div>
        </div>
      </li>
    </ul>

    <h2 class="mb-3 mt-10 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-tk-ink-3">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent" aria-hidden="true">
        <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
        <polyline points="22,6 12,13 2,6" />
      </svg>
      Pending invites
    </h2>
    <ul
      data-invites-list
      class="divide-y divide-tk-border rounded-lg border border-tk-border bg-tk-surface"
    >
      {/* 2026-05-24 — skeleton rows for hydrate-state polish. */}
      <li class="px-6 py-4">
        <div class="flex items-center gap-4">
          <div class="h-3 w-36 animate-pulse rounded bg-tk-hover"></div>
          <div class="h-3 w-24 animate-pulse rounded bg-tk-hover"></div>
        </div>
      </li>
    </ul>

    <p class="mt-8 text-xs text-tk-ink-3">
      Invitees receive an email with a 7-day accept link. They must accept while signed in to the
      same email address. Once accepted, members can act on this account's resources by toggling
      the "Acting as" picker in the sidebar — reads work for both <code>member</code> and
      <code>admin</code> roles; writes require <code>admin</code>. See
      <a href="https://docs.driftstack.dev/api/team" class="text-tk-accent-text underline" target="_blank" rel="noopener noreferrer">docs.driftstack.dev/api/team</a> for the role gating reference.
    </p>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="team"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const selfScopedNotice = root.querySelector('[data-self-scoped-notice]');
      const membersList = root.querySelector('[data-members-list]');
      const invitesList = root.querySelector('[data-invites-list]');
      const showInviteBtn = root.querySelector('[data-show-invite]');
      const inviteFormWrap = root.querySelector('[data-invite-form-wrap]');
      const inviteForm = root.querySelector('[data-invite-form]');
      const inviteCancel = root.querySelector('[data-invite-cancel]');
      const inviteSubmit = root.querySelector('[data-invite-submit]');
      const inviteError = root.querySelector('[data-invite-error]');
      const TEAM_TIMEOUT_MS = 15_000;
      const removalButtonsInFlight = new WeakSet();
      let inviteInFlight = false;

      function boundedFetch(url, init = {}) {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), TEAM_TIMEOUT_MS);
        return fetch(url, { ...init, signal: controller.signal })
          .catch(function (err) {
            if (err && err.name === 'AbortError') {
              const timeoutError = new Error(
                'Request took too long. Check your connection and try again.',
              );
              timeoutError.name = 'AbortError';
              throw timeoutError;
            }
            throw err;
          })
          .finally(function () {
            window.clearTimeout(timeout);
          });
      }

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function showBanner(msg) {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove('hidden');
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }

      function fmtIsoDay(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }

      // 2026-05-29 — polished empty state (icon + headline + body),
      // consistent with the snapshots/recipes/profiles pages. Replaces
      // the prior plain single-line text so empty lists read as a
      // deliberate state rather than a glitch.
      function emptyState(iconPath, headline, body) {
        return (
          '<li class="px-6 py-12 text-center">' +
          '<div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-tk-accent/10 text-tk-accent ring-1 ring-tk-accent/30">' +
          '<svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="' +
          iconPath +
          '" /></svg>' +
          '</div>' +
          '<p class="text-sm font-medium text-tk-ink">' +
          escapeHtml(headline) +
          '</p>' +
          '<p class="mt-1 text-sm text-tk-ink-3">' +
          escapeHtml(body) +
          '</p>' +
          '</li>'
        );
      }

      function memberRow(m) {
        const removeBtn =
          '<button type="button" data-remove="' +
          escapeHtml(m.id) +
          '" data-remove-email="' +
          escapeHtml(m.member_email) +
          '" class="text-sm text-tk-err-text hover:underline">Remove</button>';
        const roleClass =
          m.role === 'admin' ? 'bg-tk-accent/10 text-tk-accent-text' : 'bg-tk-surface text-tk-ink-2';
        return (
          '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-tk-ink">' +
          escapeHtml(m.member_email) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(m.id) +
          '</p>' +
          '<p class="mt-1 text-xs text-tk-ink-3">Joined ' +
          escapeHtml(fmtIsoDay(m.accepted_at)) +
          '</p></div>' +
          '<div class="flex shrink-0 items-center gap-3">' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium ' +
          roleClass +
          '">' +
          escapeHtml(m.role) +
          '</span>' +
          removeBtn +
          '</div></li>'
        );
      }

      function inviteRow(inv) {
        return (
          '<li class="flex items-start justify-between gap-6 px-6 py-4">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-tk-ink">' +
          escapeHtml(inv.invitee_email) +
          '</p>' +
          '<p class="mt-1 text-xs text-tk-ink-3">Invited ' +
          escapeHtml(fmtIsoDay(inv.created_at)) +
          ' · expires ' +
          escapeHtml(fmtIsoDay(inv.expires_at)) +
          '</p></div>' +
          '<span class="inline-flex shrink-0 rounded-full bg-tk-accent/10 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-accent-text">pending</span>' +
          '</li>'
        );
      }

      // A failed load left the SSR skeleton <li>s pulsing forever — the
      // success-only .then() below is the only path that ever replaces
      // them. Clear both lists to an explicit retry row instead.
      function renderLoadError() {
        [
          [membersList, 'members'],
          [invitesList, 'invites'],
        ].forEach(function (pair) {
          const ul = pair[0];
          const kind = pair[1];
          if (!ul) return;
          ul.innerHTML =
            '<li class="px-6 py-4 text-sm text-tk-ink-3">Couldn\'t load ' +
            kind +
            '. <button type="button" data-action="retry-team-' +
            kind +
            '" class="text-tk-accent-text underline">Retry</button></li>';
          const retryBtn = ul.querySelector('[data-action="retry-team-' + kind + '"]');
          if (retryBtn)
            retryBtn.addEventListener('click', function () {
              refresh();
            });
        });
      }

      function refresh(showLoadError = true) {
        const token = getToken();
        if (!token) {
          if (membersList)
            membersList.innerHTML =
              '<li class="px-6 py-4 text-sm text-tk-ink-3">Sign in to see team members.</li>';
          if (invitesList)
            invitesList.innerHTML =
              '<li class="px-6 py-4 text-sm text-tk-ink-3">Sign in to see pending invites.</li>';
          return Promise.resolve(false);
        }
        return Promise.all([
          boundedFetch(apiBaseUrl + '/v1/team/members', {
            headers: { authorization: 'Bearer ' + token },
          }).then(function (r) {
            if (!r.ok) throw new Error('members HTTP ' + r.status);
            return r.json();
          }),
          boundedFetch(apiBaseUrl + '/v1/team/invites', {
            headers: { authorization: 'Bearer ' + token },
          }).then(function (r) {
            if (!r.ok) throw new Error('invites HTTP ' + r.status);
            return r.json();
          }),
        ])
          .then(function (results) {
            const members = results[0].data || [];
            const invites = results[1].data || [];
            if (membersList) {
              membersList.innerHTML =
                members.length === 0
                  ? emptyState(
                      'M6 6a2.25 2.25 0 1 1 0-4.5 2.25 2.25 0 0 1 0 4.5Z M2 13c.5-2 2-3 4-3s3.5 1 4 3 M10.75 4.25a2 2 0 0 1 0 3.5 M13.5 12.75c-.25-1.5-1-2.25-2.25-2.75',
                      'No team members yet',
                      'Invite one above to collaborate on profiles and sessions.',
                    )
                  : members.map(memberRow).join('');
              wireRemoveButtons();
            }
            if (invitesList) {
              invitesList.innerHTML =
                invites.length === 0
                  ? emptyState(
                      'M2 4.5h12v9H2z M2 5l6 4 6-4',
                      'No pending invites',
                      'Invitations you send will appear here until they are accepted.',
                    )
                  : invites.map(inviteRow).join('');
            }
            return true;
          })
          .catch(function (err) {
            if (showLoadError) {
              renderLoadError();
              showBanner(
                'Failed to load team: ' + (err && err.message ? err.message : 'network error'),
              );
            }
            return false;
          })
          .finally(function () {
            // 2026-05-21 — signal the layout opacity-gate; same pattern
            // as billing/usage/profiles/sessions/api-keys/webhooks.
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function wireRemoveButtons() {
        if (!membersList) return;
        const buttons = membersList.querySelectorAll('[data-remove]');
        buttons.forEach(function (btn) {
          btn.addEventListener('click', async function () {
            if (removalButtonsInFlight.has(btn)) return;
            removalButtonsInFlight.add(btn);
            const id = btn.getAttribute('data-remove');
            const email = btn.getAttribute('data-remove-email') || '(unknown)';
            const ok = await window.driftstackConfirm(
              'Remove ' +
                email +
                ' from the team? They keep their Driftstack account but lose team access.',
              { confirmLabel: 'Remove', destructive: true },
            );
            if (!ok) {
              removalButtonsInFlight.delete(btn);
              return;
            }
            const token = getToken();
            btn.disabled = true;
            btn.setAttribute('aria-busy', 'true');
            btn.textContent = 'Removing…';
            boundedFetch(apiBaseUrl + '/v1/team/members/' + encodeURIComponent(id), {
              method: 'DELETE',
              headers: { authorization: 'Bearer ' + token },
            })
              .then(function (r) {
                if (!r.ok && r.status !== 204) throw new Error('HTTP ' + r.status);
                return refresh();
              })
              .catch(async function (err) {
                if (err && err.name === 'AbortError') {
                  const refreshed = await refresh(false);
                  const stillPresent = membersList
                    ? Array.from(membersList.querySelectorAll('[data-remove]')).some(function (
                        button,
                      ) {
                        return button.getAttribute('data-remove') === id;
                      })
                    : false;
                  if (refreshed && !stillPresent) {
                    showBanner(
                      'Member-removal outcome is unknown because the request timed out. The team list was refreshed and ' +
                        email +
                        ' is no longer present; removal likely completed, so do not submit it again.',
                    );
                  } else if (refreshed) {
                    showBanner(
                      'Member-removal outcome is unknown because the request timed out. The team list was refreshed and ' +
                        email +
                        ' is still present; retry removal if their access must be revoked.',
                    );
                  } else {
                    showBanner(
                      'Member-removal outcome is unknown because the request timed out, and the team list could not be refreshed. Verify membership before retrying.',
                    );
                  }
                } else {
                  showBanner(
                    'Remove failed: ' + (err && err.message ? err.message : 'network error'),
                  );
                }
              })
              .finally(function () {
                removalButtonsInFlight.delete(btn);
                btn.disabled = false;
                btn.setAttribute('aria-busy', 'false');
                btn.textContent = 'Remove';
              });
          });
        });
      }

      function showInvite() {
        if (!getToken()) {
          showBanner('Sign in to invite team members.');
          return;
        }
        if (inviteFormWrap) inviteFormWrap.classList.remove('hidden');
        const emailInput = inviteForm && inviteForm.querySelector('input[name="email"]');
        if (emailInput) emailInput.focus();
      }
      function hideInvite() {
        if (inviteFormWrap) inviteFormWrap.classList.add('hidden');
        if (inviteError) {
          inviteError.classList.add('hidden');
          inviteError.textContent = '';
        }
        if (inviteForm) inviteForm.reset();
      }

      if (showInviteBtn) showInviteBtn.addEventListener('click', showInvite);
      if (inviteCancel) inviteCancel.addEventListener('click', hideInvite);
      if (inviteForm) {
        inviteForm.addEventListener('submit', function (event) {
          event.preventDefault();
          if (inviteInFlight) return;
          const formData = new FormData(inviteForm);
          const email = String(formData.get('email') || '').trim();
          const role = String(formData.get('role') || 'member');
          if (!email) {
            if (inviteError) {
              inviteError.textContent = 'Email is required.';
              inviteError.classList.remove('hidden');
            }
            return;
          }
          inviteInFlight = true;
          const token = getToken();
          if (inviteSubmit) {
            inviteSubmit.disabled = true;
            inviteSubmit.setAttribute('aria-busy', 'true');
            inviteSubmit.textContent = 'Sending…';
          }
          boundedFetch(apiBaseUrl + '/v1/team/invites', {
            method: 'POST',
            headers: {
              authorization: 'Bearer ' + token,
              'content-type': 'application/json',
            },
            body: JSON.stringify({ email: email, role: role }),
          })
            .then(function (r) {
              if (!r.ok && r.status !== 202) {
                return r
                  .json()
                  .catch(function () {
                    return {};
                  })
                  .then(function (b) {
                    throw new Error(b.detail || 'HTTP ' + r.status);
                  });
              }
              return refresh();
            })
            .then(function () {
              hideInvite();
            })
            .catch(async function (err) {
              if (inviteError) {
                if (err && err.name === 'AbortError') {
                  const refreshed = await refresh(false);
                  inviteError.textContent =
                    'Invite outcome is unknown after the request timed out. ' +
                    (refreshed
                      ? 'The pending-invite list was refreshed. '
                      : "We couldn't refresh pending invites. ") +
                    'If ' +
                    email +
                    ' appears there, do not send it again: resending replaces the first link and sends another email.';
                } else {
                  inviteError.textContent = err && err.message ? err.message : 'Invite failed.';
                }
                inviteError.classList.remove('hidden');
              }
            })
            .finally(function () {
              inviteInFlight = false;
              if (inviteSubmit) {
                inviteSubmit.disabled = false;
                inviteSubmit.setAttribute('aria-busy', 'false');
                inviteSubmit.textContent = 'Send invite';
              }
            });
        });
      }

      // 2026-06-30 — team membership is always self-scoped (it does
      // not honor the "Acting as" header — see the OpenAPI X-Driftstack-
      // Account note). Surface that explicitly whenever the global
      // picker has an active selection, so this page never silently
      // contradicts the layout's "Acting as <owner>" banner.
      function revealSelfScopedNoticeIfActingAs() {
        if (!selfScopedNotice) return;
        let actingAs = '';
        try {
          actingAs = localStorage.getItem('ds_act_as_account') || '';
        } catch (_) {
          actingAs = '';
        }
        if (actingAs) selfScopedNotice.classList.remove('hidden');
        else selfScopedNotice.classList.add('hidden');
      }
      revealSelfScopedNoticeIfActingAs();

      refresh();
    })();
  </script>
</DashboardLayout>
