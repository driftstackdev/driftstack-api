---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-273 — Password-reset request page. Pairs with the V-079 backend
// route `POST /v1/auth/password-reset/request`.
//
// Flow:
//   1. User enters their email + submits.
//   2. Server returns `{sent: true, expires_at}`. The shape is stable
//      regardless of whether the email matches an account (the server
//      never confirms account existence via this endpoint — anti-
//      enumeration).
//   3. Page shows "Check your inbox" message + the email used + the
//      expires_at window.
//   4. User clicks the link in the email → /reset-password?token=…
//      page handles the actual reset.
//
// Dev convenience: when the server returns a `debug_token` (set when
// AUTH_EXPOSE_DEBUG_TOKEN=true), the page surfaces it for paste-into-
// /reset-password during local development.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<DashboardLayout title="Forgot password" withSidebar={false}>
  {/* 2026-05-24 — hero-glow atmosphere matches brand surface. */}
  <div class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex min-h-[calc(100vh-14rem)] w-full max-w-md flex-col justify-center px-6 py-16 animate-fade-up"
      data-page="forgot-password"
    >
    <p class="section-label">Password reset</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-tk-ink" style="letter-spacing: -0.02em;">
      Forgot password
    </h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      Enter the email associated with your Driftstack account and we'll send you a reset link.
    </p>

    <div class="auth-card mt-8">
      <div data-banner class="banner-warn mb-5 hidden" role="status"></div>

      <form data-form class="space-y-5">
        <div>
          <label class="form-label" for="forgot-email">Email</label>
          <input
            id="forgot-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>
        <button type="submit" class="btn-primary w-full">Send reset link</button>
      </form>

      <div
        data-success
        class="mt-6 hidden rounded-lg border border-tk-ready/30 bg-tk-ready/10 p-4 backdrop-blur-sm"
      >
        <h2 class="text-sm font-semibold text-tk-ready-text">Check your inbox</h2>
        <p class="mt-2 text-sm text-tk-ready-text">
          If <span data-success-email class="font-mono text-tk-accent-text"></span> matches a Driftstack
          account, a reset link is on the way. The link expires in <span
            data-success-window
            class="font-mono">60 minutes</span
          >.
        </p>
        <div
          data-debug-token
          class="mt-3 hidden rounded border border-tk-ready/30 bg-tk-bg/40 px-3 py-2 text-xs text-tk-ink-2"
        >
          <span class="font-mono uppercase tracking-wide text-tk-accent-text">Dev mode:</span>
          <a data-debug-link href="#" class="font-mono text-tk-accent-text underline">Open reset link</a>
        </div>
      </div>

      <p class="mt-6 text-xs text-tk-ink-3">
        Remembered it? <a
          href="/login"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">Sign in</a
        >.
      </p>
    </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="forgot-password"]');
      if (!root) return;
      const form = root.querySelector('[data-form]');
      const banner = root.querySelector('[data-banner]');
      const success = root.querySelector('[data-success]');
      const successEmail = root.querySelector('[data-success-email]');
      const successWindow = root.querySelector('[data-success-window]');
      const debugWrap = root.querySelector('[data-debug-token]');
      const debugLink = root.querySelector('[data-debug-link]');

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      // Prefill the email from ?email= (carried over from the signup
      // "already registered → reset password" link) so the customer
      // doesn't retype it.
      try {
        const prefill = new URLSearchParams(window.location.search).get('email');
        const emailInput = root.querySelector('#forgot-email');
        if (prefill && emailInput && !emailInput.value) emailInput.value = prefill;
      } catch (_) {
        /* swallow */
      }

      // Disable the submit button + show a pending label while the request
      // is in flight: prevents double-submit (duplicate reset emails) and
      // gives the user feedback that the click registered.
      const submitBtn = form.querySelector('button[type="submit"]');
      const submitLabel = submitBtn ? submitBtn.textContent : '';
      const RESET_LINK_REQUEST_TIMEOUT_MS = 15_000;
      let resetLinkRequestInFlight = false;
      function setSubmitting(on) {
        if (!submitBtn) return;
        submitBtn.disabled = on;
        submitBtn.setAttribute('aria-busy', on ? 'true' : 'false');
        submitBtn.textContent = on ? 'Sending…' : submitLabel;
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        if (resetLinkRequestInFlight) return;
        banner.classList.add('hidden');
        resetLinkRequestInFlight = true;
        setSubmitting(true);
        const email = (new FormData(form).get('email') || '').toString();
        const controller = new AbortController();
        const timeoutId = setTimeout(
          () => controller.abort(),
          RESET_LINK_REQUEST_TIMEOUT_MS,
        );
        fetch(apiBaseUrl + '/v1/auth/password-reset/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email }),
          signal: controller.signal,
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            successEmail.textContent = email;
            if (body.expires_at) {
              const minutes = Math.max(
                1,
                Math.round((new Date(body.expires_at).getTime() - Date.now()) / 60000),
              );
              successWindow.textContent = minutes + ' minutes';
            }
            if (body.debug_token) {
              debugLink.setAttribute(
                'href',
                '/reset-password?token=' + encodeURIComponent(body.debug_token),
              );
              debugWrap.classList.remove('hidden');
            }
            form.classList.add('hidden');
            success.classList.remove('hidden');
          })
          .catch((err) => {
            showBanner(
              controller.signal.aborted
                ? 'Sending the reset link took too long. Check your connection and try again.'
                : err && err.message
                  ? err.message
                  : 'Request failed.',
            );
          })
          .finally(() => {
            clearTimeout(timeoutId);
            resetLinkRequestInFlight = false;
            setSubmitting(false);
          });
      });
    })();
  </script>
</DashboardLayout>
