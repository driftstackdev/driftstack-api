---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// V-273 — Password-reset request page. Pairs with the V-079 backend
// route `POST /v1/auth/password-reset/request`.
//
// Flow:
//   1. User enters their email + submits.
//   2. Server returns `{sent: true, expires_at}`. The shape is stable
//      regardless of whether the email matches an account (the server
//      never confirms account existence via this endpoint — anti-
//      enumeration).
//   3. Page shows "Check your inbox" message + the email used + the
//      expires_at window.
//   4. User clicks the link in the email → /reset-password?token=…
//      page handles the actual reset.
//
// Dev convenience: when the server returns a `debug_token` (set when
// AUTH_EXPOSE_DEBUG_TOKEN=true), the page surfaces it for paste-into-
// /reset-password during local development.

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<DashboardLayout title="Forgot password" withSidebar={false}>
  <div class="mx-auto max-w-md px-6 py-16" data-page="forgot-password">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Forgot password</h1>
    <p class="mt-3 text-sm text-slate-600">
      Enter the email associated with your Driftstack account and we'll send you a reset link.
    </p>

    <div
      data-banner
      class="mt-6 hidden rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
      role="status"
    >
    </div>

    <form data-form class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700" for="forgot-email">Email</label>
        <input
          id="forgot-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <button type="submit" class="btn-primary w-full">Send reset link</button>
    </form>

    <div data-success class="mt-8 hidden rounded-lg border border-emerald-200 bg-emerald-50 p-4">
      <h2 class="text-sm font-semibold text-emerald-900">Check your inbox</h2>
      <p class="mt-2 text-sm text-emerald-900">
        If <span data-success-email class="mono"></span> matches a Driftstack account, a reset link
        is on the way. The link expires in <span data-success-window class="mono">15 minutes</span
        >.
      </p>
      <div data-debug-token class="mt-3 hidden rounded border border-emerald-300 bg-white px-3 py-2 text-xs text-slate-700">
        <span class="font-mono uppercase tracking-wide text-amber-700">Dev mode:</span>
        <a data-debug-link href="#" class="font-mono text-oxblood-700 underline">Open reset link</a>
      </div>
    </div>

    <p class="mt-6 text-xs text-slate-500">
      Remembered it? <a href="/login" class="text-oxblood-700 underline">Sign in</a>.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="forgot-password"]');
      if (!root) return;
      const form = root.querySelector('[data-form]');
      const banner = root.querySelector('[data-banner]');
      const success = root.querySelector('[data-success]');
      const successEmail = root.querySelector('[data-success-email]');
      const successWindow = root.querySelector('[data-success-window]');
      const debugWrap = root.querySelector('[data-debug-token]');
      const debugLink = root.querySelector('[data-debug-link]');

      function showBanner(text) {
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        banner.classList.add('hidden');
        const email = (new FormData(form).get('email') || '').toString();
        fetch(apiBaseUrl + '/v1/auth/password-reset/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email }),
        })
          .then((r) =>
            r.ok
              ? r.json()
              : r
                  .json()
                  .catch(() => ({}))
                  .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status))),
          )
          .then((body) => {
            successEmail.textContent = email;
            if (body.expires_at) {
              const minutes = Math.max(
                1,
                Math.round((new Date(body.expires_at).getTime() - Date.now()) / 60000),
              );
              successWindow.textContent = minutes + ' minutes';
            }
            if (body.debug_token) {
              debugLink.setAttribute(
                'href',
                '/reset-password?token=' + encodeURIComponent(body.debug_token),
              );
              debugWrap.classList.remove('hidden');
            }
            form.classList.add('hidden');
            success.classList.remove('hidden');
          })
          .catch((err) => {
            showBanner(err && err.message ? err.message : 'Request failed.');
          });
      });
    })();
  </script>
</DashboardLayout>
