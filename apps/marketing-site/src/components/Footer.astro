---
const year = new Date().getUTCFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 md:flex-row md:items-start md:justify-between"
  >
    <div>
      <div class="flex items-center gap-2 font-mono text-sm font-semibold text-slate-900">
        <span
          class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-oxblood-700 text-white text-xs"
        >
          D
        </span>
        <span>driftstack</span>
      </div>
      <p class="mt-3 max-w-prose text-sm text-slate-600">
        iPhone Safari sessions, on demand. Premium fidelity for the device that matters.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 text-sm md:grid-cols-4">
      <div>
        <h3 class="font-medium text-slate-900">Product</h3>
        <ul class="mt-3 space-y-2 text-slate-600">
          <li><a href="/pricing" class="nav-link">Pricing</a></li>
          <li><a href="/self-hosted" class="nav-link">Self-hosted</a></li>
          <li>
            <a
              href="https://docs.driftstack.dev"
              class="nav-link"
              target="_blank"
              rel="noopener noreferrer">Docs</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">Company</h3>
        <ul class="mt-3 space-y-2 text-slate-600">
          <li><a href="/about" class="nav-link">About</a></li>
          <li><a href="/faq" class="nav-link">FAQ</a></li>
          <li><a href="/changelog" class="nav-link">Changelog</a></li>
          <li>
            <a href="mailto:support@driftstack.dev" class="nav-link">support@driftstack.dev</a>
          </li>
          <li>
            <a href="mailto:sales@driftstack.dev" class="nav-link">sales@driftstack.dev</a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">Trust</h3>
        <ul class="mt-3 space-y-2 text-slate-600">
          <li><a href="/security" class="nav-link">Security</a></li>
          <li><a href="/trust/sub-processors" class="nav-link">Sub-processors</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">Legal</h3>
        <ul class="mt-3 space-y-2 text-slate-600">
          <li><a href="/legal/terms" class="nav-link">Terms</a></li>
          <li><a href="/legal/privacy" class="nav-link">Privacy</a></li>
          <li><a href="/legal/dpa" class="nav-link">DPA</a></li>
          <li><a href="/legal/aup" class="nav-link">Acceptable Use</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-slate-200">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-4 text-xs text-slate-500 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} Driftstack. All rights reserved.</p>
      <p>All prices in USD. VAT/BTW added per region per applicable EU rules.</p>
    </div>
  </div>
</footer>
