---
import StatusBadge from './StatusBadge.astro';

const year = new Date().getUTCFullYear();
---

<footer class="relative border-t border-tk-border bg-tk-bg">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 md:flex-row md:items-start md:justify-between"
  >
    <div>
      <div class="flex items-center gap-2.5 font-mono text-sm font-semibold text-tk-ink">
        <img
          src="/driftstack-mark.svg?v=4"
          alt="Driftstack"
          width="28"
          height="28"
          class="inline-block h-7 w-7"
        />
        <span class="font-sans font-black italic tracking-tight">DRIFT<span class="text-tk-accent-text">STACK</span></span>
      </div>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-2">
        Pixel-identical iPhone Safari sessions in the cloud. API, SDK, or GUI.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 text-sm md:grid-cols-2">
      <div>
        <h3 class="font-medium text-tk-ink text-xs uppercase tracking-widest">Product</h3>
        <ul class="mt-4 space-y-2.5 text-tk-ink-2">
          <li><a href="/pricing/" class="nav-link">Pricing</a></li>
          <li><a href="/comparison/" class="nav-link">Comparison</a></li>
          <li><a href="/self-hosted/" class="nav-link">Self-hosted</a></li>
          <li>
            <a
              href="https://docs.driftstack.io"
              class="nav-link"
              target="_blank"
              rel="noopener noreferrer">Docs</a
            >
          </li>
          <li>
            <a href="https://app.driftstack.io/signup/" class="nav-link">Sign up</a>
          </li>
          <li>
            <a href="https://app.driftstack.io/login/" class="nav-link">Sign in</a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-medium text-tk-ink text-xs uppercase tracking-widest">Company</h3>
        <ul class="mt-4 space-y-2.5 text-tk-ink-2">
          <li><a href="/about/" class="nav-link">About</a></li>
          <li><a href="/faq/" class="nav-link">FAQ</a></li>
          <li><a href="/changelog/" class="nav-link">Changelog</a></li>
          <li>
            <a href="mailto:support@driftstack.dev" class="nav-link">support@driftstack.dev</a>
          </li>
          <li>
            <a href="mailto:sales@driftstack.dev" class="nav-link">sales@driftstack.dev</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <!-- F-3 (Issue 7) — replaced the compliance badge strip
       (Stripe-billed / GDPR-aware / EU-resident / Article 28(2))
       with product-focused signals. Legal/trust details live on the
       /legal and /trust pages and in the meta-link row below; the
       splash position is for differentiators, not paperwork. -->
  <div class="border-t border-tk-border">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-3 px-6 py-5 text-xs text-tk-ink-3">
      <span class="inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-tk-accent"></span>
        Bit-identical iPhone Safari fingerprint
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-tk-accent"></span>
        SOCKS5 · WireGuard · OpenVPN proxies
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-tk-accent"></span>
        API · SDK · GUI access
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-tk-accent"></span>
        UDP / QUIC / WebRTC tunnelling
      </span>
    </div>
  </div>
  <!-- F-3 (Issue 7) — meta link row: legal + trust + status
       consolidated into one small bottom-most row, replacing the
       four separate footer columns that previously displayed them. -->
  <div class="border-t border-tk-border">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-4 gap-y-2 px-6 py-4 text-xs text-tk-ink-3">
      <a href="/legal/privacy/" class="nav-link">Privacy</a>
      <span aria-hidden="true">·</span>
      <a href="/legal/terms/" class="nav-link">Terms</a>
      <span aria-hidden="true">·</span>
      <a href="/legal/dpa/" class="nav-link">DPA</a>
      <span aria-hidden="true">·</span>
      <a href="/legal/aup/" class="nav-link">Acceptable Use</a>
      <span aria-hidden="true">·</span>
      <a href="/trust/" class="nav-link">Trust</a>
      <span aria-hidden="true">·</span>
      <a href="/security/" class="nav-link">Security</a>
      <span aria-hidden="true">·</span>
      <a href="/trust/sub-processors/" class="nav-link">Sub-processors</a>
      <span aria-hidden="true">·</span>
      <a
        href="https://status.driftstack.io"
        class="nav-link"
        target="_blank"
        rel="noopener noreferrer">Status</a
      >
    </div>
  </div>
  <div class="border-t border-tk-border">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-5 text-xs text-tk-ink-3 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} Driftstack. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-mono text-[11px] text-tk-ink-3">No trackers on this site.</span>
        <button
          type="button"
          data-theme-toggle
          class="flex h-7 w-7 items-center justify-center rounded-md border border-tk-border text-tk-ink-3 transition-colors hover:border-tk-ink-3/40 hover:text-tk-ink"
          aria-label="Switch to light theme"
          aria-pressed="false"
          title="Switch to light theme"
        >
          <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <StatusBadge />
      </div>
    </div>
  </div>
</footer>
