---
// Code window — .code-preview chrome (three pips + mono title) around a
// <pre> in the default slot, with an optional copy button wired via the
// shared [data-copy-target] listener below. The script body is PLAIN
// code on purpose: wrapping an is:inline script in an Astro expression
// container with a template literal ships a literal no-op string.
interface Props {
  /** Chrome title, e.g. 'quickstart.ts'. */
  title?: string;
  /** id of the element whose textContent the Copy button copies. */
  copyTargetId?: string;
}
const { title, copyTargetId } = Astro.props;
---

<figure class="code-preview overflow-hidden">
  <div class="code-window-chrome">
    <span class="pip"></span><span class="pip"></span><span class="pip"></span>
    {title ? <span class="ml-2 text-[11px] text-white/60">{title}</span> : null}
    {
      copyTargetId ? (
        <button
          type="button"
          class="ml-auto rounded border border-white/15 px-2 py-0.5 text-[11px] text-white/70 transition-colors hover:text-white"
          data-copy-target={copyTargetId}
          aria-label="Copy code to clipboard"
          aria-live="polite"
          aria-atomic="true"
        >
          Copy
        </button>
      ) : null
    }
  </div>
  <div class="overflow-x-auto p-4">
    <slot />
  </div>
</figure>

<script is:inline>
  // Shared copy-button wiring — one document-level listener, guarded so
  // multiple CodeWindow instances on a page don't double-bind.
  if (!window.__dsCopyWired) {
    window.__dsCopyWired = true;
    var copyStates = new WeakMap();

    function stateFor(btn) {
      var state = copyStates.get(btn);
      if (!state) {
        state = { inFlight: false, generation: 0, resetTimer: null };
        copyStates.set(btn, state);
      }
      return state;
    }

    function resetCopyButton(btn, state) {
      if (state.resetTimer !== null) window.clearTimeout(state.resetTimer);
      state.resetTimer = null;
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
    }

    function showCopyResult(btn, state, generation, label, ariaLabel, delayMs) {
      if (generation !== state.generation) return;
      resetCopyButton(btn, state);
      btn.textContent = label;
      btn.setAttribute('aria-label', ariaLabel);
      state.resetTimer = window.setTimeout(function () {
        if (generation === state.generation) resetCopyButton(btn, state);
      }, delayMs);
    }

    function writeClipboard(value) {
      try {
        if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
          return Promise.reject(new Error('clipboard unavailable'));
        }
        return Promise.resolve(navigator.clipboard.writeText(value));
      } catch (error) {
        return Promise.reject(error);
      }
    }

    document.addEventListener('click', function (e) {
      var btn = e.target instanceof Element ? e.target.closest('[data-copy-target]') : null;
      if (!(btn instanceof HTMLButtonElement)) return;
      var state = stateFor(btn);
      if (state.inFlight) return;
      var target = document.getElementById(btn.getAttribute('data-copy-target') || '');
      var generation = ++state.generation;
      state.inFlight = true;
      resetCopyButton(btn, state);
      btn.textContent = 'Copying…';
      btn.setAttribute('aria-label', 'Copying code');
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      var write = target
        ? writeClipboard(target.textContent || '')
        : Promise.reject(new Error('copy target unavailable'));
      write.then(
        function () {
          showCopyResult(btn, state, generation, 'Copied', 'Code copied to clipboard', 1200);
        },
        function () {
          showCopyResult(
            btn,
            state,
            generation,
            'Copy failed',
            'Could not copy code; select it manually',
            1800,
          );
        },
      ).finally(function () {
        if (generation === state.generation) {
          state.inFlight = false;
          btn.disabled = false;
          btn.setAttribute('aria-busy', 'false');
        }
      });
    });
  }
</script>
