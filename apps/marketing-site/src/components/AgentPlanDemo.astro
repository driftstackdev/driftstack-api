---
/**
 * The agent's plan, executing.
 *
 * Every intent shown here is a real member of the closed verb union in
 * `packages/api-types/src/agent-intents.ts`, with its real field names. The
 * schema's own doc comment is the reason this demo is built from source rather
 * than invented: "The agent cannot invent new verbs." A marketing animation that
 * showed a verb the product does not have would be the one kind of dishonesty
 * this page cannot afford, given what it is claiming.
 *
 * TWO MEMBERS ARE DELIBERATELY ABSENT. `interact:swipe` and `capture:pdf` are
 * declared in the union and always return `{ok:false}` — a declared verb that
 * always fails is worse than an absent one, and it is certainly not a thing to
 * animate. See D-7.
 *
 * `behavioral_pause` carries the whole argument. Every automation product can
 * tap and type; a first-class PAUSE, scaled to a persona's reading speed, is
 * what a real browser engine driving a real device buys you. So the animation
 * genuinely waits there — the dwell is the demo, not a gap in it.
 */

interface Step {
  /** The wire intent, exactly as it appears in the `intents` array. */
  intent: string;
  /** What the device is doing while it runs. */
  caption: string;
}

const STEPS: Step[] = [
  { intent: '{ "kind": "navigate", "url": "https://shop.example/cart" }', caption: 'Opening' },
  { intent: '{ "kind": "wait", "condition": "idle" }', caption: 'Settling' },
  {
    intent: '{ "kind": "behavioral_pause", "reading_word_count": 38 }',
    caption: 'Reading — 38 words, at this persona’s pace',
  },
  {
    intent: '{ "kind": "interact", "action": "tap", "selector": "#promo" }',
    caption: 'Tapping',
  },
  {
    intent: '{ "kind": "interact", "action": "type", "value": "SPRING", "sensitive": false }',
    caption: 'Typing',
  },
  { intent: '{ "kind": "scroll", "direction": "down", "amount_px": 600 }', caption: 'Scrolling' },
  { intent: '{ "kind": "capture", "capture": "screenshot" }', caption: 'Captured' },
];

/** One full pass, in seconds. */
const CYCLE = 16;
/**
 * Each step's share of the cycle. `behavioral_pause` gets nearly triple, because
 * the point of that intent is the dwell — giving it an equal slice would animate
 * away the one behaviour worth showing.
 */
const WEIGHTS = [1, 0.8, 2.6, 1, 1.4, 1.2, 1];
const TOTAL = WEIGHTS.reduce((a, b) => a + b, 0);

/** Cumulative start percentage of each step within the cycle. */
const starts: number[] = [];
let acc = 0;
for (const w of WEIGHTS) {
  starts.push((acc / TOTAL) * 100);
  acc += w;
}

/** Per-step keyframes: appear at its own moment, hold to the end, reset. */
const keyframes = STEPS.map((_, i) => {
  const at = starts[i] ?? 0;
  const lit = Math.min(at + 2.5, 99);
  return `@keyframes ds-step-${String(i)} {
  0%, ${at.toFixed(2)}% { opacity: .18; transform: translateY(3px); }
  ${lit.toFixed(2)}%, 98% { opacity: 1; transform: none; }
  100% { opacity: .18; transform: translateY(3px); }
}`;
}).join('\n');

/** The device pane follows the same clock, so caption and screen never disagree. */
const screenFrames = `@keyframes ds-screen {
  0%, ${(starts[1] ?? 0).toFixed(2)}% { opacity: 0; }
  ${((starts[1] ?? 0) + 3).toFixed(2)}%, 100% { opacity: 1; }
}
@keyframes ds-scrolled {
  0%, ${(starts[5] ?? 0).toFixed(2)}% { transform: none; }
  ${((starts[5] ?? 0) + 4).toFixed(2)}%, 100% { transform: translateY(-34px); }
}
@keyframes ds-tap {
  0%, ${(starts[3] ?? 0).toFixed(2)}% { opacity: 0; transform: scale(.4); }
  ${((starts[3] ?? 0) + 1.5).toFixed(2)}% { opacity: .55; transform: scale(1); }
  ${((starts[3] ?? 0) + 4).toFixed(2)}%, 100% { opacity: 0; transform: scale(1.5); }
}
@keyframes ds-caret {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}`;
---

<figure class="not-prose my-10">
  <div
    class="grid gap-5 rounded-card border border-tk-border bg-tk-surface p-5 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] md:gap-7 md:p-7"
  >
    <!-- device -->
    <div class="mx-auto w-full max-w-[15rem]">
      <div
        class="ds-device relative overflow-hidden rounded-[1.6rem] border border-tk-border bg-tk-bg p-2 shadow-sm"
      >
        <div class="mx-auto mb-2 h-1 w-10 rounded-full bg-tk-border" aria-hidden="true"></div>
        <div class="relative h-[16.5rem] overflow-hidden rounded-[1.1rem] bg-tk-raised">
          <div class="flex items-center gap-1.5 border-b border-tk-border px-2.5 py-2">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-tk-ready"></span>
            <span class="truncate font-mono text-[9px] text-tk-ink-3">shop.example/cart</span>
          </div>
          <div class="ds-screen space-y-2 p-2.5">
            <div class="ds-scrollable space-y-2">
              <div class="h-14 rounded-md bg-tk-hover"></div>
              <div class="h-2 w-4/5 rounded bg-tk-hover"></div>
              <div class="h-2 w-3/5 rounded bg-tk-hover"></div>
              <div class="relative">
                <div
                  class="flex h-7 items-center rounded-md border border-tk-accent/40 px-2 font-mono text-[10px] text-tk-ink-2"
                >
                  <span class="ds-typed"></span><span
                    class="ds-caret ml-px inline-block h-3 w-px bg-tk-accent"></span>
                </div>
                <span class="ds-tap absolute left-4 top-1.5 h-4 w-4 rounded-full bg-tk-accent"
                ></span>
              </div>
              <div class="h-2 w-2/3 rounded bg-tk-hover"></div>
              <div class="h-9 rounded-md bg-tk-hover"></div>
              <div class="h-2 w-1/2 rounded bg-tk-hover"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- plan -->
    <div class="min-w-0">
      <p class="mb-3 text-[11px] uppercase tracking-wider text-tk-ink-3">
        Intents on the wire &middot; <span class="text-tk-ink-2">plan-executed</span>
      </p>
      <ol class="ds-plan space-y-1.5">
        {
          STEPS.map((step, i) => (
            <li class={`ds-step ds-step-${String(i)} flex items-start gap-2.5`}>
              <span
                class="mt-[3px] h-1.5 w-1.5 shrink-0 rounded-full bg-tk-accent"
                aria-hidden="true"
              />
              <span class="min-w-0 flex-1">
                <code class="block overflow-x-auto whitespace-pre font-mono text-[11px] leading-relaxed text-tk-ink-2">
                  {step.intent}
                </code>
                <span class="mt-0.5 block text-[11px] text-tk-ink-3">{step.caption}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  <figcaption class="mt-3 text-center text-[12px] text-tk-ink-3">
    Every verb above is a member of the API&rsquo;s closed intent union &mdash; the agent cannot
    invent new ones.
  </figcaption>
</figure>

<style is:inline set:html={`
${keyframes}
${screenFrames}
.ds-step { opacity: .18; }
${STEPS.map((_, i) => `.ds-step-${i} { animation: ds-step-${i} ${CYCLE}s linear infinite; }`).join('\n')}
.ds-screen { opacity: 0; animation: ds-screen ${CYCLE}s linear infinite; }
.ds-scrollable { animation: ds-scrolled ${CYCLE}s ease-in-out infinite; }
.ds-tap { opacity: 0; animation: ds-tap ${CYCLE}s ease-out infinite; }
.ds-caret { animation: ds-caret 1.1s steps(1) infinite; }
.ds-typed::after { content: ""; }

/* The site's global reduced-motion reset collapses every duration to 0.01ms,
   which lands each element on its FINAL keyframe. That is the right resting
   state here — the whole plan legible at once, the device showing the end of the
   run — but only because the animations were written to end there. Anything
   whose final frame is blank would vanish for these readers. */
@media (prefers-reduced-motion: reduce) {
  .ds-step { opacity: 1; transform: none; }
  .ds-screen { opacity: 1; }
  .ds-tap { opacity: 0; }
}
`} />
