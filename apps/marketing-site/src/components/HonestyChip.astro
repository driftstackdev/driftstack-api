---
// Honesty chip — the load-bearing feature-state labels (honest-claims
// guardrail: unshipped features MUST carry their chip). Exactly three
// states; labels are verbatim contract strings pinned by the parity
// suite — never reword them here without re-pinning.
type ChipState = 'live' | 'rolling-out' | 'roadmap';
interface Props {
  state: ChipState;
}
const { state } = Astro.props;
const LABELS: Record<ChipState, string> = {
  live: 'Live',
  'rolling-out': 'Rolling out',
  roadmap: 'Roadmap',
};
const TONES: Record<ChipState, string> = {
  // 2026-09-25 — the site's one badge recipe (base.css .badge + a tone): the
  // status hue as a /10 wash and /30 border, with the AA-safe status-text
  // tone for the label (S24: raw ready/busy are fill tones). Roadmap is the
  // neutral inset chip in secondary ink — the old raised fill with muted ink
  // measured 4.04:1 on the slate dark theme's elevated surface.
  live: 'badge--ready',
  'rolling-out': 'badge--busy',
  roadmap: 'badge--neutral',
};
---

<span
  class:list={[
    'badge font-mono text-[11px]',
    TONES[state],
  ]}
>
  {LABELS[state]}
</span>
