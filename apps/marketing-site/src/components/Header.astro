---
// V-133: mobile responsiveness pass.
// On mobile (<md), the 4-item nav + CTA + logo overflowed in a single
// row. Now: logo + CTA stay visible at all widths; nav links hide on
// mobile and reveal via CSS-only <details> hamburger so we don't need
// a client-side JS bundle for a pure-static marketing site.

const navItems = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/comparison', label: 'Compare' },
  { href: '/self-hosted', label: 'Self-hosted' },
  { href: '/faq', label: 'FAQ' },
  { href: 'https://docs.driftstack.dev', label: 'Docs', external: true },
];

// Mobile-menu list mirrors desktop + adds secondary pages that don't
// earn a top-level desktop slot. Empty at launch (F-3 / Issue 5 —
// /roadmap link removed; no aspirational pages in nav).
const mobileExtraItems: Array<{ href: string; label: string }> = [];
const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-30 border-b border-white/10 bg-surface-base/70 backdrop-blur-md supports-[backdrop-filter]:bg-surface-base/60"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href="/"
      class="group flex items-center gap-2.5 font-mono text-base font-semibold text-ink-primary"
    >
      <span
        class="relative inline-flex h-8 w-8 items-center justify-center transition-all duration-300 group-hover:scale-110"
      >
        <img
          src="/driftstack-mark.svg?v=2"
          alt="Driftstack"
          width="32"
          height="32"
          class="h-full w-full"
        />
        <span
          aria-hidden="true"
          class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          style="filter: drop-shadow(0 0 12px rgba(226, 56, 71, 0.5));"></span>
      </span>
      <span class="tracking-tight">driftstack</span>
    </a>

    <!-- Desktop nav (md+) -->
    <nav class="hidden items-center gap-6 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link',
              pathname === item.href && 'text-glow-red font-medium',
            ]}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <span aria-hidden="true" class="h-4 w-px bg-white/10"></span>
      <a href="https://app.driftstack.dev/login" class="nav-link">Sign in</a>
      <a href="/pricing#trial-pack" class="btn-primary">Get started</a>
    </nav>

    <!-- Mobile: CTA visible at all widths, nav collapsed into <details> -->
    <div class="flex items-center gap-3 md:hidden">
      <a href="/pricing#trial-pack" class="btn-primary text-sm">Start</a>
      <details class="relative">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-white/10 text-ink-secondary hover:border-white/20 hover:text-ink-primary [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 z-20 flex w-56 flex-col gap-1 rounded-md border border-white/10 bg-surface-raised p-3 shadow-glow-red"
        >
          {
            [...navItems, ...mobileExtraItems].map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded px-3 py-2 text-sm text-ink-secondary hover:bg-white/5 hover:text-ink-primary',
                  pathname === item.href && 'text-glow-red font-medium',
                ]}
                target={'external' in item && item.external ? '_blank' : undefined}
                rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="https://app.driftstack.dev/login"
            class="rounded px-3 py-2 text-sm text-ink-secondary hover:bg-white/5 hover:text-ink-primary"
          >
            Sign in
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
