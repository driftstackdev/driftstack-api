---
// V-133: mobile responsiveness pass.
// On mobile (<md), the 4-item nav + CTA + logo overflowed in a single
// row. Now: logo + CTA stay visible at all widths; nav links hide on
// mobile and reveal via CSS-only <details> hamburger so we don't need
// a client-side JS bundle for a pure-static marketing site.

// S14 nav rework (2026-07-03, D8): the funnel pages lead — How it
// works + Use cases take the first two slots; Self-hosted moves to
// the footer Product column (it kept a mobile slot below). Still no
// /roadmap in nav (F-3 / Issue 5 — no aspirational pages).
const navItems = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/use-cases', label: 'Use cases' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/comparison', label: 'Compare' },
  { href: '/faq', label: 'FAQ' },
  { href: 'https://docs.driftstack.dev', label: 'Docs', external: true },
];

// Mobile-menu list mirrors desktop + adds secondary pages that don't
// earn a top-level desktop slot: Self-hosted (left the desktop roster
// in the S14 rework; footer Product column carries it on desktop) and
// the Glossary reference page.
const mobileExtraItems: Array<{ href: string; label: string }> = [
  { href: '/self-hosted', label: 'Self-hosted' },
  { href: '/glossary', label: 'Glossary' },
];
const pathname = Astro.url.pathname;
const normalizedPathname = pathname === '/' ? '/' : pathname.replace(/\/+$/, '');
function isActiveItem(item: { href: string; external?: boolean }): boolean {
  if (item.external === true) return false;
  return normalizedPathname === item.href || normalizedPathname.startsWith(`${item.href}/`);
}
---

<header
  class="sticky top-0 z-30 border-b border-tk-border bg-tk-bg/70 backdrop-blur-md supports-[backdrop-filter]:bg-tk-bg/60"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href="/"
      class="group flex items-center gap-2.5 font-mono text-xl font-semibold text-tk-ink"
    >
      <span
        class="relative inline-flex h-8 w-8 items-center justify-center transition-all duration-300 group-hover:scale-110"
      >
        <img
          src="/driftstack-mark.svg?v=4"
          alt=""
          width="32"
          height="32"
          class="h-full w-full"
        />
        <span
          aria-hidden="true"
          class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          style="filter: drop-shadow(0 0 12px var(--glow));"></span>
      </span>
      <span class="font-sans font-black italic tracking-tight">DRIFT<span class="text-tk-accent-text">STACK</span></span>
    </a>

    <!-- Desktop nav (md+) -->
    <nav class="hidden items-center gap-6 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.external ? item.href : `${item.href}/`}
            aria-current={isActiveItem(item) ? 'page' : undefined}
            class:list={[
              // 2026-05-21 — font-medium on base class so width stays
              // constant across active/inactive; active state distinguished
              // by accent tone only. Same fix as the dashboard +
              // admin-panel sidebars (50b0dd7a / 3331f410). Otherwise
              // clicking nav items shifts neighbours horizontally as the
              // text bolds. S24: the active tone is TEXT → tk-accent-text
              // (raw accent is ~3.0:1 on the dark bg — a fill tone).
              'nav-link font-medium',
              isActiveItem(item) && 'text-tk-accent-text',
            ]}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <span aria-hidden="true" class="h-4 w-px bg-tk-hover"></span>
      <button
        type="button"
        data-theme-toggle
        class="flex h-9 w-9 items-center justify-center rounded-md border border-tk-border text-tk-ink-2 transition-colors hover:border-tk-ink-3/40 hover:text-tk-ink"
        aria-label="Switch to light theme"
        aria-pressed="false"
        title="Switch to light theme"
      >
        <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href="https://app.driftstack.dev/login/" class="nav-link">Sign in</a>
      <a href="/pricing/#free" class="btn-primary">Start free</a>
    </nav>

    <!-- Mobile: CTA visible at all widths, nav collapsed into <details> -->
    <div class="flex items-center gap-3 md:hidden">
      <a href="/pricing/#free" class="btn-primary text-sm">Start free</a>
      <details class="relative" data-mobile-nav>
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-tk-border text-tk-ink-2 hover:border-tk-ink-3/40 hover:text-tk-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 z-20 flex w-56 flex-col gap-1 rounded-md border border-tk-border bg-tk-surface p-3 shadow-glow-accent"
        >
          {
            [...navItems, ...mobileExtraItems].map((item) => (
              <a
                href={'external' in item && item.external ? item.href : `${item.href}/`}
                aria-current={isActiveItem(item) ? 'page' : undefined}
                class:list={[
                  // 2026-05-21 — same constant-font-weight pattern as the
                  // desktop nav (above) so the mobile popup doesn't reflow
                  // when the active item is tapped. S24: same AA-safe
                  // accent-text active tone as the desktop nav.
                  'rounded px-3 py-2 text-sm font-medium text-tk-ink-2 hover:bg-tk-hover hover:text-tk-ink',
                  isActiveItem(item) && 'text-tk-accent-text',
                ]}
                target={'external' in item && item.external ? '_blank' : undefined}
                rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="https://app.driftstack.dev/login/"
            class="rounded px-3 py-2 text-sm text-tk-ink-2 hover:bg-tk-hover hover:text-tk-ink"
          >
            Sign in
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
