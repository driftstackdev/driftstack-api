---
// V-133: mobile responsiveness pass.
// On mobile (<md), the 4-item nav + CTA + logo overflowed in a single
// row. Now: logo + CTA stay visible at all widths; nav links hide on
// mobile and reveal via CSS-only <details> hamburger so we don't need
// a client-side JS bundle for a pure-static marketing site.

const navItems = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/self-hosted', label: 'Self-hosted' },
  { href: '/faq', label: 'FAQ' },
  { href: 'https://docs.driftstack.dev', label: 'Docs', external: true },
];
const pathname = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex items-center gap-2 font-mono text-base font-semibold text-slate-900">
      <span
        class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-oxblood-700 text-white"
      >
        D
      </span>
      <span>driftstack</span>
    </a>

    <!-- Desktop nav (md+) -->
    <nav class="hidden items-center gap-6 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', pathname === item.href && 'text-oxblood-700 font-medium']}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="https://app.driftstack.dev/login" class="nav-link">Sign in</a>
      <a href="/pricing#trial-pack" class="btn-primary">Get started</a>
    </nav>

    <!-- Mobile: CTA visible at all widths, nav collapsed into <details> -->
    <div class="flex items-center gap-3 md:hidden">
      <a href="/pricing#trial-pack" class="btn-primary text-sm">Start</a>
      <details class="relative">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-slate-200 text-slate-700 [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 z-20 flex w-56 flex-col gap-1 rounded-md border border-slate-200 bg-white p-3 shadow-lg"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded px-3 py-2 text-sm text-slate-700 hover:bg-slate-100',
                  pathname === item.href && 'text-oxblood-700 font-medium',
                ]}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="https://app.driftstack.dev/login"
            class="rounded px-3 py-2 text-sm text-slate-700 hover:bg-slate-100"
          >
            Sign in
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
