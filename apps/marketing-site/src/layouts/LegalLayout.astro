---
// Wraps a legal markdown page in BaseLayout with prose styling
// matching the rest of the site (oxblood links, mono code, slate
// palette). The header surfaces version + effective-date pulled from
// the markdown frontmatter so customers can see at a glance which
// version of a document they're viewing.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? 'Legal';
const description =
  Astro.props.description ??
  frontmatter?.description ??
  'Driftstack legal documents.';

const legalLinks = [
  { href: '/legal/terms', label: 'Terms of Service' },
  { href: '/legal/privacy', label: 'Privacy Policy' },
  { href: '/legal/dpa', label: 'Data Processing Agreement' },
  { href: '/legal/aup', label: 'Acceptable Use Policy' },
  { href: '/trust/sub-processors', label: 'Sub-processors' },
];
---

<BaseLayout title={title} description={description}>
  {/* 2026-05-22 — hero-glow + gradient h1 matches the rest of the
      marketing site. Applies to every legal page (terms, privacy,
      aup, dpa, refunds, sub-processors, vulnerability-disclosure). */}
  <section class="relative overflow-hidden border-b border-white/10 bg-gradient-to-b from-surface-base to-surface-raised">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-12">
      <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Legal</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
        
          {title}
        
      </h1>
      {description ? <p class="mt-4 max-w-prose text-base text-ink-secondary">{description}</p> : null}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <article
      class="prose prose-invert max-w-none prose-headings:scroll-mt-20 prose-headings:font-semibold prose-headings:text-ink-primary prose-h1:hidden prose-h2:mt-12 prose-h2:text-2xl prose-h3:text-xl prose-p:leading-relaxed prose-p:text-ink-secondary prose-li:my-1 prose-li:text-ink-secondary prose-a:text-oxblood-300 prose-a:no-underline hover:prose-a:underline hover:prose-a:text-oxblood-200 prose-strong:text-ink-primary prose-code:rounded prose-code:bg-surface-inset prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:text-ink-primary prose-code:before:content-none prose-code:after:content-none prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-table:text-sm prose-td:text-ink-secondary prose-th:bg-surface-raised prose-th:text-ink-primary prose-th:text-left prose-blockquote:border-l-oxblood-300 prose-blockquote:not-italic prose-blockquote:text-ink-secondary"
    >
      <slot />
    </article>

    <nav
      class="mt-16 border-t border-white/10 pt-8"
      aria-label="Other legal documents"
    >
      <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">
        Other legal documents
      </p>
      <ul class="mt-3 grid gap-1 sm:grid-cols-2">
        {legalLinks.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-oxblood-700 hover:underline">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>
