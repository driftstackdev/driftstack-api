---
// Wraps a legal markdown page in BaseLayout with prose styling
// matching the rest of the site (oxblood links, mono code, slate
// palette). The header surfaces version + effective-date pulled from
// the markdown frontmatter so customers can see at a glance which
// version of a document they're viewing.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? 'Legal';
const description =
  Astro.props.description ??
  frontmatter?.description ??
  'Driftstack legal documents.';

const legalLinks = [
  { href: '/legal/terms', label: 'Terms of Service' },
  { href: '/legal/privacy', label: 'Privacy Policy' },
  { href: '/legal/dpa', label: 'Data Processing Agreement' },
  { href: '/legal/aup', label: 'Acceptable Use Policy' },
  { href: '/trust/sub-processors', label: 'Sub-processors' },
];
---

<BaseLayout title={title} description={description}>
  {/* 2026-05-22 — hero-glow + gradient h1 matches the rest of the
      marketing site. Applies to every legal page (terms, privacy,
      aup, dpa, refunds, sub-processors, vulnerability-disclosure). */}
  <section class="relative overflow-hidden border-b border-tk-border bg-gradient-to-b from-tk-bg to-tk-surface">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-12">
      {/* S24: eyebrow is TEXT → the AA-safe accent-text tone. */}
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Legal</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
        
          {title}
        
      </h1>
      {description ? <p class="mt-4 max-w-prose text-base text-tk-ink-2">{description}</p> : null}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <article
      class="prose max-w-none prose-headings:scroll-mt-20 prose-headings:font-semibold prose-headings:text-tk-ink prose-h2:mt-12 prose-h2:text-2xl prose-h3:text-xl prose-p:leading-relaxed prose-p:text-tk-ink-2 prose-li:my-1 prose-li:text-tk-ink-2 prose-a:text-tk-accent-text prose-a:no-underline hover:prose-a:underline hover:prose-a:text-tk-accent-2 prose-strong:text-tk-ink prose-code:rounded prose-code:bg-tk-bg prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:text-tk-ink prose-code:before:content-none prose-code:after:content-none prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-table:text-sm prose-td:text-tk-ink-2 prose-th:bg-tk-surface prose-th:text-tk-ink prose-th:text-left prose-blockquote:border-l-tk-accent prose-blockquote:not-italic prose-blockquote:text-tk-ink-2"
    >
      <slot />
    </article>

    <nav
      class="mt-16 border-t border-tk-border pt-8"
      aria-label="Other legal documents"
    >
      <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
        Other legal documents
      </p>
      <ul class="mt-3 grid gap-1 sm:grid-cols-2">
        {legalLinks.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-tk-accent-text hover:underline">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>
