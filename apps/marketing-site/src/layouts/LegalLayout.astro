---
// Wraps a legal markdown page in BaseLayout with prose styling
// matching the rest of the site (oxblood links, mono code, slate
// palette). The header surfaces version + effective-date pulled from
// the markdown frontmatter so customers can see at a glance which
// version of a document they're viewing.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? 'Legal';
const description =
  Astro.props.description ??
  frontmatter?.description ??
  'Driftstack legal documents.';

const legalLinks = [
  { href: '/legal/terms', label: 'Terms of Service' },
  { href: '/legal/privacy', label: 'Privacy Policy' },
  { href: '/legal/dpa', label: 'Data Processing Agreement' },
  { href: '/legal/aup', label: 'Acceptable Use Policy' },
  { href: '/trust/sub-processors', label: 'Sub-processors' },
];
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-slate-200 bg-gradient-to-b from-white to-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-12">
      <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Legal</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl">
        {title}
      </h1>
      {description ? <p class="mt-4 max-w-prose text-base text-slate-600">{description}</p> : null}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    <article
      class="prose prose-slate max-w-none prose-headings:scroll-mt-20 prose-headings:font-semibold prose-h1:hidden prose-h2:mt-12 prose-h2:text-2xl prose-h3:text-xl prose-p:leading-relaxed prose-a:text-oxblood-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-900 prose-code:rounded prose-code:bg-slate-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-li:my-1 prose-table:text-sm prose-th:bg-slate-50 prose-th:text-left prose-blockquote:border-l-oxblood-300 prose-blockquote:not-italic prose-blockquote:text-slate-700"
    >
      <slot />
    </article>

    <nav
      class="mt-16 border-t border-slate-200 pt-8"
      aria-label="Other legal documents"
    >
      <p class="font-mono text-xs uppercase tracking-widest text-slate-500">
        Other legal documents
      </p>
      <ul class="mt-3 grid gap-1 sm:grid-cols-2">
        {legalLinks.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-oxblood-700 hover:underline">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>
