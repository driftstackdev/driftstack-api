---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pathname?: string;
  /**
   * Optional per-page social-card image (absolute URL or `/`-rooted
   * path). Defaults to the site-wide `/og-default.png` when not
   * supplied. Pages that want a custom card pass it explicitly.
   */
  ogImage?: string;
  /**
   * V-255 — set true on draft / pre-counsel-review pages so search
   * engines don't index them as binding. Defaults to indexable.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'iPhone Safari sessions, on demand. Premium fidelity for the device that matters.',
  pathname = Astro.url.pathname,
  ogImage,
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Driftstack' ? title : `${title} · Driftstack`;
const canonical = new URL(pathname, Astro.site).toString();
// Resolve OG image to an absolute URL so social crawlers can fetch it
// without the path-resolution headaches some platforms have with
// relative paths. Defaults to /og-default.png at the site root —
// Cloudflare Pages serves anything in apps/marketing-site/public/
// at the root when build runs. PNG, NOT SVG: Twitter/X, Facebook,
// LinkedIn, Slack, and Discord don't render SVG og:images, so a raster
// card is required for link previews to show an image at all. The PNG
// is generated from og-default.svg via scripts/gen-og-image.mjs (the
// SVG stays the editable design source-of-truth).
const ogImageUrl = new URL(ogImage ?? '/og-default.png', Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f14" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- OpenGraph (LinkedIn, Slack, iMessage, generic OG-aware crawlers) -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Driftstack" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=2" />
  </head>
  <body class="relative">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR users skip the nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-glow-red focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to main content
    </a>
    <!-- Ambient background layer: radial glow + faint grid pattern. -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute inset-0 grid-bg opacity-60"></div>
      <div class="absolute inset-x-0 top-0 h-[600px] bg-glow-radial-red"></div>
      <div class="absolute inset-x-0 bottom-0 h-[400px] bg-glow-radial-red-soft"></div>
    </div>

    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
