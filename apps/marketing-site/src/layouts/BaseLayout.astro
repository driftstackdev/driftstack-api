---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pathname?: string;
  /**
   * Optional per-page social-card image (absolute URL or `/`-rooted
   * path). Defaults to the site-wide `/og-light.png` when not
   * supplied. Pages that want a custom card pass it explicitly.
   */
  ogImage?: string;
  /**
   * V-255 — set true on draft / pre-counsel-review pages so search
   * engines don't index them as binding. Defaults to indexable.
   */
  noindex?: boolean;
}

const {
  title,
  description = "Real iPhone Safari in the cloud — to every website, they're just people on phones. Drive them by hand, by code, or by AI. Start free.",
  pathname = Astro.url.pathname,
  ogImage,
  noindex = false,
} = Astro.props;

// Page authors sometimes supply a deliberately branded title (for example
// "Admin API — Driftstack" or "Error codes — Driftstack developer docs").
// Appending the brand unconditionally turned those into visibly duplicated
// browser/search titles. Preserve any already-branded title verbatim.
const fullTitle = title.includes('Driftstack') ? title : `${title} · Driftstack`;
const canonical = new URL(pathname, Astro.site).toString();
// Resolve OG image to an absolute URL so social crawlers can fetch it
// without the path-resolution headaches some platforms have with
// relative paths. Defaults to /og-light.png at the site root —
// Cloudflare Pages serves anything in apps/marketing-site/public/
// at the root when build runs. PNG, NOT SVG: Twitter/X, Facebook,
// LinkedIn, Slack, and Discord don't render SVG og:images, so a raster
// card is required for link previews to show an image at all. The PNG
// is generated from og-light.svg via scripts/gen-og-image.mjs (the
// SVG stays the editable design source-of-truth).
// 2026-09-25 — the light card ships under a NEW file name instead of a ?v=
// bump of the dark /og-default.png: public/_headers serves /*.png immutable
// for a year, and a new name is the one cache key every crawler and CDN
// honours. The dark og-default.png stays on disk (docs.driftstack.io and
// already-cached previews still point at it). Per-page ogImage overrides
// (/og/<slug>-light.png) follow the same rule.
const ogImageUrl = new URL(ogImage ?? '/og-light.png', Astro.site).toString();

// W464 — JSON-LD structured data (schema.org) for rich-result eligibility +
// knowledge-graph understanding. Site-wide Organization + WebSite + the
// SoftwareApplication (the product) with the free-tier Offer. @graph with @id
// cross-refs is the canonical way to ship multiple linked entities in one
// block. Strictly factual — no fabricated ratings or reviews (we have none;
// inventing them is dishonest + a Google structured-data penalty risk).
const siteOrigin = new URL('/', Astro.site).toString().replace(/\/$/, '');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: 'Driftstack',
      url: siteOrigin,
      logo: new URL('/driftstack-mark.svg', Astro.site).toString(),
      description:
        'Real iPhone Safari browsers in the cloud that every website treats as a genuine iPhone — for scraping, testing, and automation.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteOrigin,
      name: 'Driftstack',
      publisher: { '@id': `${siteOrigin}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Driftstack',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Web, macOS, Windows',
      url: siteOrigin,
      description:
        'Automate a real iPhone Safari browser in the cloud from TypeScript, Python, Go, or a desktop app — every website sees a genuine iPhone, never a bot.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        description: 'Free tier — one profile, 20-minute sessions, no card required.',
      },
    },
  ],
};
---

<!-- Token axes: data-mode/data-accent drive the tk-* token classes +
     token-aware components (styles/base.css, @driftstack/design-tokens).
     light+oxblood = the default since 2026-09-25 (owner: the desktop app's
     white theme everywhere) — it retires the 2026-06-15 dark first
     impression; the toggle keeps dark one click away, and nothing follows the
     system theme. dark: variants key off [data-mode="dark"] (tailwind
     darkMode selector).
     NOTE: nothing may sit between doctype and <html> — a JSX comment there
     makes the Astro compiler DROP the <html> element (and the axes). -->
<!doctype html>
<html lang="en" data-mode="light" data-accent="oxblood">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The status-bar tint is the page ground of the mode being shown:
         #ebedf2 (surface-base, light — the default) or #0f172a (surface-base,
         dark). It must follow the mode, or iOS Safari paints a strip of the
         other theme above the page (founder 2026-06-22, seen in the simulator
         on driftstack.io while the tint was pinned to the other mode). -->
    <meta name="theme-color" content="#ebedf2" />
    <script is:inline>
      {
        /*
         * Fleet v2 (2026-07-03) — theme persistence, pre-paint. Applies the
         * visitor's saved MODE before first paint so there is no flash of
         * the default theme. Marketing exposes the mode axis only (light ↔
         * dark; oxblood is the brand's face) and the value is WHITELISTED —
         * never write raw localStorage into a DOM attribute. Default (light
         * + oxblood since 2026-09-25) lives on the <html> attrs; the
         * [data-theme-toggle] buttons (wired at body end) write
         * ds_theme_mode. Deliberately does NOT honor prefers-color-scheme —
         * the mode is the visitor's explicit choice, as in the desktop app.
         *
         * NOTE: plain code in a brace-comment block — never a template
         * literal inside an expression container: Astro emits that wrapper
         * literally, turning the whole script into a no-op string
         * expression (the 2026-07-02 dead-inline-script bug class).
         */
      }
      (function () {
        try {
          var m = localStorage.getItem('ds_theme_mode');
          if (m === 'light' || m === 'dark') {
            document.documentElement.setAttribute('data-mode', m);
            if (m === 'dark') {
              var mt = document.querySelector('meta[name="theme-color"]');
              if (mt) mt.setAttribute('content', '#0f172a');
            }
          }
        } catch (_) {
          /* default theme */
        }
      })();
    </script>
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      !noindex && (
        <>
          {/* OpenGraph (LinkedIn, Slack, iMessage, generic OG-aware crawlers) */}
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Driftstack" />
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {/* Twitter / X */}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={fullTitle} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImageUrl} />
          {/* W464 — schema.org structured data (Organization + WebSite + SoftwareApplication). */}
          <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=5" />
    {/* Self-hosted fonts (Fleet v2 port 2026-07-03) — preload the two
        above-the-fold faces so first paint doesn't flash the system
        stack longer than needed (font-display: swap in base.css). */}
    <link rel="preload" href="/fonts/geist/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* iOS home-screen icon — apple-touch-icon MUST be raster (PNG); an
        SVG favicon alone leaves driftstack.io with a blank/generic icon
        when added to an iPhone home screen. Generated from the brand mark
        via scripts/gen-apple-touch-icon.mjs. /*.png is immutable at the
        edge for a year, so new art ships under a new name (-2 is the
        oxblood mark; the old name held the violet one). */}
    <link rel="apple-touch-icon" href="/apple-touch-icon-2.png" />
  </head>
  <body class="relative">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR users skip the nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-tk-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-tk-accent-ink"
    >
      Skip to main content
    </a>
    <!-- Ambient background layer: radial glow + faint grid pattern, over the
         top of the page (2026-09-25: at lower alpha, and anchored to the page
         rather than fixed to the window, so it frames the first screen and
         then gives the reading room back; body's own wash in base.css adds
         the faint pool under the footer). -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[900px]">
      <div class="absolute inset-0 grid-bg opacity-40"></div>
      <div class="absolute inset-x-0 top-0 h-[600px] bg-glow-radial-accent"></div>
    </div>

    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      {
        /*
         * Fleet v2 (2026-07-03) — mode-toggle wiring. One delegated
         * listener covers every [data-theme-toggle] button (header +
         * footer); flips data-mode, keeps the theme-color meta in sync
         * (iOS Safari status bar), persists to ds_theme_mode. Plain code
         * (see the pre-paint script note above re the template-literal
         * dead-script trap).
         */
      }
      (function () {
        function syncThemeControls(mode) {
          var light = mode === 'light';
          var actionLabel = light ? 'Switch to dark theme' : 'Switch to light theme';
          document.querySelectorAll('[data-theme-toggle]').forEach(function (control) {
            control.setAttribute('aria-pressed', light ? 'true' : 'false');
            control.setAttribute('aria-label', actionLabel);
            control.setAttribute('title', actionLabel);
          });
        }

        syncThemeControls(document.documentElement.getAttribute('data-mode'));
        document.addEventListener('click', function (e) {
          var btn = e.target instanceof Element ? e.target.closest('[data-theme-toggle]') : null;
          if (!btn) return;
          var next =
            document.documentElement.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-mode', next);
          syncThemeControls(next);
          var mt = document.querySelector('meta[name="theme-color"]');
          if (mt) mt.setAttribute('content', next === 'light' ? '#ebedf2' : '#0f172a');
          try {
            localStorage.setItem('ds_theme_mode', next);
          } catch (_) {
            /* persistence unavailable — the toggle still works this visit */
          }
        });
      })();
    </script>
    <script is:inline>
      {
        /*
         * The native <details> keeps the mobile menu operable without a
         * framework bundle. This small progressive enhancement makes its
         * current state explicit to assistive technology and dismisses the
         * overlay with the two expected escape routes: Escape and an outside
         * click. Keyboard dismissal restores focus to the summary trigger.
         */
      }
      (function () {
        var menu = document.querySelector('[data-mobile-nav]');
        if (!(menu instanceof HTMLDetailsElement)) return;
        var trigger = menu.querySelector('summary');
        if (!(trigger instanceof HTMLElement)) return;

        function syncMobileMenu() {
          var expanded = menu.open;
          trigger.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          trigger.setAttribute(
            'aria-label',
            expanded ? 'Close navigation menu' : 'Open navigation menu',
          );
        }

        menu.addEventListener('toggle', syncMobileMenu);
        document.addEventListener('click', function (event) {
          if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
            menu.open = false;
          }
        });
        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape' || !menu.open) return;
          event.preventDefault();
          menu.open = false;
          trigger.focus();
        });
        syncMobileMenu();
      })();
    </script>
    <script is:inline>
      {
        /*
         * WCAG 2.1.1 — a code block that overflows horizontally must be
         * reachable without a pointing device. Only add a tab stop while the
         * <pre> is genuinely scrollable at the current responsive width; the
         * marker makes the enhancement reversible and preserves any tabindex
         * a page author supplied deliberately. 2026-09-25: a long-form prose
         * table scrolls the same way on a phone (base.css .prose-tk table),
         * so it gets the same treatment.
         */
      }
      (function () {
        var blocks = Array.prototype.slice.call(document.querySelectorAll('pre, .prose-tk table'));
        if (blocks.length === 0) return;

        function sync(block) {
          var overflows = block.scrollWidth > block.clientWidth + 1;
          if (overflows && !block.hasAttribute('tabindex')) {
            block.setAttribute('tabindex', '0');
            block.setAttribute('data-scroll-focus', 'true');
          } else if (!overflows && block.getAttribute('data-scroll-focus') === 'true') {
            block.removeAttribute('tabindex');
            block.removeAttribute('data-scroll-focus');
          }
        }

        blocks.forEach(sync);
        window.addEventListener('load', function () {
          blocks.forEach(sync);
        });
        if ('ResizeObserver' in window) {
          var observer = new ResizeObserver(function (entries) {
            entries.forEach(function (entry) {
              sync(entry.target);
            });
          });
          blocks.forEach(function (block) {
            observer.observe(block);
          });
        }
      })();
    </script>
  </body>
</html>
