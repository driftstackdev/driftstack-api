---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pathname?: string;
  /**
   * Optional per-page social-card image (absolute URL or `/`-rooted
   * path). Defaults to the site-wide `/og-default.png` when not
   * supplied. Pages that want a custom card pass it explicitly.
   */
  ogImage?: string;
  /**
   * V-255 — set true on draft / pre-counsel-review pages so search
   * engines don't index them as binding. Defaults to indexable.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'iPhone Safari sessions, on demand. Premium fidelity for the device that matters.',
  pathname = Astro.url.pathname,
  ogImage,
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Driftstack' ? title : `${title} · Driftstack`;
const canonical = new URL(pathname, Astro.site).toString();
// Resolve OG image to an absolute URL so social crawlers can fetch it
// without the path-resolution headaches some platforms have with
// relative paths. Defaults to /og-default.png at the site root —
// Cloudflare Pages serves anything in apps/marketing-site/public/
// at the root when build runs. PNG, NOT SVG: Twitter/X, Facebook,
// LinkedIn, Slack, and Discord don't render SVG og:images, so a raster
// card is required for link previews to show an image at all. The PNG
// is generated from og-default.svg via scripts/gen-og-image.mjs (the
// SVG stays the editable design source-of-truth).
const ogImageUrl = new URL(ogImage ?? '/og-default.png', Astro.site).toString();

// W464 — JSON-LD structured data (schema.org) for rich-result eligibility +
// knowledge-graph understanding. Site-wide Organization + WebSite + the
// SoftwareApplication (the product) with the free-tier Offer. @graph with @id
// cross-refs is the canonical way to ship multiple linked entities in one
// block. Strictly factual — no fabricated ratings or reviews (we have none;
// inventing them is dishonest + a Google structured-data penalty risk).
const siteOrigin = new URL('/', Astro.site).toString().replace(/\/$/, '');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: 'Driftstack',
      url: siteOrigin,
      logo: new URL('/driftstack-mark.svg', Astro.site).toString(),
      description:
        'Real iPhone Safari browsers in the cloud that every website treats as a genuine iPhone — for scraping, testing, and automation.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteOrigin,
      name: 'Driftstack',
      publisher: { '@id': `${siteOrigin}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Driftstack',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Web, macOS, Windows',
      url: siteOrigin,
      description:
        'Automate a real iPhone Safari browser in the cloud from TypeScript, Python, Go, or a desktop app — every website sees a genuine iPhone, never a bot.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        description: 'Free tier — one profile, 20-minute sessions, no card required.',
      },
    },
  ],
};
---

<!-- Fleet token axes (2026-06-12 rework): data-mode/data-accent drive the
     tk-* token classes + token-aware components (styles/base.css).
     dark+oxblood = the founder-locked default (2026-06-15: "Fleet Mission
     Control" brand — Dark + Red, matching the GUI standard). dark: variants
     key off [data-mode="dark"] (tailwind darkMode selector).
     NOTE: nothing may sit between doctype and <html> — a JSX comment there
     makes the Astro compiler DROP the <html> element (and the axes). -->
<!doctype html>
<html lang="en" data-mode="dark" data-accent="oxblood">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f3f6" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- OpenGraph (LinkedIn, Slack, iMessage, generic OG-aware crawlers) -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Driftstack" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {/* W464 — schema.org structured data (Organization + WebSite + SoftwareApplication). */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=4" />
    {/* iOS home-screen icon — apple-touch-icon MUST be raster (PNG); an
        SVG favicon alone leaves driftstack.dev with a blank/generic icon
        when added to an iPhone home screen. Generated from the brand mark
        via scripts/gen-apple-touch-icon.mjs. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="relative">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR users skip the nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-tk-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to main content
    </a>
    <!-- Ambient background layer: radial glow + faint grid pattern. -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute inset-0 grid-bg opacity-60"></div>
      <div class="absolute inset-x-0 top-0 h-[600px] bg-glow-radial-accent"></div>
      <div class="absolute inset-x-0 bottom-0 h-[400px] bg-glow-radial-accent-soft"></div>
    </div>

    <Header />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
