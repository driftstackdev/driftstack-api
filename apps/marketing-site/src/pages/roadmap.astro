---
import BaseLayout from '../layouts/BaseLayout.astro';

// V-473 — public roadmap. Sourced selectively from the internal V-294
// catalog; internal V-NNN tags are intentionally NOT exposed (they
// rotate fast and would confuse customers). Customer-facing groupings
// are Now / Next / Later, framed as feature outcomes, not engineering
// slices.
//
// Items here are forward-looking — no commitment to specific dates.
// The marketing-copy-cadence rule applies: agent drafts; founder
// reviews tone post-hoc.

interface RoadmapItem {
  title: string;
  body: string;
}

const NOW: RoadmapItem[] = [
  {
    title: 'iPhone family fingerprint parity (81 profiles, iPhone 13 → 17 Pro Max)',
    body: 'Bit-identical fingerprint parity across 81 device profiles spanning the iPhone 13 through 17 Pro Max families, on iOS 18.6 / 18.7 and Safari 18.6 through 26.5. Every measured signal matches the real phone or the build is blocked. This is the platform foundation; everything else builds on top.',
  },
  {
    title: 'TypeScript · Python · Go SDKs',
    body: 'First-class clients in three languages, with idempotency keys, scope-based permission helpers, behavioural-preset selectors, proxy configuration helpers, and webhook signature verification. Wire-shape regression tested across all three.',
  },
  {
    title: 'Customer dashboard at app.driftstack.dev',
    body: 'Account self-service for sessions, profiles, snapshots, API keys, webhooks, billing, audit log, MFA enrollment, and team management. Live; ships with the rest of the platform.',
  },
  {
    title: 'Webhook delivery infrastructure',
    body: 'HMAC-SHA256-signed events with 5-minute timestamp tolerance, configurable retries, dead-letter queue, and dashboard replay. Subscribe to session lifecycle, quota, and API-key events.',
  },
  {
    title: 'GUI client for human operators',
    body: 'Tauri-based desktop client (macOS first) for the Manual ladder. Drive sessions yourself, manage 10–200 persistent profiles, no code required.',
  },
  {
    title: 'Public status page',
    body: 'status.driftstack.dev with manual + auto-poll incident history, email subscriptions, and a simple-by-design surface for "is the platform working right now?".',
  },
  {
    title: 'OAuth signup (Google · GitHub)',
    body: '"Continue with Google" / "Continue with GitHub" alongside email + password. Provider-verified emails skip the verification step.',
  },
  {
    title: 'API key rotation with grace window',
    body: 'Rotate a key without breaking in-flight clients. New key issued, old key kept valid for a configurable grace period, then auto-revoked. Same pattern already shipped for webhook signing secrets.',
  },
  {
    title: 'Recipe library (capture + manage at v1.0)',
    body: 'Snapshot a finished agent-session into a replayable recipe — capture the structured intent_log + transcript without re-paying decompose cost. Create, list, read, and delete ship at v1.0; recipe execution lands at v1.1.',
  },
  {
    title: 'Agent sessions — natural-language automation with AI / manual / pair modes',
    body: 'Layer a chat-style decompose-and-execute loop on top of any driver session. AI mode (default) translates a user message into structured intents (navigate / interact / wait / capture) and the runtime executes them; manual mode is pass-through for clients driving their own UI; pair mode lets the customer take over from the AI and hand back. Live transcript via Server-Sent Events with Last-Event-ID resume. Bundled LLM is opt-in (deployment-managed Anthropic budget); BYOK Anthropic via PUT /v1/account/me/byok-anthropic-key (the dashboard surface lands at v1.1; the server route is live today and your stored key is forwarded to the agent runtime automatically).',
  },
];

const NEXT: RoadmapItem[] = [
  {
    title: 'Account deletion (GDPR Article 17)',
    body: 'Self-service account deletion with explicit retention disclosure — recordings hard-deleted, invoice history kept per EU tax law, audit trail of the deletion event itself preserved.',
  },
  {
    title: 'Live session WebRTC stream',
    body: 'Watch a remote session render live in your browser, including from the GUI client. Useful for debugging detection challenges and verifying that a session actually navigated to where you expected.',
  },
  {
    title: 'Workflow recording',
    body: 'Record a manual session in the GUI client, replay it programmatically via the SDK. Closes the gap between "explored manually" and "automated reliably" without re-implementing every click.',
  },
];

const LATER: RoadmapItem[] = [
  {
    title: 'Older iOS archetypes (iPhone 12 + earlier)',
    body: 'iPhone 12 and earlier device-and-OS combinations, extending the catalog below the current iPhone 13 floor. Same source-level fidelity as the launch archetypes; pick which combination matches your target population. The 81-profile iPhone 13 → 17 Pro Max catalog (iOS 18.6 / 18.7, Safari 18.6–26.5) already ships at launch (see NOW above).',
  },
  {
    title: 'Android Chrome archetypes',
    body: 'Samsung Galaxy S24 / Pixel 9 / mid-tier Android device parity, source-level (Chromium fork instead of WebKit fork). Lands after the iOS catalog matures.',
  },
  {
    title: 'Hardware-key MFA (WebAuthn)',
    body: 'YubiKey / Touch ID / platform authenticators in addition to TOTP recovery codes. Single sign-on integrations (SAML / OIDC) for team accounts.',
  },
  {
    title: 'Public benchmark page',
    body: 'benchmarks.driftstack.dev with comparative detection results — published methodology, reproducible test rigs, raw data.',
  },
  {
    title: 'Self-hosted parity polish',
    body: 'Same control plane as the SaaS — admin UI, dashboard, status surface — runnable inside a single VPC with zero outbound traffic to driftstack.dev.',
  },
];
---

<BaseLayout
  title="Roadmap"
  description="What's live now, what's landing next, and what's further out for Driftstack. iPhone Safari fingerprint platform — agent sessions (AI / manual / pair), additional archetypes, GUI streaming, recipe library."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-tk-bg to-tk-surface">
    {/* 2026-05-24 — hero-glow atmosphere matches the rest of the site. */}
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-20 md:pt-24">
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">Roadmap</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl text-tk-ink">What's live, next, and further out.</h1>
      <p class="mt-6 max-w-prose text-lg text-tk-ink-2">
        We don't publish dates; we publish ordering. <strong>Now</strong> ships
        today. <strong>Next</strong> is in active engineering and lands in the
        weeks ahead. <strong>Later</strong> is on the deck and will move up
        as the foundation supports it.
      </p>
      <p class="mt-3 max-w-prose text-base text-tk-ink-2">
        If something on the Later list would unlock a real workload for you
        today, mail
        <a href="mailto:support@driftstack.dev" class="text-tk-accent underline"
          >support@driftstack.dev</a
        > — concrete demand reorders the deck.
      </p>
    </div>
  </section>

  <!-- Now -->
  <section class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-baseline gap-4">
        <span
          class="rounded-full bg-emerald-100 px-3 py-1 font-mono text-xs uppercase tracking-widest text-emerald-300"
        >
          Now
        </span>
        <h2 class="text-2xl font-semibold tracking-tight text-tk-ink">Live and supported today.</h2>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          NOW.map((item) => (
            <li class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-6">
              <h3 class="text-lg font-medium text-tk-ink">{item.title}</h3>
              <p class="mt-3 text-sm text-tk-ink-2">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Next -->
  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-baseline gap-4">
        <span
          class="rounded-full bg-tk-accent/20 px-3 py-1 font-mono text-xs uppercase tracking-widest text-tk-accent"
        >
          Next
        </span>
        <h2 class="text-2xl font-semibold tracking-tight text-tk-ink">In active engineering.</h2>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          NEXT.map((item) => (
            <li class="rounded-lg border border-tk-accent/30 bg-tk-surface p-6">
              <h3 class="text-lg font-medium text-tk-ink">{item.title}</h3>
              <p class="mt-3 text-sm text-tk-ink-2">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Later -->
  <section class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-baseline gap-4">
        <span
          class="rounded-full bg-tk-raised px-3 py-1 font-mono text-xs uppercase tracking-widest text-tk-ink-2"
        >
          Later
        </span>
        <h2 class="text-2xl font-semibold tracking-tight text-tk-ink">On the deck.</h2>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          LATER.map((item) => (
            <li class="rounded-lg border border-tk-border bg-tk-bg/60 p-6">
              <h3 class="text-lg font-medium text-tk-ink">{item.title}</h3>
              <p class="mt-3 text-sm text-tk-ink-2">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">
            Influence the order
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">
            Tell us what would unlock your workload.
          </h2>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            Customer demand is the single best ordering signal we have. If
            you're trying to decide whether to bet on Driftstack and a Later
            item is the deal-breaker, say so — that information moves it up.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="mailto:support@driftstack.dev" class="btn-primary">Email us</a>
          <a href="/pricing#free" class="btn-secondary">Try the platform</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
