---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Product updates"
  description="Released Driftstack product changes and current capability references."
>
  <PageHero label="Product updates" title="What is available today.">
    <p class="mt-6 max-w-prose text-lg text-tk-ink-2">
      Driftstack publishes released customer-facing changes in the
      <a href="/changelog/" class="text-tk-accent-text underline">changelog</a>
      and keeps the current HTTP contract in the
      <a href="https://docs.driftstack.io/api/" class="text-tk-accent-text underline"
        >API documentation</a
      >.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/changelog/" class="btn-primary">Read the changelog</a>
      <a href="https://docs.driftstack.io/api/" class="btn-secondary">Browse the API</a>
    </div>
  </PageHero>
</BaseLayout>
