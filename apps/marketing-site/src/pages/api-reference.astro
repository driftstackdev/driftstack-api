---
import BaseLayout from '../layouts/BaseLayout.astro';

// V-127a placeholder — until the marketing-site build embeds the
// Scalar UI bundle directly, this page links to the live API
// server's interactive reference at api.driftstack.dev/docs (which
// already serves Scalar against the running OpenAPI spec).
//
// Future iteration: build-time fetch of /openapi.json + embed
// Scalar's standalone HTML, so the reference stays browseable even
// when the API server is offline.

const API_DOCS_URL = 'https://api.driftstack.dev/docs';
const OPENAPI_JSON_URL = 'https://api.driftstack.dev/openapi.json';
---

<BaseLayout
  title="API reference"
  description="Driftstack API reference. Every endpoint, every shape, generated from the same OpenAPI 3.1 spec the SDK codegen reads."
>
  <!-- Header -->
  <section class="bg-gradient-to-b from-surface-base to-surface-raised">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">API reference</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink-primary md:text-5xl">
        Every endpoint, every shape.
      </h1>
      <p class="mt-6 max-w-prose text-lg text-ink-secondary">
        The Driftstack API is documented as an OpenAPI 3.1 spec generated
        from the same Zod schemas the server uses at runtime. There is no
        second source of truth — if a route exists, it's in the spec; if
        it's in the spec, the SDK has typed bindings for it.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={API_DOCS_URL} class="btn-primary">Open interactive reference →</a>
        <a href={OPENAPI_JSON_URL} class="btn-secondary">Download openapi.json</a>
      </div>
      <p class="mt-3 text-xs text-ink-muted">
        Interactive reference uses Scalar — try requests against your API
        key directly in the browser.
      </p>
    </div>
  </section>

  <!-- Surface map -->
  <section class="border-t border-white/10 bg-surface-raised">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Surface map</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-primary">
        Routes, grouped.
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Sessions
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/sessions</li>
            <li>GET /v1/sessions</li>
            <li>GET /v1/sessions/:id</li>
            <li>POST /v1/sessions/:id/navigate</li>
            <li>POST /v1/sessions/:id/interact</li>
            <li>POST /v1/sessions/:id/wait</li>
            <li>GET /v1/sessions/:id/state</li>
            <li>POST /v1/sessions/:id/capture</li>
            <li>DELETE /v1/sessions/:id</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Profiles
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/profiles</li>
            <li>GET /v1/profiles</li>
            <li>GET /v1/profiles/:id</li>
            <li>PATCH /v1/profiles/:id</li>
            <li>DELETE /v1/profiles/:id</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            API keys
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/api-keys</li>
            <li>GET /v1/api-keys</li>
            <li>POST /v1/api-keys/:id/rotate</li>
            <li>DELETE /v1/api-keys/:id</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Webhooks
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/webhooks</li>
            <li>GET /v1/webhooks</li>
            <li>GET /v1/webhooks/:id</li>
            <li>PATCH /v1/webhooks/:id</li>
            <li>DELETE /v1/webhooks/:id</li>
            <li>POST /v1/webhooks/:id/rotate-secret</li>
            <li>POST /v1/webhooks/:id/test</li>
            <li>GET /v1/webhooks/:id/deliveries</li>
            <li>POST /v1/webhook-deliveries/:id/replay</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Account
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>GET /v1/account/me</li>
            <li>GET /v1/account/audit-log</li>
            <li>GET /v1/account/audit-log/export</li>
            <li>GET /v1/account/email-preferences</li>
            <li>PUT /v1/account/email-preferences</li>
            <li>GET /v1/account/rate-limits</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Team
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/team/invites</li>
            <li>GET /v1/team/invites</li>
            <li>POST /v1/team/invites/accept</li>
            <li>GET /v1/team/members</li>
            <li>DELETE /v1/team/members/:id</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Billing — crypto orders
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/billing/crypto-checkout</li>
            <li>POST /v1/billing/crypto-checkout/quote</li>
            <li>GET /v1/billing/crypto-orders</li>
            <li>GET /v1/billing/crypto-orders/:id</li>
            <li>PATCH /v1/billing/crypto-orders/:id</li>
            <li>POST /v1/billing/crypto-orders/:id/cancel</li>
            <li>GET /v1/billing/crypto-orders/:id/receipt</li>
            <li>GET /v1/billing/crypto-orders/:id/receipt.txt</li>
            <li>GET /v1/billing/crypto-orders/:id/receipt.pdf</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Status
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>GET /v1/status</li>
            <li>GET /v1/status/stream</li>
            <li>GET /v1/status/sla</li>
            <li>POST /v1/status/subscribe</li>
            <li>POST /v1/status/subscribe/confirm</li>
            <li>POST /v1/status/subscribe/unsubscribe</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Auth flows
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/auth/signup</li>
            <li>POST /v1/auth/login</li>
            <li>POST /v1/auth/logout</li>
            <li>POST /v1/auth/verify-email</li>
            <li>POST /v1/auth/magic-link/request</li>
            <li>POST /v1/auth/magic-link/consume</li>
            <li>POST /v1/auth/password-reset/request</li>
            <li>POST /v1/auth/password-reset/confirm</li>
            <li>POST /v1/auth/refresh</li>
          </ul>
        </div>

        <div class="rounded-lg border border-white/10 bg-surface-raised p-6">
          <h3 class="font-mono text-sm uppercase tracking-widest text-glow-red">
            Billing
          </h3>
          <ul class="mt-3 space-y-2 font-mono text-xs text-ink-secondary">
            <li>POST /v1/billing/checkout-session</li>
            <li>POST /v1/billing/portal-session</li>
            <li>POST /v1/billing/trial-pack</li>
            <li>GET /v1/billing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- V-662 — Common patterns: side-by-side cURL / TS / Python / Go
       samples for the three most-used flows. Reduces the
       "what does it actually look like to call this?" friction
       that the route-list above doesn't answer on its own. -->
  <section class="border-t border-white/10 bg-surface-raised">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Common patterns</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-primary">
        Three flows, four languages.
      </h2>
      <p class="mt-3 max-w-prose text-ink-secondary">
        Most integrations are built on the same three operations:
        spin up a session, drive it, capture artifacts. Below: each
        one in cURL, TypeScript, Python, and Go. Copy-paste straight
        into a quickstart.
      </p>

      <!-- Create a session -->
      <div class="mt-10">
        <h3 class="text-xl font-semibold text-ink-primary">1. Create a session</h3>
        <p class="mt-2 max-w-prose text-sm text-ink-secondary">
          The minimal "hello world" — provision an iPhone 16 Pro Safari
          session, return its id. Default archetype if you don't pass one.
        </p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300"># cURL</span>{`
curl -X POST https://api.driftstack.dev/v1/sessions \\
  -H "authorization: Bearer $DRIFTSTACK_API_KEY" \\
  -H "content-type: application/json" \\
  -d '{"archetype":"iphone16pro_ios18_7_safari26_4"}'
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300">// TypeScript</span>{`
import { Driftstack } from "@driftstack/sdk";
const client = new Driftstack({ apiKey: process.env.DRIFTSTACK_API_KEY });
const session = await client.sessions.create({
  archetype: "iphone16pro_ios18_7_safari26_4",
});
console.log(session.id);
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300"># Python</span>{`
from driftstack import Driftstack
client = Driftstack(api_key=os.environ["DRIFTSTACK_API_KEY"])
session = client.sessions.create(archetype="iphone16pro_ios18_7_safari26_4")
print(session.id)
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300">// Go</span>{`
client := driftstack.NewClient(driftstack.Config{
    APIKey: os.Getenv("DRIFTSTACK_API_KEY"),
})
session, err := client.Sessions.Create(ctx, &driftstack.SessionCreateParams{
    Archetype: "iphone16pro_ios18_7_safari26_4",
})
if err != nil { return err }
fmt.Println(session.ID)
`}</code></pre>
        </div>
      </div>

      <!-- Drive the session -->
      <div class="mt-12">
        <h3 class="text-xl font-semibold text-ink-primary">2. Drive the session</h3>
        <p class="mt-2 max-w-prose text-sm text-ink-secondary">
          Navigate, tap, wait. <code class="font-mono">interact</code>
          handles taps, swipes, and key presses; <code class="font-mono">wait</code>
          blocks until a DOM condition is met or a timeout fires.
        </p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300"># cURL</span>{`
curl -X POST $URL/navigate \\
  -d '{"url":"https://example.com"}' ...
curl -X POST $URL/interact \\
  -d '{"action":{"kind":"tap_at","x":50,"y":120}}' ...
curl -X POST $URL/wait \\
  -d '{"condition":{"kind":"selector","selector":"main"}}' ...
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300">// TypeScript</span>{`
await client.sessions.navigate(session.id, { url: "https://example.com" });
await client.sessions.interact(session.id, {
  action: { kind: "tap_at", x: 50, y: 120 },
});
await client.sessions.wait(session.id, {
  condition: { kind: "selector", selector: "main" },
  timeout_ms: 5000,
});
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300"># Python</span>{`
client.sessions.navigate(session.id, url="https://example.com")
client.sessions.interact(session.id, action={
    "kind": "tap_at", "x": 50, "y": 120,
})
client.sessions.wait(session.id, condition={
    "kind": "selector", "selector": "main",
}, timeout_ms=5000)
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300">// Go</span>{`
_, err = client.Sessions.Navigate(ctx, session.ID, &driftstack.NavigateParams{
    URL: "https://example.com",
})
_, err = client.Sessions.Interact(ctx, session.ID, &driftstack.InteractParams{
    Action: driftstack.TapAt{X: 50, Y: 120},
})
`}</code></pre>
        </div>
      </div>

      <!-- Capture artifacts -->
      <div class="mt-12">
        <h3 class="text-xl font-semibold text-ink-primary">3. Capture a screenshot</h3>
        <p class="mt-2 max-w-prose text-sm text-ink-secondary">
          <code class="font-mono">capture</code> takes one of four kinds:
          <code class="font-mono">screenshot</code>, <code class="font-mono">dom</code>,
          <code class="font-mono">pdf</code>, or <code class="font-mono">recording</code>.
          The response carries a base64 <code class="font-mono">data</code> field
          for the first three; recordings stream to R2 + return a
          signed-URL handle.
        </p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300"># cURL</span>{`
curl -X POST $URL/capture \\
  -d '{"kind":"screenshot"}' ...
# response.data is base64 PNG
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300">// TypeScript</span>{`
const shot = await client.sessions.capture(session.id, {
  kind: "screenshot",
});
fs.writeFileSync("out.png", Buffer.from(shot.data, "base64"));
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300"># Python</span>{`
shot = client.sessions.capture(session.id, kind="screenshot")
Path("out.png").write_bytes(base64.b64decode(shot.data))
`}</code></pre>
          <pre
            class="overflow-x-auto rounded-md bg-surface-inset p-4 font-mono text-xs leading-relaxed text-slate-100"><code><span class="text-emerald-300">// Go</span>{`
shot, _ := client.Sessions.Capture(ctx, session.ID, &driftstack.CaptureParams{
    Kind: "screenshot",
})
data, _ := base64.StdEncoding.DecodeString(shot.Data)
os.WriteFile("out.png", data, 0644)
`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- V-662 — Error taxonomy quick reference. The interactive Scalar
       UI documents each shape, but customers evaluating the platform
       often want one screen with "here's what can go wrong + how to
       react" before they pick the SDK. -->
  <section class="border-t border-white/10 bg-surface-base">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Error reference</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-primary">
        What can go wrong, and what to do about it.
      </h2>
      <p class="mt-3 max-w-prose text-ink-secondary">
        Every error is RFC 7807
        <code class="font-mono">application/problem+json</code> with a
        stable <code class="font-mono">type</code> URI. SDK clients
        translate these into typed error classes; the cURL caller
        gets the JSON straight.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-white/10 text-left">
              <th class="py-2 pr-4 font-medium text-ink-primary">Status</th>
              <th class="py-2 pr-4 font-medium text-ink-primary">Type URI</th>
              <th class="py-2 pr-4 font-medium text-ink-primary">When</th>
              <th class="py-2 font-medium text-ink-primary">SDK class</th>
            </tr>
          </thead>
          <tbody class="font-mono text-xs">
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">400</td>
              <td class="py-2 pr-4">errors.driftstack.dev/validation-failed</td>
              <td class="py-2 pr-4 font-sans">Zod schema mismatch on request body.</td>
              <td class="py-2">ValidationError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">401</td>
              <td class="py-2 pr-4">errors.driftstack.dev/unauthorized</td>
              <td class="py-2 pr-4 font-sans">API key missing, malformed, or revoked.</td>
              <td class="py-2">AuthError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">404</td>
              <td class="py-2 pr-4">errors.driftstack.dev/not-found</td>
              <td class="py-2 pr-4 font-sans">Resource id doesn't exist or isn't visible to this key.</td>
              <td class="py-2">NotFoundError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">409</td>
              <td class="py-2 pr-4">errors.driftstack.dev/conflict</td>
              <td class="py-2 pr-4 font-sans">Resource state precludes the operation (e.g. trial pack already purchased).</td>
              <td class="py-2">ConflictError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">410</td>
              <td class="py-2 pr-4">errors.driftstack.dev/session-destroyed</td>
              <td class="py-2 pr-4 font-sans">Session was destroyed; create a new one.</td>
              <td class="py-2">SessionDestroyedError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">429</td>
              <td class="py-2 pr-4">errors.driftstack.dev/tier-limit</td>
              <td class="py-2 pr-4 font-sans">Account hit a tier cap (profile count, api-keys per account).</td>
              <td class="py-2">TierLimitError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">429</td>
              <td class="py-2 pr-4">errors.driftstack.dev/rate-limited</td>
              <td class="py-2 pr-4 font-sans">Per-account rate limit; <code>retry-after</code> header carries seconds.</td>
              <td class="py-2">RateLimitError <em class="font-sans not-italic text-ink-muted">(retryable)</em></td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">429</td>
              <td class="py-2 pr-4">errors.driftstack.dev/concurrency-limit</td>
              <td class="py-2 pr-4 font-sans">Account hit its tier-bound concurrent-session cap.</td>
              <td class="py-2">ConcurrencyLimitError</td>
            </tr>
            <tr class="border-b border-white/10">
              <td class="py-2 pr-4">500</td>
              <td class="py-2 pr-4">errors.driftstack.dev/internal</td>
              <td class="py-2 pr-4 font-sans">Server-side fault. Logged + alerted.</td>
              <td class="py-2">DriftstackError (kind: <code>internal</code>) <em class="font-sans not-italic text-ink-muted">(retryable)</em></td>
            </tr>
            <tr>
              <td class="py-2 pr-4">503</td>
              <td class="py-2 pr-4">errors.driftstack.dev/feature-unavailable</td>
              <td class="py-2 pr-4 font-sans">Feature disabled at deploy time (e.g. avatar upload without R2 bucket).</td>
              <td class="py-2">FeatureUnavailableError <em class="font-sans not-italic text-ink-muted">(NOT retryable)</em></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-ink-muted">
        SDK consumers can use <code class="font-mono">isRetryable(err)</code>
        (TypeScript) / equivalent predicates in Python + Go to filter
        which errors to retry without re-implementing the mapping.
      </p>
    </div>
  </section>

  <!-- Spec posture -->
  <section class="border-t border-white/10 bg-surface-base">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Spec posture</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink-primary">
        Stable contract. Versioned. Auto-generated.
      </h2>
      <ul class="mt-6 space-y-3 max-w-prose text-ink-secondary">
        <li class="flex gap-3">
          <span class="text-glow-red">→</span>
          <span>Every endpoint has Zod schemas for request + response. The OpenAPI 3.1 spec is generated from the schemas — there is no second source of truth.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-glow-red">→</span>
          <span>Every error case maps to an RFC 7807 <code class="font-mono">application/problem+json</code> response with a stable <code class="font-mono">type</code> URI.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-glow-red">→</span>
          <span>Breaking changes ship under a new path version. <code class="font-mono">/v1</code> stays stable; <code class="font-mono">/v2</code> would be a new prefix, not a silent shape change.</span>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
