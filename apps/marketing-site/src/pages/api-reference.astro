---
// Fleet v2 (2026-07-03) — re-skin only: PageHero/Section shells, the
// .card/.panel/IconTile recipes, AA-safe accent text, plus the
// living-reference banner. The curated route map, error table, and runnable
// samples are pinned by the api-reference satellite suite.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import IconTile from '../components/IconTile.astro';

// The live API server serves Scalar against the running OpenAPI spec.

const API_DOCS_URL = 'https://api.driftstack.dev/docs';
const OPENAPI_JSON_URL = 'https://api.driftstack.dev/openapi.json';
const ARCHETYPES_REFERENCE_URL = 'https://docs.driftstack.dev/api/archetypes/';
---

<BaseLayout
  title="API reference"
  description="Driftstack API reference: a curated route map and runnable examples backed by the same OpenAPI 3.1 spec the SDK codegen reads."
>
  <!-- Hero -->
  <PageHero label="API reference" title="Core routes, exact shapes.">
    <p class="mt-5 max-w-prose text-lg leading-8 text-tk-ink-2">
      The complete Driftstack API is documented in a standard
      machine-readable format (an OpenAPI 3.1 spec), generated from the
      same validation rules (Zod schemas) the server enforces at runtime.
      There is no second source of truth for public request and response
      shapes. This page is a curated map of common resources and runnable
      request patterns; the interactive reference carries the complete
      operation and schema catalog.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={API_DOCS_URL} class="btn-primary">Open interactive reference →</a>
      <a href={OPENAPI_JSON_URL} class="btn-secondary">Download openapi.json</a>
    </div>
    <p class="mt-4 font-mono text-xs text-tk-ink-3">
      Interactive reference uses Scalar — try requests against your API
      key directly in the browser.
    </p>
  </PageHero>

  <!-- Snapshot banner — the always-current reference lives on the docs
       site; this page is a curated snapshot of the surface. -->
  <div class="mx-auto max-w-6xl px-6 py-8">
    <p class="panel text-sm text-tk-ink-2">
      The complete living reference is <a href="https://docs.driftstack.dev" class="text-tk-accent-text underline" rel="noopener noreferrer">docs.driftstack.dev</a> — this page is a curated snapshot.
    </p>
  </div>

  <!-- Surface map -->
  <Section label="Surface map" title="Common routes, grouped." class="bg-tk-surface">
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="card p-6">
