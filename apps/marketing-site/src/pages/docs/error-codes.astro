---
import BaseLayout from '../../layouts/BaseLayout.astro';

// V-688 / W203 — error-codes developer reference. Lets developers
// grep logs for a problem-type URI + jump straight to "what does this
// mean / what should I do."
//
// W203 rewrote this doc to match reality: every Driftstack error
// response is RFC 7807 (`application/problem+json`) with a flat
// shape — `type` URI + `title` + `status` + `detail` + extension
// keys at the top level. The previous version of this page advertised
// a fictional `{ "error": { "code": ..., "message": ... } }` envelope
// and a `code` field that the server doesn't emit; clients dispatching
// on `error.code` would have hit `undefined` on every error path.

const ERRORS = [
  // 4xx
  { uri: 'bad-request', http: 400, when: 'Generic invariant violation (e.g. capacity ≤ 0, malformed URL).', action: 'Read `detail`; the field at fault is named.' },
  { uri: 'validation-failed', http: 400, when: 'Request body / params failed Zod schema validation.', action: 'Fix the field listed in the response detail.' },
  { uri: 'unauthorized', http: 401, when: 'Authorization header missing or malformed.', action: 'Send `Authorization: Bearer ds_live_…` on every request.' },
  { uri: 'invalid-key', http: 401, when: 'API key is malformed (wrong prefix) or unknown.', action: 'Confirm the key in your secret manager matches the dashboard.' },
  { uri: 'revoked-key', http: 401, when: 'API key was revoked (manually or via rotation grace expiry).', action: 'Mint a new key from the dashboard.' },
  { uri: 'expired-key', http: 401, when: 'API key passed its `expires_at` (set by rotation).', action: 'Roll to the post-rotation key; old key auto-expires after the 24h grace window.' },
  { uri: 'invalid-auth-token', http: 401, when: 'Signup-verification / password-reset / magic-link token was malformed, consumed, or expired.', action: 'Request a fresh token via the dashboard.' },
  { uri: 'email-not-verified', http: 401, when: 'Login attempted before the user verified their signup email.', action: 'Click the verify link in the welcome email, or use Resend verification email on /verify-email.' },
  { uri: 'invalid-credentials', http: 401, when: 'Login failed (wrong password) OR account does not exist — both surface the same shape on purpose (no enumeration).', action: 'Verify credentials; do not retry-loop.' },
  { uri: 'forbidden', http: 403, when: 'Key is valid but lacks the required scope for this endpoint.', action: 'Mint a key with the right scope (see /docs/api-keys).' },
  { uri: 'mfa-step-up-required', http: 403, when: 'Endpoint requires a fresh MFA step-up confirmation. Extension `requires_mfa_step_up: true`.', action: 'POST a 6-digit code to /v1/auth/mfa/step-up, then retry the original request.' },
  { uri: 'legal-acceptance-required', http: 403, when: 'A new ToS / Privacy revision hasn\'t been accepted by the calling account.', action: 'POST to /v1/legal/accept with the current revision id.' },
  { uri: 'not-found', http: 404, when: 'Resource id does not exist OR you do not have access (both surface as 404; no enumeration).', action: 'Verify the id; cross-account lookups return 404 by design.' },
  { uri: 'conflict', http: 409, when: 'State conflict (duplicate, sticky tombstone, idempotency-key replay with different body).', action: 'Read `detail` — often "mint a fresh resource instead".' },
  { uri: 'concurrency-limit', http: 429, when: 'Account has hit its tier-bound concurrent-session cap. Extensions `current_sessions` + `limit`.', action: 'Wait for a running session to finish, or upgrade the tier. See https://docs.driftstack.dev/guides/concurrency/.' },
  { uri: 'tier-limit', http: 429, when: 'Tier cap reached on a non-session resource (e.g. profile count, API keys per account).', action: 'Upgrade tier or delete unused resources.' },
  { uri: 'storage-quota-exceeded', http: 409, when: 'A profile-backed session-launch was refused because your profiles’ total stored size reached your tier’s storage cap. Extensions `used_bytes` + `cap_bytes` + `tier`. Sessions without a profile are never affected; Enterprise is soft-only (never blocks).', action: 'Delete or trim a profile, or upgrade the tier, then launch again.' },
  { uri: 'profile-in-use', http: 409, when: 'A session-create carried a `profile_id` that already has a live session — two sessions on the same profile would overwrite each other’s saved cookies/logins. Extension `active_session_id` names the live session. Sessions without a profile are never affected.', action: 'End the named session (or wait for it to finish), then launch again.' },
  { uri: 'proxy-validation-failed', http: 422, when: 'The proxy on a launch failed a LIVE launch-time connectivity test — the server connected THROUGH the proxy and ran a real egress round-trip, which failed, so the launch was blocked (no session, no worker). Extension `reason`: `unreachable` / `auth_failed` / `timeout` / `egress_blocked`.', action: 'Fix the proxy per the `reason` (host/port/online, credentials, or its upstream egress), then launch again.' },
  { uri: 'rate-limited', http: 429, when: 'A rate-limit bucket is empty. Extension `retry_after_seconds`; same value as `Retry-After` header.', action: 'Honour Retry-After. See /docs/rate-limits.' },
  // Session lifecycle
  { uri: 'session-destroyed', http: 410, when: 'Tried to operate on a session that\'s already been destroyed.', action: 'Treat the session as gone; create a new one.' },
  { uri: 'session-timeout', http: 504, when: 'A blocking session operation (e.g. wait-for-selector) ran past its timeout.', action: 'Increase the timeout if legitimate, or address the upstream slowness.' },
  // 5xx
  { uri: 'internal', http: 500, when: 'Driftstack hit an unexpected error processing the request.', action: 'Retry with exponential backoff. If persistent, email support with X-Request-Id.' },
  { uri: 'driver-error', http: 502, when: 'The underlying browser driver returned a structured failure.', action: 'See `detail` for the driver-side cause. Often retryable.' },
  { uri: 'driver-not-integrated', http: 503, when: 'Endpoint hit a driver path that hasn\'t been wired up yet.', action: 'Not retryable; contact support if a documented path lands here.' },
  { uri: 'feature-unavailable', http: 503, when: 'Feature explicitly disabled at deploy time (e.g. R2 bucket unconfigured for avatar upload).', action: 'Not retryable; the operator must wire the missing dependency.' },
  { uri: 'byok-anthropic-required', http: 502, when: 'Agent-sessions message turn cannot resolve an Anthropic API key. BYOK-for-v1.0 means the customer must supply their own key.', action: 'PUT /v1/account/me/byok-anthropic-key to set a stored key, or supply x-byok-anthropic-api-key on each request header.' },
  // Bundled-LLM (v2-#6 — 402 Payment Required, distinct slugs so SDKs can branch)
  { uri: 'bundled-llm-budget-exhausted', http: 402, when: 'Bundled-LLM monthly soft-cap reached on this account (default $20; configurable via PATCH /v1/account/me/bundled-llm-settings). Resets at calendar month start.', action: 'Raise the cap, wait until next month, or supply a BYOK Anthropic key (BYOK always wins per Q4=A).' },
  { uri: 'bundled-llm-consent-required', http: 402, when: 'Deployment is wired for bundled-LLM but the customer has not yet ticked the consent flag. Distinct from byok-anthropic-required so dashboards can render a one-click "enable bundled-LLM" CTA.', action: 'PATCH /v1/account/me/bundled-llm-settings with bundled_llm_consent: true.' },
  // Pair-mode (v2-#8 takeover/handback contention)
  { uri: 'pair-mode-conflict', http: 409, when: 'Pair-mode takeover lost the SET-NX-EX race against another participant. Extension carries winner_client_id so the loser dashboard can render "user X is taking over".', action: 'Re-fetch the session; do not retry the takeover unless the winner releases the lock.' },
  { uri: 'pair-mode-invalid-transition', http: 409, when: 'Pair-mode state machine refused the requested transition (e.g. a handback request before any takeover-grant). Extensions `from` + `transition`.', action: 'Re-fetch the pair-mode state; do not retry the transition without resolving the state mismatch.' },
  // Pre-auth
  { uri: 'email-already-registered', http: 409, when: 'Signup attempted for an email that already has an account.', action: 'Direct the user to /login or to the password-reset flow.' },
];
---

<BaseLayout title="Error codes — Driftstack developer docs" description="Every problem-type URI Driftstack returns, what it means, and what to do.">
  <main class="mx-auto max-w-3xl px-6 py-12 prose prose-slate dark:prose-invert">
    <h1>Error codes</h1>

    <p class="lead">
      Every error response from Driftstack is RFC 7807
      <code>application/problem+json</code>. The stable identifier is
      the <code>type</code> URI; dispatch your client logic on
      <code>type</code>, not on the HTTP status or the human-readable
      <code>title</code> / <code>detail</code>.
    </p>

    <h2>Response shape</h2>
    <pre><code>{`HTTP/1.1 429 Too Many Requests
Retry-After: 12
Content-Type: application/problem+json

{
  "type": "https://errors.driftstack.dev/rate-limited",
  "title": "Too Many Requests",
  "status": 429,
  "detail": "Rate limit for \\"sessions:create\\" exceeded for tier \\"solo_manual\\".",
  "retry_after_seconds": 12
}`}</code></pre>
    <p>
      Required fields: <code>type</code>, <code>title</code>,
      <code>status</code>. Optional: <code>detail</code> (human
      message), <code>instance</code> (request id when present), and
      problem-specific extensions (flat keys on the top-level, per RFC
      7807 §3.2). Always check <code>type</code>, not the HTTP status
      alone — the same status can correspond to multiple types
      (e.g. 429 covers both <code>rate-limited</code> and
      <code>concurrency-limit</code>; 401 covers six distinct types).
    </p>

    <h2>Reference</h2>
    <p>
      The full URI is <code>https://errors.driftstack.dev/&lt;slug&gt;</code>
      where <code>&lt;slug&gt;</code> is the value in the first column.
      Slugs are stable; they will not be renamed without a deprecation
      window.
    </p>
    <table>
      <thead>
        <tr>
          <th>Type slug</th>
          <th>HTTP</th>
          <th>When</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {ERRORS.map((e) => (
          <tr>
            <td><code>{e.uri}</code></td>
            <td>{e.http}</td>
            <td>{e.when}</td>
            <td>{e.action}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Stability</h2>
    <p>
      The <code>type</code> URI slugs listed above are part of the API
      contract — they will not be renamed or removed without a
      deprecation window. New types may be added; defensive clients
      should treat unknown types as <code>internal</code>
      (i.e. retry with backoff and surface <code>detail</code> to the
      operator).
    </p>

    <h2>OAuth token endpoint</h2>
    <p>
      Errors from the OAuth token endpoint follow the standard problem
      shape (the server maps OAuth 2.0 errors via
      <code>UnauthorizedError</code> / <code>BadRequestError</code>):
    </p>
    <ul>
      <li><code>invalid_client</code> / <code>unauthorized_client</code> → <code>type</code> is <code>unauthorized</code>.</li>
      <li><code>invalid_request</code> / <code>invalid_scope</code> / <code>invalid_grant</code> / <code>access_denied</code> → <code>type</code> is <code>bad-request</code>.</li>
    </ul>

    <h2>Status outages</h2>
    <p>
      For platform-level outages (everyone hits 5xx),
      check <a href="https://status.driftstack.dev">status.driftstack.dev</a>.
      Subscribe to email notifications from the same page if you'd
      like to be told before your dashboard refreshes.
    </p>

    <h2>Support</h2>
    <p>
      Persistent or surprising errors:
      <a href="mailto:developers@driftstack.dev">developers@driftstack.dev</a>.
      Include the <code>X-Request-Id</code> header from the response —
      every Driftstack response carries one, and we use it to find the
      corresponding server logs.
    </p>
  </main>
</BaseLayout>
