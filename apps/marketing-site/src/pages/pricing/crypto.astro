---
import BaseLayout from '../../layouts/BaseLayout.astro';

// V-674 — crypto-payments pricing page. Documents the V-666 /
// V-666.B / V-666.C crypto-checkout posture for customers who land
// on `/pricing/crypto` from the marketing nav.
//
// Posture (current): the checkout endpoint mints an order but
// payment-address minting is stubbed — the customer-facing flow is
// "request quote, support sends a payment address out-of-band, IPN
// settles." That arrangement holds until the V-666.D follow-up wires
// a NowPayments merchant account; this page describes what the
// customer actually experiences today (not the future state) so the
// page doesn't promise a flow we can't deliver.

// W247.C — labels derived from API_TIERS (single source of truth in
// marketing-site/src/data/pricing.ts). Hard-coded prices here drifted
// against the canonical table; deriving keeps both layers in lockstep.
import { API_TIERS } from '../../data/pricing.ts';

function fmtPriceLabel(monthlyUsd: number | null, oneTime?: boolean): string {
  if (monthlyUsd === null) return 'custom';
  const price = monthlyUsd % 1 === 0
    ? `$${monthlyUsd.toLocaleString('en-US')}`
    : `$${monthlyUsd.toFixed(2)}`;
  return oneTime ? `${price}, one-time` : `${price}/mo`;
}

// The perpetual free tier is not purchasable (no crypto checkout); the
// one-time trial_pack was retired 2026-05-27. Only the 6 paid tiers.
const CRYPTO_PAYABLE_TIER_IDS = [
  'solo_manual',
  'team_manual',
  'agency_manual',
  'api_starter',
  'api_builder',
  'api_scale',
];

const SUPPORTED_TIERS = CRYPTO_PAYABLE_TIER_IDS.map((id) => {
  const t = API_TIERS.find((row) => row.id === id);
  if (!t) throw new Error(`Crypto-supported tier not found in API_TIERS: ${id}`);
  return {
    id: t.id,
    label: `${t.name} (${fmtPriceLabel(t.monthlyUsd, t.oneTime)})`,
  };
});

const ACCEPTED_CURRENCIES = ['BTC', 'ETH', 'USDC (ERC-20)', 'USDT (ERC-20)', 'USDC (Polygon)'];
---

<BaseLayout title="Crypto payments — Driftstack" description="Pay for Driftstack with bitcoin, ether, or stablecoins. Supported tiers, accepted currencies, and confirmation timing.">
  {/* 2026-05-23 — hero-glow + gradient-text intro before the prose body. */}
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 pb-6 pt-16">
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Pricing · Crypto</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl text-tk-ink">Paying with crypto.</h1>
    </div>
  </section>
  <main class="mx-auto max-w-3xl px-6 py-12 prose prose-slate dark:prose-invert prose-headings:font-semibold">
    <p class="lead text-lg text-tk-ink-2"><strong class="text-tk-ink">Bitcoin, Ether, USDC, USDT</strong> — every self-serve paid tier accepts crypto via NowPayments.</p>

    <p>
      Settlement is on-chain; once your transfer receives the required
      confirmations, your account unlocks automatically — no support
      ticket needed for the steady state.
    </p>

    <h2>Supported tiers</h2>
    <ul>
      {SUPPORTED_TIERS.map((t) => <li>{t.label}</li>)}
    </ul>
    <p class="text-sm text-tk-ink-3">
      Enterprise tiers (custom pricing) settle through wire transfer or
      crypto on a negotiated invoice — contact <a href="mailto:sales@driftstack.dev">sales@driftstack.dev</a>.
    </p>

    <h2>Accepted currencies</h2>
    <ul>
      {ACCEPTED_CURRENCIES.map((c) => <li>{c}</li>)}
    </ul>
    <p class="text-sm text-tk-ink-3">
      The price you see at checkout is quoted in USD; the equivalent
      crypto amount is fixed when the order is created and doesn't
      change. There's no fixed 1-hour cutoff — a pending order isn't
      automatically cancelled on a timer. If you want a fresh quote
      (you missed your window, or market conditions moved), email
      <a href="mailto:support@driftstack.dev">support@driftstack.dev</a>
      and we'll close the stale order so you can check out again at
      the current price.
    </p>

    <h2>Confirmation timing</h2>
    <table>
      <thead>
        <tr><th>Asset</th><th>Required confirmations</th><th>Typical settle</th></tr>
      </thead>
      <tbody>
        <tr><td>BTC</td><td>2</td><td>~20 minutes</td></tr>
        <tr><td>ETH</td><td>12</td><td>~3 minutes</td></tr>
        <tr><td>USDC / USDT (ERC-20)</td><td>12</td><td>~3 minutes</td></tr>
        <tr><td>USDC (Polygon)</td><td>32</td><td>~90 seconds</td></tr>
      </tbody>
    </table>

    <h2>How the checkout works</h2>
    <ol>
      <li>From your account dashboard, pick the tier and click
        <strong>Pay with crypto</strong>.</li>
      <li>The Driftstack backend mints an order via NowPayments and
        returns a unique deposit address + the exact amount to send.</li>
      <li>You broadcast the on-chain transfer. The exchange or wallet
        you use is up to you — we only need to see the transfer land
        at the address NowPayments issued.</li>
      <li>NowPayments watches the chain; once your transfer hits the
        required confirmation count, Driftstack flips your account
        to the new tier.</li>
    </ol>

    <p class="rounded-md border border-status-warning/40 bg-status-warning/15 p-3 text-sm">
      <strong>Crypto payments are non-refundable.</strong> You may
      cancel anytime — cancellation stops future billing periods —
      but the current billing period is not refunded. See
      <a href="/legal/refunds">refund policy</a> for the full rules.
    </p>

    <h2>If something goes wrong</h2>
    <ul>
      <li><strong>Underpayment</strong> — if the transfer is short of
        the quoted amount, the order moves to <code>partial</code>;
        support follows up within one business day to confirm a
        top-up. Crypto payments are non-refundable, so partial
        underpayments are resolved by topping up rather than by
        sending the customer's existing crypto back.</li>
      <li><strong>Late payment</strong> — transfers received after the
        1-hour pay-window land on an expired order. Support manually
        reconciles these; expect a one-business-day delay.</li>
      <li><strong>Wrong currency</strong> — sending an unsupported
        asset to the deposit address means the funds are not recovered
        automatically. Email <a href="mailto:support@driftstack.dev">support@driftstack.dev</a> with the
        transaction hash; we'll do what we can on a best-effort basis.</li>
    </ul>

    <h2>Refunds + cancellation</h2>
    <p>
      <strong>Crypto payments are non-refundable.</strong> Once a
      crypto payment settles on-chain, it is committed for the
      billing period it covers. You can cancel your subscription at
      any time — cancellation stops the next billing period's
      payment request — but the current period is not pro-rated or
      refunded. This is the standard B2B SaaS posture; the rationale
      is in <a href="/legal/refunds">/legal/refunds</a>.
    </p>
    <p>
      If you need a refund mechanism, our card-billing path (Stripe)
      is the right channel; card refunds follow the standard rules
      in the refund policy.
    </p>

    <h2>Tax + accounting</h2>
    <p>
      Driftstack issues USD-denominated invoices for crypto payments
      based on the quoted USD price at order time, not the realised
      crypto amount. This keeps your accounting in line with cards;
      if you need a crypto-denominated receipt for self-custody
      accounting, request one from support.
    </p>
  </main>
</BaseLayout>
