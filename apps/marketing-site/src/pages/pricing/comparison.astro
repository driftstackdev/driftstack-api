---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { API_TIERS } from '../../data/pricing.ts';
import type { LlmBilling } from '../../data/pricing.ts';

// V-668 — per-tier comparison page. The main /pricing page is a
// glanceable overview; /pricing/comparison is the spreadsheet-style
// deep dive sales evaluations actually need. Pulls every dimension
// directly from the same data file so the two pages can't drift.

const freeTier = API_TIERS.find((t) => t.id === 'free');
const paidTiers = API_TIERS.filter((t) => t.id !== 'free');

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtAiAgent(aiAgent: boolean, llmBilling: LlmBilling): string {
  if (!aiAgent) return 'Not on this tier';
  switch (llmBilling) {
    case 'byok_only':
      return 'BYOK only';
    case 'byok_or_bundled':
      return 'BYOK or bundled';
    case 'byok_or_bundled_custom':
      return 'BYOK or bundled (custom)';
    default:
      return 'Available';
  }
}

function fmtNumberOrString(value: number | string): string {
  return typeof value === 'number' ? value.toLocaleString('en-US') : value;
}

// V-668 — comparison dimensions in display order. Source of truth so
// the table grouping is identical across desktop + mobile renders.
const DIMENSIONS = [
  {
    heading: 'Pricing',
    rows: [
      {
        label: 'Monthly',
        get: (t: (typeof API_TIERS)[number]): string => fmtUsd(t.monthlyUsd),
      },
      {
        label: 'Annual (monthly equivalent)',
        get: (t: (typeof API_TIERS)[number]): string =>
          fmtUsd(t.annualMonthlyEquivalentUsd),
      },
      {
        label: 'Annual total',
        get: (t: (typeof API_TIERS)[number]): string => fmtUsd(t.annualUsd),
      },
      {
        label: 'Extra hourly charges (overage)',
        get: (t: (typeof API_TIERS)[number]): string =>
          t.overagePerHourUsd === null ? 'None' : fmtUsd(t.overagePerHourUsd),
      },
    ],
  },
  {
    heading: 'Quotas',
    rows: [
      {
        label: 'Saved profiles',
        get: (t: (typeof API_TIERS)[number]): string => fmtNumberOrString(t.profiles),
      },
      {
        label: 'Concurrent sessions',
        get: (t: (typeof API_TIERS)[number]): string => fmtNumberOrString(t.concurrent),
      },
      {
        label: 'Session hours',
        get: (t: (typeof API_TIERS)[number]): string => t.hoursLabel,
      },
      {
        label: 'Device types (archetypes)',
        get: (t: (typeof API_TIERS)[number]): string => t.archetypeAccess,
      },
    ],
  },
  {
    heading: 'Features',
    rows: [
      {
        label: 'AI agent',
        get: (t: (typeof API_TIERS)[number]): string => fmtAiAgent(t.aiAgent, t.llmBilling),
      },
      {
        label: 'Audience',
        get: (t: (typeof API_TIERS)[number]): string => t.audience,
      },
      {
        label: 'Support',
        get: (t: (typeof API_TIERS)[number]): string => t.support,
      },
    ],
  },
] as const;
---

<BaseLayout
  title="Pricing comparison"
  description="Side-by-side comparison of every Driftstack tier: pricing, quotas, features, support. Pulled from the same data the live billing system uses, so you can quote it in evaluations."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-tk-bg to-tk-surface">
    {/* 2026-05-23 — hero-glow + gradient h1 matches family. */}
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 pb-12 pt-20 md:pt-24">
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">
        Pricing · Comparison
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl text-tk-ink">Compare every tier, side-by-side.</h1>
      <p class="mt-6 max-w-prose text-lg text-tk-ink-2">
        Everything that matters when you're comparing plans, in one
        table. Numbers come from the same data file the live billing
        system uses — what you see here is what your invoice will say.
      </p>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-3">
        Looking for the glanceable view?
        <a href="/pricing/" class="text-tk-accent-text underline">/pricing</a>
        has the headline cards.
      </p>
    </div>
  </section>

  {freeTier && (
    <section class="border-t border-tk-border bg-tk-surface">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <h2 class="text-xl font-semibold tracking-tight text-tk-ink">Free ({fmtUsd(freeTier.monthlyUsd)}, forever)</h2>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-2">
          {freeTier.hoursLabel} — a try-before-you-buy tier, no card
          required. Includes every device type
          (<a href="/glossary/#archetype" class="text-tk-accent-text underline">archetype</a>)
          we currently offer.
        </p>
        <p class="mt-2 text-sm">
          <a
            href={freeTier.cta.href}
            class="font-medium text-tk-accent-text underline">{freeTier.cta.label} →</a>
        </p>
      </div>
    </section>
  )}

  <section class="border-t border-tk-border bg-tk-surface/40">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="overflow-x-auto">
        <table class="min-w-full border-separate border-spacing-0 text-sm">
          <thead>
            <tr>
              <th
                class="sticky left-0 z-10 border-b border-tk-border bg-tk-surface py-3 pl-2 pr-4 text-left text-xs font-medium uppercase tracking-wider text-tk-ink-3"
              >
                Dimension
              </th>
              {paidTiers.map((t) => (
                <th
                  scope="col"
                  class={`border-b border-tk-border bg-tk-surface py-3 px-4 text-left text-xs font-medium uppercase tracking-wider ${
                    t.highlight ? 'text-tk-accent-text' : 'text-tk-ink-3'
                  }`}
                >
                  {t.name}{t.highlight && ' ★'}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {DIMENSIONS.map((group) => (
              <>
                <tr>
                  <td
                    colspan={paidTiers.length + 1}
                    class="bg-tk-surface pt-6 pb-2 pl-2 text-xs font-semibold uppercase tracking-widest text-tk-accent-text"
                  >
                    {group.heading}
                  </td>
                </tr>
                {group.rows.map((row) => (
                  <tr class="bg-tk-surface">
                    <td
                      class="sticky left-0 z-10 border-b border-tk-border bg-tk-surface py-2 pl-2 pr-4 text-sm font-medium text-tk-ink-2"
                    >
                      {row.label}
                    </td>
                    {paidTiers.map((t) => (
                      <td
                        class={`border-b border-tk-border py-2 px-4 text-sm align-top ${
                          t.highlight ? 'text-tk-accent-text' : 'text-tk-ink-2'
                        }`}
                      >
                        {row.get(t)}
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-tk-ink-3">
        ★ = team's most popular tier in active evaluations. Not a sales
        push — just what prospective customers are picking right now.
      </p>
      <p class="mt-2 max-w-prose text-xs text-tk-ink-3">
        BYOK = bring your own key: you connect your own Anthropic account
        for the AI agent and pay Anthropic directly. Bundled = Driftstack
        carries the AI calls and bills them on your Driftstack invoice. An
        <a href="/glossary/#archetype" class="text-tk-accent-text underline">archetype</a>
        is a specific iPhone model + iOS + Safari combination. SLA = the
        reply time we commit to for support.
      </p>
    </div>
  </section>

  <section class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="text-2xl font-semibold tracking-tight text-tk-ink">How tier-switching works</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-tk-border bg-tk-surface p-6">
          <h3 class="text-base font-semibold text-tk-ink">
            Upgrade mid-month
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Switching to a higher tier is immediate. You pay only the
            difference for the rest of the billing period (prorated); the
            next invoice reflects the upgrade. No interruption to running
            sessions.
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-6">
          <h3 class="text-base font-semibold text-tk-ink">
            Downgrade at renewal
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Downgrades take effect at the end of the current billing
            period — you keep the higher tier's quotas until renewal,
            then drop to the lower tier. If you have more profiles than
            the lower tier allows, you keep and can view them all — you
            just can't create new ones until you're back under the limit.
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-6">
          <h3 class="text-base font-semibold text-tk-ink">
            Cancel any time
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Cancellation takes effect at the end of the current billing
            period. API access stops at renewal; we keep your data for
            30 days after cancellation in case you come back, then delete
            it on the schedule promised in our data-processing agreement
            (DPA).
          </p>
        </div>
        <div class="rounded-lg border border-tk-border bg-tk-surface p-6">
          <h3 class="text-base font-semibold text-tk-ink">
            Annual vs monthly
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Annual billing is ~20% off the monthly rate, paid up-front.
            You can switch monthly → annual at any time (the annual term
            starts right away, prorated); annual → monthly takes effect
            at the annual term's end.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-tk-border bg-tk-surface/40">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-tk-ink">Need a custom quote?</h2>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            Volume above the published tiers, keeping data longer than 30
            days, or a contractual reply-time commitment (SLA) — email us
            a rough picture of your usage and we'll quote in one business
            day.
          </p>
        </div>
        <a href="mailto:sales@driftstack.dev" class="btn-primary">Email sales</a>
      </div>
    </div>
  </section>
</BaseLayout>
