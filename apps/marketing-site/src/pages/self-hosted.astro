---
// Self-hosted v2 (2026-07-03) — "Plain Words, Same Teeth" pass: Band-A
// hero (plain why-self-host opening in the homepage §12 register), Fleet
// v2 recipes (PageHero/Section/Card/IconTile/CtaBand, AA-safe accent
// text). SKU data binding, prices, the ASCII architecture diagram and
// every substantive claim are byte-identical to the pre-redesign page.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import IconTile from '../components/IconTile.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  SELF_HOSTED_ARCHETYPE_UPDATES,
  SELF_HOSTED_SKUS,
  SELF_HOSTED_SOFTWARE_UPDATES,
  SELF_HOSTED_SOURCE_ACCESS,
} from '../data/pricing.ts';

// 2026-05-19 founder verdict — hardware is OPTIONAL within the
// Apple-Silicon family. Any M-series Mac works; the per-SKU rows
// below are recommended-spec hints sized for the SKU's expected
// concurrent workload. Customers running fewer concurrent sessions
// can use a smaller Mac without penalty; customers needing many
// concurrent sessions need bigger / more Macs (real differentiation).
const HARDWARE_BY_SKU: Record<string, string> = {
  self_hosted_solo: 'Any Apple Silicon Mac (Mac Mini M4 16 GB recommended)',
  self_hosted_pro: 'Apple Silicon Mac sized for sustained concurrency (Mac Studio M4 Max recommended)',
  self_hosted_enterprise: 'Multi-node Apple Silicon fleet (Mac Studio Ultra / Mac Pro recommended)',
};

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtArchetypes(max: number | null): string {
  if (max === null) return 'All available + custom archetypes';
  return max === 1 ? '1 archetype' : `${max.toString()} archetypes`;
}

// 2026-05-19 founder verdict — drop tiered SLA ladder (theatre for
// a small operation). Single best-effort target across all SKUs;
// Slack Connect available on request post-paid-subscription.
function fmtSupportTier(tier: 'email_48h' | 'email_slack_12h' | 'dedicated_csm_1h'): string {
  switch (tier) {
    case 'email_48h':
      return 'Email · 48h target';
    case 'email_slack_12h':
      return 'Email + Slack Connect · 48h target';
    case 'dedicated_csm_1h':
      return 'Email + Slack Connect · 48h target';
  }
}

function fmtCustomArchetypeDev(level: 'none' | 'limited' | 'unlimited'): string {
  switch (level) {
    case 'none':
      return '—';
    case 'limited':
      return 'Limited (1/yr)';
    case 'unlimited':
      return 'Unlimited';
  }
}
---

<BaseLayout
  title="Self-Hosted"
  description="Run Driftstack on your own infrastructure. Privacy-required workloads, sustained high-concurrency operations, full data sovereignty. Self-hosted GA follows the API public launch — Contact Sales for early access."
>
  <!-- Hero — Band A: the plain why-self-host sentence leads, the
       technical substance rides underneath. -->
  <PageHero label="Self-hosted" title="Run Driftstack on your own infrastructure.">
    <p class="mt-5 max-w-2xl text-lg leading-8 text-tk-ink-2">
      Some work can't leave your building. If your sessions carry data
      that must stay inside your own network, if your security team
      needs to own every box in the chain, or if you run enough
      concurrent sessions that renting stops making sense — run the
      whole thing on Macs you own.
    </p>
    <p class="mt-4 max-w-2xl text-base leading-7 text-tk-ink-2">
      Same SDK, same archetypes, same iPhone Safari fidelity — just running
      on hardware you own and inside a network you control. Driftstack
      runs the software that coordinates everything (the
      orchestration); you supply the machines. Any Apple
      Silicon Mac works; the package you choose (the SKU) is about how
      many sessions you need running at once, not about unlocking
      software features.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="mailto:sales@driftstack.dev?subject=Self-Hosted%20inquiry" class="btn-primary"
        >Contact sales</a
      >
      <a href="/pricing#self-hosted" class="btn-secondary">See pricing</a>
    </div>
    {/* S43 2026-07-07 (founder-approved) — GA-promise softened from a
        dated commitment ("within 6 months") to intent-without-deadline. */}
    <p class="mt-4 text-sm text-tk-ink-2">
      You can start today by emailing sales; the finished, generally
      available (GA) self-hosted release follows the API's public
      launch.
    </p>
    <p class="mt-2 font-mono text-xs text-tk-ink-3">
      Available "Contact Sales" from day 0. Self-hosted GA follows the
      API public launch.
    </p>
  </PageHero>

  <!-- Architecture diagram -->
  <Section
    label="Architecture"
    title="Two boxes. One secure channel. Your hardware, our orchestration."
  >
    <p class="mt-4 max-w-2xl text-base leading-7 text-tk-ink-2">
      Self-hosted is one piece of Driftstack software running on Mac
      hardware you own. Driftstack's coordination service (the
      "control plane") starts and manages sessions and gives you the
      developer kit (SDK) and the desktop app (GUI) — and it never
      holds what happens inside your sessions.
    </p>

    <div class="panel mt-10 overflow-x-auto p-8 font-mono text-sm leading-6 text-tk-ink">
      <pre class="whitespace-pre">{`  YOUR INFRA                                 DRIFTSTACK ORCHESTRATION
  ──────────                                 ────────────────────────

  ┌──────────────────┐                       ┌──────────────────────┐
  │  Mac fleet       │ ◀──── secure ───────▶ │  Control plane       │
  │  (M4 / Studio /  │       channel         │  (license, API keys, │
  │   multi-node)    │       (HTTPS)         │   session metadata)  │
  └──────────────────┘                       └──────────────────────┘
        │
        │  WebKit sessions exit via your network
        ▼
  ┌──────────────────┐
  │  Your network    │
  │  egress          │
  │  (DC / VPN /     │
  │   BYO SOCKS5 +   │
  │   OpenVPN + WG)  │
  └──────────────────┘`}</pre>
    </div>

    <p class="mt-6 max-w-prose text-sm text-tk-ink-3">
      Session content (URLs, form data, captures, recordings) stays inside
      your network. Driftstack's control plane sees your license and
      basic session details — when a session started, which profile
      ran (session metadata) — never the session itself.
    </p>
  </Section>

  <!-- When self-hosted makes sense -->
  <Section label="Why self-host" title="When self-hosted is the right call." class="bg-tk-surface">
    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 11.8 4.2-1.1 8-6.3 8-11.8V5l-8-3z" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Privacy</p>
        <h3 class="mt-3 text-xl font-semibold text-tk-ink">Sessions never leave your perimeter</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          For work where session content (URLs, form data, captures,
          recordings) must never pass through anyone's servers but
          your own. Self-hosted runs the browser engine (WebKit) and
          Driftstack's coordination software (the control plane) on
          your own Mac mini or Mac Studio; nothing leaves your network.
        </p>
      </div>
      <div>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Volume</p>
        <h3 class="mt-3 text-xl font-semibold text-tk-ink">
          Sustained high-concurrency operations
        </h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          When your fleet runs at consistently high concurrent-session
          counts (sustained 10+ concurrent across the month), owning
          the hardware works out cheaper than renting the equivalent
          cloud plan. We'll work out with your team, from your actual
          usage — how many sessions you run at once, and for how long
          — the exact point where buying beats renting (the
          break-even).
        </p>
      </div>
      <div>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Sovereignty</p>
        <h3 class="mt-3 text-xl font-semibold text-tk-ink">Full control over recordings + state</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          Recordings, screenshots, saved request files — all stored on
          storage you own: an S3-style cloud bucket (R2-compatible) or
          a local network drive (NAS), with you deciding how long
          anything is kept (the retention policy). Driftstack keeps no
          copies, no outside vendor (sub-processor) has shared access,
          and there's no extra data-processing-agreement (DPA) add-on
          for your security review.
        </p>
      </div>
    </div>
  </Section>

  <!-- SKU comparison -->
  <Section
    label="Configurations"
    title="Three configurations."
    lead="Each package (SKU) pairs a Mac configuration with a Driftstack license tier. You buy the hardware; we install and set up the Driftstack software that runs everything on it (the control plane + orchestration layer)."
  >
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {SELF_HOSTED_SKUS.map((sku) => (
        <div class="card p-6">
          <h3 class="text-xl font-semibold text-tk-ink">{sku.name}</h3>
          <div class="mt-4">
            {sku.monthlyUsd === null ? (
              <div>
                <span class="text-3xl font-semibold text-tk-ink">
                  from {fmtUsd(sku.annualMonthlyEquivalentUsd)}
                </span>
                <span class="text-sm font-normal text-tk-ink-3">/mo</span>
                <div class="text-xs text-tk-ink-3">annual contract only</div>
              </div>
            ) : (
              <div>
                <span class="text-3xl font-semibold text-tk-ink">
                  {fmtUsd(sku.monthlyUsd)}
                </span>
                <span class="text-sm font-normal text-tk-ink-3">/mo</span>
                <div class="text-xs text-tk-ink-3">
                  or {fmtUsd(sku.annualMonthlyEquivalentUsd)}/mo billed annually
                </div>
              </div>
            )}
          </div>
          <dl class="mt-6 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Hardware</dt>
              <dd class="text-right text-tk-ink">{HARDWARE_BY_SKU[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Browser profiles</dt>
              <dd class="text-right text-tk-ink">
                {sku.profilesMax === null ? 'Unlimited' : sku.profilesMax.toString()}
              </dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Archetypes</dt>
              <dd class="text-right text-tk-ink">{fmtArchetypes(sku.archetypesMax)}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Software updates</dt>
              <dd class="text-right text-tk-ink-2">{SELF_HOSTED_SOFTWARE_UPDATES[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Archetype updates</dt>
              <dd class="text-right text-tk-ink-2">{SELF_HOSTED_ARCHETYPE_UPDATES[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Source code access</dt>
              <dd class="text-right text-tk-ink-2">{SELF_HOSTED_SOURCE_ACCESS[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Custom device profiles built for you (archetype dev)</dt>
              <dd class="text-right text-tk-ink-2">
                {fmtCustomArchetypeDev(sku.customArchetypeDevelopment)}
              </dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Source-code escrow (a third party holds a copy)</dt>
              <dd class="text-right text-tk-ink-2">{sku.sourceEscrow ? 'Yes' : 'No'}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Support</dt>
              <dd class="text-right text-tk-ink-2">{fmtSupportTier(sku.supportTier)}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Minimum term</dt>
              <dd class="text-right text-tk-ink">{sku.minimumTermMonths.toString()}-month</dd>
            </div>
          </dl>
          <p class="mt-3 text-xs text-tk-ink-3">
            Concurrent capacity is bounded by your hardware, not by license.
          </p>
          <a href={sku.ctaHref} class="btn-primary mt-6 w-full">Contact sales</a>
        </div>
      ))}
    </div>
  </Section>

  <!-- Process -->
  <Section label="Process" title="How it works." class="bg-tk-surface">
    <ol class="mt-10 grid gap-8 md:grid-cols-4">
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">01</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Contact sales</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          Email <a href="mailto:sales@driftstack.dev" class="text-tk-accent-text underline">sales@driftstack.dev</a> with what the work is and how many
          sessions you need going at once (your workload shape +
          concurrent-session profile). We'll set out in writing
          whether self-hosting fits and where owning beats renting.
        </p>
      </li>
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">02</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Procure hardware</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          You buy the Mac configuration matching your package — Mini
          M4, Studio
          M4 Max, or Studio Ultra / Mac Pro / multi-node. We tell you
          exactly what to buy and how it should be set up (the
          provisioning specs).
        </p>
      </li>
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">03</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Onboard</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          We install the Driftstack software on your hardware, set
          your team up in the admin console, and run a first live test
          together (a joint smoke test) on your real workload.
        </p>
      </li>
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">04</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Run</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          Same SDK as cloud Driftstack — change one settings value (a
          config field) and your
          existing code talks to your own installation instead of our
          cloud. Support channels and response targets match the
          package you chose.
        </p>
      </li>
    </ol>
  </Section>

  <!-- FAQ teaser -->
  <Section label="Common questions" title="What about updates? Compliance? SLAs?">
    <p class="mt-4 max-w-2xl text-base leading-7 text-tk-ink-2">
      See the FAQ for the standard answers, or email us with the
      specific question your security / procurement / compliance team
      is asking. We answer everything in writing.
    </p>
    <div class="mt-8">
      <a href="/faq" class="btn-secondary">See FAQ</a>
    </div>
  </Section>

  <!-- Final CTA -->
  <CtaBand
    title="Talk to us about self-hosting."
    lead="Email what you're running — what the work is and how many sessions you need going at once — and we'll set out in writing whether self-hosting fits and where owning beats renting."
    primaryHref="mailto:sales@driftstack.dev?subject=Self-Hosted%20inquiry"
    primaryLabel="Contact sales"
    secondaryHref="/pricing#self-hosted"
    secondaryLabel="See pricing"
  />
</BaseLayout>
