---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SELF_HOSTED_ARCHETYPE_UPDATES,
  SELF_HOSTED_SKUS,
  SELF_HOSTED_SOFTWARE_UPDATES,
  SELF_HOSTED_SOURCE_ACCESS,
} from '../data/pricing.ts';

// 2026-05-19 founder verdict — hardware is OPTIONAL within the
// Apple-Silicon family. Any M-series Mac works; the per-SKU rows
// below are recommended-spec hints sized for the SKU's expected
// concurrent workload. Customers running fewer concurrent sessions
// can use a smaller Mac without penalty; customers needing many
// concurrent sessions need bigger / more Macs (real differentiation).
const HARDWARE_BY_SKU: Record<string, string> = {
  self_hosted_solo: 'Any Apple Silicon Mac (Mac Mini M4 16 GB recommended)',
  self_hosted_pro: 'Apple Silicon Mac sized for sustained concurrency (Mac Studio M4 Max recommended)',
  self_hosted_enterprise: 'Multi-node Apple Silicon fleet (Mac Studio Ultra / Mac Pro recommended)',
};

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtArchetypes(max: number | null): string {
  if (max === null) return 'All available + custom archetypes';
  return max === 1 ? '1 archetype' : `${max.toString()} archetypes`;
}

// 2026-05-19 founder verdict — drop tiered SLA ladder (theatre for
// a small operation). Single best-effort target across all SKUs;
// Slack Connect available on request post-paid-subscription.
function fmtSupportTier(tier: 'email_48h' | 'email_slack_12h' | 'dedicated_csm_1h'): string {
  switch (tier) {
    case 'email_48h':
      return 'Email · 48h target';
    case 'email_slack_12h':
      return 'Email + Slack Connect · 48h target';
    case 'dedicated_csm_1h':
      return 'Email + Slack Connect · 48h target';
  }
}

function fmtCustomArchetypeDev(level: 'none' | 'limited' | 'unlimited'): string {
  switch (level) {
    case 'none':
      return '—';
    case 'limited':
      return 'Limited (1/yr)';
    case 'unlimited':
      return 'Unlimited';
  }
}
---

<BaseLayout
  title="Self-Hosted"
  description="Run Driftstack on your own infrastructure. Privacy-required workloads, sustained high-concurrency operations, full data sovereignty. Contact Sales for early access; GA within 6 months of API public launch."
>
  <!-- Header -->
  <section class="relative overflow-hidden bg-gradient-to-b from-surface-base to-surface-raised">
    {/* 2026-05-22 — hero-glow atmosphere matches the rest of the site. */}
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Self-hosted</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
        <span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">
          Run Driftstack on your own infrastructure.
        </span>
      </h1>
      <p class="mt-6 max-w-prose text-lg text-ink-secondary">
        Same SDK, same archetypes, same iPhone Safari fidelity — just running
        on hardware you own and inside a network you control. Driftstack
        handles the orchestration, you handle the metal. Any Apple
        Silicon Mac works; the SKU you choose maps to how many concurrent
        sessions you need to run at once, not a software-feature ladder.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="mailto:sales@driftstack.dev?subject=Self-Hosted%20inquiry" class="btn-primary"
          >Contact sales</a
        >
        <a href="/pricing#self-hosted" class="btn-secondary">See pricing</a>
      </div>
      <p class="mt-3 text-xs text-ink-muted">
        Available "Contact Sales" from day 0. Self-hosted GA within 6 months
        of API public launch.
      </p>
    </div>
  </section>

  <!-- Architecture diagram -->
  <section class="border-t border-white/10 bg-surface-base">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Architecture</p>
      <h2
        class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight text-ink-primary md:text-4xl"
        style="letter-spacing: -0.02em;"
      >
        Two boxes. One secure channel. Your hardware, our orchestration.
      </h2>
      <p class="mt-6 max-w-prose text-base text-ink-secondary">
        Self-hosted is one piece of Driftstack software running on Mac
        hardware you own. The control plane orchestrates sessions, exposes
        the SDK + GUI, and never holds your session content.
      </p>

      <div
        class="mt-10 overflow-x-auto rounded-lg border border-white/10 bg-surface-inset p-8 font-mono text-sm leading-6 text-ink-primary"
      >
        <pre class="whitespace-pre">{`  YOUR INFRA                                 DRIFTSTACK ORCHESTRATION
  ──────────                                 ────────────────────────

  ┌──────────────────┐                       ┌──────────────────────┐
  │  Mac fleet       │ ◀──── secure ───────▶ │  Control plane       │
  │  (M4 / Studio /  │       channel         │  (license, API keys, │
  │   multi-node)    │       (HTTPS)         │   session metadata)  │
  └──────────────────┘                       └──────────────────────┘
        │
        │  WebKit sessions exit via your network
        ▼
  ┌──────────────────┐
  │  Your network    │
  │  egress          │
  │  (DC / VPN /     │
  │   BYO SOCKS5 +   │
  │   OpenVPN + WG)  │
  └──────────────────┘`}</pre>
      </div>

      <p class="mt-6 max-w-prose text-sm text-ink-muted">
        Session content (URLs, form data, captures, recordings) stays inside
        your network. Driftstack's control plane sees license + session
        metadata, never the session itself.
      </p>
    </div>
  </section>

  <!-- When self-hosted makes sense -->
  <section class="border-t border-white/10 bg-surface-raised">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">When self-hosted is the right call.</span></h2>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 11.8 4.2-1.1 8-6.3 8-11.8V5l-8-3z" />
            </svg>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Privacy</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-primary">Sessions never leave your perimeter</h3>
          <p class="mt-3 text-sm text-ink-secondary">
            For workloads where session content (URLs, form data, captures,
            recordings) must not transit any vendor infrastructure beyond
            your own. Self-hosted runs the WebKit engine + control plane on
            your Mac mini / Mac Studio; nothing leaves your network.
          </p>
        </div>
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" />
            </svg>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Volume</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-primary">
            Sustained high-concurrency operations
          </h3>
          <p class="mt-3 text-sm text-ink-secondary">
            When your fleet runs at consistently high concurrent-session
            counts (sustained 10+ concurrent across the month), owned
            hardware unit economics flip favorably against equivalent
            cloud-tier subscriptions. We'll model the break-even with your
            team based on your actual concurrency profile.
          </p>
        </div>
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-glow-red/10 ring-1 ring-glow-red/30 text-glow-red mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Sovereignty</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-primary">Full control over recordings + state</h3>
          <p class="mt-3 text-sm text-ink-secondary">
            Recordings, screenshots, request artefacts — all stored on your
            own R2-compatible bucket (or local NAS) with retention policies
            you set. No Driftstack-side copies, no shared sub-processor
            access, no DPA addendum required for your security review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SKU comparison -->
  <section class="border-t border-white/10 bg-surface-base">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">Three configurations.</span></h2>
      <p class="mt-3 max-w-prose text-ink-secondary">
        Each SKU pairs a Mac configuration with a Driftstack license tier.
        Hardware is customer-purchased; Driftstack provisions the control
        plane + orchestration layer on your gear.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {SELF_HOSTED_SKUS.map((sku) => (
          <div class="rounded-lg border border-white/10 bg-surface-raised p-6 shadow-sm">
            <h3 class="text-xl font-semibold text-ink-primary">{sku.name}</h3>
            <div class="mt-4">
              {sku.monthlyUsd === null ? (
                <div>
                  <span class="text-3xl font-semibold text-ink-primary">
                    from {fmtUsd(sku.annualMonthlyEquivalentUsd)}
                  </span>
                  <span class="text-sm font-normal text-ink-muted">/mo</span>
                  <div class="text-xs text-ink-muted">annual contract only</div>
                </div>
              ) : (
                <div>
                  <span class="text-3xl font-semibold text-ink-primary">
                    {fmtUsd(sku.monthlyUsd)}
                  </span>
                  <span class="text-sm font-normal text-ink-muted">/mo</span>
                  <div class="text-xs text-ink-muted">
                    or {fmtUsd(sku.annualMonthlyEquivalentUsd)}/mo billed annually
                  </div>
                </div>
              )}
            </div>
            <dl class="mt-6 space-y-3 text-sm">
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Hardware</dt>
                <dd class="text-right text-ink-primary">{HARDWARE_BY_SKU[sku.id]}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Browser profiles</dt>
                <dd class="text-right text-ink-primary">
                  {sku.profilesMax === null ? 'Unlimited' : sku.profilesMax.toString()}
                </dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Archetypes</dt>
                <dd class="text-right text-ink-primary">{fmtArchetypes(sku.archetypesMax)}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Software updates</dt>
                <dd class="text-right text-ink-secondary">{SELF_HOSTED_SOFTWARE_UPDATES[sku.id]}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Archetype updates</dt>
                <dd class="text-right text-ink-secondary">{SELF_HOSTED_ARCHETYPE_UPDATES[sku.id]}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Source code access</dt>
                <dd class="text-right text-ink-secondary">{SELF_HOSTED_SOURCE_ACCESS[sku.id]}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Custom archetype dev</dt>
                <dd class="text-right text-ink-secondary">
                  {fmtCustomArchetypeDev(sku.customArchetypeDevelopment)}
                </dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Source escrow</dt>
                <dd class="text-right text-ink-secondary">{sku.sourceEscrow ? 'Yes' : 'No'}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Support</dt>
                <dd class="text-right text-ink-secondary">{fmtSupportTier(sku.supportTier)}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
                <dt class="text-ink-muted">Minimum term</dt>
                <dd class="text-right text-ink-primary">{sku.minimumTermMonths.toString()}-month</dd>
              </div>
            </dl>
            <p class="mt-3 text-xs text-ink-muted">
              Concurrent capacity is bounded by your hardware, not by license.
            </p>
            <a href={sku.ctaHref} class="btn-primary mt-6 w-full">Contact sales</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="border-t border-white/10 bg-surface-raised">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">How it works.</span></h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-4">
        <li>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">01</p>
          <h3 class="mt-3 font-semibold text-ink-primary">Contact sales</h3>
          <p class="mt-2 text-sm text-ink-secondary">
            Email <a href="mailto:sales@driftstack.dev" class="text-glow-red underline">sales@driftstack.dev</a> with workload shape + concurrent-session profile.
            We'll model fit + break-even.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">02</p>
          <h3 class="mt-3 font-semibold text-ink-primary">Procure hardware</h3>
          <p class="mt-2 text-sm text-ink-secondary">
            You buy the Mac configuration matching your SKU — Mini M4, Studio
            M4 Max, or Studio Ultra / Mac Pro / multi-node. We provide
            provisioning specs.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">03</p>
          <h3 class="mt-3 font-semibold text-ink-primary">Onboard</h3>
          <p class="mt-2 text-sm text-ink-secondary">
            We deploy the Driftstack stack to your hardware, wire your team
            to the admin console, run a joint smoke test against your
            workload.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">04</p>
          <h3 class="mt-3 font-semibold text-ink-primary">Run</h3>
          <p class="mt-2 text-sm text-ink-secondary">
            Same SDK as cloud Driftstack — change one config field and your
            existing code points at the self-hosted control plane. Support
            via the SLA matching your SKU.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- FAQ teaser -->
  <section class="border-t border-white/10 bg-surface-base">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-8 md:grid-cols-2 md:items-center">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-glow-red">Common questions</p>
          <h2 class="mt-3 text-2xl font-semibold"><span class="bg-gradient-to-br from-ink-primary via-ink-primary to-glow-red bg-clip-text text-transparent">What about updates? Compliance? SLAs?</span></h2>
          <p class="mt-3 max-w-prose text-ink-secondary">
            See the FAQ for the standard answers, or email us with the
            specific question your security / procurement / compliance team
            is asking. We answer everything in writing.
          </p>
        </div>
        <div class="flex gap-3">
          <a href="/faq" class="btn-secondary">See FAQ</a>
          <a href="mailto:sales@driftstack.dev?subject=Self-Hosted%20inquiry" class="btn-primary">Email sales</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
