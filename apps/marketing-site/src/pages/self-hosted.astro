---
// Self-hosted v2 (2026-07-03) — "Plain Words, Same Teeth" pass: Band-A
// hero (plain why-self-host opening in the homepage §12 register), Fleet
// v2 recipes (PageHero/Section/Card/IconTile/CtaBand, AA-safe accent
// text). SKU data binding, prices, the ASCII architecture diagram and
// every substantive claim are byte-identical to the pre-redesign page.
// 2026-09-15 what-ships pass — the support line now renders per SKU from
// pricing.ts (Self-Hosted Enterprise = dedicated account manager + the
// contractual 1h Severity-1 first-reply SLA, Terms §9.2; pricing.astro's
// mirror of fmtSupportTier says the same, pinned cross-page); the hero
// names the engine the house-style way; the Run step lists what the
// desktop app and the account each include; a target-vs-SLA gloss sits
// under the SKUs. Deployment model corrected the same day: the customer
// runs the Driftstack server on their own Macs (apps/docs license-
// activation.md, Terms §3, docs/runbooks/self-hosted-mac-local.md); no
// code reports a license or session details to a Driftstack-hosted
// service, so the page no longer describes one. Second pass: the Run
// step no longer credits the desktop app with snapshots (no surface in
// apps/gui-client/src; v1 captures device + name, API only) and scopes
// export/import to a profile's settings (routes/profiles.ts export is
// metadata-only).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import IconTile from '../components/IconTile.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  SELF_HOSTED_ARCHETYPE_UPDATES,
  SELF_HOSTED_SKUS,
  SELF_HOSTED_SOFTWARE_UPDATES,
  SELF_HOSTED_SOURCE_ACCESS,
} from '../data/pricing.ts';

// 2026-05-19 founder verdict — hardware is OPTIONAL within the
// Apple-Silicon family. Any M-series Mac works; the per-SKU rows
// below are recommended-spec hints sized for the SKU's expected
// concurrent workload. Customers running fewer concurrent sessions
// can use a smaller Mac without penalty; customers needing many
// concurrent sessions need bigger / more Macs (real differentiation).
const HARDWARE_BY_SKU: Record<string, string> = {
  self_hosted_solo: 'Any Apple Silicon Mac (Mac Mini M4 16 GB recommended)',
  self_hosted_pro: 'A larger Apple Silicon Mac for running many sessions at once (Mac Studio M4 Max recommended)',
  self_hosted_enterprise: 'Several Apple Silicon Macs (Mac Studio Ultra / Mac Pro recommended)',
};

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtArchetypes(max: number | null): string {
  if (max === null) return 'All available + custom device profiles';
  return max === 1 ? '1 device profile' : `${max.toString()} device profiles`;
}

// 2026-05-19 founder verdict — no tiered reply ladder below the
// contractual tiers: Solo and Pro state the support channel plus the
// honest operational 48h target (Terms §9.1 — no contractual SLA;
// Slack Connect on Pro). 2026-09-15 — Self-Hosted Enterprise
// (`dedicated_csm_1h`) states exactly the grant pricing.ts gives the
// Enterprise tier: a dedicated account manager and the contractual 1h
// first-reply SLA on Severity-1 incidents (Terms §9.2). Until today all
// three SKUs rendered the same '48h target' string, contradicting
// pricing.ts and the /pricing Enterprise row.
function fmtSupportTier(tier: 'email_48h' | 'email_slack_12h' | 'dedicated_csm_1h'): string {
  switch (tier) {
    case 'email_48h':
      return 'Email · 48h target';
    case 'email_slack_12h':
      return 'Email + Slack Connect · 48h target';
    case 'dedicated_csm_1h':
      return 'Dedicated account manager · 1h SLA for first reply on critical (Severity-1) incidents';
  }
}

function fmtCustomArchetypeDev(level: 'none' | 'limited' | 'unlimited'): string {
  switch (level) {
    case 'none':
      return '—';
    case 'limited':
      return 'Limited (1/yr)';
    case 'unlimited':
      return 'Unlimited';
  }
}
---

<BaseLayout
  title="Self-Hosted"
  description="Run Driftstack on Macs you own, with guided setup from our team — for work that must stay inside your network, for running many sessions at once, and for full control of your data."
>
  <!-- Hero — Band A: the plain why-self-host sentence leads, the
       technical substance rides underneath. -->
  <PageHero label="Self-hosted" title="Run Driftstack on hardware you own.">
    <p class="mt-5 max-w-2xl text-lg leading-8 text-tk-ink-2">
      Some work can't leave your building. If your sessions carry data
      that must stay inside your own network, if your security team
      needs to own every machine involved, or if you run enough
      concurrent sessions that renting stops making sense — run the
      whole thing on Macs you own.
    </p>
    <p class="mt-4 max-w-2xl text-base leading-7 text-tk-ink-2">
      Same SDK, same desktop app, and device profiles from the same
      catalog — a build of Apple's own WebKit, the engine family behind
      iPhone Safari, checked against real iPhones — just running on
      hardware you own and inside a network you control.
      The Driftstack server that starts and manages your sessions runs
      on your Macs as well, with the desktop app pointed at it; we
      install and set it up with you. Any Apple Silicon Mac works;
      the package you choose (the SKU) is about how many sessions you
      need running at once, not about unlocking software features.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="mailto:sales@driftstack.dev?subject=Self-Hosted%20inquiry" class="btn-primary"
        >Contact sales</a
      >
      <a href="/pricing/#self-hosted" class="btn-secondary">See pricing</a>
    </div>
    <p class="mt-4 text-sm text-tk-ink-2">
      Self-hosted is set up together with our sales team, step by step.
      We check that the work is a good fit, plan the hardware and
      network, install and set up your deployment, and run a first
      live test with your team.
    </p>
    <p class="mt-2 font-mono text-xs text-tk-ink-3">
      Available now through Contact Sales · scoped and supported directly
    </p>
  </PageHero>

  <!-- Architecture diagram -->
  <Section
    label="Architecture"
    title="Your hardware, our software, one secure connection."
  >
    <p class="mt-4 max-w-2xl text-base leading-7 text-tk-ink-2">
      Self-hosted is the whole of Driftstack running on Mac hardware
      you own: the server that starts and manages sessions, the desktop
      app pointed at it, and the sessions themselves. We supply the
      software, its updates and new device profiles, and the developer
      kit (SDK) — and we never hold what happens inside your sessions.
    </p>

    <div class="panel mt-10 overflow-x-auto p-8 font-mono text-sm leading-6 text-tk-ink">
      <pre class="whitespace-pre">{`  YOUR MACS                                  DRIFTSTACK
  ─────────                                  ──────────

  ┌──────────────────┐                       ┌──────────────────────┐
  │  Your Macs       │ ◀──── secure ───────▶ │  Driftstack          │
  │  (Mac mini or    │     connection        │  (software releases, │
  │   Mac Studio,    │       (HTTPS)         │   device-profile     │
  │   one or more)   │                       │   updates)           │
  │                  │                       └──────────────────────┘
  │  Driftstack      │
  │  server, desktop │
  │  app, sessions   │
  └──────────────────┘
        │
        │  Sessions reach the web through your network
        ▼
  ┌──────────────────┐
  │  Your network    │
  │  exit            │
  │  (direct, VPN,   │
  │   or your own    │
  │   SOCKS5 /       │
  │   OpenVPN /      │
  │   WireGuard)     │
  └──────────────────┘`}</pre>
    </div>

    <p class="mt-6 max-w-prose text-sm text-tk-ink-3">
      Session content (URLs, form data, captures, recordings) stays inside
      your network, and so does the record of your sessions — when one
      started, which profile ran — because the server that keeps it is
      yours. Driftstack holds no copy of either. Crash reporting in the
      desktop app is off by default when the app points at a self-hosted
      server.
    </p>
  </Section>

  <!-- When self-hosted makes sense -->
  <Section label="Why self-host" title="When self-hosted is the right call." class="bg-tk-surface">
    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 11.8 4.2-1.1 8-6.3 8-11.8V5l-8-3z" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Privacy</p>
        <h3 class="mt-3 text-xl font-semibold text-tk-ink">Sessions never leave your network</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          For work where session content (URLs, form data, captures,
          recordings) must never pass through anyone's servers but
          your own. Self-hosted runs the browser and the Driftstack
          software on your own Mac mini or Mac Studio; session content
          never leaves your network.
        </p>
      </div>
      <div>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Volume</p>
        <h3 class="mt-3 text-xl font-semibold text-tk-ink">
          Running many sessions at once, consistently
        </h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          When you consistently run many sessions at once (10 or more,
          sustained through a whole month), owning the hardware works
          out cheaper than renting the equivalent cloud plan. We'll work out with your team, from your actual
          usage — how many sessions you run at once, and for how long
          — the exact point where buying beats renting (the
          break-even).
        </p>
      </div>
      <div>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Sovereignty</p>
        <h3 class="mt-3 text-xl font-semibold text-tk-ink">Full control over recordings and saved files</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          Recordings, screenshots, and saved files all live on storage
          you own — an S3-compatible cloud bucket or a network drive —
          and you decide how long anything is kept. Driftstack keeps no
          copies and no outside vendor has access, so there is no extra
          data-processing agreement to add to your security review.
        </p>
      </div>
    </div>
  </Section>

  <!-- SKU comparison -->
  <Section
    label="Configurations"
    title="Three configurations."
    lead="Each package (SKU) pairs a Mac configuration with a Driftstack license tier. You buy the hardware; we install and set up the Driftstack software on it."
  >
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {SELF_HOSTED_SKUS.map((sku) => (
        <div class="card p-6">
          <h3 class="text-xl font-semibold text-tk-ink">{sku.name}</h3>
          <div class="mt-4">
            {sku.monthlyUsd === null ? (
              <div>
                <span class="text-3xl font-semibold text-tk-ink">
                  from {fmtUsd(sku.annualMonthlyEquivalentUsd)}
                </span>
                <span class="text-sm font-normal text-tk-ink-3">/mo</span>
                <div class="text-xs text-tk-ink-3">annual contract only</div>
              </div>
            ) : (
              <div>
                <span class="text-3xl font-semibold text-tk-ink">
                  {fmtUsd(sku.monthlyUsd)}
                </span>
                <span class="text-sm font-normal text-tk-ink-3">/mo</span>
                <div class="text-xs text-tk-ink-3">
                  or {fmtUsd(sku.annualMonthlyEquivalentUsd)}/mo billed annually
                </div>
              </div>
            )}
          </div>
          <dl class="mt-6 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Hardware</dt>
              <dd class="text-right text-tk-ink">{HARDWARE_BY_SKU[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Browser profiles</dt>
              <dd class="text-right text-tk-ink">
                {sku.profilesMax === null ? 'Unlimited' : sku.profilesMax.toString()}
              </dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Device profiles</dt>
              <dd class="text-right text-tk-ink">{fmtArchetypes(sku.archetypesMax)}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Software updates</dt>
              <dd class="text-right text-tk-ink-2">{SELF_HOSTED_SOFTWARE_UPDATES[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Device profile updates</dt>
              <dd class="text-right text-tk-ink-2">{SELF_HOSTED_ARCHETYPE_UPDATES[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Source code access</dt>
              <dd class="text-right text-tk-ink-2">{SELF_HOSTED_SOURCE_ACCESS[sku.id]}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Custom device profiles built for you</dt>
              <dd class="text-right text-tk-ink-2">
                {fmtCustomArchetypeDev(sku.customArchetypeDevelopment)}
              </dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Source-code escrow (a third party holds a copy)</dt>
              <dd class="text-right text-tk-ink-2">{sku.sourceEscrow ? 'Yes' : 'No'}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Support</dt>
              <dd class="text-right text-tk-ink-2">{fmtSupportTier(sku.supportTier)}</dd>
            </div>
            <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
              <dt class="text-tk-ink-3">Minimum term</dt>
              <dd class="text-right text-tk-ink">{sku.minimumTermMonths.toString()}-month</dd>
            </div>
          </dl>
          <p class="mt-3 text-xs text-tk-ink-3">
            How many sessions can run at once depends on your hardware, not your license.
          </p>
          <a href={sku.ctaHref} class="btn-primary mt-6 w-full">Contact sales</a>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-prose text-xs text-tk-ink-3">
      "Target" is the reply time we aim for, not a contractual promise
      (Terms §9.1). "SLA" is a contractual promise: on Self-Hosted
      Enterprise it covers our first reply to the most serious
      ("Severity-1") incidents (Terms §9.2).
    </p>
  </Section>

  <!-- Process -->
  <Section label="Process" title="How it works." class="bg-tk-surface">
    <ol class="mt-10 grid gap-8 md:grid-cols-4">
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">01</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Contact sales</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          Email <a href="mailto:sales@driftstack.dev" class="text-tk-accent-text underline">sales@driftstack.dev</a> with what the work is and how many
          sessions you need going at once. We'll set out in writing
          whether self-hosting fits and where owning beats renting.
        </p>
      </li>
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">02</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Procure hardware</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          You buy the Mac configuration matching your package — Mac mini
          M4, Mac Studio M4 Max, or Mac Studio Ultra / Mac Pro / several
          Macs for larger setups. We tell you exactly what to buy and
          how to set it up.
        </p>
      </li>
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">03</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Onboard</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          We install the Driftstack software on your hardware, set up
          your team's accounts and roles, and run a first live test
          together on your real workload.
        </p>
      </li>
      <li>
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </IconTile>
        <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">04</p>
        <h3 class="mt-3 font-semibold text-tk-ink">Run</h3>
        <p class="mt-2 text-sm text-tk-ink-2">
          Same SDK as cloud Driftstack — change one setting and your
          existing code talks to your own installation instead of our
          cloud. The desktop app is the same as well: profiles with a
          recycle bin and export/import of their settings as a file, and a
          proxy or VPN attached per profile, with a Test readout before
          you launch. Your account keeps team roles, an audit log you
          can export as CSV, and two-factor sign-in. Support channels
          and response targets match the package you chose.
        </p>
      </li>
    </ol>
  </Section>

  <!-- FAQ teaser -->
  <Section label="Common questions" title="What about updates? Compliance? SLAs?">
    <p class="mt-4 max-w-2xl text-base leading-7 text-tk-ink-2">
      See the FAQ for the standard answers, or email us with the
      specific question your security / procurement / compliance team
      is asking. We answer everything in writing.
    </p>
    <div class="mt-8">
      <a href="/faq/" class="btn-secondary">See FAQ</a>
    </div>
  </Section>

  <!-- Final CTA -->
  <CtaBand
    title="Talk to us about self-hosting."
    lead="Email what you're running — what the work is and how many sessions you need going at once — and we'll set out in writing whether self-hosting fits and where owning beats renting."
    primaryHref="mailto:sales@driftstack.dev?subject=Self-Hosted%20inquiry"
    primaryLabel="Contact sales"
    secondaryHref="/pricing/#self-hosted"
    secondaryLabel="See pricing"
  />
</BaseLayout>
