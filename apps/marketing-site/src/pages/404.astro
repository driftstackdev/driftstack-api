---
// Fleet v2 (2026-07-03) — "This page drifted off." 404 with a useful-links
// row (home / pricing / docs / status). Deliberately tiny and dependency-
// free: BaseLayout + recipe classes, no components, no scripts.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · Driftstack" description="Page not found." noindex>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-glow-radial-accent opacity-60" aria-hidden="true"></div>
    <div class="absolute inset-0 grid-bg opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-32 text-center animate-fade-up">
      <p class="section-label">404</p>
      <h1 class="mt-6 text-5xl font-semibold tracking-tight text-tk-ink md:text-6xl">
        This page drifted off.
      </h1>
      <p class="mt-6 max-w-prose mx-auto text-tk-ink-2 leading-relaxed">
        The page you were looking for has moved, doesn't exist, or never did.
        If you typed a URL by hand, double-check the spelling. If you got
        here from a link on driftstack.dev, drop us a line at
        <a href="mailto:support@driftstack.dev" class="text-tk-accent-text underline underline-offset-4">support@driftstack.dev</a> —
        we'll fix it.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">Back home</a>
        <a href="/pricing" class="btn-secondary">See pricing</a>
        <a href="/docs" class="btn-secondary">Read the docs</a>
        <a href="https://status.driftstack.dev" class="btn-secondary" rel="noopener noreferrer"
          >System status</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
