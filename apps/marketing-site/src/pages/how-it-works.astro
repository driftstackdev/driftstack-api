---
// /how-it-works (2026-07-03, S14 / D8) — the zero-code explainer for
// non-technical buyers. Band A only: the homepage's three steps,
// expanded; profile · session · proxy in the same metaphors the
// pricing page and faq.ts use (saved iPhone identity / browser tabs /
// your own internet exit); a short desktop-app walkthrough showing the
// REAL Profiles view (2026-09-11: a capture of the app's own components
// via AppScreen.astro — the compact hand-drawn fleet strip it replaces had
// drifted from the app; no invented UI). Hard rule: NO code blocks on
// this page — the developer story lives on /use-cases/qa-testing and the
// docs. The homepage hero's "#how-it-works" anchor CTA is untouched —
// that stays an in-page anchor; this page is the nav-level entry.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import IconTile from '../components/IconTile.astro';
import CtaBand from '../components/CtaBand.astro';
import AppScreen from '../components/AppScreen.astro';
import AgentPlanDemo from '../components/AgentPlanDemo.astro';
import FingerprintDemo from '../components/FingerprintDemo.astro';
import ProxyHealthDemo from '../components/ProxyHealthDemo.astro';
import profilesGridScreen from '../assets/screens/profiles-grid.png';
import { ARCHETYPE_REGISTRY, LOCKED_ARCHETYPE_ID } from '@driftstack/api-types';
import { DEVICE_SUPPORT } from '../data/capabilities';

// 2026-09-16 readability pass ("how it READS"): Band A sentences split to one
// idea each (aim <= 20 words, never two em-dash asides in one sentence), the
// benefit stated before the mechanism, and every term explained in the sentence
// that uses it or linked to /glossary (proxy, VPN). The precise device row and
// the two technical panels (FingerprintDemo, ProxyHealthDemo) keep their
// precision — only their INTRO sentences were made plain. No fact, number,
// limit or disclosure changed; every pinned phrase is intact.
// 2026-09-16 (verifier fixes, same pass):
//   • The Proxy panel states that YOU bring the connection before it names any
//     example city. Driftstack supplies no exits of its own — you attach your
//     own proxy or VPN — and a benefit sentence left standing a full sentence
//     ahead of that qualifier reads as a closed list of exits we provide.
//   • The proxy-health intro sells the reading and its last-checked timestamp,
//     never pre-session failure detection. A check can be stale — the same
//     paragraph says so — and a stale check is precisely the case where a dead
//     connection surfaces mid-session instead.
// 2026-09-15 — the default device and the catalog counts are READ at build
// time (the same bindings FingerprintDemo and the homepage use), so this page
// cannot quote a default or a count the product stopped shipping. A missing
// registry entry fails the build instead of falling back to a typed-out label.
const lockedDevice = ARCHETYPE_REGISTRY.find((a) => a.id === LOCKED_ARCHETYPE_ID);
if (!lockedDevice) {
  throw new Error(`how-it-works: default device ${LOCKED_ARCHETYPE_ID} is not in the registry`);
}
const DEFAULT_DEVICE = lockedDevice.displayLabel;

// The model count is DERIVED from the selectable rows the same way. The catalog
// names specific iPhone models between its endpoints (19 today — there is no
// iPhone SE, 16e or Air profile), so the copy says "N iPhone models, iPhone 13 →
// 17 Pro Max" and never "every iPhone" in that span: that sentence would promise
// models the registry does not carry.
const DEVICE_MODEL_COUNT = new Set(
  ARCHETYPE_REGISTRY.filter((a) => a.status === 'launch' || a.status === 'available').map(
    (a) => a.device,
  ),
).size;

// What the cockpit capture SHOWS, in plain words (Band A: cities spelled
// out, no protocol jargon). The capture is the source of truth — the alt
// describes the picture and claims nothing beyond it.
const COCKPIT_ALT =
  'The Driftstack desktop app, Profiles view: eight iPhone profile cards, each a ' +
  'small phone showing its name — amsterdam shopper, tokyo sneakers, london ' +
  'checkout, paris fashion and more — the iPhone it runs as, whether it is Live ' +
  'or Idle, the city it browses from (Amsterdam, Tokyo, Zurich, Berlin, London, ' +
  'Paris) and a Launch button, with the app\'s sidebar on the left.';
---

<BaseLayout
  title="How it works"
  description="The whole product in three steps, with no code anywhere. Pick an iPhone profile, start a session in the cloud, then drive it yourself, from code, or in plain English with the built-in AI agent (Team plans and up, and every API plan)."
  ogImage="/og/how-it-works-light.png"
>
  <PageHero
    label="How it works"
    title="Pick a profile. Start a session. Drive it your way."
    lead="Here is the whole product, in three steps. There is no code anywhere on this page. Five minutes here and the rest of the site makes sense."
  />

  <Section
    label="Three words first"
    title="Learn three words and everything else makes sense."
  >
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <div class="panel">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Profile</p>
        <p class="mt-3 text-sm leading-6 text-tk-ink-2">
          A <strong class="text-tk-ink">saved iPhone identity</strong> that
          keeps its logins and history. Close it tonight and open it tomorrow.
          To a website it is the same phone coming back, not a stranger.
        </p>
      </div>
      <div class="panel">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Session</p>
        <p class="mt-3 text-sm leading-6 text-tk-ink-2">
          A profile, running live. It is a real iPhone browser in the cloud
          with that identity loaded.
          <strong class="text-tk-ink">Concurrent</strong> is the word for
          sessions running at the same time — think browser tabs. It is the
          one number your plan is priced on.
        </p>
      </div>
      <div class="panel">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Proxy</p>
        <p class="mt-3 text-sm leading-6 text-tk-ink-2">
          Your session's <strong class="text-tk-ink">own internet exit</strong>
          — the connection it browses through. You bring that connection.
          Attach one per profile and that phone browses from wherever your
          connection comes out: Amsterdam, New York, Tokyo. Not from a data
          center. Use a
          <a href="/glossary/#proxy" class="accent-link">proxy</a>
          you already have (the SOCKS5 kind), or on paid plans a
          <a href="/glossary/#vpn" class="accent-link">VPN</a>
          file (OpenVPN or WireGuard).
        </p>
      </div>
    </div>
    <p class="mt-8 text-sm text-tk-ink-3">
      Every other term on this site is one honest paragraph away in the
      <a href="/glossary/" class="accent-link">glossary</a>.
    </p>
  </Section>

  <Section
    label="The three steps"
    title="From nothing to a live iPhone, in minutes."
  >
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <Card title="Pick an iPhone profile">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">1</span></IconTile>
        Start with the default iPhone, {DEFAULT_DEVICE}. Or pick any of the
        {DEVICE_SUPPORT.selectableCount} device profiles —
        {DEVICE_MODEL_COUNT} iPhone models, {DEVICE_SUPPORT.deviceFamilies}.
        The free tier starts you on an iPhone 13 or 13 mini. Make one profile
        per account, per client, or per job. Each one remembers its logins,
        cookies and history across every run. Set it up once and it stays
        set up.
      </Card>
      <Card title="Start a session">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">2</span></IconTile>
        One click in the desktop app opens a real iPhone browser in the cloud,
        ready in seconds. There is no hardware to buy and no phone to set up.
        It appears in its own floating window, already being the profile you
        picked. Developers get the same thing from one API call.
      </Card>
      <Card title="Drive it your way">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">3</span></IconTile>
        Tap, swipe, scroll and type yourself, exactly like any phone. When a
        job is repetitive, describe it in plain English and the built-in AI
        agent drives while you watch (Team plans and up, and every API plan).
        If your team writes code, the same sessions can be driven from code
        instead. That story is on the
        <a href="/use-cases/qa-testing/" class="accent-link">QA page</a>.
      </Card>
    </div>
  </Section>

  <Section
    label="What “the agent drives” means"
    title="You can read every step before it runs."
  >
    <p class="mt-6 max-w-prose text-tk-ink-2">
      You describe the job in plain English. The agent turns it into a short list of
      actions and runs them on the phone. It can only pick from a fixed set of
      actions, and it cannot invent new ones. So you can read what it is about to
      do before it happens. You can read it again afterwards, in the session
      history. A step that looks like a purchase, a
      payment, or an account deletion stops and waits for your approval. The
      screenshots the agent takes land in the transcript as it goes.
      The agent is included on Team plans and up, and on every API plan.
    </p>
    <AgentPlanDemo />
    <p class="max-w-prose text-tk-ink-2">
      The third step in that list has no equivalent in an ordinary automation tool.
      <span class="text-tk-ink">Pausing is an action.</span> The agent waits the way
      a person reading that much text would wait. The pace comes from the profile it
      is running as. A real browser on a real device is only convincing if it
      spends time like one.
    </p>
  </Section>

  <Section
    label="What the device looks like"
    title="A real profile, matched detail by detail."
  >
    <p class="mt-6 max-w-prose text-tk-ink-2">
      Your session gives a website's hidden checks the answers a real iPhone gives.
      A website never simply asks what browser you are. It quietly measures a dozen
      small things and checks whether the answers fit together. Driftstack takes those
      answers from a real device profile instead of making them up at random. That is
      why they agree with each other. Answers picked at random disagree in exactly the
      ways a detector looks for.
    </p>
    <FingerprintDemo />
    <p class="max-w-prose text-tk-ink-2">
      The device profile shown above is Driftstack's default iPhone, with the iOS and
      Safari versions it runs today. It is one of {DEVICE_SUPPORT.selectableCount}
      device profiles you can choose from: {DEVICE_MODEL_COUNT} iPhone models,
      {DEVICE_SUPPORT.deviceFamilies}, on iOS 18, with Safari
      {DEVICE_SUPPORT.safariVersions}. Each one is matched to an iPhone Apple
      really shipped.
    </p>
  </Section>

  <Section
    label="Proxy health you can see"
    title="A proxy that stops working says so."
  >
    <p class="mt-6 max-w-prose text-tk-ink-2">
      This is where you see whether each connection is still working — and when it
      was last checked. Driftstack checks every proxy and shows you the result. If a
      proxy fails, you see why. If a check is old, it is marked out of date rather
      than shown as current. So you know your proxy works instead of assuming it.
    </p>
    <p class="mt-5 max-w-prose text-tk-ink-2">
      The Test button also reports the proxy's response time, the country and city it
      exits from, and whether WebRTC and HTTP/3 can travel through it. On a proxy that
      can't carry HTTP/3, Driftstack switches HTTP/3 off rather than letting it leak.
    </p>
    <ProxyHealthDemo />
  </Section>

  <Section
    label="The cockpit"
    title="One window for all your phones."
    lead="The desktop app keeps every iPhone one click away. Each profile is a little phone card. At a glance you can see whether it is running and which city it browses from."
  >
    <div class="mt-10 grid gap-10 md:grid-cols-2 md:items-center">
      <!-- The REAL Profiles view — a capture of the desktop app's own
           components with fixture data (see AppScreen.astro). Static
           picture, no live-session claim; the real copy beside it stays
           outside the decorative frame so it is still contrast-scanned. -->
      <AppScreen
        src={profilesGridScreen}
        alt={COCKPIT_ALT}
        sizes="(min-width: 768px) 552px, calc(100vw - 48px)"
      />
      <div class="space-y-4 text-base leading-7 text-tk-ink-2">
        <p>
          Profiles live in folders — by client, by region, by job — and tags
          cover anything folders don't. A green
          <strong class="text-tk-ready-text">Live</strong> dot means that phone
          is running right now, and the flag says which country it browses
          from. Click a card and the session pops out into its own floating
          device window. Two accounts sit side by side without sharing
          anything. Duplicate a profile in one click. Delete one and it waits
          in a recycle bin for 30 days in case you want it back. You can also
          record a session and replay it in the app later. Recordings stay on
          your own computer.
        </p>
        <p>
          Some tasks are pure repetition: check these listings, fill this form,
          collect these screenshots. Type what you want in plain English and
          the built-in AI agent drives while you watch (Team plans and up, and
          every API plan). Run it in pair mode and you can take over any time,
          mid-task, with one click, then hand back.
        </p>
      </div>
    </div>
  </Section>

  <CtaBand
    title="Try the whole loop in five minutes."
    lead="The free tier is the tour: one profile on an iPhone 13 or 13 mini, 20-minute sessions, no card required. Pick a profile, start a session, drive it. Then decide on your own terms."
    primaryHref="/pricing/#free"
    primaryLabel="Start free"
    secondaryHref="/pricing/"
    secondaryLabel="See pricing"
  />
</BaseLayout>
