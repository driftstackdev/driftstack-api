---
// /how-it-works (2026-07-03, S14 / D8) — the zero-code explainer for
// non-technical buyers. Band A only: the homepage's three steps,
// expanded; profile · session · proxy in the same metaphors the
// pricing page and faq.ts use (saved iPhone identity / browser tabs /
// your own internet exit); a short desktop-app walkthrough showing the
// REAL Profiles view (2026-09-11: a capture of the app's own components
// via AppScreen.astro — the compact hand-drawn fleet strip it replaces had
// drifted from the app; no invented UI). Hard rule: NO code blocks on
// this page — the developer story lives on /use-cases/qa-testing and the
// docs. The homepage hero's "#how-it-works" anchor CTA is untouched —
// that stays an in-page anchor; this page is the nav-level entry.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import IconTile from '../components/IconTile.astro';
import CtaBand from '../components/CtaBand.astro';
import AppScreen from '../components/AppScreen.astro';
import AgentPlanDemo from '../components/AgentPlanDemo.astro';
import FingerprintDemo from '../components/FingerprintDemo.astro';
import ProxyHealthDemo from '../components/ProxyHealthDemo.astro';
import profilesGridScreen from '../assets/screens/profiles-grid.png';

// What the cockpit capture SHOWS, in plain words (Band A: cities spelled
// out, no protocol jargon). The capture is the source of truth — the alt
// describes the picture and claims nothing beyond it.
const COCKPIT_ALT =
  'The Driftstack desktop app, Profiles view: eight iPhone profile cards, each a ' +
  'small phone showing its name — amsterdam shopper, tokyo sneakers, london ' +
  'checkout, paris fashion and more — the iPhone it runs as, whether it is Live ' +
  'or Idle, the city it browses from (Amsterdam, Tokyo, Zurich, Berlin, London, ' +
  'Paris) and a Launch button, with the app\'s sidebar on the left.';
---

<BaseLayout
  title="How it works"
  description="The whole product in three steps, no code anywhere: pick an iPhone profile, start a session in the cloud, and drive it yourself or in plain English."
  ogImage="/og/how-it-works.png"
>
  <PageHero
    label="How it works"
    title="Pick a profile. Start a session. Drive it your way."
    lead="The whole product in three steps — and not a line of code anywhere on this page. Five minutes here and the rest of the site reads itself."
  />

  <Section
    label="Three words first"
    title="Learn three words and everything else makes sense."
  >
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <div class="panel">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Profile</p>
        <p class="mt-3 text-sm leading-7 text-tk-ink-2">
          A <strong class="text-tk-ink">saved iPhone identity</strong> that
          keeps its logins and history. Close it tonight, open it tomorrow —
          to a website it's the same phone coming back, not a stranger.
        </p>
      </div>
      <div class="panel">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Session</p>
        <p class="mt-3 text-sm leading-7 text-tk-ink-2">
          A profile, running live — a real iPhone browser in the cloud with
          that identity loaded. <strong class="text-tk-ink">Concurrent</strong>
          means sessions running at the same time — think browser tabs — and
          it's the one number plans are priced on.
        </p>
      </div>
      <div class="panel">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Proxy</p>
        <p class="mt-3 text-sm leading-7 text-tk-ink-2">
          Your session's <strong class="text-tk-ink">own internet exit</strong>.
          Attach one per profile and that phone browses from its own corner of
          the world — Amsterdam, New York, Tokyo — instead of from a data
          center.
        </p>
      </div>
    </div>
    <p class="mt-8 text-sm text-tk-ink-3">
      Every other term on this site is one honest paragraph away in the
      <a href="/glossary/" class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">glossary</a>.
    </p>
  </Section>

  <Section
    label="The three steps"
    title="From nothing to a live iPhone, in minutes."
  >
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <Card title="Pick an iPhone profile">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">1</span></IconTile>
        Start with the default iPhone, or create your own. Make one per
        account, per client, or per job. Each profile remembers its logins,
        cookies, and history across every run — set it up once, and it stays
        set up.
      </Card>
      <Card title="Start a session">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">2</span></IconTile>
        One click in the desktop app and a real iPhone browser opens in the
        cloud, ready in seconds. No hardware to buy, nothing to install, no
        setup wizard — the phone appears in its own window, already being the
        profile you picked.
      </Card>
      <Card title="Drive it your way">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">3</span></IconTile>
        Tap, scroll, and type yourself, like any phone. When a task is
        repetitive, describe it in plain English and the built-in AI agent
        drives while you watch. And if your team writes code, the same sessions can be
        driven from it — that story lives on the
        <a href="/use-cases/qa-testing/" class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">QA page</a>.
      </Card>
    </div>
  </Section>

  <Section
    label="What &ldquo;the agent drives&rdquo; means"
    title="It plans in a fixed vocabulary, and you can read every step."
  >
    <p class="mt-6 max-w-prose text-tk-ink-2">
      Describe the job in plain English and the agent turns it into a short list of
      actions, then runs them on the phone. The list is not free-form: the agent
      picks from a closed set of verbs and cannot invent new ones, so what it is
      about to do is always something you can read before it happens &mdash; and
      afterwards, in the session history.
    </p>
    <AgentPlanDemo />
    <p class="max-w-prose text-tk-ink-2">
      The third step is the one that has no equivalent in a normal automation tool.
      <span class="text-tk-ink">Pausing is an action.</span> The agent waits the way
      a person reading that much text would wait, at the pace set by the profile it
      is running as &mdash; because a real browser on a real device is only
      convincing if it also spends time like one.
    </p>
  </Section>

  <Section
    label="What the device looks like"
    title="A real profile, matched axis by axis."
  >
    <p class="mt-6 max-w-prose text-tk-ink-2">
      A site does not ask what browser you are. It measures a dozen things and compares
      them. Driftstack matches those axes to a real device profile rather than
      randomising them, which is why the answers agree with each other &mdash; a
      randomised fingerprint is inconsistent in exactly the ways a detector looks for.
    </p>
    <FingerprintDemo />
    <p class="max-w-prose text-tk-ink-2">
      The device row above is read from the live archetype registry when this page is
      built, so it cannot quote a version the product stopped shipping.
    </p>
  </Section>

  <Section
    label="Egress you can see"
    title="A proxy that stops working says so."
  >
    <p class="mt-6 max-w-prose text-tk-ink-2">
      Every proxy is probed and the result is kept with the time it was taken. A failure
      carries its reason, and a result that has aged past its window is shown as stale
      rather than quietly presented as current &mdash; the difference between knowing
      your egress works and assuming it.
    </p>
    <ProxyHealthDemo />
  </Section>

  <Section
    label="The cockpit"
    title="One window for the whole fleet."
    lead="The desktop app keeps every iPhone one click away. Here's the shape of it — each profile is a little phone card that tells you at a glance whether it's live, and where in the world it exits."
  >
    <div class="mt-10 grid gap-10 md:grid-cols-2 md:items-center">
      <!-- The REAL Profiles view — a capture of the desktop app's own
           components with fixture data (see AppScreen.astro). Static
           picture, no live-session claim; the real copy beside it stays
           outside the decorative frame so it is still contrast-scanned. -->
      <AppScreen
        src={profilesGridScreen}
        alt={COCKPIT_ALT}
        sizes="(min-width: 768px) 552px, calc(100vw - 48px)"
      />
      <div class="space-y-4 text-base leading-7 text-tk-ink-2">
        <p>
          Profiles live in folders — by client, by region, by job — with tags
          for anything folders don't cover. A green
          <strong class="text-tk-ready-text">Live</strong> dot means that phone is
          running right now; the flag says where it exits. Click a card and
          the session pops out into its own floating device window, so two
          accounts sit side by side without sharing anything.
        </p>
        <p>
          When a task is repetitive — check these listings, fill this form,
          collect these screenshots — type what you want in plain English and
          the built-in AI agent drives while you watch. You can take over any
          time, mid-task, with a click.
        </p>
      </div>
    </div>
  </Section>

  <CtaBand
    title="Try the whole loop in five minutes."
    lead="The free tier is the tour: one profile, 20-minute sessions, no card required. Pick a profile, start a session, drive it — and decide on your own terms."
    primaryHref="/pricing/#free"
    primaryLabel="Start free"
    secondaryHref="/pricing/"
    secondaryLabel="See pricing"
  />
</BaseLayout>
