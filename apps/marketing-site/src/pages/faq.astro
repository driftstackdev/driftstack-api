---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import { FAQ_GROUPS, faqGroupSlug, faqPlainText } from '../data/faq';

// Q&A content lives in src/data/faq.ts (single source of truth) — the
// rendered headings below and the FAQPage JSON-LD both derive from
// FAQ_GROUPS, so they can never diverge.
//
// W507 — schema.org FAQPage for rich-result eligibility (complements
// the site-wide @graph in BaseLayout). Strictly factual: every
// Question/acceptedAnswer pair is the exact on-page Q&A (answers
// tag-stripped via faqPlainText), no fabricated ratings or reviews.
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_GROUPS.flatMap((group) => group.entries).map((entry) => ({
    '@type': 'Question',
    name: entry.q,
    acceptedAnswer: { '@type': 'Answer', text: faqPlainText(entry.a) },
  })),
};
---

<BaseLayout
  title="FAQ"
  description="Common questions about Driftstack pricing, the free tier, tier upgrades, the bundled LLM, EU data residency, and support."
  ogImage="/og/faq.png"
>
  <PageHero label="FAQ" title="Frequently asked.">
    <p class="mt-5 max-w-2xl text-lg leading-8 text-tk-ink-2">
      If your question isn't answered here, email
      <a href="mailto:support@driftstack.dev" class="text-tk-accent-text underline"
        >support@driftstack.dev</a
      > or
      <a href="mailto:sales@driftstack.dev" class="text-tk-accent-text underline"
        >sales@driftstack.dev</a
      > — we answer everything in writing.
    </p>
  </PageHero>

  <section class="relative bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20 lg:grid lg:grid-cols-[240px_1fr] lg:gap-14">
      <!-- Sticky category side-nav (desktop only) — plain anchor list
           over the group headings below. -->
      <nav class="hidden lg:block" aria-label="FAQ categories">
        <div class="sticky top-24">
          <p class="section-label">Categories</p>
          <ul class="mt-4 space-y-1 border-l border-tk-border">
            {
              FAQ_GROUPS.map((group) => (
                <li>
                  <a
                    href={`#${faqGroupSlug(group.title)}`}
                    class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-sm text-tk-ink-2 transition-colors hover:border-tk-accent hover:text-tk-ink"
                  >
                    {group.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <div>
        {
          FAQ_GROUPS.map((group, i) => (
            <section class={i === 0 ? undefined : 'mt-16'}>
              <h2
                id={faqGroupSlug(group.title)}
                class="scroll-mt-24 text-2xl font-semibold tracking-tight text-tk-ink"
              >
                {group.title}
              </h2>
              <FaqList entries={group.entries} class="mt-6" />
            </section>
          ))
        }
      </div>
    </div>
  </section>

  {/* W507 — schema.org FAQPage (derived from the same FAQ_GROUPS the page renders). */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
</BaseLayout>
