  <!-- Monthly/Annual toggle script -->
  <script is:inline>
    (function () {
      const root = document.getElementById('billing-toggle');
      if (!root) return;
      const buttons = root.querySelectorAll('.billing-toggle-btn');
      const monthlyEls = document.querySelectorAll('[data-period-target="monthly"]');
      const annualEls = document.querySelectorAll('[data-period-target="annual"]');

      function setPeriod(period) {
        buttons.forEach((btn) => {
          btn.setAttribute(
            'aria-selected',
            btn.getAttribute('data-period') === period ? 'true' : 'false',
          );
          if (btn.getAttribute('data-period') === period) {
            btn.classList.add('bg-tk-accent', 'text-tk-accent-ink');
            btn.classList.remove('text-tk-ink-2');
          } else {
            btn.classList.remove('bg-tk-accent', 'text-tk-accent-ink');
            btn.classList.add('text-tk-ink-2');
          }
        });
        monthlyEls.forEach((el) => el.classList.toggle('hidden', period !== 'monthly'));
        annualEls.forEach((el) => el.classList.toggle('hidden', period !== 'annual'));
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const period = btn.getAttribute('data-period');
          if (period) setPeriod(period);
        });
      });

      setPeriod('monthly');
    })();
  </script>
</BaseLayout>
