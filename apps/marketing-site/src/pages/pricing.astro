---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  API_TIERS,
  SELF_HOSTED_ARCHETYPE_UPDATES,
  SELF_HOSTED_SKUS,
  SELF_HOSTED_SOFTWARE_UPDATES,
  SELF_HOSTED_SOURCE_ACCESS,
} from '../data/pricing.ts';
import type { LlmBilling } from '../data/pricing.ts';

const freeTier = API_TIERS.find((t) => t.id === 'free')!;
const manualTiers = API_TIERS.filter((t) => t.tierType === 'manual');
const apiTiers = API_TIERS.filter((t) => t.tierType === 'api');

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtAiAgent(aiAgent: boolean, llmBilling: LlmBilling): string {
  if (!aiAgent) return '—';
  switch (llmBilling) {
    case 'byok_only':
      return 'BYOK (Anthropic key required)';
    case 'byok_or_bundled':
      return 'BYOK or bundled (your choice)';
    case 'byok_or_bundled_custom':
      return 'BYOK or bundled (custom rate)';
    default:
      return '—';
  }
}

function fmtArchetypes(max: number | null): string {
  if (max === null) return 'All + custom';
  return max === 1 ? '1 archetype' : `${max.toString()} archetypes`;
}

function fmtSupportTier(tier: 'email_48h' | 'email_slack_12h' | 'dedicated_csm_1h'): string {
  switch (tier) {
    case 'email_48h':
      return 'Email · 48h SLA';
    case 'email_slack_12h':
      return 'Email + Slack Connect · 12h SLA';
    case 'dedicated_csm_1h':
      return 'Dedicated CSM · 1h SLA';
  }
}

function fmtCustomArchetypeDev(level: 'none' | 'limited' | 'unlimited'): string {
  switch (level) {
    case 'none':
      return '—';
    case 'limited':
      return 'Limited (1/yr)';
    case 'unlimited':
      return 'Unlimited';
  }
}

---

<BaseLayout
  title="Pricing"
  description="Driftstack pricing — start free, then pay only for the sessions you run at once. Pick Manual (drive sessions yourself in our desktop app) or API (automate with code). Or self-host and run it all yourself."
>
  <!-- Header -->
  <section class="relative overflow-hidden">
    {/* 2026-05-22 — same hero-glow atmosphere as the landing page so
        the pricing surface reads as part of the same visual family. */}
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-24 animate-fade-up">
      <p class="section-label">Pricing</p>
      <h1
        class="mt-6 text-4xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
        style="letter-spacing: -0.02em;"
      >
        
          Two ladders.
        
        <span class="block text-tk-ink">One free tier to start.</span>
      </h1>
      <p class="mt-6 max-w-prose text-lg text-tk-ink-2 leading-relaxed">
        <strong class="text-tk-ink">Manual</strong> if a person is driving
        sessions in our desktop app.
        <strong class="text-tk-ink">API</strong> if your code is calling
        the SDK. Same engine underneath; pick the workflow that matches yours.
        Start on the free tier first to see which feels right.
      </p>
    </div>
  </section>

  <!-- Free tier hero card -->
  <section id="free" class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div
        class="grid gap-8 rounded-lg border border-tk-accent/30 bg-tk-surface p-8 md:grid-cols-3 md:items-center"
      >
        <div class="md:col-span-2">
          {/* 2026-05-23 — icon + h2 on free-tier hero. */}
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
              </svg>
            </div>
            <div>
              <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">Start here</p>
              <h2 class="mt-3 text-2xl font-semibold text-tk-ink">
                  Free — {fmtUsd(freeTier.monthlyUsd)}, forever
                </h2>
            </div>
          </div>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            A perpetual free tier to evaluate the platform — no card
            required. {freeTier.profiles} profile, {freeTier.concurrent}
            concurrent session of up to 20 minutes — manual-only via the
            desktop GUI client — and it never expires.
          </p>
          <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
            No usage metering at all — run as many manual iPhone Safari
            sessions as you like. Upgrade to a paid tier when you need the
            API, more profiles, more concurrency, or the AI agent.
          </p>
          <ul class="mt-4 space-y-1 text-sm text-tk-ink-2">
            <li class="flex gap-2">
              <span class="text-tk-accent">•</span> Real iOS WebKit. No emulation, no runtime
              patches.
            </li>
            <li class="flex gap-2">
              <span class="text-tk-accent">•</span> Same SDK + GUI as paid tiers — switch tiers without
              code changes.
            </li>
            <li class="flex gap-2">
              <span class="text-tk-accent">•</span> Perpetual — no expiry, no credit to run down.
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-3 md:items-end">
          <a href="https://app.driftstack.dev/signup" class="btn-primary w-full md:w-auto"
            >Get started free</a
          >
          <a href="https://docs.driftstack.dev" class="btn-secondary w-full md:w-auto"
            >Read the docs</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning band -->
  <section id="no-overages" class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <p class="text-2xl font-medium tracking-tight text-tk-ink md:text-3xl">
        Pay per concurrent session.
        <span class="text-tk-ink-3"
          >Run as many hours as you want within your concurrent cap.</span
        > No surprise overage bills.
      </p>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-2">
        <strong class="text-tk-ink">Concurrent sessions</strong> = how many
        sessions you can run at the same time, like browser tabs you'd have
        open at once. The number after each tier (e.g. "3 concurrent") is the
        cap; everything else (hours, calls, page navigations) is unmetered
        within the cap.
      </p>
    </div>
  </section>

  <!-- Monthly/annual toggle (controls both Manual + API tables) -->
  <!-- V-502 — decision-tree section between the free-tier hero and the
       monthly/annual toggle. Static prose ladder; intentionally
       no JS interaction (Tier-1 placeholder bound). -->
  <section
    id="which-tier"
    aria-label="Which tier is right for me?"
    class="border-t border-tk-border bg-tk-surface"
  >
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">
        Pick your tier
      </p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-tk-ink">Which tier is right for me?</h2>
      <p class="mt-3 max-w-3xl text-sm text-tk-ink-2">
        All tiers run the same engine and the same fingerprint surface.
        Differences are concurrent caps + profile counts + AI-agent
        availability. The right tier is the one that matches your access
        pattern (Manual vs API) and your peak parallelism — switch any
        time, prorated automatically.
      </p>
      <p class="mt-3 text-sm text-tk-ink-2">
        Need every dimension side-by-side?
        <a href="/pricing/comparison" class="font-medium text-tk-accent underline"
          >See the per-tier comparison →</a
        >
      </p>

      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        <li class="rounded-lg border border-tk-accent/30 bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">
            Just looking
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">
            Free — $0, forever
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            One profile, one concurrent session of up to 20 minutes — no
            card required. The right entry if you want to click through
            iPhone Safari sessions and see the fingerprint surface before
            committing to a paid tier.
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Solo operator, GUI
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Personal — $79/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            One human clicking in the desktop GUI client; up to 10
            persistent profiles. Power users running 1 session at a time
            across 10 different client identities — sneaker resellers,
            sole-trader compliance work, individual researchers.
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Small team, GUI
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Team — $249/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            3 humans clicking in parallel; 50 profiles. Account managers
            running multiple client identities concurrently. AI-agent
            available (BYOK).
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Agency, GUI
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Agency — $699/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            8 concurrent operators; 200 profiles. Marketing agencies,
            compliance teams, legal-tech ops juggling many client
            identities at once.
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Solo dev, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Starter — $149/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Programmatic SDK access; 2 concurrent sessions; 25 profiles.
            Solo developers writing test automation or evaluation-stage
            scrapers. AI-agent available (BYOK).
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Production scale, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Builder — $499/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            8 concurrent; 100 profiles. Production automation jobs,
            CI suites running iPhone Safari on real WebKit, AI-agent
            flows with either BYOK or bundled-rate billing.
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            High throughput, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Scale — $1,499/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            24 concurrent; 500 profiles. High-volume automation fleets,
            agencies running scraping jobs across many domains, AI-agent
            workflows at scale.
          </p>
        </li>
        <li class="rounded-lg border border-tk-border bg-tk-surface p-5">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Custom contract
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Enterprise — from $4,000/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Annual contracts only. Custom concurrency + profiles +
            archetypes + SLA + DPA terms. The right tier for regulated
            industries (finance, healthcare) needing custom paperwork or
            customers needing a dedicated CSM.
          </p>
        </li>
      </ul>

      <p class="mt-8 max-w-3xl text-sm text-tk-ink-2">
        Need to run on your own hardware (regulated industry, air-gapped
        deployment, custom hardware fingerprint)?
        <a href="#self-hosted" class="text-tk-accent underline">
          See self-hosted SKUs
        </a>
        — pricing is engine-license-based with source-escrow, not the
        per-seat ladder above. Or
        <a href="/faq#architecture-sessions" class="text-tk-accent underline">
          read the architecture FAQ
        </a>
        if you're still deciding whether real-WebKit fits your workload.
      </p>
    </div>
  </section>

  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-10">
      <div class="flex items-center justify-end">
        <div
          id="billing-toggle"
          class="inline-flex rounded-md border border-tk-border bg-tk-surface p-1 text-sm font-medium"
          role="tablist"
        >
          <button
            type="button"
            data-period="monthly"
            class="billing-toggle-btn rounded-sm px-3 py-1.5 text-tk-ink-2"
            aria-selected="true"
          >
            Monthly
          </button>
          <button
            type="button"
            data-period="annual"
            class="billing-toggle-btn rounded-sm px-3 py-1.5 text-tk-ink-2"
            aria-selected="false"
          >
            Annual
            <span
              class="ml-1 rounded-sm bg-tk-accent/20 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-tk-accent"
              >−20%</span
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Manual ladder -->
  <section id="manual" class="bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 pb-20">
      <div class="mb-10 flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4" />
            <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">Manual</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">
              Manual — for humans
            </h2>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            Persistent profiles. Drive sessions yourself in the GUI client. No code
            required.
          </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          manualTiers.map((tier) => (
            <div
              class:list={[
                'rounded-lg border bg-tk-surface p-6',
                tier.highlight ? 'border-tk-accent shadow-md' : 'border-tk-border',
              ]}
            >
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-tk-ink">{tier.name}</h3>
                {tier.highlight && (
                  <span class="rounded-sm bg-tk-accent/20 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-tk-accent">
                    popular
                  </span>
                )}
              </div>
              <div class="price-monthly mt-3" data-period-target="monthly">
                <span class="text-2xl font-semibold text-tk-ink">{fmtUsd(tier.monthlyUsd)}</span>
                <span class="text-sm text-tk-ink-3">/mo</span>
              </div>
              <div class="price-annual mt-3 hidden" data-period-target="annual">
                <span class="text-2xl font-semibold text-tk-ink">
                  {fmtUsd(tier.annualMonthlyEquivalentUsd)}
                </span>
                <span class="text-sm text-tk-ink-3">
                  /mo · billed {fmtUsd(tier.annualUsd)} yearly
                </span>
              </div>
              <dl class="mt-6 space-y-3 text-sm">
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Browser profiles</dt>
                  <dd class="text-right font-medium text-tk-ink">{tier.profiles.toString()}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Concurrent sessions</dt>
                  <dd class="text-right font-medium text-tk-ink">{tier.concurrent.toString()}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Hours</dt>
                  <dd class="text-right text-tk-ink">{tier.hoursLabel}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">AI agent (LLM-driven sessions)</dt>
                  <dd class="text-right text-tk-ink-2">
                    {fmtAiAgent(tier.aiAgent, tier.llmBilling)}
                  </dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Support</dt>
                  <dd class="text-right text-tk-ink-2">{tier.support}</dd>
                </div>
              </dl>
              <a href="https://app.driftstack.dev/signup" class="btn-primary mt-6 w-full">Get started free</a>
              <a
                href="https://app.driftstack.dev/signup"
                class="mt-2 block w-full text-center text-sm font-medium text-tk-accent underline-offset-4 hover:underline"
              >
                Buy {tier.name} →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Visual divider -->
  <div class="bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6">
      <div class="h-px bg-tk-accent"></div>
    </div>
  </div>

  <!-- API ladder -->
  <section id="api" class="bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-10 flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">API</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">
              API — for code
            </h2>
        <p class="mt-3 max-w-prose text-tk-ink-2">
          SDK in your language. Programmatic session creation. Concurrent caps that
          scale with your fleet.
        </p>
        <p class="mt-3 max-w-prose text-sm text-tk-ink-3">
          You'll see <strong class="text-tk-ink-2">"BYOK"</strong> in the tier
          tables below — it means
          <em>bring your own API key</em> from Anthropic for the optional AI
          agent feature. Your model spend goes
          to your provider account; Driftstack doesn't markup or proxy.
          Bundled LLM is the alternative — Driftstack proxies + bills on one
          invoice. Detail below the tier tables.
        </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          apiTiers.map((tier) => (
            <div
              class:list={[
                'rounded-lg border bg-tk-surface p-6',
                tier.highlight ? 'border-tk-accent shadow-md' : 'border-tk-border',
              ]}
            >
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-tk-ink">{tier.name}</h3>
                {tier.highlight && (
                  <span class="rounded-sm bg-tk-accent/20 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-tk-accent">
                    popular
                  </span>
                )}
              </div>
              {tier.id === 'enterprise' ? (
                <div class="mt-3">
                  <span class="text-2xl font-semibold text-tk-ink">
                    from {fmtUsd(tier.annualMonthlyEquivalentUsd)}/mo
                  </span>
                  <div class="text-xs text-tk-ink-3">annual contract only</div>
                </div>
              ) : (
                <>
                  <div class="price-monthly mt-3" data-period-target="monthly">
                    <span class="text-2xl font-semibold text-tk-ink">
                      {fmtUsd(tier.monthlyUsd)}
                    </span>
                    <span class="text-sm text-tk-ink-3">/mo</span>
                  </div>
                  <div class="price-annual mt-3 hidden" data-period-target="annual">
                    <span class="text-2xl font-semibold text-tk-ink">
                      {fmtUsd(tier.annualMonthlyEquivalentUsd)}
                    </span>
                    <span class="text-sm text-tk-ink-3">
                      /mo · billed {fmtUsd(tier.annualUsd)} yearly
                    </span>
                  </div>
                </>
              )}
              <dl class="mt-6 space-y-3 text-sm">
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Browser profiles</dt>
                  <dd class="text-right font-medium text-tk-ink">{tier.profiles.toString()}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Concurrent sessions</dt>
                  <dd class="text-right font-medium text-tk-ink">{tier.concurrent.toString()}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Hours</dt>
                  <dd class="text-right text-tk-ink">{tier.hoursLabel}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">AI agent (LLM-driven sessions)</dt>
                  <dd class="text-right text-tk-ink-2">
                    {fmtAiAgent(tier.aiAgent, tier.llmBilling)}
                  </dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Support</dt>
                  <dd class="text-right text-tk-ink-2">{tier.support}</dd>
                </div>
              </dl>
              {
                tier.id === 'enterprise' ? (
                  <a href={tier.cta.href} class="btn-primary mt-6 w-full">
                    {tier.cta.label}
                  </a>
                ) : (
                  <>
                    <a href="https://app.driftstack.dev/signup" class="btn-primary mt-6 w-full">
                      Get started free
                    </a>
                    <a
                      href="https://app.driftstack.dev/signup"
                      class="mt-2 block w-full text-center text-sm font-medium text-tk-accent underline-offset-4 hover:underline"
                    >
                      Buy {tier.name} →
                    </a>
                  </>
                )
              }
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-xs text-tk-ink-3">
        All prices in USD. VAT/BTW added per region per applicable EU rules. No
        setup fees on any tier. Annual contracts billed up front.
      </p>
    </div>
  </section>

  <!-- Visual divider -->
  <div class="bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6">
      <div class="h-px bg-tk-accent"></div>
