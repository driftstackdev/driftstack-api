---
// Pricing v2 (2026-07-03) — "Plain Words, Same Teeth" pass, same treatment
// as the homepage: Band A (hero → decision helper) speaks plain language;
// the ladders keep full technical precision. Every figure BINDS to
// src/data/pricing.ts (W292.B — no hand-typed dollars in the matrix).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import IconTile from '../components/IconTile.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  API_TIERS,
  SELF_HOSTED_ARCHETYPE_UPDATES,
  SELF_HOSTED_SKUS,
  SELF_HOSTED_SOFTWARE_UPDATES,
  SELF_HOSTED_SOURCE_ACCESS,
} from '../data/pricing.ts';
import type { LlmBilling } from '../data/pricing.ts';

const freeTier = API_TIERS.find((t) => t.id === 'free')!;
const manualTiers = API_TIERS.filter((t) => t.tierType === 'manual');
const apiTiers = API_TIERS.filter((t) => t.tierType === 'api');

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtAiAgent(aiAgent: boolean, llmBilling: LlmBilling): string {
  if (!aiAgent) return '—';
  switch (llmBilling) {
    case 'byok_only':
      return 'BYOK — bring your own Anthropic key';
    case 'byok_or_bundled':
      return 'BYOK or bundled (your choice)';
    case 'byok_or_bundled_custom':
      return 'BYOK or bundled (custom rate)';
    default:
      return '—';
  }
}

function fmtArchetypes(max: number | null): string {
  if (max === null) return 'All + custom';
  return max === 1 ? '1 archetype' : `${max.toString()} archetypes`;
}

// S26 2026-07-06 (#132) — accuracy fix (audit M1): this formatter
// previously rendered a tiered 48h/12h/1h reply ladder that
// contradicted /self-hosted. Per the 2026-05-19 founder verdict
// (see self-hosted.astro) the tiered SLA ladder was dropped
// (theatre for a small operation): single best-effort 48h target
// across all SKUs; Slack Connect available on request
// post-paid-subscription. Wording now mirrors self-hosted.astro's
// fmtSupportTier byte-for-byte.
function fmtSupportTier(tier: 'email_48h' | 'email_slack_12h' | 'dedicated_csm_1h'): string {
  switch (tier) {
    case 'email_48h':
      return 'Email · 48h target';
    case 'email_slack_12h':
      return 'Email + Slack Connect · 48h target';
    case 'dedicated_csm_1h':
      return 'Email + Slack Connect · 48h target';
  }
}

function fmtCustomArchetypeDev(level: 'none' | 'limited' | 'unlimited'): string {
  switch (level) {
    case 'none':
      return '—';
    case 'limited':
      return 'Limited (1/yr)';
    case 'unlimited':
      return 'Unlimited';
  }
}

// W507 — schema.org Product + AggregateOffer for rich-result eligibility on
// the pricing page (complements the site-wide @graph in BaseLayout). Every
// figure DERIVES from API_TIERS (W292.B data-binding discipline): lowPrice is
// the perpetual free tier, highPrice the highest listed monthly price,
// offerCount the tier count. Strictly factual — no fabricated ratings or
// reviews (we have none; inventing them is dishonest + a Google
// structured-data penalty risk).
const listedMonthlyUsd = API_TIERS.map((t) => t.monthlyUsd).filter(
  (v): v is number => typeof v === 'number',
);
const pricingStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Driftstack',
  description:
    'Real iPhone Safari sessions in the cloud — drive them by hand in a desktop app (Manual tiers) or from code via SDK (API tiers). Perpetual free tier included.',
  brand: { '@type': 'Brand', name: 'Driftstack' },
  url: new URL('/pricing', Astro.site).toString(),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: String(freeTier.monthlyUsd),
    highPrice: String(Math.max(...listedMonthlyUsd)),
    offerCount: String(API_TIERS.length),
  },
};
---

<BaseLayout
  title="Pricing"
  description="Driftstack pricing — start free, then pay only for the sessions you run at once. Pick Manual (drive sessions yourself in our desktop app) or API (automate with code). Or self-host and run it all yourself."
  ogImage="/og/pricing.png"
>
  <!-- Hero — Fleet v2 PageHero (label + h1 + lead over hero-glow + grid). -->
  <PageHero label="Pricing" title="Two ladders. One free tier to start.">
    <p class="mt-5 max-w-2xl text-lg leading-8 text-tk-ink-2">
      <strong class="text-tk-ink">Manual</strong> if a person is driving
      sessions in our desktop app.
      <strong class="text-tk-ink">API</strong> if your code is calling
      the SDK — our ready-made code library. Same engine underneath — start
      free and see which one fits.
    </p>
  </PageHero>

  <!-- Free tier hero card -->
  <section id="free" class="bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="card grid gap-8 border-tk-accent/40 p-8 md:grid-cols-3 md:items-center">
        <div class="md:col-span-2">
          <div class="flex items-start gap-3">
            <IconTile class="mt-1">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </IconTile>
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">
                Start here
              </p>
              <h2 class="mt-3 text-2xl font-semibold text-tk-ink">
                Free — {fmtUsd(freeTier.monthlyUsd)}, forever
              </h2>
            </div>
          </div>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            A perpetual free tier to evaluate the platform — no card
            required. {freeTier.profiles} profile, {freeTier.concurrent}
            session at a time (up to 20 minutes each) — driven by hand in
            our desktop app — and it never expires.
          </p>
          <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
            No usage metering at all — run as many manual iPhone Safari
            sessions as you like. Upgrade to a paid tier when you need the
            API, more profiles, more sessions running at once, or the AI
            agent.
          </p>
          <ul class="mt-4 space-y-1.5 text-sm text-tk-ink-2">
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span> The real iPhone browser engine — Apple's
              <a href="/glossary#webkit" class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">WebKit</a>.
              Not an emulator, and nothing patched on top to fake it.
            </li>
            {/* S26 2026-07-06 (#132) — accuracy fix (audit M2): this
                 bullet previously promised the "same code library
                 (SDK) as the paid tiers", but the free tier is
                 manual-only — apiAccess: false in
                 packages/api-types/src/common.ts TIER_FEATURES (no
                 usable API keys, no REST/SDK access from code).
                 Wording now matches the faq.ts free-tier answer. */}
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span> Same desktop app as the paid tiers — but manual-only:
              access from code (the API and SDKs) starts on the API
              ladder.
            </li>
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span> Perpetual — no expiry, no credit to run down.
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-3 md:items-end">
          <a href="https://app.driftstack.dev/signup" class="btn-primary w-full md:w-auto"
            >Get started free</a
          >
          <a href="https://docs.driftstack.dev" class="btn-secondary w-full md:w-auto"
            >Read the docs</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning band -->
  <section id="no-overages" class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <p class="text-2xl font-medium tracking-tight text-tk-ink md:text-3xl">
        Pay per concurrent session.
        <span class="text-tk-ink-3"
          >Run as many hours as you want within your concurrent cap.</span
        > No surprise overage bills.
      </p>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-2">
        <strong class="text-tk-ink">Concurrent sessions</strong> = how many
        sessions you can run at the same time, like browser tabs you'd have
        open at once. The number after each tier (e.g. "3 concurrent") is the
        cap; everything else (hours, calls, page navigations) is unmetered
        within the cap.
      </p>
    </div>
  </section>

  <!-- V-502 — decision helper between the free-tier hero and the
       monthly/annual toggle. Band A fork question ("who drives the
       sessions?") + two anchor cards into the ladders + a quieter
       both-workflows card, then the 8-tier prose teaser ladder. -->
  <section
    id="which-tier"
    aria-label="Which tier is right for me?"
    class="border-t border-tk-border bg-tk-surface"
  >
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="section-label">Pick your tier</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-tk-ink sm:text-3xl">
        Which tier is right for me?
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-tk-ink-2">
        One question decides most of it: who drives the sessions — a person
        clicking, or code calling?
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <a href="#manual" class="card block p-8">
          <div class="flex items-center gap-3">
            <IconTile>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"></path>
              </svg>
            </IconTile>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Manual</p>
          </div>
          <h3 class="mt-5 text-xl font-semibold tracking-tight text-tk-ink sm:text-2xl">
            A person → Manual.
          </h3>
          <p class="mt-3 text-sm leading-6 text-tk-ink-2">
            You drive iPhones by hand in the desktop app. Open a profile,
            click around, keep logins alive — no code anywhere. Tiers differ
            by how many people can work at once.
          </p>
          <p class="mt-5 text-sm font-medium text-tk-accent-text">See Manual tiers ↓</p>
        </a>
        <a href="#api" class="card block p-8">
          <div class="flex items-center gap-3">
            <IconTile>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </IconTile>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">API</p>
          </div>
          <h3 class="mt-5 text-xl font-semibold tracking-tight text-tk-ink sm:text-2xl">
            Code → API.
          </h3>
          <p class="mt-3 text-sm leading-6 text-tk-ink-2">
            Your scripts and automated jobs run the sessions. Start them from
            TypeScript, Python, or Go and read back what they find. Tiers
            differ by how many sessions run at once.
          </p>
          <p class="mt-5 text-sm font-medium text-tk-accent-text">See API tiers ↓</p>
        </a>
      </div>
      <div class="panel mt-6 md:flex md:items-center md:justify-between md:gap-8">
        <div>
          <h3 class="text-base font-semibold text-tk-ink">Both? Neither yet? Start free.</h3>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-tk-ink-2">
            Both ladders run the same engine and share the same free tier.
            Start free, drive a session by hand, run one from code, and see
            which workflow fits before paying for anything.
          </p>
        </div>
        <a href="#free" class="btn-secondary mt-4 shrink-0 md:mt-0">Start free ↑</a>
      </div>

      <p class="mt-12 max-w-2xl text-sm leading-6 text-tk-ink-2">
        Every tier runs the same engine — same iPhones, same faithfulness to
        the real device. Paying more buys more sessions at once, more saved
        profiles, and the AI agent. Switch tiers any time; billing is
        prorated automatically.
      </p>
      <p class="mt-3 text-sm text-tk-ink-2">
        Need every dimension side-by-side?
        <a
          href="/pricing/comparison"
          class="font-medium text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >See the per-tier comparison →</a
        >
      </p>

      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        <li class="card border-tk-accent/40 p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">
            Just looking
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">
            Free — $0, forever
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            One profile, one session at a time, up to 20 minutes — no card
            required. The right entry if you want to click around a real
            iPhone in the cloud before paying for anything.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            One person, by hand
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Personal — $79/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            One person clicking in the desktop app; up to 10 saved profiles.
            Run 1 session at a time across 10 different client identities —
            sneaker resellers, sole-trader compliance work, individual
            researchers.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Small team, by hand
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Team — $249/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            3 people clicking at the same time; 50 profiles. Account managers
            keeping several client identities open at once. AI agent
            available (bring your own Anthropic key).
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Big team, by hand
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Agency — $699/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            8 people working at once; 200 profiles. Marketing agencies,
            compliance teams, legal-tech ops juggling many client identities
            at once.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            One developer, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Starter — $149/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Your code runs the sessions — 2 at a time, 25 profiles. Solo
            developers writing test automation or early-stage scrapers. AI
            agent available (bring your own Anthropic key).
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Production, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Builder — $499/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            8 sessions at a time; 100 profiles. Production automation and CI
            test suites (the checks that run automatically on every code
            change) that need iPhone Safari on real WebKit. AI agent with
            your own key or billed on one invoice.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            High volume, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Scale — $1,499/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            24 sessions at a time; 500 profiles. High-volume automation
            fleets and agencies running jobs across many sites at once.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Custom contract
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Enterprise — from $4,000/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Annual contracts only. Custom limits on sessions-at-once and
            profiles, custom device types (archetypes), plus tailored
            reply-time commitments (SLA) and data-protection agreements
            (DPA). For regulated industries (finance, healthcare) that need
            custom paperwork or a dedicated customer-success manager.
          </p>
        </li>
      </ul>

      <p class="mt-8 max-w-3xl text-sm text-tk-ink-2">
        Need to run on your own hardware (a regulated industry, machines with
        no internet connection — "air-gapped" — or a custom hardware
        fingerprint)?
        <a
          href="#self-hosted"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
        >
          See self-hosted plans
        </a>
        — priced as a software license with source escrow (a copy of the code
        held in trust for you by a third party), not like the monthly tiers
        above. Or
        <a
          href="/faq#architecture-sessions"
          class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
        >
          read the architecture FAQ
        </a>
        if you're still deciding whether the real-Safari engine fits what
        you're doing.
      </p>
    </div>
  </section>

  <!-- Glossary line + monthly/annual toggle (controls both Manual + API tables) -->
  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-10">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        {/* One-sentence glossary for the ladders below — same browser-tabs
            metaphor as the homepage metering band. */}
        <p class="max-w-2xl text-sm leading-6 text-tk-ink-2">
          Three words to know: <strong class="font-medium text-tk-ink">concurrent</strong> means
          sessions running at the same time — think browser tabs — a
          <strong class="font-medium text-tk-ink">profile</strong> is a saved iPhone identity
          that keeps its logins and history, and
          <strong class="font-medium text-tk-ink">BYOK</strong> means you bring your own
          Anthropic key for the optional AI agent and pay Anthropic directly.
        </p>
        <div
          id="billing-toggle"
          class="inline-flex shrink-0 self-start rounded-md border border-tk-border bg-tk-surface p-1 text-sm font-medium md:self-auto"
          role="tablist"
        >
          <button
            type="button"
            data-period="monthly"
            class="billing-toggle-btn rounded-sm px-3 py-1.5 text-tk-ink-2"
            aria-selected="true"
          >
            Monthly
          </button>
          <button
            type="button"
            data-period="annual"
            class="billing-toggle-btn rounded-sm px-3 py-1.5 text-tk-ink-2"
            aria-selected="false"
          >
            Annual
            {/* S34 2026-07-07 (fable-frontend-audit) — the chip's idle colors (accent-text on
                an accent wash) become unreadable (1.2–1.9:1) once the
                Annual button is SELECTED and fills with solid accent;
                setPeriod() flips the chip to white-ink-on-white-wash in
                the selected state (computed 4.9:1 at 10px). */}
            <span
              data-annual-chip
              class="ml-1 rounded-sm bg-tk-accent/15 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-tk-accent-text"
              >−20%</span
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Manual ladder -->
  <section id="manual" class="bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 pb-20">
      <div class="mb-10 flex items-start gap-4">
        <IconTile class="mt-1">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"></path>
          </svg>
        </IconTile>
        <div>
          <p class="section-label">Manual</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">
            Manual — for humans
          </h2>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            Saved profiles that keep their logins. Drive sessions yourself in
            the desktop app. No code required.
          </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          manualTiers.map((tier) => (
            <div class:list={['card p-6', tier.highlight ? 'border-tk-accent/50' : '']}>
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-tk-ink">{tier.name}</h3>
                {tier.highlight && <span class="pill text-tk-accent-text">Popular</span>}
              </div>
              <div class="price-monthly mt-3" data-period-target="monthly">
                <span class="text-2xl font-semibold text-tk-ink">{fmtUsd(tier.monthlyUsd)}</span>
                <span class="text-sm text-tk-ink-3">/mo</span>
              </div>
              <div class="price-annual mt-3 hidden" data-period-target="annual">
                <span class="text-2xl font-semibold text-tk-ink">
                  {fmtUsd(tier.annualMonthlyEquivalentUsd)}
                </span>
                <span class="text-sm text-tk-ink-3">
                  /mo · billed {fmtUsd(tier.annualUsd)} yearly
                </span>
              </div>
              <dl class="mt-6 space-y-3 text-sm">
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Browser profiles</dt>
                  <dd class="text-right font-medium text-tk-ink">{tier.profiles.toString()}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Concurrent sessions</dt>
                  <dd class="text-right font-medium text-tk-ink">{tier.concurrent.toString()}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Hours</dt>
                  <dd class="text-right text-tk-ink">{tier.hoursLabel}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">AI agent (sessions driven by an AI model)</dt>
                  <dd class="text-right text-tk-ink-2">
                    {fmtAiAgent(tier.aiAgent, tier.llmBilling)}
                  </dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-tk-border pt-3">
                  <dt class="text-tk-ink-3">Support</dt>
                  <dd class="text-right text-tk-ink-2">{tier.support}</dd>
                </div>
              </dl>
              <a href="https://app.driftstack.dev/signup" class="btn-primary mt-6 w-full">
                Get started free
              </a>
