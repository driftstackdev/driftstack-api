---
import BaseLayout from '../layouts/BaseLayout.astro';
import { API_TIERS, SELF_HOSTED_SKUS, TRIAL_PACK } from '../data/pricing.ts';

const paidTiers = API_TIERS.filter((t) => t.id !== 'trial-pack');
const trialPack = API_TIERS.find((t) => t.id === 'trial-pack')!;

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}
---

<BaseLayout
  title="Pricing"
  description="Driftstack pricing: $2.99 trial pack, then per-browser-hour billing across five tiers. One transparent ladder, no bait-and-switch."
>
  <!-- Header -->
  <section class="bg-gradient-to-b from-white to-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Pricing</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900 md:text-5xl">
        Pay for browser-hours. Cap by concurrency. Done.
      </h1>
      <p class="mt-6 max-w-prose text-lg text-slate-600">
        Driftstack meters by the browser-hour, not by call count. Concurrency
        caps are tier-defining hard limits at session creation; everything else
        is a deterministic line item. No "API call" upcharges. No retention
        gates. No tier-based archetype lockouts beyond what's explicitly listed.
      </p>
    </div>
  </section>

  <!-- Trial pack hero card -->
  <section id="trial-pack" class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-8 rounded-lg border border-oxblood-200 bg-white p-8 md:grid-cols-3 md:items-center">
        <div class="md:col-span-2">
          <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Start here</p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-900">
            Trial pack — {fmtUsd(trialPack.monthlyUsd)}, one-time
          </h2>
          <p class="mt-3 max-w-prose text-slate-600">
            {TRIAL_PACK.creditCents}¢ of pre-paid credit, decremented at the
            Starter rate ({TRIAL_PACK.meterRate}). Yields ~{TRIAL_PACK.hoursApprox} hours of
            iPhone Safari sessions. {TRIAL_PACK.concurrent} concurrent session, {TRIAL_PACK.windowDays}-day
            window from purchase, one-time purchase used once per account.
          </p>
          <ul class="mt-4 space-y-1 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-oxblood-700">•</span> Real iPhone Safari, real Apple silicon. No emulation.</li>
            <li class="flex gap-2"><span class="text-oxblood-700">•</span> Same SDK + API surface as paid tiers — switch tiers without code changes.</li>
            <li class="flex gap-2"><span class="text-oxblood-700">•</span> Unused credit expires after {TRIAL_PACK.windowDays} days; subscribe to a tier to continue.</li>
          </ul>
        </div>
        <div class="flex flex-col gap-3 md:items-end">
          <a href="/signup" class="btn-primary w-full md:w-auto">Buy {fmtUsd(trialPack.monthlyUsd)} trial pack</a>
          <a href="https://docs.driftstack.dev" class="btn-secondary w-full md:w-auto">Read the docs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Subscription tiers -->
  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-col items-start gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Subscriptions</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">
            Five tiers. One ladder.
          </h2>
        </div>
        <div
          id="billing-toggle"
          class="inline-flex rounded-md border border-slate-200 bg-white p-1 text-sm font-medium"
          role="tablist"
        >
          <button
            type="button"
            data-period="monthly"
            class="billing-toggle-btn rounded-sm px-3 py-1.5 text-slate-700 [aria-selected=true]:bg-oxblood-700 [aria-selected=true]:text-white"
            aria-selected="true"
          >
            Monthly
          </button>
          <button
            type="button"
            data-period="annual"
            class="billing-toggle-btn rounded-sm px-3 py-1.5 text-slate-700 [aria-selected=true]:bg-oxblood-700 [aria-selected=true]:text-white"
            aria-selected="false"
          >
            Annual
            <span class="ml-1 rounded-sm bg-oxblood-100 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-oxblood-700">−20%</span>
          </button>
        </div>
      </div>

      <!-- Tier table — desktop -->
      <div class="mt-12 hidden overflow-x-auto md:block">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-4 pr-4 font-medium text-slate-700">Plan</th>
              {paidTiers.map((tier) => (
                <th
                  class:list={[
                    'px-4 py-4 font-semibold',
                    tier.highlight ? 'text-oxblood-700' : 'text-slate-900',
                  ]}
                >
                  {tier.name}
                  {tier.highlight && (
                    <span class="ml-2 rounded-sm bg-oxblood-100 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-oxblood-700">popular</span>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Price</td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top">
                  {tier.id === 'enterprise' ? (
                    <div>
                      <div class="text-base font-semibold text-slate-900">
                        from {fmtUsd(tier.annualUsd)}/mo
                      </div>
                      <div class="text-xs text-slate-500">annual only</div>
                    </div>
                  ) : (
                    <div>
                      <div class="price-monthly" data-period-target="monthly">
                        <span class="text-base font-semibold text-slate-900">{fmtUsd(tier.monthlyUsd)}</span>
                        <span class="text-xs text-slate-500">/mo</span>
                      </div>
                      <div class="price-annual hidden" data-period-target="annual">
                        <span class="text-base font-semibold text-slate-900">{fmtUsd(tier.annualMonthlyEquivalentUsd)}</span>
                        <span class="text-xs text-slate-500">/mo</span>
                        <div class="text-[11px] text-slate-500">
                          billed {fmtUsd(tier.annualUsd)} annually
                        </div>
                      </div>
                    </div>
                  )}
                </td>
              ))}
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Browser-hours</td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top text-slate-900">{tier.hoursLabel}</td>
              ))}
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Overage / hr</td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top text-slate-900">
                  {tier.overagePerHourUsd === null ? '—' : fmtUsd(tier.overagePerHourUsd)}
                </td>
              ))}
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Concurrent</td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top text-slate-900">{tier.concurrent}</td>
              ))}
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Archetypes</td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top text-slate-600">{tier.archetypeAccess}</td>
              ))}
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Support</td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top text-slate-600">{tier.support}</td>
              ))}
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 pr-4 font-medium text-slate-700">Bundled LLM</td>
              {paidTiers.map((tier) => {
                const eligible = ['builder', 'scale', 'enterprise'].includes(tier.id);
                return (
                  <td class="px-4 py-4 align-top text-slate-600">
                    {eligible ? 'Available · BYOK supported' : '—'}
                  </td>
                );
              })}
            </tr>
            <tr>
              <td class="py-4 pr-4"></td>
              {paidTiers.map((tier) => (
                <td class="px-4 py-4 align-top">
                  <a
                    href={tier.cta.href}
                    class:list={[tier.highlight ? 'btn-primary' : 'btn-secondary', 'w-full']}
                  >
                    {tier.cta.label}
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Tier table — mobile cards -->
      <div class="mt-12 grid gap-6 md:hidden">
        {paidTiers.map((tier) => (
          <div
            class:list={[
              'rounded-lg border bg-white p-6',
              tier.highlight ? 'border-oxblood-700 shadow-md' : 'border-slate-200',
            ]}
          >
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold text-slate-900">{tier.name}</h3>
              {tier.highlight && (
                <span class="rounded-sm bg-oxblood-100 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-oxblood-700">popular</span>
              )}
            </div>
            {tier.id === 'enterprise' ? (
              <div class="mt-3 text-2xl font-semibold text-slate-900">
                from {fmtUsd(tier.annualUsd)}<span class="text-sm font-normal text-slate-500">/mo annual only</span>
              </div>
            ) : (
              <>
                <div class="price-monthly mt-3" data-period-target="monthly">
                  <span class="text-2xl font-semibold text-slate-900">{fmtUsd(tier.monthlyUsd)}</span>
                  <span class="text-sm text-slate-500">/mo</span>
                </div>
                <div class="price-annual mt-3 hidden" data-period-target="annual">
                  <span class="text-2xl font-semibold text-slate-900">{fmtUsd(tier.annualMonthlyEquivalentUsd)}</span>
                  <span class="text-sm text-slate-500">/mo, billed {fmtUsd(tier.annualUsd)} yearly</span>
                </div>
              </>
            )}
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              <li><strong class="text-slate-900">{tier.hoursLabel}</strong></li>
              {tier.overagePerHourUsd !== null && (
                <li>{fmtUsd(tier.overagePerHourUsd)}/hr overage</li>
              )}
              <li>{typeof tier.concurrent === 'number' ? `${tier.concurrent.toString()} concurrent` : tier.concurrent}</li>
              <li>{tier.archetypeAccess}</li>
              <li>{tier.support}</li>
            </ul>
            <a
              href={tier.cta.href}
              class:list={[tier.highlight ? 'btn-primary' : 'btn-secondary', 'mt-6 w-full']}
            >
              {tier.cta.label}
            </a>
          </div>
        ))}
      </div>

      <p class="mt-8 text-xs text-slate-500">
        All prices in USD. VAT/BTW added per region per applicable EU rules.
        No setup fees on any tier. Annual contracts billed up front.
      </p>
    </div>
  </section>

  <!-- BYOK note -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-6 rounded-lg border border-slate-200 bg-white p-8 md:grid-cols-3 md:items-center">
        <div class="md:col-span-2">
          <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">
            Bundled LLM (Builder, Scale, Enterprise)
          </p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-900">
            Bundled or BYOK — your call.
          </h2>
          <p class="mt-3 max-w-prose text-slate-600">
            Driftstack's optional AI agent feature drives sessions with a
            large language model. Bring your own LLM API key (BYOK) or use
            the bundled billing. Per-token pricing for the bundled rate is
            announced at launch; BYOK is metered against your own provider
            key at no Driftstack markup.
          </p>
        </div>
        <div class="text-sm text-slate-600">
          <ul class="space-y-2">
            <li class="flex gap-2"><span class="text-oxblood-700">→</span> Latest frontier models supported.</li>
            <li class="flex gap-2"><span class="text-oxblood-700">→</span> Token usage on your bill, not ours.</li>
            <li class="flex gap-2"><span class="text-oxblood-700">→</span> Toggle BYOK ↔ bundled per-account.</li>
          </ul>
          <p class="mt-3 text-xs text-slate-500">
            Supported LLM provider listed at <a href="/trust/sub-processors" class="text-oxblood-700 underline">/trust/sub-processors</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Self-Hosted -->
  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-col items-start gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">Self-hosted</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">
            Run on your own Apple silicon.
          </h2>
          <p class="mt-3 max-w-prose text-slate-600">
            For privacy-required workloads, sustained &gt;5,000 hr/mo volume,
            or full data-sovereignty needs. Contact Sales from day 0; GA
            within 6 months of API public launch.
          </p>
        </div>
        <a href="/self-hosted" class="btn-secondary">See self-hosted details</a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {SELF_HOSTED_SKUS.map((sku) => (
          <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900">{sku.name}</h3>
            <div class="mt-3">
              {sku.monthlyUsd === null ? (
                <div class="text-2xl font-semibold text-slate-900">
                  from {fmtUsd(sku.annualMonthlyEquivalentUsd)}<span class="text-sm font-normal text-slate-500">/mo</span>
                </div>
              ) : (
                <>
                  <div class="text-2xl font-semibold text-slate-900">
                    {fmtUsd(sku.monthlyUsd)}<span class="text-sm font-normal text-slate-500">/mo</span>
                  </div>
                  <div class="text-xs text-slate-500">
                    or {fmtUsd(sku.annualMonthlyEquivalentUsd)}/mo billed annually
                  </div>
                </>
              )}
            </div>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              <li><strong class="text-slate-900">{sku.hardwareRequired}</strong></li>
              <li>{sku.concurrent}</li>
              <li>{sku.archetypeAccess}</li>
              <li>{sku.minimumTerm}</li>
            </ul>
            <a href={sku.ctaHref} class="btn-secondary mt-6 w-full">Contact sales</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mini FAQ teaser -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="text-2xl font-semibold text-slate-900">Common questions</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="font-medium text-slate-900">Why browser-hours and not sessions?</h3>
          <p class="mt-2 text-sm text-slate-600">
            A session is what your code starts; a browser-hour is what
            actually consumes Apple silicon. Metering by the hour means you
            pay for engagement, not for spinning idle sessions. A
            5-minute session costs less than an hour-long one. Concurrency
            caps stay tier-defining at session creation.
          </p>
        </div>
        <div>
          <h3 class="font-medium text-slate-900">What happens when the trial pack runs out?</h3>
          <p class="mt-2 text-sm text-slate-600">
            Either the credit hits zero or 14 days pass. New session attempts
            return 402 Payment Required pointing at the checkout flow for a
            paid tier. Trial pack is once per account, no reset on downgrade
            or churn — to come back, subscribe.
          </p>
        </div>
        <div>
          <h3 class="font-medium text-slate-900">Can I switch tiers mid-month?</h3>
          <p class="mt-2 text-sm text-slate-600">
            Yes. The change is prorated automatically. New limits apply immediately;
            session-creation gates use the new tier on the next call.
          </p>
        </div>
        <div>
          <h3 class="font-medium text-slate-900">Is the EU stack just marketing?</h3>
          <p class="mt-2 text-sm text-slate-600">
            No. Customer data is hosted in the EU — compute, database, and
            object storage all EU-resident. Mac fleet sessions may run in
            supported regions outside the EU under SCCs and the EU-US Data
            Privacy Framework. Full sub-processor list with locations and
            contractual basis at <a href="/trust/sub-processors" class="text-oxblood-700 underline">/trust/sub-processors</a>.
          </p>
        </div>
      </div>
      <div class="mt-10">
        <a href="/faq" class="btn-secondary">See full FAQ</a>
      </div>
    </div>
  </section>

  <!-- Monthly/Annual toggle script -->
  <script is:inline>
    (function () {
      const root = document.getElementById('billing-toggle');
      if (!root) return;
      const buttons = root.querySelectorAll('.billing-toggle-btn');
      const monthlyEls = document.querySelectorAll('[data-period-target="monthly"]');
      const annualEls = document.querySelectorAll('[data-period-target="annual"]');

      function setPeriod(period) {
        buttons.forEach((btn) => {
          btn.setAttribute('aria-selected', btn.getAttribute('data-period') === period ? 'true' : 'false');
          if (btn.getAttribute('data-period') === period) {
            btn.classList.add('bg-oxblood-700', 'text-white');
            btn.classList.remove('text-slate-700');
          } else {
            btn.classList.remove('bg-oxblood-700', 'text-white');
            btn.classList.add('text-slate-700');
          }
        });
        monthlyEls.forEach((el) => el.classList.toggle('hidden', period !== 'monthly'));
        annualEls.forEach((el) => el.classList.toggle('hidden', period !== 'annual'));
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const period = btn.getAttribute('data-period');
          if (period) setPeriod(period);
        });
      });

      // Initialise to the currently-selected (data-driven) state.
      setPeriod('monthly');
    })();
  </script>
</BaseLayout>
