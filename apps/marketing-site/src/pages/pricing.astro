---
// Pricing v2 (2026-07-03) — "Plain Words, Same Teeth" pass, same treatment
// as the homepage: Band A (hero → decision helper) speaks plain language;
// the ladders keep full technical precision. Every figure BINDS to
// src/data/pricing.ts (W292.B — no hand-typed dollars in the matrix).
//
// 2026-09-16 readability pass — the last pass fixed claims sentence by
// sentence and the page still READ the same. Changed here, facts untouched:
//   • ONE name for the thing every plan is priced by — "sessions at the same
//     time". It is explained once, in the positioning band under the free
//     card ("what you pay for", browser-tabs metaphor, with "concurrent
//     sessions" named as the industry word), and every later mention, row
//     label and tier card uses that same phrase, so "concurrent" and "at
//     once" no longer take turns meaning the same thing. The one surviving
//     "one session at a time" is the free tier's cap of 1, where that is the
//     natural English and the pinned wording.
//   • Row labels a non-technical buyer reads without a glossary: Browser
//     profiles → Saved profiles, Concurrent sessions → Sessions at the same
//     time, Hours → Hours included.
//   • Band A sentences split: no stacked em-dash asides, shorter sentences,
//     benefit first. Band C (the ladder rows, the API band's auth sentence,
//     the self-hosted SKU rows) keeps its precision — only its intros moved.
// No figure, cap, tier name, price, limit or data binding changed.
//
// 2026-09-16 second readability pass (verifier round). Same discipline,
// four things the first pass left behind:
//   • ONE name for the device dimension. The ladder rows say "Device types";
//     the prose said "device profile", which collided with the glossary's
//     "profile" (a saved iPhone identity) and made the count read like a
//     profile quota. Prose now says "device type" everywhere, and the
//     glossary band carries the gloss /pricing/comparison already had, so
//     the term is defined before the tables use it.
//   • "VPN exit" / "OpenVPN and WireGuard exits" left Band A: the free card
//     and the two upgrade-trigger sentences now say "your own VPN
//     connection" and gloss the proxy once, in the same sentence.
//   • Upgrade triggers lead with the action, then list the reasons — and
//     stay reason-lists, never "every paid tier adds X" (Personal has no AI
//     agent and the same 1 session at a time as Free).
//   • Two overstatements removed: the AI-agent intro no longer offers every
//     plan a choice of who pays for the model (Team / Agency / API Starter
//     and self-hosted are BYOK-only), and the mini-FAQ heading says
//     "sessions at the same time", which is the thing that is capped.
// Again: no figure, cap, tier name, price, limit or data binding changed.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import IconTile from '../components/IconTile.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  API_TIERS,
  SELF_HOSTED_ARCHETYPE_UPDATES,
  SELF_HOSTED_SKUS,
  SELF_HOSTED_SOFTWARE_UPDATES,
  SELF_HOSTED_SOURCE_ACCESS,
} from '../data/pricing.ts';
import type { LlmBilling } from '../data/pricing.ts';
import { DEVICE_SUPPORT } from '../data/capabilities';

const freeTier = API_TIERS.find((t) => t.id === 'free')!;
const manualTiers = API_TIERS.filter((t) => t.tierType === 'manual');
const apiTiers = API_TIERS.filter((t) => t.tierType === 'api');

function fmtUsd(value: number | null | undefined): string {
  if (value === null || value === undefined) return '—';
  return value % 1 === 0 ? `$${value.toLocaleString('en-US')}` : `$${value.toFixed(2)}`;
}

function fmtAiAgent(aiAgent: boolean, llmBilling: LlmBilling): string {
  if (!aiAgent) return '—';
  switch (llmBilling) {
    case 'byok_only':
      return 'BYOK — bring your own Anthropic key';
    case 'byok_or_bundled':
      return 'BYOK or bundled (your choice)';
    case 'byok_or_bundled_custom':
      return 'BYOK or bundled (custom budget)';
    default:
      return '—';
  }
}

function fmtArchetypes(max: number | null): string {
  if (max === null) return 'All + custom';
  return max === 1 ? '1 device type' : `${max.toString()} device types`;
}

// S26 2026-07-06 (#132) — accuracy fix (audit M1): this formatter
// previously rendered a tiered 48h/12h/1h reply ladder that
// contradicted /self-hosted. Per the 2026-05-19 founder verdict
// (see self-hosted.astro) the tiered SLA ladder was dropped
// (theatre for a small operation): single best-effort 48h target
// across all SKUs; Slack Connect available on request
// post-paid-subscription. Wording now mirrors self-hosted.astro's
// fmtSupportTier byte-for-byte. 2026-09-15 — Self-Hosted Enterprise
// (`dedicated_csm_1h`) states the grant pricing.ts gives the Enterprise
// tier (dedicated account manager + the contractual 1h Severity-1
// first-reply SLA, Terms §9.2), the same string self-hosted.astro
// renders; the cross-page pin lives in the self-hosted parity tests.
function fmtSupportTier(tier: 'email_48h' | 'email_slack_12h' | 'dedicated_csm_1h'): string {
  switch (tier) {
    case 'email_48h':
      return 'Email · 48h target';
    case 'email_slack_12h':
      return 'Email + Slack Connect · 48h target';
    case 'dedicated_csm_1h':
      return 'Dedicated account manager · 1h SLA for first reply on critical (Severity-1) incidents';
  }
}

function fmtCustomArchetypeDev(level: 'none' | 'limited' | 'unlimited'): string {
  switch (level) {
    case 'none':
      return '—';
    case 'limited':
      return 'Limited (1/yr)';
    case 'unlimited':
      return 'Unlimited';
  }
}

// W507 — schema.org Product + AggregateOffer for rich-result eligibility on
// the pricing page (complements the site-wide @graph in BaseLayout). Every
// figure DERIVES from API_TIERS (W292.B data-binding discipline): lowPrice is
// the perpetual free tier, highPrice the highest listed monthly price,
// offerCount the tier count. Strictly factual — no fabricated ratings or
// reviews (we have none; inventing them is dishonest + a Google
// structured-data penalty risk).
const listedMonthlyUsd = API_TIERS.map((t) => t.monthlyUsd).filter(
  (v): v is number => typeof v === 'number',
);
const pricingStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Driftstack',
  description:
    'Real iPhone Safari sessions in the cloud — drive them by hand in a desktop app (Manual tiers) or from code via SDK (API tiers). Free tier included, and it never expires.',
  brand: { '@type': 'Brand', name: 'Driftstack' },
  url: new URL('/pricing', Astro.site).toString(),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: String(freeTier.monthlyUsd),
    highPrice: String(Math.max(...listedMonthlyUsd)),
    offerCount: String(API_TIERS.length),
  },
};
---

<BaseLayout
  title="Pricing"
  description="Driftstack pricing — start free, then pay only for the sessions you run at the same time. Pick Manual (drive sessions yourself in our desktop app) or API (automate with code). Or self-host and run it all yourself."
  ogImage="/og/pricing-light.png"
>
  <!-- Hero — Fleet v2 PageHero (label + h1 + lead over hero-glow + grid). -->
  <PageHero label="Pricing" title="Two plan families. One free tier to start.">
    <p class="mt-5 max-w-2xl text-lg leading-8 text-tk-ink-2">
      <strong class="text-tk-ink">Manual</strong> if a person is driving
      sessions in our desktop app.
      <strong class="text-tk-ink">API</strong> if your code is calling
      the SDK, our ready-made code library. Both run the same real iPhones.
      Start free and see which one fits.
    </p>
  </PageHero>

  <!-- Free tier hero card -->
  <section id="free" class="bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="card grid gap-8 border-tk-accent/40 p-8 md:grid-cols-3 md:items-start">
        <div class="md:col-span-2">
          <div class="flex items-start gap-3">
            <IconTile class="mt-1">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </IconTile>
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">
                Start here
              </p>
              <h2 class="mt-3 text-2xl font-semibold text-tk-ink">
                Free — {fmtUsd(freeTier.monthlyUsd)}, forever
              </h2>
            </div>
          </div>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            A free tier that never expires — no card required.
            {freeTier.profiles} profile, {freeTier.concurrent}
            session at a time (up to 20 minutes each), driven by hand in
            our desktop app, on the {freeTier.archetypeAccess}.
          </p>
          <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
            No hourly charges and no usage counting. Start as many iPhone
            Safari sessions as you like, one after another.
            Move up to a paid tier when you need more. That could be the
            API, every device type, or longer sessions. It could also be
            more profiles, more sessions at the same time, or the AI agent.
            Paid tiers also let sessions go out through your own VPN
            connection, not just a proxy.
          </p>
          <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
            The desktop app is available for macOS, Windows and Linux. It
            isn't yet signed with Apple or Microsoft, so your computer may show
            a security warning the first time you open it — this is expected.
            <a
              href="https://github.com/driftstackdev/driftstack-api/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
              class="accent-link"
              >Download the desktop app</a
            >.
          </p>
          <ul class="mt-4 space-y-1.5 text-sm text-tk-ink-2">
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span>
              {/* The sentence is wrapped so this <li> has exactly TWO flex items.
                  Left unwrapped, the inline <a> becomes its own flex item and the
                  word space before it stops existing as text — it survives only as
                  `gap`, which rendered as "Apple'sWebKit". The sibling bullets are
                  safe only because they contain no inline link. */}
              <span>
                A build of Apple's own <a href="/glossary/#webkit" class="accent-link">WebKit</a> — the engine family behind iPhone Safari. Not an emulator, and no add-on scripts to disguise it.
              </span>
            </li>
            {/* S26 2026-07-06 (#132) — accuracy fix (audit M2): this
                 bullet previously promised the "same code library
                 (SDK) as the paid tiers", but the free tier is
                 manual-only — apiAccess: false in
                 packages/api-types/src/common.ts TIER_FEATURES (no
                 usable API keys, no REST/SDK access from code).
                 Wording now matches the faq.ts free-tier answer.
                 2026-09-15: API access is on EVERY paid tier
                 (TIER_FEATURES apiAccess: true across the paid ladder),
                 so "starts with the API plans" was itself wrong. The
                 bullet now also states the free tier's proxy-only egress
                 (vpnEgress: false gates only the openvpn/wireguard
                 schemes — routes/account-me.ts — so the one saved proxy
                 per PROXIES_PER_TIER may be SOCKS5 or HTTP; 2026-09-15
                 refuter) and the AI-agent gate (aiAgent:
                 false on Free and Personal). */}
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span> The same desktop app as the paid plans, but you drive
              every session by hand:
              no API or SDK access, and no VPN. Free sessions reach the
              internet through a connection you supply: one saved proxy,
              either SOCKS5 or HTTP. A site then sees that address instead
              of ours. Paid plans add the API, and let you use your own VPN
              (OpenVPN or WireGuard) instead of a proxy.
            </li>
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span> Never expires — no time limit, no credits to run out.
            </li>
            <li class="flex gap-2">
              <span class="arrow-bullet">›</span> No AI agent on the free plan — it starts at Team, and is
              on every API plan.
            </li>
          </ul>
        </div>
        {/* 2026-09-25 — the two actions sit at the top of the card, level
            with its title and the same width, instead of floating at the
            card's vertical middle. */}
        <div class="flex flex-col gap-3 md:ml-auto md:w-48">
          <a href="https://app.driftstack.io/signup/" class="btn-primary w-full"
            >Get started free</a
          >
          <a href="https://docs.driftstack.io" class="btn-secondary w-full"
            >Read the docs</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning band -->
  <section id="no-overages" class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <p class="text-2xl font-medium tracking-tight text-tk-ink md:text-3xl">
        Browser plans are priced by how many sessions you can run at the same time.
        <span class="text-tk-ink-3"
          >Use as many hours as you want within that limit.</span
        > No extra bills for browser usage.
      </p>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-2">
        <strong class="text-tk-ink">Sessions at the same time</strong> is what
        you pay for. Think of browser tabs you keep open at once. It is also
        called "concurrent sessions". Hours, API calls and page visits
        inside that limit are unlimited. The optional AI agent with
        Driftstack-supplied AI access (the "bundled" option) has its own
        monthly budget, explained below, separate from your browser
        subscription.
      </p>
    </div>
  </section>

  <!-- V-502 — decision helper between the free-tier hero and the
       monthly/annual toggle. Band A fork question ("who drives the
       sessions?") + two anchor cards into the ladders + a quieter
       both-workflows card, then the 8-tier prose teaser ladder. -->
  <section
    id="which-tier"
    aria-label="Which tier is right for me?"
    class="border-t border-tk-border bg-tk-surface"
  >
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="section-label">Pick your tier</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-tk-ink sm:text-3xl">
        Which tier is right for me?
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-tk-ink-2">
        One question decides most of it: who drives the sessions — a person
        clicking, or code calling?
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <a href="#manual" class="card block p-8">
          <div class="flex items-center gap-3">
            <IconTile>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="7" r="4"></circle>
                <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"></path>
              </svg>
            </IconTile>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">Manual</p>
          </div>
          <h3 class="mt-5 text-xl font-semibold tracking-tight text-tk-ink sm:text-2xl">
            A person → Manual.
          </h3>
          <p class="mt-3 text-sm leading-6 text-tk-ink-2">
            You drive iPhones by hand in the desktop app. Open a profile,
            click around, keep logins alive. No code anywhere. Tiers differ
            by how many sessions run at the same time and how many profiles
            you keep.
          </p>
          <p class="mt-5 text-sm font-medium text-tk-accent-text">See Manual tiers ↓</p>
        </a>
        <a href="#api" class="card block p-8">
          <div class="flex items-center gap-3">
            <IconTile>
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </IconTile>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">API</p>
          </div>
          <h3 class="mt-5 text-xl font-semibold tracking-tight text-tk-ink sm:text-2xl">
            Code → API.
          </h3>
          <p class="mt-3 text-sm leading-6 text-tk-ink-2">
            Your scripts and automated jobs run the sessions. Start them from
            TypeScript, Python, or Go and read back what they find. Tiers
            differ by how many sessions run at the same time.
          </p>
          <p class="mt-5 text-sm font-medium text-tk-accent-text">See API tiers ↓</p>
        </a>
      </div>
      <div class="panel mt-6 md:flex md:items-center md:justify-between md:gap-8">
        <div>
          <h3 class="text-base font-semibold text-tk-ink">Both? Neither yet? Start free.</h3>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-tk-ink-2">
            Both plan families give you the same real iPhones and share the same free tier.
            Start free and drive a session by hand; the API and SDKs come with
            any paid plan, so you can try code-driven sessions the moment you
            upgrade.
          </p>
        </div>
        <a href="#free" class="btn-secondary mt-4 shrink-0 md:mt-0">Start free ↑</a>
      </div>

      <p class="mt-12 max-w-2xl text-sm leading-6 text-tk-ink-2">
        Every paid tier gives you every device type we offer. That is 19 iPhone
        models, from the 13 to the 17 Pro Max — {DEVICE_SUPPORT.selectableCount} device
        types in total. They run iOS 18, with Safari {DEVICE_SUPPORT.safariVersions}.
        Every paid tier also includes API access, and lets sessions go out
        through your own VPN connection.
        The free tier runs the
        {freeTier.archetypeAccess}. Paying more buys more sessions at the same
        time, more saved profiles, and the AI agent (Team and up, and every API
        plan). Upgrade any time and you only pay the difference for the rest
        of your billing period. Downgrades take effect at your next renewal.
      </p>
      <p class="mt-3 text-sm text-tk-ink-2">
        Need every dimension side-by-side?
        <a
          href="/pricing/comparison/"
          class="accent-link font-medium"
          >See the per-tier comparison →</a
        >
      </p>

      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        <li class="card border-tk-accent/40 p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-accent-text">
            Just looking
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">
            Free — $0, forever
          </h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            One profile and one session at a time, up to 20 minutes, on the
            {freeTier.archetypeAccess}. No card required. Start here if you
            want to click around a real iPhone in the cloud before you pay
            for anything.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            One person, by hand
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Personal — $79/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            One person clicking in the desktop app; up to 10 saved profiles.
            Run 1 session at a time across 10 different client identities.
            Built for sneaker resellers, sole traders doing their own
            compliance work, and individual researchers. Every device type and
            API access are included, and sessions can go out through your own
            VPN connection. The AI agent is not on this plan.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Small team, by hand
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Team — $249/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            3 sessions at the same time; 50 profiles, shared with the
            teammates you invite. Built for account managers who keep several
            client identities open at once. AI agent available (bring your own
            Anthropic key).
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Big team, by hand
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Agency — $699/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            8 sessions at the same time; 200 profiles. Built for marketing
            agencies, compliance teams and legal teams juggling many client
            identities at once.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            One developer, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Starter — $149/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Your code runs the sessions: 2 at the same time, 25 profiles.
            Built for solo developers writing test automation or early
            scrapers. AI agent available (bring your own Anthropic key).
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Production, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Builder — $499/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            8 sessions at the same time; 100 profiles. Built for production
            automation, and for CI test suites that need real iPhone Safari.
            A CI test suite is the set of checks that run automatically on
            every code change. AI agent with your own key, or with
            Driftstack-provided AI access under a monthly budget you set.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            High volume, code
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">API Scale — $1,499/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            24 sessions at the same time; 500 profiles. Built for high-volume
            automation teams and agencies running jobs across many sites at
            once. AI agent with your own key, or with Driftstack-provided AI
            access.
          </p>
        </li>
        <li class="card p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-tk-ink-3">
            Custom contract
          </p>
          <h3 class="mt-2 font-medium text-tk-ink">Enterprise — from $4,000/mo</h3>
          <p class="mt-2 text-sm text-tk-ink-2">
            Annual contracts only. Custom limits on sessions at the same time
            and on profiles, plus custom device types. Tailored reply-time
            commitments (SLA) and data-protection agreements (DPA). For
            regulated industries such as finance and healthcare that need
            custom paperwork or a dedicated account manager.
          </p>
        </li>
      </ul>

      <p class="mt-8 max-w-3xl text-sm text-tk-ink-2">
        Need to run on your own hardware — for a regulated industry, machines
        with no internet connection, or a custom device type?
        <a
          href="#self-hosted"
          class="accent-link"
          >See self-hosted plans</a
        >. They are priced as a software license, not like the monthly tiers
        above. That license includes source escrow: a copy of the code, held
        in trust for you by a third party.
      </p>
      <p class="mt-3 max-w-3xl text-sm text-tk-ink-2">
        Still deciding whether a real iPhone browser fits what you're doing?
        <a
          href="/faq/#architecture-sessions"
          class="accent-link"
          >Read the FAQ on how sessions work</a
        >.
      </p>
    </div>
  </section>

  <!-- Glossary line + monthly/annual toggle (controls both Manual + API tables) -->
  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-10">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        {/* Glossary for the ladders below. 2026-09-16: "sessions at the same
            time" is explained ONCE, in the positioning band above, and the
            tables then carry that phrase as their own row label — so this line
            defines only the terms the tables use without explaining
            themselves. Same browser-tabs metaphor as the homepage metering
            band. 2026-09-16 (2nd pass): "device type" joined them. The ladder
            row label was already "Device types" and the gloss lived only on
            /pricing/comparison, so on THIS page the term met the reader
            undefined — next to a "Saved profiles" row, with the prose calling
