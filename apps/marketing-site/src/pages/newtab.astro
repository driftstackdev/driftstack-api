---
// Branded new-tab page (founder 2026-06-25: "our own blank about:me page
// instead of nothing"). Served at https://driftstack.io/newtab and opened by
// the GUI simulator's "+" new-tab action (apps/gui-client SimulatorWindow
// NEW_TAB_URL) so a fresh tab shows an on-brand Driftstack page instead of the
// box rendering a literally-empty about:blank.
//
// DELIBERATELY self-contained — NO BaseLayout (which pulls the Header/Footer,
// JSON-LD, and OG chrome). This page must load INSTANTLY inside the streamed
// iPhone: brand tokens are inlined, the mark is an inline SVG, the font falls
// back to the system stack, and there is exactly one tiny inline <script> for
// the search/URL submit. No webfonts, no images, no external CSS — a single
// HTML document.
//
// The centered field navigates on submit: a typed value with no scheme gets
// https:// prefixed; anything that doesn't look like a URL becomes a Google
// search (mirrors the GUI omnibox + a real browser new-tab page). It sets
// window.location so the navigation happens IN the streamed tab.
//
// 2026-09-24 (owner item 6: "the HTTP/3 always show still as ; Not detected, this
// whole might need a upgrade as well") — the panel under the field is a small
// CONNECTION CHECK: what any website can see about this tab's connection, each
// row measured in this tab. Diagnostics only: it shows what is visible and
// changes nothing about it. ROOT CAUSE of "HTTP/3: Not detected", measured with a
// real browser against the live page on a direct connection (no proxy at all):
//   1. The page only looked at its FIRST loads. A browser's first contact with a
//      site is over TCP; it learns from the response (`alt-svc: h3=":443"`) that
//      the site offers HTTP/3 and uses it from the NEXT request on. The
//      navigation and the one trace fetch were h2; a second fetch was h3.
//   2. Its test could not match the value it read: Cloudflare's trace spells the
//      protocol `http=http/3`, and the page tested `/h3|quic/` — no "h3" in
//      "http/3" — so even a trace that arrived over HTTP/3 read "Not detected",
//      while the Connection row above it said "HTTP/3".
// The check below fixes both: it reads every one of this page's own loads (the
// navigation and each trace fetch's `nextHopProtocol`, and the trace's own
// `http=`), and after the first load it asks again, when the browser has
// learned the site offers HTTP/3. Through a proxy the answer is still only "yes"
// when the connection carries UDP — which is exactly the fact worth showing.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060608" />
    <meta name="robots" content="noindex,nofollow" />
    <title>New Tab · Driftstack</title>
    <style>
      /* Inline copy of the dark+oxblood tokens — keep the values in sync with
         the internal 2026-07-03 design-system v2 dashboard notes (marketing's
         --ink-3 deliberately runs #8c8c96, not the dashboard's #73737f — AA
         on #060608; see apps/marketing-site/src/styles/base.css). */
      :root {
        --bg: #060608;
        --surface: #14141a; /* S20 sync: dark layer-separation ladder (base.css) */
        --ink: #f5f5f7;
        --ink-2: #b0b0bb;
        --ink-3: #8c8c96;
        --border: #2c2c38; /* S20 sync */
        --accent: #9b3b46;
        --accent-2: #c04b58;
        --glow: rgba(155, 59, 70, 0.32);
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
      }
      body {
        background-color: var(--bg);
        background-image: radial-gradient(
          ellipse 90% 55% at 50% -10%,
          var(--glow),
          transparent 70%
        );
        color: var(--ink);
        font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        display: flex;
        min-height: 100%;
      }
      /* Centred by `margin: auto`, not by the body's align/justify: a flex item
         centred that way is cut off at the TOP (unscrollably) once it is taller
         than the window — the connection check made it so on short windows. */
      main {
        width: 100%;
        max-width: 520px;
        padding: 24px;
        margin: auto;
        text-align: center;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
        user-select: none;
      }
      .brand svg {
        width: 38px;
        height: 38px;
      }
      .wordmark {
        font-weight: 900;
        font-style: italic;
        font-size: 30px;
        letter-spacing: -0.02em;
      }
      .wordmark .stack {
        color: var(--accent-2);
      }
      form {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 4px 6px 4px 14px;
        box-shadow: 0 8px 30px -12px var(--glow);
        transition:
          border-color 0.18s ease,
          box-shadow 0.18s ease;
      }
      form:focus-within {
        border-color: rgba(192, 75, 88, 0.55);
        box-shadow: 0 10px 36px -10px var(--glow);
      }
      .search-icon {
        flex: none;
        color: var(--ink-3);
      }
      input {
        flex: 1 1 auto;
        min-width: 0;
        background: transparent;
        border: 0;
        outline: 0;
        color: var(--ink);
        font-size: 16px;
        font-family: inherit;
        padding: 12px 0;
      }
      input::placeholder {
        color: var(--ink-3);
      }
      button {
        flex: none;
        appearance: none;
        border: 0;
        cursor: pointer;
        background: var(--accent);
        color: #fff;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        border-radius: 10px;
        padding: 10px 16px;
        transition: background 0.16s ease;
      }
      button:hover {
        background: var(--accent-2);
      }
      .hint {
        margin-top: 18px;
        color: var(--ink-3);
        font-size: 12.5px;
      }
      /* The connection check — what any website can see about this tab's
         connection, each row measured in this tab (see the note at the top). */
      .conn {
        margin-top: 26px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
        text-align: left;
      }
      .conn-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--border);
        color: var(--ink-2);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      .conn-head .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #35c26b;
        box-shadow: 0 0 8px rgba(53, 194, 107, 0.6);
      }
      .conn-head .again {
        margin-left: auto;
        background: transparent;
        color: var(--ink-2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
      }
      .conn-head .again:hover {
        background: var(--border);
        color: var(--ink);
      }
      .info-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        padding: 10px 16px;
      }
      .info-row + .info-row {
        border-top: 1px solid var(--border);
      }
      .info-label {
        color: var(--ink-3);
        font-size: 13px;
        flex: none;
        padding-top: 1px;
      }
      .info-cell {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 3px;
        min-width: 0;
      }
      .info-value {
        color: var(--ink);
        font-size: 13.5px;
        font-weight: 500;
        text-align: right;
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
      }
      .info-note {
        color: var(--ink-3);
        font-size: 12px;
        text-align: right;
        overflow-wrap: anywhere;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
      }
      .badge.on {
        color: #7ee2a8;
        background: rgba(53, 194, 107, 0.14);
      }
      .badge.off {
        color: var(--ink-2);
        background: rgba(140, 140, 150, 0.14);
      }
      .badge.warn {
        color: #f5c56b;
        background: rgba(245, 197, 107, 0.14);
      }
      .muted {
        color: var(--ink-3);
      }
      .conn-foot {
        padding: 9px 16px 11px;
        border-top: 1px solid var(--border);
        color: var(--ink-3);
        font-size: 11.5px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">
        <svg viewBox="0 0 256 256" fill="none" aria-label="Driftstack">
          <rect
            x="46"
            y="30"
            width="118"
            height="194"
            rx="34"
            fill="none"
            stroke="#474a55"
            stroke-width="14"
            opacity="0.55"
            transform="rotate(-7 105 127)"></rect>
          <rect x="86" y="30" width="118" height="194" rx="34" fill="#9b3b46"></rect>
          <circle cx="145" cy="192" r="12" fill="#ffffff"></circle>
        </svg>
        <span class="wordmark">DRIFT<span class="stack">STACK</span></span>
      </div>
      <form id="newtab-search" autocomplete="off">
        <svg
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <!-- No autofocus and no focus() on load: the first tap must be a real focus so the on-screen keyboard opens. -->
        <input
          id="newtab-input"
          type="text"
          name="q"
          placeholder="Search or enter address"
          aria-label="Search or enter address"
          spellcheck="false"
        />
        <button type="submit">Go</button>
      </form>
      <section class="conn" aria-label="Connection check">
        <div class="conn-head">
          <span class="dot"></span>What websites can see
          <button type="button" class="again" id="conn-again">Check again</button>
        </div>
        <div class="info-row">
          <span class="info-label">IP address</span>
          <span class="info-cell"><span class="info-value" id="v-ip">…</span></span>
        </div>
        <div class="info-row">
          <span class="info-label">Location</span>
          <span class="info-cell"><span class="info-value" id="v-loc">…</span></span>
        </div>
        <div class="info-row">
          <span class="info-label">Time zone</span>
          <span class="info-cell">
            <span class="info-value" id="v-tz">…</span>
            <span class="info-note" id="v-tz-check"></span>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Language</span>
          <span class="info-cell">
            <span class="info-value" id="v-lang">…</span>
            <span class="info-note" id="v-lang-check"></span>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">WebRTC</span>
          <span class="info-cell">
            <span class="info-value" id="v-webrtc"><span class="badge off">Checking…</span></span>
            <span class="info-note" id="v-webrtc-note"></span>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Connection</span>
          <span class="info-cell">
            <span class="info-value" id="v-proto">…</span>
            <span class="info-note" id="v-rtt"></span>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">HTTP/3 (QUIC)</span>
          <span class="info-cell">
            <span class="info-value" id="v-quic"><span class="badge off">Checking…</span></span>
            <span class="info-note" id="v-quic-note"></span>
          </span>
        </div>
        <div class="conn-foot">
          Checked in this tab, through this profile's connection. Nothing here is changed — it only
          shows what a site can see.
        </div>
      </section>
    </main>
    <script is:inline>
      (function () {
        var form = document.getElementById('newtab-search');
        var input = document.getElementById('newtab-input');
        // Resolve a typed entry to a destination URL. A value that parses as a
        // HTTP(S) and host-like values navigate directly — prefixing https://
        // when no scheme is present. Unsupported schemes become a Google
        // search instead of executing in this page's Driftstack origin.
        function resolve(raw) {
          var v = (raw || '').trim();
          if (v === '') return null;
          if (/^https?:\/\//i.test(v)) return v;
          if (/^[a-z][a-z0-9+.-]*:/i.test(v) && v.indexOf('localhost') !== 0) {
            return 'https://www.google.com/search?q=' + encodeURIComponent(v);
          }
          var looksLikeHost =
            /^[^\s]+\.[^\s]{2,}(\/[^\s]*)?$/.test(v) || v.indexOf('localhost') === 0;
          if (looksLikeHost) return 'https://' + v;
          return 'https://www.google.com/search?q=' + encodeURIComponent(v);
        }
        // The guard is scoped to the thing it guards. It used to sit at the top
        // of this function and return early, which also skipped the connection
        // panel below — so a markup change that renamed or conditionally
        // rendered the search box would have left every info field reading
        // "Checking..." forever, with no error anywhere.
        if (form && input) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var dest = resolve(input.value);
            if (dest !== null) window.location.assign(dest);
          });
        }

        // ── The connection check ─────────────────────────────────────────────
        // What any website can see about this tab's connection. Every row is
        // measured here, in this tab, through the profile's connection; a row
        // that cannot be read says so rather than breaking the tab.
        function el(id) {
          return document.getElementById(id);
        }
        function set(id, text) {
          var e = el(id);
          if (e) e.textContent = text;
        }
        function badge(id, tone, text) {
          var e = el(id);
          if (!e) return;
          e.textContent = '';
          var b = document.createElement('span');
          b.className = 'badge ' + tone;
          b.textContent = text;
          e.appendChild(b);
        }
        function flag(cc) {
          if (!cc || cc.length !== 2 || !/^[A-Za-z]{2}$/.test(cc)) return '';
          var base = 0x1f1e6;
          return (
            String.fromCodePoint(base + (cc.toUpperCase().charCodeAt(0) - 65)) +
            String.fromCodePoint(base + (cc.toUpperCase().charCodeAt(1) - 65))
          );
        }
        // Normalise every spelling a protocol arrives in: `h3` / `h2` (Resource
        // Timing's nextHopProtocol) and `http/3` / `http/2` (Cloudflare's trace).
        // ⛔ The old test was /h3|quic/, which cannot match "http/3".
        function protoKey(p) {
          p = String(p || '').toLowerCase();
          if (p === 'h3' || p.indexOf('h3-') === 0 || p === 'http/3' || p.indexOf('quic') !== -1)
            return 'h3';
          if (p === 'h2' || p === 'http/2' || p === 'http/2.0') return 'h2';
          if (p.indexOf('http/1') === 0) return 'h1';
          return '';
        }
        var PROTO_LABEL = { h3: 'HTTP/3', h2: 'HTTP/2', h1: 'HTTP/1.1' };
        function parseTrace(t) {
          var m = {};
          String(t)
            .trim()
            .split('\n')
            .forEach(function (line) {
              var i = line.indexOf('=');
              if (i > 0) m[line.slice(0, i)] = line.slice(i + 1);
            });
          return m;
        }
        // Resource Timing for one of this page's own requests (same origin, so
        // nextHopProtocol is readable). '' when the browser does not report it.
        function hopOf(path) {
          try {
            var url = new URL(path, location.href).href;
            var list = performance.getEntriesByName ? performance.getEntriesByName(url) : [];
            var e = list && list[list.length - 1];
            return (e && e.nextHopProtocol) || '';
          } catch (err) {
            return '';
          }
        }
        function navHop() {
          try {
            var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
            return (nav && nav.nextHopProtocol) || '';
          } catch (err) {
            return '';
          }
        }
        // Every protocol this page's loads used so far — the navigation, and
        // each trace fetch by its own timing entry AND by what the site saw.
        var seen = { h1: false, h2: false, h3: false };
        function note(p) {
          var k = protoKey(p);
          if (k) seen[k] = true;
        }
        function bounded(url, ms, method) {
          var c = new AbortController();
          var t = window.setTimeout(function () {
            c.abort();
          }, ms);
          return fetch(url, {
            method: method || 'GET',
            cache: 'no-store',
            signal: c.signal,
            credentials: 'omit',
          }).finally(function () {
            window.clearTimeout(t);
          });
        }

        // Time zone + local time + language — instant, no network.
        var browserTz = '';
        try {
          browserTz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          var off = -new Date().getTimezoneOffset();
          var sign = off >= 0 ? '+' : '-';
          var a = Math.abs(off);
          var pad = function (n) {
            return (n < 10 ? '0' : '') + n;
          };
          var offStr = 'UTC' + sign + pad(Math.floor(a / 60)) + ':' + pad(a % 60);
          var localTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          set('v-tz', (browserTz || '—') + ' · ' + offStr + ' · ' + localTime);
        } catch (e) {
          set('v-tz', '—');
        }
        var langs = [];
        try {
          langs = (navigator.languages && navigator.languages.length
            ? Array.prototype.slice.call(navigator.languages)
            : [navigator.language]
          ).filter(function (x) {
            return !!x;
          });
        } catch (e) {}
        set('v-lang', langs.length ? langs.slice(0, 3).join(', ') : '—');

        // What the site's own edge sees, and the exit's place. Filled in as the
        // answers arrive; the consistency lines are drawn once both are known.
        var exit = { ip: '', country: '', tz: '', city: '', region: '' };

        // Same wall-clock time now in two zones = the same offset, whatever the
        // zones are called (Europe/Amsterdam and Europe/Berlin agree).
        function sameClock(tzA, tzB) {
          try {
            var now = new Date();
            var o = { timeZone: tzA, hour: '2-digit', minute: '2-digit', hour12: false };
            var p = { timeZone: tzB, hour: '2-digit', minute: '2-digit', hour12: false };
            return now.toLocaleTimeString('en-US', o) === now.toLocaleTimeString('en-US', p);
          } catch (e) {
            return false;
          }
        }
        function drawConsistency() {
          if (exit.tz && browserTz) {
            if (exit.tz === browserTz) set('v-tz-check', '✓ Matches your IP address’s location');
            else if (sameClock(exit.tz, browserTz))
              set('v-tz-check', '✓ Same time as your IP address’s location (' + exit.tz + ')');
            else set('v-tz-check', '⚠ Your IP address is in ' + exit.tz);
          }
          if (exit.country && langs.length) {
            var cc = exit.country.toUpperCase();
            var match = langs.some(function (l) {
              var parts = String(l).split('-');
              return parts.length > 1 && parts[parts.length - 1].toUpperCase() === cc;
            });
            set(
              'v-lang-check',
              match ? '✓ Matches your IP address’s country' : 'Your IP address is in ' + cc,
            );
          }
        }
        function drawLocation() {
          var place = [exit.city, exit.region].filter(function (x) {
            return !!x;
          });
          var cc = exit.country ? (flag(exit.country) + ' ' + exit.country).trim() : '';
          if (place.length) set('v-loc', place.join(', ') + (cc ? ' · ' + cc : ''));
          else set('v-loc', cc || '—');
        }

        // ── HTTP/3 ─────────────────────────────────────────────────────────
        // A first contact is over TCP. The browser learns from that response
        // (the page's own `alt-svc` header) that the site offers HTTP/3 and
        // tries it from the next request on — so this page asks again, a moment
        // apart, before calling it: once for the page itself (which also tells
        // us whether the site offers HTTP/3 at all), then the trace.
        var offersH3 = false;
        function checkOffer() {
          var path = location.pathname + '?h3=offer';
          return bounded(path, 3000, 'HEAD')
            .then(function (r) {
              try {
                offersH3 = /h3/i.test(r.headers.get('alt-svc') || '');
              } catch (e) {}
              note(hopOf(path));
            })
            .catch(function () {});
        }
        function drawQuic(done) {
          if (seen.h3) {
            badge('v-quic', 'on', '✓ In use');
            set('v-quic-note', 'This page reached the site over QUIC (UDP).');
            return;
          }
          if (!done) return;
          // "Not in use" only on evidence: at least one load that reported TCP
          // (HTTP/1.1 or HTTP/2). With no reading at all — every trace failed and
          // the timing reported nothing — the page does not know, and says so.
          if (!seen.h1 && !seen.h2) {
            badge('v-quic', 'off', 'Could not be checked');
            set('v-quic-note', 'None of this page’s loads reported which protocol it used.');
            return;
          }
          badge('v-quic', 'off', 'Not in use');
          set(
            'v-quic-note',
            offersH3
              ? 'The site offers HTTP/3, but this connection stayed on TCP — usually because UDP does not get through.'
              : 'This page’s loads used TCP.',
          );
        }
        function drawProto(tls, done) {
          var k = seen.h3 ? 'h3' : seen.h2 ? 'h2' : seen.h1 ? 'h1' : '';
          var label = PROTO_LABEL[k] || (done ? 'Could not be checked' : 'Checking…');
          set('v-proto', label + (k && tls ? ' · ' + tls : ''));
        }
        function probeH3(n, tls) {
          if (seen.h3 || n <= 0) {
            drawProto(tls, true);
            drawQuic(true);
            return;
          }
          window.setTimeout(function () {
            var path = '/cdn-cgi/trace?h3=' + n;
            bounded(path, 3000)
              .then(function (r) {
                return r.ok ? r.text() : '';
              })
              .then(function (t) {
                note(parseTrace(t).http);
                note(hopOf(path));
              })
              .catch(function () {})
              .then(function () {
                probeH3(n - 1, tls);
              });
          }, 250);
        }

        note(navHop());

        // Same-origin Cloudflare trace → exit IP, country, the protocol the site
        // saw, TLS. Kept bounded: the new-tab page is also the Simulator's
        // recovery surface, so a stalled edge request must not leave "Checking…"
        // on screen forever.
        var traceController = new AbortController();
        var traceTimeout = window.setTimeout(function () {
          traceController.abort();
        }, 5000);
        fetch('/cdn-cgi/trace', { cache: 'no-store', signal: traceController.signal })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
          })
          .then(function (t) {
            var m = parseTrace(t);
            exit.ip = m.ip || '';
            if (!exit.country && m.loc) exit.country = m.loc;
            set('v-ip', m.ip || 'unavailable');
            drawLocation();
            drawConsistency();
            note(m.http);
            note(hopOf('/cdn-cgi/trace'));
            drawProto(m.tls);
            drawQuic(false);
            checkOffer().then(function () {
              probeH3(2, m.tls);
            });
            webrtcCheck();
          })
          .catch(function () {
            // The trace did not answer — fall back to what the page itself knows.
            set('v-ip', 'unavailable');
            drawLocation();
            drawProto('', true);
            drawQuic(true);
            webrtcCheck();
          })
          .finally(function () {
            window.clearTimeout(traceTimeout);
          });

        // The exit's city and time zone, from Driftstack's own echo of this
        // request (it answers with what its edge saw — no third-party lookup).
        bounded('https://api.driftstack.dev/v1/egress/echo', 4000)
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (j) {
            if (!j || typeof j !== 'object') return;
            if (typeof j.country === 'string') exit.country = j.country;
            if (typeof j.city === 'string') exit.city = j.city;
            if (typeof j.region === 'string') exit.region = j.region;
            if (typeof j.timezone === 'string') exit.tz = j.timezone;
            drawLocation();
            drawConsistency();
          })
          .catch(function () {});

        // ── WebRTC ─────────────────────────────────────────────────────────
        // The addresses a site can collect through WebRTC, compared with the IP
        // address above. Private and hidden (.local) addresses are not counted:
        // only a PUBLIC address other than the IP address is something a site
        // could see that it should not.
        var webrtcStarted = false;
        function isPublic(ip) {
          if (!ip || ip.indexOf('.local') !== -1) return false;
          if (ip.indexOf(':') !== -1) {
            var v6 = ip.toLowerCase();
            return !(
              v6 === '::1' ||
              v6.indexOf('fe80:') === 0 ||
              v6.indexOf('fc') === 0 ||
              v6.indexOf('fd') === 0
            );
          }
          var o = ip.split('.').map(Number);
          if (o.length !== 4 || o.some(isNaN)) return false;
          return !(
            o[0] === 10 ||
            o[0] === 127 ||
            o[0] === 0 ||
            (o[0] === 169 && o[1] === 254) ||
            (o[0] === 172 && o[1] >= 16 && o[1] <= 31) ||
            (o[0] === 192 && o[1] === 168) ||
            (o[0] === 100 && o[1] >= 64 && o[1] <= 127)
          );
        }
        function webrtcCheck() {
          if (webrtcStarted) return;
          webrtcStarted = true;
          var PC = window.RTCPeerConnection || window.webkitRTCPeerConnection;
          if (!PC) {
            badge('v-webrtc', 'on', '✓ Not available to sites');
            set('v-webrtc-note', 'WebRTC is not offered in this browser.');
            return;
          }
          var found = {};
          var finished = false;
          var pc;
          function finish() {
            if (finished) return;
            finished = true;
            try {
              pc.close();
            } catch (e) {}
            var ips = Object.keys(found);
            var others = ips.filter(function (x) {
              return x !== exit.ip;
            });
            if (!ips.length) {
              badge('v-webrtc', 'on', '✓ No address shown');
              set('v-webrtc-note', 'WebRTC gives sites no public address.');
            } else if (!others.length) {
              badge('v-webrtc', 'on', '✓ Same as your IP address');
              set('v-webrtc-note', 'WebRTC shows only the IP address above.');
            } else if (!exit.ip) {
              badge('v-webrtc', 'off', 'Shows ' + ips.join(', '));
              set('v-webrtc-note', 'The IP address could not be read to compare.');
            } else {
              badge('v-webrtc', 'warn', '⚠ Shows another address');
              set('v-webrtc-note', others.join(', ') + ' is visible to sites through WebRTC.');
            }
          }
          try {
            pc = new PC({ iceServers: [{ urls: 'stun:stun.cloudflare.com:3478' }] });
            pc.createDataChannel('check');
            pc.onicecandidate = function (e) {
              if (!e || !e.candidate) return finish();
              var parts = String(e.candidate.candidate || '').split(' ');
              var ip = parts[4];
              if (isPublic(ip)) found[ip] = true;
            };
            pc.createOffer()
              .then(function (o) {
                return pc.setLocalDescription(o);
              })
              .catch(finish);
            window.setTimeout(finish, 4000);
          } catch (e) {
            badge('v-webrtc', 'off', 'Could not be checked');
            set('v-webrtc-note', '');
          }
        }

        var again = el('conn-again');
        if (again) {
          again.addEventListener('click', function () {
            window.location.reload();
          });
        }
      })();
    </script>
  </body>
</html>
