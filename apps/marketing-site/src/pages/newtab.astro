---
// Branded new-tab page (founder 2026-06-25: "our own blank about:me page
// instead of nothing"). Served at https://driftstack.dev/newtab and opened by
// the GUI simulator's "+" new-tab action (apps/gui-client SimulatorWindow
// NEW_TAB_URL) so a fresh tab shows an on-brand Driftstack page instead of the
// box rendering a literally-empty about:blank.
//
// DELIBERATELY self-contained — NO BaseLayout (which pulls the Header/Footer,
// JSON-LD, and OG chrome). This page must load INSTANTLY inside the streamed
// iPhone: brand tokens are inlined, the mark is an inline SVG, the font falls
// back to the system stack, and there is exactly one tiny inline <script> for
// the search/URL submit. No webfonts, no images, no external CSS — a single
// HTML document.
//
// The centered field navigates on submit: a typed value with no scheme gets
// https:// prefixed; anything that doesn't look like a URL becomes a Google
// search (mirrors the GUI omnibox + a real browser new-tab page). It sets
// window.location so the navigation happens IN the streamed tab.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060608" />
    <meta name="robots" content="noindex,nofollow" />
    <title>New Tab · Driftstack</title>
    <style>
      /* Inline copy of the dark+oxblood tokens — keep the values in sync with
         docs/internal/2026-07-03-design-system-v2-dashboard.md (marketing's
         --ink-3 deliberately runs #8c8c96, not the dashboard's #73737f — AA
         on #060608; see apps/marketing-site/src/styles/base.css). */
      :root {
        --bg: #060608;
        --surface: #14141a; /* S20 sync: dark layer-separation ladder (base.css) */
        --ink: #f5f5f7;
        --ink-2: #b0b0bb;
        --ink-3: #8c8c96;
        --border: #2c2c38; /* S20 sync */
        --accent: #9b3b46;
        --accent-2: #c04b58;
        --glow: rgba(155, 59, 70, 0.32);
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
      }
      body {
        background-color: var(--bg);
        background-image: radial-gradient(
          ellipse 90% 55% at 50% -10%,
          var(--glow),
          transparent 70%
        );
        color: var(--ink);
        font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100%;
      }
      main {
        width: 100%;
        max-width: 520px;
        padding: 24px;
        text-align: center;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
        user-select: none;
      }
      .brand svg {
        width: 38px;
        height: 38px;
      }
      .wordmark {
        font-weight: 900;
        font-style: italic;
        font-size: 30px;
        letter-spacing: -0.02em;
      }
      .wordmark .stack {
        color: var(--accent-2);
      }
      form {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 4px 6px 4px 14px;
        box-shadow: 0 8px 30px -12px var(--glow);
        transition:
          border-color 0.18s ease,
          box-shadow 0.18s ease;
      }
      form:focus-within {
        border-color: rgba(192, 75, 88, 0.55);
        box-shadow: 0 10px 36px -10px var(--glow);
      }
      .search-icon {
        flex: none;
        color: var(--ink-3);
      }
      input {
        flex: 1 1 auto;
        min-width: 0;
        background: transparent;
        border: 0;
        outline: 0;
        color: var(--ink);
        font-size: 16px;
        font-family: inherit;
        padding: 12px 0;
      }
      input::placeholder {
        color: var(--ink-3);
      }
      button {
        flex: none;
        appearance: none;
        border: 0;
        cursor: pointer;
        background: var(--accent);
        color: #fff;
        font-family: inherit;
        font-size: 14px;
        font-weight: 600;
        border-radius: 10px;
        padding: 10px 16px;
        transition: background 0.16s ease;
      }
      button:hover {
        background: var(--accent-2);
      }
      .hint {
        margin-top: 18px;
        color: var(--ink-3);
        font-size: 12.5px;
      }
      /* Live "this device's network identity" panel — shows the customer exactly
         what a real site sees through their proxy (exit IP, spoofed timezone,
         whether the connection negotiated HTTP/3 over QUIC/UDP). All detected
         client-side + via the same-origin Cloudflare /cdn-cgi/trace echo. */
      .conn {
        margin-top: 26px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
        overflow: hidden;
        text-align: left;
      }
      .conn-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--border);
        color: var(--ink-2);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      .conn-head .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #35c26b;
        box-shadow: 0 0 8px rgba(53, 194, 107, 0.6);
      }
      .info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 10px 16px;
      }
      .info-row + .info-row {
        border-top: 1px solid var(--border);
      }
      .info-label {
        color: var(--ink-3);
        font-size: 13px;
        flex: none;
      }
      .info-value {
        color: var(--ink);
        font-size: 13.5px;
        font-weight: 500;
        text-align: right;
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
      }
      .badge.on {
        color: #7ee2a8;
        background: rgba(53, 194, 107, 0.14);
      }
      .badge.off {
        color: var(--ink-3);
        background: rgba(140, 140, 150, 0.14);
      }
      .muted {
        color: var(--ink-3);
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">
        <svg viewBox="0 0 256 256" fill="none" aria-label="Driftstack">
          <rect
            x="46"
            y="30"
            width="118"
            height="194"
            rx="34"
            fill="none"
            stroke="#474a55"
            stroke-width="14"
            opacity="0.55"
            transform="rotate(-7 105 127)"></rect>
          <rect x="86" y="30" width="118" height="194" rx="34" fill="#9b3b46"></rect>
          <circle cx="145" cy="192" r="12" fill="#ffffff"></circle>
        </svg>
        <span class="wordmark">DRIFT<span class="stack">STACK</span></span>
      </div>
      <form id="newtab-search" autocomplete="off">
        <svg
          class="search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="newtab-input"
          type="text"
          name="q"
          placeholder="Search or enter address"
          aria-label="Search or enter address"
          spellcheck="false"
          autofocus
        />
        <button type="submit">Go</button>
      </form>
      <section class="conn" aria-label="Connection details">
        <div class="conn-head"><span class="dot"></span>This device, as sites see it</div>
        <div class="info-row">
          <span class="info-label">IP address</span>
          <span class="info-value" id="v-ip">…</span>
        </div>
        <div class="info-row">
          <span class="info-label">Location</span>
          <span class="info-value" id="v-loc">…</span>
        </div>
        <div class="info-row">
          <span class="info-label">Time zone</span>
          <span class="info-value" id="v-tz">…</span>
        </div>
        <div class="info-row">
          <span class="info-label">Language</span>
          <span class="info-value" id="v-lang">…</span>
        </div>
        <div class="info-row">
          <span class="info-label">Connection</span>
          <span class="info-value" id="v-proto">…</span>
        </div>
        <div class="info-row">
          <span class="info-label">UDP / QUIC</span>
          <span class="info-value" id="v-quic"><span class="badge off">Checking…</span></span>
        </div>
      </section>
    </main>
    <script is:inline>
      (function () {
        var form = document.getElementById('newtab-search');
        var input = document.getElementById('newtab-input');
        // Resolve a typed entry to a destination URL. A value that parses as a
        // HTTP(S) and host-like values navigate directly — prefixing https://
        // when no scheme is present. Unsupported schemes become a Google
        // search instead of executing in this page's Driftstack origin.
        function resolve(raw) {
          var v = (raw || '').trim();
          if (v === '') return null;
          if (/^https?:\/\//i.test(v)) return v;
          if (/^[a-z][a-z0-9+.-]*:/i.test(v) && v.indexOf('localhost') !== 0) {
            return 'https://www.google.com/search?q=' + encodeURIComponent(v);
          }
          var looksLikeHost =
            /^[^\s]+\.[^\s]{2,}(\/[^\s]*)?$/.test(v) || v.indexOf('localhost') === 0;
          if (looksLikeHost) return 'https://' + v;
          return 'https://www.google.com/search?q=' + encodeURIComponent(v);
        }
        // The guard is scoped to the thing it guards. It used to sit at the top
        // of this function and return early, which also skipped the connection
        // panel below — so a markup change that renamed or conditionally
        // rendered the search box would have left every info field reading
        // "Checking..." forever, with no error anywhere.
        if (form && input) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var dest = resolve(input.value);
            if (dest !== null) window.location.assign(dest);
          });
        }

        // ── Live connection panel ────────────────────────────────────────────
        // Shows what a real website sees about this simulated device: exit IP +
        // country, the (spoofed) browser time zone + language, and whether the
        // connection to the edge negotiated HTTP/3 over QUIC/UDP. Everything is
        // detected in-page; IP/country/protocol come from the same-origin
        // Cloudflare /cdn-cgi/trace echo (goes through the session's proxy, so
        // the IP IS the proxy exit). All best-effort — a field that can't be
        // read shows "—" rather than breaking the tab.
        function set(id, text) {
          var el = document.getElementById(id);
          if (el) el.textContent = text;
        }
        function flag(cc) {
          if (!cc || cc.length !== 2 || !/^[A-Za-z]{2}$/.test(cc)) return '';
          var base = 0x1f1e6;
          return (
            String.fromCodePoint(base + (cc.toUpperCase().charCodeAt(0) - 65)) +
            String.fromCodePoint(base + (cc.toUpperCase().charCodeAt(1) - 65))
          );
        }
        function protoLabel(p) {
          p = (p || '').toLowerCase();
          if (p === 'h3' || p.indexOf('http/3') === 0 || p.indexOf('quic') !== -1)
            return 'HTTP/3 · QUIC over UDP';
          if (p === 'h2' || p.indexOf('http/2') === 0) return 'HTTP/2 · TCP';
          if (p.indexOf('http/1') === 0 || p === 'http/1.1') return 'HTTP/1.1 · TCP';
          return p ? p : '—';
        }
        function setQuic(on) {
          var el = document.getElementById('v-quic');
          if (!el) return;
          el.innerHTML =
            '<span class="badge ' +
            (on ? 'on' : 'off') +
            '">' +
            (on ? '✓ Supported' : '✗ Not detected') +
            '</span>';
        }

        // Time zone + local time + language — instant, no network.
        try {
          var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '—';
          var off = -new Date().getTimezoneOffset();
          var sign = off >= 0 ? '+' : '-';
          var a = Math.abs(off);
          var pad = function (n) {
            return (n < 10 ? '0' : '') + n;
          };
          var offStr = 'UTC' + sign + pad(Math.floor(a / 60)) + ':' + pad(a % 60);
          var localTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          set('v-tz', tz + ' · ' + offStr + ' · ' + localTime);
        } catch (e) {
          set('v-tz', '—');
        }
        set('v-lang', navigator.language || '—');

        // Fast secondary protocol signal from the navigation timing entry.
        var hop = '';
        try {
          var navEntry =
            performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          hop = (navEntry && navEntry.nextHopProtocol) || '';
        } catch (e) {}

        // Same-origin Cloudflare trace → exit IP, country, negotiated protocol, TLS.
        // Keep this diagnostic bounded: the new-tab page is also the Simulator's
        // recovery surface, so a stalled edge request must not leave "Checking…"
        // on screen forever.
        var traceController = new AbortController();
        var traceTimeout = window.setTimeout(function () {
          traceController.abort();
        }, 5000);
        fetch('/cdn-cgi/trace', { cache: 'no-store', signal: traceController.signal })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
          })
          .then(function (t) {
            var m = {};
            String(t)
              .trim()
              .split('\n')
              .forEach(function (line) {
                var i = line.indexOf('=');
                if (i > 0) m[line.slice(0, i)] = line.slice(i + 1);
              });
            set('v-ip', m.ip || 'unavailable');
            set('v-loc', m.loc ? (flag(m.loc) + ' ' + m.loc).trim() : '—');
            var proto = m.http || hop;
            set('v-proto', protoLabel(proto) + (m.tls ? ' · ' + m.tls : ''));
            setQuic(/h3|quic/i.test(proto) || hop === 'h3');
          })
          .catch(function () {
            // Proxy/edge didn't return trace — fall back to what the page itself knows.
            set('v-ip', 'unavailable');
            set('v-loc', '—');
            set('v-proto', protoLabel(hop));
            setQuic(hop === 'h3');
          })
          .finally(function () {
            window.clearTimeout(traceTimeout);
          });
      })();
    </script>
  </body>
</html>
