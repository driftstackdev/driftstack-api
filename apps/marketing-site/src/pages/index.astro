---
// Homepage v2 (2026-07-03) — "Plain Words, Same Teeth". The 2026-06
// Fleet homepage carried ~22 sections and spoke WebKit/SOCKS5 to
// non-technical operators in the first screens. This rebuild keeps every
// technical claim but moves each to the altitude where its reader lives:
//   Band A (hero → use cases): plain language, zero unexplained jargon.
//   Band B (mid-page): big plain line + small mono technical line.
//   Band C (// FOR DEVELOPERS + deep pages): full precision.
// 13 sections. Verbatim-preserved proof blocks: the fleet wall, the GUI
// cockpit, the detection matrix, the works-with-your-stack cards, and
// the real SDK snippet. Pricing figures are BOUND to src/data/pricing.ts
// (no hand-typed dollar amounts in this file).
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import IconTile from '../components/IconTile.astro';
import Stat from '../components/Stat.astro';
import FeatureRow from '../components/FeatureRow.astro';
import CtaBand from '../components/CtaBand.astro';
import CodeWindow from '../components/CodeWindow.astro';
import { API_TIERS } from '../data/pricing';

// W292.B-style data binding: every figure below derives from pricing.ts.
const fmtUsd = (n: number): string => `$${n.toLocaleString('en-US')}`;
const manualLadder = API_TIERS.filter((t) => t.tierType === 'manual');
const apiLadder = API_TIERS.filter((t) => t.tierType === 'api' && t.monthlyUsd !== null);
const manualFrom = fmtUsd(Math.min(...manualLadder.map((t) => t.monthlyUsd!)));
const apiFrom = fmtUsd(Math.min(...apiLadder.map((t) => t.monthlyUsd!)));
const manualLineup = manualLadder.map((t) => `${t.name} ${fmtUsd(t.monthlyUsd!)}/mo`).join(' · ');
const apiLineup = apiLadder.map((t) => `${t.name} ${fmtUsd(t.monthlyUsd!)}/mo`).join(' · ');
const manualCaps = manualLadder.map((t) => t.concurrent).join(' / ');
const apiCaps = apiLadder.map((t) => t.concurrent).join(' / ');

// Hero fleet fan — three open iPhone windows, drawn to match the current
// desktop GUI (phone-framed, LIVE/IDLE, dark+oxblood). Band A: cities
// spelled out, "own connection", no protocol jargon. example.com pages
// only (no real brands/URLs). Center phone is accent-lit + LIVE.
const heroFleet = [
  {
    name: 'us-retail-qa',
    live: true,
    site: 'market.example.com',
    wrap: 'z-10 -mr-5 rotate-[-8deg] translate-y-4 scale-[0.9]',
    center: false,
  },
  {
    name: 'amsterdam-shopper',
    live: true,
    site: 'shop.example.com',
    wrap: 'z-30',
    center: true,
  },
  {
    name: 'jp-market',
    live: false,
    site: '',
    wrap: 'z-10 -ml-5 rotate-[8deg] translate-y-4 scale-[0.9]',
    center: false,
  },
];

// Cockpit profile grid — the current GUI renders profiles as phone-framed
// cards (LIVE/IDLE, exit flag + country code). example.com only.
const cockpitProfiles = [
  { name: 'amsterdam-shopper', flag: '🇳🇱', cc: 'NL', live: true, center: true },
  { name: 'us-retail-qa', flag: '🇺🇸', cc: 'US', live: true, center: false },
  { name: 'jp-market', flag: '🇯🇵', cc: 'JP', live: false, center: false },
  { name: 'de-pricing', flag: '🇩🇪', cc: 'DE', live: true, center: false },
  { name: 'uk-checkout', flag: '🇬🇧', cc: 'GB', live: true, center: false },
];
---

<BaseLayout
  title="Driftstack"
  description="A real iPhone browser in the cloud that every website sees as a genuine iPhone — never a bot. Automate iPhone Safari from TypeScript, Python, Go, or a desktop app. Start free."
>
  <!-- ═══ 1 · HERO — Fleet mission control. Band A: the mockup metadata is
       de-jargoned (proxy protocol names → "own connection"; the telemetry
       footer reads like a person wrote it). Honest-claims: only real
       capabilities; generic professional telemetry. ═══ -->
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 sm:pb-24 sm:pt-24 md:pt-28">
      <div class="grid gap-10 sm:gap-12 md:grid-cols-2 md:items-center">
        <div class="animate-fade-up">
          <p class="section-label">iPhone Safari · on demand</p>
          <h1
            class="mt-4 text-[1.6rem] font-semibold tracking-tight text-tk-ink sm:mt-5 sm:text-4xl md:text-5xl"
            style="letter-spacing: -0.02em; line-height: 1.12;"
          >
            Command a fleet of real iPhones.
          </h1>
          <p class="mt-4 max-w-prose text-sm text-tk-ink-2 leading-relaxed sm:mt-5 sm:text-base md:text-lg">
            Spin up real iPhones in the cloud — each with its own identity,
            its own history, its own corner of the world. Drive them by hand,
            by code, or by AI. To every website, they're just people on
            phones.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-3 sm:mt-8 sm:gap-4">
            <a href="/pricing/#free" class="btn-primary">Start free</a>
            <a href="#how-it-works" class="btn-secondary">See how it works</a>
          </div>
          <p class="mt-3 text-xs text-tk-ink-2 sm:mt-4">
            One profile · 20-minute sessions · no card required.
          </p>
        </div>

        <!-- The fleet: a fan of open iPhone windows — the literal "command a
             fleet of real iPhones" visual. Drawn to match the current GUI
             (phone-framed, LIVE/IDLE, dark+oxblood). Band A: cities spelled
             out, "own connection", example.com pages only. -->
        <div class="relative">
          {/* S24 — data-contrast-decorative: the fan is an ILLUSTRATION of
              the GUI (miniature window chrome, 6–8px faux print, no real
              links/CTAs inside), exempt from the contrast scanner per
              WCAG 1.4.3 "incidental" text-in-a-picture. The caption strip
              BELOW the fan is real copy and stays scanned. */}
          <div class="flex items-end justify-center pt-2" data-contrast-decorative>
            {
              heroFleet.map((p) => (
                <div class={`relative w-[118px] shrink-0 sm:w-[128px] ${p.wrap}`}>
                  <div
                    class={`overflow-hidden rounded-[22px] p-[3px] shadow-ambient-lg ${p.center ? 'ring-1 ring-tk-accent shadow-glow-accent' : 'ring-1 ring-tk-border'}`}
                    style="background: linear-gradient(160deg, #161b24, #0a0e14);"
                  >
                    <div class="flex items-center gap-1 rounded-t-[19px] bg-[#1d1e24] px-2 py-1">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#ff5f57]" />
                      <span class="h-1.5 w-1.5 rounded-full bg-[#febc2e]" />
                      <span class="ml-1 truncate font-sans text-[8px] font-semibold text-white/85">
                        {p.name}
                      </span>
                      <span
                        class={`ml-auto flex shrink-0 items-center gap-0.5 text-[7px] font-bold uppercase tracking-wide ${p.live ? 'text-tk-ready' : 'text-tk-ink-3'}`}
                      >
                        {p.live ? (
                          <span class="live-dot h-1 w-1 rounded-full bg-tk-ready" />
                        ) : (
                          <span class="h-1 w-1 rounded-full border border-tk-ink-3" />
                        )}
                        {p.live ? 'Live' : 'Idle'}
                      </span>
                    </div>
                    <div class="relative aspect-[9/17] overflow-hidden rounded-[19px] bg-black">
                      <div class="absolute left-1/2 top-1.5 z-10 h-2 w-8 -translate-x-1/2 rounded-full bg-black ring-1 ring-white/10" />
                      {p.site ? (
                        <div class="absolute inset-0 flex flex-col bg-gradient-to-b from-white to-slate-100 pt-5">
                          <div class="mx-1.5 truncate rounded-sm bg-white px-1 py-0.5 font-mono text-[6px] text-slate-500 ring-1 ring-slate-200">
                            {p.site} 🔒
                          </div>
                          <div class="mx-1.5 mt-1 h-8 rounded-sm bg-gradient-to-br from-slate-800 to-slate-600" />
                          <div class="mx-1.5 mt-1 grid grid-cols-2 gap-1">
                            <div class="h-6 rounded-sm bg-white ring-1 ring-slate-200" />
                            <div class="h-6 rounded-sm bg-white ring-1 ring-slate-200" />
                          </div>
                          <div class="mx-1.5 mb-2 mt-auto h-3 rounded-sm bg-slate-900" />
                        </div>
                      ) : (
                        <div class="absolute inset-0 flex items-center justify-center bg-tk-surface">
                          <span class="font-mono text-[7px] text-tk-ink-3">New Tab</span>
                        </div>
                      )}
                      <div class="absolute bottom-1 left-1/2 h-0.5 w-8 -translate-x-1/2 rounded-full bg-white/40" />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-center font-mono text-[10px] text-tk-ink-3">
            🇺🇸 New York · 🇳🇱 Amsterdam · 🇯🇵 Tokyo — each on its own connection
          </p>
          <div class="mt-2 flex flex-wrap justify-center gap-x-4 gap-y-1 font-mono text-[10px] text-tk-ink-3">
            <span><b class="text-tk-ready-text">4 iPhones</b> in your fleet</span>
            <span>each with <b class="text-tk-ink-2">its own identity</b></span>
            <span>all <b class="text-tk-ready-text">healthy</b></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 2 · WHAT IS DRIFTSTACK — Band B tiles: big plain claim + small
       mono technical line. Merges the former stats strip + "What sets us
       apart" differentiator strip (2026-07-03; the no-JS-patching claim
       moved to the proof section's Engine-deep card). ═══ -->
  <Section
    label="What is Driftstack?"
    title="Real iPhones in the cloud, ready in seconds."
    lead="Websites can tell when a browser is pretending to be a phone. Driftstack doesn't pretend — every session runs on the real thing."
  >
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <Stat
        plain="A real iPhone, not a lookalike"
        technical="Built from Apple's WebKit source code — the engine inside every iPhone's Safari, the same one your iOS users run"
      />
      <Stat
        plain="Looks human to every website"
        technical="The hidden 'device photos' sites take to spot fakes (canvas + WebGL hashes) match millions of real iPhones — not a new unique value per session like every other API"
      />
      <Stat
        plain="Drive it three ways"
        technical="From code — TypeScript, Python, or Go — or point-and-click from the dashboard. Same engine either way"
      />
      <Stat
        plain="Any country you need"
        technical="Bring your own proxy or VPN, attached per profile"
      />
    </div>
  </Section>

  <!-- ═══ 3 · HOW IT WORKS — plain-language 3 steps (Band A; the hero's
       secondary CTA anchors here). ═══ -->
  <Section
    id="how-it-works"
    label="How it works"
    title="Three steps to a real iPhone in the cloud."
  >
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <Card title="Pick an iPhone profile">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">1</span></IconTile>
        Start with the default iPhone, or create your own. Each profile is a
        persistent identity that remembers its logins, cookies, and history
        across every run.
      </Card>
      <Card title="Start a session">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">2</span></IconTile>
        Spin up a real iPhone Safari browser in the cloud — one click in the
        desktop app, or one API call. No hardware to buy, nothing to install.
      </Card>
      <Card title="Drive it your way">
        <IconTile slot="icon"><span class="font-mono text-base font-semibold">3</span></IconTile>
        Click around yourself, or automate it from TypeScript, Python, or Go.
        Every website it visits sees a genuine iPhone — never a bot.
      </Card>
    </div>
  </Section>

  <!-- ═══ 4 · USE CASES — personas, operators first (Band A). ═══ -->
  <Section
    label="Use cases"
    title="Built for the work you actually do."
  >
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <Card title="Run many accounts, safely apart">
        <IconTile slot="icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="8.5" cy="7" r="4" />
            <path d="M20 8v6M23 11h-6" />
          </svg>
        </IconTile>
        Keep separate identities on services that recognize your device by its
        <a href="/glossary/#fingerprint" class="text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2">fingerprint</a>
        — the traits a website can measure about a browser. Persistent
        profiles let each account look like its own physical phone, every
        session, every time.
        <a
          href="/use-cases/multi-account/"
          class="mt-3 block text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >More →</a
        >
      </Card>
      <Card title="Test on the real thing">
        <IconTile slot="icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 11l3 3 8-8" />
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
          </svg>
        </IconTile>
        Run your automated tests — the kind that click through your site like
        a real user — against the exact engine your iOS users run. Same
        rendering, same JavaScript timing, same quirks — the bug you
        reproduce is the bug your users hit.
        <a
          href="/use-cases/qa-testing/"
          class="mt-3 block text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >More →</a
        >
      </Card>
      <Card title="See what iPhone users see">
        <IconTile slot="icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5" />
            <path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6" />
          </svg>
        </IconTile>
        Many sites serve different content to mobile Safari than to desktop
        Chrome. With Driftstack, your scraper sees what an iPhone visitor
        would see — no redirects to "please use our app" pages.
        <a
          href="/use-cases/web-scraping/"
          class="mt-3 block text-tk-accent-text underline underline-offset-4 hover:text-tk-accent-2"
          >More →</a
        >
      </Card>
    </div>
  </Section>

  <!-- ═══ 5 · TWO WAYS TO DRIVE + the GUI cockpit (Band A headline; the
       cockpit mockup is preserved verbatim — founder 2026-06-12: show the
       GUI itself, no live-session implication). ═══ -->
  <Section
    label="Two ways to drive it"
    title="Point and click — or just say what you want."
    lead="The desktop app keeps every iPhone one click away — folders, tags, floating device windows. And when a task is repetitive, type it in plain English and the built-in AI agent drives while you watch."
  >
      {/* S24 — data-contrast-decorative: the whole cockpit block (window +
          floating simulator) is an ILLUSTRATION of the desktop GUI — every
          "control" inside is a span/div, none of it is site UI a visitor
          must read — so it's exempt from the contrast scanner per WCAG
          1.4.3 "incidental" text-in-a-picture. The explanatory copy below
          it stays scanned. */}
      <div class="mt-10 relative" data-contrast-decorative>
        <div class="rounded-2xl border border-tk-border bg-tk-surface shadow-ambient-lg overflow-hidden">
          <!-- window chrome — matches the current GUI titlebar: brand +
               · cloud, a Connected pill on the right. -->
          <div class="flex items-center gap-2 border-b border-tk-border bg-tk-hover/60 px-4 py-2.5">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 font-sans text-xs font-black italic tracking-tight text-tk-ink">DRIFT<span class="text-tk-accent-text">STACK</span></span>
            <span class="font-mono text-[10px] text-tk-ink-3">· cloud</span>
            <span class="ml-auto inline-flex items-center gap-1 rounded-full border border-tk-border px-2 py-0.5 font-mono text-[9px] text-tk-ink-2"><span class="live-dot h-1.5 w-1.5 rounded-full bg-tk-ready"></span>Connected</span>
          </div>
          <div class="grid md:grid-cols-[188px_1fr]">
            <!-- sidebar — the current grouped GUI navigation -->
            <div class="hidden border-r border-tk-border bg-tk-bg/60 p-3 md:block">
              <p class="text-[8px] font-semibold uppercase tracking-widest text-tk-ink-3">Home</p>
              <div class="mt-1.5 px-2 py-1 text-xs text-tk-ink-2">Command center</div>
              <p class="mt-3 text-[8px] font-semibold uppercase tracking-widest text-tk-ink-3">Browse</p>
              <div class="mt-1.5 flex items-center justify-between rounded bg-tk-accent/10 px-2 py-1 text-xs font-medium text-tk-ink">Profiles <span class="font-mono text-[9px] text-tk-ink-3">4/10</span></div>
              <div class="px-2 py-1 text-xs text-tk-ink-2">Proxies</div>
              <p class="mt-3 text-[8px] font-semibold uppercase tracking-widest text-tk-ink-3">Automate</p>
              <div class="mt-1.5 px-2 py-1 text-xs text-tk-ink-2">AI Browser Automation</div>
              <div class="px-2 py-1 text-xs text-tk-ink-2">Saved tasks</div>
              <p class="mt-3 text-[8px] font-semibold uppercase tracking-widest text-tk-ink-3">History</p>
              <div class="mt-1.5 px-2 py-1 text-xs text-tk-ink-2">Session log</div>
              <div class="px-2 py-1 text-xs text-tk-ink-2">Recordings</div>
            </div>
            <!-- profiles pane — phone-framed cards (the current GUI look) -->
            <div class="p-4">
              <div class="mb-3 flex items-center justify-between">
                <span class="font-mono text-[11px] text-tk-ink-2"><b class="text-tk-ready-text">4 live</b> · 98% proxy health</span>
                <span class="rounded-md bg-tk-accent px-2 py-0.5 text-[10px] font-semibold text-tk-accent-ink">+ New profile</span>
              </div>
              <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-5">
                {
                  cockpitProfiles.map((p) => (
                    <div
                      class={`overflow-hidden rounded-[16px] p-[3px] ${p.center ? 'ring-1 ring-tk-accent shadow-glow-accent' : 'ring-1 ring-tk-border'}`}
                      style="background: linear-gradient(160deg, #161b24, #0a0e14);"
                    >
                      <div class="flex items-center gap-1 rounded-t-[13px] bg-[#1d1e24] px-1.5 py-1">
                        <span class="truncate font-sans text-[7px] font-semibold text-white/85">{p.name}</span>
                        <span
                          class={`ml-auto flex shrink-0 items-center gap-0.5 text-[6px] font-bold uppercase ${p.live ? 'text-tk-ready' : 'text-tk-ink-3'}`}
                        >
                          {p.live ? (
                            <span class="live-dot h-1 w-1 rounded-full bg-tk-ready" />
                          ) : (
                            <span class="h-1 w-1 rounded-full border border-tk-ink-3" />
                          )}
                          {p.live ? 'Live' : 'Idle'}
                        </span>
                      </div>
                      <div class="relative aspect-[9/13] overflow-hidden rounded-b-[13px] bg-black">
                        <div class="absolute left-1/2 top-1 z-10 h-1.5 w-6 -translate-x-1/2 rounded-full bg-black ring-1 ring-white/10" />
                        {p.live ? (
                          <div class="absolute inset-0 flex flex-col bg-gradient-to-b from-white to-slate-100 pt-3.5">
                            <div class="mx-1 h-4 rounded-sm bg-gradient-to-br from-slate-800 to-slate-600" />
                            <div class="mx-1 mt-1 grid grid-cols-2 gap-0.5">
                              <div class="h-3 rounded-sm bg-white ring-1 ring-slate-200" />
                              <div class="h-3 rounded-sm bg-white ring-1 ring-slate-200" />
                            </div>
                          </div>
                        ) : (
                          <div class="absolute inset-0 bg-tk-surface" />
                        )}
                        <div class="absolute bottom-1 left-1/2 z-10 -translate-x-1/2 rounded-full bg-black/60 px-1 font-mono text-[6px] text-white/80">
                          {p.flag} {p.cc}
                        </div>
                      </div>
                    </div>
                  ))
                }
                <div class="flex items-center justify-center rounded-[16px] border border-dashed border-tk-border text-center">
                  <span class="text-[10px] text-tk-ink-3">+ New<br />profile</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- floating simulator window, overlapping the hub -->
        <div class="pointer-events-none absolute -bottom-6 right-4 hidden w-44 md:block">
          <div class="overflow-hidden rounded-xl border border-tk-border bg-tk-surface shadow-xl">
            <div class="flex items-center gap-1 border-b border-tk-border bg-tk-hover/60 px-2 py-1">
              <span class="h-1.5 w-1.5 rounded-full bg-[#ff5f57]"></span><span class="h-1.5 w-1.5 rounded-full bg-[#febc2e]"></span>
              <span class="ml-1 font-mono text-[8px] text-tk-ink-3">amsterdam-shopper</span>
              <span class="live-dot ml-auto h-1.5 w-1.5 rounded-full bg-tk-ready"></span>
            </div>
            <div class="bg-gradient-to-b from-white to-slate-100 p-1.5">
              <div class="rounded-sm bg-white px-1 py-0.5 font-mono text-[7px] text-slate-500 ring-1 ring-slate-200">shop.example.com 🔒</div>
              <div class="mt-1 h-7 rounded-sm bg-gradient-to-br from-slate-800 to-slate-600"></div>
              <div class="mt-1 grid grid-cols-2 gap-1"><div class="h-5 rounded-sm bg-white ring-1 ring-slate-200"></div><div class="h-5 rounded-sm bg-white ring-1 ring-slate-200"></div></div>
              <div class="mt-1 h-2.5 rounded-sm bg-slate-900"></div>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-10 max-w-prose text-sm text-tk-ink-2">
        The desktop app is the cockpit: organize profiles in folders, launch
        with one click, and pop any session out into its own floating device
        window. Engineers get the same power from code (the SDK — our
        ready-made programming library):
        <strong class="text-tk-ink">once a task is scripted, repeat runs skip
        the AI agent entirely — none of its cost, none of its wait</strong>.
      </p>
  </Section>

  <!-- ═══ 6 · THE PROOF — "One iPhone among millions." Merges the former
       why-it-works cards + detection matrix + how-it's-built statement +
       comparison teaser into one flagship section (2026-07-03). The
       costume-metaphor lead is the Band-A on-ramp; the matrix + engine
       paragraph carry the full technical teeth. ═══ -->
  <section class="relative border-t border-tk-border">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="section-label">Why Driftstack works</p>
      <h2
        class="mt-5 text-3xl font-semibold tracking-tight text-tk-ink sm:mt-6 sm:text-5xl md:text-7xl lg:text-8xl"
        style="letter-spacing: -0.04em; line-height: 1.1;"
      >
        One iPhone among millions.
      </h2>
      <p class="mt-6 max-w-prose text-base text-tk-ink-2 leading-relaxed sm:mt-8 md:text-lg">
        Most tools dress up a desktop browser to look like a phone — and
