---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Driftstack"
  description="A real iPhone browser in the cloud that every website sees as a genuine iPhone — never a bot. Automate iPhone Safari from TypeScript, Python, Go, or a desktop app. Start free."
>
  <!-- ═══ HERO — Fleet mission control (founder 2026-06-12: the fleet section
       IS the hero; the SDK-first hero moved to a compact section below).
       Honest-claims: only real capabilities; generic professional telemetry. ═══ -->
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 sm:pb-24 sm:pt-24 md:pt-28">
      <div class="grid gap-10 sm:gap-12 md:grid-cols-2 md:items-center">
        <div class="animate-fade-up">
          <p class="section-label">iPhone Safari · on demand</p>
          <h1
            class="mt-4 text-[1.6rem] font-semibold tracking-tight text-tk-ink sm:mt-5 sm:text-4xl md:text-5xl"
            style="letter-spacing: -0.02em; line-height: 1.12;"
          >
            Command a fleet of real iPhones.
          </h1>
          <p class="mt-4 max-w-prose text-sm text-tk-ink-2 leading-relaxed sm:mt-5 sm:text-base md:text-lg">
            Spin up real iPhones in the cloud — each with its own identity,
            its own history, its own corner of the world. Drive them by hand,
            by code, or by AI. To every website, they're just people on
            phones.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-3 sm:mt-8 sm:gap-4">
            <a href="/pricing#free" class="btn-primary">Start free</a>
            <a href="/comparison" class="btn-secondary">Compare the alternatives</a>
          </div>
          <p class="mt-3 text-[11px] text-tk-ink-3 sm:mt-4 sm:text-xs">
            One profile · 20-minute sessions · no card required.
          </p>
        </div>

        <!-- The fleet wall (founder round 6, 2026-06-12): renders the WORKSPACE
             the product actually shows — GUI hub layout with workspace nav,
             folders, and profile cards (device · exit · proxy · tags) instead
             of abstract mini phones. Content per the founder's spec. -->
        <div class="rounded-2xl border border-tk-border bg-tk-surface p-4 shadow-lg">
          <div class="mb-3 flex items-center gap-2 font-mono text-[11px] text-tk-ink-3">
            <span class="font-sans text-[12px] font-black italic tracking-tight text-tk-ink">DRIFT<span class="text-tk-accent">STACK</span></span>
            <span>your-workspace</span>
            <span class="ml-auto flex items-center gap-1"><span class="live-dot inline-block h-2 w-2 rounded-full bg-tk-ready"></span><b class="text-tk-ready">4 running</b></span>
          </div>
          <div class="flex gap-3">
            <div class="w-28 shrink-0 rounded-lg border border-tk-border bg-tk-bg p-2 font-mono text-[9.5px]">
              <p class="text-tk-accent">// workspace</p>
              <p class="mt-1 rounded bg-tk-accent/10 px-1.5 py-0.5 font-semibold text-tk-ink">Profiles</p>
              <p class="px-1.5 py-0.5 text-tk-ink-3">Sessions</p>
              <p class="px-1.5 py-0.5 text-tk-ink-3">Recipes</p>
              <p class="px-1.5 py-0.5 text-tk-ink-3">Proxies</p>
              <p class="mt-2 text-tk-accent">// folders</p>
              <p class="px-1.5 py-0.5 text-tk-ink-3">📁 E-commerce</p>
              <p class="px-1.5 py-0.5 text-tk-ink-3">📁 Social ops</p>
              <p class="px-1.5 py-0.5 text-tk-ink-3">📁 QA suite</p>
            </div>
            <div class="grid min-w-0 flex-1 grid-cols-2 gap-2">
              <div class="rounded-lg border-2 border-tk-accent bg-tk-bg p-2.5 shadow-glow-accent">
                <div class="flex items-center justify-between gap-1"><span class="truncate text-[11px] font-semibold text-tk-ink">amsterdam-shopper</span><span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-tk-border px-1.5 py-0.5 text-[8.5px] font-semibold text-tk-ready"><span class="live-dot h-1 w-1 rounded-full bg-tk-ready"></span>Running</span></div>
                <p class="mt-1 font-mono text-[9px] text-tk-ink-3">iPhone 17 · 🇳🇱 AMS · SOCKS5</p>
                <div class="mt-1.5 flex gap-1"><span class="rounded-full border border-tk-border px-1.5 py-px text-[8px] text-tk-ink-3">checkout</span><span class="rounded-full border border-tk-border px-1.5 py-px text-[8px] text-tk-ink-3">priority</span></div>
              </div>
              <div class="rounded-lg border border-tk-border bg-tk-bg p-2.5">
                <div class="flex items-center justify-between gap-1"><span class="truncate text-[11px] font-semibold text-tk-ink">us-retail-qa</span><span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-tk-border px-1.5 py-0.5 text-[8.5px] font-semibold text-tk-ready"><span class="live-dot h-1 w-1 rounded-full bg-tk-ready"></span>Running</span></div>
                <p class="mt-1 font-mono text-[9px] text-tk-ink-3">iPhone 17 · 🇺🇸 NYC · WireGuard</p>
                <div class="mt-1.5 flex gap-1"><span class="rounded-full border border-tk-border px-1.5 py-px text-[8px] text-tk-ink-3">e2e</span></div>
              </div>
              <div class="rounded-lg border border-tk-border bg-tk-bg p-2.5">
                <div class="flex items-center justify-between gap-1"><span class="truncate text-[11px] font-semibold text-tk-ink">jp-market</span><span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-tk-border px-1.5 py-0.5 text-[8.5px] font-semibold text-tk-ink-3"><span class="h-1 w-1 rounded-full bg-tk-ink-3"></span>Idle</span></div>
                <p class="mt-1 font-mono text-[9px] text-tk-ink-3">iPhone 15 Pro · 🇯🇵 TYO · SOCKS5</p>
                <div class="mt-1.5 flex gap-1"><span class="rounded-full border border-tk-border px-1.5 py-px text-[8px] text-tk-ink-3">research</span></div>
              </div>
              <div class="rounded-lg border border-tk-border bg-tk-bg p-2.5">
                <div class="flex items-center justify-between gap-1"><span class="truncate text-[11px] font-semibold text-tk-ink">de-pricing</span><span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-tk-border px-1.5 py-0.5 text-[8.5px] font-semibold text-tk-busy"><span class="live-dot h-1 w-1 rounded-full bg-tk-busy"></span>Syncing</span></div>
                <p class="mt-1 font-mono text-[9px] text-tk-ink-3">iPhone 17 · 🇩🇪 FRA · SOCKS5</p>
                <div class="mt-1.5 flex gap-1"><span class="rounded-full border border-tk-border px-1.5 py-px text-[8px] text-tk-ink-3">daily</span></div>
              </div>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] text-tk-ink-3">
            <span>fingerprint coherence <b class="text-tk-ready">verified</b></span>
            <span>detection flags <b class="text-tk-ready">0</b></span>
            <span>median control latency <b class="text-tk-ink-2">&lt;100ms</b></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 2026-05-22 — stats strip between the hero + the "Two ways to
      drive it" section. Four concrete numbers replace what would
      otherwise be more prose-heavy claims. Visual breathing room
      between two text-dense sections. */}
  <section class="relative border-t border-tk-border">
    <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex items-start gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="2" width="14" height="20" rx="2" />
              <path d="M12 18h.01" />
            </svg>
          </div>
          <div>
            <p class="text-2xl font-semibold text-tk-ink">
              Real WebKit
            </p>
            <p class="mt-1 text-xs text-tk-ink-3">The engine every iPhone ships</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
          </div>
          <div>
            <p class="text-2xl font-semibold text-tk-ink">
              iOS 18.7 / 26.x
            </p>
            <p class="mt-1 text-xs text-tk-ink-3">Safari versions Apple still ships</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
            </svg>
          </div>
          <div>
            <p class="text-2xl font-semibold text-tk-ink">
              3 SDKs
            </p>
            <p class="mt-1 text-xs text-tk-ink-3">TypeScript · Python · Go</p>
          </div>
        </div>
        {/* 2026-05-22 — replaced "EU-hosted" with a concrete proxy-
            capability claim. Founder feedback: customers care about
            UDP/WebRTC/QUIC + OpenVPN/WireGuard support, not the
            data-center location. */}
        <div class="flex items-start gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/30 text-tk-accent">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
              <circle cx="5" cy="12" r="2" />
              <circle cx="19" cy="12" r="2" />
            </svg>
          </div>
          <div>
            <p class="text-2xl font-semibold text-tk-ink">
              SOCKS5 + VPN
            </p>
            <p class="mt-1 text-xs text-tk-ink-3">Configurable per profile</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Build-with-code — the former hero, compacted below the fleet hero
       (founder 2026-06-12). All pinned copy + the REAL SDK snippet kept. -->
  <section class="relative border-t border-tk-border">
    {/* 2026-05-22 — atmospheric glow behind the hero. Two soft glow-
        red radial gradients that pulse on a 12s loop. Pure CSS;
        respects prefers-reduced-motion. */}
            <div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="grid gap-10 sm:gap-12 md:grid-cols-2 md:items-center">
        <div class="animate-fade-up">
          <p class="section-label">iPhone Safari · on demand</p>
          <h2
            class="mt-4 text-xl font-semibold tracking-tight text-tk-ink sm:mt-5 sm:text-2xl md:text-3xl"
            style="letter-spacing: -0.02em; line-height: 1.2;"
          >
            Indistinguishable iPhone Safari.
            <span class="block">Programmable from any language.</span>
          </h2>
          <p class="mt-4 max-w-prose text-sm text-tk-ink-2 leading-relaxed sm:mt-5 sm:text-base md:text-lg">
            Run a real iPhone browser in the cloud that every website treats as
            a genuine iPhone — never a bot, never an emulator. Built for
            scraping, testing, and automation that has to pass as a real mobile
            user. Drive it from TypeScript, Python, Go, or the desktop app.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-3 sm:mt-8 sm:gap-4">
            <a href="/pricing#free" class="btn-primary">Start free</a>
            <a href="/comparison" class="btn-secondary">Compare the alternatives</a>
          </div>
          <p class="mt-3 text-[11px] text-tk-ink-3 sm:mt-4 sm:text-xs">
            One profile · 20-minute sessions · no card required.
          </p>
        </div>

        <div class="code-preview relative">
          <div class="code-window-chrome">
            <span class="pip"></span>
            <span class="pip"></span>
            <span class="pip"></span>
            <span class="ml-3 truncate text-[11px] text-tk-ink-3 sm:text-xs">driftstack-typescript-sdk</span>
            <button
              type="button"
              data-copy-target="hero-sdk-code"
              class="ml-auto rounded border border-tk-border px-2 py-0.5 text-[10px] font-mono text-tk-ink-3 transition hover:border-tk-accent hover:text-tk-accent"
              aria-label="Copy code to clipboard"
            >
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="max-h-[220px] overflow-x-auto p-3 text-[9.5px] leading-relaxed sm:max-h-none sm:p-5 sm:text-xs md:text-sm"><code id="hero-sdk-code">{`import { Driftstack } from '@driftstack/sdk';

const ds = new Driftstack({ apiKey: process.env.DRIFTSTACK_API_KEY });

const session = await ds.sessions.create({
  archetype: 'iphone17_ios18_7_safari26_4',
  label: 'target-flow',
});

try {
  await ds.sessions.navigate(session.id, { url: 'https://target.example' });
  await ds.sessions.capture(session.id, { kind: 'screenshot' });
  const state = await ds.sessions.getState(session.id);
  console.log(state.url, state.title);
} finally {
  await ds.sessions.destroy(session.id);
}`}</code></pre>
          <!-- Horizontal-scroll affordance: fade on the right edge so
               readers know the code preview can be panned on mobile. -->
          <div class="pointer-events-none absolute inset-y-12 right-0 w-8 bg-gradient-to-l from-black/70 to-transparent sm:hidden"></div>
        </div>
      </div>
    </div>
  </section>



  <!-- Not-an-anti-detect comparison (demo's table, distilled from /comparison) -->
  <section class="relative border-t border-tk-border">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="section-label">Comparison</p>
      <h2 class="mt-5 max-w-3xl text-2xl font-semibold tracking-tight sm:text-3xl md:text-4xl" style="letter-spacing: -0.02em;">
        Not another anti-detect browser.
      </h2>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-2 leading-relaxed sm:text-base">
        Anti-detects patch a desktop browser to lie about itself.
        Driftstack runs the real thing — actual WebKit on Apple-shipped
        iOS versions — so there's nothing to detect.
      </p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-tk-border bg-tk-surface">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-tk-border font-mono text-[11px] uppercase tracking-wider text-tk-ink-3">
              <th class="px-5 py-3 font-medium">Capability</th>
              <th class="px-5 py-3 font-medium">Typical anti-detect</th>
              <th class="px-5 py-3 font-medium">Driftstack</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-tk-border">
            <tr><td class="px-5 py-3 text-tk-ink-2">Mobile fingerprint</td><td class="px-5 py-3 text-tk-ink-3">spoofed desktop UA</td><td class="px-5 py-3 font-medium text-tk-ink">real WebKit, real iOS</td></tr>
            <tr><td class="px-5 py-3 text-tk-ink-2">Where it runs</td><td class="px-5 py-3 text-tk-ink-3">your machine</td><td class="px-5 py-3 font-medium text-tk-ink">cloud + live control</td></tr>
            <tr><td class="px-5 py-3 text-tk-ink-2">Detection surface</td><td class="px-5 py-3 text-tk-ink-3">stealth-patch bundle to spot</td><td class="px-5 py-3 font-medium text-tk-ink">no runtime JS patching at all</td></tr>
            <tr><td class="px-5 py-3 text-tk-ink-2">Automation</td><td class="px-5 py-3 text-tk-ink-3">clunky local RPA</td><td class="px-5 py-3 font-medium text-tk-ink">3 SDKs · AI agent · API</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-tk-ink-3">
        Full tier-by-tier and tool-by-tool detail on the
        <a href="/comparison" class="text-tk-accent underline">comparison page</a>.
      </p>
    </div>
  </section>

  <!-- W456 — plain-language "How it works in 3 steps" explainer, placed early
       for non-technical visitors who don't scroll to the deeper technical
       sections. Mirrors the Use-cases 3-card grid; numbered step badges. -->
  <section class="relative border-t border-tk-border">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="section-label">How it works</p>
      <h2
        class="mt-6 max-w-3xl text-2xl font-semibold tracking-tight sm:text-3xl md:text-4xl"
        style="letter-spacing: -0.02em;"
      >
        Three steps to a real iPhone in the cloud.
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="card p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-tk-accent/10 font-mono text-base font-semibold text-tk-accent ring-1 ring-tk-accent/30">
            1
          </div>
          <h3 class="mt-4 text-lg font-semibold text-tk-ink">Pick an iPhone profile</h3>
          <p class="mt-2 text-sm leading-relaxed text-tk-ink-2">
            Start with the default iPhone, or create your own. Each profile is a
            persistent identity that remembers its logins, cookies, and history
            across every run.
          </p>
        </div>
        <div class="card p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-tk-accent/10 font-mono text-base font-semibold text-tk-accent ring-1 ring-tk-accent/30">
            2
          </div>
          <h3 class="mt-4 text-lg font-semibold text-tk-ink">Start a session</h3>
          <p class="mt-2 text-sm leading-relaxed text-tk-ink-2">
            Spin up a real iPhone Safari browser in the cloud — one click in the
            desktop app, or one API call. No hardware to buy, nothing to install.
          </p>
        </div>
        <div class="card p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-tk-accent/10 font-mono text-base font-semibold text-tk-accent ring-1 ring-tk-accent/30">
            3
          </div>
          <h3 class="mt-4 text-lg font-semibold text-tk-ink">Drive it your way</h3>
          <p class="mt-2 text-sm leading-relaxed text-tk-ink-2">
            Click around yourself, or automate it from TypeScript, Python, or Go.
            Every website it visits sees a genuine iPhone — never a bot.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- M.2 — "Two ways to drive it" section, refreshed per Plan Item 3.
       The hero above shows the imperative SDK as a real code block;
       this section now shows the AI-agent UX as a stylized visual
       mockup (chat transcript + LiveKit preview pane) so customers
       SEE the agent experience instead of reading another large
       <pre><code> block. Static HTML/CSS — no live LiveKit embed
       yet (a real auth-gated session embed lands as a follow-up
       once the Q.0 EG-API-1.6 propagation + AI-B1.b activation
       arrive). Mobile: md:grid-cols-[1fr_1fr] collapses to single
       column, chat on top + preview below; preview min-height
       stays 280px so the preview pane doesn't shrink to a sliver. -->
  <section class="relative border-t border-tk-border">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="section-label">Two ways to drive it</p>
      <h2
        class="mt-5 max-w-3xl text-2xl font-semibold tracking-tight sm:mt-6 sm:text-3xl md:text-4xl"
        style="letter-spacing: -0.02em;"
      >
        
          Code it precisely, or just describe what you want.
        
      </h2>
      <p class="mt-4 max-w-prose text-sm text-tk-ink-2 leading-relaxed sm:mt-5 sm:text-base">
        Engineers drive sessions directly with the SDK (see the hero
        example). Everyone else can open the dashboard, type the task
        in plain English, and watch the agent execute it live — with
        the option to export the result as code anytime.
      </p>

      <!-- The cockpit showcase — a high-fidelity mockup of the desktop GUI
           (the real product, not a live session): hub window + the floating
           iPhone simulator, with breathing live-status. Founder 2026-06-12:
           no live-session implication on the homepage; show the GUI itself. -->
      <div class="mt-10 relative">
        <div class="rounded-2xl border border-tk-border bg-tk-surface shadow-lg overflow-hidden">
          <!-- window chrome -->
          <div class="flex items-center gap-2 border-b border-tk-border bg-tk-hover/60 px-4 py-2.5">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 font-sans text-xs font-black italic tracking-tight text-tk-ink">DRIFT<span class="text-tk-accent">STACK</span></span>
            <span class="ml-auto font-mono text-[10px] text-tk-ink-3">your-workspace · 4 running</span>
          </div>
          <div class="grid md:grid-cols-[180px_1fr]">
            <!-- sidebar -->
            <div class="hidden border-r border-tk-border bg-tk-bg/60 p-3 md:block">
              <div class="font-mono text-[9px] uppercase tracking-widest text-tk-ink-3"><span class="text-tk-accent">//</span> workspace</div>
              <div class="mt-2 rounded bg-tk-accent/10 px-2 py-1 text-xs font-medium text-tk-ink">Profiles</div>
              <div class="mt-1 px-2 py-1 text-xs text-tk-ink-2">Sessions</div>
              <div class="mt-1 px-2 py-1 text-xs text-tk-ink-2">Recipes</div>
              <div class="mt-1 px-2 py-1 text-xs text-tk-ink-2">Proxies</div>
              <div class="mt-4 font-mono text-[9px] uppercase tracking-widest text-tk-ink-3"><span class="text-tk-accent">//</span> folders</div>
              <div class="mt-2 flex items-center gap-1.5 px-2 py-0.5 text-xs text-tk-ink-2"><span class="h-1.5 w-1.5 rounded-full bg-tk-ready"></span> E-commerce</div>
              <div class="flex items-center gap-1.5 px-2 py-0.5 text-xs text-tk-ink-2"><span class="h-1.5 w-1.5 rounded-full bg-tk-accent/60"></span> Social ops</div>
              <div class="flex items-center gap-1.5 px-2 py-0.5 text-xs text-tk-ink-2"><span class="h-1.5 w-1.5 rounded-full bg-tk-busy"></span> QA suite</div>
            </div>
            <!-- profile grid -->
