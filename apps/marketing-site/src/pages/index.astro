  <!-- M.4 Plan Item 9f — code-block copy button. Static prerender +
       inline script (Astro is:inline) so no module hydration required;
       wires every [data-copy-target] to navigator.clipboard. Resilient
       to the navigator.clipboard absence (older WebViews / insecure
       origins) — falls back to selecting the text so the user can
       still ctrl-C / ⌘C. -->
  <script is:inline>
    (() => {
      function wireCopyButton(btn) {
        const targetId = btn.getAttribute('data-copy-target');
        if (!targetId) return;
        const target = document.getElementById(targetId);
        const label = btn.querySelector('[data-copy-label]');
        if (!target || !label) return;
        btn.addEventListener('click', async () => {
          const text = target.textContent ?? '';
          const original = label.textContent;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(text);
            } else {
              const range = document.createRange();
              range.selectNodeContents(target);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
            label.textContent = 'Copied';
            setTimeout(() => {
              label.textContent = original;
            }, 1600);
          } catch {
            label.textContent = 'Copy failed';
            setTimeout(() => {
              label.textContent = original;
            }, 1600);
          }
        });
      }
      document.querySelectorAll('[data-copy-target]').forEach(wireCopyButton);
    })();
  </script>
