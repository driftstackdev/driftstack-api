---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CUMULATIVE_RIG, DEVICE_SUPPORT } from '../../data/capabilities.ts';

// V-668 — Cumulative rig methodology page. The homepage repeatedly
// references /trust/cumulative-rig as "the full signal-by-signal
// table" backing the Indistinguishable claim; until this page
// landed, those references were broken links.
//
// Scope:
//   • Define what "the cumulative rig" is at a customer-readable
//     level (not the internal engineering term — describe the
//     concept).
//   • Enumerate the fingerprint signals Driftstack measures + how
//     each is implemented.
//   • Show what each signal SHOULD look like on a real iPhone vs
//     what a typical Chromium-stealth tool returns (the contrast
//     that makes the column load-bearing).
//   • State the launch-blocker policy: any drift from the reference
//     phone is a launch-blocking bug.
//
// Out of scope:
//   • Per-version test outputs (those live in the internal repo —
//     this page is the methodology, not the dashboard).
//   • Step-by-step detection-bypass tutorials (those help attackers,
//     not customers).

// S10 (2026-07-03) — the worked-example archetype renders from the
// CUMULATIVE_RIG snapshot in src/data/capabilities.ts (the founder-
// attested fact source) instead of a hardcoded literal. The page's
// typographic register uses '·' separators; the data file stores the
// parity-pinned '/' form, so derive the display strings here.
const [archetypeDevice = '', archetypeOs = '', archetypeSafari = ''] =
  CUMULATIVE_RIG.archetypeReference.split(' / ');
const archetypeDisplay = [archetypeDevice, archetypeOs, archetypeSafari].join(' · ');
const archetypeColumnLabel = `${archetypeDevice} · ${archetypeOs}`;

// S18 (2026-07-04) — Fleet v2 re-skin (PageHero + .section-label
// eyebrows + .card link grid + AA-safe tk-accent-text for accent
// TEXT; raw tk-accent stays on borders only). Every claim, figure,
// and table cell is byte-identical to the pre-redesign page; the
// CUMULATIVE_RIG bindings above are unchanged from S10.
---

<BaseLayout
  title="Cumulative rig methodology"
  description="The signal-by-signal methodology behind Driftstack's iPhone fingerprint claim. How each measurable signal is produced, what a real iPhone returns, and what a typical Chromium-stealth tool returns."
>
  <!-- Hero -->
  <PageHero label="Trust center · Cumulative rig" title="Cumulative rig methodology.">
    <Breadcrumbs
      slot="crumbs"
      class="mb-5"
      items={[{ name: 'Home', href: '/' }, { name: 'Trust center', href: '/trust/' }, { name: 'Cumulative rig' }]}
    />
    <p class="mt-6 max-w-prose text-lg text-tk-ink-2 leading-relaxed">
      The cumulative rig is the full set of measurable signals a
      detection system can read from a browser session. Driftstack's
      product claim — indistinguishable from a real iPhone — is only
      meaningful if every signal in the rig matches what the
      reference phone sends. This page documents what we measure,
      how, and against which reference.
    </p>
    <p class="mt-4 max-w-prose text-base text-tk-ink-2 leading-relaxed">
      The table below shows the rig run against
      <strong>{archetypeDisplay}</strong> as a worked example. The
      same methodology runs against every archetype in the catalog —
      {DEVICE_SUPPORT.archetypeCount} profiles, {DEVICE_SUPPORT.deviceFamilies},
      on iOS {DEVICE_SUPPORT.iosVersions}, Safari {DEVICE_SUPPORT.safariVersions}.
      (An archetype is one specific iPhone model + iOS version +
      Safari version combination — see
      <a href="/glossary/#archetype" class="text-tk-accent-text underline">the glossary</a>.)
      If any signal differs from what the real phone sends, we treat
      it as a launch-blocking bug and fix the engine — not a
      JavaScript wrapper over it.
    </p>
  </PageHero>

  <!-- Why the rig is "cumulative" -->
  <section class="border-t border-tk-border">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="section-label">Why cumulative</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">Any single signal is easy. Every signal at once is the hard part.</h2>
      <p class="mt-6 max-w-prose text-base text-tk-ink-2 leading-relaxed">
        A stealth Chromium tool can spoof the user-agent string in five
        minutes. It can fake the screen size in another five. But the
        deeper measurements — how the browser draws an invisible test
        image (the canvas hash), which graphics engine it reports (the
        WebGL renderer), how its audio system rounds numbers (the
        AudioContext fingerprint), how its fonts measure on screen
        (the Core Text font-metric output), even the timing rhythm of
        its JavaScript engine
        — those leak the underlying Chromium engine in the next layer
        of measurement.
      </p>
      <p class="mt-4 max-w-prose text-base text-tk-ink-2 leading-relaxed">
        Detection systems combine many signals into one score. A
        single mismatch — the browser introduces itself as an iPhone
        (its user-agent, "UA"), but its drawing output betrays
        Chrome's engine (the canvas hash says Blink) —
        flags the session as inauthentic. Driftstack's claim isn't
        "we got the user-agent right." It's "every signal in the rig,
        at the same time, returns the iPhone value."
      </p>
    </div>
  </section>

  <!-- The signal table -->
  <section class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="section-label">Measured signals</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">Signal-by-signal table.</h2>
      <p class="mt-4 max-w-prose text-base text-tk-ink-2 leading-relaxed">
        Each row is a signal a detection system can read. The
        "Driftstack" column is what an iPhone 16 Pro returns; the
        "Stealth Chromium" column is what a representative
        Chromium-with-stealth-plugin tool returns. Cells marked
        <code class="font-mono text-tk-accent-text">unique-per-session</code>
        are the giveaway that matters most: a real iPhone returns the same
        value as millions of other iPhones — that is what
        population-stable means in the Driftstack column — so any
        tool that returns
        a hash unique to its own session has already given itself
        away.
      </p>

      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[700px] border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-tk-accent">
              <th
                class="sticky left-0 bg-tk-surface px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3"
              >
                Signal
              </th>
              <th class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3">
                Stealth Chromium
              </th>
              <th class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-accent-text">
                Driftstack ({archetypeColumnLabel})
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-tk-border">
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">navigator.userAgent</td>
              <td class="px-4 py-3 text-tk-ink-3">spoofed string</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">iPhone Safari UA (unmodified)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">navigator.platform</td>
              <td class="px-4 py-3 text-tk-ink-3">spoofed</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">"iPhone"</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">Canvas 2D hash</td>
              <td class="px-4 py-3 text-tk-ink-3">unique-per-session (Skia)</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">population-stable (Core Graphics)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">WebGL renderer</td>
              <td class="px-4 py-3 text-tk-ink-3">"ANGLE / SwiftShader"</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">"Apple GPU"</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">WebGL hash</td>
              <td class="px-4 py-3 text-tk-ink-3">unique-per-session</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">population-stable</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">AudioContext fingerprint</td>
              <td class="px-4 py-3 text-tk-ink-3">Blink audio backend</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">iOS audio backend</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">Font metric outputs</td>
              <td class="px-4 py-3 text-tk-ink-3">Linux / desktop fonts</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">iOS Core Text metrics</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">JavaScript engine timing</td>
              <td class="px-4 py-3 text-tk-ink-3">V8 latency profile</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">JSCore latency profile</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">TLS ClientHello fingerprint</td>
              <td class="px-4 py-3 text-tk-ink-3">Chrome / Edge profile</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">iOS Safari profile</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">Touch-event support flag</td>
              <td class="px-4 py-3 text-tk-ink-3">absent or spoofed</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">native</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">Screen dimensions + pixel density (DPR)</td>
              <td class="px-4 py-3 text-tk-ink-3">configurable</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">393x852 @ 3x (iPhone 16 Pro)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">CSS @media (hover) value</td>
              <td class="px-4 py-3 text-tk-ink-3">"hover"</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">"none" (touch device)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">requestIdleCallback presence</td>
              <td class="px-4 py-3 text-tk-ink-3">present (Chromium)</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">absent (Safari)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-tk-ink">
                Same fingerprint, session after session?
                <span class="mt-0.5 block font-normal text-xs text-tk-ink-3">Hash uniqueness across sessions</span>
              </td>
              <td class="px-4 py-3 text-tk-ink-3">100% unique</td>
              <td class="px-4 py-3 font-mono text-tk-accent-text">population-stable</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-6 max-w-prose text-sm text-tk-ink-3">
        14 signals shown above. The internal rig measures 60+ signals
        across every session built; the published subset is the ones
        that most decide whether a detection system classifies a
        session as real or fake.
      </p>
    </div>
  </section>

  <!-- Launch-blocker policy -->
  <section class="border-t border-tk-border">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="section-label">Launch-blocker policy</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink">Any drift from the reference is a launch-blocking bug.</h2>
      <p class="mt-6 max-w-prose text-base text-tk-ink-2 leading-relaxed">
        Every Driftstack engine build runs the cumulative rig against
        the reference iPhone. If any signal differs from what the
        reference returns, the build does not ship. We don't paper
        over individual signals with JavaScript patches ("shims")
        layered on top — that's the
        approach every stealth-plugin tool takes, and it's exactly
        what the rig catches.
      </p>
      <p class="mt-4 max-w-prose text-base text-tk-ink-2 leading-relaxed">
        When Apple ships a new iOS or Safari version, our target (the
        reference) moves and the engine has to catch up. Until it
        fully matches the new version, we keep offering the previous
        version's profiles — a phone Apple really shipped — as the
        customer-facing archetype; the engine
        targets the prior iOS, not a half-built blend of old and new.
      </p>
    </div>
  </section>

  <!-- Cross-references -->
  <section class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="section-label">Related</p>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <a href="/trust/security-overview/" class="card group p-6">
          <h3 class="font-mono text-sm text-tk-ink group-hover:text-tk-accent-text">
            /trust/security-overview
          </h3>
          <p class="mt-3 text-sm text-tk-ink-2">
            the live security checklist — every security claim mapped
            to its evidence.
          </p>
        </a>
        <a href="/comparison/" class="card group p-6">
          <h3 class="font-mono text-sm text-tk-ink group-hover:text-tk-accent-text">
            /comparison
          </h3>
          <p class="mt-3 text-sm text-tk-ink-2">
            how Driftstack's fingerprint posture compares to other
            browser-API vendors.
          </p>
        </a>
        <a href="/security/" class="card group p-6">
          <h3 class="font-mono text-sm text-tk-ink group-hover:text-tk-accent-text">
            /security
          </h3>
          <p class="mt-3 text-sm text-tk-ink-2">
            TLS posture, scrypt-hashed keys, HMAC webhooks,
            no-customer-data-access enforcement.
          </p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
