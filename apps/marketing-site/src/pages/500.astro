---
// Fleet v2 (2026-07-03) — sober 500. Headline in plain words; the on-us
// framing, support escape-hatch, and status-site pointer are unchanged.
// Deliberately tiny and dependency-free: BaseLayout + recipe classes only.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="500 · Driftstack" description="Something went wrong on our end." noindex>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-glow-radial-accent opacity-60" aria-hidden="true"></div>
    <div class="absolute inset-0 grid-bg opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-32 text-center animate-fade-up">
      <p class="section-label">500</p>
      <h1 class="mt-6 text-5xl font-semibold tracking-tight text-tk-ink md:text-6xl">
        Something broke on our side.
      </h1>
      <p class="mt-6 max-w-prose mx-auto text-tk-ink-2 leading-relaxed">
        This is on us, not you. The error has been captured and we'll look
        into it. If this is blocking something time-sensitive, email
        <a href="mailto:support@driftstack.dev" class="text-tk-accent-text underline underline-offset-4">support@driftstack.dev</a>
        with the URL you were on and we'll get back to you.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">Back home</a>
        <a href="https://status.driftstack.io" class="btn-secondary">See status</a>
      </div>
      <p class="mt-8 text-xs text-tk-ink-3">
        Live status: <a href="https://status.driftstack.io" class="text-tk-accent-text underline underline-offset-4">status.driftstack.io</a>.
      </p>
    </div>
  </section>
</BaseLayout>
