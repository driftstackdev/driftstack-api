---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="500 · Driftstack" description="Something went wrong on our end.">
  <section class="bg-surface-raised">
    <div class="mx-auto max-w-3xl px-6 py-32 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-glow-red">500</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink-primary">
        Something went wrong on our end.
      </h1>
      <p class="mt-4 text-ink-secondary">
        This is on us, not you. The error has been captured; we'll look at
        it. If this is blocking something time-sensitive, email
        <a href="mailto:support@driftstack.dev" class="text-glow-red underline">support@driftstack.dev</a>
        with the URL you were on.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/" class="btn-primary">Back home</a>
        <a href="https://status.driftstack.dev" class="btn-secondary">See status</a>
      </div>
      <p class="mt-8 text-xs text-ink-muted">
        Status page lives at status.driftstack.dev when it lands. Until
        then, check the Twitter/X account or email support.
      </p>
    </div>
  </section>
</BaseLayout>
