---
// Fleet v2 (2026-07-03) — re-skin only: PageHero + the .card/IconTile
// recipes, AA-safe accent text. Every card, href, and copy block is
// byte-identical to the pre-redesign page (the docs-landing pair + the
// 63 doc-parity chains pin them); no card added or removed (see the
// W210 note below on the deliberately missing Recipe library card).
// S47 2026-07-07 (founder-approved: mirror deprecation) — the
// Quickstart card now points at the verified docs successor
// (docs.driftstack.dev/quickstart-curl/); the legacy
// /docs/api-quickstart mirror page is deleted + 301-redirected via
// public/_redirects.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IconTile from '../components/IconTile.astro';
---

<BaseLayout
  title="Docs"
  description="Driftstack documentation: quickstart, SDK references for TypeScript / Python / Go, API reference, self-hosted setup, recipe library."
>
  <!-- Hero -->
  <PageHero label="Docs" title="Everything you need to drive a session.">
    <p class="mt-5 max-w-prose text-lg leading-8 text-tk-ink-2">
      Quickstarts for every supported language, the full API reference,
      SDK guides, self-hosted setup, and the recipe catalogue. Driftstack
      is small enough to read end-to-end — start with the quickstart
      and follow the link trail.
    </p>
  </PageHero>

  <!-- Doc categories -->
  <section class="bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-6 md:grid-cols-3">
        <a href="https://docs.driftstack.dev/quickstart-curl/" class="group card p-6">
          <IconTile class="mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12l5 5L20 7" />
            </svg>
          </IconTile>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">
            Quickstart
          </p>
          <h2 class="mt-3 text-xl font-semibold text-tk-ink transition-colors group-hover:text-tk-accent-text">
            Five minutes to first session →
          </h2>
          <p class="mt-3 text-sm text-tk-ink-2">
            Install the SDK in your language, paste an API key, drive
            your first session. No prior browser-automation experience
            needed.
          </p>
        </a>

        <a href="/api-reference/" class="group card p-6">
          <IconTile class="mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
            </svg>
          </IconTile>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">
            API reference
          </p>
          <h2 class="mt-3 text-xl font-semibold text-tk-ink transition-colors group-hover:text-tk-accent-text">
            Every endpoint, every shape →
          </h2>
          <p class="mt-3 text-sm text-tk-ink-2">
            Auto-generated from the OpenAPI 3.1 spec. Try requests
            against your own API key directly in the browser. Same
            spec the SDK codegen reads.
          </p>
        </a>

        <a href="/docs/sdk-typescript/" class="group card p-6">
          <IconTile class="mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
            </svg>
          </IconTile>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">SDKs</p>
          <h2 class="mt-3 text-xl font-semibold text-tk-ink transition-colors group-hover:text-tk-accent-text">
            TypeScript · Python · Go →
          </h2>
          <p class="mt-3 text-sm text-tk-ink-2">
            Native packages on npm, PyPI, and as a Go module. Typed
            request/response shapes. Retry-with-backoff. Webhook
            signature verification. Async iterators for paginated
            list endpoints.
          </p>
        </a>

        <a href="/docs/webhooks/" class="group card p-6">
          <IconTile class="mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
          </IconTile>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">Webhooks</p>
          <h2 class="mt-3 text-xl font-semibold text-tk-ink transition-colors group-hover:text-tk-accent-text">
            Event types + signature verification →
          </h2>
          <p class="mt-3 text-sm text-tk-ink-2">
            All eight subscribable event types — session.completed, session.failed,
            api_key.revoked,
            session.egress_capability_changed, crypto.order.paid,
            crypto.order.failed, session.challenge_detected,
            session.profile_save_failed — with payload shapes
            and HMAC-SHA256 verification examples.
          </p>
        </a>

        <a href="/self-hosted/" class="group card p-6">
          <IconTile class="mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="18" rx="2" /><path d="M2 9h20M8 14h.01M12 14h.01" />
            </svg>
          </IconTile>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-accent-text">
            Self-hosted
          </p>
          <h2 class="mt-3 text-xl font-semibold text-tk-ink transition-colors group-hover:text-tk-accent-text">
            Deploy on your own hardware →
          </h2>
          <p class="mt-3 text-sm text-tk-ink-2">
            SKU comparison, hardware specs, onboarding flow. For
            sustained high-concurrency operations or full data
            sovereignty.
          </p>
        </a>

        {/* The recipe API is documented on docs.driftstack.dev/api/recipes/.
            Keep this landing grid focused on the primary onboarding paths. */}
      </div>
    </div>
  </section>

  {/* 2026-05-23 — icon on docs help-banner h2. */}
  <!-- Help banner -->
  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="flex flex-col items-start gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="flex items-center gap-2 text-xl font-semibold text-tk-ink">
            <span class="flex h-8 w-8 items-center justify-center rounded-md border border-tk-accent/20 bg-tk-accent/10 text-tk-accent-text" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                <path d="M12 17h.01" />
              </svg>
            </span>
            Doc not landing?
          </h2>
          <p class="mt-2 max-w-prose text-sm text-tk-ink-2">
            Email <a
              href="mailto:support@driftstack.dev"
              class="text-tk-accent-text underline">support@driftstack.dev</a> with the URL you expected to find. We answer in writing,
            usually same business day.
          </p>
        </div>
        <a href="https://github.com/driftstackdev" class="btn-secondary">GitHub →</a>
      </div>
    </div>
  </section>
</BaseLayout>
