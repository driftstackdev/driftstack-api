---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import IconTile from '../components/IconTile.astro';

// V-472 — comparison page. Driftstack vs Browserless / Bright Data /
// ScrapingBee / Browserbase. Tone: differentiation, not disparagement.
// Each competitor has a legitimate audience and use-case; the page
// names where Driftstack's posture is materially different and where
// it isn't a fit.
//
// Content claims about competitors are confined to category-level
// facts that are uncontroversial from each vendor's own marketing
// (Chromium-based, proxy-network-first, scraping-API surface, etc.).
// No performance benchmarks vs them — those land on the future
// /benchmarks subdomain (V-345) once empirical data is collected.

interface ComparisonRow {
  feature: string;
  driftstack: string;
  browserless: string;
  brightData: string;
  scrapingBee: string;
  browserbase: string;
}

const COMPARISON_ROWS: ComparisonRow[] = [
  {
    feature: 'Browser engine',
    driftstack: "Apple WebKit — our own build of Apple's source code",
    browserless: 'Chromium / Chrome',
    brightData: 'Chromium-based scraping browser',
    scrapingBee: 'Chromium (Puppeteer)',
    browserbase: 'Chromium / Stagehand',
  },
  {
    feature: 'Primary device target',
    driftstack: 'iPhone 15 Pro / 16 Pro / 17 family · iOS 18.7 · Safari 26.4-26.5',
    browserless: 'Desktop Chrome',
    brightData: 'Desktop Chrome with a simulated mobile identity',
    scrapingBee: 'Desktop Chrome',
    browserbase: 'Desktop Chrome',
  },
  {
    feature: 'Stealth approach',
    driftstack: 'Built into the source itself — nothing patched over while the page runs',
    browserless: 'Stealth plugins (puppeteer-extra)',
    brightData: 'Proprietary anti-detection layer',
    scrapingBee: 'Stealth headers + rotating proxies',
    browserbase: 'Stealth bundles + AI-assisted',
  },
  {
    feature: 'Fingerprint posture',
    driftstack: 'Graphics fingerprints match what real iPhones produce',
    browserless: 'Configurable per session',
    brightData: 'Real-device fingerprint pool (rotated)',
    scrapingBee: 'Auto-rotated browser identity + headers',
    browserbase: 'Per-session profiles',
  },
  {
    feature: 'Pricing model',
    driftstack: 'Per concurrent session (how many run at once); hours never billed',
    browserless: 'Per browser-hour + per-unit',
    brightData: 'Per GB + per request',
    scrapingBee: 'Per API call (request credits)',
    browserbase: 'Per browser-hour',
  },
  {
    feature: 'Billing surprises',
    driftstack: 'None — one flat price within your session limit',
    browserless: 'Idle browser hours billable',
    brightData: 'Data-transfer (GB) charges can spike',
    scrapingBee: 'JavaScript-heavy pages cost more credits',
    browserbase: 'Idle browser hours billable',
  },
  {
    feature: 'Customer-controlled proxies',
    driftstack: 'Bring your own: SOCKS5 proxy, OpenVPN, or WireGuard VPN — attached per profile. A VPN or UDP-capable proxy carries WebRTC and HTTP/3 too; on a TCP-only proxy, HTTP/3 is switched off rather than leaked',
    browserless: 'Per-session HTTP/HTTPS proxy config',
    brightData: 'Their proxy network is the product',
    scrapingBee: 'Bundled (their pool)',
    browserbase: 'Per-session HTTP/HTTPS proxy config',
  },
  {
    feature: 'Data residency',
    // S30 2026-07-07 (founder decision: soften) — "EU-only ... storage"
    // over-claimed: file objects live on Cloudflare R2 in the default
    // jurisdiction (EU + US replication). Compute + database are EU-true.
    driftstack: 'Servers and database in the EU; uploaded files on cloud storage that can replicate outside the EU',
    browserless: 'US / EU regions',
    brightData: 'Global; configurable per plan',
    scrapingBee: 'US default',
    browserbase: 'US / EU regions',
  },
  {
    feature: 'Point-and-click app for human operators',
    driftstack: 'Yes — desktop app (Manual plans)',
    browserless: 'API-first (no desktop app)',
    brightData: 'Browser product + dashboard',
    scrapingBee: 'API-first (no desktop app)',
    browserbase: 'Replay viewer + dashboard',
  },
  {
    feature: 'SDK languages',
    driftstack: 'TypeScript · Python · Go',
    browserless: 'Any (REST + Puppeteer)',
    brightData: 'Any (REST + scraping browser)',
    scrapingBee: 'Any (REST)',
    browserbase: 'TypeScript · Python',
  },
  {
    feature: 'Self-hosted option',
    driftstack: 'Yes — three plans (source-code escrow on Enterprise)',
    browserless: 'Yes — open-source core',
    brightData: 'No',
    scrapingBee: 'No',
    browserbase: 'No',
  },
  {
    feature: 'Trial path',
    driftstack: 'Free tier · 1 profile · manual · never expires',
    browserless: 'Free tier with usage cap',
    brightData: 'Free trial with credit',
    scrapingBee: '1,000 free credits',
    browserbase: 'Free credits on signup',
  },
];
---

<BaseLayout
  title="Comparison"
  description="How Driftstack compares to Browserless, Bright Data, ScrapingBee, and Browserbase. Apple's WebKit (the browser iPhones actually use) vs Chromium. iPhone Safari vs desktop. Flat pricing by how many sessions run at once vs hourly or per-call charges."
  ogImage="/og/comparison.png"
>
  <!-- Hero -->
  <PageHero label="Comparison" title="How Driftstack compares.">
    <p class="mt-5 max-w-2xl text-lg leading-8 text-tk-ink-2">
      Driftstack and the platforms below all give code or humans a remote
      browser session. The difference is in <strong>which browser</strong>,
      <strong>how fingerprints are produced</strong>, and
      <strong>what shows up on the invoice</strong>.
    </p>
    <p class="mt-3 max-w-2xl text-base leading-7 text-tk-ink-2">
      Each row in the table below is a category-level fact pulled from each
      vendor's own marketing — not a benchmark, not a value judgement.
      Pick whichever fits your workload; Driftstack is the right answer for
      a specific shape of problem, and we name where it isn't.
    </p>
  </PageHero>

  <!-- Band-A primer — what this product category even is, for readers
       landing here from a search without the homepage context. -->
  <section class="bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <p class="section-label">Start here</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-tk-ink sm:text-3xl">
        What is an anti-detect browser — and why websites catch them
      </h2>
      <div class="mt-6 max-w-prose space-y-4 text-base leading-relaxed text-tk-ink-2">
        <p>
          Websites read hundreds of small signals from every visitor's browser
          — screen size, fonts, how it draws graphics, how it plays audio —
          and add them up into a fingerprint of the device. An anti-detect
          browser is a tool that changes those signals, so a session looks
          like it came from a different device than the one actually running
          it.
        </p>
        <p>
          Most anti-detect tools start with a desktop browser and dress it up
          as something else — an iPhone identity string here, a patched-over
          browser detail there. That's a costume, and websites have gotten
          very good at spotting the costume: the surface says "iPhone" while
          the layers underneath (graphics fingerprints, timing, error
          messages) still say otherwise. One mismatch is all a detection
          system needs.
        </p>
        <p>
          Driftstack takes a different path: instead of dressing up another
          browser as an iPhone, it runs the browser the iPhone actually uses
          — Apple's WebKit — so the signals aren't imitated; they're the
          real thing. The table below compares that
          approach with four popular platforms, and names the workloads where
          each of them is the better pick.
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="border-t border-tk-border bg-tk-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="max-w-prose text-base text-tk-ink-2">
        The <strong>Fingerprint posture</strong> row decides most
        detections. When a website checks how a browser draws graphics (its
        <a href="/glossary/#canvas-hash" class="text-tk-accent-text underline">canvas</a>
        and WebGL fingerprints), Driftstack produces the same results real
        iPhones produce — so a session blends into the crowd of genuine
        iPhone visitors. A tool that generates a fresh identity for every
        session stands out for exactly that reason: a fingerprint no real
        device shares is itself a giveaway. The signal-by-signal methodology
        is in
        <a href="/trust/cumulative-rig/" class="text-tk-accent-text underline"
          >the full signal table</a>.
      </p>
      <!-- M.5 (Part F2) mobile scroll-cue: the 6-column competitor
           table forces a min-width of 900px (below that it would
           collapse to unreadable). The overflow-x-auto wrapper lets
           the table pan horizontally on smaller viewports, and the
           right-edge gradient fade signals "you can pan this" so
           the affordance isn't silent. md:hidden on the fade because
           the desktop view shows the whole table in-frame. -->
      <div class="relative mt-10">
        <div class="overflow-x-auto">
        <table class="w-full min-w-[900px] border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-tk-accent">
              <th
                class="sticky left-0 bg-tk-surface px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3"
              >
                Feature
              </th>
              <th
                class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-accent-text"
              >
                Driftstack
              </th>
              <th
                class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3"
              >
                Browserless
              </th>
              <th
                class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3"
              >
                Bright Data
              </th>
              <th
                class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3"
              >
                ScrapingBee
              </th>
              <th
                class="px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-tk-ink-3"
              >
                Browserbase
              </th>
            </tr>
          </thead>
          <tbody>
            {
              COMPARISON_ROWS.map((row) => (
                <tr class="border-b border-tk-border align-top">
                  <th
                    scope="row"
                    class="sticky left-0 bg-tk-surface px-4 py-3 text-left text-sm font-medium text-tk-ink-2"
                  >
                    {row.feature}
                  </th>
                  <td class="px-4 py-3 text-tk-ink">
                    <span class="font-medium">{row.driftstack}</span>
                  </td>
                  <td class="px-4 py-3 text-tk-ink-2">{row.browserless}</td>
                  <td class="px-4 py-3 text-tk-ink-2">{row.brightData}</td>
                  <td class="px-4 py-3 text-tk-ink-2">{row.scrapingBee}</td>
                  <td class="px-4 py-3 text-tk-ink-2">{row.browserbase}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        </div>
        <!-- Mobile-only scroll-cue gradient on the right edge.
             Hidden at md+ where the table fits in-viewport. -->
        <div
          class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-tk-surface to-transparent md:hidden"
          aria-hidden="true"
        ></div>
      </div>
      <p class="mt-6 max-w-prose text-xs text-tk-ink-3">
        Last reviewed 2026-05-10. If a competitor row drifts from current
        public marketing, mail
        <a href="mailto:support@driftstack.dev" class="text-tk-accent-text underline"
          >support@driftstack.dev</a
        > and we'll update.
      </p>
    </div>
  </section>

  <!-- Per-competitor sections -->
  <Section
    label="Side-by-side"
    title="When each is the right answer."
    lead="We name the workload each platform fits. If yours doesn't match Driftstack, we'd rather you find the right tool than buy the wrong one and churn."
    class="bg-tk-bg"
  >
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <!-- Browserless -->
      <div class="card p-6">
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
          </svg>
        </IconTile>
        <h3 class="text-xl font-semibold text-tk-ink">Driftstack vs Browserless</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          Browserless is the canonical "Chrome-as-a-service" platform —
          you rent Chrome browsers in their cloud and drive them with the
          standard developer tools (Puppeteer / Playwright); the core is
          open source and can be self-hosted. Pick Browserless when the
          target site renders fine on desktop Chrome and you don't need
          iOS-specific signals.
        </p>
        <p class="mt-3 text-sm text-tk-ink-2">
          Pick Driftstack when the target site checks iPhone-specific
          signals — the browser's identity string, touch-screen events, how
          Apple renders fonts — and a Chrome-shaped answer would give the
          game away.
        </p>
        <p class="mt-3 flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-tk-ink-3">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent-text" aria-hidden="true">
            <line x1="12" y1="1" x2="12" y2="23" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          Pricing shape
        </p>
        <p class="mt-1 text-sm text-tk-ink-2">
          Browserless bills by browser-hour plus per-operation charges. Idle
          browsers count. Driftstack bills a flat rate for how many sessions
          run at once; idle time within that limit is free.
        </p>
      </div>

      <!-- Bright Data -->
      <div class="card p-6">
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5" /><path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6" />
          </svg>
        </IconTile>
        <h3 class="text-xl font-semibold text-tk-ink">Driftstack vs Bright Data</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          Bright Data's core asset is its proxy network — residential, ISP,
          mobile, datacenter pools at large scale. The Scraping Browser is
          a Chromium-derived product layered on top. Pick Bright Data when
          the unlock you need is
          <strong>which IP the request comes from</strong>, not which
          browser engine renders the page.
        </p>
        <p class="mt-3 text-sm text-tk-ink-2">
          Pick Driftstack when the unlock you need is the engine — Apple's
          WebKit returning the fingerprints a real iPhone returns. Bring the
          proxy network you already pay for — over SOCKS5, OpenVPN, or
          WireGuard. We don't sell proxies and we never charge for
          bandwidth: your traffic runs through your own proxy or VPN.
        </p>
        <p class="mt-3 flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-tk-ink-3">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent-text" aria-hidden="true">
            <line x1="12" y1="1" x2="12" y2="23" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          Pricing shape
        </p>
        <p class="mt-1 text-sm text-tk-ink-2">
          Bright Data bills per GB transferred + per request on most
          products. Driftstack bills a flat rate for how many sessions run
          at once; your traffic runs over your own proxy or VPN, so
          bandwidth never shows up on our invoice at all.
        </p>
      </div>

      <!-- ScrapingBee -->
      <div class="card p-6">
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 7l9-4 9 4-9 4-9-4z" /><path d="M3 17l9 4 9-4M3 12l9 4 9-4" />
          </svg>
        </IconTile>
        <h3 class="text-xl font-semibold text-tk-ink">Driftstack vs ScrapingBee</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          ScrapingBee's API surface is the simplest of any vendor in this
          list — POST a URL, get HTML or extracted data back. Stealth
          headers and proxy rotation are bundled. Pick ScrapingBee when the
          workload is
          <strong>fetch-this-page-and-hand-me-the-contents</strong> and you
          don't need to interact with the page after rendering.
        </p>
        <p class="mt-3 text-sm text-tk-ink-2">
          Pick Driftstack when the workload is interactive — multi-step
          checkouts, form fills, pop-up dialogs, staying logged in across
          many requests, cookies that stay saved with each profile — and
          the engine needs to be iPhone Safari, not generic Chromium.
        </p>
        <p class="mt-3 flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-tk-ink-3">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent-text" aria-hidden="true">
            <line x1="12" y1="1" x2="12" y2="23" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          Pricing shape
        </p>
        <p class="mt-1 text-sm text-tk-ink-2">
          ScrapingBee bills per API call, with extra charges for harder
          pages (premium proxies, JavaScript rendering). Predictable per
          fetch. Driftstack bills a flat rate for how many sessions run at
          once, regardless of how many actions run inside each session.
        </p>
      </div>

      <!-- Browserbase -->
      <div class="card p-6">
        <IconTile class="mb-3">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="8" width="16" height="12" rx="2" /><path d="M12 8V4M9 4h6" /><circle cx="9" cy="14" r="1" /><circle cx="15" cy="14" r="1" />
          </svg>
        </IconTile>
        <h3 class="text-xl font-semibold text-tk-ink">Driftstack vs Browserbase</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          Browserbase is a managed Chromium platform optimized for AI
          agent workloads — Stagehand integration, a replay viewer for
          debugging agent runs, monitoring tuned to AI-driven sessions.
          Pick Browserbase when your agent stack is built around Chromium
          and your target sites accept desktop Chrome.
        </p>
        <p class="mt-3 text-sm text-tk-ink-2">
          Pick Driftstack when the agent needs to look like a real iPhone
          visitor — same engine, same fingerprints, same touch events,
          same font rendering. Our optional AI agent drives the same real
          iPhone browser your code does — there's no desktop Chrome hidden
          underneath.
        </p>
        <p class="mt-3 flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-tk-ink-3">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-tk-accent-text" aria-hidden="true">
            <line x1="12" y1="1" x2="12" y2="23" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          Pricing shape
        </p>
        <p class="mt-1 text-sm text-tk-ink-2">
          Browserbase bills browser-hours; idle counts. Driftstack bills a
          flat rate for how many sessions run at once; idle time within that
          limit is free. You can use your own Anthropic key with no
          Driftstack markup. On plans that offer it, you can also opt in to
          Driftstack-provided AI access, which runs against a monthly budget
          you control and isn't billed separately today.
        </p>
      </div>
    </div>
  </Section>

  <!-- When NOT Driftstack -->
  <Section
    label="Where Driftstack isn't the fit"
    title="When to pick something else."
    class="bg-tk-surface"
  >
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      <div>
        <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg border border-tk-border bg-tk-surface text-tk-ink-3" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-tk-ink">Desktop-only targets</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          If your target site is a B2B dashboard or an internal tool that
          only desktop users hit, an iPhone fingerprint buys you nothing
          and may attract attention. Browserless or Browserbase are the
          cleaner picks.
        </p>
      </div>
      <div>
        <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg border border-tk-border bg-tk-surface text-tk-ink-3" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-tk-ink">Pure HTML scraping</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          "Fetch URL, extract data, never interact" is exactly the workload
          ScrapingBee and similar API-first scrapers price for. For that
          kind of job Driftstack costs more per page — you'd be paying for
          browser realism you don't need.
        </p>
      </div>
      <div>
        <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg border border-tk-border bg-tk-surface text-tk-ink-3" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-tk-ink">When the proxy pool is the product</h3>
        <p class="mt-3 text-sm text-tk-ink-2">
          If what you're buying is residential / mobile / ISP addresses at
          scale and the engine is interchangeable, Bright Data or a
          dedicated proxy vendor will outprice us. Driftstack expects you
          to bring your own proxy or VPN for traffic to the open internet.
        </p>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <section class="border-t border-tk-border bg-tk-bg">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="section-label">Try it</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-tk-ink">Free tier — one profile, manual, perpetual.</h2>
          <p class="mt-3 max-w-prose text-tk-ink-2">
            The free tier is the simplest way to verify whether the iPhone
            engine difference matters for your workload. If the answer is
            no, the comparison above will help you pick the right alternative.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/pricing/#free" class="btn-primary">Start free</a>
          <a href="/pricing/" class="btn-secondary">See full pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
