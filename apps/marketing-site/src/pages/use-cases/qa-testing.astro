---
// /use-cases/qa-testing (2026-07-03, S14 / D8) — persona page for
// QA + engineering teams. This is a developer page, so code belongs
// here: the CodeWindow reuses the homepage SDK snippet verbatim
// (locked archetype slug 'iphone17_ios18_7_safari26_4' — registry-
// enforced by the workspace archetype sweeps). Claim register:
// homepage §4 card ("Test on the real thing" / the-bug-you-reproduce
// line), §8 FOR DEVELOPERS (SDK trio + plain-HTTPS integrations),
// faq.ts free-tier answer (free is manual-only; every paid tier
// includes API access — the API ladder is the one built/sized for
// code-first workloads; S43 2026-07-07 claims fix).
// 2026-09-15 truth pass: the exact-engine / same-engine-as-your-users
// wording → "a build of Apple's own WebKit — the engine family behind
// iPhone Safari, checked against real iPhones" (A1: per-surface evidence,
// not blanket identity); the device Stat binds to DEVICE_SUPPORT instead
// of naming three model families by hand (the catalog offers 19 models);
// capture kinds, profile snapshots, webhooks and device-code sign-in are
// shipped routes the page never mentioned.
// 2026-09-16 readability pass: the hero and the problem section are Band A —
// short sentences, no unexplained vocabulary ("CI" is spelled out where the
// developer band introduces it). The "// wire it into CI" band stays Band C:
// its intro sentence was made plain, the snippet and the technical paragraphs
// beside it keep their precision.
// 2026-09-16 (verifier fix): the plain line over the ephemerality Stat says
// SESSION, not phone. Site-wide a phone IS a profile (glossary #profile: "each
// profile looks like the same physical phone coming back, every session, every
// time"), so a plain line about a new phone each run over-reached its own
// technical line — which is about sessions — and contradicted the
// persistent-profile reuse this page offers a few lines below.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Section from '../../components/Section.astro';
import Stat from '../../components/Stat.astro';
import CodeWindow from '../../components/CodeWindow.astro';
import CtaBand from '../../components/CtaBand.astro';
import { DEVICE_SUPPORT } from '../../data/capabilities';
import { API_TIERS } from '../../data/pricing';

const freeTier = API_TIERS.find((t) => t.id === 'free')!;
---

<BaseLayout
  title="QA on real iPhone Safari"
  description="Run your end-to-end tests on a real iPhone browser in the cloud, started with one API call. It is a build of Apple's own WebKit, the engine family behind iPhone Safari. TypeScript, Python, and Go SDKs."
  ogImage="/og/use-cases.png"
>
  <PageHero
    label="Use cases · QA + engineering teams"
    title="Test on the real thing."
    lead="Your users are on iPhones. Your test grid probably isn't. Driftstack gives your tests a real iPhone browser in the cloud, started with one API call. It runs a build of Apple's own WebKit, the engine family behind iPhone Safari."
  >
    <Breadcrumbs
      slot="crumbs"
      class="mb-5"
      items={[{ name: 'Home', href: '/' }, { name: 'Use cases', href: '/use-cases/' }, { name: 'QA + testing' }]}
    />
  </PageHero>

  <Section
    label="The problem"
    title="The bug you can't reproduce is on a phone."
  >
    <div class="mt-8 max-w-prose space-y-5 text-base leading-7 text-tk-ink-2">
      <p>
        Mobile Safari is its own world: its own rendering, its own JavaScript
        timing, its own quirks. A desktop browser shrunk to 390 pixels wide
        does not reproduce it. The layout break your iPhone users hit simply
        isn't there. Your suite stays green while your users see a broken page.
      </p>
      <p>
        Driftstack sessions run a browser built from Apple's WebKit source —
        the engine family behind iPhone Safari, checked against real iPhones.
        The rendering, the JavaScript timing and the quirks all come from that
        engine, not from a desktop browser in a phone-sized window. So the bug you reproduce is the bug your
        users hit, and the fix you verify is the fix they get. There is no
        hardware to buy.
      </p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <Stat
        plain="A real iPhone browser, not a lookalike"
        technical="Built from Apple's WebKit source code — the engine family behind Safari on every iPhone — not a desktop browser shrunk to phone width"
      />
      <Stat
        plain="The iPhones your users hold"
        technical={`19 iPhone models, from the 13 to the 17 Pro Max — ${DEVICE_SUPPORT.selectableCount} device profiles on iOS 18, Safari ${DEVICE_SUPPORT.safariVersions}; the default is the iPhone 17 on iOS 18.7 / Safari 26.4`}
      />
      <Stat
        plain="A fresh session for every test run"
        technical="Sessions are created for each test run and removed after — no devices to keep running between runs"
      />
    </div>
  </Section>

  <Section
    label="// wire it into CI"
    title="Your pipeline speaks HTTPS. So do we."
    lead="Your build-and-test pipeline — CI — starts a session with one call and tears it down when the run ends. First-party SDKs in TypeScript, Python, and Go, plus a plain HTTPS API any HTTP client can drive. Playwright test fixtures, n8n workflows, plain curl from a cron job. The snippet below is the whole session lifecycle."
  >
    <div class="mt-10 grid gap-10 md:grid-cols-2 md:items-center">
      <CodeWindow title="driftstack-typescript-sdk" copyTargetId="qa-sdk-code">
        <pre
          class="text-[11px] leading-relaxed sm:text-xs md:text-sm"
        ><code id="qa-sdk-code">{`import { Driftstack } from '@driftstack/sdk';

const ds = new Driftstack({ apiKey: process.env.DRIFTSTACK_API_KEY });

const session = await ds.sessions.create({
  archetype: 'iphone17_ios18_7_safari26_4',
  label: 'target-flow',
});

try {
  await ds.sessions.navigate(session.id, { url: 'https://target.example' });
  await ds.sessions.capture(session.id, { kind: 'screenshot' });
  const state = await ds.sessions.getState(session.id);
  console.log(state.url, state.title);
} finally {
  await ds.sessions.destroy(session.id);
}`}</code></pre>
      </CodeWindow>
      <div class="space-y-4 text-base leading-7 text-tk-ink-2">
        <p>
          Create a session on the device profile you ship for, drive the flow with
          structured actions (<code class="font-mono text-tk-accent-text">navigate</code>,
          <code class="font-mono text-tk-accent-text">interact</code>,
          <code class="font-mono text-tk-accent-text">capture</code>,
          <code class="font-mono text-tk-accent-text">extract</code>), assert
          on state and screenshots, destroy it in the teardown. A capture
          returns a screenshot, the page's DOM, or a PDF. Every run gets a
          fresh, real iPhone Safari session — or reuse a persistent profile
          when a test needs logged-in state that survives between runs. Through
          the API, a profile snapshot saves that profile's device and name so
          you can spin up a matching fresh profile later.
        </p>
        <p>
          Webhooks tell your pipeline when a session completes or fails, or
          when a site throws a challenge. Your own command-line tools can
          sign in with a browser-approved device code instead of a pasted
          key.
        </p>
        <p>
          Sessions are billed on one number:
          <strong class="text-tk-ink">concurrent</strong>, meaning how many run
          at the same time — think browser tabs. Run your suite in parallel up
          to that limit. Hours and calls inside it are never billed.
        </p>
      </div>
    </div>
  </Section>

  {/* S43 2026-07-07 (founder-approved) — claims fix: programmatic
      access is included on every paid tier, so the lead no longer says
      it "starts on the API ladder"; the API ladder is the path sized
      for code-first workloads. */}
  <Section
    label="Which plan"
    title="Code calling → the API plan family."
    lead="If code is doing the calling, the API plans are the ones built for it. That means SDK keys, sessions started from your pipeline, and limits sized for test suites that run in parallel. Every paid plan includes API access. The API plans' limits are sized for it, and the AI agent is on every API plan."
  >
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/pricing/#api" class="btn-secondary">See API pricing →</a>
      <p class="text-sm text-tk-ink-3">
        The free tier is manual-only ({freeTier.archetypeAccess}). Use it to
        click through your own pages by hand and see how they render, before
        you connect the SDK.
      </p>
    </div>
  </Section>

  <CtaBand
    title="Green in your tests. Green on the phone."
    lead="Check the rendering by hand on the free tier. Point your pipeline at the API plans once you're convinced."
    primaryHref="/pricing/#free"
    primaryLabel="Start free"
    secondaryHref="https://docs.driftstack.io"
    secondaryLabel="Read the docs"
  />
</BaseLayout>
