{
  "name": "@driftstack/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.1059.0",
    "@aws-sdk/s3-request-presigner": "^3.1059.0",
    "@driftstack/api-types": "*",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/websocket": "^11.2.0",
    "@scalar/fastify-api-reference": "^1.58.0",
    "@sentry/node": "10.65.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.11.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "postmark": "^4.0.7",
    "scrypt-kdf": "^2.0.1",
    "undici": "^8.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@driftstack/sdk": "*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "ws": "^8.21.0"
  }
}
