---
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Driftstack admin panel — Driftstack staff only.',
} = Astro.props;

const fullTitle = `${title} · Driftstack admin`;
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Overview' },
  { href: '/accounts', label: 'Accounts' },
  { href: '/cost', label: 'Cost' },
  { href: '/audit-log', label: 'Audit log' },
  { href: '/incidents', label: 'Incidents' },
  { href: '/status-subscribers', label: 'Status subs' },
  { href: '/sessions', label: 'Sessions' },
  { href: '/fleet', label: 'Fleet' },
  { href: '/api-keys', label: 'API keys' },
  { href: '/webhook-dlq', label: 'Webhook DLQ' },
  { href: '/rate-limit-overrides', label: 'Rate limits' },
  { href: '/atlas-priority-queue', label: 'Atlas priority' },
];
---

<!doctype html>
<html lang="en" data-mode="light" data-accent="oxblood">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f3f6" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Admin panel must NEVER be indexed; staff-only surface. -->
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=4" />
    <script is:inline data-admin-sso-preflight>
      // Consume the cross-origin dashboard handoff before <body> and every
      // slotted page script parse. AdminLayout previously ran this after
      // <slot />, so pages that captured localStorage synchronously kept a
      // false null token for the whole visit.
      (function () {
        try {
        if (location.hash && location.hash.indexOf('#token=') === 0) {
          var t = decodeURIComponent(location.hash.slice('#token='.length));
          if (t.length > 0) localStorage.setItem('ds_web_session_token', t);
          history.replaceState(null, '', location.pathname + location.search);
        }
        // Direct visits without a staff token bounce through the customer
        // dashboard. bounced=1 prevents an auth-failure redirect loop.
        if (
          !localStorage.getItem('ds_web_session_token') &&
          location.search.indexOf('bounced=1') === -1
        ) {
          location.replace(
            'https://app.driftstack.dev/?next-admin=' +
              encodeURIComponent(location.pathname + location.search),
          );
          return;
        }
        } catch (_) {
          /* localStorage/history unavailable: page auth fetches fail closed */
        }
      })();
    </script>
    <script is:inline data-admin-fetch-deadline>
      // Installed before every slotted page script so admin transport deadlines
      // cover response decoding, not just the wait for response headers.
      (function () {
        window.driftstackRequestErrorMessage = function (err, fallback) {
          var name = err && typeof err.name === 'string' ? err.name : '';
          var message = err && typeof err.message === 'string' ? err.message.trim() : '';
          var normalized = (name + ' ' + message).toLowerCase();
          if (message === 'forbidden' || message === 'not-found') return message;
          if (message === 'no admin token') {
            return 'Staff admin token is unavailable. Sign in again.';
          }
          if (/abort|timed? out|timeout/.test(normalized)) {
            return 'Request timed out. Check the connection and try again.';
          }
          if (
            /failed to fetch|fetch failed|network(?:error| request)?|load failed|offline|internet|connection (?:failed|lost|refused)|dns|econn|getaddrinfo/.test(
              normalized,
            )
          ) {
            return 'Check the connection and try again.';
          }
          var statusMatch = message.match(/^HTTP\s+(\d{3})$/i);
          if (statusMatch) {
            var status = Number(statusMatch[1]);
            if (status === 401 || status === 403) {
              return 'Staff sign-in has expired. Sign in again and retry.';
            }
            if (status === 404) return 'The requested admin resource was not found.';
            if (status === 409) return 'The resource changed. Refresh and try again.';
            if (status === 429) return 'Too many requests. Wait a moment and try again.';
            if (status >= 500) return 'The admin service is temporarily unavailable. Try again shortly.';
            return fallback;
          }
          if (err && err.staffSafe === true && message) return message;
          return fallback;
        };
        window.driftstackResponseError = function (response, body) {
          var detail = body && typeof body.detail === 'string' ? body.detail.trim() : '';
          var error = new Error(detail || 'HTTP ' + response.status);
          if (detail) error.staffSafe = true;
          return error;
        };
        window.driftstackFetchWithDeadline = function (url, init, timeoutMs, suppliedController) {
          var controller = suppliedController || new AbortController();
          var timeout = window.setTimeout(function () {
            controller.abort();
          }, timeoutMs);
          var requestInit = Object.assign({}, init || {}, { signal: controller.signal });
          return fetch(url, requestInit).then(
            function (response) {
              var cleared = false;
              function clearDeadline() {
                if (cleared) return;
                cleared = true;
                window.clearTimeout(timeout);
              }
              ['arrayBuffer', 'blob', 'formData', 'json', 'text'].forEach(function (method) {
                var read = response[method];
                if (typeof read !== 'function') return;
                response[method] = function () {
                  try {
                    return Promise.resolve(read.apply(response, arguments)).finally(clearDeadline);
                  } catch (error) {
                    clearDeadline();
                    throw error;
                  }
                };
              });
              // Nothing remains to decode on 204/HEAD-style responses.
              if (!response.body) clearDeadline();
              return response;
            },
            function (error) {
              window.clearTimeout(timeout);
              throw error;
            },
          );
        };
      })();
    </script>
  </head>
  <body class="bg-tk-bg text-tk-ink">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR operators skip the nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-tk-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to main content
    </a>
    <style>
      /* 2026-05-21 — mobile-nav reveal. Same pattern as the customer
       * dashboard 4c3e0cc2: default `hidden md:block` on the aside;
       * when the hamburger sets html[data-mobile-nav-open=true] the
       * aside drops to a fullscreen overlay so staff can navigate
       * + sign out from a phone. */
      html[data-mobile-nav-open='true'] [data-mobile-nav] {
        display: block;
        position: fixed;
        inset: 56px 0 0 0;
        width: 100%;
        z-index: 30;
        overflow-y: auto;
      }
    </style>
    <header
      class="flex items-center justify-between border-b border-tk-border bg-tk-surface px-4 py-3 md:hidden"
    >
      {/* 2026-05-23 — group hover-scale on logo. */}
      <a
        href="/"
        class="group flex items-center gap-2 font-mono text-base font-semibold text-tk-ink"
      >
        <img
          src="/driftstack-mark.svg?v=4"
          alt="Driftstack"
          width="28"
          height="28"
          class="inline-block h-7 w-7 transition-transform duration-300 group-hover:scale-110"
        />
        <span class="font-sans font-black italic tracking-tight">DRIFT<span class="text-tk-accent">STACK</span></span>
        <span class="ml-2 rounded-full bg-tk-accent/10 px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-tk-accent">
          admin
        </span>
      </a>
      <button
        type="button"
        data-mobile-nav-toggle
        aria-label="Open navigation"
        aria-controls="admin-mobile-navigation"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-tk-border text-tk-ink-2 hover:text-tk-ink"
      >
        <svg
          data-mobile-nav-icon="closed"
          viewBox="0 0 16 16"
          width="18"
          height="18"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        >
          <path d="M2.5 4h11 M2.5 8h11 M2.5 12h11" />
        </svg>
        <svg
          data-mobile-nav-icon="open"
          viewBox="0 0 16 16"
          width="18"
          height="18"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          class="hidden"
        >
          <path d="m3 3 10 10 M13 3 3 13" />
        </svg>
      </button>
    </header>
    <div class="flex min-h-screen">
      <aside
        id="admin-mobile-navigation"
        data-mobile-nav
        class="hidden w-56 shrink-0 border-r border-tk-border bg-tk-surface md:block"
      >
        {/*
          V-219* / Fleet port — W2 wordmark (DRIFTSTACK black-italic two-tone)
          matches the marketing-site Header brand. The "admin" pill
          stays alongside as the staff-context indicator.
        */}
        <div class="flex h-16 items-center justify-between gap-3 px-6 border-b border-tk-border">
          <a
            href="/"
            class="group flex items-center gap-2 font-mono text-base font-semibold text-tk-ink"
          >
            <img
              src="/driftstack-mark.svg?v=4"
              alt="Driftstack"
              width="28"
              height="28"
              class="inline-block h-7 w-7 transition-transform duration-300 group-hover:scale-110"
            />
            <span class="font-sans font-black italic tracking-tight">DRIFT<span class="text-tk-accent">STACK</span></span>
          </a>
          <span
            class="rounded-full bg-tk-accent/10 px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-tk-accent"
          >
            admin
          </span>
        </div>
        <nav class="px-4 py-6">
          <ul class="space-y-1">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href === '/' ? '/' : `${item.href}/`}
                    aria-current={pathname === item.href || pathname.startsWith(item.href + '/')
                      ? 'page'
                      : undefined}
                    class:list={[
                      // 2026-05-21 — font-medium applied unconditionally on
                      // the base class to keep text width constant across
                      // active/inactive (otherwise clicking shifted other
                      // items as the new-active item bolded). Same fix as
                      // DashboardLayout 50b0dd7a.
                      'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
                      pathname === item.href || pathname.startsWith(item.href + '/')
                        ? 'bg-tk-accent/10 text-tk-accent'
                        : 'text-tk-ink-2 hover:bg-tk-hover hover:text-tk-ink',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="border-t border-tk-border px-6 py-4 text-xs text-tk-ink-3">
          <p>Staff-only surface. All actions audit-logged.</p>
          <button
            type="button"
            data-signout
            class="mt-2 text-tk-ink-3 hover:text-tk-accent"
          >
            Sign out
          </button>
        </div>
      </aside>
      <main
        id="main-content"
        tabindex="-1"
        class="flex-1"
        data-hydrate="pending"
        style="opacity: 0; transition: opacity 0.18s ease-out"
      >
        <slot />
      </main>
    </div>

    {/* 2026-05-29 — branded confirm + prompt modals. Replace native
        window.confirm/prompt across the admin panel (founder: "no alert
        boxes everywhere"). Pages call window.driftstackConfirm(message,
        opts?) -> Promise<boolean> and window.driftstackPrompt(message,
        opts?) -> Promise<string|null>. Admin light-theme palette. */}
    <div
      data-ds-confirm
      class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ds-confirm-message"
    >
      <div class="w-full max-w-md rounded-lg border border-tk-border bg-tk-surface p-6 shadow-xl">
        <p data-ds-confirm-message id="ds-confirm-message" class="whitespace-pre-line text-sm text-tk-ink"></p>
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" data-ds-confirm-cancel class="rounded-md border border-tk-border px-4 py-2 text-sm text-tk-ink-2 hover:bg-tk-bg">Cancel</button>
          <button type="button" data-ds-confirm-ok class="rounded-md bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800">Confirm</button>
        </div>
      </div>
    </div>
    <div
      data-ds-prompt
      class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ds-prompt-message"
    >
      <div class="w-full max-w-md rounded-lg border border-tk-border bg-tk-surface p-6 shadow-xl">
        <p data-ds-prompt-message id="ds-prompt-message" class="whitespace-pre-line text-sm text-tk-ink"></p>
        <input type="text" data-ds-prompt-input aria-label="Response" class="mt-4 w-full rounded-md border border-tk-border bg-tk-surface px-3 py-2 text-sm text-tk-ink placeholder:text-tk-ink-3 focus:border-tk-accent focus:outline-none" />
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" data-ds-prompt-cancel class="rounded-md border border-tk-border px-4 py-2 text-sm text-tk-ink-2 hover:bg-tk-bg">Cancel</button>
          <button type="button" data-ds-prompt-ok class="rounded-md bg-tk-accent px-4 py-2 text-sm font-medium text-white hover:bg-tk-accent-hover">OK</button>
        </div>
      </div>
    </div>
    <script is:inline>
        // 2026-05-29 — branded window.driftstackConfirm / driftstackPrompt
        // for the admin panel. Mirror of the DashboardLayout helpers.
        // driftstackConfirm(message, opts) -> Promise<boolean>;
        // driftstackPrompt(message, opts) -> Promise<string|null>.
        // NOTE: plain code, NOT the {`…`} template-literal wrapper — Astro
        // emits that wrapper literally, which made this whole script a
        // no-op string in the browser (both globals were undefined in
        // production — including the W2820 destructive-confirm guard —
        // until the 2026-07-02 fix).
        (function () {
          // One lease covers both modal types. Multi-step admin actions often
          // open a prompt after a confirm; an independent lock per type lets a
          // repeat click stack the other dialog and attach competing key handlers.
          var modalOpen = false;
          window.driftstackConfirm = function (message, opts) {
            return new Promise(function (resolve) {
              var overlay = document.querySelector('[data-ds-confirm]');
              if (!overlay) { resolve(window.confirm(message)); return; }
              if (modalOpen) { resolve(false); return; }
              modalOpen = true;
              var msg = overlay.querySelector('[data-ds-confirm-message]');
              var ok = overlay.querySelector('[data-ds-confirm-ok]');
              var cancel = overlay.querySelector('[data-ds-confirm-cancel]');
              if (msg) msg.textContent = message;
              if (ok) ok.textContent = (opts && opts.confirmLabel) || 'Confirm';
              // W2820 (review wxbkih0x2): a DESTRUCTIVE confirm must not be firable by a
              // stray Enter on the auto-focused OK button. When opts.destructive, focus
              // Cancel instead and swallow Enter (see onKey) so the operator MUST click OK
              // — making the fleet-control "a real OK click, not Enter" guarantee true.
              var destructive = !!(opts && opts.destructive);
              var prevFocus = document.activeElement;
              overlay.classList.remove('hidden');
              document.body.style.overflow = 'hidden';
              if (destructive) { if (cancel && cancel.focus) cancel.focus(); }
              else if (ok && ok.focus) ok.focus();
              function done(result) {
                modalOpen = false;
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
                if (ok) ok.removeEventListener('click', onOk);
                if (cancel) cancel.removeEventListener('click', onCancel);
                overlay.removeEventListener('click', onOverlay);
                document.removeEventListener('keydown', onKey);
                if (prevFocus && prevFocus.focus) prevFocus.focus();
                resolve(result);
              }
              function onOk() { done(true); }
              function onCancel() { done(false); }
              function onOverlay(e) { if (e.target === overlay) done(false); }
              function onKey(e) {
                if (e.key === 'Escape') { done(false); return; }
                // Destructive confirms require an explicit OK CLICK — Enter never confirms.
                if (destructive && e.key === 'Enter') { e.preventDefault(); return; }
                if (e.key === 'Tab') {
                  var f = [cancel, ok].filter(function (el) { return el; });
                  if (!f.length) return;
                  if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
                  else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
                }
              }
              if (ok) ok.addEventListener('click', onOk);
              if (cancel) cancel.addEventListener('click', onCancel);
              overlay.addEventListener('click', onOverlay);
              document.addEventListener('keydown', onKey);
            });
          };
          window.driftstackPrompt = function (message, opts) {
            return new Promise(function (resolve) {
              var overlay = document.querySelector('[data-ds-prompt]');
              if (!overlay) { resolve(window.prompt(message, (opts && opts.defaultValue) || '')); return; }
              if (modalOpen) { resolve(null); return; }
              modalOpen = true;
              var msg = overlay.querySelector('[data-ds-prompt-message]');
              var input = overlay.querySelector('[data-ds-prompt-input]');
              var ok = overlay.querySelector('[data-ds-prompt-ok]');
              var cancel = overlay.querySelector('[data-ds-prompt-cancel]');
              if (msg) msg.textContent = message;
              if (ok) ok.textContent = (opts && opts.confirmLabel) || 'OK';
              if (input) {
                input.value = (opts && opts.defaultValue) || '';
                input.setAttribute('placeholder', (opts && opts.placeholder) || '');
              }
              var prevFocus = document.activeElement;
              overlay.classList.remove('hidden');
              document.body.style.overflow = 'hidden';
              if (input && input.focus) { input.focus(); if (input.select) input.select(); }
              function done(result) {
                modalOpen = false;
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
                if (ok) ok.removeEventListener('click', onOk);
                if (cancel) cancel.removeEventListener('click', onCancel);
                if (input) input.removeEventListener('keydown', onKey);
                overlay.removeEventListener('click', onOverlay);
                document.removeEventListener('keydown', onDocKey);
                if (prevFocus && prevFocus.focus) prevFocus.focus();
                resolve(result);
              }
              function onOk() { done(input ? input.value : ''); }
              function onCancel() { done(null); }
              function onOverlay(e) { if (e.target === overlay) done(null); }
              function onKey(e) { if (e.key === 'Enter') { e.preventDefault(); onOk(); } }
              function onDocKey(e) {
                if (e.key === 'Escape') { done(null); return; }
                if (e.key === 'Tab') {
                  var f = [input, cancel, ok].filter(function (el) { return el; });
                  if (!f.length) return;
                  if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
                  else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
                }
              }
              if (ok) ok.addEventListener('click', onOk);
              if (cancel) cancel.addEventListener('click', onCancel);
              if (input) input.addEventListener('keydown', onKey);
              overlay.addEventListener('click', onOverlay);
              document.addEventListener('keydown', onDocKey);
            });
          };
        })();
    </script>
    <script is:inline>
      {
        /*
         * 2026-05-21 — page-hydrate reveal. Same pattern as
         * DashboardLayout f33fa91e: <main> renders opacity:0 so the
         * customer doesn't see the brief flash of MOCK_ACCOUNTS /
         * MOCK_AUDIT_LOG / MOCK_OVERRIDES / etc on first paint. The
         * reveal fires on either DOMContentLoaded+rAF OR a 600ms
         * safety fallback, whichever first.
         */
      }
      (function () {
        var main = document.querySelector('main[data-hydrate="pending"]');
        if (!main) return;
        var revealed = false;
        function reveal() {
          if (revealed) return;
          revealed = true;
          main.style.opacity = '1';
          main.setAttribute('data-hydrate', 'ready');
        }
        // 2026-05-21 — pages call window.dashboardHydrated() after
        // their primary fetch resolves (same pattern as the
        // customer-dashboard layout 4a15ce31). 1200ms safety cap
        // covers pages not yet retrofitted.
        window.dashboardHydrated = reveal;
        setTimeout(reveal, 1200);

        // 2026-05-21 — sign-out wiring. Same pattern as DashboardLayout
        // 5f7eff40 — clears admin's localStorage + redirects to the
        // dashboard sign-in (admin has no /login page of its own).
        var signOut = document.querySelector('[data-signout]');
        if (signOut) {
          signOut.addEventListener('click', function () {
            try {
              var token = localStorage.getItem('ds_web_session_token') || '';
              if (token) {
                fetch('https://api.driftstack.dev/v1/auth/logout', {
                  method: 'POST',
                  headers: { authorization: 'Bearer ' + token },
                  credentials: 'include',
                  keepalive: true,
                }).catch(function () {
                  /* fire-and-forget */
                });
              }
              localStorage.removeItem('ds_web_session_token');
              localStorage.removeItem('ds_is_staff_user');
            } catch (_) {
              /* swallow */
            }
            // Bounce out of the admin origin entirely — admin has no
            // login page; the dashboard's /login is the canonical sign-
            // in surface.
            window.location.href = 'https://app.driftstack.dev/login';
          });
        }

        // 2026-05-21 — mobile-nav hamburger wiring. Same shape as the
        // customer dashboard 4c3e0cc2. Aside is `hidden md:block` by
        // default; flipping html[data-mobile-nav-open=true] reveals it
        // as a fullscreen overlay.
        var navToggle = document.querySelector('[data-mobile-nav-toggle]');
        if (navToggle) {
          var root = document.documentElement;
          var closedIcon = document.querySelector('[data-mobile-nav-icon="closed"]');
          var openIcon = document.querySelector('[data-mobile-nav-icon="open"]');
          function setNavOpen(isOpen) {
            if (isOpen) {
              root.setAttribute('data-mobile-nav-open', 'true');
              navToggle.setAttribute('aria-expanded', 'true');
              navToggle.setAttribute('aria-label', 'Close navigation');
              if (closedIcon) closedIcon.classList.add('hidden');
              if (openIcon) openIcon.classList.remove('hidden');
            } else {
              root.removeAttribute('data-mobile-nav-open');
              navToggle.setAttribute('aria-expanded', 'false');
              navToggle.setAttribute('aria-label', 'Open navigation');
              if (closedIcon) closedIcon.classList.remove('hidden');
              if (openIcon) openIcon.classList.add('hidden');
            }
          }
          navToggle.addEventListener('click', function () {
            setNavOpen(root.getAttribute('data-mobile-nav-open') !== 'true');
          });
          document.querySelectorAll('aside[data-mobile-nav] a').forEach(function (a) {
            a.addEventListener('click', function () {
              setNavOpen(false);
            });
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && root.getAttribute('data-mobile-nav-open') === 'true') {
              setNavOpen(false);
              navToggle.focus();
            }
          });
        }
      })();
    </script>
  </body>
</html>
