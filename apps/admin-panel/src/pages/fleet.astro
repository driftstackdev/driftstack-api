---
import AdminLayout from '../layouts/AdminLayout.astro';
import { resolveApiBaseUrl } from '../lib/api-base-url';

// W629 — Fleet view. Read-only operator window onto the Mac fleet,
// consuming GET /v1/mac-nodes (W628). The whole point is debugging why a
// launch lands in an empty stream room: a node can be registered + have
// LiveKit yet not hold a live control-plane connection (dispatch logs
// "fleet node not connected"). This page makes registered / last-seen /
// has-LiveKit / connected visible at a glance.
//
// W604 discipline: NO mock rows. The table starts unavailable and is filled
// only from a successful live fetch; on failure it shows an honest error,
// never fabricated rows or stale freshness.
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Fleet">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-fleet">
    <div class="mb-6 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-tk-ink">Fleet nodes</h1>
        <p class="mt-1 text-sm text-tk-ink-3">
          Mac workers registered with the control plane. A session only runs a real browser when a
          node is both <strong>connected</strong> and has <strong>LiveKit</strong>; otherwise launches
          land in an empty stream room (dispatch logs <code>fleet node not connected</code>).
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-xs text-tk-ink-3" data-live-state>
          <span class="h-2 w-2 rounded-full bg-amber-400" data-live-dot></span>
          <span data-live-label aria-live="polite">Waiting for live data</span>
        </span>
        <button
          type="button"
          data-refresh
          disabled
          aria-disabled="true"
          title="Available after staff sign-in."
          class="text-sm font-medium text-tk-accent hover:underline disabled:cursor-not-allowed disabled:text-tk-ink-3 disabled:no-underline"
        >Refresh now</button>
      </div>
    </div>

    <div
      data-banner
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="mb-4 hidden rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
    >
    </div>

    <div class="overflow-x-auto rounded-lg border border-tk-border">
      <table class="min-w-full divide-y divide-tk-border text-sm">
        <thead class="bg-tk-bg text-left text-xs font-medium uppercase tracking-wide text-tk-ink-3">
          <tr>
            <th class="px-4 py-3">Node</th>
            <th class="px-4 py-3">Region</th>
            <th class="px-4 py-3">Connected</th>
            <th class="px-4 py-3">LiveKit</th>
            <th class="px-4 py-3">Sessions</th>
            <th class="px-4 py-3">CPU / Mem</th>
            <th class="px-4 py-3">Disk free</th>
            <th class="px-4 py-3">Health</th>
            <th class="px-4 py-3">Uptime</th>
            <th class="px-4 py-3">Harness</th>
            <th class="px-4 py-3">Last seen</th>
            <th class="px-4 py-3">Controls</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-list="fleet">
          <tr>
            <td colspan="12" class="px-4 py-8 text-center text-sm text-tk-ink-3">
              Live fleet state is unavailable until loaded.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-tk-ink-3" data-field="footnote"></p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-fleet"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const tbody = root.querySelector('[data-list="fleet"]');
      const footnote = root.querySelector('[data-field="footnote"]');
      const liveDot = root.querySelector('[data-live-dot]');
      const liveLabel = root.querySelector('[data-live-label]');
      const refreshBtn = root.querySelector('[data-refresh]');
      let token = null;
      const FLEET_REQUEST_TIMEOUT_MS = 15_000;
      let loadController = null;
      let loadGeneration = 0;
      // A node control is fire-and-forget after the server accepts it. If the
      // browser loses the 202 response, a second command can duplicate a
      // destructive restart/drain. Keep that node non-actionable until a
      // deliberate reload after the operator verifies its live state.
      const uncertainControlNodes = new Set();

      function boundedFetch(url, init, controller) {
        const activeController = controller || new AbortController();
        return window.driftstackFetchWithDeadline(
          url,
          init,
          FLEET_REQUEST_TIMEOUT_MS,
          activeController,
        );
      }

      function requestErrorMessage(err, fallback = 'network error') {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch {
          return '';
        }
      }

      function setLiveState(state, message) {
        if (liveDot) {
          liveDot.className =
            'h-2 w-2 rounded-full ' +
            (state === 'ready'
              ? 'bg-emerald-500'
              : state === 'failed'
                ? 'bg-red-500'
                : 'bg-amber-400');
        }
        if (liveLabel) {
          liveLabel.textContent =
            message ||
            (state === 'ready'
              ? 'Live · updated'
              : state === 'failed'
                ? 'Live data unavailable'
                : 'Loading live data');
        }
      }

      function syncRefreshControl(reason) {
        if (!refreshBtn) return;
        const disabled = !token || Boolean(loadController) || controlInFlight;
        refreshBtn.disabled = disabled;
        refreshBtn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
        if (!token) refreshBtn.title = reason || 'Available after staff sign-in.';
        else if (controlInFlight) refreshBtn.title = 'Available after the current node command.';
        else if (loadController) refreshBtn.title = 'Refreshing live fleet state.';
        else refreshBtn.removeAttribute('title');
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
        );
      }
      function isRecord(value) {
        return value !== null && typeof value === 'object' && !Array.isArray(value);
      }
      function isBoundedString(value, min, max) {
        return typeof value === 'string' && value.length >= min && value.length <= max;
      }
      function isFiniteInRange(value, min, max) {
        return typeof value === 'number' && Number.isFinite(value) && value >= min && value <= max;
      }
      function isNonnegativeInteger(value) {
        return Number.isInteger(value) && value >= 0 && value <= Number.MAX_SAFE_INTEGER;
      }
      function isIsoTimestamp(value) {
        return isBoundedString(value, 1, 64) && Number.isFinite(Date.parse(value));
      }
      function parseHeartbeat(value) {
        if (value === null) return null;
        if (
          !isRecord(value) ||
          !isIsoTimestamp(value.beatAt) ||
          !isFiniteInRange(value.cpuPercent, 0, 100) ||
          !isFiniteInRange(value.memoryPercent, 0, 100) ||
          !isNonnegativeInteger(value.activeSessionCount)
        ) {
          throw new Error('Invalid live fleet response.');
        }
        if (
          (value.maxConcurrent !== undefined && !isNonnegativeInteger(value.maxConcurrent)) ||
          (value.uptimeSeconds !== undefined && !isFiniteInRange(value.uptimeSeconds, 0, Number.MAX_SAFE_INTEGER)) ||
          (value.drainState !== undefined && value.drainState !== 'draining') ||
          (value.thermalState !== undefined &&
            !['nominal', 'fair', 'serious', 'critical'].includes(value.thermalState)) ||
          (value.memoryPressureLevel !== undefined &&
            !['normal', 'warn', 'critical'].includes(value.memoryPressureLevel)) ||
          (value.busiestCorePercent !== undefined &&
            !isFiniteInRange(value.busiestCorePercent, 0, 100)) ||
          (value.diskFreePercent !== undefined &&
            !isFiniteInRange(value.diskFreePercent, 0, 100)) ||
          (value.harnessVersion !== undefined && !isBoundedString(value.harnessVersion, 0, 256))
        ) {
          throw new Error('Invalid live fleet response.');
        }
        if (value.sessionOutcomeCounts !== undefined) {
          if (!isRecord(value.sessionOutcomeCounts)) throw new Error('Invalid live fleet response.');
          const outcomes = Object.entries(value.sessionOutcomeCounts);
          if (
            outcomes.length > 256 ||
            outcomes.some(
              ([key, count]) => !isBoundedString(key, 1, 128) || !isNonnegativeInteger(count),
            )
          ) {
            throw new Error('Invalid live fleet response.');
          }
        }
        return value;
      }
      function parseFleetPage(value) {
        if (!isRecord(value) || !Array.isArray(value.data) || value.data.length > 10_000) {
          throw new Error('Invalid live fleet response.');
        }
        const seen = new Set();
        return value.data.map((row) => {
          if (
            !isRecord(row) ||
            !isBoundedString(row.id, 1, 256) ||
            !isBoundedString(row.display_name, 1, 128) ||
            !isBoundedString(row.region, 1, 64) ||
            !isBoundedString(row.hardware_class, 1, 64) ||
            !isIsoTimestamp(row.registered_at) ||
            !(row.last_seen_at === null || isIsoTimestamp(row.last_seen_at)) ||
            typeof row.has_livekit !== 'boolean' ||
            !(row.connected === null || typeof row.connected === 'boolean') ||
            !Object.prototype.hasOwnProperty.call(row, 'last_heartbeat')
          ) {
            throw new Error('Invalid live fleet response.');
          }
          if (seen.has(row.id)) throw new Error('Invalid live fleet response.');
          seen.add(row.id);
          parseHeartbeat(row.last_heartbeat);
          return row;
        });
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }
      // Derived live-state from last_seen_at — the RELIABLE liveness signal. The
      // "Connected" column is the in-memory WS bool, which resets to unknown on
      // every server restart (prod redeploys frequently), so a beating node can
      // briefly read "offline" there. last_seen_at is DB-persisted + bumped every
      // ~10s heartbeat, so the relative age answers "is this worker alive RIGHT
      // NOW": <30s = live, <2m = lagging, older / never = stale/down.
      function fmtFreshness(iso) {
        if (!iso) return { text: 'never', cls: 'bg-red-50 text-red-700' };
        const ageMs = Date.now() - new Date(iso).getTime();
        if (!(ageMs >= 0)) return { text: 'just now', cls: 'bg-emerald-50 text-emerald-700' };
        const s = Math.floor(ageMs / 1000);
        let text;
        if (s < 60) text = s + 's ago';
        else if (s < 3600) text = Math.floor(s / 60) + 'm ago';
        else if (s < 86400) text = Math.floor(s / 3600) + 'h ago';
        else text = Math.floor(s / 86400) + 'd ago';
        const cls =
          s < 30
            ? 'bg-emerald-50 text-emerald-700'
            : s < 120
              ? 'bg-amber-50 text-amber-700'
              : 'bg-red-50 text-red-700';
        return { text, cls };
      }
      function freshnessBadge(iso) {
        const f = fmtFreshness(iso);
        return (
          '<span class="rounded-full px-2 py-0.5 text-xs ' +
          f.cls +
          '" title="' +
          escapeHtml(fmtIso(iso)) +
          '">' +
          escapeHtml(f.text) +
          '</span>'
        );
      }
      function fmtPct(n) {
        return typeof n === 'number' ? Math.round(n) + '%' : '—';
      }
      function fmtSessions(hb) {
        if (!hb) return '—';
        const active = typeof hb.activeSessionCount === 'number' ? hb.activeSessionCount : '?';
        const max = typeof hb.maxConcurrent === 'number' ? hb.maxConcurrent : '?';
        return active + ' / ' + max;
      }
      function fmtUptime(s) {
        if (typeof s !== 'number' || s < 0) return '—';
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        if (d > 0) return d + 'd ' + h + 'h';
        if (h > 0) return h + 'h ' + m + 'm';
        return m + 'm';
      }
      // thermalState nominal|fair|serious|critical → green/amber/red; a draining
      // node + a non-normal memory-pressure level each add a badge. '—' when no
      // heartbeat telemetry has arrived yet.
      function pill(text, cls) {
        return '<span class="rounded-full px-2 py-0.5 text-xs ' + cls + '">' + escapeHtml(text) + '</span>';
      }
      function healthBadges(hb) {
        if (!hb) return '<span class="text-tk-ink-3">—</span>';
        const out = [];
        const t = hb.thermalState;
        if (typeof t === 'string') {
          const cls =
            t === 'nominal'
              ? 'bg-emerald-50 text-emerald-700'
              : t === 'fair'
                ? 'bg-amber-50 text-amber-700'
                : 'bg-red-50 text-red-700';
          out.push(pill(t, cls));
        }
        if (hb.drainState === 'draining') out.push(pill('draining', 'bg-amber-50 text-amber-700'));
        const mp = hb.memoryPressureLevel;
        if (typeof mp === 'string' && mp !== 'normal')
          out.push(pill('mem ' + mp, 'bg-red-50 text-red-700'));
        return out.length > 0 ? out.join(' ') : pill('ok', 'bg-emerald-50 text-emerald-700');
      }
      function boolBadge(value, onText, offText, unknownText) {
        if (value === null || value === undefined) {
          return (
            '<span class="rounded-full bg-tk-hover px-2 py-0.5 text-xs text-tk-ink-3">' +
            escapeHtml(unknownText) +
            '</span>'
          );
        }
        const cls = value ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700';
        return (
          '<span class="rounded-full px-2 py-0.5 text-xs ' +
          cls +
          '">' +
          escapeHtml(value ? onText : offText) +
          '</span>'
        );
      }
      function rowHtml(n) {
        return (
          '<tr>' +
          '<td class="px-4 py-3"><div class="font-medium text-tk-ink">' +
          escapeHtml(n.display_name || n.id) +
          '</div><div class="font-mono text-xs text-tk-ink-3">' +
          escapeHtml(n.id) +
          '</div></td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(n.region || '—') +
          '</td>' +
          '<td class="px-4 py-3">' +
          boolBadge(n.connected, 'connected', 'offline', 'unknown') +
          '</td>' +
          '<td class="px-4 py-3">' +
          boolBadge(n.has_livekit, 'yes', 'no', '—') +
          '</td>' +
          // Latest-heartbeat telemetry (migration 0083); '—' until the node beats.
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(fmtSessions(n.last_heartbeat)) +
          '</td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(
            fmtPct(n.last_heartbeat && n.last_heartbeat.cpuPercent) +
              ' / ' +
              fmtPct(n.last_heartbeat && n.last_heartbeat.memoryPercent),
          ) +
          '</td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(fmtPct(n.last_heartbeat && n.last_heartbeat.diskFreePercent)) +
          '</td>' +
          '<td class="px-4 py-3">' +
          healthBadges(n.last_heartbeat) +
          '</td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(fmtUptime(n.last_heartbeat && n.last_heartbeat.uptimeSeconds)) +
          '</td>' +
          '<td class="px-4 py-3 font-mono text-xs text-tk-ink-3">' +
          escapeHtml((n.last_heartbeat && n.last_heartbeat.harnessVersion) || '—') +
          '</td>' +
          '<td class="px-4 py-3">' +
          freshnessBadge(n.last_seen_at) +
          '</td>' +
          '<td class="px-4 py-3">' +
          controlButtons(n) +
          '</td>' +
          '</tr>'
        );
      }

      // The per-row control buttons. A dash (no buttons) when the node holds no
      // live control-plane connection — the command is delivered over that WS, so
      // it would 409 otherwise. data-* attributes feed the delegated click handler.
      function controlButtons(n) {
        if (n.connected !== true) {
          return '<span class="text-xs text-tk-ink-3" title="Controls need a live control-plane connection">—</span>';
        }
        if (uncertainControlNodes.has(String(n.id))) {
          return '<span class="text-xs font-medium text-amber-700" title="A control command may already have been accepted. Verify Health and Last seen before reloading.">Outcome unknown — verify, then reload</span>';
        }
        const mk = (cmd, label, cls) =>
          '<button type="button" data-control="' +
          cmd +
          '" data-node-id="' +
          escapeHtml(n.id) +
          '" class="mr-1 mb-1 inline-block rounded px-2 py-0.5 text-xs font-medium ' +
          cls +
          '">' +
          label +
          '</button>';
        const neutral = 'bg-tk-hover text-tk-ink-2 hover:bg-slate-200';
        const warn = 'bg-amber-50 text-amber-700 hover:bg-amber-100';
        const danger = 'bg-red-50 text-red-700 hover:bg-red-100';
        return (
          mk('cordon', 'Cordon', warn) +
          mk('uncordon', 'Uncordon', neutral) +
          mk('drain', 'Drain', warn) +
          mk('restart', 'Restart', danger)
        );
      }

      function load() {
        if (!token) {
          if (tbody)
            tbody.innerHTML =
              '<tr><td colspan="12" class="px-4 py-8 text-center text-sm text-tk-ink-3">Sign in as a staff admin to view the fleet.</td></tr>';
          if (footnote) footnote.textContent = '';
          hideBanner();
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return Promise.resolve(false);
        }
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        syncRefreshControl();
        const generation = ++loadGeneration;
        return boundedFetch(
          apiBaseUrl + '/v1/mac-nodes',
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (generation !== loadGeneration) return;
            const rows = parseFleetPage(body);
            if (tbody) {
              if (rows.length === 0) {
                tbody.innerHTML =
                  '<tr><td colspan="12" class="px-4 py-8 text-center text-sm text-tk-ink-3">No fleet nodes registered yet. Start a Mac worker (harness with DRIFTSTACK_ENABLE_DRIVE_BRIDGE=1) and it will appear here once it registers.</td></tr>';
              } else {
                tbody.innerHTML = rows.map(rowHtml).join('');
              }
            }
            if (footnote) {
              const connected = rows.filter((n) => n.connected === true).length;
              footnote.textContent =
                rows.length +
                ' node' +
                (rows.length === 1 ? '' : 's') +
                ' registered · ' +
                connected +
                ' connected. A launch needs a connected node with LiveKit to show a real browser.';
            }
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (generation !== loadGeneration) return;
            const msg = requestErrorMessage(err);
            // W604 discipline: never leave fabricated rows; show honest state.
            if (tbody)
              tbody.innerHTML =
                '<tr><td colspan="12" class="px-4 py-8 text-center text-sm text-tk-ink-3">Could not load fleet nodes. Resolve the error above and retry.</td></tr>';
            if (footnote) footnote.textContent = '';
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — staff admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner('Could not load fleet nodes — ' + msg + '.');
            }
            return false;
          })
          .finally(() => {
            if (generation !== loadGeneration) return;
            loadController = null;
            if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          });
      }

      function loadWithLive() {
        if (controlInFlight) return Promise.resolve(undefined);
        setLiveState('loading', 'Loading live fleet state…');
        syncRefreshControl();
        return load()
          .then((loaded) => {
            if (loaded === true) setLiveState('ready');
            else if (loaded === false) {
              setLiveState(
                'failed',
                token ? 'Live fleet state unavailable' : 'Staff sign-in required',
              );
            }
            return loaded;
          })
          .finally(() => {
            syncRefreshControl();
          });
      }

      // W631 — per-node fleet control actions (founder "ship them now", 2026-06-23).
      // Cordon / uncordon / drain / restart via POST /v1/mac-nodes/:id/control (staff
      // admin scope). The harness acks 202 and applies the command on its own loop, so
      // we surface "sent" + refresh — never claim instant effect. Destructive actions
      // (drain / restart finish-or-end in-flight sessions) are gated behind an explicit
      // driftstackConfirm (a real OK click — NOT an Enter-fires prompt — so a stray
      // keypress can't restart a worker). The listener is delegated on `tbody` so it
      // survives the 15s auto-refresh innerHTML swap.
      // W2820 — true while a control action (confirm dialog open OR request in flight) is
      // running, so the 15s auto-refresh skips its table rebuild and doesn't detach the
      // button / re-render mid-action.
      let controlInFlight = false;
      function controlActionLabel(cmd) {
        return cmd.charAt(0).toUpperCase() + cmd.slice(1);
      }
      function controlPendingLabel(cmd) {
        if (cmd === 'cordon') return 'Cordoning…';
        if (cmd === 'uncordon') return 'Uncordoning…';
        if (cmd === 'drain') return 'Draining…';
        return 'Restarting…';
      }
      function controlConfirmMessage(cmd) {
        if (cmd === 'restart')
          return 'Restart this worker? It drains (lets active sessions finish) then exits and respawns — any in-flight session on this node is ended.';
        if (cmd === 'drain')
          return 'Drain this worker? It stops accepting new sessions and goes idle once the active ones finish.';
        if (cmd === 'cordon')
          return 'Cordon this worker? It stops accepting NEW sessions; active ones keep running.';
        return 'Uncordon this worker? It resumes accepting new sessions.';
      }
      async function runControl(nodeId, cmd, btn) {
        // One node-control command at a time. `controlInFlight` previously only
        // paused auto-refresh; a second button could still open another confirm
        // and dispatch an overlapping command while the first request was live.
        if (!token || controlInFlight) return;
        // W2820 (review wxbkih0x2): mark in-flight BEFORE the confirm await so the 15s
        // auto-refresh (below) does NOT rebuild the table — which would detach `btn`
        // (making btn.disabled a no-op on the visible row) and let the same command be
        // re-issued. The finally clears it on every exit path (incl. a cancel).
        controlInFlight = true;
        syncRefreshControl();
        let controls = [];
        const originalText = btn ? btn.textContent : '';
        let commandStarted = false;
        async function publishUnknownOutcome(detail) {
          uncertainControlNodes.add(String(nodeId));
          const refreshed = await load();
          showBanner(
            controlActionLabel(cmd) +
              ' outcome is unknown because ' +
              detail +
              '. The node may already have accepted the command. ' +
              (refreshed
                ? 'Fleet state was refreshed, but it cannot prove whether an asynchronous command ran. '
                : 'Fleet state could not be refreshed. ') +
              'Controls for this node are locked for this page. Verify Health and Last seen before reloading; do not send the command again blindly.',
          );
        }
        try {
          const confirmFn = window.driftstackConfirm;
          // drain/restart end-or-finish in-flight sessions → destructive: focus Cancel +
          // Enter can't confirm (the modal's W2820 destructive mode). cordon/uncordon are
          // reversible, so they keep the normal Enter-confirms behaviour.
          const destructive = cmd === 'drain' || cmd === 'restart';
          const proceed = confirmFn
            ? await confirmFn(controlConfirmMessage(cmd), {
                confirmLabel: controlActionLabel(cmd),
                destructive,
              })
            : window.confirm(controlConfirmMessage(cmd));
          if (!proceed) return;
          // Disable every command in the table while the single-flight request
          // runs. Otherwise the guard would silently ignore another visible,
          // apparently-clickable control. The clicked command gets explicit
          // progress text and aria-busy for assistive technology.
          controls = tbody ? Array.from(tbody.querySelectorAll('button[data-control]')) : [];
          controls.forEach(function (control) {
            control.disabled = true;
          });
          if (btn) {
            btn.textContent = controlPendingLabel(cmd);
            btn.setAttribute('aria-busy', 'true');
          }
          commandStarted = true;
          const r = await boundedFetch(
            apiBaseUrl + '/v1/mac-nodes/' + encodeURIComponent(nodeId) + '/control',
            {
              method: 'POST',
              headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ command: cmd }),
            },
          );
          if (r.status === 202) {
            const refreshed = await load();
            showBanner(
              controlActionLabel(cmd) +
                ' sent to ' +
                nodeId +
                ' — the node accepted it asynchronously. ' +
                (refreshed
                  ? 'Fleet state was refreshed; watch Health / Last seen for the applied result.'
                  : 'Fleet state could not be refreshed; verify Health / Last seen before another command.'),
            );
          } else if (r.status === 409) {
            showBanner('Cannot ' + cmd + ': node is not connected to the control plane.');
          } else if (r.status === 404) {
            showBanner('Cannot ' + cmd + ': node not found (it may have de-registered).');
          } else if (r.status === 403) {
            showBanner('Cannot ' + cmd + ': staff admin scope required.');
          } else if (r.status === 503) {
            showBanner('Cannot ' + cmd + ': fleet control is not available on this server.');
          } else if (r.status >= 500 || (r.status >= 200 && r.status < 300)) {
            await publishUnknownOutcome(
              r.status >= 500
                ? 'the server returned an error after the request was sent'
                : 'the server returned an unexpected successful response',
            );
          } else {
            showBanner(
              'Cannot ' +
                cmd +
                ': ' +
                requestErrorMessage(
                  new Error('HTTP ' + r.status),
                  'the control request was not accepted',
                ) +
                '.',
            );
          }
        } catch (err) {
          if (commandStarted) {
            await publishUnknownOutcome(
              err && err.name === 'AbortError'
                ? 'the response timed out'
                : 'the connection failed before a definitive response arrived',
            );
          } else {
            showBanner('Control request failed — ' + requestErrorMessage(err) + '.');
          }
        } finally {
          const outcomeUnknown = uncertainControlNodes.has(String(nodeId));
          controls.forEach(function (control) {
            control.disabled = outcomeUnknown;
          });
          if (btn) {
            btn.textContent = originalText;
            btn.removeAttribute('aria-busy');
            btn.disabled = outcomeUnknown;
          }
          controlInFlight = false;
          syncRefreshControl();
        }
      }
      if (tbody) {
        tbody.addEventListener('click', function (e) {
          const target = e.target;
          const btn = target && target.closest ? target.closest('button[data-control]') : null;
          if (!btn) return;
          const cmd = btn.getAttribute('data-control');
          const nodeId = btn.getAttribute('data-node-id');
          if (!cmd || !nodeId) return;
          void runControl(nodeId, cmd, btn);
        });
      }

      function start() {
        token = getToken();
        syncRefreshControl('Available after staff sign-in.');
        void loadWithLive();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
      // W630 — auto-refresh every 15s so an operator watching a worker
      // come online sees connected flip offline→connected live, without
      // reloading the page. Cheap (one small GET) and the load() function
      // already replaces the table wholesale, so no flicker beyond the
      // row swap. No teardown needed — the page is a full document, the
      // interval dies with it on navigation away.
      setInterval(function () {
        if (controlInFlight) return; // W2820 — don't rebuild the table mid control-action
        void loadWithLive();
      }, 15000);
      if (refreshBtn) refreshBtn.addEventListener('click', loadWithLive);
    })();
  </script>
</AdminLayout>
