---
import AdminLayout from '../layouts/AdminLayout.astro';
import { resolveApiBaseUrl } from '../lib/api-base-url';

// V-312 — admin view of status-page email subscribers (V-295c3 +
// V-295c3-tombstone). Read /v1/admin/status-subscribers; expose a
// force-unsubscribe button per row. Audit log dual-write happens
// server-side (V-281 pattern).

const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Status-page subscribers">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="status-subscribers">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Status-page subscribers</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Email addresses subscribed to status.driftstack.dev incident notifications. Confirmed
          subscribers receive emails when public incidents are posted or resolved (V-295c3-followup
          fan-out). Force-unsubscribe writes admin_audit_log via V-281 dual-write.
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as ab41f9d8. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-amber-500"
          ></span>
          <span data-live-status>Waiting for live data</span>
          <span data-live-age class="hidden"></span>
        </span>
        <button
          type="button"
          data-live-refresh
          disabled
          aria-disabled="true"
          title="Available after staff sign-in."
          class="text-tk-accent hover:underline disabled:cursor-not-allowed disabled:text-tk-ink-3 disabled:no-underline"
        >
          Refresh now
        </button>
      </div>
    </header>

    {/* 2026-05-22 — admin force-subscribe. Bypasses public double-
        opt-in flow when staff has out-of-band consent (sales
        handoff, ticket). Audit-logged via
        admin_audit_action='status_subscriber.force_subscribed'. */}
    <form
      data-add-form
      class="mb-6 flex flex-wrap items-end gap-3 rounded-lg border border-tk-border bg-tk-surface p-4"
      autocomplete="off"
    >
      <div class="flex-1 min-w-[260px]">
        <label for="add-email" class="block text-xs font-medium uppercase tracking-wide text-tk-ink-3">
          Add subscriber (force, no opt-in email)
        </label>
        <input
          id="add-email"
          name="email"
          type="email"
          required
          disabled
          aria-disabled="true"
          title="Available after the live subscriber list loads."
          placeholder="customer@example.com"
          class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent disabled:cursor-not-allowed disabled:bg-tk-hover disabled:text-tk-ink-3"
        />
      </div>
      <button
        type="submit"
        disabled
        aria-disabled="true"
        title="Available after the live subscriber list loads."
        class="btn-primary disabled:cursor-not-allowed disabled:opacity-60">Add subscriber</button
      >
    </form>
    <div data-add-result class="mb-6 hidden rounded-md border border-emerald-200 bg-emerald-50 p-3 text-xs"></div>

    <div class="rounded-lg border border-tk-border bg-tk-surface">
      <ul data-list class="divide-y divide-slate-100">
        <li class="px-6 py-4 text-sm text-tk-ink-3">
          Live subscribers are unavailable until loaded.
        </li>
      </ul>
    </div>

    <p class="mt-6 text-xs text-tk-ink-3">
      Subscribers list paginated server-side (default 50 per page; <code>?limit=&amp;offset=</code>
      query params for paging). Confirmed-and-still-subscribed rows trigger fan-out emails on
      public incident state changes (V-295c3-followup). Tombstoned rows (90d post-unsubscribe via
      V-295c3-tombstone purge cron) appear with email = <code>null</code>.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="status-subscribers"]');
      if (!root) return;
      const list = root.querySelector('[data-list]');
      const banner = root.querySelector('[data-banner]');
      const liveDot = root.querySelector('[data-live-dot]');
      const liveStatus = root.querySelector('[data-live-status]');
      const ageEl = root.querySelector('[data-live-age]');
      const refreshBtn = root.querySelector('[data-live-refresh]');
      const addForm = root.querySelector('[data-add-form]');
      const addEmail = addForm ? addForm.querySelector('#add-email') : null;
      const addSubmit = addForm ? addForm.querySelector('button[type="submit"]') : null;
      const addResult = root.querySelector('[data-add-result]');
      const SUBSCRIBER_TIMEOUT_MS = 15_000;
      let refreshController = null;
      let refreshGeneration = 0;
      const forceUnsubsInFlight = new Set();
      const uncertainForceUnsubs = new Set();
      let addInFlight = false;
      let addOutcomeUnknown = false;
      let subscriberDataAvailable = false;
      let lastFetch = null;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, SUBSCRIBER_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      function getToken() {
        try {
          // 2026-05-21 — use ds_web_session_token (canonical staff bearer
          // set by the SSO bridge from app.driftstack.dev). The legacy
          // `driftstack_admin_token` key was never populated.
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function showBanner(msg, isError) {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove('hidden');
        if (isError) {
          banner.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
        } else {
          banner.classList.remove('border-red-200', 'bg-red-50', 'text-red-700');
        }
      }

      function setRefreshAuthority(available, reason) {
        if (!refreshBtn) return;
        refreshBtn.disabled = !available;
        refreshBtn.setAttribute('aria-disabled', available ? 'false' : 'true');
        if (available) refreshBtn.removeAttribute('title');
        else refreshBtn.title = reason || 'Available after staff sign-in.';
      }

      function setAddAuthority(available, reason) {
        subscriberDataAvailable = available;
        const unavailableReason = reason || 'Available after the live subscriber list loads.';
        if (addEmail) {
          addEmail.disabled = !available;
          addEmail.setAttribute('aria-disabled', available ? 'false' : 'true');
          if (available) addEmail.removeAttribute('title');
          else addEmail.title = unavailableReason;
        }
        if (addSubmit) {
          const disabled = !available || addInFlight || addOutcomeUnknown;
          addSubmit.disabled = disabled;
          addSubmit.setAttribute('aria-disabled', disabled ? 'true' : 'false');
          if (addOutcomeUnknown) {
            addSubmit.title = 'Reload later to verify the previous add-subscriber outcome.';
          } else if (!available) {
            addSubmit.title = unavailableReason;
          } else if (addInFlight) {
            addSubmit.title = 'Wait for the current add-subscriber action to finish.';
          } else {
            addSubmit.removeAttribute('title');
          }
        }
      }

      function renderUnavailable(message) {
        setAddAuthority(false, message);
        if (list) {
          list.innerHTML =
            '<li class="px-6 py-12 text-center text-sm text-tk-ink-3">' +
            escapeHtml(message) +
            '</li>';
        }
      }

      function setLiveState(state, message) {
        if (liveDot) {
          const color = state === 'success' ? 'bg-emerald-500' : state === 'error' ? 'bg-red-500' : 'bg-amber-500';
          liveDot.className = 'inline-block h-2 w-2 rounded-full ' + color;
        }
        if (liveStatus) liveStatus.textContent = message;
        if (ageEl) {
          ageEl.classList.toggle('hidden', state !== 'success');
          if (state === 'success') ageEl.textContent = '· updated just now';
        }
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }

      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function statusBadge(sub) {
        if (sub.unsubscribed_at) {
          return '<span class="rounded-full bg-tk-hover px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-ink-2">unsubscribed ' +
            escapeHtml(fmtIso(sub.unsubscribed_at)) +
            '</span>';
        }
        if (sub.confirmed_at) {
          return '<span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-emerald-700">confirmed</span>';
        }
        return '<span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-amber-700">pending</span>';
      }

      function row(sub) {
        const canForceUnsub = !sub.unsubscribed_at && sub.email;
        const id = String(sub.id);
        const forceUnsubPending = forceUnsubsInFlight.has(id);
        const forceUnsubUnknown = uncertainForceUnsubs.has(id);
        const forceUnsubDisabled = forceUnsubPending || forceUnsubUnknown;
        const action = canForceUnsub
          ? '<button type="button" data-force-unsub="' +
            escapeHtml(sub.id) +
            '" data-email="' +
            escapeHtml(sub.email) +
            '"' +
            (forceUnsubDisabled
              ? ' disabled aria-disabled="true"' +
                (forceUnsubPending
                  ? ' aria-busy="true" title="Wait for the current force-unsubscribe action to finish."'
                  : ' title="Reload later to verify the previous force-unsubscribe outcome."')
              : '') +
            ' class="text-sm text-rose-700 hover:underline disabled:cursor-not-allowed disabled:opacity-60">' +
            (forceUnsubPending
              ? 'Unsubscribe pending…'
              : forceUnsubUnknown
                ? 'Check status'
                : 'Force unsubscribe') +
            '</button>'
          : '<span class="text-xs text-tk-ink-3">no action</span>';
        const emailDisplay = sub.email
          ? escapeHtml(sub.email)
          : '<span class="font-mono text-xs text-tk-ink-3">(purged — V-295c3-tombstone)</span>';
        return (
          '<li data-subscriber-email="' +
          escapeHtml(sub.email ? String(sub.email).toLowerCase() : '') +
          '" class="px-6 py-4">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0 flex-1">' +
          '<p class="text-base font-medium text-tk-ink">' +
          emailDisplay +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(sub.id) +
          '</p>' +
          '<p class="mt-1 text-xs text-tk-ink-3">Created ' +
          escapeHtml(fmtIso(sub.created_at)) +
          (sub.confirmed_at
            ? ' · confirmed ' + escapeHtml(fmtIso(sub.confirmed_at))
            : '') +
          '</p></div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          statusBadge(sub) +
          action +
          '</div></div></li>'
        );
      }

      function refresh() {
        const token = getToken();
        if (!token) {
          refreshGeneration += 1;
          if (refreshController) refreshController.abort();
          refreshController = null;
          root.removeAttribute('aria-busy');
          renderUnavailable('Sign in with a staff admin account to load subscribers.');
          setRefreshAuthority(false, 'Available after staff sign-in.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return Promise.resolve(false);
        }
        if (refreshController) refreshController.abort();
        const controller = new AbortController();
        const generation = ++refreshGeneration;
        refreshController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          apiBaseUrl + '/v1/admin/status-subscribers?limit=200',
          { headers: { authorization: 'Bearer ' + token } },
          controller,
        )
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function (body) {
            if (generation !== refreshGeneration) return null;
            const subs = body.data || [];
            setAddAuthority(true);
            if (subs.length === 0) {
              if (list)
                list.innerHTML =
                  '<li class="px-6 py-12 text-center">' +
                  '<div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">' +
                  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                  '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />' +
                  '</svg></div>' +
                  '<h2 class="text-base font-semibold tracking-tight text-tk-ink">No subscribers yet</h2>' +
                  '<p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">When visitors subscribe to incident notifications on status.driftstack.dev, they appear here for support and compliance review.</p>' +
                  '</li>';
              return true;
            }
            if (list) {
              list.innerHTML = subs.map(row).join('');
              wireForceUnsub();
            }
            return true;
          })
          .catch(function (err) {
            // A poll/manual/post-mutation refresh intentionally aborts the
            // previous read. Its late rejection (or a response that had
            // already reached body parsing) must not overwrite the newer
            // list or publish a false timeout banner.
            if (generation !== refreshGeneration) return null;
            renderUnavailable('Could not load the current subscriber list. Refresh to try again.');
            showBanner(
              'Failed to load subscribers: ' +
                requestErrorMessage(err, 'network error'),
              true,
            );
            return false;
          })
          .finally(function () {
            if (generation === refreshGeneration) {
              refreshController = null;
              root.removeAttribute('aria-busy');
              if (typeof window.dashboardHydrated === 'function') {
                window.dashboardHydrated();
              }
            }
          });
      }

      window.addEventListener(
        'pagehide',
        function () {
          refreshGeneration += 1;
          if (refreshController) refreshController.abort();
          refreshController = null;
          root.removeAttribute('aria-busy');
        },
        { once: true },
      );

      function wireForceUnsub() {
        if (!list) return;
        const buttons = list.querySelectorAll('[data-force-unsub]');
        buttons.forEach(function (btn) {
          btn.addEventListener('click', async function () {
            const id = btn.getAttribute('data-force-unsub');
            const email = btn.getAttribute('data-email');
            if (!id || uncertainForceUnsubs.has(id) || forceUnsubsInFlight.has(id)) return;
            forceUnsubsInFlight.add(id);
            const idleLabel = btn.textContent || 'Force unsubscribe';
            btn.disabled = true;
            btn.setAttribute('aria-busy', 'true');
            btn.textContent = 'Confirming…';
            try {
              const ok = await window.driftstackConfirm(
                'Force-unsubscribe ' +
                  email +
                  '? Writes admin_audit_log. Customer can re-subscribe via the public form.',
                { confirmLabel: 'Force-unsubscribe' },
              );
              if (!ok) return;
              btn.textContent = 'Unsubscribing…';
              const response = await boundedFetch(
                apiBaseUrl + '/v1/admin/status-subscribers/' + encodeURIComponent(id) + '/force-unsubscribe',
                {
                  method: 'POST',
                  headers: {
                    authorization: 'Bearer ' + getToken(),
                    'content-type': 'application/json',
                  },
                  body: '{}',
                },
              );
              if (!response.ok) throw new Error('HTTP ' + response.status);
              // The response body is unused. Trust the accepted status so a
              // malformed body cannot make an operator repeat a completed
              // force-unsubscribe.
              await refreshWithLive();
            } catch (err) {
              if (err && err.name === 'AbortError') {
                uncertainForceUnsubs.add(id);
                const refreshed = Boolean(await refreshWithLive());
                const stillActive = Array.from(
                  list ? list.querySelectorAll('[data-force-unsub]') : [],
                ).some((action) => action.getAttribute('data-force-unsub') === id);
                showBanner(
                  !refreshed
                    ? 'Force-unsubscribe outcome is unknown after the request timed out, and the subscriber list could not be refreshed. Do not submit it again on this page; reload later to verify status first.'
                    : stillActive
                      ? 'Force-unsubscribe outcome is unknown after the request timed out. The refreshed list still shows ' +
                        email +
                        ' active, but completion may be delayed. Do not submit it again on this page; reload later and retry only if it remains active.'
                      : 'Force-unsubscribe outcome is unknown after the request timed out. The refreshed list no longer shows ' +
                        email +
                        ' active, so it likely completed. Do not submit it again.',
                  true,
                );
                return;
              }
              showBanner(
                'Force-unsubscribe failed: ' + requestErrorMessage(err, 'network error'),
                true,
              );
            } finally {
              forceUnsubsInFlight.delete(id);
              const outcomeUnknown = uncertainForceUnsubs.has(id);
              const current = Array.from(
                list ? list.querySelectorAll('[data-force-unsub]') : [],
              ).find((action) => action.getAttribute('data-force-unsub') === id);
              if (current) {
                current.disabled = outcomeUnknown;
                current.removeAttribute('aria-busy');
                current.setAttribute('aria-disabled', outcomeUnknown ? 'true' : 'false');
                if (!outcomeUnknown) current.removeAttribute('aria-disabled');
                if (outcomeUnknown) {
                  current.title =
                    'Reload later to verify the previous force-unsubscribe outcome.';
                } else {
                  current.removeAttribute('title');
                }
                current.textContent = outcomeUnknown ? 'Check status' : idleLabel;
              }
            }
          });
        });
      }

      // 2026-05-22 — admin force-subscribe form. POSTs the email +
      // shows the returned unsubscribe link in the success banner so
      // staff can copy it for the customer. Refreshes the list on
      // success.
      if (addForm) {
        addForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          if (!subscriberDataAvailable || addInFlight || addOutcomeUnknown) return;
          const token = getToken();
          if (!token) {
            showBanner('Sign in with a staff admin account first.', true);
            return;
          }
          const emailEl = addEmail;
          const email = emailEl && 'value' in emailEl ? emailEl.value.trim() : '';
          if (!email) return;
          const submitBtn = addSubmit;
          addInFlight = true;
          addForm.setAttribute('aria-busy', 'true');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Adding…';
          }
          if (addResult) addResult.classList.add('hidden');
          boundedFetch(apiBaseUrl + '/v1/admin/status-subscribers/force-subscribe', {
            method: 'POST',
            headers: {
              authorization: 'Bearer ' + token,
              'content-type': 'application/json',
            },
            body: JSON.stringify({ email: email }),
          })
            .then((r) =>
              r.ok
                ? r.json()
                : r
                    .json()
                    .catch(() => ({}))
                    .then((b) => Promise.reject(window.driftstackResponseError(r, b))),
            )
            .then((body) => {
              if (addResult) {
                addResult.classList.remove('hidden');
                addResult.innerHTML =
                  '<p class="font-medium text-emerald-700">Added ' +
                  escapeHtml(body.email) +
                  ' (' +
                  escapeHtml(body.id) +
                  ').</p>' +
                  '<p class="mt-1 text-emerald-700">Unsubscribe link: <code class="font-mono">' +
                  escapeHtml(body.unsubscribe_link) +
                  '</code></p>';
              }
              if (emailEl && 'value' in emailEl) emailEl.value = '';
              return refreshWithLive();
            })
            .catch(async (err) => {
              if (err && err.name === 'AbortError') {
                addOutcomeUnknown = true;
                const refreshed = Boolean(await refreshWithLive());
                const normalizedEmail = email.toLowerCase();
                const appearsInList = Array.from(
                  list ? list.querySelectorAll('[data-subscriber-email]') : [],
                ).some(
                  (item) => item.getAttribute('data-subscriber-email') === normalizedEmail,
                );
                showBanner(
                  !refreshed
                    ? 'Add-subscriber outcome is unknown after the request timed out, and the authoritative list could not be refreshed. Do not submit this address again on this page; reload later to verify it first.'
                    : appearsInList
                      ? 'Add-subscriber outcome is unknown after the request timed out. The authoritative list now contains ' +
                        email +
                        ', so the add likely completed, but the returned unsubscribe link cannot be recovered. Do not submit it again; the customer can unsubscribe from a notification email or staff can remove the row here.'
                      : 'Add-subscriber outcome is unknown after the request timed out. The refreshed list does not show ' +
                        email +
                        ' yet, but completion may be delayed. Do not submit it again on this page; reload later and retry only if it remains absent.',
                  true,
                );
                return;
              }
              showBanner(
                'Add subscriber failed: ' + requestErrorMessage(err, 'network error'),
                true,
              );
            })
            .finally(() => {
              addInFlight = false;
              addForm.removeAttribute('aria-busy');
              if (submitBtn) {
                submitBtn.textContent = addOutcomeUnknown ? 'Check status' : 'Add subscriber';
              }
              setAddAuthority(subscriberDataAvailable);
            });
        });
      }

      // 2026-05-22 — live auto-poll. Same pattern as ab41f9d8.
      // Subscribers list refreshes every 30s so a fresh confirmed
      // subscription appears without F5.
      function refreshWithLive() {
        setLiveState('loading', 'Loading live data…');
        setRefreshAuthority(false, 'Loading the current subscriber list.');
        const p = refresh();
        const generation = refreshGeneration;
        if (p && typeof p.then === 'function') {
          p.then(
            (loaded) => {
              if (generation !== refreshGeneration || loaded === null) return;
              if (loaded === true) {
                lastFetch = Date.now();
                setLiveState('success', 'Live');
              } else {
                setLiveState('error', getToken() ? 'Live data unavailable' : 'Staff sign-in required');
              }
              setRefreshAuthority(Boolean(getToken()), 'Available after staff sign-in.');
            },
            () => {
              if (generation !== refreshGeneration) return;
              setLiveState('error', 'Live data unavailable');
              setRefreshAuthority(Boolean(getToken()), 'Available after staff sign-in.');
            },
          );
        }
        return p;
      }
      function fmtAge(ms) {
        if (!ms) return '';
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      function start() {
        if (refreshBtn) refreshBtn.addEventListener('click', refreshWithLive);
        setInterval(refreshWithLive, 30_000);
        setInterval(() => {
          if (ageEl && lastFetch) ageEl.textContent = '· updated ' + fmtAge(lastFetch);
        }, 5_000);
        refreshWithLive();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
