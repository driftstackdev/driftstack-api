---
import AdminLayout from '../layouts/AdminLayout.astro';

// V-193 — progressive-enhancement against /v1/admin/api-keys (new in
// V-193). SSG renders an inert shell; an inline <script> fetches with
// bearer auth. Filter bar wired (account_id text input + hide-revoked
// checkbox). Revoke action POSTs to existing
// /v1/admin/api-keys/:id/revoke with audited reason.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="API keys">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-api-keys">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">API keys</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Cross-account key view for support cases. Manual revocation when a
          customer reports a leak + can't reach the dashboard, or when abuse
          signals trip a moderation flag.
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as be9793f8. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-amber-500"
          ></span>
          <span data-live-status>Waiting for live data</span>
          <span data-live-age class="hidden"></span>
        </span>
        <button
          type="button"
          data-live-refresh
          disabled
          aria-disabled="true"
          title="Available after staff sign-in"
          class="text-tk-accent hover:underline disabled:cursor-not-allowed disabled:opacity-50"
        >
          Refresh now
        </button>
      </div>
    </header>

    <div
      class="mb-6 flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
    >
      <span class="font-mono text-xs uppercase">!</span>
      <p>
        Manual revocation invalidates the key immediately + cascades to the
        auth cache. Customer's running sessions on that key continue until
        next token check; subsequent requests return 401. Audit row records
        admin id + key id + reason.
      </p>
    </div>

    <!-- Filter bar -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <input
        type="search"
        data-field="account-id"
        aria-label="Filter API keys by account id"
        placeholder="Account id (acc_<uuid>)"
        class="w-72 rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      />
      <label class="flex items-center gap-2 text-sm text-tk-ink-2">
        <input type="checkbox" data-field="hide-revoked" class="rounded" />
        Hide revoked
      </label>
    </div>

    <div class="overflow-x-auto rounded-lg border border-tk-border bg-tk-surface">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-tk-border text-left text-xs font-medium uppercase tracking-wide text-tk-ink-3">
            <th class="px-4 py-3">Key</th>
            <th class="px-4 py-3">Account</th>
            <th class="px-4 py-3">Scopes</th>
            <th class="px-4 py-3">Last used</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-list="api-keys">
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-sm text-tk-ink-3">
              Live API keys are unavailable until loaded.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-tk-ink-3" data-field="footnote">
      Revocation fires <code class="font-mono">POST /v1/admin/api-keys/:id/revoke</code> with
      a required reason. The reason is stored on the audit row and surfaced
      to the customer in their key list ("revoked by Driftstack: &lt;reason&gt;").
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-api-keys"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const tbody = root.querySelector('[data-list="api-keys"]');
      const footnote = root.querySelector('[data-field="footnote"]');
      const accountIdEl = root.querySelector('[data-field="account-id"]');
      const hideRevokedEl = root.querySelector('[data-field="hide-revoked"]');
      const liveDot = root.querySelector('[data-live-dot]');
      const liveStatus = root.querySelector('[data-live-status]');
      const liveAge = root.querySelector('[data-live-age]');
      const refreshBtn = root.querySelector('[data-live-refresh]');
      let token = null;
      const API_KEY_TIMEOUT_MS = 15_000;
      let loadController = null;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, API_KEY_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      const SCOPE_LABEL = {
        read: 'read',
        write: 'write',
        admin: 'admin',
        account_owner: 'owner',
        driftstack_internal_admin: 'staff',
        gui_control: 'gui',
      };

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function renderKeysUnavailable(message) {
        if (tbody) {
          tbody.innerHTML =
            '<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-tk-ink-3">' +
            escapeHtml(message) +
            '</td></tr>';
        }
        if (footnote) footnote.textContent = '';
      }

      function setLiveState(state, message) {
        if (liveDot) {
          const color =
            state === 'ready'
              ? 'bg-emerald-500'
              : state === 'failed'
                ? 'bg-red-500'
                : 'bg-amber-500';
          liveDot.className = 'inline-block h-2 w-2 rounded-full ' + color;
        }
        if (liveStatus) {
          liveStatus.textContent = message
            ? message
            : state === 'ready'
              ? 'Live · updated'
              : state === 'failed'
                ? 'Live refresh failed'
                : 'Loading live data';
        }
        if (liveAge) liveAge.classList.toggle('hidden', state !== 'ready');
      }

      const revokesInFlight = new Set();
      function revokeControlState(id) {
        const pending = revokesInFlight.has(String(id));
        return {
          pending,
          attrs: pending
            ? ' disabled aria-disabled="true" aria-busy="true" title="Wait for the current revocation to finish."'
            : '',
          label: pending ? 'Revocation pending…' : 'Revoke',
        };
      }

      function syncRevokeControls(id) {
        const state = revokeControlState(id);
        root.querySelectorAll('[data-action="revoke"]').forEach((control) => {
          if (control.getAttribute('data-id') !== String(id)) return;
          control.disabled = state.pending;
          control.textContent = state.label;
          if (state.pending) {
            control.setAttribute('aria-disabled', 'true');
            control.setAttribute('aria-busy', 'true');
            control.title = 'Wait for the current revocation to finish.';
          } else {
            control.removeAttribute('aria-disabled');
            control.removeAttribute('aria-busy');
            control.removeAttribute('title');
          }
        });
      }

      function rowHtml(k) {
        const revoked = k.revoked_at !== null;
        const opacityClass = revoked ? 'opacity-60' : '';
        const scopeChips = (k.scopes || [])
          .map(
            (s) =>
              '<span class="rounded bg-tk-hover px-1.5 py-0.5 font-mono text-[11px] text-tk-ink-2">' +
              escapeHtml(SCOPE_LABEL[s] || s) +
              '</span>',
          )
          .join(' ');
        const statusBadge = revoked
          ? '<span class="inline-flex rounded-full bg-tk-hover px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-ink-2">revoked</span>'
          : '<span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-emerald-700">active</span>';
        const revokeState = revokeControlState(k.id);
        const actionCell = !revoked
          ? '<button type="button" data-action="revoke" data-id="' +
            escapeHtml(k.id) +
            '"' +
            revokeState.attrs +
            ' class="text-sm font-medium text-red-700 hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-60">' +
            revokeState.label +
            '</button>'
          : '';
        return (
          '<tr class="hover:bg-tk-bg ' +
          opacityClass +
          '">' +
          '<td class="px-4 py-3">' +
          '<p class="font-medium text-tk-ink">' +
          escapeHtml(k.name) +
          '</p>' +
          '<p class="mt-1 font-mono text-[11px] text-tk-ink-2">' +
          escapeHtml(k.key_prefix) +
          '<span class="text-tk-ink-3">…</span></p>' +
          '<p class="mt-0.5 font-mono text-[10px] text-tk-ink-3">' +
          escapeHtml(k.id) +
          '</p></td>' +
          // Email primary (UUID secondary) when the server enriches the
          // row, like the Accounts list — so the operator can tell whose
          // key this is. Falls back to the bare UUID otherwise.
          '<td class="px-4 py-3">' +
          (k.account_email
            ? '<p class="text-xs text-tk-ink">' +
              escapeHtml(k.account_email) +
              '</p>' +
              '<p class="mt-0.5 font-mono text-[10px] text-tk-ink-3">' +
              escapeHtml(k.account_id) +
              '</p>'
            : '<p class="font-mono text-[10px] text-tk-ink-3">' +
              escapeHtml(k.account_id) +
              '</p>') +
          '</td>' +
          '<td class="px-4 py-3"><div class="flex flex-wrap gap-1">' +
          scopeChips +
          '</div></td>' +
          '<td class="px-4 py-3 text-xs text-tk-ink-2">' +
          escapeHtml(fmtIso(k.last_used_at)) +
          '</td>' +
          '<td class="px-4 py-3">' +
          statusBadge +
          '</td>' +
          '<td class="px-4 py-3 text-right">' +
          actionCell +
          '</td></tr>'
        );
      }

      function buildQuery() {
        const params = new URLSearchParams();
        params.set('limit', '50');
        if (accountIdEl && accountIdEl.value.trim())
          params.set('account_id', accountIdEl.value.trim());
        if (hideRevokedEl && hideRevokedEl.checked) params.set('revoked', 'false');
        return params;
      }

      let inFlight = 0;
      function load() {
        if (!token) return Promise.resolve(false);
        const myReq = ++inFlight;
        const params = buildQuery();
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          apiBaseUrl + '/v1/admin/api-keys?' + params.toString(),
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return false;
            const rows = body.data || [];
            if (tbody) {
              if (rows.length === 0) {
                tbody.innerHTML =
                  '<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-tk-ink-3">No keys match the current filter.</td></tr>';
              } else {
                tbody.innerHTML = rows.map(rowHtml).join('');
              }
            }
            if (footnote) {
              footnote.textContent =
                'Showing ' +
                rows.length +
                ' key' +
                (rows.length === 1 ? '' : 's') +
                '. Revoke fires POST /v1/admin/api-keys/:id/revoke with a required reason.';
            }
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (myReq !== inFlight) return false;
            const msg = requestErrorMessage(err, 'network error');
            renderKeysUnavailable(
              'Could not load API keys — nothing to act on. Resolve the error above and retry.',
            );
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load API keys (" + msg + ').');
            }
            return false;
          })
          .finally(() => {
            if (myReq === inFlight) {
              loadController = null;
              root.removeAttribute('aria-busy');
            }
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      async function revoke(id, btn) {
        if (!token || revokesInFlight.has(id)) return;
        revokesInFlight.add(id);
        syncRevokeControls(id);
        if (btn) {
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          btn.textContent = 'Reason…';
        }
        try {
          const reason = await window.driftstackPrompt(
            'Reason for revoking ' + id + ' (required):',
            {
              placeholder: 'e.g. suspected leak',
              confirmLabel: 'Revoke',
            },
          );
          if (!reason || !reason.trim()) {
            showBanner('Revoke cancelled — reason is required.');
            return;
          }
          if (btn) btn.textContent = 'Revoking…';
          showBanner('Revoking ' + id + '…');
          const response = await boundedFetch(
            apiBaseUrl + '/v1/admin/api-keys/' + encodeURIComponent(id) + '/revoke',
            {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                'content-type': 'application/json',
              },
              credentials: 'include',
              body: JSON.stringify({ reason: reason.trim() }),
            },
          );
          if (response.status !== 204 && !response.ok) {
            throw new Error('HTTP ' + response.status);
          }
          showBanner('Revoked ' + id + '. Refreshing…');
          await load();
        } catch (err) {
          if (err && err.name === 'AbortError') {
            const refreshed = await load();
            showBanner(
              'Revocation outcome is unknown after the request timed out. ' +
                (refreshed ? 'The key list was refreshed. ' : "We couldn't refresh the key list. ") +
                'If ' +
                id +
                ' is gone or shows revoked, revocation completed; do not submit it again. If it still shows active, retry the revocation.',
            );
            return;
          }
          const msg = requestErrorMessage(err, 'network error');
          showBanner("Couldn't revoke (" + msg + ').');
        } finally {
          revokesInFlight.delete(id);
          syncRevokeControls(id);
        }
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action="revoke"]');
        if (!btn) return;
        ev.preventDefault();
        const id = btn.getAttribute('data-id');
        if (id) revoke(id, btn);
      });

      let debounce = 0;
      function scheduleLoad() {
        clearTimeout(debounce);
        debounce = setTimeout(loadWithLive, 200);
      }
      if (accountIdEl) accountIdEl.addEventListener('input', scheduleLoad);
      if (hideRevokedEl) hideRevokedEl.addEventListener('change', scheduleLoad);

      // 2026-05-22 — live auto-poll. Same pattern as be9793f8.
      let lastFetch = Date.now();
      function loadWithLive() {
        setLiveState('loading');
        if (refreshBtn) {
          refreshBtn.disabled = true;
          refreshBtn.setAttribute('aria-disabled', 'true');
        }
        const expectedReq = inFlight + 1;
        const p = load();
        if (p && typeof p.then === 'function') {
          return p.then((loaded) => {
            if (expectedReq !== inFlight) return loaded;
            if (loaded) {
              lastFetch = Date.now();
              if (liveAge) liveAge.textContent = 'just now';
              setLiveState('ready');
            } else {
              setLiveState('failed');
            }
            if (refreshBtn) {
              refreshBtn.disabled = false;
              refreshBtn.removeAttribute('aria-disabled');
            }
            return loaded;
          });
        } else {
          setLiveState('failed');
          if (refreshBtn) {
            refreshBtn.disabled = false;
            refreshBtn.removeAttribute('aria-disabled');
          }
          return Promise.resolve(false);
        }
      }
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      function start() {
        try {
          token = localStorage.getItem('ds_web_session_token');
        } catch {
          token = null;
        }
        if (!token) {
          renderKeysUnavailable('Sign in with a staff admin account to see API keys.');
          setLiveState('failed', 'Sign in for live data');
          showBanner('Sign in with a staff admin account to see live data.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return;
        }
        if (refreshBtn) {
          refreshBtn.disabled = false;
          refreshBtn.removeAttribute('aria-disabled');
          refreshBtn.removeAttribute('title');
          refreshBtn.addEventListener('click', loadWithLive);
        }
        setInterval(loadWithLive, 30_000);
        setInterval(() => {
          if (liveAge) liveAge.textContent = fmtAge(lastFetch);
        }, 5_000);
        loadWithLive();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
