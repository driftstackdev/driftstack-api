---
import AdminLayout from '../layouts/AdminLayout.astro';
import { MOCK_ACCOUNTS, MOCK_AUDIT_LOG } from '../data/mocks.ts';

// V-190 — progressive-enhancement against /v1/admin/overview +
// /v1/admin/audit-log?limit=5. SSG renders mock counts; an inline
// <script> fetches both endpoints and replaces the tile values + the
// recent-activity list. Banner surfaces no-token / 403 forbidden /
// fetch-error states.
//
// 2026-06-03 — the 3rd health tile is now a REAL "Open incidents" count
// from /v1/admin/incidents (status != resolved), replacing a prior mock
// tile (no Postgres surface) so the grid carries no fabricated number.

const activeAccounts = MOCK_ACCOUNTS.filter((a) => a.status === 'active');
const suspendedAccounts = MOCK_ACCOUNTS.filter((a) => a.status === 'suspended');
const recentAudits = MOCK_AUDIT_LOG.slice(0, 5);

// Accounts-by-tier distribution (server: /v1/admin/overview accounts.by_tier,
// added 2026-06-02). Canonical AccountTier order + friendly labels — passed to
// the inline script via define:vars so SSR mock-preview and live hydration share
// one source (no drift). SSR paints a mock distribution; hydration replaces it.
const TIER_ORDER = [
  'free',
  'solo_manual',
  'team_manual',
  'agency_manual',
  'api_starter',
  'api_builder',
  'api_scale',
  'enterprise',
] as const;
const TIER_LABELS: Record<string, string> = {
  free: 'Free',
  solo_manual: 'Solo · manual',
  team_manual: 'Team · manual',
  agency_manual: 'Agency · manual',
  api_starter: 'API Starter',
  api_builder: 'API Builder',
  api_scale: 'API Scale',
  enterprise: 'Enterprise',
};
const mockTierCounts: Record<string, number> = Object.fromEntries(
  TIER_ORDER.map((t) => [t, MOCK_ACCOUNTS.filter((a) => a.tier === t).length]),
);
const mockTierMax = Math.max(1, ...Object.values(mockTierCounts));
const mockTierRows = TIER_ORDER.map((t) => ({
  id: t,
  label: TIER_LABELS[t] ?? t,
  n: mockTierCounts[t] ?? 0,
  pct: Math.round(((mockTierCounts[t] ?? 0) / mockTierMax) * 100),
}));

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Overview">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-overview">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    {/* 2026-05-23 — light-theme accent on the admin header. Soft
        oxblood gradient text + a subtle decorative line below.
        Matches the dashboard/marketing visual family without
        breaking the light-mode legibility. */}
    <header class="mb-10">
      <p class="text-sm text-tk-ink-3">Driftstack admin · staff-only</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Overview</h1>
      <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
    </header>

    <!-- Top tiles -->
    <section class="grid gap-4 md:grid-cols-4">
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Active accounts</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="7" r="4" /><path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
            </svg>
          </span>
        </div>
        <p
          class="mt-3 text-3xl font-semibold text-tk-ink"
          data-field="active-accounts"
        >
          {activeAccounts.length}
        </p>
        <p class="mt-1 text-[11px] text-tk-ink-3" data-field="total-accounts-annotation">
          of {MOCK_ACCOUNTS.length} total
        </p>
      </div>
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Suspended</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M9 9h6v6H9z" />
            </svg>
          </span>
        </div>
        <p
          class="mt-3 text-3xl font-semibold text-tk-ink"
          data-field="suspended-accounts"
        >
          {suspendedAccounts.length}
        </p>
      </div>
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Open incidents</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><path d="M12 9v4" /><path d="M12 17h.01" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-field="incidents-open">—</p>
        <p class="mt-1 text-[11px] text-tk-ink-3">active (not resolved)</p>
      </div>
      <div class="dashboard-card">
        <div class="flex items-start justify-between">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">DLQ depth</p>
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-semibold text-tk-ink" data-field="dlq-depth">0</p>
      </div>
    </section>

    <!-- New signups (growth) -->
    <section class="mt-6 dashboard-card">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 6l-9.5 9.5-5-5L1 18" /><path d="M17 6h6v6" />
            </svg>
          </span>
          New signups
        </h2>
        <span class="font-mono text-xs text-tk-ink-3">new accounts · UTC</span>
      </div>
      <dl class="mt-4 grid gap-4 sm:grid-cols-3">
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Today</dt>
          <dd class="mt-1 text-2xl font-semibold text-tk-ink" data-field="signups-today">—</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Last 7 days</dt>
          <dd class="mt-1 text-2xl font-semibold text-tk-ink" data-field="signups-7d">—</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Last 30 days</dt>
          <dd class="mt-1 text-2xl font-semibold text-tk-ink" data-field="signups-30d">—</dd>
        </div>
      </dl>
    </section>

    <!-- Live sessions -->
    <section class="mt-6 dashboard-card">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
            </svg>
          </span>
          Live sessions
        </h2>
        <span class="font-mono text-xs text-tk-ink-3">browser sessions</span>
      </div>
      <dl class="mt-4 grid gap-4 sm:grid-cols-3">
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Active now</dt>
          <dd class="mt-1 text-2xl font-semibold text-tk-ink" data-field="sessions-active">—</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Errored</dt>
          <dd class="mt-1 text-2xl font-semibold text-tk-ink" data-field="sessions-errored">—</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Total</dt>
          <dd class="mt-1 text-2xl font-semibold text-tk-ink" data-field="sessions-total">—</dd>
        </div>
      </dl>
    </section>

    <!-- Accounts by tier -->
    <section class="mt-6 dashboard-card">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" /><rect x="7" y="11" width="3" height="6" /><rect x="12" y="7" width="3" height="10" /><rect x="17" y="13" width="3" height="4" />
            </svg>
          </span>
          Accounts by tier
        </h2>
        <span class="font-mono text-xs text-tk-ink-3" data-field="tier-total">— total</span>
      </div>
      <ul class="mt-4 space-y-2" data-list="tier-distribution">
        {
          mockTierRows.map((row) => (
            <li class="flex items-center gap-3">
              <span class="w-28 shrink-0 font-mono text-xs text-tk-ink-3">{row.label}</span>
              <span class="relative h-2 flex-1 overflow-hidden rounded-full bg-tk-hover">
                <span
                  class="absolute inset-y-0 left-0 rounded-full bg-tk-accent"
                  style={`width:${row.pct}%`}
                />
              </span>
              <span class="w-10 shrink-0 text-right font-mono text-xs text-tk-ink">{row.n}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-[11px] text-tk-ink-3">
        Distribution across every plan tier — sums to total accounts.
      </p>
    </section>

    <!-- Paying subscribers by tier (live: /v1/admin/billing/subscriptions/stats) -->
    <section class="mt-6 dashboard-card">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1v22" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </span>
          Paying subscribers by tier
        </h2>
        <span class="font-mono text-xs text-tk-ink-3" data-field="paying-total">— active</span>
      </div>
      <ul class="mt-4 space-y-2" data-list="paying-tier-distribution">
        {
          TIER_ORDER.map((t) => (
            <li class="flex items-center gap-3">
              <span class="w-28 shrink-0 font-mono text-xs text-tk-ink-3">{TIER_LABELS[t] ?? t}</span>
              <span class="relative h-2 flex-1 overflow-hidden rounded-full bg-tk-hover">
                <span class="absolute inset-y-0 left-0 rounded-full bg-tk-accent" style="width:0%" />
              </span>
              <span class="w-10 shrink-0 text-right font-mono text-xs text-tk-ink">—</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-[11px] text-tk-ink-3">
        Active subscriptions (active / trialing) per tier — the paying-customer mix, vs assigned tier above.
      </p>
    </section>

    {/* Owner-only platform status. SSR-hidden; the inline script reveals it
        only when GET /v1/admin/owner/platform-status returns 200 (the owner
        account). Staff-admins get 403 and never see it. */}
    <section class="mt-6 dashboard-card hidden" data-owner-only="platform-status">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2 4 5v6c0 5 3.4 7.8 8 9 4.6-1.2 8-4 8-9V5l-8-3z" />
            </svg>
          </span>
          Platform status
        </h2>
        <span class="font-mono text-xs text-tk-ink-3">owner-only · activation</span>
      </div>
      <dl class="mt-4 grid gap-3 sm:grid-cols-2" data-list="platform-status">
        {
          [
            ['billing', 'Billing (Stripe)'],
            ['livekit', 'LiveKit'],
            ['crypto', 'Crypto checkout'],
            ['oauth_client', 'OAuth sign-in'],
            ['sentry', 'Sentry'],
            ['permissive_cors', 'Permissive CORS'],
          ].map(([key, label]) => (
            <div class="flex items-center justify-between rounded-md bg-tk-bg px-3 py-2">
              <dt class="text-sm text-tk-ink-2">{label}</dt>
              <dd class="font-mono text-xs text-tk-ink-3" data-field={`flag-${key}`}>—</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-[11px] text-tk-ink-3">
        Which activation-gated features are wired in this deployment (owner view).
      </p>
    </section>

    {/* Owner-only tier pricing. SSR-hidden; revealed only when GET
        /v1/admin/owner/pricing returns 200 (the owner). Editable — Save
        PATCHes the audited owner price-edit route. */}
    <section class="mt-6 dashboard-card hidden" data-owner-only="pricing">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1v22" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </span>
          Tier pricing
        </h2>
        <span class="font-mono text-xs text-tk-ink-3">owner-only · $/mo</span>
      </div>
      <dl class="mt-4 grid gap-3 sm:grid-cols-2" data-list="owner-pricing">
        <div class="text-sm text-tk-ink-3">Loading…</div>
      </dl>
      <p class="mt-3 text-[11px] text-tk-ink-3">
        Per-tier monthly price in cents. Editing the price changes what customers are charged (crypto
        checkout) and the displayed pricing — both read the same source. Each Save is audited.
      </p>
    </section>

    {/* Owner-only platform secrets (secrets Phase A slice 3, 2026-06-12).
        SSR-hidden; revealed only when GET /v1/admin/owner/secrets returns 200
        (the owner). Values NEVER ride the list — Reveal is an explicit,
        server-audited decrypt; Set/Delete are audited too. */}
    <section class="mt-6 dashboard-card hidden" data-owner-only="secrets">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </span>
          Platform secrets
        </h2>
        <span class="font-mono text-xs text-tk-ink-3">owner-only · encrypted at rest</span>
      </div>
      <div class="mt-4 space-y-2" data-list="owner-secrets">
        <div class="text-sm text-tk-ink-3">Loading…</div>
      </div>
      <form class="mt-4 flex flex-wrap items-end gap-2" data-form="secret-set">
        <label class="flex flex-col gap-1 text-[11px] text-tk-ink-3">name
          <input name="name" required pattern="[a-z0-9][a-z0-9_]*" maxlength="64" placeholder="stripe_secret_key"
            class="w-44 rounded border border-tk-border px-2 py-1 font-mono text-xs text-tk-ink" />
        </label>
        <label class="flex flex-col gap-1 text-[11px] text-tk-ink-3">value
          <input name="value" type="password" required maxlength="8192" autocomplete="off" placeholder="••••••"
            class="w-56 rounded border border-tk-border px-2 py-1 font-mono text-xs text-tk-ink" />
        </label>
        <label class="flex flex-col gap-1 text-[11px] text-tk-ink-3">description (optional)
          <input name="description" maxlength="256" placeholder="What is this?"
            class="w-48 rounded border border-tk-border px-2 py-1 text-xs text-tk-ink" />
        </label>
        <button type="submit" class="rounded bg-tk-accent px-3 py-1.5 text-xs font-medium text-white hover:bg-tk-accent-hover">Save secret</button>
        <span class="text-[11px]" data-field="secret-set-status"></span>
      </form>
      <p class="mt-3 text-[11px] text-tk-ink-3">
        AES-256-GCM at rest; list shows metadata only. Reveal decrypts ONCE and is audited
        (secret.revealed) — every set/delete is audited too. Values never appear in the audit log.
      </p>
    </section>

    {/* 2026-05-23 — icon on Recent admin activity header. */}
    <!-- Recent admin activity -->
    <section class="mt-10 dashboard-card">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg>
          </span>
          Recent admin activity
        </h2>
        <div class="flex items-center gap-3 text-xs">
          {/* 2026-05-21 — live auto-refresh indicator. JS toggles
              `data-state` to dot-green while idle, dot-amber while
              fetching, dot-red on error. Updates every 30s. */}
          <span class="flex items-center gap-1.5 text-tk-ink-3" data-live-indicator>
            <span
              aria-hidden="true"
              data-live-dot
              class="inline-block h-2 w-2 rounded-full bg-emerald-500"
            ></span>
            <span data-live-status>Live · updated <span data-live-age>just now</span></span>
          </span>
          <button
            type="button"
            data-live-refresh
            class="text-tk-accent hover:underline"
          >
            Refresh now
          </button>
          <a href="/audit-log" class="text-tk-accent hover:underline">
            See full log →
          </a>
        </div>
      </div>
      <ul class="mt-4 divide-y divide-slate-100" data-list="recent-audits">
        {
          recentAudits.map((entry) => (
            <li class="flex items-start justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="font-mono text-xs text-tk-ink-3">
                  {new Date(entry.ts).toISOString().replace('T', ' ').slice(0, 19)} UTC
                </p>
                <p class="mt-1 text-sm text-tk-ink">
                  <span class="font-mono text-xs text-tk-ink-2">{entry.adminEmail}</span>{' '}
                  <span class="font-mono text-xs text-tk-ink-3">→</span>{' '}
                  <code class="font-mono text-xs text-tk-accent">{entry.action}</code>
                </p>
                {entry.targetAccountId !== null && (
                  <p class="mt-1 font-mono text-xs text-tk-ink-3">
                    target: {entry.targetAccountId}
                  </p>
                )}
              </div>
              <span
                class:list={[
                  'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                  entry.result === 'success'
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'bg-red-50 text-red-700',
                ]}
              >
                {entry.result}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* W527 — ops quick links: the external surfaces an operator checks
        daily, one click from the overview. Static links only (no fetch). */}
    <section class="mt-10" aria-label="Ops quick links">
      <h2 class="text-lg font-semibold tracking-tight text-tk-ink">Ops quick links</h2>
      <ul class="mt-3 flex flex-wrap gap-3 text-sm">
        <li>
          <a href="https://api.driftstack.dev/health" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">prod /health</a>
        </li>
        <li>
          <a href="https://api.driftstack.dev/version" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">prod /version</a>
        </li>
        <li>
          <a href="https://staging.driftstack.dev/version" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">staging /version</a>
        </li>
        <li>
          <a href="https://status.driftstack.dev" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">status page</a>
        </li>
        <li>
          <a href="https://sentry.io" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">Sentry</a>
        </li>
        <li>
          <a href="https://account.postmarkapp.com" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">Postmark</a>
        </li>
        <li>
          <a href="https://dash.cloudflare.com" class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-tk-ink-2 hover:border-slate-400" rel="noopener" target="_blank">Cloudflare</a>
        </li>
      </ul>
    </section>

    <p class="mt-8 text-xs text-tk-ink-3">
      All actions on this panel are audit-logged with admin id + target id +
      input payload + ip address. Audit trail is append-only and cannot be
      mutated by admins (D-025 audit-before-response contract).
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, tierOrder: TIER_ORDER, tierLabels: TIER_LABELS }}>
    (function () {
      const root = document.querySelector('[data-page="admin-overview"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list="recent-audits"]');
      const token = localStorage.getItem('ds_web_session_token');

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function setText(field, text) {
        const el = root.querySelector('[data-field="' + field + '"]');
        if (el) el.textContent = text;
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
      }

      function authedFetch(path, init) {
        // Optional `init` lets callers issue non-GET requests (e.g. the owner
        // pricing PATCH); the bearer + credentials are merged in. Back-compat:
        // GET callers pass no init and behave exactly as before.
        var opts = init || {};
        var headers = Object.assign({ authorization: 'Bearer ' + token }, opts.headers || {});
        return window
          .driftstackFetchWithDeadline(
            apiBaseUrl + path,
            Object.assign({ credentials: 'include' }, opts, {
              headers: headers,
            }),
            15_000,
          )
          .catch((err) => {
            if (err && err.name === 'AbortError') {
              const timeoutError = new Error('Request timed out. Try again.');
              timeoutError.name = 'AbortError';
              throw timeoutError;
            }
            throw err;
          });
      }

      // Replace the SSR mock tier bars with the live distribution from
      // /v1/admin/overview accounts.by_tier. Bar widths are relative to the
      // largest tier so small tiers stay visible; the count is exact.
      function renderTiers(byTier, total) {
        const tierList = root.querySelector('[data-list="tier-distribution"]');
        if (!tierList) return;
        const rows = tierOrder.map((t) => ({
          label: tierLabels[t] || t,
          n: byTier && typeof byTier[t] === 'number' ? byTier[t] : 0,
        }));
        const max = Math.max(1, ...rows.map((r) => r.n));
        tierList.innerHTML = rows
          .map((r) => {
            const pct = Math.round((r.n / max) * 100);
            return (
              '<li class="flex items-center gap-3">' +
              '<span class="w-28 shrink-0 font-mono text-xs text-tk-ink-3">' +
              escapeHtml(r.label) +
              '</span>' +
              '<span class="relative h-2 flex-1 overflow-hidden rounded-full bg-tk-hover">' +
              '<span class="absolute inset-y-0 left-0 rounded-full bg-tk-accent" style="width:' +
              pct +
              '%"></span></span>' +
              '<span class="w-10 shrink-0 text-right font-mono text-xs text-tk-ink">' +
              escapeHtml(String(r.n)) +
              '</span></li>'
            );
          })
          .join('');
        setText('tier-total', total + ' total');
      }

      // Live paying-subscriber distribution from
      // /v1/admin/billing/subscriptions/stats by_tier — same bar treatment
      // as the accounts card; counts active (active/trialing) subscriptions.
      function renderPayingTiers(byTier, totalActive) {
        const payingList = root.querySelector('[data-list="paying-tier-distribution"]');
        if (!payingList) return;
        const rows = tierOrder.map((t) => ({
          label: tierLabels[t] || t,
          n: byTier && typeof byTier[t] === 'number' ? byTier[t] : 0,
        }));
        const max = Math.max(1, ...rows.map((r) => r.n));
        payingList.innerHTML = rows
          .map((r) => {
            const pct = Math.round((r.n / max) * 100);
            return (
              '<li class="flex items-center gap-3">' +
              '<span class="w-28 shrink-0 font-mono text-xs text-tk-ink-3">' +
              escapeHtml(r.label) +
              '</span>' +
              '<span class="relative h-2 flex-1 overflow-hidden rounded-full bg-tk-hover">' +
              '<span class="absolute inset-y-0 left-0 rounded-full bg-tk-accent" style="width:' +
              pct +
              '%"></span></span>' +
              '<span class="w-10 shrink-0 text-right font-mono text-xs text-tk-ink">' +
              escapeHtml(String(r.n)) +
              '</span></li>'
            );
          })
          .join('');
        setText('paying-total', totalActive + ' active');
      }

      function renderAudits(entries) {
        if (!list) return;
        if (entries.length === 0) {
          list.innerHTML =
            '<li class="py-3 text-sm text-tk-ink-3">No admin actions recorded yet.</li>';
          return;
        }
        list.innerHTML = entries
          .map((entry) => {
            // Prefer the email (UUID secondary) when the server enriches
            // the entry, so the recent-actions feed reads "who → action →
            // to whom" without UUID-chasing. Falls back to the UUID.
            const targetFrag = entry.target_account_id
              ? '<p class="mt-1 font-mono text-xs text-tk-ink-3">target: ' +
                escapeHtml(entry.target_email || entry.target_account_id) +
                '</p>'
              : '';
            const resultClass =
              entry.result === 'success'
                ? 'bg-emerald-50 text-emerald-700'
                : 'bg-red-50 text-red-700';
            return (
              '<li class="flex items-start justify-between gap-4 py-3">' +
              '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-tk-ink-3">' +
              escapeHtml(fmtIso(entry.timestamp)) +
              '</p>' +
              '<p class="mt-1 text-sm text-tk-ink">' +
              '<span class="font-mono text-xs text-tk-ink-2">' +
              escapeHtml(entry.admin_email || entry.admin_account_id) +
              '</span> ' +
              '<span class="font-mono text-xs text-tk-ink-3">→</span> ' +
              '<code class="font-mono text-xs text-tk-accent">' +
              escapeHtml(entry.action) +
              '</code></p>' +
              targetFrag +
              '</div>' +
              '<span class="inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
              resultClass +
              '">' +
              escapeHtml(entry.result) +
              '</span></li>'
            );
          })
          .join('');
      }

      // W604 — reset the SSR mock-derived account counts + tier distribution
      // to neutral placeholders. The Active/Suspended tiles, the "of N total"
      // annotation, and the tier bars are baked from MOCK_ACCOUNTS (2 active /
      // 1 suspended / 3 total); leaving them up on a no-token / fetch-error
      // state shows fabricated platform metrics. (The other tiles —
      // incidents-open / dlq-depth / signups / sessions — already init to '—'.)
      function resetMockTiles() {
        setText('active-accounts', '—');
        setText('suspended-accounts', '—');
        setText('total-accounts-annotation', 'of — total');
        const tierList = root.querySelector('[data-list="tier-distribution"]');
        if (tierList) {
          tierList.innerHTML =
            '<li class="text-xs text-tk-ink-3">No data.</li>';
        }
        setText('tier-total', '— total');
      }

      if (!token) {
        resetMockTiles();
        showBanner('Sign in with a staff admin account to see live data.');
        if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
        return;
      }

      // 2026-05-22 — overview fetch extracted into a function so the
      // 30s live-poll timer can refresh the count tiles alongside the
      // activity feed. Previously the tiles painted once at boot then
      // froze; an operator watching for a DLQ spike would have to F5.
      function fetchOverview() {
        return authedFetch('/v1/admin/overview')
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (body && body.accounts) {
              setText('active-accounts', String(body.accounts.active));
              setText('suspended-accounts', String(body.accounts.suspended));
              // V-515 — server now returns a computed total
              // (active + suspended + deleted). Annotate the active-
              // accounts tile with "of N total" so the operator sees
              // the fleet shape without doing arithmetic. Falls back
              // gracefully if the field is missing.
              const total =
                body.accounts.total !== undefined
                  ? body.accounts.total
                  : (body.accounts.active || 0) +
                    (body.accounts.suspended || 0) +
                    (body.accounts.deleted || 0);
              setText('total-accounts-annotation', 'of ' + total + ' total');
              // by_tier (server 2026-06-02) — render the tier distribution,
              // replacing the SSR mock bars. Tolerates older servers that
              // don't yet return by_tier (the SSR preview stays).
              if (body.accounts.by_tier) {
                renderTiers(body.accounts.by_tier, total);
              }
              // signups (server 2026-06-02) — today/7d/30d new-account
              // counts. Tolerates older servers that omit signups.
              if (body.accounts.signups) {
                setText('signups-today', String(body.accounts.signups.today));
                setText('signups-7d', String(body.accounts.signups.last_7d));
                setText('signups-30d', String(body.accounts.signups.last_30d));
              }
            }
            if (body && body.webhooks) {
              setText('dlq-depth', String(body.webhooks.dlq_depth));
            }
          });
      }
      const overviewP = fetchOverview();

      // Live session stats (server 2026-06-03) — active / errored / total
      // browser sessions from /v1/admin/sessions/stats. Extracted like
      // fetchOverview so the 30s timer refreshes it too. Tolerates older
      // servers (the SSR "—" placeholders stay).
      function fetchSessionStats() {
        return authedFetch('/v1/admin/sessions/stats')
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (body) {
              setText('sessions-active', String(body.active));
              setText('sessions-total', String(body.total));
              if (body.by_status) {
                setText('sessions-errored', String(body.by_status.errored));
              }
            }
          });
      }
      const sessionsP = fetchSessionStats();

      // Open incidents (2026-06-03) — REAL count of non-resolved incidents
      // from /v1/admin/incidents (status !== 'resolved'), replacing the
      // former mock leads tile. Tolerates both the {data:[...]} envelope
      // and a bare array. Rides the 30s poll like the others.
      function fetchOpenIncidents() {
        return authedFetch('/v1/admin/incidents')
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            const rows = Array.isArray(body) ? body : (body && body.data) || [];
            const open = rows.filter((i) => i && i.status !== 'resolved').length;
            setText('incidents-open', String(open));
          });
      }
      const incidentsP = fetchOpenIncidents();

      // Paying-subscriber mix (2026-06-04) — active-subscription count by
      // tier from /v1/admin/billing/subscriptions/stats ({by_tier,
      // total_active}). Best-effort: NOT part of the banner-gating
      // Promise.all, and tolerates older servers / errors (the SSR "—"
      // placeholders stay) so it never blocks the rest of the overview.
      function fetchPayingTiers() {
        return authedFetch('/v1/admin/billing/subscriptions/stats')
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (body && body.by_tier) {
              renderPayingTiers(body.by_tier, body.total_active || 0);
            }
          });
      }
      void fetchPayingTiers().catch(() => {});

      // Owner-only platform status (2026-06-04) — GET /v1/admin/owner/platform-status
      // returns { features: { billing, livekit, crypto, oauth_client, sentry,
      // permissive_cors } } for the OWNER account (403 for staff-admins).
      // Best-effort + owner-gated: reveals the SSR-hidden card ONLY on a 200;
      // staff get 403 → the card stays hidden. Never part of the banner gate.
      function renderPlatformStatus(features) {
        const card = root.querySelector('[data-owner-only="platform-status"]');
        if (!card || !features) return;
        const keys = ['billing', 'livekit', 'crypto', 'oauth_client', 'sentry', 'permissive_cors'];
        for (const k of keys) {
          const el = root.querySelector('[data-field="flag-' + k + '"]');
          if (el) el.textContent = features[k] ? 'wired' : 'not set';
        }
        card.classList.remove('hidden');
      }
      function fetchPlatformStatus() {
        return authedFetch('/v1/admin/owner/platform-status')
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (body && body.features) renderPlatformStatus(body.features);
          });
      }
      void fetchPlatformStatus().catch(() => {});

      // Owner-only tier pricing (2026-06-04; editable 2026-06-05) — GET
      // /v1/admin/owner/pricing returns { tiers: [{ tier, monthly_cents }] }
      // for the OWNER (403 for staff). Best-effort + owner-gated: reveals the
      // SSR-hidden card only on a 200; staff stay hidden. Each row is editable
      // — Save PATCHes /v1/admin/owner/pricing/:tier { monthly_cents } (the
      // audited owner edit route); the change moves both this view and the
      // crypto-checkout charge (both read PricingService.listEffective).
      function renderPricing(tiers) {
        const card = root.querySelector('[data-owner-only="pricing"]');
        const list = root.querySelector('[data-list="owner-pricing"]');
        if (!card || !list || !Array.isArray(tiers)) return;
        // A confirm dialog moves focus outside this list, so the focus guard
        // below is not enough to protect a pending row from the 30s/manual
        // poll. Keep the exact disabled/busy nodes mounted until every save
        // lease settles; the next poll reconciles unrelated prices.
        if (pricingSavesInFlight.size > 0) return;
        // Don't clobber an in-progress edit when the 30s poll re-renders.
        const active = window.document.activeElement;
        if (active && list.contains(active)) return;
        list.innerHTML = tiers
          .map((t) => {
            const tier = String(t.tier);
            const cents = Number(t.monthly_cents || 0);
            const dollars = '$' + (cents / 100).toFixed(0) + '/mo';
            return (
              '<div class="flex items-center justify-between gap-2 rounded-md bg-tk-bg px-3 py-2" data-pricing-row="' +
              escapeHtml(tier) +
              '"><dt class="text-sm text-tk-ink-2">' +
              escapeHtml(tier) +
              '<span class="ml-1 text-[11px] text-tk-ink-3">' +
              escapeHtml(dollars) +
              '</span></dt><dd class="flex items-center gap-1">' +
              '<input type="number" min="1" max="1000000" step="1" value="' +
              String(cents) +
              '" data-edit-tier="' +
              escapeHtml(tier) +
              '" aria-label="' +
              escapeHtml(tier) +
              ' monthly price in cents" class="w-24 rounded border border-tk-border px-2 py-1 text-right font-mono text-xs text-tk-ink" />' +
              '<button type="button" data-save-tier="' +
              escapeHtml(tier) +
              '" class="rounded bg-tk-accent px-2 py-1 text-xs font-medium text-white hover:bg-tk-accent-hover">Save</button>' +
              '<span class="w-12 text-[11px]" data-save-status="' +
              escapeHtml(tier) +
              '"></span></dd></div>'
            );
          })
          .join('');
        card.classList.remove('hidden');
      }
      function fetchPricing() {
        return authedFetch('/v1/admin/owner/pricing')
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            if (body && Array.isArray(body.tiers)) renderPricing(body.tiers);
            return body;
          });
      }
      const pricingSavesInFlight = new Set();
      async function savePricing(tier, button) {
        if (!tier || pricingSavesInFlight.has(tier)) return;
        const input = root.querySelector('[data-edit-tier="' + tier + '"]');
        const status = root.querySelector('[data-save-status="' + tier + '"]');
        if (!input) return;
        const cents = Number(input.value);
        if (!Number.isInteger(cents) || cents < 1 || cents > 1000000) {
          if (status) {
            status.textContent = 'invalid';
            status.className = 'w-12 text-[11px] text-rose-600';
          }
          return;
        }
        pricingSavesInFlight.add(tier);
        const idleLabel = button ? button.textContent : 'Save';
        input.disabled = true;
        if (button) {
          button.disabled = true;
          button.textContent = 'Confirming…';
          button.setAttribute('aria-busy', 'true');
        }
        try {
          const confirmed = await window.driftstackConfirm(
            'Set ' + tier + ' monthly price to $' + (cents / 100).toFixed(2) + '? This changes the price used for future purchases.',
            { confirmLabel: 'Save price' },
          );
          if (!confirmed) return;
          if (button) button.textContent = 'Saving…';
          if (status) {
            status.textContent = '…';
            status.className = 'w-12 text-[11px] text-tk-ink-3';
          }
          const response = await authedFetch('/v1/admin/owner/pricing/' + encodeURIComponent(tier), {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ monthly_cents: cents }),
          });
          if (!response.ok) throw new Error('HTTP ' + response.status);
          // Reflect the saved price in-place — a full re-render (fetchPricing)
          // would wipe this status + clobber any other in-progress edit. The
          // 30s poll reconciles the rest.
          const row = root.querySelector('[data-pricing-row="' + tier + '"]');
          const label = row ? row.querySelector('dt span') : null;
          if (label) label.textContent = '$' + (cents / 100).toFixed(0) + '/mo';
          if (status) {
            status.textContent = 'saved';
            status.className = 'w-12 text-[11px] text-emerald-600';
          }
        } catch (err) {
          if (err && err.name === 'AbortError') {
            const refreshed = await fetchPricing().catch(() => null);
            const liveTier =
              refreshed && Array.isArray(refreshed.tiers)
                ? refreshed.tiers.find((candidate) => candidate && candidate.tier === tier)
                : null;
            const liveCents = liveTier ? Number(liveTier.monthly_cents) : null;
            const outcomeStatus = root.querySelector('[data-save-status="' + tier + '"]');
            if (liveCents === cents) {
              showBanner(
                'Pricing outcome is unknown because the response timed out. Effective pricing was refreshed and ' +
                  tier +
                  ' is now $' +
                  (cents / 100).toFixed(2) +
                  '; the save completed, so do not submit it again.',
              );
              if (outcomeStatus) {
                outcomeStatus.textContent = 'confirmed';
                outcomeStatus.className = 'w-16 text-[11px] text-emerald-600';
              }
            } else if (liveTier) {
              showBanner(
                'Pricing outcome is unknown because the response timed out. Effective pricing was refreshed and ' +
                  tier +
                  ' is still $' +
                  (liveCents / 100).toFixed(2) +
                  '; retry the $' +
                  (cents / 100).toFixed(2) +
                  ' save if that price is still required.',
              );
              if (outcomeStatus) {
                outcomeStatus.textContent = 'retry';
                outcomeStatus.className = 'w-12 text-[11px] text-amber-600';
              }
            } else {
              showBanner(
                'Pricing outcome is unknown because the response timed out, and effective pricing could not be refreshed. Verify the tier price before retrying.',
              );
              if (outcomeStatus) {
                outcomeStatus.textContent = 'unknown';
                outcomeStatus.className = 'w-12 text-[11px] text-rose-600';
              }
            }
          } else if (status) {
            status.textContent = 'error';
            status.className = 'w-12 text-[11px] text-rose-600';
          }
        } finally {
          pricingSavesInFlight.delete(tier);
          input.disabled = false;
          if (button && button.isConnected) {
            button.disabled = false;
            button.textContent = idleLabel;
            button.removeAttribute('aria-busy');
          }
        }
      }
      // Delegated Save handler — bound once (renderPricing replaces innerHTML
      // on each poll, so a per-row listener would leak; delegation survives).
      const pricingList = root.querySelector('[data-list="owner-pricing"]');
      if (pricingList) {
        pricingList.addEventListener('click', (e) => {
          const t = e.target;
          const btn = t && t.closest ? t.closest('[data-save-tier]') : null;
          if (btn) savePricing(btn.getAttribute('data-save-tier'), btn);
        });
      }
      void fetchPricing().catch(() => {});

      // Owner-only platform secrets (Phase A slice 3, 2026-06-12) — GET
      // /v1/admin/owner/secrets returns { enabled, secrets: [meta] } for the
      // OWNER (403 for staff -> card stays hidden). Values NEVER ride the
      // list; Reveal POSTs the audited decrypt and shows the value until
      // Hide is clicked (cleared from the DOM on hide, never logged).
      let secretMetadataByName = new Map();
      let secretActionInFlight = null;
      let secretFormDisabledBeforeExternalAction = null;
      const SECRET_ACTION_WAIT_REASON = 'Wait for the active secret action to finish.';
      function syncSecretActionControls() {
        const active = secretActionInFlight;
        root
          .querySelectorAll('[data-reveal-secret], [data-delete-secret]')
          .forEach((button) => {
            const isReveal = button.hasAttribute('data-reveal-secret');
            const action = isReveal ? 'reveal' : 'delete';
            const name = button.getAttribute(
              isReveal ? 'data-reveal-secret' : 'data-delete-secret',
            );
            const isActive = Boolean(
              active && active.name === name && active.action === action,
            );
            button.disabled = active !== null;
            button.toggleAttribute('aria-busy', isActive);
            if (active) button.setAttribute('title', SECRET_ACTION_WAIT_REASON);
            else button.removeAttribute('title');
            if (isActive) {
              button.textContent = active.label;
            } else if (isReveal) {
              const output = Array.from(root.querySelectorAll('[data-secret-value]')).find(
                (candidate) => candidate.getAttribute('data-secret-value') === name,
              );
              button.textContent = output && !output.classList.contains('hidden') ? 'Hide' : 'Reveal';
            } else {
              button.textContent = 'Delete';
            }
          });

        if (!secretForm) return;
        const externalAction = Boolean(active && active.action !== 'save');
        const controls = Array.from(secretForm.elements);
        const submit = secretForm.querySelector('button[type="submit"]');
        if (externalAction && secretFormDisabledBeforeExternalAction === null) {
          secretFormDisabledBeforeExternalAction = {
            disabled: controls.map((control) => control.disabled),
            ariaDisabled: secretForm.getAttribute('aria-disabled'),
            submitTitle: submit ? submit.getAttribute('title') : null,
          };
        }
        if (externalAction) {
          controls.forEach((control) => {
            control.disabled = true;
          });
          secretForm.setAttribute('aria-disabled', 'true');
          if (submit) submit.setAttribute('title', SECRET_ACTION_WAIT_REASON);
        } else if (secretFormDisabledBeforeExternalAction !== null) {
          controls.forEach((control, index) => {
            control.disabled = secretFormDisabledBeforeExternalAction.disabled[index];
          });
          const { ariaDisabled, submitTitle } = secretFormDisabledBeforeExternalAction;
          secretFormDisabledBeforeExternalAction = null;
          if (ariaDisabled === null) secretForm.removeAttribute('aria-disabled');
          else secretForm.setAttribute('aria-disabled', ariaDisabled);
          if (submit) {
            if (submitTitle === null) submit.removeAttribute('title');
            else submit.setAttribute('title', submitTitle);
          }
        }
      }
      function beginSecretAction(name, action, label) {
        if (!name || secretActionInFlight !== null) return false;
        if (action !== 'reveal') {
          root.querySelectorAll('[data-secret-value]').forEach((output) => {
            output.textContent = '';
            output.classList.add('hidden');
          });
        }
        secretActionInFlight = { name, action, label };
        syncSecretActionControls();
        return true;
      }
      function updateSecretActionLabel(action, label) {
        if (!secretActionInFlight || secretActionInFlight.action !== action) return;
        secretActionInFlight.label = label;
        syncSecretActionControls();
      }
      function endSecretAction(action) {
        if (!secretActionInFlight || secretActionInFlight.action !== action) return;
        secretActionInFlight = null;
        syncSecretActionControls();
      }
      function renderSecrets(body) {
        const card = root.querySelector('[data-owner-only="secrets"]');
        const list = root.querySelector('[data-list="owner-secrets"]');
        if (!card || !list || !body) return;
        const rows = Array.isArray(body.secrets) ? body.secrets : [];
        secretMetadataByName = new Map(
          rows.map((secret) => [String(secret.name), String(secret.updated_at || '')]),
        );
        if (!body.enabled) {
          list.innerHTML =
            '<div class="text-sm text-amber-600">Secrets are disabled on this deployment (MFA_ENCRYPTION_KEY unset).</div>';
        } else if (rows.length === 0) {
          list.innerHTML = '<div class="text-sm text-tk-ink-3">No secrets stored yet.</div>';
        } else {
          list.innerHTML = rows
            .map((m) => {
              const name = escapeHtml(String(m.name));
              const desc = m.description ? escapeHtml(String(m.description)) : '';
              const updated = m.updated_at ? escapeHtml(String(m.updated_at).slice(0, 16).replace('T', ' ')) : '';
              return (
                '<div class="flex flex-wrap items-center gap-2 rounded-md bg-tk-bg px-3 py-2" data-secret-row="' + name + '">' +
                '<span class="font-mono text-xs text-tk-ink">' + name + '</span>' +
                (desc ? '<span class="text-[11px] text-tk-ink-3">' + desc + '</span>' : '') +
                '<span class="ml-auto text-[11px] text-tk-ink-3">' + updated + '</span>' +
                '<output class="hidden max-w-[16rem] truncate rounded bg-slate-900 px-2 py-0.5 font-mono text-[11px] text-emerald-300" data-secret-value="' + name + '"></output>' +
                '<button type="button" data-reveal-secret="' + name + '" class="rounded border border-tk-border px-2 py-1 text-[11px] text-tk-ink-2 hover:bg-tk-hover">Reveal</button>' +
                '<button type="button" data-delete-secret="' + name + '" class="rounded border border-red-200 px-2 py-1 text-[11px] text-red-600 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50">Delete</button>' +
                '</div>'
              );
            })
            .join('');
        }
        card.classList.remove('hidden');
        syncSecretActionControls();
      }
      function fetchSecrets() {
        return authedFetch('/v1/admin/owner/secrets')
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then((body) => {
            renderSecrets(body);
            return body;
          });
      }
      async function deleteSecret(name, button) {
        const idleLabel = button ? button.textContent : 'Delete';
        if (!beginSecretAction(name, 'delete', 'Confirming…')) return;
        if (button) {
          button.disabled = true;
          button.textContent = 'Confirming…';
          button.setAttribute('aria-busy', 'true');
        }
        try {
          const confirmFn = window.driftstackConfirm;
          const confirmed = confirmFn
            ? await confirmFn('Delete secret "' + name + '"? This is audited and irreversible.', {
                confirmLabel: 'Delete secret',
                destructive: true,
              })
            : window.confirm('Delete secret "' + name + '"? This is audited and irreversible.');
          if (!confirmed) return;
          updateSecretActionLabel('delete', 'Deleting…');
          if (button) button.textContent = 'Deleting…';
          const dstatus = root.querySelector('[data-field="secret-set-status"]');
          const r = await authedFetch('/v1/admin/owner/secrets/' + encodeURIComponent(name), {
            method: 'DELETE',
          });
          if (!r.ok) throw new Error('HTTP ' + r.status);
          if (dstatus) dstatus.textContent = 'Deleted "' + name + '".';
          await fetchSecrets();
        } catch (err) {
          const dstatus = root.querySelector('[data-field="secret-set-status"]');
          if (err && err.name === 'AbortError') {
            const refreshed = await fetchSecrets().catch(() => null);
            const stillPresent =
              refreshed && Array.isArray(refreshed.secrets)
                ? refreshed.secrets.some((secret) => secret && secret.name === name)
                : null;
            if (dstatus && stillPresent === false) {
              dstatus.textContent =
                'Secret-deletion outcome is unknown because the response timed out. Secret metadata was refreshed and "' +
                name +
                '" is absent; deletion completed, so do not submit it again.';
            } else if (dstatus && stillPresent === true) {
              dstatus.textContent =
                'Secret-deletion outcome is unknown because the response timed out. Secret metadata was refreshed and "' +
                name +
                '" is still present; retry deletion if it must be removed.';
            } else if (dstatus) {
              dstatus.textContent =
                'Secret-deletion outcome is unknown because the response timed out, and secret metadata could not be refreshed. Verify the secret before retrying.';
            }
          } else {
            const msg = err && err.message ? err.message : 'network error';
            if (dstatus) dstatus.textContent = 'Delete failed (' + msg + ').';
          }
        } finally {
          endSecretAction('delete');
          if (button && button.isConnected) {
            button.disabled = false;
            button.textContent = idleLabel;
            button.removeAttribute('aria-busy');
          }
        }
      }
      const secretsList = root.querySelector('[data-list="owner-secrets"]');
      async function revealSecret(name, button) {
        if (!name) return;
        const out = Array.from(root.querySelectorAll('[data-secret-value]')).find(
          (candidate) => candidate.getAttribute('data-secret-value') === name,
        );
        if (!out) return;
        if (!out.classList.contains('hidden')) {
          out.textContent = '';
          out.classList.add('hidden');
          button.textContent = 'Reveal';
          return;
        }
        if (!beginSecretAction(name, 'reveal', 'Revealing…')) return;
        button.disabled = true;
        button.textContent = 'Revealing…';
        button.setAttribute('aria-busy', 'true');
        try {
          const response = await authedFetch(
            '/v1/admin/owner/secrets/' + encodeURIComponent(name) + '/reveal',
            { method: 'POST' },
          );
          if (!response.ok) throw new Error('HTTP ' + response.status);
          const body = await response.json();
          out.textContent = String(body.value);
          out.classList.remove('hidden');
        } catch {
          out.textContent = '';
          out.classList.add('hidden');
        } finally {
          endSecretAction('reveal');
          if (button.isConnected) {
            button.disabled = false;
            button.removeAttribute('aria-busy');
            button.textContent = out.classList.contains('hidden') ? 'Reveal' : 'Hide';
          }
        }
      }
      if (secretsList) {
        secretsList.addEventListener('click', (e) => {
          const t = e.target;
          const revealBtn = t && t.closest ? t.closest('[data-reveal-secret]') : null;
          const deleteBtn = t && t.closest ? t.closest('[data-delete-secret]') : null;
          if (revealBtn) {
            const name = revealBtn.getAttribute('data-reveal-secret');
            if (name) void revealSecret(name, revealBtn);
          }
          if (deleteBtn) {
            const name = deleteBtn.getAttribute('data-delete-secret');
            if (name) void deleteSecret(name, deleteBtn);
          }
        });
      }
      const secretForm = root.querySelector('[data-form="secret-set"]');
      async function saveSecret(form) {
        const status = root.querySelector('[data-field="secret-set-status"]');
        if (secretActionInFlight !== null) {
          if (status) status.textContent = SECRET_ACTION_WAIT_REASON;
          return;
        }
        const fd = new FormData(form);
        const name = String(fd.get('name') || '');
        const value = String(fd.get('value') || '');
        const description = String(fd.get('description') || '');
        if (!name || !value) return;
        if (!beginSecretAction(name, 'save', 'Confirming…')) return;
        const previouslyPresent = secretMetadataByName.has(name);
        const previousUpdatedAt = secretMetadataByName.get(name) || '';
        form.setAttribute('aria-busy', 'true');
        const controls = Array.from(form.elements);
        const disabledBefore = controls.map((control) => control.disabled);
        controls.forEach((control) => {
          control.disabled = true;
        });
        const submit = form.querySelector('button[type="submit"]');
        const idleLabel = submit ? submit.textContent : 'Save secret';
        if (submit) submit.textContent = 'Confirming…';
        try {
          const confirmed = await window.driftstackConfirm(
            'Store platform secret "' + name + '"? If it already exists, its encrypted value will be replaced. The value is never written to the audit log.',
            { confirmLabel: 'Save secret' },
          );
          if (!confirmed) return;
          updateSecretActionLabel('save', 'Saving…');
          if (submit) submit.textContent = 'Saving…';
          if (status) {
            status.textContent = 'saving…';
            status.className = 'text-[11px] text-tk-ink-3';
          }
          const response = await authedFetch(
            '/v1/admin/owner/secrets/' + encodeURIComponent(name),
            {
              method: 'PUT',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ value, description: description || null }),
            },
          );
          if (!response.ok) throw new Error('HTTP ' + response.status);
          const body = await response.json();
          if (status) {
            status.textContent = body.status === 'created' ? 'created ✓' : 'updated ✓';
            status.className = 'text-[11px] text-emerald-600';
          }
          form.reset();
          await fetchSecrets();
        } catch (err) {
          if (status) {
            if (err && err.name === 'AbortError') {
              const refreshed = await fetchSecrets().catch(() => null);
              const liveSecret =
                refreshed && Array.isArray(refreshed.secrets)
                  ? refreshed.secrets.find((secret) => secret && secret.name === name)
                  : null;
              const metadataAdvanced =
                liveSecret &&
                (!previouslyPresent || String(liveSecret.updated_at || '') !== previousUpdatedAt);
              if (metadataAdvanced) {
                status.textContent = 'confirmed ✓';
                status.className = 'text-[11px] text-emerald-600';
                form.reset();
                showBanner(
                  'Secret-save outcome is unknown because the response timed out. Secret metadata was refreshed and "' +
                    name +
                    '" has a new version; the save likely completed, so do not overwrite it again. Validate the dependent integration before another change.',
                );
              } else if (liveSecret) {
                status.textContent = 'verify';
                status.className = 'text-[11px] text-amber-600';
                showBanner(
                  'Secret-save outcome is unknown because the response timed out. Secret metadata was refreshed but "' +
                    name +
                    '" has not changed; verify the dependent integration before deliberately retrying the exact value.',
                );
              } else {
                status.textContent = 'unknown';
                status.className = 'text-[11px] text-red-600';
                showBanner(
                  'Secret-save outcome is unknown because the response timed out, and a new metadata version could not be confirmed. Verify the dependent integration and secret list before retrying.',
                );
              }
            } else {
              status.textContent =
                'failed (' + (err && err.message ? err.message : 'error') + ')';
              status.className = 'text-[11px] text-red-600';
            }
          }
        } finally {
          endSecretAction('save');
          form.removeAttribute('aria-busy');
          controls.forEach((control, index) => {
            control.disabled = disabledBefore[index];
          });
          if (submit) submit.textContent = idleLabel;
        }
      }
      if (secretForm) {
        secretForm.addEventListener('submit', (e) => {
          e.preventDefault();
          void saveSecret(secretForm);
        });
      }
      void fetchSecrets().catch(() => {});

      // 2026-05-21 — live activity feed. The audit-log fetch is
      // extracted so we can refresh it on a 30s timer + bind to the
      // "Refresh now" button. Each refresh updates `lastAuditFetch`
      // for the "Live · updated <N> ago" indicator.
      let lastAuditFetch = Date.now();
      function fetchAudit() {
        const liveDot = root.querySelector('[data-live-dot]');
        if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-amber-500';
        return authedFetch('/v1/admin/audit-log?limit=5')
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            renderAudits(body.data || []);
            lastAuditFetch = Date.now();
            if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-emerald-500';
          })
          .catch((err) => {
            if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-red-500';
            throw err;
          });
      }
      const auditP = fetchAudit();

      Promise.all([overviewP, auditP, sessionsP, incidentsP])
        .then(() => hideBanner())
        .catch((err) => {
          const msg = err && err.message ? err.message : 'network error';
          // W604 — clear the SSR mock account counts/tier bars so a transient
          // overview-fetch failure never leaves fabricated platform metrics up.
          resetMockTiles();
          if (msg === 'forbidden') {
            showBanner(
              'Access denied — admin scope required. You are signed in as a customer account.',
            );
          } else {
            showBanner("Couldn't load overview (" + msg + ').');
          }
        })
        .finally(() => {
          // 2026-05-21 — signal AdminLayout opacity-gate (same pattern as
          // customer-dashboard 4a15ce31 / c8ad19a4 / 661f0422).
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        });

      // 2026-05-21 — 30s polling timer + "Refresh now" button +
      // "updated <N> ago" age-ticker. The age string updates every
      // 5s without re-fetching so the indicator feels responsive.
      // 2026-05-22 — refresh the count tiles alongside the activity
      // feed. fetchOverview's errors are swallowed in the .catch
      // so a transient overview-fetch failure doesn't break the
      // audit-feed indicator.
      let refreshAllInFlight = false;
      const refreshBtn = root.querySelector('[data-live-refresh]');
      function refreshAll() {
        if (refreshAllInFlight) return Promise.resolve();
        refreshAllInFlight = true;
        if (refreshBtn) {
          refreshBtn.disabled = true;
          refreshBtn.setAttribute('aria-busy', 'true');
          refreshBtn.textContent = 'Refreshing…';
        }
        return Promise.allSettled([
          fetchAudit(),
          fetchOverview(),
          fetchSessionStats(),
          fetchOpenIncidents(),
          fetchPayingTiers(),
          fetchPlatformStatus(),
          fetchPricing(),
        ]).finally(() => {
          refreshAllInFlight = false;
          if (refreshBtn) {
            refreshBtn.disabled = false;
            refreshBtn.removeAttribute('aria-busy');
            refreshBtn.textContent = 'Refresh now';
          }
        });
      }
      if (refreshBtn) refreshBtn.addEventListener('click', refreshAll);
      setInterval(refreshAll, 30_000);
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      const ageEl = root.querySelector('[data-live-age]');
      setInterval(() => {
        if (ageEl) ageEl.textContent = fmtAge(lastAuditFetch);
      }, 5_000);
    })();
  </script>
</AdminLayout>
