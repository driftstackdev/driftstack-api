---
import AdminLayout from '../layouts/AdminLayout.astro';
import { MOCK_ACCOUNTS, MOCK_AUDIT_LOG, MOCK_LEADS } from '../data/mocks.ts';

const activeAccounts = MOCK_ACCOUNTS.filter((a) => a.status === 'active');
const suspendedAccounts = MOCK_ACCOUNTS.filter((a) => a.status === 'suspended');
const recentAudits = MOCK_AUDIT_LOG.slice(0, 5);
---

<AdminLayout title="Overview">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-10">
      <p class="text-sm text-slate-500">Driftstack admin · staff-only</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Overview</h1>
    </header>

    <!-- Top tiles -->
    <section class="grid gap-4 md:grid-cols-4">
      <div class="dashboard-card">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Active accounts</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">
          {activeAccounts.length}
        </p>
      </div>
      <div class="dashboard-card">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Suspended</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">
          {suspendedAccounts.length}
        </p>
      </div>
      <div class="dashboard-card">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Open leads</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">{MOCK_LEADS.length}</p>
      </div>
      <div class="dashboard-card">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-500">DLQ depth</p>
        <p class="mt-3 text-3xl font-semibold text-slate-900">0</p>
      </div>
    </section>

    <!-- Recent admin activity -->
    <section class="mt-10 dashboard-card">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Recent admin activity</h2>
        <a href="/audit-log" class="text-sm text-oxblood-700 hover:underline">
          See full log →
        </a>
      </div>
      <ul class="mt-4 divide-y divide-slate-100">
        {
          recentAudits.map((entry) => (
            <li class="flex items-start justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="font-mono text-xs text-slate-500">
                  {new Date(entry.ts).toISOString().replace('T', ' ').slice(0, 19)} UTC
                </p>
                <p class="mt-1 text-sm text-slate-900">
                  <span class="font-mono text-xs text-slate-700">{entry.adminEmail}</span>{' '}
                  <span class="font-mono text-xs text-slate-500">→</span>{' '}
                  <code class="font-mono text-xs text-oxblood-700">{entry.action}</code>
                </p>
                {entry.targetAccountId !== null && (
                  <p class="mt-1 font-mono text-xs text-slate-500">
                    target: {entry.targetAccountId}
                  </p>
                )}
              </div>
              <span
                class:list={[
                  'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                  entry.result === 'success'
                    ? 'bg-emerald-50 text-emerald-700'
                    : 'bg-red-50 text-red-700',
                ]}
              >
                {entry.result}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-8 text-xs text-slate-500">
      All actions on this panel are audit-logged with admin id + target id +
      input payload + ip address. Audit trail is append-only and cannot be
      mutated by admins (D-025 audit-before-response contract).
    </p>
  </div>
</AdminLayout>
