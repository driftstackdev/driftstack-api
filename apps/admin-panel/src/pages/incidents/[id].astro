---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { MOCK_INCIDENTS } from '../../data/mocks.ts';

export function getStaticPaths() {
  return MOCK_INCIDENTS.map((inc) => ({ params: { id: inc.id } }));
}

const { id } = Astro.params;
const incident = MOCK_INCIDENTS.find((inc) => inc.id === id);

if (!incident) {
  return Astro.redirect('/incidents');
}

// V-344 — apiBaseUrl exposed to inline script for live form wiring.
import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

function fmtIso(iso: string): string {
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const SEVERITY_BADGE: Record<string, string> = {
  minor: 'bg-amber-50 text-amber-700',
  major: 'bg-orange-50 text-orange-700',
  outage: 'bg-red-50 text-red-700',
};

const STATUS_BADGE: Record<string, string> = {
  investigating: 'bg-amber-50 text-amber-700',
  identified: 'bg-blue-50 text-blue-700',
  monitoring: 'bg-indigo-50 text-indigo-700',
  resolved: 'bg-emerald-50 text-emerald-700',
};

const isResolved = incident.status === 'resolved';
---

<AdminLayout title={`Incident · ${incident.title}`}>
  <div class="mx-auto max-w-4xl px-6 py-10">
    <a href="/incidents" class="text-sm text-oxblood-700 hover:underline">← Back to incidents</a>

    <header class="mt-4 mb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span
          class:list={[
            'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
            SEVERITY_BADGE[incident.severity] ?? '',
          ]}
        >
          {incident.severity}
        </span>
        <span
          class:list={[
            'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
            STATUS_BADGE[incident.status] ?? '',
          ]}
        >
          {incident.status}
        </span>
        {!incident.public && (
          <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-slate-600">
            private
          </span>
        )}
      </div>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight "><span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">{incident.title}</span></h1>
      <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
      <p class="mt-1 font-mono text-xs text-slate-500">{incident.id}</p>
      <p class="mt-2 text-sm text-slate-500">
        Started {fmtIso(incident.startedAt)}
        {incident.resolvedAt && (
          <>
            {' '}· resolved {fmtIso(incident.resolvedAt)}
          </>
        )}
        {incident.affectedComponents.length > 0 && (
          <>
            {' '}· affecting {incident.affectedComponents.join(', ')}
          </>
        )}
      </p>
    </header>

    <!-- Timeline -->
    <section class="dashboard-card mb-8">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-oxblood-700/10 ring-1 ring-oxblood-700/20 text-oxblood-700">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
              </svg>
            </span>
            <span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Timeline</span>
          </h2>
      <ol class="mt-4 space-y-4 border-l border-slate-200 pl-5">
        {incident.updates.map((u) => (
          <li class="relative">
            <span class="absolute -left-[27px] top-1 inline-block h-3 w-3 rounded-full border-2 border-white bg-oxblood-700 ring-1 ring-oxblood-700" />
            <div class="flex items-baseline gap-2">
              <span
                class:list={[
                  'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                  STATUS_BADGE[u.status] ?? '',
                ]}
              >
                {u.status}
              </span>
              <span class="text-xs text-slate-500">{fmtIso(u.postedAt)}</span>
            </div>
            <p class="mt-1 text-sm text-slate-700">{u.message}</p>
          </li>
        ))}
      </ol>
    </section>

    {
      !isResolved && (
        <>
          <!-- Add-update form -->
          <section class="dashboard-card mb-6">
            <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-oxblood-700/10 ring-1 ring-oxblood-700/20 text-oxblood-700">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </span>
            <span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Post update</span>
          </h2>
            <form id="add-update-form" class="mt-4 space-y-4">
              <div>
                <label class="block text-sm font-medium text-slate-700" for="update-status">
                  Status
                </label>
                <select
                  id="update-status"
                  name="status"
                  class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
                >
                  <option value="investigating">Investigating</option>
                  <option value="identified">Identified</option>
                  <option value="monitoring" selected>Monitoring</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700" for="update-message">
                  Message
                </label>
                <textarea
                  id="update-message"
                  name="message"
                  rows="3"
                  required
                  class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
                ></textarea>
              </div>
              <div class="flex justify-end border-t border-slate-100 pt-4">
                <button
                  type="submit"
                  class="inline-flex items-center rounded-md bg-oxblood-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-oxblood-800 focus:outline-none focus:ring-2 focus:ring-oxblood-700 focus:ring-offset-2"
                >
                  Post update
                </button>
              </div>
            </form>
          </section>

          <!-- Resolve form -->
          <section class="dashboard-card border-emerald-200 bg-emerald-50/30">
            <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-oxblood-700/10 ring-1 ring-oxblood-700/20 text-oxblood-700">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" />
              </svg>
            </span>
            <span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Mark resolved</span>
          </h2>
            <p class="mt-1 text-sm text-slate-600">
              Posts a final timeline entry with status “resolved” and stamps
              <code>resolved_at</code>. The status page will show a green banner once propagated.
            </p>
            <form id="resolve-form" class="mt-4 space-y-4">
              <div>
                <label class="block text-sm font-medium text-slate-700" for="resolve-message">
                  Resolution summary
                </label>
                <textarea
                  id="resolve-message"
                  name="message"
                  rows="3"
                  required
                  placeholder="Rolled back the bad deploy. Monitoring complete; error rate normal."
                  class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
                ></textarea>
              </div>
              <div class="flex justify-end border-t border-emerald-100 pt-4">
                <button
                  type="submit"
                  class="inline-flex items-center rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2"
                >
                  Resolve incident
                </button>
              </div>
            </form>
          </section>
        </>
      )
    }

    {/* 2026-05-22 — admin reopen flow for false-alarm correction
        or regression on a previously-resolved issue. Only shows
        when incident is in 'resolved' state. Same body shape as
        the resolve form (just a message); audit-action
        'incident.reopened' via migration 0063. */}
    {
      isResolved && (
        <section class="dashboard-card mb-6 border-amber-200 bg-amber-50/30">
          <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-oxblood-700/10 ring-1 ring-oxblood-700/20 text-oxblood-700">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
              </svg>
            </span>
            <span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Reopen incident</span>
          </h2>
          <p class="mt-2 text-sm text-slate-600">
            Reverts to <code>investigating</code> + clears
            <code>resolved_at</code>. Use when the issue resurfaced after
            resolution OR the original resolve was a false alarm. Audit-
            logged.
          </p>
          <form id="reopen-form" class="mt-4 space-y-4">
            <div>
              <label class="block text-sm font-medium text-slate-700" for="reopen-message">
                Reason for reopen
              </label>
              <textarea
                id="reopen-message"
                name="message"
                rows="3"
                required
                minlength="3"
                maxlength="2000"
                placeholder="Recurrence detected: same probe failing again."
                class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-amber-700 focus:outline-none focus:ring-1 focus:ring-amber-700"
              />
            </div>
            <div class="flex justify-end">
              <button
                type="submit"
                class="rounded-md bg-amber-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-800"
              >
                Reopen incident
              </button>
            </div>
          </form>
        </section>
      )
    }
  </div>

  <script is:inline define:vars={{ apiBaseUrl, incidentId: incident.id }}>
    // V-344 — wires Post-update + Mark-resolved forms to the live
    // /v1/admin/incidents/:id/{updates,resolve} endpoints. Replaces
    // the V-295a alert-stubs.
    (function () {
      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      function bind(formId, urlSuffix, includeStatus) {
        const form = document.getElementById(formId);
        if (!form) return;
        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          const token = getToken();
          if (!token) {
            // eslint-disable-next-line no-alert
            alert('Sign in with a staff admin account before posting.');
            return;
          }
          const fd = new FormData(form);
          const message = (fd.get('message') || '').toString().trim();
          if (!message) return;
          const body = { message: message };
          if (includeStatus) {
            body.status = (fd.get('status') || 'monitoring').toString();
          }
          const submit = form.querySelector('button[type="submit"]');
          if (submit) {
            submit.disabled = true;
            submit.dataset.origText = submit.textContent || '';
            submit.textContent = 'Posting…';
          }
          fetch(apiBaseUrl + '/v1/admin/incidents/' + encodeURIComponent(incidentId) + urlSuffix, {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify(body),
          })
            .then(function (r) {
              if (!r.ok) {
                return r
                  .json()
                  .catch(function () {
                    return {};
                  })
                  .then(function (b) {
                    return Promise.reject(new Error(b.detail || 'HTTP ' + r.status));
                  });
              }
              return r.json();
            })
            .then(function () {
              window.location.reload();
            })
            .catch(function (err) {
              // eslint-disable-next-line no-alert
              alert('Post failed: ' + (err && err.message ? err.message : 'network error'));
              if (submit) {
                submit.disabled = false;
                submit.textContent = submit.dataset.origText || 'Submit';
              }
            });
        });
      }

      bind('add-update-form', '/updates', true);
      bind('resolve-form', '/resolve', false);
      // 2026-05-22 — incident reopen handler. Same body shape as
      // resolve (just a message field). bind() handles the POST +
      // page reload pattern.
      bind('reopen-form', '/reopen', false);
    })();
  </script>
</AdminLayout>
