---
import AdminLayout from '../../layouts/AdminLayout.astro';

// V-338 — incident form uses client-owned-id PUT /v1/admin/incidents/:id.
// SSG renders an inert unavailable list; the inline script replaces it
// only after a successful live read and also handles the create form.
import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Incidents">
  <div class="mx-auto max-w-6xl px-6 py-10">
    {/* audit waefer6wu — fetchAndRender() used to swallow every fetch
        failure (403 / 5xx / network) into the same rebuild([]) the page
        renders for a genuine zero-incident state, so a real outage could
        be invisible behind a calm "All systems operational" message. This
        banner gives load failures a distinct, retry-capable state, matching
        the data-banner pattern already used on accounts.astro / sessions.astro
        / audit-log.astro / cost.astro. */}
    <div
      data-banner
      class="mb-6 hidden items-center justify-between gap-4 rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
      <span data-banner-text></span>
      <button
        type="button"
        data-banner-retry
        class="hidden shrink-0 font-medium text-tk-accent hover:underline"
      >
        Retry
      </button>
    </div>

    <header class="mb-8 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Incidents</h1>
        <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 text-sm text-tk-ink-3">
          Manually post and update status-page incidents. Public entries surface on
          status.driftstack.dev within ~60 seconds. Every action audit-logged.
        </p>
      </div>
    </header>

    {/* 2026-05-23 — icon header on Post-new-incident form. */}
    <!-- New incident form -->
    <section class="dashboard-card mb-10">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
            <line x1="12" y1="9" x2="12" y2="13" />
            <line x1="12" y1="17" x2="12.01" y2="17" />
          </svg>
        </span>
        Post new incident
      </h2>
      <p class="mt-1 text-sm text-tk-ink-3">
        The first message becomes the initial timeline update. Set status to
        “investigating” unless you’ve already pinned the cause.
      </p>
      <form id="new-incident-form" class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="title">Title</label>
          <input
            id="title"
            name="title"
            type="text"
            required
            placeholder="API server elevated 5xx — eu-west-1"
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-tk-ink-2" for="description">
            Initial update
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            required
            placeholder="Investigating elevated error rate on /v1/sessions/create after 14:02 UTC deploy."
            class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
          ></textarea>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="block text-sm font-medium text-tk-ink-2" for="severity">Severity</label>
            <select
              id="severity"
              name="severity"
              class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            >
              <option value="minor">Minor</option>
              <option value="major" selected>Major</option>
              <option value="outage">Outage</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-tk-ink-2" for="affected">
              Affected components
            </label>
            <input
              id="affected"
              name="affected"
              type="text"
              placeholder="api, sessions"
              class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            />
          </div>
          <div class="flex items-end">
            <label class="inline-flex items-center gap-2 text-sm text-tk-ink-2">
              <input
                id="public"
                name="public"
                type="checkbox"
                checked
                class="rounded border-tk-border text-tk-accent focus:ring-tk-accent"
              />
              Public on status page
            </label>
          </div>
        </div>
        <p
          id="form-error"
          class="hidden rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        ></p>
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
          <button
            id="submit-btn"
            type="submit"
            class="inline-flex items-center rounded-md bg-tk-accent px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-tk-accent-hover focus:outline-none focus:ring-2 focus:ring-tk-accent focus:ring-offset-2 disabled:opacity-50"
          >
            Post incident
          </button>
        </div>
      </form>
    </section>

    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-tk-ink-3">
      Open (<span data-open-count>—</span>)
    </h2>
    <div data-incidents-list>
      <div class="dashboard-card text-center text-sm text-tk-ink-3">
        Live incident state unavailable until loaded.
      </div>
    </div>

    <p class="mt-8 text-xs text-tk-ink-3">
      Posting an incident writes <code>incident.created</code> to the admin audit log.
      Public incidents propagate to status.driftstack.dev through the Cloudflare Pages mirror
      within about 60 seconds via the Hetzner poller and R2.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    // V-338 — wires the new-incident form to idempotent PUT /v1/admin/incidents/:id.
    // V-338b — also fetches /v1/admin/incidents on mount + replaces
    // the unavailable list shell with live data.
    (function () {
      const INCIDENT_TIMEOUT_MS = 15_000;
      let listController = null;
      let listGeneration = 0;

      function boundedFetch(url, init, controller) {
        const activeController = controller || new AbortController();
        return window.driftstackFetchWithDeadline(
          url,
          init,
          INCIDENT_TIMEOUT_MS,
          activeController,
        );
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      const SEVERITY_BADGE = {
        minor: 'bg-amber-50 text-amber-700',
        major: 'bg-orange-50 text-orange-700',
        outage: 'bg-red-50 text-red-700',
      };
      const STATUS_BADGE = {
        investigating: 'bg-amber-50 text-amber-700',
        identified: 'bg-blue-50 text-blue-700',
        monitoring: 'bg-indigo-50 text-indigo-700',
        resolved: 'bg-emerald-50 text-emerald-700',
      };
      const INCIDENT_STATUSES = new Set(Object.keys(STATUS_BADGE));
      const INCIDENT_SEVERITIES = new Set(Object.keys(SEVERITY_BADGE));
      function isIso(value) {
        if (typeof value !== 'string') return false;
        const date = new Date(value);
        return Number.isFinite(date.getTime()) && date.toISOString() === value;
      }
      function isIncident(value) {
        return Boolean(
          value &&
            typeof value === 'object' &&
            /^inc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
              value.id,
            ) &&
            typeof value.title === 'string' &&
            typeof value.description === 'string' &&
            INCIDENT_SEVERITIES.has(value.severity) &&
            INCIDENT_STATUSES.has(value.status) &&
            Array.isArray(value.affected_components) &&
            value.affected_components.every(function (component) {
              return typeof component === 'string';
            }) &&
            typeof value.public === 'boolean' &&
            isIso(value.started_at) &&
            (value.resolved_at === null || isIso(value.resolved_at)) &&
            isIso(value.created_at) &&
            isIso(value.updated_at),
        );
      }
      function isIncidentUpdate(value) {
        return Boolean(
          value &&
            typeof value === 'object' &&
            /^incu_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
              value.id,
            ) &&
            /^inc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
              value.incident_id,
            ) &&
            typeof value.message === 'string' &&
            INCIDENT_STATUSES.has(value.status) &&
            isIso(value.posted_at),
        );
      }
      function parseListPage(value) {
        if (
          !value ||
          typeof value !== 'object' ||
          !Array.isArray(value.data) ||
          !value.data.every(isIncident) ||
          !Number.isInteger(value.total) ||
          value.total < value.data.length ||
          !Number.isInteger(value.open_count) ||
          value.open_count < 0 ||
          typeof value.has_more !== 'boolean' ||
          !(
            value.next_cursor === null ||
            (typeof value.next_cursor === 'string' && value.next_cursor.length > 0)
          ) ||
          value.has_more !== (value.next_cursor !== null)
        ) {
          throw new Error('invalid incident list response');
        }
        return value;
      }
      function fmtIso(iso) {
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }
      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }
      function openLi(inc) {
        const sevClass = SEVERITY_BADGE[inc.severity] || '';
        const statusClass = STATUS_BADGE[inc.status] || '';
        const privBadge = inc.public
          ? ''
          : '<span class="inline-flex rounded-full bg-tk-hover px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-ink-2">private</span>';
        return (
          '<li class="dashboard-card">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-tk-ink">' +
          escapeHtml(inc.title) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(inc.id) +
          '</p>' +
          '<p class="mt-1 text-xs text-tk-ink-3">Started ' +
          escapeHtml(fmtIso(inc.started_at)) +
          '</p>' +
          '</div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          sevClass +
          '">' +
          escapeHtml(inc.severity) +
          '</span>' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          statusClass +
          '">' +
          escapeHtml(inc.status) +
          '</span>' +
          privBadge +
          '<a href="/incidents/' +
          encodeURIComponent(inc.id) +
          '" class="text-sm text-tk-accent hover:underline">Open</a>' +
          '</div></div></li>'
        );
      }
      function resolvedLi(inc) {
        return (
          '<li class="dashboard-card opacity-80">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<p class="text-base font-medium text-tk-ink">' +
          escapeHtml(inc.title) +
          '</p>' +
          '<p class="mt-1 font-mono text-xs text-tk-ink-3">' +
          escapeHtml(inc.id) +
          '</p>' +
          '<p class="mt-1 text-xs text-tk-ink-3">' +
          escapeHtml(fmtIso(inc.started_at)) +
          ' → ' +
          escapeHtml(inc.resolved_at ? fmtIso(inc.resolved_at) : '—') +
          '</p>' +
          '</div>' +
          '<a href="/incidents/' +
          encodeURIComponent(inc.id) +
          '" class="text-sm text-tk-accent hover:underline">Open</a>' +
          '</div></li>'
        );
      }
      function showBanner(text, opts) {
        var banner = document.querySelector('[data-banner]');
        if (!banner) return;
        var textEl = banner.querySelector('[data-banner-text]');
        if (textEl) textEl.textContent = text;
        else banner.textContent = text;
        banner.classList.remove('hidden');
        banner.classList.add('flex');
        var retryBtn = banner.querySelector('[data-banner-retry]');
        if (retryBtn) {
          if (opts && opts.retry) retryBtn.classList.remove('hidden');
          else retryBtn.classList.add('hidden');
        }
      }
      function hideBanner() {
        var banner = document.querySelector('[data-banner]');
        if (!banner) return;
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      }

      function rebuild(open, resolved, metadata) {
        const container = document.querySelector('[data-incidents-list]');
        const openCountEl = document.querySelector('[data-open-count]');
        if (!container) return;
        if (openCountEl) openCountEl.textContent = String(metadata.openTotal);
        let html = '';
        if (metadata.openTotal === 0) {
          html +=
            '<div class="dashboard-card text-center text-sm text-tk-ink-3">No open incidents. All systems operational.</div>';
        } else {
          html += '<ul class="space-y-3">' + open.map(openLi).join('') + '</ul>';
          if (metadata.openTruncated) {
            html +=
              '<p class="mt-3 text-xs text-amber-700">Showing ' +
              open.length +
              ' of ' +
              metadata.openTotal +
              ' open incidents. Use the API cursor to review the remainder.</p>';
          }
        }
        if (metadata.resolvedTotal > 0) {
          html +=
            '<h2 class="mb-3 mt-10 text-sm font-semibold uppercase tracking-wide text-tk-ink-3">Resolved (<span>' +
            metadata.resolvedTotal +
            '</span>)</h2>';
          html += '<ul class="space-y-3">' + resolved.map(resolvedLi).join('') + '</ul>';
          if (metadata.resolvedTruncated) {
            html +=
              '<p class="mt-3 text-xs text-tk-ink-3">Showing the newest ' +
              resolved.length +
              ' of ' +
              metadata.resolvedTotal +
              ' resolved incidents.</p>';
          }
        }
        container.innerHTML = html;
      }

      function renderUnavailable(message) {
        const container = document.querySelector('[data-incidents-list]');
        const openCountEl = document.querySelector('[data-open-count]');
        if (openCountEl) openCountEl.textContent = '—';
        if (container) {
          container.innerHTML =
            '<div class="dashboard-card text-center text-sm text-tk-ink-3">' +
            message +
            '</div>';
        }
      }

      function fetchAndRender() {
        if (listController) listController.abort();
        const generation = ++listGeneration;
        let token;
        try {
          token = localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          token = '';
        }
        // A signed-out operator has no incident authority. Keep this distinct
        // from a successful zero-row response, which alone may claim the
        // platform has no open incidents.
        if (!token) {
          renderUnavailable('Sign in to load live incident state.');
          showBanner('Sign in with a staff admin account to see live data.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return Promise.resolve(false);
        }
        const controller = new AbortController();
        listController = controller;
        return Promise.all([
          boundedFetch(
            apiBaseUrl + '/v1/admin/incidents?scope=all&state=open&limit=100',
            { headers: { authorization: 'Bearer ' + token } },
            controller,
          ),
          boundedFetch(
            apiBaseUrl + '/v1/admin/incidents?scope=all&state=resolved&limit=100',
            { headers: { authorization: 'Bearer ' + token } },
            controller,
          ),
        ])
          .then(function (responses) {
            if (responses.some(function (response) { return response.status === 403; })) {
              return Promise.reject(new Error('forbidden'));
            }
            if (responses.some(function (response) { return !response.ok; })) {
              const failed = responses.find(function (response) { return !response.ok; });
              return Promise.reject(new Error('HTTP ' + (failed ? failed.status : 'unknown')));
            }
            return Promise.all(responses.map(function (response) { return response.json(); }));
          })
          .then(function (bodies) {
            if (generation !== listGeneration) return;
            const openPage = parseListPage(bodies[0]);
            const resolvedPage = parseListPage(bodies[1]);
            if (
              openPage.total !== openPage.open_count ||
              openPage.data.some(function (incident) { return incident.status === 'resolved'; }) ||
              resolvedPage.data.some(function (incident) { return incident.status !== 'resolved'; })
            ) {
              throw new Error('incident lifecycle response mismatch');
            }
            rebuild(openPage.data, resolvedPage.data, {
              openTotal: openPage.open_count,
              openTruncated: openPage.has_more,
              resolvedTotal: resolvedPage.total,
              resolvedTruncated: resolvedPage.has_more,
            });
            hideBanner();
            return true;
          })
          .catch(function (err) {
            if (generation !== listGeneration) return;
            // CRITICAL — a failed fetch (expired token, 403 scope mismatch,
            // transient 5xx, network blip) must NEVER render identically to
            // the verified healthy empty state on the one page
            // whose entire job is surfacing active incidents (audit
            // waefer6wu). Clear the list to avoid showing stale/fabricated
            // data, but show a distinct, retry-capable error banner instead
            // of the calm empty-state message.
            renderUnavailable('Could not load live incident state. Retry before judging health.');
            var msg = requestErrorMessage(err, 'network error');
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
                { retry: true },
              );
            } else {
              showBanner("Couldn't load incidents (" + msg + '). The list below may be incomplete.', {
                retry: true,
              });
            }
            return false;
          })
          .finally(function () {
            if (generation !== listGeneration) return;
            listController = null;
            if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          });
      }

      const retryBtn = document.querySelector('[data-banner-retry]');
      if (retryBtn) retryBtn.addEventListener('click', fetchAndRender);

      const form = document.getElementById('new-incident-form');
      const submit = document.getElementById('submit-btn');
      const errEl = document.getElementById('form-error');
      if (!form || !submit || !errEl) return;

      function showErr(msg) {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      }
      function hideErr() {
        errEl.classList.add('hidden');
        errEl.textContent = '';
      }

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      let postingIncident = false;
      let createAttempt = null;
      let createAttemptBlocked = false;

      function sameStringArray(left, right) {
        return (
          Array.isArray(left) &&
          Array.isArray(right) &&
          left.length === right.length &&
          left.every(function (value, index) { return value === right[index]; })
        );
      }

      function parseWriteSuccess(status, value, attempt) {
        const expectedOutcome = status === 201 ? 'created' : status === 200 ? 'replayed' : null;
        if (
          expectedOutcome === null ||
          !value ||
          typeof value !== 'object' ||
          value.outcome !== expectedOutcome ||
          !isIncident(value.incident) ||
          value.incident.id !== attempt.id ||
          value.incident.title !== attempt.body.title ||
          value.incident.description !== attempt.body.description ||
          value.incident.severity !== attempt.body.severity ||
          value.incident.public !== attempt.body.public ||
          value.incident.started_at !== attempt.body.started_at ||
          !sameStringArray(value.incident.affected_components, attempt.body.affected_components) ||
          !Array.isArray(value.updates) ||
          value.updates.length !== 1 ||
          !isIncidentUpdate(value.updates[0]) ||
          value.updates[0].incident_id !== attempt.id ||
          value.updates[0].message !== attempt.body.description ||
          value.updates[0].status !== attempt.body.status
        ) {
          throw new Error('invalid incident create response');
        }
        return value;
      }

      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        if (postingIncident || createAttemptBlocked) return;
        hideErr();
        const token = getToken();
        if (!token) {
          showErr('Sign in with a staff admin account before posting an incident.');
          return;
        }
        if (!createAttempt) {
          const fd = new FormData(form);
          const title = (fd.get('title') || '').toString().trim();
          const description = (fd.get('description') || '').toString().trim();
          const severity = (fd.get('severity') || 'major').toString();
          const affectedRaw = (fd.get('affected') || '').toString().trim();
          const affected_components = affectedRaw
            ? affectedRaw
                .split(',')
                .map(function (s) { return s.trim(); })
                .filter(function (s) { return s.length > 0; })
            : [];
          if (!title || !description) {
            showErr('Title + initial update are required.');
            return;
          }
          if (!window.crypto || typeof window.crypto.randomUUID !== 'function') {
            showErr('This browser cannot create a safe incident request id. Use a current browser.');
            return;
          }
          createAttempt = {
            id: 'inc_' + window.crypto.randomUUID(),
            body: {
              title: title,
              description: description,
              severity: severity,
              status: 'investigating',
              affected_components: affected_components,
              public: fd.get('public') === 'on',
              started_at: new Date().toISOString(),
            },
          };
        }
        const attempt = createAttempt;
        postingIncident = true;
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
        submit.textContent = 'Posting…';
        boundedFetch(apiBaseUrl + '/v1/admin/incidents/' + encodeURIComponent(attempt.id), {
          method: 'PUT',
          headers: {
            'content-type': 'application/json',
            authorization: 'Bearer ' + token,
          },
          body: JSON.stringify(attempt.body),
        })
          .then(async function (r) {
            let body;
            try {
              body = await r.json();
            } catch (_) {
              body = null;
            }
            if (r.ok) return parseWriteSuccess(r.status, body, attempt);
            const error = window.driftstackResponseError(r, body || {});
            error.status = r.status;
            error.authoritative = r.status >= 400 && r.status < 500;
            throw error;
          })
          .then(function () {
            // Reload to show the new incident in the open list.
            window.location.reload();
          })
          .catch(function (err) {
            if (err && err.authoritative && err.status !== 409) {
              createAttempt = null;
              showErr(requestErrorMessage(err, 'The incident request was rejected. Correct it and try again.'));
              return;
            }
            if (err && err.status === 409) {
              createAttemptBlocked = true;
              showErr(
                'This request id already belongs to a different incident payload. Reload and inspect the existing incident before taking another action.',
              );
              return;
            }
            showErr(
              'The result was not confirmed. Retry uses the same incident id and exact payload, so it cannot create a duplicate. ' +
                requestErrorMessage(err, ''),
            );
          })
          .finally(function () {
            postingIncident = false;
            submit.disabled = createAttemptBlocked;
            submit.removeAttribute('aria-busy');
            submit.textContent = createAttempt ? 'Retry same request' : 'Post incident';
            if (createAttempt && !createAttemptBlocked) {
              submit.title = 'Retries reuse the same incident id and frozen payload.';
            } else if (createAttemptBlocked) {
              submit.title = 'Reload and inspect the conflicting incident before continuing.';
            } else submit.removeAttribute('title');
          });
      });

      function start() {
        fetchAndRender();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
