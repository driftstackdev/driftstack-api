---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { MOCK_INCIDENTS } from '../../data/mocks.ts';

function fmtIso(iso: string): string {
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const SEVERITY_BADGE: Record<string, string> = {
  minor: 'bg-amber-50 text-amber-700',
  major: 'bg-orange-50 text-orange-700',
  outage: 'bg-red-50 text-red-700',
};

const STATUS_BADGE: Record<string, string> = {
  investigating: 'bg-amber-50 text-amber-700',
  identified: 'bg-blue-50 text-blue-700',
  monitoring: 'bg-indigo-50 text-indigo-700',
  resolved: 'bg-emerald-50 text-emerald-700',
};

const open = MOCK_INCIDENTS.filter((i) => i.status !== 'resolved');
const resolved = MOCK_INCIDENTS.filter((i) => i.status === 'resolved');
---

<AdminLayout title="Incidents">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-8 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Incidents</h1>
        <p class="mt-2 text-sm text-slate-500">
          Manually post and update status-page incidents. Public entries surface on
          status.driftstack.dev within ~60 seconds. Every action audit-logged.
        </p>
      </div>
    </header>

    <!-- New incident form -->
    <section class="dashboard-card mb-10">
      <h2 class="text-lg font-semibold text-slate-900">Post new incident</h2>
      <p class="mt-1 text-sm text-slate-500">
        The first message becomes the initial timeline update. Set status to
        “investigating” unless you’ve already pinned the cause.
      </p>
      <form id="new-incident-form" class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="title">Title</label>
          <input
            id="title"
            name="title"
            type="text"
            required
            placeholder="API server elevated 5xx — eu-west-1"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="description">
            Initial update
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            required
            placeholder="Investigating elevated error rate on /v1/sessions/create after 14:02 UTC deploy."
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
          ></textarea>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="block text-sm font-medium text-slate-700" for="severity">Severity</label>
            <select
              id="severity"
              name="severity"
              class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
            >
              <option value="minor">Minor</option>
              <option value="major" selected>Major</option>
              <option value="outage">Outage</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700" for="affected">
              Affected components
            </label>
            <input
              id="affected"
              name="affected"
              type="text"
              placeholder="api, sessions"
              class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
            />
          </div>
          <div class="flex items-end">
            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
              <input
                id="public"
                name="public"
                type="checkbox"
                checked
                class="rounded border-slate-300 text-oxblood-700 focus:ring-oxblood-700"
              />
              Public on status page
            </label>
          </div>
        </div>
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
          <button
            type="submit"
            class="inline-flex items-center rounded-md bg-oxblood-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-oxblood-800 focus:outline-none focus:ring-2 focus:ring-oxblood-700 focus:ring-offset-2"
          >
            Post incident
          </button>
        </div>
      </form>
    </section>

    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">
      Open ({open.length})
    </h2>
    {
      open.length === 0 ? (
        <div class="dashboard-card text-center text-sm text-slate-500">
          No open incidents. All systems operational.
        </div>
      ) : (
        <ul class="space-y-3">
          {open.map((inc) => (
            <li class="dashboard-card">
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0">
                  <p class="text-base font-medium text-slate-900">{inc.title}</p>
                  <p class="mt-1 font-mono text-xs text-slate-500">{inc.id}</p>
                  <p class="mt-1 text-xs text-slate-500">Started {fmtIso(inc.startedAt)}</p>
                  <p class="mt-3 text-sm text-slate-700">{inc.description}</p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                      SEVERITY_BADGE[inc.severity] ?? '',
                    ]}
                  >
                    {inc.severity}
                  </span>
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                      STATUS_BADGE[inc.status] ?? '',
                    ]}
                  >
                    {inc.status}
                  </span>
                  {!inc.public && (
                    <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-slate-600">
                      private
                    </span>
                  )}
                  <a
                    href={`/incidents/${inc.id}`}
                    class="text-sm text-oxblood-700 hover:underline"
                  >
                    Open
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    {
      resolved.length > 0 && (
        <>
          <h2 class="mb-3 mt-10 text-sm font-semibold uppercase tracking-wide text-slate-500">
            Resolved ({resolved.length})
          </h2>
          <ul class="space-y-3">
            {resolved.map((inc) => (
              <li class="dashboard-card opacity-80">
                <div class="flex items-start justify-between gap-6">
                  <div class="min-w-0">
                    <p class="text-base font-medium text-slate-900">{inc.title}</p>
                    <p class="mt-1 font-mono text-xs text-slate-500">{inc.id}</p>
                    <p class="mt-1 text-xs text-slate-500">
                      {fmtIso(inc.startedAt)} → {inc.resolvedAt ? fmtIso(inc.resolvedAt) : '—'}
                    </p>
                  </div>
                  <a
                    href={`/incidents/${inc.id}`}
                    class="text-sm text-oxblood-700 hover:underline"
                  >
                    Open
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="mt-8 text-xs text-slate-500">
      Posting an incident writes <code>incident.created</code> to the admin audit log.
      Public incidents propagate to status.driftstack.dev (CF Pages mirror) within ~60s
      via Hetzner cron + R2 (V-295c).
    </p>
  </div>

  <script>
    // Progressive enhancement only — wired to live API in V-295c when CF Pages goes up.
    document.getElementById('new-incident-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      // eslint-disable-next-line no-alert
      alert('V-295a admin UI scaffold — POST /v1/admin/incidents wiring lands in V-295c.');
    });
  </script>
</AdminLayout>
