---
import AdminLayout from '../layouts/AdminLayout.astro';
import { resolveApiBaseUrl } from '../lib/api-base-url';

// V-541.B — admin cost dashboard. Static shell + progressive-enhanced
// inline JS that fetches /v1/admin/cost/config (rate card + tier
// thresholds, no usage data) on load, then lets the operator query
// /v1/admin/cost/accounts/:id for a per-account breakdown.
//
// Pre-launch posture: tile values come from the same admin token the
// rest of the admin panel uses (V-100 internal_admin scope). 401/403
// surfaces a banner, not silent failure.

const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Cost">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-cost">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-tk-ink-3">Driftstack admin · staff-only</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-tk-ink">Cost</h1>
     <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
      <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
        Per-account cost estimate for the current billing cycle. Numbers
        come from <code class="font-mono text-xs">/v1/admin/cost/*</code>;
        config tile shows the wired rate card so operators can sanity-check
        the deploy before trusting the dollar numbers.
      </p>
    </header>

    <!-- Config inspector tile -->
    <section class="mb-8 grid gap-4 md:grid-cols-2">
      <div class="dashboard-card">
        <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Rate card (per unit)</p>
        <dl class="mt-4 space-y-3 text-sm" data-field="rate-card">
          {/* 2026-05-24 — skeleton rows for hydrate-state polish. */}
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-32 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-16 animate-pulse rounded bg-slate-200"></div>
          </div>
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-28 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-20 animate-pulse rounded bg-slate-200"></div>
          </div>
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-36 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-12 animate-pulse rounded bg-slate-200"></div>
          </div>
        </dl>
      </div>
      <div class="dashboard-card">
        <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Tier thresholds</p>
        <dl class="mt-4 space-y-3 text-sm" data-field="tier-thresholds">
          {/* 2026-05-24 — skeleton rows for hydrate-state polish. */}
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-24 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-20 animate-pulse rounded bg-slate-200"></div>
          </div>
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-32 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-16 animate-pulse rounded bg-slate-200"></div>
          </div>
        </dl>
      </div>
    </section>

    {/* 2026-05-23 — icon header on cost sections. */}
    <!-- Per-account query -->
    <section class="mb-6">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4" />
            <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
          </svg>
        </span>
        Per-account breakdown
      </h2>
      <form
        data-form="account-query"
        class="mt-3 flex flex-wrap items-end gap-3"
      >
        <label class="flex flex-col text-sm">
          <span class="text-tk-ink-2">Account ID</span>
          <input
            type="text"
            name="account_id"
            disabled
            aria-disabled="true"
            title="Available after live cost configuration loads."
            placeholder="acc_… or raw UUID"
            class="mt-1 w-72 rounded-md border border-tk-border px-3 py-2 font-mono text-xs shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent disabled:cursor-not-allowed disabled:bg-tk-hover disabled:text-tk-ink-3"
            required
          />
        </label>
        <label class="flex flex-col text-sm">
          <span class="text-tk-ink-2">Billing cycle</span>
          <input
            type="text"
            name="billing_cycle"
            disabled
            aria-disabled="true"
            title="Available after live cost configuration loads."
            placeholder="YYYY-MM (default current)"
            class="mt-1 w-44 rounded-md border border-tk-border px-3 py-2 font-mono text-xs shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent disabled:cursor-not-allowed disabled:bg-tk-hover disabled:text-tk-ink-3"
          />
        </label>
        <button
          type="submit"
          disabled
          aria-disabled="true"
          title="Available after live cost configuration loads."
          class="rounded-md bg-tk-accent px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-tk-accent-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          Query
        </button>
      </form>
      <div
        data-field="account-result"
        class="mt-6 hidden dashboard-card"
      >
      </div>
    </section>

    <!-- Top accounts by cost -->
    <section class="mb-6">
      <div class="flex items-end justify-between gap-3">
        <div>
          <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
              </svg>
            </span>
            Top accounts by cost
          </h2>
          <p class="mt-1 text-sm text-tk-ink-3">
            Top by total cents among the most recent
            <code class="font-mono text-xs">limit=50</code> accounts (by
            creation order) — not the platform-wide top spenders. Fetches that
            page then asks <code class="font-mono text-xs">/v1/admin/cost/overview</code>
            to sort it by total cost desc. Accounts outside that page are not
            included; use the per-account breakdown above for a specific account.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            data-button="export-top-csv"
            disabled
            aria-disabled="true"
            class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-sm shadow-sm hover:bg-tk-bg disabled:cursor-not-allowed disabled:text-tk-ink-3"
            title="Available after a live top-accounts table loads."
          >
            Export CSV
          </button>
          <button
            type="button"
            data-button="refresh-top"
            disabled
            aria-disabled="true"
            title="Available after live cost configuration loads."
            class="rounded-md border border-tk-border bg-tk-surface px-3 py-1.5 text-sm shadow-sm hover:bg-tk-bg disabled:cursor-not-allowed disabled:text-tk-ink-3"
          >
            Refresh
          </button>
        </div>
      </div>
      <div
        data-field="top-result"
        class="mt-4 dashboard-card"
      >
        <p class="text-sm text-tk-ink-3">
          Live top accounts are unavailable until cost configuration loads.
        </p>
      </div>
    </section>

    <p class="mt-12 text-xs text-tk-ink-3">
      Endpoints consumed:
      <code class="font-mono">{apiBaseUrl}/v1/admin/cost/config</code>,
      <code class="font-mono">{apiBaseUrl}/v1/admin/cost/accounts/:id</code>,
      <code class="font-mono">{apiBaseUrl}/v1/admin/cost/overview</code>,
      <code class="font-mono">{apiBaseUrl}/v1/admin/accounts</code>.
    </p>
  </div>
</AdminLayout>

<script is:inline define:vars={{ apiBaseUrl }}>
  const root = document.querySelector('[data-page="admin-cost"]');
  if (!root) throw new Error('admin-cost root missing');
  const banner = root.querySelector('[data-banner]');
  const rateCard = root.querySelector('[data-field="rate-card"]');
  const tierThresholds = root.querySelector('[data-field="tier-thresholds"]');
  const accountForm = root.querySelector('[data-form="account-query"]');
  const accountResult = root.querySelector('[data-field="account-result"]');
  const accountSubmitBtn = accountForm?.querySelector('button[type="submit"]');
  const accountInputs = accountForm ? Array.from(accountForm.querySelectorAll('input')) : [];
  const topResult = root.querySelector('[data-field="top-result"]');
  const refreshTopBtn = root.querySelector('[data-button="refresh-top"]');
  const exportCsvBtn = root.querySelector('[data-button="export-top-csv"]');
  const COST_REQUEST_TIMEOUT_MS = 15_000;
  let costDataAvailable = false;
  let topAccountsAvailable = false;
  let topAccountsLoading = false;
  let accountQueryLoading = false;

  function showBanner(msg) {
    if (!banner) return;
    banner.textContent = msg;
    banner.classList.remove('hidden');
  }

  function adminToken() {
    try {
      return globalThis.localStorage?.getItem('ds_web_session_token') ?? '';
    } catch (_) {
      return '';
    }
  }

  async function authedFetch(path, init = {}) {
    const token = adminToken();
    if (!token) {
      showBanner(
        'No admin token found. Sign in with a staff admin account via the dashboard (app.driftstack.dev) — the SSO bridge stores it in localStorage as "ds_web_session_token".',
      );
      throw new Error('no admin token');
    }
    return window.driftstackFetchWithDeadline(
      apiBaseUrl + path,
      {
        ...init,
        headers: { ...(init.headers ?? {}), authorization: 'Bearer ' + token },
      },
      COST_REQUEST_TIMEOUT_MS,
    );
  }

  function requestErrorMessage(err, fallback) {
    return window.driftstackRequestErrorMessage(err, fallback);
  }

  function responseErrorMessage(response, fallback) {
    return requestErrorMessage(new Error('HTTP ' + response.status), fallback);
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
    );
  }

  function syncAccountQueryAuthority(reason) {
    const unavailableReason = reason || 'Available after live cost configuration loads.';
    accountInputs.forEach((input) => {
      input.disabled = !costDataAvailable;
      input.setAttribute('aria-disabled', costDataAvailable ? 'false' : 'true');
      if (costDataAvailable) input.removeAttribute('title');
      else input.title = unavailableReason;
    });
    if (accountSubmitBtn) {
      const disabled = !costDataAvailable || accountQueryLoading;
      accountSubmitBtn.disabled = disabled;
      accountSubmitBtn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
      if (!costDataAvailable) accountSubmitBtn.title = unavailableReason;
      else if (accountQueryLoading) {
        accountSubmitBtn.title = 'Wait for the current cost query to finish.';
      } else accountSubmitBtn.removeAttribute('title');
    }
  }

  function syncTopAuthority(reason) {
    const unavailableReason = reason || 'Available after live cost configuration loads.';
    if (refreshTopBtn) {
      const disabled = !costDataAvailable || topAccountsLoading;
      refreshTopBtn.disabled = disabled;
      refreshTopBtn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
      if (!costDataAvailable) refreshTopBtn.title = unavailableReason;
      else if (topAccountsLoading) {
        refreshTopBtn.title = 'Wait for the current top-accounts query to finish.';
      } else refreshTopBtn.removeAttribute('title');
    }
    if (exportCsvBtn) {
      exportCsvBtn.disabled = !topAccountsAvailable;
      exportCsvBtn.setAttribute('aria-disabled', topAccountsAvailable ? 'false' : 'true');
      exportCsvBtn.title = topAccountsAvailable
        ? 'Download the currently-rendered top-accounts table as CSV'
        : 'Available after a live top-accounts table loads.';
    }
  }

  function setCostDataAuthority(available, reason) {
    costDataAvailable = available;
    if (!available) topAccountsAvailable = false;
    syncAccountQueryAuthority(reason);
    syncTopAuthority(reason);
    if (topResult && !topAccountsAvailable && !topAccountsLoading) {
      topResult.innerHTML = available
        ? '<p class="text-sm text-tk-ink-3">Click Refresh to fetch the top accounts.</p>'
        : '<p class="text-sm text-tk-ink-3">Live top accounts are unavailable until cost configuration loads.</p>';
    }
  }

  function renderAccountUnavailable(message) {
    if (!accountResult) return;
    accountResult.classList.remove('hidden');
    accountResult.innerHTML = `<p class="text-sm text-tk-ink-3">${escapeHtml(message)}</p>`;
  }

  function renderRateCard(rates) {
    if (!rateCard) return;
    const entries = [
      ['Compute', 'computeCentsPerMinute', 'cents / minute'],
      ['Storage', 'storageCentsPerGbMonth', 'cents / GB-month'],
      ['Egress', 'egressCentsPerGb', 'cents / GB'],
      ['Email', 'emailCentsPerSend', 'cents / send'],
      ['LLM (input)', 'llmCentsPer1kInputTokens', 'cents / 1k tokens'],
      ['LLM (output)', 'llmCentsPer1kOutputTokens', 'cents / 1k tokens'],
    ];
    rateCard.innerHTML = entries
      .map(
        ([label, key, unit]) =>
          `<div class="flex justify-between gap-4"><dt class="text-tk-ink-2">${escapeHtml(label)}</dt><dd class="font-mono text-xs text-tk-ink">${escapeHtml(String(rates[key] ?? '—'))} <span class="text-tk-ink-3">${escapeHtml(unit)}</span></dd></div>`,
      )
      .join('');
  }

  function renderTierThresholds(tiers) {
    if (!tierThresholds) return;
    const rows = Object.entries(tiers ?? {}).map(
      // GET /v1/admin/cost/config returns `{ softCents, hardCents }`
      // per AlertThresholds in lib/cost-estimator.ts. Reading
      // `softWarningCents` / `hardCapCents` (a previous field-name
      // guess) silently rendered every tier as "$0.00".
      ([tier, t]) =>
        `<div class="flex justify-between gap-4"><dt class="text-tk-ink-2">${escapeHtml(tier)}</dt><dd class="font-mono text-xs text-tk-ink">soft $${((t.softCents ?? 0) / 100).toFixed(2)} · hard $${((t.hardCents ?? 0) / 100).toFixed(2)}</dd></div>`,
    );
    tierThresholds.innerHTML =
      rows.length > 0
        ? rows.join('')
        : '<div class="text-tk-ink-3">No tier thresholds configured.</div>';
  }

  function renderAccountSummary(body) {
    if (!accountResult) return;
    const cents = (n) => '$' + (Number(n ?? 0) / 100).toFixed(2);
    // GET /v1/admin/cost/accounts/:id returns CostMonitoringAccountSummary
    // (cost-monitoring.ts):
    //   { account_id, billing_cycle, breakdown: CostBreakdown,
    //     tier, thresholds: { softCents, hardCents } }
    // where breakdown carries computeCents / storageCents / egressCents /
    // emailCents / llmCents / totalCents / thresholdState.
    // Previous reads used camelCase + a non-existent `estimated` /
    // `softWarningCents` / `hardCapCents` / root-level `thresholdState`
    // shape, silently rendering every value as "$0.00" or "—".
    const breakdown = body.breakdown ?? body.estimated ?? {};
    const thresholds = body.thresholds ?? {};
    // Sub-processor row sums email (Postmark) + LLM (Anthropic) costs,
    // matching what CostBreakdown carries. The old `subprocessorCents`
    // field never existed on the wire.
    const subprocessorCents =
      Number(breakdown.emailCents ?? 0) + Number(breakdown.llmCents ?? 0);
    accountResult.classList.remove('hidden');
    // 2026-05-22 — visual breakdown. Per-dimension horizontal bars
    // sized by share of total + threshold-state coloring. Pure HTML/
    // CSS — no chart lib dependency. Bars sized by inline width
    // percentage; minimum 4% so a $0.01 dimension still renders a
    // visible sliver.
    const total = Math.max(1, Number(breakdown.totalCents ?? 0));
    function bar(label, value) {
      const v = Number(value ?? 0);
      const pct = Math.max(4, Math.round((v / total) * 100));
      return (
        '<div class="flex items-center gap-3 text-xs">' +
        `<span class="w-24 shrink-0 text-tk-ink-2">${escapeHtml(label)}</span>` +
        '<div class="flex-1 h-4 rounded-full bg-tk-hover overflow-hidden">' +
        `<div class="h-full bg-tk-accent/70" style="width: ${pct.toString()}%"></div>` +
        '</div>' +
        `<span class="font-mono w-20 text-right text-tk-ink">${cents(v)}</span>` +
        '</div>'
      );
    }
    const STATE_BADGE = {
      'under-soft': 'bg-emerald-100 text-emerald-800',
      'between-soft-and-hard': 'bg-amber-100 text-amber-800',
      'over-hard': 'bg-rose-100 text-rose-800',
    };
    const stateClass =
      STATE_BADGE[breakdown.thresholdState] || 'bg-tk-hover text-tk-ink-2';
    accountResult.innerHTML =
      '<div class="space-y-4">' +
      `<p class="font-mono text-xs text-tk-ink-3">account_id: ${escapeHtml(body.account_id ?? body.accountId ?? '—')} · cycle: ${escapeHtml(body.billing_cycle ?? body.billingCycle ?? '—')} · tier: ${escapeHtml(body.tier ?? '—')}</p>` +
      '<div class="flex items-baseline justify-between">' +
      `<p class="text-2xl font-semibold text-tk-ink">${cents(breakdown.totalCents)}</p>` +
      `<span class="inline-flex items-center rounded-full ${stateClass} px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide">${escapeHtml(breakdown.thresholdState ?? '—')}</span>` +
      '</div>' +
      '<div class="space-y-2">' +
      bar('Compute', breakdown.computeCents) +
      bar('Storage', breakdown.storageCents) +
      bar('Egress', breakdown.egressCents) +
      bar('Sub-processor', subprocessorCents) +
      '</div>' +
      `<p class="text-xs text-tk-ink-3">Soft warn ${cents(thresholds.softCents)} · hard cap ${cents(thresholds.hardCents)}</p>` +
      '</div>';
  }

  // audit waefer6wu — on any config-fetch failure (missing/expired token,
  // non-2xx, network error) the Rate Card / Tier Thresholds tiles were left
  // exactly as SSG-rendered: pulsing `animate-pulse` skeleton bars, forever,
  // since renderRateCard()/renderTierThresholds() were the ONLY code that
  // ever touched those two elements and neither failure branch called them.
  // showConfigError() clears the skeleton to an explicit error message so
  // the tiles don't look perpetually "still loading" when the page is
  // actually erroring.
  function showConfigError(msg) {
    const text = `<p class="text-sm text-red-600">${escapeHtml(msg)}</p>`;
    if (rateCard) rateCard.innerHTML = text;
    if (tierThresholds) tierThresholds.innerHTML = text;
  }

  async function loadConfig() {
    try {
      const res = await authedFetch('/v1/admin/cost/config');
      if (!res.ok) {
        const msg = responseErrorMessage(
          res,
          'Could not load cost configuration. Try again.',
        );
        showBanner(msg);
        showConfigError(msg);
        return false;
      }
      const body = await res.json();
      renderRateCard(body.rates ?? {});
      // GET /v1/admin/cost/config returns `{ rates, tierThresholds }`
      // per CostMonitoringService.getConfig(). Reading `body.tiers`
      // (the previous field-name guess) always resolved to undefined,
      // so the "No tier thresholds configured" empty-state rendered
      // every time — masking the actual per-tier table from
      // admin/ops visibility. Same field-drift class as the
      // softWarningCents → softCents fix.
      renderTierThresholds(body.tierThresholds ?? body.tiers ?? {});
      return true;
    } catch (err) {
      const msg = requestErrorMessage(err, 'Could not load cost configuration. Try again.');
      showBanner(msg);
      showConfigError(msg);
      return false;
    }
  }

  function renderTopAccounts(rows) {
    if (!topResult) return;
    const cents = (n) => '$' + (Number(n ?? 0) / 100).toFixed(2);
    if (!Array.isArray(rows) || rows.length === 0) {
      topAccountsAvailable = false;
      syncTopAuthority();
      topResult.innerHTML = '<p class="text-sm text-tk-ink-3">No accounts with usage in the current cycle.</p>';
      return;
    }
    const top = rows.slice(0, 10);
    // Same field-rename invariant as renderAccountSummary above.
    // Each row is a CostMonitoringAccountSummary; thresholds live
    // under `thresholds.softCents` / `thresholds.hardCents` and the
    // breakdown carries `thresholdState`.
    topResult.innerHTML =
      '<table class="w-full text-sm">' +
      '<thead><tr class="text-left text-xs uppercase tracking-widest text-tk-ink-3"><th class="py-1">Account</th><th>Tier</th><th class="text-right">Total</th><th class="text-right">Soft warn</th><th class="text-right">Hard cap</th><th>State</th></tr></thead>' +
      '<tbody>' +
      top
        .map((r) => {
          const breakdown = r.breakdown ?? r.estimated ?? {};
          const thresholds = r.thresholds ?? {};
          return (
            `<tr class="border-t border-slate-100">` +
            `<td class="py-2 font-mono text-xs">${escapeHtml(r.account_id ?? r.accountId ?? '—')}</td>` +
            `<td class="text-xs">${escapeHtml(r.tier ?? '—')}</td>` +
            `<td class="text-right font-mono text-xs">${cents(breakdown.totalCents)}</td>` +
            `<td class="text-right font-mono text-xs">${cents(thresholds.softCents)}</td>` +
            `<td class="text-right font-mono text-xs">${cents(thresholds.hardCents)}</td>` +
            `<td class="text-xs">${escapeHtml(breakdown.thresholdState ?? '—')}</td>` +
            `</tr>`
          );
        })
        .join('') +
      '</tbody></table>';
    topAccountsAvailable = true;
    syncTopAuthority();
  }

  async function loadTopAccounts() {
    if (!costDataAvailable || !topResult || topAccountsLoading) return;
    topAccountsLoading = true;
    topAccountsAvailable = false;
    syncTopAuthority();
    if (refreshTopBtn) {
      refreshTopBtn.setAttribute('aria-busy', 'true');
      refreshTopBtn.textContent = 'Refreshing…';
    }
    topResult.innerHTML = '<p class="text-sm text-tk-ink-3">Loading…</p>';
    try {
      // Step 1 — pull first 50 accounts.
      const accountsRes = await authedFetch('/v1/admin/accounts?limit=50');
      if (!accountsRes.ok) {
        const msg = responseErrorMessage(
          accountsRes,
          'Could not load the account list. Try again.',
        );
        topResult.innerHTML = `<p class="text-sm text-red-600">${escapeHtml(msg)}</p>`;
        return;
      }
      const accountsBody = await accountsRes.json();
      const ids = (accountsBody.data ?? [])
        .map((a) => (a.id ?? '').startsWith('acc_') ? (a.id ?? '').slice(4) : a.id)
        .filter(Boolean);
      if (ids.length === 0) {
        topResult.innerHTML = '<p class="text-sm text-tk-ink-3">No accounts found.</p>';
        return;
      }
      // Step 2 — overview is already sorted by total cost desc.
      const overviewRes = await authedFetch(
        '/v1/admin/cost/overview?account_ids=' + encodeURIComponent(ids.join(',')),
      );
      if (!overviewRes.ok) {
        const msg = responseErrorMessage(
          overviewRes,
          'Could not load cost totals. Try again.',
        );
        topResult.innerHTML = `<p class="text-sm text-red-600">${escapeHtml(msg)}</p>`;
        return;
      }
      const overviewBody = await overviewRes.json();
      renderTopAccounts(overviewBody.summaries ?? []);
    } catch (err) {
      const msg = requestErrorMessage(err, 'Could not load top accounts. Try again.');
      topResult.innerHTML = `<p class="text-sm text-red-600">${escapeHtml(msg)}</p>`;
    } finally {
      topAccountsLoading = false;
      syncTopAuthority();
      if (refreshTopBtn) {
        refreshTopBtn.setAttribute('aria-busy', 'false');
        refreshTopBtn.textContent = 'Refresh';
      }
    }
  }

  if (refreshTopBtn) {
    refreshTopBtn.addEventListener('click', () => {
      void loadTopAccounts();
    });
  }

  // 2026-05-22 — CSV export of the top-accounts table. Reads the
  // rendered DOM table (so it always matches what the operator
  // sees on-screen) + downloads as a timestamped file. Survives
  // pagination since the page only shows 50 accounts anyway.
  if (exportCsvBtn) {
    exportCsvBtn.addEventListener('click', () => {
      if (!topAccountsAvailable) return;
      if (!topResult) return;
      const table = topResult.querySelector('table');
      if (!table) {
        showBanner('Top-accounts table not loaded yet. Click Refresh first.');
        return;
      }
      const rows = Array.from(table.querySelectorAll('tr'));
      const csv = rows
        .map((tr) =>
          Array.from(tr.querySelectorAll('th, td'))
            .map((cell) => {
              const text = cell.textContent ?? '';
              // RFC 4180 quoting: wrap in quotes, double internal quotes.
              return '"' + text.replace(/"/g, '""') + '"';
            })
            .join(','),
        )
        .join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const ts = new Date().toISOString().slice(0, 10);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'driftstack-top-accounts-' + ts + '.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  if (accountForm) {
    accountForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!costDataAvailable || accountQueryLoading) return;
      const fd = new FormData(accountForm);
      const rawInput = String(fd.get('account_id') ?? '').trim();
      // Strip the public 'acc_' prefix if present — the cost endpoint
      // expects raw UUIDs (the operator typically pastes from the
      // /accounts admin page which surfaces 'acc_<uuid>').
      const accountId = rawInput.startsWith('acc_') ? rawInput.slice(4) : rawInput;
      const billingCycle = String(fd.get('billing_cycle') ?? '').trim();
      if (!accountId) return;
      accountQueryLoading = true;
      syncAccountQueryAuthority();
      accountForm.setAttribute('aria-busy', 'true');
      if (accountSubmitBtn) {
        accountSubmitBtn.textContent = 'Querying…';
      }
      renderAccountUnavailable('Loading the current account cost…');
      try {
        const qs = billingCycle ? `?billing_cycle=${encodeURIComponent(billingCycle)}` : '';
        const res = await authedFetch(
          `/v1/admin/cost/accounts/${encodeURIComponent(accountId)}${qs}`,
        );
        if (res.status === 404) {
          // audit waefer6wu — GET /v1/admin/cost/accounts/:id 404s for TWO
          // distinct server-side cases that collapse to the identical
          // message: a real account with zero usage this cycle, OR an
          // account id that doesn't exist at all (e.g. an operator
          // fat-fingering a UUID while triaging a billing dispute). A
          // typo'd id reading as "confirmed zero usage" can feed a wrong
          // support conclusion. Disambiguate client-side with the same
          // existence check accounts/[id].astro already does — GET
          // /v1/admin/accounts/:id — without touching the cost route.
          accountResult?.classList.add('hidden');
          try {
            const existsRes = await authedFetch(
              `/v1/admin/accounts/${encodeURIComponent('acc_' + accountId)}`,
            );
            if (existsRes.status === 404) {
              showBanner(`Account acc_${accountId} not found — check the id.`);
            } else if (existsRes.ok) {
              showBanner('Account exists but has no usage in the requested cycle.');
            } else {
              showBanner(
                responseErrorMessage(
                  existsRes,
                  'Could not verify whether this account exists. Try again.',
                ),
              );
            }
          } catch (existErr) {
            showBanner(
              requestErrorMessage(
                existErr,
                'Could not verify whether this account exists. Try again.',
              ),
            );
          }
          return;
        }
        if (!res.ok) {
          const msg = responseErrorMessage(res, 'Could not load account cost. Try again.');
          showBanner(msg);
          renderAccountUnavailable(
            'Could not load the current account cost. Check the error above and retry.',
          );
          return;
        }
        const body = await res.json();
        renderAccountSummary(body);
      } catch (err) {
        const msg = requestErrorMessage(err, 'Could not load account cost. Try again.');
        showBanner(msg);
        renderAccountUnavailable(
          'Could not load the current account cost. Check the error above and retry.',
        );
      } finally {
        accountQueryLoading = false;
        syncAccountQueryAuthority();
        accountForm.setAttribute('aria-busy', 'false');
        if (accountSubmitBtn) {
          accountSubmitBtn.textContent = 'Query';
        }
      }
    });
  }

  function start() {
    void loadConfig()
      .then((loaded) => {
        setCostDataAuthority(loaded, 'Available after live cost configuration loads.');
      })
      .finally(() => {
        // 2026-05-21 — AdminLayout opacity-gate signal.
        if (typeof window.dashboardHydrated === 'function') {
          window.dashboardHydrated();
        }
      });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
