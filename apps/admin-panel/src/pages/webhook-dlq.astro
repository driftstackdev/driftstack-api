---
import AdminLayout from '../layouts/AdminLayout.astro';

interface MockDlqEntry {
  id: string;
  webhookId: string;
  webhookUrl: string;
  accountEmail: string;
  eventType: string;
  attempts: number;
  lastError: string;
  ageHours: number;
}

const MOCK_DLQ: MockDlqEntry[] = [
  {
    id: 'wdl_00000000-0000-4000-8000-0000000000d1',
    webhookId: 'whk_00000000-0000-4000-8000-0000000000a1',
    webhookUrl: 'https://hooks.example.test/driftstack',
    accountEmail: 'tester@driftstack.local',
    eventType: 'session.completed',
    attempts: 6,
    lastError: 'connect ECONNREFUSED — endpoint unreachable',
    ageHours: 14,
  },
];
---

<AdminLayout title="Webhook DLQ">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Webhook DLQ</h1>
      <p class="mt-2 max-w-prose text-sm text-slate-500">
        Deliveries that exhausted the retry budget (5×). Manual intervention
        only — auto-retry past the initial attempts is intentionally absent
        to avoid storm-on-recovery patterns.
      </p>
    </header>

    {
      MOCK_DLQ.length === 0 ? (
        <div class="dashboard-card text-center">
          <h2 class="text-lg font-semibold text-slate-900">DLQ empty</h2>
          <p class="mx-auto mt-2 max-w-prose text-sm text-slate-500">
            No deliveries have exhausted the retry budget. Healthy posture —
            customer endpoints are reachable + responding.
          </p>
        </div>
      ) : (
        <>
          <div class="mb-6 flex items-center justify-between gap-4">
            <p class="text-sm text-slate-700">
              <strong class="font-medium text-red-700">
                {MOCK_DLQ.length.toString()} entr{MOCK_DLQ.length === 1 ? 'y' : 'ies'}
              </strong>{' '}
              · oldest {Math.max(...MOCK_DLQ.map((e) => e.ageHours)).toString()}h
            </p>
            <a href="#requeue-all" class="btn-secondary text-sm">
              Requeue all
            </a>
          </div>

          <ul class="space-y-3">
            {MOCK_DLQ.map((entry) => (
              <li class="rounded-lg border border-red-200 bg-red-50 p-5">
                <div class="flex items-start justify-between gap-6">
                  <div class="min-w-0">
                    <p class="font-mono text-xs text-slate-700">{entry.id}</p>
                    <p class="mt-2 truncate font-mono text-sm text-slate-900">
                      {entry.webhookUrl}
                    </p>
                    <p class="mt-1 text-xs text-slate-700">
                      Customer: {entry.accountEmail}
                    </p>
                    <p class="mt-2">
                      <code class="font-mono text-xs text-oxblood-700">
                        {entry.eventType}
                      </code>
                    </p>
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-2">
                    <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-red-800">
                      DLQ · {entry.attempts}× tried
                    </span>
                    <p class="text-xs text-red-800">{entry.ageHours}h ago</p>
                  </div>
                </div>

                <div class="mt-4 rounded border border-red-200 bg-white px-3 py-2">
                  <p class="font-mono text-xs text-red-900">{entry.lastError}</p>
                </div>

                <div class="mt-4 flex flex-wrap gap-3">
                  <a
                    href={`#requeue-${entry.id}`}
                    class="text-sm font-medium text-oxblood-700 hover:underline"
                  >
                    Requeue
                  </a>
                  <a
                    href={`#payload-${entry.id}`}
                    class="text-sm text-slate-600 hover:underline"
                  >
                    View payload
                  </a>
                  <a
                    href={`#discard-${entry.id}`}
                    class="text-sm text-red-700 hover:underline"
                  >
                    Discard
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="mt-8 text-xs text-slate-500">
      Requeue fires <code class="font-mono">POST /v1/admin/webhook-dlq/:id/requeue</code> —
      delivery resets to attempt=1 + retry budget refreshes. Audit row records
      admin id + delivery id + reason. Discard hard-deletes the entry; payload
      is unrecoverable.
    </p>
  </div>
</AdminLayout>
