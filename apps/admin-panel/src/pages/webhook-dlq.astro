---
import AdminLayout from '../layouts/AdminLayout.astro';

// V-189 — progressive-enhancement against /v1/admin/webhook-dlq. SSG
// renders a single mock entry; an inline <script> fetches the live
// list, replaces the body, and wires Requeue (POST
// /v1/admin/webhook-dlq/:id/requeue). Account email + webhook URL
// aren't part of the DLQ delivery shape today (would need a join in
// WebhooksAdminService.listDlq), so the live view shows webhook id +
// event id; enriched display lands as a separate slice once the
// endpoint exposes owner+url.

interface MockDlqEntry {
  id: string;
  webhookId: string;
  webhookUrl: string;
  accountEmail: string;
  eventType: string;
  attempts: number;
  lastError: string;
  ageHours: number;
}

const MOCK_DLQ: MockDlqEntry[] = [
  {
    id: 'wdl_00000000-0000-4000-8000-0000000000d1',
    webhookId: 'whk_00000000-0000-4000-8000-0000000000a1',
    webhookUrl: 'https://hooks.example.test/driftstack',
    accountEmail: 'tester@driftstack.local',
    eventType: 'session.completed',
    attempts: 6,
    lastError: 'connect ECONNREFUSED — endpoint unreachable',
    ageHours: 14,
  },
];

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Webhook DLQ">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-dlq">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Webhook DLQ</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Deliveries that exhausted the retry budget (5×). Manual intervention
          only — auto-retry past the initial attempts is intentionally absent
          to avoid storm-on-recovery patterns.
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. New DLQ entries surface every
          30s without F5 (so staff don't miss a deliverability spike). */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-emerald-500"
          ></span>
          <span>Live · updated <span data-live-age>just now</span></span>
        </span>
        <button
          type="button"
          data-live-refresh
          class="text-tk-accent hover:underline"
        >
          Refresh now
        </button>
      </div>
    </header>

    {/* 2026-05-23 — icon on healthy DLQ empty state. */}
    <div class="hidden" data-region="empty">
      <div class="dashboard-card text-center">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-emerald-50 ring-1 ring-emerald-200 text-emerald-700">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold tracking-tight text-tk-ink">DLQ empty</h2>
        <p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">
          No deliveries have exhausted the retry budget. Healthy posture —
          customer endpoints are reachable + responding.
        </p>
      </div>
    </div>

    <div data-region="list">
      <div class="mb-6 flex items-center justify-between gap-4">
        <p class="text-sm text-tk-ink-2">
          <strong class="font-medium text-red-700" data-field="summary">
            {MOCK_DLQ.length.toString()} entr{MOCK_DLQ.length === 1 ? 'y' : 'ies'}
          </strong>
        </p>
      </div>

      <ul class="space-y-3" data-list="dlq">
        {
          MOCK_DLQ.map((entry) => (
            <li class="rounded-lg border border-red-200 bg-red-50 p-5">
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0">
                  <p class="font-mono text-xs text-tk-ink-2">{entry.id}</p>
                  <p class="mt-2 truncate font-mono text-sm text-tk-ink">
                    {entry.webhookUrl}
                  </p>
                  <p class="mt-1 text-xs text-tk-ink-2">Customer: {entry.accountEmail}</p>
                  <p class="mt-2">
                    <code class="font-mono text-xs text-tk-accent">{entry.eventType}</code>
                  </p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-red-800">
                    DLQ · {entry.attempts}× tried
                  </span>
                  <p class="text-xs text-red-800">{entry.ageHours}h ago</p>
                </div>
              </div>

              <div class="mt-4 rounded border border-red-200 bg-tk-surface px-3 py-2">
                <p class="font-mono text-xs text-red-900">{entry.lastError}</p>
              </div>

              <div class="mt-4 flex flex-wrap gap-3">
                <button
                  type="button"
                  data-action="requeue"
                  data-id={entry.id}
                  class="text-sm font-medium text-tk-accent hover:underline"
                >
                  Requeue
                </button>
                {/* 2026-05-22 — hard-delete; payload irrecoverable. Confirm()
                    in the handler protects against fat-fingered clicks. */}
                <button
                  type="button"
                  data-action="discard"
                  data-id={entry.id}
                  class="text-sm font-medium text-rose-700 hover:underline"
                >
                  Discard
                </button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-8 text-xs text-tk-ink-3">
      Requeue fires <code class="font-mono">POST /v1/admin/webhook-dlq/:id/requeue</code> —
      delivery resets to attempt=1 + retry budget refreshes. Audit row records
      admin id + delivery id + reason. Discard hard-deletes the entry; payload
      is unrecoverable.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-dlq"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list="dlq"]');
      const summary = root.querySelector('[data-field="summary"]');
      const listRegion = root.querySelector('[data-region="list"]');
      const emptyRegion = root.querySelector('[data-region="empty"]');
      const token = localStorage.getItem('ds_web_session_token');
      const DLQ_TIMEOUT_MS = 15_000;
      let loadController = null;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, DLQ_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      // On a failed requeue/discard, surface the server's problem+json
      // `detail` (W151/W152) so the operator sees why — e.g. "Delivery
      // already discarded" / "already requeued" when another operator
      // beat them to it — instead of a bare "HTTP 409". The load fetch
      // keeps its own graceful "couldn't load" fallback.
      function mutationError(r) {
        return r
          .json()
          .catch(() => ({}))
          .then((b) => Promise.reject(window.driftstackResponseError(r, b)));
      }
      // Keep the action + phase, not only membership. Auto/manual refreshes
      // rebuild the row DOM while a slow mutation may still be pending; the
      // renderer uses this state to preserve the disabled/busy controls.
      const pendingMutations = new Map();
      function setEntryBusy(id, action, busy, pendingLabel) {
        if (busy) pendingMutations.set(id, { action: action, label: pendingLabel });
        else pendingMutations.delete(id);
        if (!list) return;
        list.querySelectorAll('button[data-id]').forEach(function (button) {
          if (button.getAttribute('data-id') !== id) return;
          if (!button.hasAttribute('data-idle-label')) {
            button.setAttribute('data-idle-label', button.textContent || '');
          }
          button.disabled = busy;
          if (busy && button.getAttribute('data-action') === action) {
            button.textContent = pendingLabel;
            button.setAttribute('aria-busy', 'true');
          } else {
            button.textContent = button.getAttribute('data-idle-label') || button.textContent;
            button.removeAttribute('aria-busy');
          }
        });
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function ageStr(createdAt) {
        if (!createdAt) return '—';
        const ms = Date.now() - new Date(createdAt).getTime();
        if (ms < 0) return '—';
        const min = Math.floor(ms / 60000);
        if (min < 60) return min + 'm ago';
        const hr = Math.floor(min / 60);
        if (hr < 48) return hr + 'h ago';
        const days = Math.floor(hr / 24);
        return days + 'd ago';
      }

      function rowHtml(d) {
        const pending = pendingMutations.get(d.id);
        const controlsDisabled = pending ? ' disabled' : '';
        const requeueBusy = pending && pending.action === 'requeue' ? ' aria-busy="true"' : '';
        const discardBusy = pending && pending.action === 'discard' ? ' aria-busy="true"' : '';
        const requeueLabel = pending && pending.action === 'requeue' ? pending.label : 'Requeue';
        const discardLabel = pending && pending.action === 'discard' ? pending.label : 'Discard';
        const errorBlock = d.last_error
          ? '<div class="mt-4 rounded border border-red-200 bg-tk-surface px-3 py-2"><p class="font-mono text-xs text-red-900">' +
            escapeHtml(d.last_error) +
            '</p></div>'
          : '';
        const respLine =
          d.last_response_status !== null && d.last_response_status !== undefined
            ? '<p class="mt-1 text-xs text-tk-ink-2">Last HTTP ' +
              escapeHtml(String(d.last_response_status)) +
              '</p>'
            : '';
        return (
          '<li class="rounded-lg border border-red-200 bg-red-50 p-5">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<p class="font-mono text-xs text-tk-ink-2">' +
          escapeHtml(d.id) +
          '</p>' +
          '<p class="mt-2 truncate font-mono text-sm text-tk-ink">' +
          escapeHtml(d.webhook_id) +
          '</p>' +
          '<p class="mt-1 text-xs text-tk-ink-2">Event: ' +
          escapeHtml(d.event_id) +
          '</p>' +
          respLine +
          '<p class="mt-2"><code class="font-mono text-xs text-tk-accent">' +
          escapeHtml(d.event_type) +
          '</code></p>' +
          '</div>' +
          '<div class="flex shrink-0 flex-col items-end gap-2">' +
          '<span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-red-800">DLQ · ' +
          escapeHtml(String(d.attempts)) +
          '× tried</span>' +
          '<p class="text-xs text-red-800">' +
          escapeHtml(ageStr(d.created_at)) +
          '</p></div></div>' +
          errorBlock +
          '<div class="mt-4 flex flex-wrap gap-3">' +
          '<button type="button" data-action="requeue" data-id="' +
          escapeHtml(d.id) +
          '"' +
          controlsDisabled +
          requeueBusy +
          ' class="text-sm font-medium text-tk-accent hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-50">' +
          requeueLabel +
          '</button>' +
          '<button type="button" data-action="discard" data-id="' +
          escapeHtml(d.id) +
          '"' +
          controlsDisabled +
          discardBusy +
          ' class="text-sm font-medium text-rose-700 hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-50">' +
          discardLabel +
          '</button>' +
          '</div></li>'
        );
      }

      function renderEntries(entries) {
        if (entries.length === 0) {
          if (list) list.innerHTML = '';
          if (summary) summary.textContent = '0 entries';
          if (listRegion) listRegion.classList.add('hidden');
          if (emptyRegion) emptyRegion.classList.remove('hidden');
          return;
        }
        if (listRegion) listRegion.classList.remove('hidden');
        if (emptyRegion) emptyRegion.classList.add('hidden');
        if (summary) {
          summary.textContent =
            entries.length + ' entr' + (entries.length === 1 ? 'y' : 'ies');
        }
        if (list) list.innerHTML = entries.map(rowHtml).join('');
      }

      let inFlight = 0;
      function load() {
        if (!token) return Promise.resolve(false);
        const myReq = ++inFlight;
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          apiBaseUrl + '/v1/admin/webhook-dlq?limit=50',
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return false;
            renderEntries(body.data || []);
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (myReq !== inFlight) return;
            const msg = requestErrorMessage(err, 'network error');
            // W604 — clear the SSG mock entry on ANY load failure. Leaving the
            // mock row on screen is dangerous: it renders live Requeue +
            // (irrecoverable) Discard buttons wired to a FAKE delivery id, so
            // an admin during a transient API error could fire
            // POST /admin/webhook-dlq/<mock-id>/discard on an entry that
            // doesn't exist. Replace with an honest error state.
            if (emptyRegion) emptyRegion.classList.add('hidden');
            if (listRegion) listRegion.classList.remove('hidden');
            if (list) {
              list.innerHTML =
                '<li class="rounded-lg border border-tk-border bg-tk-bg p-5 text-sm text-tk-ink-3">Could not load the DLQ — nothing to act on. Resolve the error above and retry.</li>';
            }
            if (summary) summary.textContent = '';
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load DLQ (" + msg + ').');
            }
            return false;
          })
          .finally(() => {
            if (myReq === inFlight) {
              loadController = null;
              root.removeAttribute('aria-busy');
            }
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function requeue(id) {
        if (!token || pendingMutations.has(id)) return Promise.resolve();
        setEntryBusy(id, 'requeue', true, 'Requeueing…');
        showBanner('Requeueing ' + id + '…');
        return boundedFetch(apiBaseUrl + '/v1/admin/webhook-dlq/' + encodeURIComponent(id) + '/requeue', {
          method: 'POST',
          headers: {
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
          },
          credentials: 'include',
          body: '{}',
        })
          .then((r) => (r.ok ? r.json() : mutationError(r)))
          .then(() => {
            showBanner('Requeued ' + id + '. Refreshing list…');
            return load();
          })
          .catch(async (err) => {
            if (err && err.name === 'AbortError') {
              const refreshed = await load();
              showBanner(
                'Requeue outcome is unknown after the request timed out. ' +
                  (refreshed ? 'The DLQ was refreshed. ' : "We couldn't refresh the DLQ. ") +
                  'If ' +
                  id +
                  ' is gone, it was likely re-enqueued; do not submit it again.',
              );
              return;
            }
            const msg = requestErrorMessage(err, 'network error');
            showBanner("Couldn't requeue " + id + ' (' + msg + ').');
          })
          .finally(() => {
            setEntryBusy(id, 'requeue', false, '');
          });
      }

      // 2026-05-22 — hard-delete a DLQ row. The payload is gone after
      // this; the admin audit log entry (webhook_delivery.discarded)
      // is the only forensic trace. Confirm() before firing so a
      // mis-click doesn't destroy evidence.
      async function discard(id) {
        if (!token || pendingMutations.has(id)) return;
        setEntryBusy(id, 'discard', true, 'Confirming…');
        // destructive: true — this is the one hard-delete action on this page
        // (payload is irrecoverable). Without it the Discard button auto-
        // focuses and Enter isn't swallowed, so a stray Enter right after the
        // dialog opens fires the delete with no click required, same bug class
        // as the suspend confirm on accounts/[id].astro (audit waefer6wu).
        try {
          const confirmed = await window.driftstackConfirm(
            'Discard webhook delivery ' +
              id +
              '? This is irrecoverable — the payload + retry history are deleted. The action is audit-logged.',
            { confirmLabel: 'Discard', destructive: true },
          );
          if (!confirmed) return;
          setEntryBusy(id, 'discard', true, 'Discarding…');
          showBanner('Discarding ' + id + '…');
          const r = await boundedFetch(
            apiBaseUrl + '/v1/admin/webhook-dlq/' + encodeURIComponent(id) + '/discard',
            {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                'content-type': 'application/json',
              },
              credentials: 'include',
              body: '{}',
            },
          );
          await (r.ok ? r.json() : mutationError(r));
          showBanner('Discarded ' + id + '. Refreshing list…');
          await load();
        } catch (err) {
          if (err && err.name === 'AbortError') {
            const refreshed = await load();
            showBanner(
              'Discard outcome is unknown after the request timed out. ' +
                (refreshed ? 'The DLQ was refreshed. ' : "We couldn't refresh the DLQ. ") +
                'If ' +
                id +
                ' is gone, it was likely discarded and only its audit trace remains; do not submit it again.',
            );
            return;
          }
          const msg = requestErrorMessage(err, 'network error');
          showBanner("Couldn't discard " + id + ' (' + msg + ').');
        } finally {
          setEntryBusy(id, 'discard', false, '');
        }
      }

      // Event delegation for dynamically-rendered Requeue + Discard buttons.
      if (root) {
        root.addEventListener('click', (ev) => {
          const target = ev.target;
          if (!target || !target.closest) return;
          const requeueBtn = target.closest('[data-action="requeue"]');
          if (requeueBtn) {
            ev.preventDefault();
            const id = requeueBtn.getAttribute('data-id');
            if (id) requeue(id);
            return;
          }
          const discardBtn = target.closest('[data-action="discard"]');
          if (discardBtn) {
            ev.preventDefault();
            const id = discardBtn.getAttribute('data-id');
            if (id) discard(id);
          }
        });
      }

      if (!token) {
        // W604 — clear the SSG mock so the unauthenticated state never shows a
        // fabricated DLQ entry with live Requeue/Discard buttons wired to a
        // FAKE delivery id.
        if (emptyRegion) emptyRegion.classList.add('hidden');
        if (listRegion) listRegion.classList.remove('hidden');
        if (list) {
          list.innerHTML =
            '<li class="rounded-lg border border-tk-border bg-tk-bg p-5 text-sm text-tk-ink-3">Sign in with a staff admin account to see the DLQ.</li>';
        }
        if (summary) summary.textContent = '';
        showBanner('Sign in with a staff admin account to see live data.');
        return;
      }

      // 2026-05-22 — live auto-poll. Same pattern as 580b30a7.
      let lastFetch = Date.now();
      function loadWithLive() {
        const liveDot = root.querySelector('[data-live-dot]');
        if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-amber-500';
        const p = load();
        if (p && typeof p.then === 'function') {
          p.then(
            () => {
              lastFetch = Date.now();
              if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-emerald-500';
            },
            () => {
              if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-red-500';
            },
          );
        } else {
          lastFetch = Date.now();
        }
      }
      const refreshBtn = root.querySelector('[data-live-refresh]');
      if (refreshBtn) refreshBtn.addEventListener('click', loadWithLive);
      setInterval(loadWithLive, 30_000);
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      const ageEl = root.querySelector('[data-live-age]');
      setInterval(() => {
        if (ageEl) ageEl.textContent = fmtAge(lastFetch);
      }, 5_000);

      load();
    })();
  </script>
</AdminLayout>
