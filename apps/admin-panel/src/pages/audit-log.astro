---
import AdminLayout from '../layouts/AdminLayout.astro';
import { MOCK_AUDIT_LOG } from '../data/mocks.ts';

// V-188 — progressive-enhancement against /v1/admin/audit-log. SSG
// renders the mock; an inline <script> reads ds_web_session_token
// from localStorage and replaces the table body with live entries.
// Filter bar is wired: action substring (server-side `action`),
// admin id (`admin_id`), result-only filter is client-side post-fetch
// since the endpoint doesn't accept a result filter today. Banner
// surfaces no-token / fetch-error / forbidden states.

function fmtIso(iso: string): string {
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
}

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Audit log">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-audit-log">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Audit log</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Append-only record of every admin action. Cannot be mutated by admins
          (D-025). Filter by action, admin id, or target account.
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as 2c24750f /
          580b30a7. New audit entries surface every 30s without F5. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-emerald-500"
          ></span>
          <span>Live · updated <span data-live-age>just now</span></span>
        </span>
        <button
          type="button"
          data-live-refresh
          class="text-tk-accent hover:underline"
        >
          Refresh now
        </button>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div class="relative">
        <input
          type="search"
          data-field="action"
          aria-label="Filter audit log by action"
          placeholder="Filter by action (e.g. account.tier_changed)…"
          class="w-80 rounded-md border border-tk-border px-3 py-2 pr-12 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
        />
        <kbd
          aria-hidden="true"
          class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-tk-border bg-tk-bg px-1.5 py-0.5 font-mono text-[10px] text-tk-ink-3"
        >
          /
        </kbd>
      </div>
      <input
        type="search"
        data-field="admin-id"
        aria-label="Filter audit log by admin id"
        placeholder="Admin id (acc_<uuid>)"
        class="w-64 rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      />
      <select
        data-field="result"
        aria-label="Filter audit log by result"
        class="rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      >
        <option value="">Any result</option>
        <option value="success">Success only</option>
        <option value="error">Errors only</option>
      </select>
      {/* Scoped-target chip: shown when the page is deep-linked with a
          ?target_id=… (e.g. "Full audit log for this account"). Hidden by
          default; the inline script reveals + populates it from the URL. */}
      <span
        data-field="target-chip"
        class="hidden inline-flex items-center gap-2 rounded-full bg-tk-accent/10 px-3 py-1 text-xs text-tk-accent"
      >
        <span>Filtered to <span class="font-mono" data-field="target-chip-label"></span></span>
        <button type="button" data-action="clear-target" class="font-medium hover:underline">
          clear
        </button>
      </span>
    </div>

    <!-- Audit table -->
    <div class="overflow-x-auto rounded-lg border border-tk-border bg-tk-surface">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-tk-border text-left text-xs font-medium uppercase tracking-wide text-tk-ink-3">
            <th class="px-4 py-3">Timestamp</th>
            <th class="px-4 py-3">Admin</th>
            <th class="px-4 py-3">Action</th>
            <th class="px-4 py-3">Target</th>
            <th class="px-4 py-3">Result</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-list="audit">
          {
            MOCK_AUDIT_LOG.map((entry) => (
              <tr class="hover:bg-tk-bg">
                <td class="px-4 py-3 font-mono text-xs text-tk-ink-2">{fmtIso(entry.ts)}</td>
                <td class="px-4 py-3 font-mono text-xs text-tk-ink-2">{entry.adminEmail}</td>
                <td class="px-4 py-3">
                  <code class="font-mono text-xs text-tk-accent">{entry.action}</code>
                </td>
                <td class="px-4 py-3">
                  {entry.targetAccountId !== null && (
                    <p class="font-mono text-xs text-tk-ink-2">{entry.targetAccountId}</p>
                  )}
                  {entry.targetResourceId !== null && (
                    <p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">
                      {entry.targetResourceId}
                    </p>
                  )}
                </td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                      entry.result === 'success'
                        ? 'bg-emerald-50 text-emerald-700'
                        : 'bg-red-50 text-red-700',
                    ]}
                  >
                    {entry.result}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-tk-ink-3" data-field="footnote">
      Retention 90 days hot in Postgres + R2 archive thereafter (ADR-006). The
      read endpoint paginates by timestamp DESC; bulk export is not yet
      exposed from <code class="font-mono">/v1/admin/audit-log</code> — pull
      pages via <code class="font-mono">cursor</code> for now.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-audit-log"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const tbody = root.querySelector('[data-list="audit"]');
      const footnote = root.querySelector('[data-field="footnote"]');
      const actionEl = root.querySelector('[data-field="action"]');
      const adminIdEl = root.querySelector('[data-field="admin-id"]');
      const resultEl = root.querySelector('[data-field="result"]');
      let token = null;
      const AUDIT_REQUEST_TIMEOUT_MS = 15_000;
      let loadController = null;

      function boundedFetch(url, init, controller) {
        return window.driftstackFetchWithDeadline(
          url,
          init,
          AUDIT_REQUEST_TIMEOUT_MS,
          controller,
        );
      }

      function requestErrorMessage(err, fallback = 'network error') {
        return err && err.name === 'AbortError'
          ? 'Request timed out. Try again.'
          : err && err.message
            ? err.message
            : fallback;
      }

      // Seed the filter from the URL so deep-links like
      // /audit-log?target_id=acc_<id> (from the per-account detail page) or
      // /audit-log?admin_id=acc_<id> land on a pre-filtered view rather than
      // the global unfiltered log. target_id has no visible input, so it's
      // carried in buildQuery() + surfaced as a "Filtered to … (clear)" chip.
      const urlParams = new URLSearchParams(window.location.search);
      if (adminIdEl instanceof HTMLInputElement && urlParams.get('admin_id')) {
        adminIdEl.value = urlParams.get('admin_id');
      }
      if (actionEl instanceof HTMLInputElement && urlParams.get('action')) {
        actionEl.value = urlParams.get('action');
      }
      let targetIdFromUrl = urlParams.get('target_id') || '';
      const targetChip = root.querySelector('[data-field="target-chip"]');
      const targetChipLabel = root.querySelector('[data-field="target-chip-label"]');
      function syncTargetChip() {
        if (!targetChip) return;
        if (targetIdFromUrl) {
          if (targetChipLabel) targetChipLabel.textContent = targetIdFromUrl;
          targetChip.classList.remove('hidden');
        } else {
          targetChip.classList.add('hidden');
        }
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function fmtIso(iso) {
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
      }

      function rowHtml(e) {
        // Show the email as the primary line (UUID secondary) when the
        // server has enriched the entry — so "who did this?" and "to
        // whom?" read off the row directly. Falls back to the bare UUID
        // when admin_email / target_email aren't present yet.
        const adminFrag = e.admin_email
          ? '<p class="text-xs text-tk-ink">' +
            escapeHtml(e.admin_email) +
            '</p>' +
            '<p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">' +
            escapeHtml(e.admin_account_id) +
            '</p>'
          : '<p class="font-mono text-xs text-tk-ink-2">' +
            escapeHtml(e.admin_account_id) +
            '</p>';
        const targetFrag =
          (e.target_account_id
            ? e.target_email
              ? '<p class="text-xs text-tk-ink">' +
                escapeHtml(e.target_email) +
                '</p>' +
                '<p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">' +
                escapeHtml(e.target_account_id) +
                '</p>'
              : '<p class="font-mono text-xs text-tk-ink-2">' +
                escapeHtml(e.target_account_id) +
                '</p>'
            : '') +
          (e.target_resource_id
            ? '<p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">' +
              escapeHtml(e.target_resource_id) +
              '</p>'
            : '');
        const resultClass =
          e.result === 'success'
            ? 'bg-emerald-50 text-emerald-700'
            : 'bg-red-50 text-red-700';
        return (
          '<tr class="hover:bg-tk-bg">' +
          '<td class="px-4 py-3 font-mono text-xs text-tk-ink-2">' +
          escapeHtml(fmtIso(e.timestamp)) +
          '</td>' +
          '<td class="px-4 py-3">' +
          adminFrag +
          '</td>' +
          '<td class="px-4 py-3"><code class="font-mono text-xs text-tk-accent">' +
          escapeHtml(e.action) +
          '</code></td>' +
          '<td class="px-4 py-3">' +
          (targetFrag || '<span class="text-xs text-tk-ink-3">—</span>') +
          '</td>' +
          '<td class="px-4 py-3">' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          resultClass +
          '">' +
          escapeHtml(e.result) +
          '</span></td></tr>'
        );
      }

      function buildQuery() {
        const params = new URLSearchParams();
        params.set('limit', '50');
        if (actionEl && actionEl.value.trim()) params.set('action', actionEl.value.trim());
        if (adminIdEl && adminIdEl.value.trim()) params.set('admin_id', adminIdEl.value.trim());
        // target_id has no visible input; it's carried from the URL deep-link
        // (server filters by target_id — admin-audit-log.ts maybeUuidFromInput).
        if (targetIdFromUrl) params.set('target_id', targetIdFromUrl);
        return params;
      }

      let inFlight = 0;
      function load() {
        if (!token) return Promise.resolve(false);
        const myReq = ++inFlight;
        const params = buildQuery();
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        return boundedFetch(
          apiBaseUrl + '/v1/admin/audit-log?' + params.toString(),
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return;
            const fetched = body.data || [];
            let entries = fetched;
            const resultFilter = resultEl ? resultEl.value : '';
            if (resultFilter) {
              // Failures are audited as `error: <code>` (every admin route's
              // catch block), so an exact === 'error' match never hit them and
              // "Errors only" silently showed nothing. Prefix-match instead:
              // 'success' matches the exact success result, 'error' matches
              // every `error: <code>` variant.
              entries = entries.filter((e) => String(e.result).startsWith(resultFilter));
            }
            // The result filter is applied CLIENT-side over only the fetched
            // page (server takes no `result` param), so an empty filtered view
            // means "none in the 50 most-recent" — NOT "no such entries exist".
            // Say so, or a forensic reviewer reads a false all-clear. (Only the
            // page window is qualified; without a filter the count is exact.)
            const filteredPage = resultFilter && fetched.length >= 50;
            if (tbody) {
              if (entries.length === 0) {
                tbody.innerHTML =
                  '<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-tk-ink-3">' +
                  (filteredPage
                    ? 'No ' +
                      resultFilter +
                      ' entries in the 50 most-recent — older entries are not loaded on this view.'
                    : 'No audit entries match the current filter.') +
                  '</td></tr>';
              } else {
                tbody.innerHTML = entries.map(rowHtml).join('');
              }
            }
            if (footnote) {
              footnote.textContent =
                'Showing ' +
                entries.length +
                ' entr' +
                (entries.length === 1 ? 'y' : 'ies') +
                (filteredPage ? ' (of the 50 most-recent — filter is client-side)' : '') +
                '. Retention 90 days hot in Postgres + R2 archive thereafter (ADR-006).';
            }
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (myReq !== inFlight) return false;
            const msg = requestErrorMessage(err);
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load audit log (" + msg + '). Showing preview data below.');
            }
            return false;
          })
          .finally(() => {
            if (myReq !== inFlight) return;
            loadController = null;
            // 2026-05-21 — AdminLayout opacity-gate signal.
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function start() {
        token = localStorage.getItem('ds_web_session_token');
        if (!token) {
          showBanner('Sign in with a staff admin account to see live data. Showing preview below.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return;
        }

      let debounce = 0;
      function scheduleLoad() {
        clearTimeout(debounce);
        debounce = setTimeout(load, 200);
      }

      if (actionEl) actionEl.addEventListener('input', scheduleLoad);
      if (adminIdEl) adminIdEl.addEventListener('input', scheduleLoad);
      if (resultEl) resultEl.addEventListener('change', scheduleLoad);

      // Surface the scoped-target chip on load + let the operator clear it
      // (drops the target_id filter back to the global log without a reload).
      syncTargetChip();
      const clearTargetBtn = root.querySelector('[data-action="clear-target"]');
      if (clearTargetBtn) {
        clearTargetBtn.addEventListener('click', () => {
          targetIdFromUrl = '';
          syncTargetChip();
          load();
        });
      }

      // 2026-05-22 — "/" focuses the action filter (same convention
      // as /accounts 2fe3da4b). Skip when user is already in an
      // input/textarea/contentEditable.
      document.addEventListener('keydown', (ev) => {
        if (ev.key !== '/' || ev.metaKey || ev.ctrlKey || ev.altKey) return;
        const target = ev.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
        if (target instanceof HTMLElement && target.isContentEditable) return;
        ev.preventDefault();
        if (actionEl instanceof HTMLInputElement) {
          actionEl.focus();
          actionEl.select();
        }
      });

      // 2026-05-22 — live auto-poll. Same pattern as 580b30a7.
      let lastFetch = Date.now();
      function loadWithLive() {
        const liveDot = root.querySelector('[data-live-dot]');
        if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-amber-500';
        const p = load();
        if (p && typeof p.then === 'function') {
          p.then((ok) => {
            if (ok) {
              lastFetch = Date.now();
              if (liveDot)
                liveDot.className = 'inline-block h-2 w-2 rounded-full bg-emerald-500';
            } else if (liveDot) {
              liveDot.className = 'inline-block h-2 w-2 rounded-full bg-red-500';
            }
          });
        } else {
          lastFetch = Date.now();
        }
      }
      const refreshBtn = root.querySelector('[data-live-refresh]');
      if (refreshBtn) refreshBtn.addEventListener('click', loadWithLive);
      setInterval(loadWithLive, 30_000);
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      const ageEl = root.querySelector('[data-live-age]');
      setInterval(() => {
        if (ageEl) ageEl.textContent = fmtAge(lastFetch);
      }, 5_000);

        void load();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
