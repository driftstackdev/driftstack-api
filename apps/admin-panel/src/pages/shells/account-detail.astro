---
import AdminLayout from '../../layouts/AdminLayout.astro';

// V-191 — progressive-enhancement against /v1/admin/accounts/:id +
// per-account audit slice + admin-action POSTs (change tier, suspend,
// unsuspend).
//
// The detail surface is a deterministic static shell. Cloudflare Pages
// internally rewrites /accounts/<id> to this file while preserving the
// browser URL; the inline script reads the id from window.location and
// replaces every placeholder from the authenticated API response. This
// keeps arbitrary live deep links without a Pages Worker or SSR adapter.
const account = {
  id: '',
  email: '—',
  name: null as string | null,
  tier: '—',
  status: 'active' as 'active' | 'suspended' | 'deleted',
  createdAt: null as string | null,
  lastSeenAt: null as string | null,
};

const auditSlice: Array<{
  id: string;
  ts: string;
  action: string;
  adminEmail: string;
  result: 'success' | 'failure';
  metadata: Record<string, unknown>;
}> = [];

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
}

const STATUS_BADGE: Record<string, string> = {
  active: 'bg-emerald-50 text-emerald-700',
  suspended: 'bg-amber-50 text-amber-700',
  deleted: 'bg-tk-hover text-tk-ink-2',
};

import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
const accountId = account.id;
---

<AdminLayout title={account.email}>
  <div
    class="mx-auto max-w-5xl px-6 py-10"
    data-page="admin-account-detail"
    data-account-id={accountId}
  >
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10">
      <p class="text-sm text-tk-ink-3">
        <a href="/accounts" class="text-tk-accent hover:underline">← Back to accounts</a>
      </p>
      <div class="mt-2 flex items-start justify-between gap-6">
        <div>
          <h1
            class="text-3xl font-semibold tracking-tight text-tk-ink"
            data-field="title-name"
          >{account.name ?? account.email}</h1>
          <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
          <p class="mt-1 text-sm text-tk-ink-3" data-field="title-email">{account.email}</p>
          <p class="mt-2 font-mono text-xs text-tk-ink-3" data-field="account-id">
            {account.id ? `acc_${account.id}` : '—'}
          </p>
        </div>
        <span
          data-field="status-badge"
          class:list={[
            'inline-flex shrink-0 rounded-full px-3 py-1 text-xs font-medium uppercase tracking-wide',
            STATUS_BADGE[account.status],
          ]}
        >
          {account.status}
        </span>
      </div>
    </header>

    <!-- Account facts -->
    {/* 2026-05-23 — icon on Account facts card. */}
    <section class="dashboard-card">
      <div class="flex items-start justify-between">
        <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Account</p>
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="7" r="4" />
            <path d="M5 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
          </svg>
        </span>
      </div>
      <dl class="mt-4 grid gap-4 md:grid-cols-2">
        <div class="flex justify-between border-b border-slate-100 pb-2">
          <dt class="text-sm text-tk-ink-3">Tier</dt>
          <dd class="font-mono text-sm text-tk-ink" data-field="tier">{account.tier}</dd>
        </div>
        <div class="flex justify-between border-b border-slate-100 pb-2">
          <dt class="text-sm text-tk-ink-3">Status</dt>
          <dd class="font-mono text-sm text-tk-ink" data-field="status">{account.status}</dd>
        </div>
        <div class="flex justify-between border-b border-slate-100 pb-2">
          <dt class="text-sm text-tk-ink-3">Created</dt>
          <dd class="font-mono text-sm text-tk-ink" data-field="created">
            {fmtIso(account.createdAt)}
          </dd>
        </div>
        <div class="flex justify-between border-b border-slate-100 pb-2">
          <dt class="text-sm text-tk-ink-3">Last updated</dt>
          <dd class="font-mono text-sm text-tk-ink" data-field="updated">
            {fmtIso(account.lastSeenAt)}
          </dd>
        </div>
      </dl>
    </section>

    {/* 2026-05-23 — icon on Admin actions card. */}
    <!-- Admin actions -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.7 6.3l-1.4 1.4 4 4-1.4 1.4-4-4-1.4 1.4 4 4-7 7H3v-4l9-9-4-4 1.4-1.4 4 4 1.4-1.4z" />
          </svg>
        </span>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Admin actions
          </p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Manual operations</h2>
        </div>
      </div>
      <p class="mt-2 text-sm text-tk-ink-3">
        All actions audit-logged with admin id + reason. Tier change applies
        immediately; suspend revokes all sessions + keys until unsuspend.
      </p>

      <div class="mt-6 flex flex-wrap gap-3" data-field="action-row">
        <button type="button" data-action="change-tier" class="btn-secondary text-sm">
          Change tier
        </button>
        <button
          type="button"
          data-action="suspend"
          class:list={[
            'btn-secondary text-sm border-amber-300 text-amber-800 hover:bg-amber-50',
            account.status === 'active' ? '' : 'hidden',
          ]}
        >
          Suspend account
        </button>
        <button
          type="button"
          data-action="unsuspend"
          class:list={[
            'btn-secondary text-sm border-emerald-300 text-emerald-800 hover:bg-emerald-50',
            account.status === 'suspended' ? '' : 'hidden',
          ]}
        >
          Unsuspend account
        </button>
        <button type="button" data-action="set-override" class="btn-secondary text-sm">
          Set rate-limit override
        </button>
        <button type="button" data-action="add-note" class="btn-secondary text-sm">
          Add support note
        </button>
        <button
          type="button"
          data-action="record-refund"
          class="btn-secondary text-sm border-amber-300 text-amber-800 hover:bg-amber-50"
        >
          Record refund (audit-only)
        </button>
      </div>

      <!--
        V-196 — inline rate-limit-override form. Hidden by default; the
        Set-rate-limit-override button reveals it. Submit POSTs to
        /v1/admin/accounts/:id/quota-override; the audit row records
        admin id + key id + bucket + reason. Form intentionally lives
        on the per-account page (Decision 4 from founder review):
        canonical staff workflow is /accounts → detail → set, not a
        top-level form on /rate-limit-overrides.
      -->
      <form
        data-field="override-form"
        class="mt-6 hidden rounded-lg border border-tk-border bg-tk-bg p-4"
      >
        {/* 2026-05-23 — icon on Rate-limit override form. */}
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg>
          </span>
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">
            Rate-limit override
          </p>
        </div>
        <div class="mt-3 grid gap-3 md:grid-cols-2">
          <label class="block text-sm">
            <span class="text-tk-ink-2">Bucket</span>
            <select
              name="bucket_key"
              class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            >
              {/* Values are the canonical SetQuotaOverrideRequestSchema enum
                  (api-types/src/admin.ts) — the server 400s on anything else.
                  The prior `session_create` / `capture` values were rejected,
                  so only `global` ever POSTed successfully. */}
              <option value="global">Global</option>
              <option value="sessions:create">Sessions: create</option>
              <option value="agent_sessions:message">Agent sessions: message</option>
            </select>
          </label>
          <label class="block text-sm">
            <span class="text-tk-ink-2">Capacity (token bucket size)</span>
            <input
              type="number"
              name="capacity"
              min="1"
              step="1"
              required
              placeholder="200"
              class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            />
          </label>
          <label class="block text-sm">
            <span class="text-tk-ink-2">Refill / sec</span>
            <input
              type="number"
              name="refill_per_second"
              min="0.01"
              step="0.01"
              required
              placeholder="10"
              class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            />
          </label>
          <label class="block text-sm">
            <span class="text-tk-ink-2">Duration (seconds, default 14d)</span>
            <input
              type="number"
              name="duration_seconds"
              min="60"
              step="60"
              value="1209600"
              class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
            />
          </label>
        </div>
        <label class="mt-3 block text-sm">
          <span class="text-tk-ink-2">Reason (audit row)</span>
          <textarea
            name="reason"
            rows="2"
            required
            placeholder="e.g. Migrating off legacy hours-meter; needs headroom during cutover."
            class="mt-1 block w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"></textarea>
        </label>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="submit" class="btn-primary text-sm">Apply override</button>
          <button type="button" data-action="cancel-override" class="btn-secondary text-sm">
            Cancel
          </button>
        </div>
      </form>
    </section>

    {/* 2026-05-22 — per-account cost breakdown inline. Same 5-
        dimension shape as /admin/cost. Saves the operator the
        drill-into-/cost step when reviewing a single account. */}
    {/* 2026-05-23 — icons on Spend + Audit slice cards. */}
    <section class="dashboard-card mt-6" data-section="account-cost">
      <div class="flex items-start gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="1" x2="12" y2="23" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
        </span>
        <div class="flex-1">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Spend (this cycle)</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Cost breakdown</h2>
        </div>
      </div>
      <div data-account-cost-body class="mt-4">
        {/* 2026-05-24 — skeleton rows for hydrate-state polish. */}
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-32 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-20 animate-pulse rounded bg-slate-200"></div>
          </div>
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-28 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-16 animate-pulse rounded bg-slate-200"></div>
          </div>
          <div class="flex items-center justify-between gap-4">
            <div class="h-3 w-36 animate-pulse rounded bg-slate-200"></div>
            <div class="h-3 w-12 animate-pulse rounded bg-slate-200"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Per-account audit slice -->
    <section class="dashboard-card mt-6">
      <div class="flex items-start gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent mt-1">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 13h6M9 17h4" />
          </svg>
        </span>
        <div class="flex-1">
          <p class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Audit slice</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-tk-ink">Admin actions on this account</h2>
        </div>
      </div>
      <ul class="mt-4 divide-y divide-slate-100" data-list="account-audit">
        {
          auditSlice.length === 0 ? (
            <li class="py-3 text-sm text-tk-ink-3">No admin actions on record.</li>
          ) : (
            auditSlice.map((entry) => (
              <li class="flex items-start justify-between gap-4 py-3">
                <div class="min-w-0">
                  <p class="font-mono text-xs text-tk-ink-3">{fmtIso(entry.ts)}</p>
                  <p class="mt-1 text-sm text-tk-ink">
                    <span class="font-mono text-xs text-tk-ink-2">{entry.adminEmail}</span>{' '}
                    <code class="font-mono text-xs text-tk-accent">{entry.action}</code>
                  </p>
                </div>
                <span
                  class:list={[
                    'inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                    entry.result === 'success'
                      ? 'bg-emerald-50 text-emerald-700'
                      : 'bg-red-50 text-red-700',
                  ]}
                >
                  {entry.result}
                </span>
              </li>
            ))
          )
        }
      </ul>
      {/* Use the server's filter param name (`target_id`, not `account`) so
          the audit-log page seeds its filter from the URL and lands on a
          view scoped to this account. The server strips the acc_ prefix via
          maybeUuidFromInput, so the prefixed id works once the param matches. */}
      <a
        href="/audit-log"
        data-field="full-audit-link"
        class="mt-4 inline-flex text-sm text-tk-accent hover:underline"
      >
        Full audit log for this account →
      </a>
    </section>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-account-detail"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list="account-audit"]');
      let token = null;
      const ACCOUNT_DETAIL_TIMEOUT_MS = 15_000;
      let hydrationController = null;
      let hydrationGeneration = 0;
      let auditEntries = [];

      // The Pages rewrite preserves the requested URL, so the live UUID is
      // available here even though every detail request shares one shell.
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const accountUuid =
        pathParts.length === 2 && pathParts[0] === 'accounts' ? pathParts[1] || '' : '';
      const prefixedId = 'acc_' + accountUuid;

      const STATUS_BADGE = {
        active: 'bg-emerald-50 text-emerald-700',
        suspended: 'bg-amber-50 text-amber-700',
        deleted: 'bg-tk-hover text-tk-ink-2',
      };

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function setText(field, text) {
        const el = root.querySelector('[data-field="' + field + '"]');
        if (el) el.textContent = text;
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
      }

      function authedFetch(path, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(
          apiBaseUrl + path,
          {
            ...init,
            headers: {
              ...(init.headers || {}),
              authorization: 'Bearer ' + token,
              'content-type': 'application/json',
            },
            credentials: 'include',
          },
          ACCOUNT_DETAIL_TIMEOUT_MS,
          controller,
        );
      }

      function requestErrorMessage(err, fallback = 'network error') {
        return err && err.name === 'AbortError'
          ? 'Request timed out. Try again.'
          : err && err.message
            ? err.message
            : fallback;
      }

      // On a failed mutation (tier change / suspend / refund / override /
      // note), surface the server's problem+json `detail` — e.g. "Refund
      // amount exceeds the original charge" or "Unknown tier id" — so the
      // operator sees WHY the action was refused instead of a bare
      // "HTTP 400" (W151/W152 baseline). Load fetches keep their own
      // 403→forbidden / 404→not-found mapping above.
      function mutationJson(r) {
        if (r.ok) return r.json();
        return r
          .json()
          .catch(() => ({}))
          .then((b) => Promise.reject(new Error(b.detail || 'HTTP ' + r.status)));
      }

      function applyAccount(a) {
        const titleName = a.name || a.email;
        setText('title-name', titleName);
        setText('title-email', a.email);
        setText('tier', a.tier);
        setText('status', a.status);
        setText('created', fmtIso(a.created_at));
        setText('updated', fmtIso(a.updated_at));
        const badge = root.querySelector('[data-field="status-badge"]');
        if (badge) {
          badge.textContent = a.status;
          badge.className =
            'inline-flex shrink-0 rounded-full px-3 py-1 text-xs font-medium uppercase tracking-wide ' +
            (STATUS_BADGE[a.status] || '');
        }
        const suspendBtn = root.querySelector('[data-action="suspend"]');
        const unsuspendBtn = root.querySelector('[data-action="unsuspend"]');
        if (suspendBtn) {
          if (a.status === 'active') suspendBtn.classList.remove('hidden');
          else suspendBtn.classList.add('hidden');
        }
        if (unsuspendBtn) {
          if (a.status === 'suspended') unsuspendBtn.classList.remove('hidden');
          else unsuspendBtn.classList.add('hidden');
        }
      }

      setText('account-id', accountUuid ? prefixedId : '—');
      const fullAuditLink = root.querySelector('[data-field="full-audit-link"]');
      if (fullAuditLink && accountUuid) {
        fullAuditLink.setAttribute(
          'href',
          '/audit-log?target_id=' + encodeURIComponent(prefixedId),
        );
      }

      function renderAudit(entries) {
        auditEntries = Array.isArray(entries) ? entries : [];
        if (!list) return;
        if (entries.length === 0) {
          list.innerHTML =
            '<li class="py-3 text-sm text-tk-ink-3">No admin actions on record.</li>';
          return;
        }
        list.innerHTML = entries
          .map((entry) => {
            const resultClass =
              entry.result === 'success'
                ? 'bg-emerald-50 text-emerald-700'
                : 'bg-red-50 text-red-700';
            return (
              '<li class="flex items-start justify-between gap-4 py-3">' +
              '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-tk-ink-3">' +
              escapeHtml(fmtIso(entry.timestamp)) +
              '</p>' +
              '<p class="mt-1 text-sm text-tk-ink">' +
              '<span class="font-mono text-xs text-tk-ink-2">' +
              escapeHtml(entry.admin_account_id) +
              '</span> ' +
              '<code class="font-mono text-xs text-tk-accent">' +
              escapeHtml(entry.action) +
              '</code></p></div>' +
              '<span class="inline-flex shrink-0 rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
              resultClass +
              '">' +
              escapeHtml(entry.result) +
              '</span></li>'
            );
          })
          .join('');
      }

      function load() {
        if (!accountUuid) {
          showBanner('Invalid account link.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return Promise.resolve(false);
        }
        if (!token) return Promise.resolve(false);
        if (hydrationController) hydrationController.abort();
        const controller = new AbortController();
        hydrationController = controller;
        const generation = ++hydrationGeneration;
        root.setAttribute('aria-busy', 'true');
        const isCurrent = () => generation === hydrationGeneration;
        const accountP = authedFetch(
          '/v1/admin/accounts/' + encodeURIComponent(prefixedId),
          {},
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            if (r.status === 404) return Promise.reject(new Error('not-found'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (isCurrent()) applyAccount(body);
          });

        const auditP = authedFetch(
          '/v1/admin/audit-log?limit=20&target_id=' + encodeURIComponent(prefixedId),
          {},
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (isCurrent()) renderAudit(body.data || []);
          });

        // 2026-05-22 — per-account cost. Soft-fails (kept off the
        // Promise.all error path) so an unwired cost surface
        // doesn't show "Couldn't load account" to operators just
        // inspecting tier/status.
        const costBody = root.querySelector('[data-account-cost-body]');
        // The cost route matches accounts.id (a bare uuid) directly — unlike
        // /v1/admin/accounts/:id which uuidFromPrefixedId-strips the acc_ prefix.
        // So it needs the RAW uuid, not prefixedId: sending the prefixed id 404s,
        // which (soft-failed below) silently rendered "No cost data this cycle
        // yet" for every account that actually had usage.
        const costP = authedFetch(
          `/v1/admin/cost/accounts/${encodeURIComponent(accountUuid)}`,
          {},
          controller,
        )
          .then((r) => (r.ok ? r.json() : null))
          .then((b) => {
            if (!isCurrent() || !costBody) return;
            if (!b || !b.breakdown) {
              costBody.innerHTML = '<p class="text-sm text-tk-ink-3">No cost data this cycle yet.</p>';
              return;
            }
            const br = b.breakdown;
            const cents = (n) => '$' + (Number(n ?? 0) / 100).toFixed(2);
            const subprocessor = Number(br.emailCents ?? 0) + Number(br.llmCents ?? 0);
            const total = Math.max(1, Number(br.totalCents ?? 0));
            const bar = (label, value) => {
              const v = Number(value ?? 0);
              const pct = Math.max(4, Math.round((v / total) * 100));
              return (
                '<div class="flex items-center gap-3 text-xs">' +
                '<span class="w-24 shrink-0 text-tk-ink-2">' + label + '</span>' +
                '<div class="flex-1 h-3 rounded-full bg-tk-hover overflow-hidden">' +
                '<div class="h-full bg-tk-accent/70" style="width: ' + pct + '%"></div>' +
                '</div>' +
                '<span class="font-mono w-16 text-right text-tk-ink">' + cents(v) + '</span>' +
                '</div>'
              );
            };
            const STATE_BADGE = {
              'under-soft': 'bg-emerald-100 text-emerald-800',
              'between-soft-and-hard': 'bg-amber-100 text-amber-800',
              'over-hard': 'bg-rose-100 text-rose-800',
            };
            const stateCls = STATE_BADGE[br.thresholdState] || 'bg-tk-hover text-tk-ink-2';
            costBody.innerHTML =
              '<div class="flex items-baseline justify-between mb-3">' +
              '<p class="text-2xl font-semibold text-tk-ink">' + cents(br.totalCents) + '</p>' +
              '<span class="inline-flex items-center rounded-full ' + stateCls + ' px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide">' + (br.thresholdState || '—') + '</span>' +
              '</div>' +
              '<div class="space-y-2">' +
              bar('Compute', br.computeCents) +
              bar('Storage', br.storageCents) +
              bar('Egress', br.egressCents) +
              bar('Sub-processor', subprocessor) +
              '</div>' +
              '<p class="mt-3 text-xs text-tk-ink-3">Cycle: ' + (b.billing_cycle || b.billingCycle || '—') + '</p>';
          })
          .catch(() => {
            if (isCurrent() && costBody)
              costBody.innerHTML =
                '<p class="text-sm text-tk-ink-3">Cost data not available.</p>';
          });

        return Promise.all([accountP, auditP, costP])
          .then(() => {
            if (!isCurrent()) return false;
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (!isCurrent()) return false;
            const msg = requestErrorMessage(err);
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else if (msg === 'not-found') {
              showBanner('Account not found. Showing preview shell.');
            } else {
              showBanner("Couldn't load account (" + msg + '). Showing preview data below.');
            }
            return false;
          })
          .finally(() => {
            if (!isCurrent()) return;
            hydrationController = null;
            root.removeAttribute('aria-busy');
            if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          });
      }

      async function reconcileAccountTransition(action) {
        const refreshed = await load();
        const status = root.querySelector('[data-field="status"]')?.textContent?.trim();
        if (action === 'suspend') {
          if (refreshed && status === 'suspended') {
            showBanner(
              'Suspension outcome is unknown because the response timed out. The account was refreshed and is suspended, so sessions and API keys were revoked; do not suspend it again.',
            );
          } else if (refreshed) {
            showBanner(
              'Suspension outcome is unknown because the response timed out. The account was refreshed and is still ' +
                (status || 'not suspended') +
                '; retry suspension if containment is still required.',
            );
          } else {
            showBanner(
              'Suspension outcome is unknown because the response timed out, and the account could not be refreshed. Verify its status before retrying.',
            );
          }
          return;
        }
        if (refreshed && status === 'active') {
          showBanner(
            'Unsuspension outcome is unknown because the response timed out. The account was refreshed and is active; do not unsuspend it again.',
          );
        } else if (refreshed) {
          showBanner(
            'Unsuspension outcome is unknown because the response timed out. The account was refreshed and is still ' +
              (status || 'not active') +
              '; retry unsuspension if access should be restored.',
          );
        } else {
          showBanner(
            'Unsuspension outcome is unknown because the response timed out, and the account could not be refreshed. Verify its status before retrying.',
          );
        }
      }

      async function reconcileAccountTier(targetTier) {
        const refreshed = await load();
        const tier = root.querySelector('[data-field="tier"]')?.textContent?.trim();
        if (refreshed && tier === targetTier) {
          showBanner(
            'Tier-change outcome is unknown because the response timed out. The account was refreshed and now uses ' +
              targetTier +
              '; the change completed, so do not submit it again.',
          );
        } else if (refreshed) {
          showBanner(
            'Tier-change outcome is unknown because the response timed out. The account was refreshed and still uses ' +
              (tier || 'an unknown tier') +
              '; retry the change to ' +
              targetTier +
              ' if it is still required.',
          );
        } else {
          showBanner(
            'Tier-change outcome is unknown because the response timed out, and the account could not be refreshed. Verify its tier before retrying.',
          );
        }
      }

      function auditPayloadMatches(entry, action, payload) {
        if (!entry || entry.action !== action || entry.result !== 'success') return false;
        const input = entry.input_payload;
        if (!input || typeof input !== 'object') return false;
        if (action === 'audit_note.added') return input.note === payload.note;
        return (
          input.external_reference === payload.external_reference &&
          Number(input.amount_cents) === payload.amount_cents &&
          String(input.currency || 'USD').toUpperCase() === 'USD' &&
          input.reason === payload.reason
        );
      }

      function fetchAccountOverrides() {
        const params = new URLSearchParams({
          limit: '100',
          account_id: prefixedId,
          include_expired: 'true',
        });
        return authedFetch('/v1/admin/rate-limit-overrides?' + params.toString()).then((r) =>
          r.ok ? r.json().then((body) => body.data || []) : Promise.reject(new Error('HTTP ' + r.status)),
        );
      }

      function overrideVersion(rows, bucketKey) {
        return Array.isArray(rows) ? rows.find((row) => row.bucket_key === bucketKey) : null;
      }

      async function reconcileOverrideSet(payload, snapshot) {
        let rows;
        try {
          rows = await fetchAccountOverrides();
        } catch {
          showBanner(
            'Override outcome is unknown because the response timed out, and the authoritative override list could not be refreshed. Verify the account and bucket on Rate limits before retrying.',
          );
          return;
        }
        const before = overrideVersion(snapshot, payload.bucket_key);
        const current = overrideVersion(rows, payload.bucket_key);
        const advanced =
          Array.isArray(snapshot) &&
          current &&
          (!before || current.id !== before.id || current.updated_at !== before.updated_at);
        const ttlMs = current
          ? Date.parse(current.expires_at) - Date.parse(current.updated_at)
          : Number.NaN;
        const ttlMatches =
          Number.isFinite(ttlMs) &&
          Math.abs(ttlMs - payload.duration_seconds * 1000) <= 60_000;
        const exact =
          current &&
          Number(current.capacity) === payload.capacity &&
          Number(current.refill_per_second) === payload.refill_per_second &&
          String(current.reason || '') === payload.reason &&
          ttlMatches;
        if (advanced && exact) {
          hideOverrideForm(true);
          showBanner(
            'Override outcome is unknown because the response timed out. The authoritative list now contains a new or updated ' +
              payload.bucket_key +
              ' override with the submitted capacity, refill rate, duration, and reason, so it was likely applied; do not submit it again.',
          );
        } else if (current) {
          showBanner(
            'Override outcome is unknown because the response timed out. The authoritative ' +
              payload.bucket_key +
              ' record could not be confirmed as a new exact version; review it on Rate limits before retrying.',
          );
        } else {
          showBanner(
            'Override outcome is unknown because the response timed out. No ' +
              payload.bucket_key +
              ' override is currently visible for this account; retry only if the capacity change is still required.',
          );
        }
      }

      const blockedAuditActions = new Set();
      function auditActionForKind(kind) {
        return kind === 'note' ? 'add-note' : 'record-refund';
      }

      function blockAuditAction(kind) {
        const action = auditActionForKind(kind);
        blockedAuditActions.add(action);
        const button = root.querySelector('[data-action="' + action + '"]');
        if (button) {
          button.disabled = true;
          button.setAttribute(
            'title',
            'Outcome unknown — reload and verify the audit log before recording another.',
          );
        }
      }

      function showBlockedAuditAction(kind) {
        showBanner(
          (kind === 'note' ? 'Support-note' : 'Refund-record') +
            ' submission is locked for this page because the previous outcome was confirmed or could not be verified. Reload and review the audit log before recording another.',
        );
      }

      async function reconcileAuditOnlyWrite(kind, payload, auditIdsBefore) {
        const refreshed = await load();
        const action = kind === 'note' ? 'audit_note.added' : 'refund.recorded';
        const matched =
          refreshed &&
          auditEntries.some(
            (entry) =>
              entry.id &&
              !auditIdsBefore.has(entry.id) &&
              auditPayloadMatches(entry, action, payload),
          );
        if (matched && kind === 'note') {
          blockAuditAction(kind);
          showBanner(
            'Support-note outcome is unknown because the response timed out. The refreshed audit log contains a new successful entry with the same note, so it was likely recorded; do not submit it again.',
          );
        } else if (matched) {
          blockAuditAction(kind);
          showBanner(
            'Refund-record outcome is unknown because the response timed out. The refreshed audit log contains a new successful entry with the same reference, amount, and reason, so the audit record was likely created; do not submit it again. The actual refund remains a separate Stripe dashboard action.',
          );
        } else if (refreshed) {
          showBanner(
            (kind === 'note' ? 'Support-note' : 'Refund-record') +
              ' outcome is unknown because the response timed out. The refreshed authoritative audit slice has no new matching successful entry; retry only if the record is still required.',
          );
        } else {
          blockAuditAction(kind);
          showBanner(
            (kind === 'note' ? 'Support-note' : 'Refund-record') +
              ' outcome is unknown because the response timed out, and the audit log could not be refreshed. Verify the full audit log before retrying to avoid a duplicate record.',
          );
        }
      }

      const actionRow = root.querySelector('[data-field="action-row"]');
      const accountActionButtons = actionRow
        ? Array.from(actionRow.querySelectorAll('[data-action]'))
        : [];
      let accountMutationInFlight = false;
      function beginAccountMutation(activeButton) {
        if (accountMutationInFlight) return false;
        const activeAction = activeButton?.getAttribute?.('data-action');
        if (activeAction && blockedAuditActions.has(activeAction)) return false;
        accountMutationInFlight = true;
        if (actionRow) actionRow.setAttribute('aria-busy', 'true');
        accountActionButtons.forEach((button) => {
          button.disabled = true;
        });
        if (activeButton) activeButton.setAttribute('aria-busy', 'true');
        return true;
      }
      function endAccountMutation(activeButton) {
        accountMutationInFlight = false;
        if (actionRow) actionRow.removeAttribute('aria-busy');
        accountActionButtons.forEach((button) => {
          button.disabled = blockedAuditActions.has(button.getAttribute('data-action'));
        });
        if (activeButton) activeButton.removeAttribute('aria-busy');
      }

      async function changeTier() {
        const tier = await window.driftstackPrompt(
          'New tier (one of free / solo_manual / team_manual / agency_manual / api_starter / api_builder / api_scale / enterprise):',
          { placeholder: 'e.g. api_starter', confirmLabel: 'Change tier' },
        );
        if (!tier) return;
        // Applies immediately to the customer's billing/feature tier; confirm the
        // resolved value so a valid-but-wrong typed tier isn't applied silently from
        // a single prompt entry (adversarial review wlcfjoxqq #2).
        const proceed = await window.driftstackConfirm(
          'Change this account’s tier to "' + tier.trim() + '"? This applies immediately.',
          { confirmLabel: 'Change tier' },
        );
        if (!proceed) return;
        const reason =
          (await window.driftstackPrompt('Reason for tier change (optional, max 500 chars):', {
            placeholder: 'optional',
          })) || '';
        const body = { tier: tier.trim() };
        if (reason.trim()) body.reason = reason.trim();
        showBanner('Changing tier to ' + tier + '…');
        return authedFetch('/v1/admin/accounts/' + encodeURIComponent(prefixedId) + '/tier', {
          method: 'POST',
          body: JSON.stringify(body),
        })
          .then(mutationJson)
          .then((updated) => {
            applyAccount(updated);
            showBanner('Tier changed to ' + updated.tier + '.');
            // Refresh audit slice to surface the just-recorded entry.
            load();
          })
          .catch(async (err) => {
            if (err && err.name === 'AbortError') {
              await reconcileAccountTier(body.tier);
              return;
            }
            const msg = requestErrorMessage(err);
            showBanner("Couldn't change tier (" + msg + ').');
          });
      }

      async function suspend() {
        // Destructive — revokes ALL active sessions + API keys until unsuspend. Gate
        // on a real yes/no confirm FIRST; the optional reason prompt alone let an
        // accidental Enter / single-click suspend a live account (adversarial review
        // wlcfjoxqq #1). destructive: true actually mirrors the panel's other
        // destructive actions (sessions.astro force-destroy) — without it the OK
        // button auto-focuses and Enter isn't swallowed, so a stray Enter right
        // after the dialog opens fires the suspend with no click required
        // (audit waefer6wu).
        const proceed = await window.driftstackConfirm(
          'Suspend this account? This revokes all active sessions and API keys until you unsuspend.',
          { confirmLabel: 'Suspend', destructive: true },
        );
        if (!proceed) return;
        const reason =
          (await window.driftstackPrompt(
            'Reason for suspending this account (optional, max 500 chars):',
            { placeholder: 'optional', confirmLabel: 'Suspend' },
          )) || '';
        const body = {};
        if (reason.trim()) body.reason = reason.trim();
        showBanner('Suspending account…');
        return authedFetch('/v1/admin/accounts/' + encodeURIComponent(prefixedId) + '/suspend', {
          method: 'POST',
          body: JSON.stringify(body),
        })
          .then(mutationJson)
          .then((updated) => {
            applyAccount(updated);
            showBanner('Account suspended.');
            load();
          })
          .catch(async (err) => {
            if (err && err.name === 'AbortError') {
              await reconcileAccountTransition('suspend');
              return;
            }
            const msg = requestErrorMessage(err);
            showBanner("Couldn't suspend (" + msg + ').');
          });
      }

      async function unsuspend() {
        const reason =
          (await window.driftstackPrompt('Reason for unsuspending (optional, max 500 chars):', {
            placeholder: 'optional',
            confirmLabel: 'Unsuspend',
          })) || '';
        const body = {};
        if (reason.trim()) body.reason = reason.trim();
        showBanner('Unsuspending account…');
        return authedFetch('/v1/admin/accounts/' + encodeURIComponent(prefixedId) + '/unsuspend', {
          method: 'POST',
          body: JSON.stringify(body),
        })
          .then(mutationJson)
          .then((updated) => {
            applyAccount(updated);
            showBanner('Account unsuspended.');
            load();
          })
          .catch(async (err) => {
            if (err && err.name === 'AbortError') {
              await reconcileAccountTransition('unsuspend');
              return;
            }
            const msg = requestErrorMessage(err);
            showBanner("Couldn't unsuspend (" + msg + ').');
          });
      }

      const overrideForm = root.querySelector('[data-field="override-form"]');
      let overrideSubmitting = false;
      function showOverrideForm() {
        if (overrideForm) overrideForm.classList.remove('hidden');
      }
      function hideOverrideForm(force) {
        if (overrideSubmitting && !force) return;
        if (overrideForm) {
          overrideForm.classList.add('hidden');
          if (overrideForm instanceof HTMLFormElement) overrideForm.reset();
        }
      }

      function submitOverride(form) {
        if (!token || overrideSubmitting || accountMutationInFlight) {
          if (!token) showBanner('Sign in with a staff admin account to perform this action.');
          return;
        }
        const data = new FormData(form);
        const payload = {
          bucket_key: String(data.get('bucket_key') || ''),
          capacity: Number(data.get('capacity')),
          refill_per_second: Number(data.get('refill_per_second')),
          duration_seconds: Number(data.get('duration_seconds')),
          reason: String(data.get('reason') || '').trim(),
        };
        if (
          !payload.bucket_key ||
          !Number.isFinite(payload.capacity) ||
          !Number.isFinite(payload.refill_per_second) ||
          !Number.isFinite(payload.duration_seconds) ||
          !payload.reason
        ) {
          showBanner('All fields required (reason is audited).');
          return;
        }
        overrideSubmitting = true;
        form.setAttribute('aria-busy', 'true');
        const controls = Array.from(form.elements);
        const disabledBefore = controls.map((control) => control.disabled);
        controls.forEach((control) => {
          control.disabled = true;
        });
        const submit = form.querySelector('button[type="submit"]');
        const submitText = submit ? submit.textContent : '';
        if (!beginAccountMutation(submit)) return;
        const overrideSnapshot = fetchAccountOverrides().catch(() => null);
        if (submit) submit.textContent = 'Applying…';
        showBanner('Applying override…');
        return overrideSnapshot
          .then((snapshot) =>
            authedFetch(
              '/v1/admin/accounts/' + encodeURIComponent(prefixedId) + '/quota-override',
              {
                method: 'POST',
                body: JSON.stringify(payload),
              },
            )
              .then(mutationJson)
              .catch(async (err) => {
                if (err && err.name === 'AbortError') {
                  await reconcileOverrideSet(payload, snapshot);
                  return null;
                }
                throw err;
              }),
          )
          .then((body) => {
            if (body === null) return;
            showBanner('Override applied for bucket "' + payload.bucket_key + '".');
            hideOverrideForm(true);
            load();
          })
          .catch((err) => {
            const msg = requestErrorMessage(err);
            showBanner("Couldn't apply override (" + msg + ').');
          })
          .finally(() => {
            overrideSubmitting = false;
            form.removeAttribute('aria-busy');
            controls.forEach((control, index) => {
              control.disabled = disabledBefore[index];
            });
            if (submit) submit.textContent = submitText;
            endAccountMutation(submit);
          });
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action]');
        if (!btn) return;
        const action = btn.getAttribute('data-action');
        if (!action) return;
        ev.preventDefault();
        if (blockedAuditActions.has(action)) {
          showBlockedAuditAction(action === 'add-note' ? 'note' : 'refund');
          return;
        }
        if (
          !token &&
          (action === 'change-tier' ||
            action === 'suspend' ||
            action === 'unsuspend' ||
            action === 'set-override' ||
            action === 'add-note' ||
            action === 'record-refund')
        ) {
          showBanner('Sign in with a staff admin account to perform this action.');
          return;
        }
        const mutationHandler =
          action === 'change-tier'
            ? changeTier
            : action === 'suspend'
              ? suspend
              : action === 'unsuspend'
                ? unsuspend
                : action === 'add-note'
                  ? addSupportNote
                  : action === 'record-refund'
                    ? recordRefund
                    : null;
        if (mutationHandler) {
          if (!beginAccountMutation(btn)) return;
          mutationHandler().finally(() => endAccountMutation(btn));
        } else if (action === 'set-override') showOverrideForm();
        else if (action === 'cancel-override') hideOverrideForm(false);
      });

      // V-281 — audit-only support tooling.
      async function addSupportNote() {
        if (blockedAuditActions.has('add-note')) {
          showBlockedAuditAction('note');
          return;
        }
        const note = await window.driftstackPrompt(
          'Support note (free-form, max 2000 chars). Recorded on this customer\'s audit log + admin audit:',
          { placeholder: 'note…', confirmLabel: 'Record note' },
        );
        if (!note || !note.trim()) return;
        const payload = { note: note.trim() };
        const auditIdsBefore = new Set(auditEntries.map((entry) => entry.id).filter(Boolean));
        showBanner('Recording support note…');
        return authedFetch('/v1/admin/accounts/' + encodeURIComponent(prefixedId) + '/audit-note', {
          method: 'POST',
          body: JSON.stringify(payload),
        })
          .then(mutationJson)
          .then(() => {
            showBanner('Support note recorded.');
            load();
          })
          .catch(async (err) => {
            if (err && err.name === 'AbortError') {
              await reconcileAuditOnlyWrite('note', payload, auditIdsBefore);
              return;
            }
            const msg = requestErrorMessage(err);
            showBanner("Couldn't record note (" + msg + ').');
          });
      }

      async function recordRefund() {
        if (blockedAuditActions.has('record-refund')) {
          showBlockedAuditAction('refund');
          return;
        }
        const externalRef = await window.driftstackPrompt(
          'Stripe charge / payment_intent / invoice id (the actual refund happens via Stripe dashboard):',
          { placeholder: 'ch_… / pi_… / in_…' },
        );
        if (!externalRef || !externalRef.trim()) return;
        const amountStr = await window.driftstackPrompt('Refund amount in cents (e.g. 299 for $2.99):', {
          placeholder: '299',
        });
        const amount_cents = Number(amountStr);
        if (!Number.isInteger(amount_cents) || amount_cents <= 0) {
          showBanner('Refund amount must be a positive integer (cents).');
          return;
        }
        const reason = await window.driftstackPrompt(
          'Reason (recorded in customer audit log + admin audit):',
          { confirmLabel: 'Record refund' },
        );
        if (!reason || !reason.trim()) {
          showBanner('Refund reason is required.');
          return;
        }
        const payload = {
          external_reference: externalRef.trim(),
          amount_cents,
          reason: reason.trim(),
        };
        const auditIdsBefore = new Set(auditEntries.map((entry) => entry.id).filter(Boolean));
        showBanner('Recording refund (audit-only)…');
        return authedFetch('/v1/admin/accounts/' + encodeURIComponent(prefixedId) + '/refund-record', {
          method: 'POST',
          body: JSON.stringify(payload),
        })
          .then(mutationJson)
          .then(() => {
            showBanner(
              'Refund recorded. Reminder: actual refund is issued via Stripe dashboard — this endpoint is audit-only.',
            );
            load();
          })
          .catch(async (err) => {
            if (err && err.name === 'AbortError') {
              await reconcileAuditOnlyWrite('refund', payload, auditIdsBefore);
              return;
            }
            const msg = requestErrorMessage(err);
            showBanner("Couldn't record refund (" + msg + ').');
          });
      }

      if (overrideForm instanceof HTMLFormElement) {
        overrideForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          submitOverride(overrideForm);
        });
      }

      function start() {
        // AdminLayout consumes the SSO hash and writes this token in its trailing
        // script. Defer the read until parsing completes so a fresh sign-in does
        // not permanently capture null in this page's earlier slotted script.
        token = localStorage.getItem('ds_web_session_token');
        if (!token) {
          showBanner('Sign in with a staff admin account to see live data. Showing preview below.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return;
        }
        load();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
