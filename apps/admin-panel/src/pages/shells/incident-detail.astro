---
import AdminLayout from '../../layouts/AdminLayout.astro';

// This is a deterministic static shell. Cloudflare Pages internally rewrites
// /incidents/<id> here without changing the browser URL; the inline script
// derives the live id from window.location and fills the shell from the
// authenticated API. Arbitrary incident deep links therefore work without
// a Pages Worker or SSR adapter.
const incident = {
  id: '',
  title: 'Incident',
  description: '',
  severity: 'minor' as 'minor' | 'major' | 'outage',
  status: 'investigating' as 'investigating' | 'identified' | 'monitoring' | 'resolved',
  affectedComponents: [] as string[],
  public: true,
  startedAt: null as string | null,
  resolvedAt: null as string | null,
  updates: [] as { id: string; message: string; status: string; postedAt: string }[],
};

// V-344 — apiBaseUrl exposed to inline script for live form wiring.
import { resolveApiBaseUrl } from '../../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const SEVERITY_BADGE: Record<string, string> = {
  minor: 'bg-amber-50 text-amber-700',
  major: 'bg-orange-50 text-orange-700',
  outage: 'bg-red-50 text-red-700',
};

const STATUS_BADGE: Record<string, string> = {
  investigating: 'bg-amber-50 text-amber-700',
  identified: 'bg-blue-50 text-blue-700',
  monitoring: 'bg-indigo-50 text-indigo-700',
  resolved: 'bg-emerald-50 text-emerald-700',
};

const isResolved = incident.status === 'resolved';
---

<AdminLayout title={`Incident · ${incident.title}`}>
  <div class="mx-auto max-w-4xl px-6 py-10">
    <a href="/incidents" class="text-sm text-tk-accent hover:underline">← Back to incidents</a>

    <div
      data-banner
      class="mt-4 mb-2 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    ></div>

    <header class="mt-4 mb-8" data-page="admin-incident-detail">
      <div class="flex flex-wrap items-center gap-2">
        <span
          data-field="severity-badge"
          class:list={[
            'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
            SEVERITY_BADGE[incident.severity] ?? '',
          ]}
        >
          {incident.severity}
        </span>
        <span
          data-field="status-badge"
          class:list={[
            'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
            STATUS_BADGE[incident.status] ?? '',
          ]}
        >
          {incident.status}
        </span>
        <span
          data-field="private-badge"
          class:list={[
            'inline-flex rounded-full bg-tk-hover px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-tk-ink-2',
            incident.public ? 'hidden' : '',
          ]}
        >
          private
        </span>
      </div>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-tk-ink" data-field="title">{incident.title}</h1>
      <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
      <p class="mt-1 font-mono text-xs text-tk-ink-3" data-field="id">{incident.id}</p>
      <p class="mt-2 text-sm text-tk-ink-3" data-field="meta">
        Started {fmtIso(incident.startedAt)}
        {incident.resolvedAt && (
          <>
            {' '}· resolved {fmtIso(incident.resolvedAt)}
          </>
        )}
        {incident.affectedComponents.length > 0 && (
          <>
            {' '}· affecting {incident.affectedComponents.join(', ')}
          </>
        )}
      </p>
    </header>

    <!-- Timeline -->
    <section class="dashboard-card mb-8">
      <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
              </svg>
            </span>
            Timeline
          </h2>
      <ol class="mt-4 space-y-4 border-l border-tk-border pl-5" data-list="timeline">
        {incident.updates.map((u) => (
          <li class="relative">
            <span class="absolute -left-[27px] top-1 inline-block h-3 w-3 rounded-full border-2 border-white bg-tk-accent ring-1 ring-tk-accent" />
            <div class="flex items-baseline gap-2">
              <span
                class:list={[
                  'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                  STATUS_BADGE[u.status] ?? '',
                ]}
              >
                {u.status}
              </span>
              <span class="text-xs text-tk-ink-3">{fmtIso(u.postedAt)}</span>
            </div>
            <p class="mt-1 text-sm text-tk-ink-2">{u.message}</p>
          </li>
        ))}
      </ol>
    </section>

    {/* Active-incident forms (Post update + Mark resolved). Always rendered in
        the static shell (the build can't know the live status
        at build time); the inline script reveals or hides this group based on
        the live status returned from GET /v1/admin/incidents/:id. Initial
        hidden state derives from the shell's isResolved. */}
    <div data-form-group="active" class:list={[isResolved ? 'hidden' : '']}>
          <!-- Add-update form -->
          <section class="dashboard-card mb-6">
            <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </span>
            Post update
          </h2>
            <form id="add-update-form" class="mt-4 space-y-4">
              <div>
                <label class="block text-sm font-medium text-tk-ink-2" for="update-status">
                  Status
                </label>
                <select
                  id="update-status"
                  name="status"
                  class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
                >
                  <option value="investigating">Investigating</option>
                  <option value="identified">Identified</option>
                  <option value="monitoring" selected>Monitoring</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-tk-ink-2" for="update-message">
                  Message
                </label>
                <textarea
                  id="update-message"
                  name="message"
                  rows="3"
                  required
                  class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
                ></textarea>
              </div>
              <div class="flex justify-end border-t border-slate-100 pt-4">
                <button
                  type="submit"
                  class="inline-flex items-center rounded-md bg-tk-accent px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-tk-accent-hover focus:outline-none focus:ring-2 focus:ring-tk-accent focus:ring-offset-2"
                >
                  Post update
                </button>
              </div>
            </form>
          </section>

          <!-- Resolve form -->
          <section class="dashboard-card border-emerald-200 bg-emerald-50/30">
            <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" />
              </svg>
            </span>
            Mark resolved
          </h2>
            <p class="mt-1 text-sm text-tk-ink-2">
              Posts a final timeline entry with status “resolved” and stamps
              <code>resolved_at</code>. The status page will show a green banner once propagated.
            </p>
            <form id="resolve-form" class="mt-4 space-y-4">
              <div>
                <label class="block text-sm font-medium text-tk-ink-2" for="resolve-message">
                  Resolution summary
                </label>
                <textarea
                  id="resolve-message"
                  name="message"
                  rows="3"
                  required
                  placeholder="Rolled back the bad deploy. Monitoring complete; error rate normal."
                  class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
                ></textarea>
              </div>
              <div class="flex justify-end border-t border-emerald-100 pt-4">
                <button
                  type="submit"
                  class="inline-flex items-center rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2"
                >
                  Resolve incident
                </button>
              </div>
            </form>
          </section>
    </div>

    {/* 2026-05-22 — admin reopen flow for false-alarm correction
        or regression on a previously-resolved issue. Only shows
        when incident is in 'resolved' state. Same body shape as
        the resolve form (just a message); audit-action
        'incident.reopened' via migration 0063. Always rendered in the static
        DOM; the inline script reveals it only when the live status is
        resolved (initial hidden state derives from the shell's isResolved). */}
    <div data-form-group="resolved" class:list={[isResolved ? '' : 'hidden']}>
        <section class="dashboard-card mb-6 border-amber-200 bg-amber-50/30">
          <h2 class="flex items-center gap-2 text-lg font-semibold tracking-tight text-tk-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
              </svg>
            </span>
            Reopen incident
          </h2>
          <p class="mt-2 text-sm text-tk-ink-2">
            Reverts to <code>investigating</code> + clears
            <code>resolved_at</code>. Use when the issue resurfaced after
            resolution OR the original resolve was a false alarm. Audit-
            logged.
          </p>
          <form id="reopen-form" class="mt-4 space-y-4">
            <div>
              <label class="block text-sm font-medium text-tk-ink-2" for="reopen-message">
                Reason for reopen
              </label>
              <textarea
                id="reopen-message"
                name="message"
                rows="3"
                required
                minlength="3"
                maxlength="2000"
                placeholder="Recurrence detected: same probe failing again."
                class="mt-1 w-full rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-amber-700 focus:outline-none focus:ring-1 focus:ring-amber-700"
              />
            </div>
            <div class="flex justify-end">
              <button
                type="submit"
                class="rounded-md bg-amber-700 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-800"
              >
                Reopen incident
              </button>
            </div>
          </form>
        </section>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    // V-344 — wires Post-update + Mark-resolved forms to the live
    // /v1/admin/incidents/:id/{updates,resolve} endpoints. Replaces
    // the V-295a alert-stubs.
    (function () {
      const banner = document.querySelector('[data-banner]');
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const incidentId =
        pathParts.length === 2 && pathParts[0] === 'incidents' ? pathParts[1] || '' : '';
      const INCIDENT_TIMEOUT_MS = 15_000;
      let loadController = null;
      let loadGeneration = 0;
      let latestIncident = null;
      let latestUpdates = [];

      function boundedFetch(url, init, controller) {
        const activeController = controller || new AbortController();
        return window.driftstackFetchWithDeadline(
          url,
          init,
          INCIDENT_TIMEOUT_MS,
          activeController,
        );
      }

      function requestErrorMessage(err, fallback) {
        return err && err.name === 'AbortError'
          ? 'Request timed out. Try again.'
          : err && err.message
            ? err.message
            : fallback;
      }

      // Branded inline banner — replaces native alert() (2026-05-29
      // "no alert boxes everywhere"). Matches the showBanner pattern used
      // across the admin panel (status-subscribers / leads): role="status"
      // div that swaps to a red error treatment when isError is set.
      function showBanner(msg, isError) {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove('hidden');
        if (isError) {
          banner.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
        } else {
          banner.classList.remove('border-red-200', 'bg-red-50', 'text-red-700');
        }
      }

      function getToken() {
        try {
          return localStorage.getItem('ds_web_session_token') || '';
        } catch (_) {
          return '';
        }
      }

      // V-200* — populate the page from the live incident at request time.
      // The built body is only a paint shell. loadIncident()
      // fetches GET /v1/admin/incidents/:id and rewrites the header, timeline,
      // and form-group visibility from the live status.
      const SEVERITY_BADGE = {
        minor: 'bg-amber-50 text-amber-700',
        major: 'bg-orange-50 text-orange-700',
        outage: 'bg-red-50 text-red-700',
      };
      const STATUS_BADGE = {
        investigating: 'bg-amber-50 text-amber-700',
        identified: 'bg-blue-50 text-blue-700',
        monitoring: 'bg-indigo-50 text-indigo-700',
        resolved: 'bg-emerald-50 text-emerald-700',
      };
      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          if (c === '&') return '&amp;';
          if (c === '<') return '&lt;';
          if (c === '>') return '&gt;';
          if (c === '"') return '&quot;';
          return '&#39;';
        });
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }
      function setText(field, text) {
        const el = document.querySelector('[data-field="' + field + '"]');
        if (el) el.textContent = text;
      }

      function applyIncident(inc, updates) {
        const sevBadge = document.querySelector('[data-field="severity-badge"]');
        if (sevBadge) {
          sevBadge.textContent = inc.severity;
          sevBadge.className =
            'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
            (SEVERITY_BADGE[inc.severity] || '');
        }
        const statusBadge = document.querySelector('[data-field="status-badge"]');
        if (statusBadge) {
          statusBadge.textContent = inc.status;
          statusBadge.className =
            'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
            (STATUS_BADGE[inc.status] || '');
        }
        const privBadge = document.querySelector('[data-field="private-badge"]');
        if (privBadge) {
          if (inc.public) privBadge.classList.add('hidden');
          else privBadge.classList.remove('hidden');
        }
        setText('title', inc.title);
        setText('id', inc.id);
        const meta = document.querySelector('[data-field="meta"]');
        if (meta) {
          let metaText = 'Started ' + fmtIso(inc.started_at);
          if (inc.resolved_at) metaText += ' · resolved ' + fmtIso(inc.resolved_at);
          const components = inc.affected_components || [];
          if (components.length > 0) metaText += ' · affecting ' + components.join(', ');
          meta.textContent = metaText;
        }
        const titleEl = document.querySelector('title');
        if (titleEl) titleEl.textContent = 'Incident · ' + inc.title + ' · Driftstack admin';

        // Timeline.
        const timeline = document.querySelector('[data-list="timeline"]');
        if (timeline) {
          const rows = (updates || [])
            .map(function (u) {
              return (
                '<li class="relative">' +
                '<span class="absolute -left-[27px] top-1 inline-block h-3 w-3 rounded-full border-2 border-white bg-tk-accent ring-1 ring-tk-accent"></span>' +
                '<div class="flex items-baseline gap-2">' +
                '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
                (STATUS_BADGE[u.status] || '') +
                '">' +
                escapeHtml(u.status) +
                '</span>' +
                '<span class="text-xs text-tk-ink-3">' +
                escapeHtml(fmtIso(u.posted_at)) +
                '</span></div>' +
                '<p class="mt-1 text-sm text-tk-ink-2">' +
                escapeHtml(u.message) +
                '</p></li>'
              );
            })
            .join('');
          timeline.innerHTML =
            rows ||
            '<li class="text-sm text-tk-ink-3">No timeline updates yet.</li>';
        }

        // Form-group visibility: active forms (post-update + resolve) when not
        // resolved; reopen form when resolved.
        const isResolved = inc.status === 'resolved';
        const activeGroup = document.querySelector('[data-form-group="active"]');
        const resolvedGroup = document.querySelector('[data-form-group="resolved"]');
        if (activeGroup) {
          if (isResolved) activeGroup.classList.add('hidden');
          else activeGroup.classList.remove('hidden');
        }
        if (resolvedGroup) {
          if (isResolved) resolvedGroup.classList.remove('hidden');
          else resolvedGroup.classList.add('hidden');
        }
      }

      function loadIncident() {
        if (loadController) loadController.abort();
        const generation = ++loadGeneration;
        const token = getToken();
        if (!incidentId) {
          showBanner('Invalid incident link.', true);
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return Promise.resolve(false);
        }
        if (!token) {
          showBanner('Sign in with a staff admin account to see this incident.', true);
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return Promise.resolve(false);
        }
        const controller = new AbortController();
        loadController = controller;
        return boundedFetch(
          apiBaseUrl + '/v1/admin/incidents/' + encodeURIComponent(incidentId),
          { headers: { authorization: 'Bearer ' + token } },
          controller,
        )
          .then(function (r) {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            if (r.status === 404) return Promise.reject(new Error('not-found'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then(function (body) {
            if (generation !== loadGeneration) return false;
            if (!body || !body.incident) return false;
            latestIncident = body.incident;
            latestUpdates = Array.isArray(body.updates) ? body.updates : [];
            applyIncident(latestIncident, latestUpdates);
            return true;
          })
          .catch(function (err) {
            if (generation !== loadGeneration) return;
            const msg = requestErrorMessage(err, 'network error');
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
                true,
              );
            } else if (msg === 'not-found') {
              showBanner('Incident not found.', true);
            } else {
              showBanner("Couldn't load incident (" + msg + ').', true);
            }
            return false;
          })
          .finally(function () {
            if (generation !== loadGeneration) return;
            loadController = null;
            if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          });
      }

      let incidentMutationInFlight = false;
      let incidentMutationBlocked = false;
      let incidentMutationBlockReason = '';
      let incidentMutationControls = [];
      function beginIncidentMutation(activeSubmit) {
        if (incidentMutationInFlight || incidentMutationBlocked) return false;
        incidentMutationInFlight = true;
        incidentMutationControls = Array.from(
          document.querySelectorAll(
            '#add-update-form input, #add-update-form select, #add-update-form textarea, #add-update-form button, ' +
              '#resolve-form input, #resolve-form select, #resolve-form textarea, #resolve-form button, ' +
              '#reopen-form input, #reopen-form select, #reopen-form textarea, #reopen-form button',
          ),
        ).map(function (control) {
          const state = { control: control, disabled: control.disabled };
          control.disabled = true;
          return state;
        });
        if (activeSubmit) {
          activeSubmit.setAttribute('aria-busy', 'true');
          activeSubmit.dataset.origText = activeSubmit.textContent || '';
          activeSubmit.textContent = 'Posting…';
        }
        return true;
      }

      function endIncidentMutation(activeSubmit) {
        incidentMutationControls.forEach(function (state) {
          state.control.disabled = incidentMutationBlocked ? true : state.disabled;
        });
        incidentMutationControls = [];
        incidentMutationInFlight = false;
        if (activeSubmit) {
          activeSubmit.removeAttribute('aria-busy');
          activeSubmit.textContent = incidentMutationBlocked
            ? incidentMutationBlockReason === 'completed'
              ? 'Already applied'
              : 'Verify before retrying'
            : activeSubmit.dataset.origText || 'Submit';
          if (incidentMutationBlocked) {
            activeSubmit.title =
              incidentMutationBlockReason === 'completed'
                ? 'The refreshed incident already contains this change. Reload before another mutation.'
                : 'Reload and verify the incident before retrying.';
          } else {
            activeSubmit.removeAttribute('title');
          }
          delete activeSubmit.dataset.origText;
        }
      }

      function updateIdentity(update) {
        return update && update.id
          ? String(update.id)
          : [update && update.status, update && update.message, update && update.posted_at]
              .map(function (value) {
                return String(value || '');
              })
              .join('\u0000');
      }

      function bind(formId, urlSuffix, includeStatus) {
        const form = document.getElementById(formId);
        if (!form) return;
        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          if (incidentMutationInFlight || incidentMutationBlocked) return;
          const token = getToken();
          if (!token) {
            showBanner('Sign in with a staff admin account before posting.', true);
            return;
          }
          const fd = new FormData(form);
          const message = (fd.get('message') || '').toString().trim();
          if (!message) return;
          const body = { message: message };
          if (includeStatus) {
            body.status = (fd.get('status') || 'monitoring').toString();
          }
          const incidentStatusBefore = latestIncident && latestIncident.status;
          const updateIdentitiesBefore = new Set(latestUpdates.map(updateIdentity));
          const submit = form.querySelector('button[type="submit"]');
          if (!beginIncidentMutation(submit)) return;
          boundedFetch(apiBaseUrl + '/v1/admin/incidents/' + encodeURIComponent(incidentId) + urlSuffix, {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: 'Bearer ' + token,
            },
            body: JSON.stringify(body),
          })
            .then(function (r) {
              if (!r.ok) {
                return r
                  .json()
                  .catch(function () {
                    return {};
                  })
                  .then(function (b) {
                    return Promise.reject(new Error(b.detail || 'HTTP ' + r.status));
                  });
              }
              return r.json();
            })
            .then(function () {
              window.location.reload();
            })
            .catch(async function (err) {
              if (err && err.name === 'AbortError') {
                const refreshed = await loadIncident();
                const completed =
                  refreshed &&
                  (urlSuffix === '/updates'
                    ? latestUpdates.some(function (update) {
                        return (
                          !updateIdentitiesBefore.has(updateIdentity(update)) &&
                          String(update.message || '').trim() === message &&
                          (!includeStatus || String(update.status || '') === body.status)
                        );
                      })
                    : urlSuffix === '/resolve'
                      ? incidentStatusBefore !== 'resolved' &&
                        latestIncident &&
                        latestIncident.status === 'resolved'
                      : incidentStatusBefore === 'resolved' &&
                        latestIncident &&
                        latestIncident.status !== 'resolved');
                if (completed) {
                  incidentMutationBlocked = true;
                  incidentMutationBlockReason = 'completed';
                  showBanner(
                    urlSuffix === '/updates'
                      ? 'The request timed out, but the refreshed timeline contains a new exact message and status. It was not posted again.'
                      : urlSuffix === '/resolve'
                        ? 'The request timed out, but the refreshed incident is resolved. Resolve was not submitted again.'
                        : 'The request timed out, but the refreshed incident is active again. Reopen was not submitted again.',
                    true,
                  );
                } else if (refreshed) {
                  showBanner(
                    'The request timed out, but the refreshed incident does not contain the submitted change. You can retry if it is still needed.',
                    true,
                  );
                } else {
                  incidentMutationBlocked = true;
                  incidentMutationBlockReason = 'unverified';
                  showBanner(
                    "The mutation request timed out and we couldn't refresh the incident. Reload and verify it before retrying; another submission could duplicate a timeline entry or repeat a state transition.",
                    true,
                  );
                }
                return;
              }
              showBanner(
                'Post failed: ' + requestErrorMessage(err, 'network error'),
                true,
              );
            })
            .finally(function () {
              endIncidentMutation(submit);
            });
        });
      }

      bind('add-update-form', '/updates', true);
      bind('resolve-form', '/resolve', false);
      // 2026-05-22 — incident reopen handler. Same body shape as
      // resolve (just a message field). bind() handles the POST +
      // page reload pattern.
      bind('reopen-form', '/reopen', false);

      // Populate from the live incident at request time, then reveal the page
      // (AdminLayout opacity-gate). The forms are wired above regardless so
      // their submit handlers are ready by the time the data lands.
      function start() {
        loadIncident();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
