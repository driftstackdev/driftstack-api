---
import AdminLayout from '../layouts/AdminLayout.astro';
import { ARCHETYPE_REGISTRY, archetypeDisplayLabel } from '@driftstack/api-types';

// V-192 — progressive-enhancement against /v1/admin/sessions (new in
// V-192). SSG renders an inert shell; an inline <script> reads
// ds_web_session_token from localStorage, fetches with bearer auth, and
// replaces the table.
// Filter bar wired (status select + account_id text input). Force-
// destroy button wired against POST /v1/admin/sessions/:id/destroy.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
// Friendly archetype labels (slug → "iPhone 17 / iOS 18.7 / Safari 26.4")
// for the operator's session list — injected into the client script + used for
// live row renderer, so the device shows readable, not a raw slug.
const ARCHETYPE_LABELS = Object.fromEntries(
  ARCHETYPE_REGISTRY.map((a) => [a.id, archetypeDisplayLabel(a.id)]),
);
---

<AdminLayout title="Sessions">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-sessions">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Sessions</h1>
      <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Live and recent customer sessions across all accounts. Force-destroy is
          the only mutation surfaced here; everything else (replay, view recording)
          flows through the per-account detail surface.
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as 2d358ce7. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-amber-500"
          ></span>
          <span data-live-status>Waiting for live data</span>
          <span data-live-age class="hidden"></span>
        </span>
        <button
          type="button"
          data-live-refresh
          disabled
          aria-disabled="true"
          title="Available after staff sign-in"
          class="text-tk-accent hover:underline disabled:cursor-not-allowed disabled:opacity-50"
        >
          Refresh now
        </button>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <select
        data-field="status"
        aria-label="Filter sessions by status"
        class="rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      >
        <option value="">All statuses</option>
        <option value="creating">creating</option>
        <option value="ready">ready</option>
        <option value="busy">busy</option>
        <option value="destroyed">destroyed</option>
        <option value="errored">errored</option>
      </select>
      <input
        type="search"
        data-field="account-id"
        aria-label="Filter sessions by account id"
        placeholder="Account id (acc_<uuid>)"
        class="w-72 rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      />
    </div>

    <div class="overflow-x-auto rounded-lg border border-tk-border bg-tk-surface">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-tk-border text-left text-xs font-medium uppercase tracking-wide text-tk-ink-3">
            <th class="px-4 py-3">Session</th>
            <th class="px-4 py-3">Account</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Started</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-list="sessions">
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-sm text-tk-ink-3">
              Live sessions are unavailable until loaded.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-tk-ink-3" data-field="footnote">
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl, archetypeLabels: ARCHETYPE_LABELS }}>
    (function () {
      const root = document.querySelector('[data-page="admin-sessions"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const tbody = root.querySelector('[data-list="sessions"]');
      const footnote = root.querySelector('[data-field="footnote"]');
      const statusEl = root.querySelector('[data-field="status"]');
      const accountIdEl = root.querySelector('[data-field="account-id"]');
      const liveDot = root.querySelector('[data-live-dot]');
      const liveStatus = root.querySelector('[data-live-status]');
      const liveAge = root.querySelector('[data-live-age]');
      const refreshBtn = root.querySelector('[data-live-refresh]');
      let token = null;
      const SESSION_TIMEOUT_MS = 15_000;
      let loadController = null;
      const destroysInFlight = new Set();

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, SESSION_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      const STATUS_BADGE = {
        creating: 'bg-amber-50 text-amber-700',
        ready: 'bg-emerald-50 text-emerald-700',
        busy: 'bg-blue-50 text-blue-700',
        destroyed: 'bg-tk-hover text-tk-ink-2',
        errored: 'bg-red-50 text-red-700',
      };

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }
      // Friendly device label via the injected registry map; raw slug if unknown.
      function archetypeLabel(slug) {
        if (!slug) return '—';
        return (archetypeLabels && archetypeLabels[slug]) || slug;
      }

      function renderSessionsUnavailable(message) {
        if (tbody) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-tk-ink-3">' +
            escapeHtml(message) +
            '</td></tr>';
        }
        if (footnote) footnote.textContent = '';
      }

      function setLiveState(state, message) {
        if (liveDot) {
          const color =
            state === 'ready'
              ? 'bg-emerald-500'
              : state === 'failed'
                ? 'bg-red-500'
                : 'bg-amber-500';
          liveDot.className = 'inline-block h-2 w-2 rounded-full ' + color;
        }
        if (liveStatus) {
          liveStatus.textContent = message
            ? message
            : state === 'ready'
              ? 'Live · updated'
              : state === 'failed'
                ? 'Live refresh failed'
                : 'Loading live data';
        }
        if (liveAge) liveAge.classList.toggle('hidden', state !== 'ready');
      }

      function destroyControlState(id) {
        const pending = destroysInFlight.has(String(id));
        return {
          pending,
          attrs: pending
            ? ' disabled aria-disabled="true" aria-busy="true" title="Wait for the current force-destroy action to finish."'
            : '',
          label: pending ? 'Destroy pending…' : 'Force destroy',
        };
      }

      function syncDestroyControls(id) {
        const state = destroyControlState(id);
        root.querySelectorAll('[data-action="destroy"]').forEach((control) => {
          if (control.getAttribute('data-id') !== String(id)) return;
          control.disabled = state.pending;
          control.textContent = state.label;
          if (state.pending) {
            control.setAttribute('aria-disabled', 'true');
            control.setAttribute('aria-busy', 'true');
            control.title = 'Wait for the current force-destroy action to finish.';
          } else {
            control.removeAttribute('aria-disabled');
            control.removeAttribute('aria-busy');
            control.removeAttribute('title');
          }
        });
      }

      function rowHtml(s) {
        const destroyState = destroyControlState(s.id);
        const destroyBtn =
          s.status !== 'destroyed'
            ? '<button type="button" data-action="destroy" data-id="' +
              escapeHtml(s.id) +
              '"' +
              destroyState.attrs +
              ' class="text-sm text-red-700 hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-60">' +
              destroyState.label +
              '</button>'
            : '';
        return (
          '<tr class="hover:bg-tk-bg">' +
          '<td class="px-4 py-3">' +
          '<p class="font-mono text-xs text-tk-ink">' +
          escapeHtml(s.id) +
          '</p>' +
          '<p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">' +
          escapeHtml(archetypeLabel(s.archetype)) +
          '</p></td>' +
          // Show the account email as the primary line (with the UUID
          // secondary), like the Accounts list — so an operator can tell
          // whose session this is without copying the id into /accounts.
          // Falls back to the bare UUID when the server hasn't enriched
          // the row with account_email yet.
          '<td class="px-4 py-3">' +
          (s.account_email
            ? '<p class="text-sm text-tk-ink">' +
              escapeHtml(s.account_email) +
              '</p>' +
              '<p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">' +
              escapeHtml(s.account_id) +
              '</p>'
            : '<p class="font-mono text-[11px] text-tk-ink-3">' +
              escapeHtml(s.account_id) +
              '</p>') +
          '</td>' +
          '<td class="px-4 py-3">' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (STATUS_BADGE[s.status] || '') +
          '">' +
          escapeHtml(s.status) +
          '</span>' +
          // Arc 5 EGRESS eg.5.c — admin-panel proxy-warning badge.
          // Same logic as customer-dashboard eg.5/5.b; admins
          // inspecting sessions for support tickets need the same
          // capability-warning indicator.
          (() => {
            const w =
              s.egress_capabilities && Array.isArray(s.egress_capabilities.warnings)
                ? s.egress_capabilities.warnings
                : [];
            return w.length > 0
              ? ' <span class="ml-1 inline-flex rounded-full bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-amber-700" title="' +
                  escapeHtml(w.join(', ')) +
                  '">⚠ proxy ' +
                  w.length +
                  '</span>'
              : '';
          })() +
          '</td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(fmtIso(s.created_at)) +
          '</td>' +
          '<td class="px-4 py-3 text-right">' +
          destroyBtn +
          '</td></tr>'
        );
      }

      function buildQuery() {
        const params = new URLSearchParams();
        params.set('limit', '50');
        if (statusEl && statusEl.value) params.set('status', statusEl.value);
        if (accountIdEl && accountIdEl.value.trim())
          params.set('account_id', accountIdEl.value.trim());
        return params;
      }

      let inFlight = 0;
      function load() {
        if (!token) return Promise.resolve(false);
        const myReq = ++inFlight;
        const params = buildQuery();
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          apiBaseUrl + '/v1/admin/sessions?' + params.toString(),
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return false;
            const rows = body.data || [];
            if (tbody) {
              if (rows.length === 0) {
                tbody.innerHTML =
                  '<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-tk-ink-3">No sessions match the current filter.</td></tr>';
              } else {
                tbody.innerHTML = rows.map(rowHtml).join('');
              }
            }
            if (footnote) {
              footnote.textContent =
                'Showing ' +
                rows.length +
                ' session' +
                (rows.length === 1 ? '' : 's') +
                '. Force-destroy fires POST /v1/admin/sessions/:id/destroy with audit log.';
            }
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (myReq !== inFlight) return false;
            const msg = requestErrorMessage(err, 'network error');
            renderSessionsUnavailable(
              'Could not load live sessions — nothing to act on. Resolve the error above and retry.',
            );
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load live sessions (" + msg + ').');
            }
            return false;
          })
          .finally(() => {
            if (myReq === inFlight) {
              loadController = null;
              root.removeAttribute('aria-busy');
            }
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      // 2026-05-22 — destroy button shows in-flight state to prevent
      // double-clicks. The button is dynamically rendered so we grab
      // a reference to the exact element clicked + restore it on
      // success/error.
      async function destroy(id, btn) {
        if (!token || destroysInFlight.has(id)) return;
        destroysInFlight.add(id);
        syncDestroyControls(id);
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Confirming…';
          btn.setAttribute('aria-busy', 'true');
        }
        // Force-destroy ends a live customer browser session immediately —
        // gate it behind an explicit yes/no confirm first (destructive: true
        // means a stray Enter can't fire it; the operator must click OK),
        // matching every other destructive admin action (suspend / drain /
        // restart). Without this, OK/Enter on the optional-reason prompt
        // alone destroyed the session.
        try {
          const confirmed = await window.driftstackConfirm(
            'Force-destroy session ' + id + "? This ends the customer's live browser session immediately.",
            { confirmLabel: 'Force-destroy', destructive: true },
          );
          if (!confirmed) return;
          if (btn) btn.textContent = 'Reason…';
          const reason =
            (await window.driftstackPrompt('Reason for force-destroying ' + id + ' (optional):', {
              placeholder: 'optional',
              confirmLabel: 'Force-destroy',
            })) || '';
          const body = {};
          if (reason.trim()) body.reason = reason.trim();
          if (btn) btn.textContent = 'Destroying…';
          showBanner('Destroying ' + id + '…');
          const response = await boundedFetch(
            apiBaseUrl + '/v1/admin/sessions/' + encodeURIComponent(id) + '/destroy',
            {
              method: 'POST',
              headers: {
                authorization: 'Bearer ' + token,
                'content-type': 'application/json',
              },
              credentials: 'include',
              body: JSON.stringify(body),
            },
          );
          if (!response.ok) throw new Error('HTTP ' + response.status);
          // The force-destroy response payload is unused. A successful status
          // is the irreversible boundary; never let malformed response JSON
          // turn a destroyed session into retry guidance.
          showBanner('Destroyed ' + id + '. Refreshing…');
          await load();
        } catch (err) {
          if (err && err.name === 'AbortError') {
            const refreshed = await load();
            const stillActionable = Array.from(
              root.querySelectorAll('[data-action="destroy"]'),
            ).some((button) => button.getAttribute('data-id') === id);
            if (refreshed && !stillActionable) {
              showBanner(
                'Force-destroy outcome is unknown because the response timed out. Live sessions were refreshed and no destroy action remains for ' +
                  id +
                  '; it was likely destroyed, so do not submit the action again.',
              );
            } else if (refreshed) {
              showBanner(
                'Force-destroy outcome is unknown because the response timed out. Live sessions were refreshed and ' +
                  id +
                  ' is still actionable; retry force-destroy if the session must be ended.',
              );
            } else {
              showBanner(
                'Force-destroy outcome is unknown because the response timed out, and live sessions could not be refreshed. Verify the session before retrying.',
              );
            }
          } else {
            showBanner("Couldn't destroy (" + requestErrorMessage(err, 'network error') + ').');
          }
        } finally {
          destroysInFlight.delete(id);
          syncDestroyControls(id);
        }
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action="destroy"]');
        if (!btn) return;
        ev.preventDefault();
        const id = btn.getAttribute('data-id');
        if (id) destroy(id, btn);
      });

      let debounce = 0;
      function scheduleLoad() {
        clearTimeout(debounce);
        debounce = setTimeout(loadWithLive, 200);
      }
      if (statusEl) statusEl.addEventListener('change', scheduleLoad);
      if (accountIdEl) accountIdEl.addEventListener('input', scheduleLoad);

      // 2026-05-22 — live auto-poll. Same pattern as 580b30a7 /
      // 2d358ce7. Session-list reflects newly-spawned customer
      // sessions + status transitions every 30s.
      let lastFetch = Date.now();
      function loadWithLive() {
        setLiveState('loading');
        if (refreshBtn) {
          refreshBtn.disabled = true;
          refreshBtn.setAttribute('aria-disabled', 'true');
        }
        const expectedReq = inFlight + 1;
        const p = load();
        if (p && typeof p.then === 'function') {
          return p.then((loaded) => {
            if (expectedReq !== inFlight) return loaded;
            if (loaded) {
              lastFetch = Date.now();
              if (liveAge) liveAge.textContent = 'just now';
              setLiveState('ready');
            } else {
              setLiveState('failed');
            }
            if (refreshBtn) {
              refreshBtn.disabled = false;
              refreshBtn.removeAttribute('aria-disabled');
            }
            return loaded;
          });
        } else {
          setLiveState('failed');
          if (refreshBtn) {
            refreshBtn.disabled = false;
            refreshBtn.removeAttribute('aria-disabled');
          }
          return Promise.resolve(false);
        }
      }
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      function start() {
        try {
          token = localStorage.getItem('ds_web_session_token');
        } catch {
          token = null;
        }
        if (!token) {
          renderSessionsUnavailable('Sign in with a staff admin account to see live sessions.');
          setLiveState('failed', 'Sign in for live data');
          showBanner('Sign in with a staff admin account to see live data.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return;
        }
        if (refreshBtn) {
          refreshBtn.disabled = false;
          refreshBtn.removeAttribute('aria-disabled');
          refreshBtn.removeAttribute('title');
          refreshBtn.addEventListener('click', loadWithLive);
        }
        setInterval(loadWithLive, 30_000);
        setInterval(() => {
          if (liveAge) liveAge.textContent = fmtAge(lastFetch);
        }, 5_000);
        loadWithLive();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
