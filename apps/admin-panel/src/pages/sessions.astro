---
import AdminLayout from '../layouts/AdminLayout.astro';

// V-192 — progressive-enhancement against /v1/admin/sessions (new in
// V-192). SSG renders mock; an inline <script> reads ds_web_session_token
// from localStorage, fetches with bearer auth, and replaces the table.
// Filter bar wired (status select + account_id text input). Force-
// destroy button wired against POST /v1/admin/sessions/:id/destroy.

interface MockAdminSession {
  id: string;
  accountId: string;
  accountEmail: string;
  status: 'creating' | 'ready' | 'busy' | 'destroyed' | 'errored';
  archetype: string;
  createdAt: string;
  destroyedAt: string | null;
}

const MOCK_SESSIONS: MockAdminSession[] = [
  {
    id: 'ses_00000000-0000-4000-8000-0000000000c1',
    accountId: 'acc_00000000-0000-4000-8000-000000000001',
    accountEmail: 'tester@driftstack.local',
    status: 'ready',
    archetype: 'iphone16pro_ios18_7_safari26_4',
    createdAt: '2026-05-04T11:30:00Z',
    destroyedAt: null,
  },
  {
    id: 'ses_00000000-0000-4000-8000-0000000000c2',
    accountId: 'acc_00000000-0000-4000-8000-000000000002',
    accountEmail: 'agency@driftstack.local',
    status: 'busy',
    archetype: 'iphone16pro_ios18_7_safari26_4',
    createdAt: '2026-05-04T10:15:00Z',
    destroyedAt: null,
  },
  {
    id: 'ses_00000000-0000-4000-8000-0000000000c3',
    accountId: 'acc_00000000-0000-4000-8000-000000000001',
    accountEmail: 'tester@driftstack.local',
    status: 'errored',
    archetype: 'iphone16pro_ios18_7_safari26_4',
    createdAt: '2026-05-04T08:00:00Z',
    destroyedAt: null,
  },
];

const STATUS_BADGE: Record<string, string> = {
  creating: 'bg-amber-50 text-amber-700',
  ready: 'bg-emerald-50 text-emerald-700',
  busy: 'bg-blue-50 text-blue-700',
  destroyed: 'bg-slate-100 text-slate-600',
  errored: 'bg-red-50 text-red-700',
};

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Sessions">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-sessions">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Sessions</span></h1>
        <p class="mt-2 max-w-prose text-sm text-slate-500">
          Live and recent customer sessions across all accounts. Force-destroy is
          the only mutation surfaced here; everything else (replay, view recording)
          flows through the per-account detail surface.
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as 2d358ce7. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-slate-500">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-emerald-500"
          ></span>
          <span>Live · updated <span data-live-age>just now</span></span>
        </span>
        <button
          type="button"
          data-live-refresh
          class="text-oxblood-700 hover:underline"
        >
          Refresh now
        </button>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <select
        data-field="status"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      >
        <option value="">All statuses</option>
        <option value="creating">creating</option>
        <option value="ready">ready</option>
        <option value="busy">busy</option>
        <option value="destroyed">destroyed</option>
        <option value="errored">errored</option>
      </select>
      <input
        type="search"
        data-field="account-id"
        placeholder="Account id (acc_<uuid>)"
        class="w-72 rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      />
    </div>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3">Session</th>
            <th class="px-4 py-3">Account</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Started</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-list="sessions">
          {
            MOCK_SESSIONS.map((session) => (
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <p class="font-mono text-xs text-slate-900">{session.id}</p>
                  <p class="mt-0.5 font-mono text-[11px] text-slate-500">
                    {session.archetype}
                  </p>
                </td>
                <td class="px-4 py-3">
                  <p class="text-sm text-slate-900">{session.accountEmail}</p>
                  <p class="mt-0.5 font-mono text-[11px] text-slate-500">
                    {session.accountId}
                  </p>
                </td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                      STATUS_BADGE[session.status],
                    ]}
                  >
                    {session.status}
                  </span>
                </td>
                <td class="px-4 py-3 text-slate-600">{fmtIso(session.createdAt)}</td>
                <td class="px-4 py-3 text-right">
                  {session.status !== 'destroyed' && (
                    <button
                      type="button"
                      data-action="destroy"
                      data-id={session.id}
                      class="text-sm text-red-700 hover:underline"
                    >
                      Force destroy
                    </button>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-slate-500" data-field="footnote">
      Showing {MOCK_SESSIONS.length} sessions. Force-destroy fires
      <code class="font-mono">POST /v1/admin/sessions/:id/destroy</code> with audit log.
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-sessions"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const tbody = root.querySelector('[data-list="sessions"]');
      const footnote = root.querySelector('[data-field="footnote"]');
      const statusEl = root.querySelector('[data-field="status"]');
      const accountIdEl = root.querySelector('[data-field="account-id"]');
      const token = localStorage.getItem('ds_web_session_token');

      const STATUS_BADGE = {
        creating: 'bg-amber-50 text-amber-700',
        ready: 'bg-emerald-50 text-emerald-700',
        busy: 'bg-blue-50 text-blue-700',
        destroyed: 'bg-slate-100 text-slate-600',
        errored: 'bg-red-50 text-red-700',
      };

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function rowHtml(s) {
        const destroyBtn =
          s.status !== 'destroyed'
            ? '<button type="button" data-action="destroy" data-id="' +
              escapeHtml(s.id) +
              '" class="text-sm text-red-700 hover:underline">Force destroy</button>'
            : '';
        return (
          '<tr class="hover:bg-slate-50">' +
          '<td class="px-4 py-3">' +
          '<p class="font-mono text-xs text-slate-900">' +
          escapeHtml(s.id) +
          '</p>' +
          '<p class="mt-0.5 font-mono text-[11px] text-slate-500">' +
          escapeHtml(s.archetype) +
          '</p></td>' +
          '<td class="px-4 py-3">' +
          '<p class="font-mono text-[11px] text-slate-500">' +
          escapeHtml(s.account_id) +
          '</p></td>' +
          '<td class="px-4 py-3">' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (STATUS_BADGE[s.status] || '') +
          '">' +
          escapeHtml(s.status) +
          '</span>' +
          // Arc 5 EGRESS eg.5.c — admin-panel proxy-warning badge.
          // Same logic as customer-dashboard eg.5/5.b; admins
          // inspecting sessions for support tickets need the same
          // capability-warning indicator.
          (() => {
            const w =
              s.egress_capabilities && Array.isArray(s.egress_capabilities.warnings)
                ? s.egress_capabilities.warnings
                : [];
            return w.length > 0
              ? ' <span class="ml-1 inline-flex rounded-full bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-amber-700" title="' +
                  escapeHtml(w.join(', ')) +
                  '">⚠ proxy ' +
                  w.length +
                  '</span>'
              : '';
          })() +
          '</td>' +
          '<td class="px-4 py-3 text-slate-600">' +
          escapeHtml(fmtIso(s.created_at)) +
          '</td>' +
          '<td class="px-4 py-3 text-right">' +
          destroyBtn +
          '</td></tr>'
        );
      }

      function buildQuery() {
        const params = new URLSearchParams();
        params.set('limit', '50');
        if (statusEl && statusEl.value) params.set('status', statusEl.value);
        if (accountIdEl && accountIdEl.value.trim())
          params.set('account_id', accountIdEl.value.trim());
        return params;
      }

      let inFlight = 0;
      function load() {
        if (!token) return Promise.resolve();
        const myReq = ++inFlight;
        const params = buildQuery();
        return fetch(apiBaseUrl + '/v1/admin/sessions?' + params.toString(), {
          headers: { authorization: 'Bearer ' + token },
          credentials: 'include',
        })
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return;
            const rows = body.data || [];
            if (tbody) {
              if (rows.length === 0) {
                tbody.innerHTML =
                  '<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-slate-500">No sessions match the current filter.</td></tr>';
              } else {
                tbody.innerHTML = rows.map(rowHtml).join('');
              }
            }
            if (footnote) {
              footnote.textContent =
                'Showing ' +
                rows.length +
                ' session' +
                (rows.length === 1 ? '' : 's') +
                '. Force-destroy fires POST /v1/admin/sessions/:id/destroy with audit log.';
            }
            hideBanner();
          })
          .catch((err) => {
            if (myReq !== inFlight) return;
            const msg = err && err.message ? err.message : 'network error';
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load sessions (" + msg + '). Showing preview data below.');
            }
          })
          .finally(() => {
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      // 2026-05-22 — destroy button shows in-flight state to prevent
      // double-clicks. The button is dynamically rendered so we grab
      // a reference to the exact element clicked + restore it on
      // success/error.
      function destroy(id, btn) {
        if (!token) return;
        const reason = window.prompt('Reason for force-destroying ' + id + ' (optional):') || '';
        const body = {};
        if (reason.trim()) body.reason = reason.trim();
        const originalText = btn ? btn.textContent : '';
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Destroying…';
        }
        showBanner('Destroying ' + id + '…');
        fetch(apiBaseUrl + '/v1/admin/sessions/' + encodeURIComponent(id) + '/destroy', {
          method: 'POST',
          headers: {
            authorization: 'Bearer ' + token,
            'content-type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify(body),
        })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
          .then(() => {
            showBanner('Destroyed ' + id + '. Refreshing…');
            load();
          })
          .catch((err) => {
            const msg = err && err.message ? err.message : 'network error';
            showBanner("Couldn't destroy (" + msg + ').');
            if (btn) {
              btn.disabled = false;
              btn.textContent = originalText;
            }
          });
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action="destroy"]');
        if (!btn) return;
        ev.preventDefault();
        const id = btn.getAttribute('data-id');
        if (id) destroy(id, btn);
      });

      let debounce = 0;
      function scheduleLoad() {
        clearTimeout(debounce);
        debounce = setTimeout(load, 200);
      }
      if (statusEl) statusEl.addEventListener('change', scheduleLoad);
      if (accountIdEl) accountIdEl.addEventListener('input', scheduleLoad);

      if (!token) {
        showBanner('Sign in with a staff admin account to see live data. Showing preview below.');
        return;
      }

      // 2026-05-22 — live auto-poll. Same pattern as 580b30a7 /
      // 2d358ce7. Session-list reflects newly-spawned customer
      // sessions + status transitions every 30s.
      let lastFetch = Date.now();
      function loadWithLive() {
        const liveDot = root.querySelector('[data-live-dot]');
        if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-amber-500';
        const p = load();
        if (p && typeof p.then === 'function') {
          p.then(
            () => {
              lastFetch = Date.now();
              if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-emerald-500';
            },
            () => {
              if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-red-500';
            },
          );
        } else {
          lastFetch = Date.now();
        }
      }
      const refreshBtn = root.querySelector('[data-live-refresh]');
      if (refreshBtn) refreshBtn.addEventListener('click', loadWithLive);
      setInterval(loadWithLive, 30_000);
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      const ageEl = root.querySelector('[data-live-age]');
      setInterval(() => {
        if (ageEl) ageEl.textContent = fmtAge(lastFetch);
      }, 5_000);

      load();
    })();
  </script>
</AdminLayout>
