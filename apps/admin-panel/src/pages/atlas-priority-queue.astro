---
import AdminLayout from '../layouts/AdminLayout.astro';

// Wave 29-400 §8.3 — atlas-priority observability admin page.
//
// Live status board for the auto-learn pipeline: each probe-signature
// row tracks lifecycle from harvester-emit through BS Automate run
// through atlas append. Backed by GET /v1/internal/atlas-priority/queue
// (gated by DRIFTSTACK_FLEET_INTERNAL_TOKEN — operator provisions; this
// admin page reads via the admin's own auth context, not the internal
// fleet token).
//
// Progressive enhancement: SSG renders an empty shell; inline <script>
// reads ds_admin_session_token from localStorage, fetches the queue
// endpoint, populates table + stats card, and re-polls every 30s.
// Filter bar wires status select + customer_id text input + page_url
// substring filter (client-side for now; server-side surfaces later
// when the queue endpoint grows the param).

const PAGE_TITLE = 'Atlas priority queue';

const STATUS_VALUES = [
  'emitted',
  'queued',
  'bs_in_flight',
  'bs_succeeded',
  'bs_failed',
  'atlas_appended',
  'atlas_failed',
] as const;

const STATUS_BADGE: Record<string, string> = {
  emitted: 'bg-tk-hover text-tk-ink-2',
  queued: 'bg-amber-50 text-amber-700',
  bs_in_flight: 'bg-blue-50 text-blue-700',
  bs_succeeded: 'bg-emerald-50 text-emerald-700',
  bs_failed: 'bg-red-50 text-red-700',
  atlas_appended: 'bg-emerald-100 text-emerald-800 font-medium',
  atlas_failed: 'bg-red-100 text-red-800 font-medium',
};

// Use the env-resolved API origin like every sibling admin page so a
// staging/local build queries its own environment instead of always
// hitting PROD (previously this page hardcoded https://api.driftstack.dev).
import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title={PAGE_TITLE}>
  <div class="px-6 py-6 max-w-7xl mx-auto">
    <header class="mb-6">
      <h1 class="text-2xl font-semibold text-tk-ink">{PAGE_TITLE}</h1>
     <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-tk-ink-2">
        Live lifecycle status for auto-learn probe signatures. Source:
        <code class="text-xs bg-tk-hover px-1 rounded"
          >GET /v1/internal/atlas-priority/queue</code
        >. Auto-refresh every 30 s.
      </p>
    </header>

    <!-- Stats card -->
    <section
      id="stats-card"
      class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6"
      aria-live="polite"
    >
      <div class="bg-tk-surface rounded-md border border-tk-border px-4 py-3">
        <div class="text-xs text-tk-ink-3 uppercase tracking-wide">Queue depth</div>
        <div class="text-2xl font-semibold text-tk-ink mt-1" data-stat="queueDepth">—</div>
      </div>
      <div class="bg-tk-surface rounded-md border border-tk-border px-4 py-3">
        <div class="text-xs text-tk-ink-3 uppercase tracking-wide">BS success 24h</div>
        <div class="text-2xl font-semibold text-emerald-700 mt-1" data-stat="bsSuccess24h">
          —
        </div>
      </div>
      <div class="bg-tk-surface rounded-md border border-tk-border px-4 py-3">
        <div class="text-xs text-tk-ink-3 uppercase tracking-wide">BS failed 24h</div>
        <div class="text-2xl font-semibold text-red-700 mt-1" data-stat="bsFailed24h">—</div>
      </div>
      <div class="bg-tk-surface rounded-md border border-tk-border px-4 py-3">
        <div class="text-xs text-tk-ink-3 uppercase tracking-wide">Atlas appended 24h</div>
        <div class="text-2xl font-semibold text-emerald-700 mt-1" data-stat="atlasAppended24h">
          —
        </div>
      </div>
      <div class="bg-tk-surface rounded-md border border-tk-border px-4 py-3">
        <div class="text-xs text-tk-ink-3 uppercase tracking-wide">Avg emit→append</div>
        <div class="text-2xl font-semibold text-tk-ink mt-1" data-stat="avgEmittedToAppendedMs">
          —
        </div>
      </div>
    </section>

    <!-- Filter bar -->
    <section class="mb-4 flex flex-wrap gap-3 items-end">
      <div>
        <label for="filter-status" class="block text-xs text-tk-ink-3 mb-1">Status</label>
        <select
          id="filter-status"
          class="border border-tk-border rounded-md px-3 py-1.5 text-sm bg-tk-surface"
        >
          <option value="">All</option>
          {STATUS_VALUES.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div>
        <label for="filter-customer" class="block text-xs text-tk-ink-3 mb-1"
          >Customer ID</label
        >
        <input
          id="filter-customer"
          type="text"
          placeholder="cust-..."
          class="border border-tk-border rounded-md px-3 py-1.5 text-sm bg-tk-surface w-64"
        />
      </div>
      <div>
        <label for="filter-page-url" class="block text-xs text-tk-ink-3 mb-1"
          >Page URL contains</label
        >
        <input
          id="filter-page-url"
          type="text"
          placeholder="example.com"
          class="border border-tk-border rounded-md px-3 py-1.5 text-sm bg-tk-surface w-64"
        />
      </div>
      <div class="flex items-center gap-2">
        <input id="filter-failures-only" type="checkbox" />
        <label for="filter-failures-only" class="text-sm text-tk-ink-2"
          >Show failures only</label
        >
      </div>
      <button
        id="refresh-btn"
        type="button"
        class="ml-auto px-3 py-1.5 text-sm rounded-md border border-tk-border bg-tk-surface hover:bg-tk-bg"
      >
        Refresh now
      </button>
    </section>

    <!-- Table -->
    <section class="bg-tk-surface rounded-md border border-tk-border overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-tk-bg text-xs uppercase tracking-wide text-tk-ink-2">
          <tr>
            <th class="px-4 py-2 text-left">Emitted</th>
            <th class="px-4 py-2 text-left">Customer</th>
            <th class="px-4 py-2 text-left">Page URL</th>
            <th class="px-4 py-2 text-left">Status</th>
            <th class="px-4 py-2 text-left">BS session</th>
            <th class="px-4 py-2 text-left">Atlas entry</th>
            <th class="px-4 py-2 text-right">Duration</th>
          </tr>
        </thead>
        <tbody id="queue-tbody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="7" class="px-4 py-6 text-center text-tk-ink-3"
              >Loading via /v1/internal/atlas-priority/queue…</td
            >
          </tr>
        </tbody>
      </table>
    </section>

    <p id="error-banner" class="mt-3 text-sm text-red-700 hidden"></p>
    <p id="status-line" class="mt-2 text-xs text-tk-ink-3"></p>
  </div>

  <script is:inline define:vars={{ STATUS_BADGE, apiBaseUrl }}>
    const POLL_INTERVAL_MS = 30000;
    const QUEUE_REQUEST_TIMEOUT_MS = 15000;
    const tbody = document.getElementById('queue-tbody');
    const errorBanner = document.getElementById('error-banner');
    const statusLine = document.getElementById('status-line');
    const refreshBtn = document.getElementById('refresh-btn');
    const statSpans = Object.fromEntries(
      Array.from(document.querySelectorAll('[data-stat]')).map((el) => [
        el.getAttribute('data-stat'),
        el,
      ]),
    );
    const filters = {
      status: document.getElementById('filter-status'),
      customer: document.getElementById('filter-customer'),
      pageUrl: document.getElementById('filter-page-url'),
      failuresOnly: document.getElementById('filter-failures-only'),
    };
    let manualRefreshLoading = false;
    let loadController = null;
    refreshBtn.addEventListener('click', () => fetchQueue(true));
    Object.values(filters).forEach((el) => el.addEventListener('change', () => fetchQueue()));
    filters.customer.addEventListener('input', debounce(() => fetchQueue(), 400));
    filters.pageUrl.addEventListener('input', debounce(() => fetchQueue(), 400));

    function debounce(fn, ms) {
      let t = null;
      return (...a) => {
        if (t) clearTimeout(t);
        t = setTimeout(() => fn(...a), ms);
      };
    }

    function fmtIso(iso) {
      if (!iso) return '—';
      return new Date(iso).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
    }
    function fmtDuration(ms) {
      if (ms == null) return '—';
      if (ms < 1000) return ms + ' ms';
      if (ms < 60000) return (ms / 1000).toFixed(1) + ' s';
      return (ms / 60000).toFixed(1) + ' min';
    }
    function truncate(s, n) {
      if (!s) return '';
      return s.length > n ? s.slice(0, n) + '…' : s;
    }
    // These rows render customer-INFLUENCED strings (customer_id / page_url are
    // free-form per POST /v1/internal/atlas-priority/probe-signature, min(1),
    // no .url() / sanitization) into innerHTML in the PRIVILEGED admin DOM.
    // Escape every interpolated value — matches the escapeHtml every sibling
    // admin page already applies (this was the one that didn't).
    function escapeHtml(s) {
      return String(s).replace(
        /[&<>"']/g,
        (c) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          })[c],
      );
    }

    // Stale-response guard — fetchQueue fires from init + refresh + every filter
    // change + a debounced text input + a 30s poll, so a slow earlier response
    // could otherwise overwrite a newer filtered render. Each call takes a token;
    // it only writes to the DOM if it's still the most-recently-started call.
    let inFlight = 0;

    function boundedFetch(url, init, controller) {
      return window.driftstackFetchWithDeadline(
        url,
        init,
        QUEUE_REQUEST_TIMEOUT_MS,
        controller,
      );
    }

    async function fetchQueue(manual = false) {
      if (manual && manualRefreshLoading) return;
      if (manual) {
        manualRefreshLoading = true;
        refreshBtn.disabled = true;
        refreshBtn.setAttribute('aria-busy', 'true');
        refreshBtn.textContent = 'Refreshing…';
      }
      const myReq = ++inFlight;
      const params = new URLSearchParams();
      if (filters.status.value) params.set('status', filters.status.value);
      if (filters.customer.value) params.set('customer_id', filters.customer.value);
      params.set('limit', '200');
      // 2026-05-21 — switch to the admin-scope mirror at /v1/admin/...
      // and call the API origin (admin.driftstack.dev itself is a
      // static Cloudflare Pages project — relative paths 404'd). The
      // staff bearer token lives in ds_web_session_token (set by the
      // SSO bridge); the legacy `ds_admin_session_token` key was never
      // populated anywhere. Origin comes from resolveApiBaseUrl()
      // (per-environment) like every sibling page, not a hardcoded prod
      // host — so a staging/local admin build queries its own env.
      const url = apiBaseUrl + '/v1/admin/atlas-priority/queue?' + params.toString();
      const token = localStorage.getItem('ds_web_session_token');
      if (loadController) loadController.abort();
      const controller = new AbortController();
      loadController = controller;
      try {
        const res = await boundedFetch(
          url,
          {
            headers: token ? { Authorization: 'Bearer ' + token } : {},
            credentials: 'include',
          },
          controller,
        );
        if (myReq !== inFlight) return; // superseded by a newer call
        if (!res.ok) {
          const message = window.driftstackRequestErrorMessage(
            new Error('HTTP ' + res.status),
            'Could not load the queue. Try again.',
          );
          // Clear the "Loading…" placeholder so a first-load failure (e.g. a
          // 401 with no token) doesn't leave a stuck loading row under the
          // error banner.
          tbody.innerHTML =
            '<tr><td colspan="7" class="px-4 py-6 text-center text-tk-ink-3">' +
            escapeHtml(message) +
            '</td></tr>';
          showError(message);
          return;
        }
        const data = await res.json();
        if (myReq !== inFlight) return; // superseded by a newer call
        renderStats(data.stats || {});
        renderRows(filterClientSide(data.events || []));
        errorBanner.classList.add('hidden');
        statusLine.textContent =
          'Showing ' + (data.events?.length ?? 0) + ' events · ' + new Date().toISOString();
      } catch (err) {
        if (myReq !== inFlight) return; // superseded by a newer call
        tbody.innerHTML =
          '<tr><td colspan="7" class="px-4 py-6 text-center text-tk-ink-3">Could not load the queue.</td></tr>';
        showError(
          err && err.name === 'AbortError'
            ? 'Request timed out. Try again.'
            : 'Could not load the queue. Check your connection and try again.',
        );
      } finally {
        if (manual) {
          manualRefreshLoading = false;
          refreshBtn.disabled = false;
          refreshBtn.setAttribute('aria-busy', 'false');
          refreshBtn.textContent = 'Refresh now';
        }
        if (myReq === inFlight) {
          loadController = null;
          // 2026-05-21 — AdminLayout opacity-gate signal.
          if (typeof window.dashboardHydrated === 'function') {
            window.dashboardHydrated();
          }
        }
      }
    }

    function filterClientSide(events) {
      const pageUrlSubstr = filters.pageUrl.value.trim();
      const failuresOnly = filters.failuresOnly.checked;
      return events.filter((e) => {
        if (pageUrlSubstr && !e.page_url.toLowerCase().includes(pageUrlSubstr.toLowerCase()))
          return false;
        if (failuresOnly && !(e.status === 'bs_failed' || e.status === 'atlas_failed'))
          return false;
        return true;
      });
    }

    function renderStats(stats) {
      const setText = (k, v) => {
        if (statSpans[k]) statSpans[k].textContent = v;
      };
      setText('queueDepth', stats.queueDepth ?? '0');
      setText('bsSuccess24h', stats.bsSuccess24h ?? '0');
      setText('bsFailed24h', stats.bsFailed24h ?? '0');
      setText('atlasAppended24h', stats.atlasAppended24h ?? '0');
      setText('avgEmittedToAppendedMs', fmtDuration(stats.avgEmittedToAppendedMs24h));
    }

    function renderRows(events) {
      if (events.length === 0) {
        tbody.innerHTML =
          '<tr><td colspan="7" class="px-4 py-6 text-center text-tk-ink-3">No events match current filters.</td></tr>';
        return;
      }
      tbody.innerHTML = events
        .map((e) => {
          const badge =
            (STATUS_BADGE && STATUS_BADGE[e.status]) || 'bg-tk-bg text-tk-ink-2';
          return (
            '<tr class="hover:bg-tk-bg">' +
            '<td class="px-4 py-2 text-tk-ink-2 whitespace-nowrap">' +
            fmtIso(e.emitted_at) +
            '</td>' +
            '<td class="px-4 py-2 text-tk-ink-2 font-mono text-xs">' +
            escapeHtml(truncate(e.customer_id || '', 18)) +
            '</td>' +
            '<td class="px-4 py-2 text-tk-ink-2">' +
            escapeHtml(truncate(e.page_url || '', 48)) +
            '</td>' +
            '<td class="px-4 py-2"><span class="px-2 py-0.5 rounded ' +
            badge +
            ' text-xs font-mono">' +
            escapeHtml(e.status || '') +
            '</span></td>' +
            '<td class="px-4 py-2 text-tk-ink-2 font-mono text-xs">' +
            escapeHtml(e.bs_automate_session_id || '—') +
            '</td>' +
            '<td class="px-4 py-2 text-tk-ink-2 font-mono text-xs">' +
            (e.atlas_entry_hash ? escapeHtml(truncate(e.atlas_entry_hash, 16)) : '—') +
            '</td>' +
            '<td class="px-4 py-2 text-right text-tk-ink-2 tabular-nums">' +
            fmtDuration(e.duration_emit_to_append_ms) +
            '</td>' +
            '</tr>'
          );
        })
        .join('');
    }

    function showError(msg) {
      errorBanner.textContent = msg;
      errorBanner.classList.remove('hidden');
    }

    function start() {
      fetchQueue();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
    setInterval(fetchQueue, POLL_INTERVAL_MS);
  </script>
</AdminLayout>
