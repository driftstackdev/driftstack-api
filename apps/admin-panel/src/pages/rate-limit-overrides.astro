---
import AdminLayout from '../layouts/AdminLayout.astro';

interface MockOverride {
  id: string;
  accountId: string;
  accountEmail: string;
  bucketKey: 'global' | 'session_create' | 'capture';
  capacity: number;
  refillPerSecond: number;
  expiresAt: string | null;
  reason: string;
  createdAt: string;
  createdBy: string;
}

const MOCK_OVERRIDES: MockOverride[] = [
  {
    id: 'rlo_00000000-0000-4000-8000-0000000000f1',
    accountId: 'acc_00000000-0000-4000-8000-000000000002',
    accountEmail: 'agency@driftstack.local',
    bucketKey: 'global',
    capacity: 200,
    refillPerSecond: 10,
    expiresAt: '2026-05-15T00:00:00Z',
    reason: 'Migrating off legacy hours-meter; needs headroom during cutover.',
    createdAt: '2026-05-04T09:00:00Z',
    createdBy: 'staff@driftstack.dev',
  },
];

const BUCKET_LABEL: Record<string, string> = {
  global: 'Global',
  session_create: 'Session create',
  capture: 'Capture',
};

function fmtIso(iso: string | null): string {
  if (iso === null) return 'permanent';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}
---

<AdminLayout title="Rate-limit overrides">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900">
          Rate-limit overrides
        </h1>
        <p class="mt-2 max-w-prose text-sm text-slate-500">
          Per-account bucket overrides that supersede the tier defaults. Used
          for time-boxed capacity bumps during migrations + production
          incidents. All overrides are auditable + auto-expire if a TTL is
          set.
        </p>
      </div>
      <a href="#new" class="btn-primary shrink-0">New override</a>
    </header>

    <!-- Filter -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <input
        type="search"
        placeholder="Filter by account email or reason…"
        class="w-72 rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      />
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" class="rounded" />
        Hide expired
      </label>
    </div>

    {
      MOCK_OVERRIDES.length === 0 ? (
        <div class="dashboard-card text-center">
          <h2 class="text-lg font-semibold text-slate-900">No active overrides</h2>
          <p class="mx-auto mt-2 max-w-prose text-sm text-slate-500">
            All accounts are running on tier defaults. New overrides time-box
            best (default 14 days) so cleanup happens automatically.
          </p>
        </div>
      ) : (
        <ul class="space-y-3">
          {MOCK_OVERRIDES.map((override) => (
            <li class="dashboard-card">
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0">
                  <div class="flex items-center gap-3">
                    <p class="text-base font-medium text-slate-900">
                      {override.accountEmail}
                    </p>
                    <span class="inline-flex rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-blue-700">
                      {BUCKET_LABEL[override.bucketKey] ?? override.bucketKey}
                    </span>
                  </div>
                  <p class="mt-1 font-mono text-[11px] text-slate-500">
                    {override.accountId}
                  </p>
                  <p class="mt-3 text-sm text-slate-700">{override.reason}</p>
                  <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs">
                    <div>
                      <dt class="text-slate-500">Capacity</dt>
                      <dd class="font-mono text-slate-900">
                        {override.capacity.toLocaleString('en-US')}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-slate-500">Refill / sec</dt>
                      <dd class="font-mono text-slate-900">{override.refillPerSecond}</dd>
                    </div>
                    <div>
                      <dt class="text-slate-500">Expires</dt>
                      <dd class="font-mono text-slate-900">
                        {fmtIso(override.expiresAt)}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-slate-500">Set by</dt>
                      <dd class="font-mono text-slate-900">{override.createdBy}</dd>
                    </div>
                  </dl>
                </div>
                <div class="flex shrink-0 flex-col gap-2">
                  <a
                    href={`#extend-${override.id}`}
                    class="text-sm text-oxblood-700 hover:underline"
                  >
                    Extend
                  </a>
                  <a
                    href={`#clear-${override.id}`}
                    class="text-sm text-red-700 hover:underline"
                  >
                    Clear now
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-8 text-xs text-slate-500">
      New overrides default to 14-day TTL. Permanent overrides allowed but
      flagged in the weekly audit-log review. Bucket keys: <code class="font-mono">global</code>
      (whole API), <code class="font-mono">session_create</code> (session creation
      only), <code class="font-mono">capture</code> (screenshot/DOM/PDF only).
    </p>
  </div>
</AdminLayout>
