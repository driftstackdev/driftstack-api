---
import AdminLayout from '../layouts/AdminLayout.astro';

// V-194 — progressive-enhancement against /v1/admin/rate-limit-
// overrides (new in V-194). SSG renders an inert shell; an inline
// <script> fetches with bearer auth, replaces the list, and wires
// Clear-now (DELETE) action against /v1/admin/accounts/:id/quota-
// override?bucket_key=<bucket>. New override / Extend require a target
// account first — surfaced as deep-links into the per-account detail
// page rather than re-implementing the form here.

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Rate-limit overrides">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-overrides">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Rate-limit overrides</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Per-account bucket overrides that supersede the tier defaults. Used
          for time-boxed capacity bumps during migrations + production
          incidents. All overrides are auditable and expire within 30 days.
          To set a new override, open the per-account page (Accounts →
          select account).
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as 154ff9cf. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-amber-500"
          ></span>
          <span data-live-status>Waiting for live data</span>
          <span data-live-age class="hidden"></span>
        </span>
        <button
          type="button"
          data-live-refresh
          disabled
          aria-disabled="true"
          title="Available after staff sign-in"
          class="text-tk-accent hover:underline disabled:cursor-not-allowed disabled:opacity-50"
        >
          Refresh now
        </button>
      </div>
    </header>

    <!-- Filter -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <input
        type="search"
        data-field="account-id"
        aria-label="Filter rate-limit overrides by account id"
        placeholder="Account id (acc_<uuid>)"
        class="w-72 rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      />
      <label class="flex items-center gap-2 text-sm text-tk-ink-2">
        <input type="checkbox" data-field="include-expired" class="rounded" />
        Include expired
      </label>
    </div>

    {/* 2026-05-23 — icon on rate-limit empty state. */}
    <div data-region="empty" class="hidden">
      <div class="dashboard-card text-center">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold tracking-tight text-tk-ink">No overrides</h2>
        <p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">
          No overrides match the current filter. New overrides default
          to a 14-day TTL via the per-account page.
        </p>
      </div>
    </div>

    <ul class="space-y-3" data-list="overrides">
      <li class="rounded-lg border border-tk-border bg-tk-bg p-5 text-sm text-tk-ink-3">
        Live rate-limit overrides are unavailable until loaded.
      </li>
    </ul>

    <div class="mt-4 flex flex-wrap items-center gap-4">
      <p class="text-xs text-tk-ink-3" data-field="summary"></p>
      <button
        type="button"
        data-action="load-more"
        disabled
        aria-disabled="true"
        aria-busy="false"
        class="hidden text-xs font-medium text-tk-accent hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-50"
      >
        Load more
      </button>
      <button
        type="button"
        data-action="back-to-newest"
        disabled
        aria-disabled="true"
        class="hidden text-xs font-medium text-tk-accent hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-50"
      >
        Back to newest / Refresh
      </button>
      <button
        type="button"
        data-action="recheck-clear"
        disabled
        aria-disabled="true"
        class="hidden text-xs font-medium text-amber-800 hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-50"
      >
        Recheck uncertain clear
      </button>
    </div>

    <p class="mt-8 text-xs text-tk-ink-3">
      Overrides require an expiry between 1 second and 30 days; the per-account
      page defaults to 14 days. Bucket keys: <code class="font-mono">global</code>
      (whole API), <code class="font-mono">sessions:create</code> (session creation
      only), <code class="font-mono">agent_sessions:message</code> (agent-session
      messages only).
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-overrides"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list="overrides"]');
      const emptyRegion = root.querySelector('[data-region="empty"]');
      const summary = root.querySelector('[data-field="summary"]');
      const accountIdEl = root.querySelector('[data-field="account-id"]');
      const includeExpiredEl = root.querySelector('[data-field="include-expired"]');
      const liveDot = root.querySelector('[data-live-dot]');
      const liveStatus = root.querySelector('[data-live-status]');
      const liveAge = root.querySelector('[data-live-age]');
      const refreshBtn = root.querySelector('[data-live-refresh]');
      const loadMoreBtn = root.querySelector('[data-action="load-more"]');
      const backToNewestBtn = root.querySelector('[data-action="back-to-newest"]');
      const recheckClearBtn = root.querySelector('[data-action="recheck-clear"]');
      let token = null;
      const OVERRIDE_TIMEOUT_MS = 15_000;
      const MAX_RECONCILE_PAGES = 100;
      const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
      const ACCOUNT_ID_RE = new RegExp('^acc_' + UUID_RE.source.slice(1, -1) + '$');
      const OVERRIDE_ID_RE = new RegExp('^rlo_' + UUID_RE.source.slice(1, -1) + '$');
      const KEY_ID_RE = new RegExp('^key_' + UUID_RE.source.slice(1, -1) + '$');
      const BUCKET_KEYS = new Set(['global', 'sessions:create', 'agent_sessions:message']);
      const OVERRIDE_FIELDS = [
        'id',
        'account_id',
        'bucket_key',
        'capacity',
        'refill_per_second',
        'reason',
        'expires_at',
        'set_by_key_id',
        'created_at',
        'updated_at',
      ];
      const BUCKET_LABEL = {
        global: 'Global',
        'sessions:create': 'Sessions: create',
        'agent_sessions:message': 'Agent sessions: message',
      };

      let loadController = null;
      let loadedOverrides = [];
      let nextCursor = null;
      let refusedCursor = null;
      const walkedCursors = new Set();
      let listEpoch = 0;
      let inFlight = 0;
      let appendGeneration = 0;
      let appendInFlight = false;
      let firstPageBusy = false;
      let expandedView = false;
      let hasLoadedWindow = false;
      let filterTransitionPending = false;
      let activeMutation = null;
      let debounce = 0;
      let liveOwner = 0;
      let lastFetch = Date.now();

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, OVERRIDE_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      function responseContractError(message) {
        const error = new Error(message);
        error.staffSafe = true;
        return error;
      }

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }

      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function hasOwn(value, field) {
        return Object.prototype.hasOwnProperty.call(value, field);
      }

      function isRecord(value) {
        return value !== null && typeof value === 'object' && !Array.isArray(value);
      }

      function isIsoUtc(value) {
        if (typeof value !== 'string') return false;
        const parsed = Date.parse(value);
        return Number.isFinite(parsed) && new Date(parsed).toISOString() === value;
      }

      function isOverrideRow(value) {
        if (
          !isRecord(value) ||
          Object.keys(value).length !== OVERRIDE_FIELDS.length ||
          !OVERRIDE_FIELDS.every((field) => hasOwn(value, field))
        ) {
          return false;
        }
        return (
          typeof value.id === 'string' &&
          OVERRIDE_ID_RE.test(value.id) &&
          typeof value.account_id === 'string' &&
          ACCOUNT_ID_RE.test(value.account_id) &&
          typeof value.bucket_key === 'string' &&
          BUCKET_KEYS.has(value.bucket_key) &&
          Number.isInteger(value.capacity) &&
          value.capacity >= 1 &&
          value.capacity <= 1_000_000 &&
          typeof value.refill_per_second === 'number' &&
          Number.isFinite(value.refill_per_second) &&
          value.refill_per_second >= 0.01 &&
          value.refill_per_second <= 100_000 &&
          (value.reason === null ||
            (typeof value.reason === 'string' && value.reason.length <= 500)) &&
          isIsoUtc(value.expires_at) &&
          typeof value.set_by_key_id === 'string' &&
          KEY_ID_RE.test(value.set_by_key_id) &&
          isIsoUtc(value.created_at) &&
          isIsoUtc(value.updated_at)
        );
      }

      // The page and every row are validated before any list or cursor state
      // changes. Empty pages cannot advertise another cursor: that shape
      // cannot make bounded progress and is therefore not authoritative.
      function parseOverridePage(body, maxRows) {
        const rowIds =
          isRecord(body) && Array.isArray(body.data)
            ? body.data.map((row) => (isRecord(row) ? row.id : null))
            : [];
        if (
          !isRecord(body) ||
          Object.keys(body).length !== 2 ||
          !hasOwn(body, 'data') ||
          !Array.isArray(body.data) ||
          body.data.length > maxRows ||
          !body.data.every(isOverrideRow) ||
          new Set(rowIds).size !== rowIds.length ||
          !hasOwn(body, 'next_cursor') ||
          !(
            body.next_cursor === null ||
            (typeof body.next_cursor === 'string' && UUID_RE.test(body.next_cursor))
          ) ||
          (body.data.length === 0 && body.next_cursor !== null)
        ) {
          throw responseContractError('Invalid rate-limit override response');
        }
        return { rows: body.data, nextCursor: body.next_cursor };
      }

      function fmtIso(iso) {
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      function setDisabled(control, disabled) {
        if (!control) return;
        control.disabled = disabled;
        if (disabled) control.setAttribute('aria-disabled', 'true');
        else control.removeAttribute('aria-disabled');
      }

      function setLiveState(state, message) {
        if (liveDot) {
          const color =
            state === 'ready'
              ? 'bg-emerald-500'
              : state === 'failed'
                ? 'bg-red-500'
                : 'bg-amber-500';
          liveDot.className = 'inline-block h-2 w-2 rounded-full ' + color;
        }
        if (liveStatus) {
          liveStatus.textContent = message
            ? message
            : state === 'ready'
              ? 'Live · updated'
              : state === 'failed'
                ? 'Live refresh failed'
                : 'Loading live data';
        }
        if (liveAge) liveAge.classList.toggle('hidden', state !== 'ready');
      }

      function captureFilters() {
        return {
          accountId: accountIdEl ? accountIdEl.value.trim() : '',
          includeExpired: !!(includeExpiredEl && includeExpiredEl.checked),
        };
      }

      function filterSignature(filters) {
        return filters.accountId + '\u0000' + (filters.includeExpired ? '1' : '0');
      }

      function currentFilterSignature() {
        return filterSignature(captureFilters());
      }

      function buildQuery(filters, requestedCursor, limit) {
        const params = new URLSearchParams();
        params.set('limit', String(limit));
        if (filters.accountId) params.set('account_id', filters.accountId);
        if (filters.includeExpired) params.set('include_expired', 'true');
        if (requestedCursor !== null) params.set('cursor', requestedCursor);
        return params;
      }

      function mutationButtonState(row) {
        if (!activeMutation) return { attrs: '', label: 'Clear now' };
        const isTarget = activeMutation.rowId === row.id;
        let label = 'Another clear pending…';
        if (isTarget) {
          label =
            activeMutation.phase === 'confirming'
              ? 'Confirming…'
              : activeMutation.phase === 'clearing'
                ? 'Clearing…'
                : activeMutation.phase === 'uncertain'
                  ? 'Outcome uncertain'
                  : 'Rechecking…';
        }
        return {
          attrs:
            ' disabled aria-disabled="true" aria-busy="true" title="Wait for the current override clear to reach an authoritative outcome."',
          label,
        };
      }

      function rowHtml(o) {
        const bucketLabel = BUCKET_LABEL[o.bucket_key] || o.bucket_key;
        const accountUuid = o.account_id.slice(4);
        const clearState = mutationButtonState(o);
        const reasonFrag = o.reason
          ? '<p class="mt-3 text-sm text-tk-ink-2">' + escapeHtml(o.reason) + '</p>'
          : '';
        return (
          '<li class="dashboard-card" data-row-id="' +
          escapeHtml(o.id) +
          '">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<div class="flex items-center gap-3">' +
          '<a class="font-mono text-[11px] text-tk-accent hover:underline" href="/accounts/' +
          encodeURIComponent(accountUuid) +
          '">' +
          escapeHtml(o.account_id) +
          '</a>' +
          '<span class="inline-flex rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-blue-700">' +
          escapeHtml(bucketLabel) +
          '</span></div>' +
          reasonFrag +
          '<dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs">' +
          '<div><dt class="text-tk-ink-3">Capacity</dt><dd class="font-mono text-tk-ink">' +
          escapeHtml(String(o.capacity)) +
          '</dd></div>' +
          '<div><dt class="text-tk-ink-3">Refill / sec</dt><dd class="font-mono text-tk-ink">' +
          escapeHtml(String(o.refill_per_second)) +
          '</dd></div>' +
          '<div><dt class="text-tk-ink-3">Expires</dt><dd class="font-mono text-tk-ink">' +
          escapeHtml(fmtIso(o.expires_at)) +
          '</dd></div>' +
          '</dl></div>' +
          '<div class="flex shrink-0 flex-col gap-2">' +
          '<button type="button" data-action="clear" data-row-id="' +
          escapeHtml(o.id) +
          '" data-account-id="' +
          escapeHtml(o.account_id) +
          '" data-bucket-key="' +
          escapeHtml(o.bucket_key) +
          '"' +
          clearState.attrs +
          ' class="text-sm text-red-700 hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-60">' +
          clearState.label +
          '</button>' +
          '</div></div></li>'
        );
      }

      function mergeUniqueOverrides(existing, incoming) {
        const seen = new Set();
        const merged = [];
        existing.concat(incoming).forEach((row) => {
          if (seen.has(row.id)) return;
          seen.add(row.id);
          merged.push(row);
        });
        return merged;
      }

      function syncMutationControls() {
        root.querySelectorAll('[data-action="clear"]').forEach((control) => {
          const rowId = control.getAttribute('data-row-id');
          const row = loadedOverrides.find((candidate) => candidate.id === rowId);
          if (!row) return;
          const state = mutationButtonState(row);
          control.textContent = state.label;
          control.disabled = !!activeMutation;
          if (activeMutation) {
            control.setAttribute('aria-disabled', 'true');
            control.setAttribute('aria-busy', 'true');
            control.title = 'Wait for the current override clear to reach an authoritative outcome.';
          } else {
            control.removeAttribute('aria-disabled');
            control.removeAttribute('aria-busy');
            control.removeAttribute('title');
          }
        });
      }

      function syncTransitionControls() {
        const readBusy = loadController !== null;
        const mutationBusy = activeMutation !== null;
        const cursorRefused = nextCursor !== null && refusedCursor === nextCursor;
        setDisabled(accountIdEl, mutationBusy);
        setDisabled(includeExpiredEl, mutationBusy);
        setDisabled(
          refreshBtn,
          !token || firstPageBusy || filterTransitionPending || mutationBusy,
        );
        if (loadMoreBtn) {
          loadMoreBtn.classList.toggle('hidden', !nextCursor || cursorRefused);
          setDisabled(
            loadMoreBtn,
            readBusy ||
              appendInFlight ||
              filterTransitionPending ||
              mutationBusy ||
              !nextCursor ||
              cursorRefused,
          );
          loadMoreBtn.textContent = appendInFlight ? 'Loading…' : 'Load more';
          loadMoreBtn.setAttribute('aria-busy', appendInFlight ? 'true' : 'false');
        }
        if (backToNewestBtn) {
          backToNewestBtn.classList.toggle('hidden', !expandedView);
          setDisabled(
            backToNewestBtn,
            readBusy || filterTransitionPending || mutationBusy || !expandedView,
          );
        }
        if (recheckClearBtn) {
          const canRecheck = !!activeMutation && activeMutation.phase === 'uncertain';
          recheckClearBtn.classList.toggle('hidden', !canRecheck);
          setDisabled(recheckClearBtn, !canRecheck);
        }
        syncMutationControls();
      }

      function renderOverrides(rows) {
        if (rows.length === 0) {
          if (list) {
            list.classList.add('hidden');
            list.innerHTML = '';
          }
          if (emptyRegion) emptyRegion.classList.remove('hidden');
        } else {
          if (list) {
            list.classList.remove('hidden');
            list.innerHTML = rows.map(rowHtml).join('');
          }
          if (emptyRegion) emptyRegion.classList.add('hidden');
        }
        if (summary) {
          summary.textContent =
            'Showing ' +
            rows.length +
            ' override' +
            (rows.length === 1 ? '' : 's') +
            (nextCursor
              ? refusedCursor === nextCursor
                ? ' — pagination stopped because the server repeated a cursor.'
                : ' — more available.'
              : '.');
        }
        syncTransitionControls();
      }

      function renderUnavailable(message) {
        loadedOverrides = [];
        nextCursor = null;
        refusedCursor = null;
        walkedCursors.clear();
        expandedView = false;
        hasLoadedWindow = false;
        if (list) {
          list.classList.remove('hidden');
          list.innerHTML =
            '<li class="rounded-lg border border-tk-border bg-tk-bg p-5 text-sm text-tk-ink-3">' +
            escapeHtml(message) +
            '</li>';
        }
        if (emptyRegion) emptyRegion.classList.add('hidden');
        if (summary) summary.textContent = '';
        syncTransitionControls();
      }

      function ownsRead(owner) {
        return (
          owner.requestId === inFlight &&
          owner.epoch === listEpoch &&
          owner.filterSignature === currentFilterSignature() &&
          (!owner.append || owner.appendGeneration === appendGeneration)
        );
      }

      function invalidateReadOwner() {
        listEpoch += 1;
        liveOwner += 1;
        appendGeneration += 1;
        appendInFlight = false;
        firstPageBusy = false;
        if (loadController) loadController.abort();
        loadController = null;
        root.removeAttribute('aria-busy');
      }

      function load(options) {
        const append = !!(options && options.append);
        if (
          !token ||
          activeMutation ||
          (filterTransitionPending && !(options && options.filterTransition))
        ) {
          return Promise.resolve(false);
        }
        const requestedCursor = append ? nextCursor : null;
        if (
          append &&
          (!requestedCursor ||
            appendInFlight ||
            refusedCursor === requestedCursor ||
            filterTransitionPending)
        ) {
          return Promise.resolve(false);
        }

        const filters = captureFilters();
        const signature = filterSignature(filters);
        const epoch = append ? listEpoch : ++listEpoch;
        let appendOwner = null;
        if (append) {
          appendOwner = ++appendGeneration;
          appendInFlight = true;
          // Preserve the exact retry cursor and pause polling even when the
          // first attempt to load an older page fails.
          expandedView = true;
        } else {
          appendGeneration += 1;
          appendInFlight = false;
          firstPageBusy = true;
        }
        const requestId = ++inFlight;
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        const owner = {
          requestId,
          epoch,
          filterSignature: signature,
          append,
          appendGeneration: appendOwner,
          requestedCursor,
        };
        root.setAttribute('aria-busy', 'true');
        syncTransitionControls();
        const params = buildQuery(filters, requestedCursor, 50);
        return boundedFetch(
          apiBaseUrl + '/v1/admin/rate-limit-overrides?' + params.toString(),
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((response) => {
            if (response.status === 403) return Promise.reject(new Error('forbidden'));
            return response.ok
              ? response.json()
              : Promise.reject(new Error('HTTP ' + response.status));
          })
          .then((body) => {
            if (!ownsRead(owner)) return false;
            const page = parseOverridePage(body, 50);
            if (append) {
              if (page.rows.some((row) => loadedOverrides.some((loaded) => loaded.id === row.id))) {
                throw responseContractError(
                  'Invalid rate-limit override response: a row id was repeated across pages',
                );
              }
              walkedCursors.add(requestedCursor);
              const cycle =
                page.nextCursor !== null && walkedCursors.has(page.nextCursor);
              loadedOverrides = mergeUniqueOverrides(loadedOverrides, page.rows);
              nextCursor = page.nextCursor;
              refusedCursor = cycle ? page.nextCursor : null;
            } else {
              walkedCursors.clear();
              loadedOverrides = mergeUniqueOverrides([], page.rows);
              nextCursor = page.nextCursor;
              refusedCursor = null;
              expandedView = false;
            }
            hasLoadedWindow = true;
            renderOverrides(loadedOverrides);
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (!ownsRead(owner)) return false;
            const msg = requestErrorMessage(err, 'network error');
            if (append) {
              renderOverrides(loadedOverrides);
              showBanner(
                "Couldn't load older overrides (" +
                  msg +
                  '). Existing rows and the retry cursor are unchanged.',
              );
              return false;
            }
            if (hasLoadedWindow) {
              renderOverrides(loadedOverrides);
              showBanner(
                "Couldn't refresh overrides (" +
                  msg +
                  '). Existing rows and pagination state are unchanged.',
              );
              return false;
            }
            renderUnavailable(
              'Could not load live overrides — nothing to act on. Resolve the error above and retry.',
            );
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load overrides (" + msg + ').');
            }
            return false;
          })
          .finally(() => {
            if (append && appendOwner === appendGeneration) appendInFlight = false;
            if (!append && ownsRead(owner)) firstPageBusy = false;
            if (loadController === controller && ownsRead(owner)) {
              loadController = null;
              root.removeAttribute('aria-busy');
            }
            if (ownsRead(owner)) filterTransitionPending = false;
            syncTransitionControls();
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      function applyReconciliationRows(mutation, rows, targetPresent) {
        if (targetPresent) {
          const authoritative = rows.find((row) => row.id === mutation.rowId);
          if (authoritative) {
            loadedOverrides = loadedOverrides.map((row) =>
              row.id === mutation.rowId ? authoritative : row,
            );
          }
        } else {
          loadedOverrides = loadedOverrides.filter((row) => row.id !== mutation.rowId);
        }
        rows
          .filter(
            (row) =>
              row.id !== mutation.rowId &&
              row.account_id === mutation.accountId &&
              row.bucket_key === mutation.bucketKey,
          )
          .forEach((replacement) => {
            loadedOverrides = [replacement].concat(
              loadedOverrides.filter((row) => row.id !== replacement.id),
            );
          });
        loadedOverrides = mergeUniqueOverrides([], loadedOverrides);
        renderOverrides(loadedOverrides);
      }

      async function walkCapturedAccount(mutation) {
        let cursor = null;
        const seenCursors = new Set();
        const rowsById = new Map();
        for (let pageIndex = 0; pageIndex < MAX_RECONCILE_PAGES; pageIndex += 1) {
          if (activeMutation !== mutation) {
            return { kind: 'incomplete', rows: Array.from(rowsById.values()) };
          }
          const params = new URLSearchParams();
          params.set('limit', '100');
          params.set('account_id', mutation.accountId);
          params.set('include_expired', 'true');
          if (cursor !== null) params.set('cursor', cursor);
          const response = await boundedFetch(
            apiBaseUrl + '/v1/admin/rate-limit-overrides?' + params.toString(),
            {
              headers: { authorization: 'Bearer ' + token },
              credentials: 'include',
            },
          );
          if (!response.ok) throw new Error('HTTP ' + response.status);
          const page = parseOverridePage(await response.json(), 100);
          if (page.rows.some((row) => row.account_id !== mutation.accountId)) {
            throw responseContractError('Invalid account-scoped reconciliation response');
          }
          if (page.rows.some((row) => rowsById.has(row.id))) {
            return { kind: 'duplicate', rows: Array.from(rowsById.values()) };
          }
          page.rows.forEach((row) => rowsById.set(row.id, row));
          if (rowsById.has(mutation.rowId)) {
            return { kind: 'present', rows: Array.from(rowsById.values()) };
          }
          if (page.nextCursor === null) {
            return { kind: 'absent', rows: Array.from(rowsById.values()) };
          }
          if (page.nextCursor === cursor || seenCursors.has(page.nextCursor)) {
            return { kind: 'cyclic', rows: Array.from(rowsById.values()) };
          }
          seenCursors.add(page.nextCursor);
          cursor = page.nextCursor;
        }
        return { kind: 'incomplete', rows: Array.from(rowsById.values()) };
      }

      function setMutationPhase(mutation, phase) {
        if (activeMutation !== mutation) return false;
        mutation.phase = phase;
        syncTransitionControls();
        return true;
      }

      function releaseMutation(mutation) {
        if (activeMutation !== mutation) return;
        activeMutation = null;
        syncTransitionControls();
      }

      async function reconcileUnknownClear(mutation) {
        if (!setMutationPhase(mutation, 'reconciling')) return;
        showBanner(
          'Clear outcome is unknown. Checking every override for the captured account before allowing another mutation…',
        );
        try {
          const result = await walkCapturedAccount(mutation);
          if (activeMutation !== mutation) return;
          if (result.kind === 'present') {
            applyReconciliationRows(mutation, result.rows, true);
            releaseMutation(mutation);
            showBanner(
              'The exact original override row still exists after an authoritative account check. The clear did not commit; it is safe to retry.',
            );
            return;
          }
          if (result.kind === 'absent') {
            applyReconciliationRows(mutation, result.rows, false);
            releaseMutation(mutation);
            showBanner(
              'The exhaustive account check confirms the exact original override row is absent. The clear is committed. Any replacement with a different row id remains visible.',
            );
            return;
          }
          setMutationPhase(mutation, 'uncertain');
          showBanner(
            'Clear outcome remains unknown because the account check was cyclic, duplicated rows, or incomplete. Conflicting controls stay locked; use Recheck uncertain clear after the service recovers.',
          );
        } catch (err) {
          if (activeMutation !== mutation) return;
          setMutationPhase(mutation, 'uncertain');
          showBanner(
            'Clear outcome remains unknown because the account check failed (' +
              requestErrorMessage(err, 'network error') +
              '). Conflicting controls stay locked; use Recheck uncertain clear after the service recovers.',
          );
        }
      }

      async function authoritativeMutationError(response) {
        const body = await response.json().catch(() => ({}));
        const error = window.driftstackResponseError(response, body);
        error.authoritativeMutationRejection = true;
        return error;
      }

      function applyKnownRemoval(mutation) {
        loadedOverrides = loadedOverrides.filter((row) => row.id !== mutation.rowId);
        renderOverrides(loadedOverrides);
      }

      async function clear(rowId, prefixedAccountId, bucketKey) {
        if (!token || activeMutation) return;
        // Acquire before the confirmation promise so two same-tick clicks,
        // filtering, pagination and refresh cannot create competing owners.
        const mutation = {
          rowId,
          accountId: prefixedAccountId,
          bucketKey,
          phase: 'confirming',
        };
        activeMutation = mutation;
        invalidateReadOwner();
        syncTransitionControls();

        let proceed = false;
        try {
          proceed = await window.driftstackConfirm(
            'Clear the ' + bucketKey + ' override for ' + prefixedAccountId + '?',
            { confirmLabel: 'Clear', destructive: true },
          );
        } catch (err) {
          releaseMutation(mutation);
          showBanner(
            "Couldn't open the clear confirmation (" +
              requestErrorMessage(err, 'confirmation unavailable') +
              '). No request was sent.',
          );
          return;
        }
        if (!proceed) {
          releaseMutation(mutation);
          return;
        }

        setMutationPhase(mutation, 'clearing');
        showBanner('Clearing override…');
        try {
          const response = await boundedFetch(
            apiBaseUrl +
              '/v1/admin/accounts/' +
              encodeURIComponent(prefixedAccountId) +
              '/quota-override?bucket_key=' +
              encodeURIComponent(bucketKey),
            {
              method: 'DELETE',
              headers: { authorization: 'Bearer ' + token },
              credentials: 'include',
            },
          );
          if (response.status === 204) {
            applyKnownRemoval(mutation);
            releaseMutation(mutation);
            showBanner('Override cleared. The exact row was removed from this window.');
            return;
          }
          if (response.status === 404) {
            applyKnownRemoval(mutation);
            releaseMutation(mutation);
            showBanner('Override was already absent. The exact stale row was removed from this window.');
            return;
          }
          if (response.ok || response.status >= 500) {
            await reconcileUnknownClear(mutation);
            return;
          }
          throw await authoritativeMutationError(response);
        } catch (err) {
          if (err && err.authoritativeMutationRejection) {
            releaseMutation(mutation);
            showBanner(
              "Couldn't clear (" + requestErrorMessage(err, 'request rejected') + '). No retry fence is needed.',
            );
            return;
          }
          await reconcileUnknownClear(mutation);
        }
      }

      function beginFilterTransition() {
        if (!token || activeMutation) return;
        clearTimeout(debounce);
        filterTransitionPending = true;
        invalidateReadOwner();
        renderUnavailable('Loading overrides for the new filter…');
        filterTransitionPending = true;
        syncTransitionControls();
        debounce = setTimeout(() => loadWithLive({ filterTransition: true }), 200);
      }

      function loadWithLive(options) {
        if (activeMutation) return Promise.resolve(false);
        if (filterTransitionPending && !(options && options.filterTransition)) {
          return Promise.resolve(false);
        }
        if (options && options.poll && expandedView) {
          setLiveState('paused', 'Live refresh paused while viewing older overrides');
          return Promise.resolve(false);
        }
        if (options && options.poll && loadController) return Promise.resolve(false);
        const owner = ++liveOwner;
        setLiveState('loading');
        syncTransitionControls();
        return load(options).then((loaded) => {
          if (owner !== liveOwner) return loaded;
          if (loaded) {
            lastFetch = Date.now();
            if (liveAge) liveAge.textContent = 'just now';
            if (expandedView) {
              setLiveState('paused', 'Live refresh paused while viewing older overrides');
            } else {
              setLiveState('ready');
            }
          } else if (expandedView) {
            setLiveState('paused', 'Live refresh paused while viewing older overrides');
          } else {
            setLiveState('failed');
          }
          syncTransitionControls();
          return loaded;
        });
      }

      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const action = target.closest('[data-action]');
        if (!action) return;
        const actionName = action.getAttribute('data-action');
        if (actionName === 'clear') {
          ev.preventDefault();
          const rowId = action.getAttribute('data-row-id');
          const accountId = action.getAttribute('data-account-id');
          const bucketKey = action.getAttribute('data-bucket-key');
          if (rowId && accountId && bucketKey) clear(rowId, accountId, bucketKey);
          return;
        }
        if (actionName === 'load-more') {
          ev.preventDefault();
          if (!activeMutation) loadWithLive({ append: true });
          return;
        }
        if (actionName === 'back-to-newest' || actionName === 'live-refresh') {
          ev.preventDefault();
          if (!activeMutation) loadWithLive({ reset: true });
          return;
        }
        if (actionName === 'recheck-clear') {
          ev.preventDefault();
          if (activeMutation && activeMutation.phase === 'uncertain') {
            reconcileUnknownClear(activeMutation);
          }
        }
      });

      function start() {
        try {
          token = localStorage.getItem('ds_web_session_token');
        } catch {
          token = null;
        }
        if (!token) {
          renderUnavailable('Sign in with a staff admin account to see rate-limit overrides.');
          setLiveState('failed', 'Sign in for live data');
          showBanner('Sign in with a staff admin account to see live data.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return;
        }
        if (refreshBtn) {
          refreshBtn.disabled = false;
          refreshBtn.removeAttribute('aria-disabled');
          refreshBtn.removeAttribute('title');
          refreshBtn.setAttribute('data-action', 'live-refresh');
        }
        if (accountIdEl) accountIdEl.addEventListener('input', beginFilterTransition);
        if (includeExpiredEl) includeExpiredEl.addEventListener('change', beginFilterTransition);
        setInterval(() => loadWithLive({ poll: true }), 30_000);
        setInterval(() => {
          if (liveAge) liveAge.textContent = fmtAge(lastFetch);
        }, 5_000);
        loadWithLive({ reset: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
