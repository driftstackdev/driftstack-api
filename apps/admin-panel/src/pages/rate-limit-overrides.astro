---
import AdminLayout from '../layouts/AdminLayout.astro';

// V-194 — progressive-enhancement against /v1/admin/rate-limit-
// overrides (new in V-194). SSG renders a placeholder mock; an inline
// <script> fetches with bearer auth, replaces the list, and wires
// Clear-now (DELETE) action against /v1/admin/accounts/:id/quota-
// override?bucket_key=<bucket>. New override / Extend require a target
// account first — surfaced as deep-links into the per-account detail
// page rather than re-implementing the form here.

interface MockOverride {
  id: string;
  accountId: string;
  accountEmail: string;
  bucketKey: 'global' | 'sessions:create';
  capacity: number;
  refillPerSecond: number;
  expiresAt: string | null;
  reason: string;
  createdAt: string;
  createdBy: string;
}

const MOCK_OVERRIDES: MockOverride[] = [
  {
    id: 'rlo_00000000-0000-4000-8000-0000000000f1',
    accountId: 'acc_00000000-0000-4000-8000-000000000002',
    accountEmail: 'agency@driftstack.local',
    bucketKey: 'global',
    capacity: 200,
    refillPerSecond: 10,
    expiresAt: '2026-05-15T00:00:00Z',
    reason: 'Migrating off legacy hours-meter; needs headroom during cutover.',
    createdAt: '2026-05-04T09:00:00Z',
    createdBy: 'staff@driftstack.dev',
  },
];

const BUCKET_LABEL: Record<string, string> = {
  global: 'Global',
  'sessions:create': 'Sessions: create',
  'agent_sessions:message': 'Agent sessions: message',
};

function fmtIso(iso: string | null): string {
  if (iso === null) return 'permanent';
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Rate-limit overrides">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-overrides">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Rate-limit overrides</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 max-w-prose text-sm text-tk-ink-3">
          Per-account bucket overrides that supersede the tier defaults. Used
          for time-boxed capacity bumps during migrations + production
          incidents. All overrides are auditable + auto-expire if a TTL is
          set. To set a new override, open the per-account page (Accounts →
          select account).
        </p>
      </div>
      {/* 2026-05-22 — live auto-poll. Same pattern as 154ff9cf. */}
      <div class="flex items-center gap-3 text-xs whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-emerald-500"
          ></span>
          <span>Live · updated <span data-live-age>just now</span></span>
        </span>
        <button
          type="button"
          data-live-refresh
          class="text-tk-accent hover:underline"
        >
          Refresh now
        </button>
      </div>
    </header>

    <!-- Filter -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <input
        type="search"
        data-field="account-id"
        aria-label="Filter rate-limit overrides by account id"
        placeholder="Account id (acc_<uuid>)"
        class="w-72 rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      />
      <label class="flex items-center gap-2 text-sm text-tk-ink-2">
        <input type="checkbox" data-field="include-expired" class="rounded" />
        Include expired
      </label>
    </div>

    {/* 2026-05-23 — icon on rate-limit empty state. */}
    <div data-region="empty" class="hidden">
      <div class="dashboard-card text-center">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold tracking-tight text-tk-ink">No overrides</h2>
        <p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">
          No active overrides match the current filter. New overrides default
          to a 14-day TTL via the per-account page.
        </p>
      </div>
    </div>

    <ul class="space-y-3" data-list="overrides">
      {
        MOCK_OVERRIDES.map((override) => (
          <li class="dashboard-card">
            <div class="flex items-start justify-between gap-6">
              <div class="min-w-0">
                <div class="flex items-center gap-3">
                  <p class="text-base font-medium text-tk-ink">{override.accountEmail}</p>
                  <span class="inline-flex rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-blue-700">
                    {BUCKET_LABEL[override.bucketKey] ?? override.bucketKey}
                  </span>
                </div>
                <p class="mt-1 font-mono text-[11px] text-tk-ink-3">{override.accountId}</p>
                <p class="mt-3 text-sm text-tk-ink-2">{override.reason}</p>
                <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs">
                  <div>
                    <dt class="text-tk-ink-3">Capacity</dt>
                    <dd class="font-mono text-tk-ink">
                      {override.capacity.toLocaleString('en-US')}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-tk-ink-3">Refill / sec</dt>
                    <dd class="font-mono text-tk-ink">{override.refillPerSecond}</dd>
                  </div>
                  <div>
                    <dt class="text-tk-ink-3">Expires</dt>
                    <dd class="font-mono text-tk-ink">{fmtIso(override.expiresAt)}</dd>
                  </div>
                </dl>
              </div>
              <div class="flex shrink-0 flex-col gap-2">
                <button
                  type="button"
                  data-action="clear"
                  data-account-id={override.accountId}
                  data-bucket-key={override.bucketKey}
                  class="text-sm text-red-700 hover:underline"
                >
                  Clear now
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-xs text-tk-ink-3">
      New overrides default to 14-day TTL. Permanent overrides allowed but
      flagged in the weekly audit-log review. Bucket keys: <code class="font-mono">global</code>
      (whole API), <code class="font-mono">sessions:create</code> (session creation
      only), <code class="font-mono">agent_sessions:message</code> (agent-session
      messages only).
    </p>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-overrides"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const list = root.querySelector('[data-list="overrides"]');
      const emptyRegion = root.querySelector('[data-region="empty"]');
      const accountIdEl = root.querySelector('[data-field="account-id"]');
      const includeExpiredEl = root.querySelector('[data-field="include-expired"]');
      const token = localStorage.getItem('ds_web_session_token');
      const OVERRIDE_TIMEOUT_MS = 15_000;
      let loadController = null;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        return window.driftstackFetchWithDeadline(url, init, OVERRIDE_TIMEOUT_MS, controller);
      }

      function requestErrorMessage(err, fallback) {
        return window.driftstackRequestErrorMessage(err, fallback);
      }

      const BUCKET_LABEL = {
        global: 'Global',
        'sessions:create': 'Sessions: create',
        'agent_sessions:message': 'Agent sessions: message',
      };

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }
      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }
      function fmtIso(iso) {
        if (!iso) return 'permanent';
        return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }

      const clearsInFlight = new Set();
      function clearOperationKey(accountId, bucketKey) {
        return String(accountId) + '\u0000' + String(bucketKey);
      }

      function clearControlState(accountId, bucketKey) {
        const pending = clearsInFlight.has(clearOperationKey(accountId, bucketKey));
        return {
          pending,
          attrs: pending
            ? ' disabled aria-disabled="true" aria-busy="true" title="Wait for the current override clear to finish."'
            : '',
          label: pending ? 'Clear pending…' : 'Clear now',
        };
      }

      function syncClearControls(accountId, bucketKey) {
        const state = clearControlState(accountId, bucketKey);
        root.querySelectorAll('[data-action="clear"]').forEach((control) => {
          if (
            control.getAttribute('data-account-id') !== String(accountId) ||
            control.getAttribute('data-bucket-key') !== String(bucketKey)
          ) {
            return;
          }
          control.disabled = state.pending;
          control.textContent = state.label;
          if (state.pending) {
            control.setAttribute('aria-disabled', 'true');
            control.setAttribute('aria-busy', 'true');
            control.title = 'Wait for the current override clear to finish.';
          } else {
            control.removeAttribute('aria-disabled');
            control.removeAttribute('aria-busy');
            control.removeAttribute('title');
          }
        });
      }

      function rowHtml(o) {
        const bucketLabel = BUCKET_LABEL[o.bucket_key] || o.bucket_key;
        const clearState = clearControlState(o.account_id, o.bucket_key);
        const reasonFrag = o.reason
          ? '<p class="mt-3 text-sm text-tk-ink-2">' + escapeHtml(o.reason) + '</p>'
          : '';
        return (
          '<li class="dashboard-card">' +
          '<div class="flex items-start justify-between gap-6">' +
          '<div class="min-w-0">' +
          '<div class="flex items-center gap-3">' +
          '<p class="font-mono text-[11px] text-tk-ink-3">' +
          escapeHtml(o.account_id) +
          '</p>' +
          '<span class="inline-flex rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-blue-700">' +
          escapeHtml(bucketLabel) +
          '</span></div>' +
          reasonFrag +
          '<dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs">' +
          '<div><dt class="text-tk-ink-3">Capacity</dt><dd class="font-mono text-tk-ink">' +
          escapeHtml(String(o.capacity)) +
          '</dd></div>' +
          '<div><dt class="text-tk-ink-3">Refill / sec</dt><dd class="font-mono text-tk-ink">' +
          escapeHtml(String(o.refill_per_second)) +
          '</dd></div>' +
          '<div><dt class="text-tk-ink-3">Expires</dt><dd class="font-mono text-tk-ink">' +
          escapeHtml(fmtIso(o.expires_at)) +
          '</dd></div>' +
          '</dl></div>' +
          '<div class="flex shrink-0 flex-col gap-2">' +
          '<button type="button" data-action="clear" data-account-id="' +
          escapeHtml(o.account_id) +
          '" data-bucket-key="' +
          escapeHtml(o.bucket_key) +
          '"' +
          clearState.attrs +
          ' class="text-sm text-red-700 hover:underline disabled:cursor-not-allowed disabled:no-underline disabled:opacity-60">' +
          clearState.label +
          '</button>' +
          '</div></div></li>'
        );
      }

      function buildQuery() {
        const params = new URLSearchParams();
        params.set('limit', '50');
        if (accountIdEl && accountIdEl.value.trim())
          params.set('account_id', accountIdEl.value.trim());
        if (includeExpiredEl && includeExpiredEl.checked)
          params.set('include_expired', 'true');
        return params;
      }

      let inFlight = 0;
      function load() {
        if (!token) return Promise.resolve(false);
        const myReq = ++inFlight;
        const params = buildQuery();
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          apiBaseUrl + '/v1/admin/rate-limit-overrides?' + params.toString(),
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return false;
            const rows = body.data || [];
            if (rows.length === 0) {
              if (list) {
                list.classList.add('hidden');
                // Remove stale action nodes as well as hiding the list. A
                // completed clear must not leave a re-enabled old button in DOM.
                list.innerHTML = '';
              }
              if (emptyRegion) emptyRegion.classList.remove('hidden');
            } else {
              if (list) {
                list.classList.remove('hidden');
                list.innerHTML = rows.map(rowHtml).join('');
              }
              if (emptyRegion) emptyRegion.classList.add('hidden');
            }
            hideBanner();
            return true;
          })
          .catch((err) => {
            if (myReq !== inFlight) return false;
            const msg = requestErrorMessage(err, 'network error');
            if (list) {
              list.classList.remove('hidden');
              list.innerHTML =
                '<li class="rounded-lg border border-tk-border bg-tk-bg p-5 text-sm text-tk-ink-3">Could not load live overrides — nothing to act on. Resolve the error above and retry.</li>';
            }
            if (emptyRegion) emptyRegion.classList.add('hidden');
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner("Couldn't load overrides (" + msg + ').');
            }
            return false;
          })
          .finally(() => {
            if (myReq === inFlight) {
              loadController = null;
              root.removeAttribute('aria-busy');
            }
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      async function clear(prefixedAccountId, bucketKey, btn) {
        if (!token) return;
        const operationKey = clearOperationKey(prefixedAccountId, bucketKey);
        if (clearsInFlight.has(operationKey)) return;
        clearsInFlight.add(operationKey);
        syncClearControls(prefixedAccountId, bucketKey);
        if (btn) {
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          btn.textContent = 'Confirming…';
        }
        try {
          const proceed = await window.driftstackConfirm(
            'Clear the ' + bucketKey + ' override for ' + prefixedAccountId + '?',
            { confirmLabel: 'Clear', destructive: true },
          );
          if (!proceed) return;
          if (btn) btn.textContent = 'Clearing…';
          showBanner('Clearing override…');
          const response = await boundedFetch(
            apiBaseUrl +
              '/v1/admin/accounts/' +
              encodeURIComponent(prefixedAccountId) +
              '/quota-override?bucket_key=' +
              encodeURIComponent(bucketKey),
            {
              method: 'DELETE',
              headers: { authorization: 'Bearer ' + token },
              credentials: 'include',
            },
          );
          if (response.status !== 204 && !response.ok) {
            throw new Error('HTTP ' + response.status);
          }
          showBanner('Override cleared. Refreshing…');
          await load();
        } catch (err) {
          if (err && err.name === 'AbortError') {
            const refreshed = await load();
            const stillActionable = Array.from(
              root.querySelectorAll('[data-action="clear"]'),
            ).some(
              (button) =>
                button.getAttribute('data-account-id') === prefixedAccountId &&
                button.getAttribute('data-bucket-key') === bucketKey,
            );
            if (refreshed && !stillActionable) {
              showBanner(
                'Override-clear outcome is unknown because the response timed out. Overrides were refreshed and the ' +
                  bucketKey +
                  ' override for ' +
                  prefixedAccountId +
                  ' is absent; clearing likely completed, so do not submit it again.',
              );
            } else if (refreshed) {
              showBanner(
                'Override-clear outcome is unknown because the response timed out. Overrides were refreshed and the override is still actionable; retry clearing if it must be removed.',
              );
            } else {
              showBanner(
                'Override-clear outcome is unknown because the response timed out, and overrides could not be refreshed. Verify the override before retrying.',
              );
            }
          } else {
            const msg = requestErrorMessage(err, 'network error');
            showBanner("Couldn't clear (" + msg + ').');
          }
        } finally {
          clearsInFlight.delete(operationKey);
          syncClearControls(prefixedAccountId, bucketKey);
        }
      }

      root.addEventListener('click', (ev) => {
        const target = ev.target;
        if (!target || !target.closest) return;
        const btn = target.closest('[data-action="clear"]');
        if (!btn) return;
        ev.preventDefault();
        const accountId = btn.getAttribute('data-account-id');
        const bucketKey = btn.getAttribute('data-bucket-key');
        if (accountId && bucketKey) clear(accountId, bucketKey, btn);
      });

      let debounce = 0;
      function scheduleLoad() {
        clearTimeout(debounce);
        debounce = setTimeout(load, 200);
      }
      if (accountIdEl) accountIdEl.addEventListener('input', scheduleLoad);
      if (includeExpiredEl) includeExpiredEl.addEventListener('change', scheduleLoad);

      if (!token) {
        showBanner('Sign in with a staff admin account to see live data. Showing preview below.');
        return;
      }

      // 2026-05-22 — live auto-poll. Same pattern as 154ff9cf.
      let lastFetch = Date.now();
      function loadWithLive() {
        const liveDot = root.querySelector('[data-live-dot]');
        if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-amber-500';
        const p = load();
        if (p && typeof p.then === 'function') {
          p.then(
            () => {
              lastFetch = Date.now();
              if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-emerald-500';
            },
            () => {
              if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-red-500';
            },
          );
        } else {
          lastFetch = Date.now();
        }
      }
      const refreshBtn = root.querySelector('[data-live-refresh]');
      if (refreshBtn) refreshBtn.addEventListener('click', loadWithLive);
      setInterval(loadWithLive, 30_000);
      function fmtAge(ms) {
        const s = Math.floor((Date.now() - ms) / 1000);
        if (s < 5) return 'just now';
        if (s < 60) return s.toString() + 's ago';
        if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
        return Math.floor(s / 3600).toString() + 'h ago';
      }
      const ageEl = root.querySelector('[data-live-age]');
      setInterval(() => {
        if (ageEl) ageEl.textContent = fmtAge(lastFetch);
      }, 5_000);

      load();
    })();
  </script>
</AdminLayout>
