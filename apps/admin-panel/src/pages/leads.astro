---
import AdminLayout from '../layouts/AdminLayout.astro';
import { MOCK_LEADS } from '../data/mocks.ts';

function fmtIso(iso: string): string {
  return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
}

const SOURCE_BADGE: Record<string, string> = {
  pricing_cta: 'bg-oxblood-50 text-oxblood-700',
  docs_signup: 'bg-blue-50 text-blue-700',
  email_inbound: 'bg-emerald-50 text-emerald-700',
  other: 'bg-slate-100 text-slate-600',
};

const SOURCE_LABEL: Record<string, string> = {
  pricing_cta: 'Pricing CTA',
  docs_signup: 'Docs signup',
  email_inbound: 'Email inbound',
  other: 'Other',
};
---

<AdminLayout title="Leads">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Leads</span></h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 text-sm text-slate-500">
          Pre-signup interest captured from the marketing site, docs, and inbound
          email. Convert to account or archive once contacted.
        </p>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <input
        type="search"
        placeholder="Filter by email or notes…"
        class="w-72 rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      />
      <select
        class="rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      >
        <option value="">All sources</option>
        <option value="pricing_cta">Pricing CTA</option>
        <option value="docs_signup">Docs signup</option>
        <option value="email_inbound">Email inbound</option>
        <option value="other">Other</option>
      </select>
    </div>

    {
      MOCK_LEADS.length === 0 ? (
        <div class="dashboard-card text-center">
          {/* 2026-05-23 — icon on empty state. */}
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-oxblood-700/10 ring-1 ring-oxblood-700/20 text-oxblood-700">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="8.5" cy="7" r="4" />
              <path d="M20 8v6M23 11h-6" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold tracking-tight"><span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">No leads yet</span></h2>
          <p class="mx-auto mt-2 max-w-prose text-sm text-slate-500">
            Once the marketing site captures signup intent, leads land here for
            sales follow-up.
          </p>
        </div>
      ) : (
        <ul class="space-y-3">
          {MOCK_LEADS.map((lead) => (
            <li class="dashboard-card">
              <div class="flex items-start justify-between gap-6">
                <div class="min-w-0">
                  <p class="text-base font-medium text-slate-900">{lead.email}</p>
                  <p class="mt-1 font-mono text-xs text-slate-500">{lead.id}</p>
                  <p class="mt-1 text-xs text-slate-500">
                    Captured {fmtIso(lead.capturedAt)}
                  </p>
                  {lead.notes !== null && (
                    <p class="mt-3 text-sm text-slate-700">{lead.notes}</p>
                  )}
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                      SOURCE_BADGE[lead.source] ?? SOURCE_BADGE.other,
                    ]}
                  >
                    {SOURCE_LABEL[lead.source] ?? lead.source}
                  </span>
                  <a href={`/leads/${lead.id}`} class="text-sm text-oxblood-700 hover:underline">
                    Open
                  </a>
                </div>
              </div>
              <div class="mt-4 flex flex-wrap gap-3 border-t border-slate-100 pt-3">
                <a href={`#convert-${lead.id}`} class="text-sm text-oxblood-700 hover:underline">
                  Convert to account →
                </a>
                <a href={`#archive-${lead.id}`} class="text-sm text-slate-600 hover:underline">
                  Archive
                </a>
                <a
                  href={`mailto:${lead.email}`}
                  class="text-sm text-slate-600 hover:underline"
                >
                  Email reply
                </a>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-8 text-xs text-slate-500">
      Conversion creates an account row + sends a magic-link signup email.
      Archive marks the lead resolved without account creation. All actions
      audit-logged.
    </p>
  </div>
</AdminLayout>
