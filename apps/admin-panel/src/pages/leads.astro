---
import AdminLayout from '../layouts/AdminLayout.astro';

// Lead capture isn't wired yet — there is no /v1/admin/leads server route
// and no leads table, so this page has no live data source. It previously
// SSG-rendered fabricated demo lead rows with dead /leads/{id} links +
// dead #convert / #archive anchors (no handlers, no backend), presenting
// fake records as real ops data. Until the feature lands, render an honest
// "coming soon" empty state with no fabricated rows and no dead actions.
// The nav entry stays so the surface is discoverable.
---

<AdminLayout title="Leads">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Leads</h1>
       <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 text-sm text-tk-ink-3">
          Pre-signup interest captured from the marketing site, docs, and inbound
          email will appear here once lead capture is wired.
        </p>
      </div>
    </header>

    <div class="dashboard-card text-center">
      {/* 2026-05-23 — icon on empty state. */}
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-tk-accent/10 ring-1 ring-tk-accent/20 text-tk-accent">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="8.5" cy="7" r="4" />
          <path d="M20 8v6M23 11h-6" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold tracking-tight text-tk-ink">Coming soon</h2>
      <p class="mx-auto mt-2 max-w-prose text-sm text-tk-ink-3">
        Lead capture isn't wired yet — there's no backend route for leads. Once
        the marketing site captures signup intent, leads will land here for
        sales follow-up.
      </p>
    </div>
  </div>
</AdminLayout>
