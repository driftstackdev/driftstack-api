---
import AdminLayout from '../layouts/AdminLayout.astro';
import { MOCK_ACCOUNTS } from '../data/mocks.ts';

// V-187 — progressive-enhancement against /v1/admin/accounts. SSG
// renders the mock; an inline <script> reads ds_web_session_token
// from localStorage and replaces the table body with live rows
// (filtered server-side via the status / tier query params). Banners
// surface no-token / fetch-error / empty-result states. Filter bar
// inputs trigger a re-fetch on change.

function fmtIso(iso: string | null): string {
  if (iso === null) return '—';
  return new Date(iso).toISOString().slice(0, 10);
}

const STATUS_BADGE: Record<string, string> = {
  active: 'bg-emerald-50 text-emerald-700',
  suspended: 'bg-amber-50 text-amber-700',
  deleted: 'bg-tk-hover text-tk-ink-2',
};

import { resolveApiBaseUrl } from '../lib/api-base-url';
const apiBaseUrl = resolveApiBaseUrl();
---

<AdminLayout title="Accounts">
  <div class="mx-auto max-w-6xl px-6 py-10" data-page="admin-accounts">
    <div
      data-banner
      class="mb-6 hidden rounded-lg border border-tk-border bg-tk-bg px-4 py-3 text-sm text-tk-ink-2"
      role="status"
    >
    </div>

    <header class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-tk-ink">Accounts</h1>
        <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
        <p class="mt-2 text-sm text-tk-ink-3">
          All customer accounts. Filter by tier or status; click a row to drill into
          per-account detail (tier change, suspend, audit log slice).
        </p>
      </div>
      {/* 2026-05-22 — auto-poll live indicator. Same shape as the
          overview live feed (2c24750f). Refreshes the accounts list
          every 30s so new sign-ups appear without F5. */}
      <div class="flex items-center gap-3 text-xs">
        <span class="flex items-center gap-1.5 text-tk-ink-3">
          <span
            aria-hidden="true"
            data-live-dot
            class="inline-block h-2 w-2 rounded-full bg-emerald-500"
          ></span>
          <span>Live · updated <span data-live-age>just now</span></span>
        </span>
        <button
          type="button"
          data-live-refresh
          class="text-tk-accent hover:underline"
        >
          Refresh now
        </button>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <div class="relative">
        <input
          type="search"
          data-field="search"
          placeholder="Search by email substring…  ( /  to focus)"
          class="w-72 rounded-md border border-tk-border px-3 py-2 pr-12 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
        />
        <kbd
          aria-hidden="true"
          class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-tk-border bg-tk-bg px-1.5 py-0.5 font-mono text-[10px] text-tk-ink-3"
          data-search-kbd
        >
          /
        </kbd>
      </div>
      <select
        data-field="status"
        class="rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      >
        <option value="">All statuses</option>
        <option value="active">Active</option>
        <option value="suspended">Suspended</option>
        <option value="deleted">Deleted</option>
      </select>
      <select
        data-field="tier"
        class="rounded-md border border-tk-border px-3 py-2 text-sm shadow-sm focus:border-tk-accent focus:outline-none focus:ring-1 focus:ring-tk-accent"
      >
        <option value="">All tiers</option>
        <option value="free">Free</option>
        <option value="solo_manual">Personal</option>
        <option value="team_manual">Team</option>
        <option value="agency_manual">Agency</option>
        <option value="api_starter">API Starter</option>
        <option value="api_builder">API Builder</option>
        <option value="api_scale">API Scale</option>
        <option value="enterprise">Enterprise</option>
      </select>
    </div>

    <!-- Accounts table -->
    <div class="overflow-x-auto rounded-lg border border-tk-border bg-tk-surface">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-tk-border text-left text-xs font-medium uppercase tracking-wide text-tk-ink-3">
            <th class="px-4 py-3">Account</th>
            <th class="px-4 py-3">Tier</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Created</th>
            <th class="px-4 py-3">Last updated</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" data-list="accounts">
          {
            MOCK_ACCOUNTS.map((account) => (
              <tr class="hover:bg-tk-bg">
                <td class="px-4 py-3">
                  <p class="font-medium text-tk-ink">{account.name ?? account.email}</p>
                  {account.name !== null && (
                    <p class="mt-0.5 text-xs text-tk-ink-3">{account.email}</p>
                  )}
                  <p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">{account.id}</p>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-tk-ink-2">{account.tier}</td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide',
                      STATUS_BADGE[account.status],
                    ]}
                  >
                    {account.status}
                  </span>
                </td>
                <td class="px-4 py-3 text-tk-ink-2">{fmtIso(account.createdAt)}</td>
                <td class="px-4 py-3 text-tk-ink-2">{fmtIso(account.lastSeenAt)}</td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/accounts/${account.id}`}
                    class="text-sm text-tk-accent hover:underline"
                  >
                    Open
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex items-center gap-4">
      <p class="text-xs text-tk-ink-3" data-field="footnote">
        Showing {MOCK_ACCOUNTS.length} of {MOCK_ACCOUNTS.length} accounts. Pagination
        via cursor when count exceeds page size (50 default).
      </p>
      {/* audit waefer6wu — the footnote advertised cursor pagination the UI
          never actually implemented: GET /v1/admin/accounts already returns
          has_more + next_cursor (apps/server/src/routes/admin-accounts.ts),
          but buildQuery() never sent a cursor and nothing ever read
          next_cursor, so rows past the first 50 were silently unreachable.
          This button wires the existing server-side cursor support. */}
      <button
        type="button"
        data-action="load-more"
        class="hidden shrink-0 text-xs font-medium text-tk-accent hover:underline"
      >
        Load more
      </button>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl }}>
    (function () {
      const root = document.querySelector('[data-page="admin-accounts"]');
      if (!root) return;
      const banner = root.querySelector('[data-banner]');
      const tbody = root.querySelector('[data-list="accounts"]');
      const footnote = root.querySelector('[data-field="footnote"]');
      const searchEl = root.querySelector('[data-field="search"]');
      const statusEl = root.querySelector('[data-field="status"]');
      const tierEl = root.querySelector('[data-field="tier"]');
      // audit waefer6wu — SSO-bridge race: this page's own <script> is
      // nested inside <AdminLayout>'s <slot/>, so it parses + runs BEFORE
      // AdminLayout's trailing <script> that reads the #token= hash from a
      // fresh SSO sign-in and writes it to localStorage. Reading the token
      // here synchronously (as this used to) ran before that write landed,
      // so every fresh sign-in showed a false "not signed in" banner with
      // no automatic recovery. `token` is read inside start(), which is
      // deferred to DOMContentLoaded — guaranteeing every earlier blocking
      // <script> in the document (including the SSO bridge) has already
      // executed and the real token is in localStorage by the time it's read.
      let token = null;
      const ACCOUNTS_TIMEOUT_MS = 15_000;
      let loadController = null;
      let loadMoreInFlight = false;

      function boundedFetch(url, init = {}, controller = new AbortController()) {
        const timeout = window.setTimeout(() => controller.abort(), ACCOUNTS_TIMEOUT_MS);
        return fetch(url, { ...init, signal: controller.signal }).finally(() => {
          window.clearTimeout(timeout);
        });
      }

      function requestErrorMessage(err, fallback) {
        return err && err.name === 'AbortError'
          ? 'Request timed out. Try again.'
          : err && err.message
            ? err.message
            : fallback;
      }

      const STATUS_BADGE = {
        active: 'bg-emerald-50 text-emerald-700',
        suspended: 'bg-amber-50 text-amber-700',
        deleted: 'bg-tk-hover text-tk-ink-2',
      };

      function showBanner(text) {
        if (!banner) return;
        banner.textContent = text;
        banner.classList.remove('hidden');
      }
      function hideBanner() {
        if (!banner) return;
        banner.classList.add('hidden');
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c],
        );
      }

      function fmtIso(iso) {
        if (!iso) return '—';
        return new Date(iso).toISOString().slice(0, 10);
      }

      function rowHtml(a) {
        const stripped = a.id.replace(/^acc_/, '');
        const nameLine = a.name ? escapeHtml(a.name) : escapeHtml(a.email);
        const subEmail = a.name
          ? '<p class="mt-0.5 text-xs text-tk-ink-3">' + escapeHtml(a.email) + '</p>'
          : '';
        return (
          '<tr class="hover:bg-tk-bg">' +
          '<td class="px-4 py-3">' +
          '<p class="font-medium text-tk-ink">' +
          nameLine +
          '</p>' +
          subEmail +
          '<p class="mt-0.5 font-mono text-[11px] text-tk-ink-3">' +
          escapeHtml(a.id) +
          '</p></td>' +
          '<td class="px-4 py-3 font-mono text-xs text-tk-ink-2">' +
          escapeHtml(a.tier) +
          '</td>' +
          '<td class="px-4 py-3">' +
          '<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ' +
          (STATUS_BADGE[a.status] || '') +
          '">' +
          escapeHtml(a.status) +
          '</span></td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(fmtIso(a.created_at)) +
          '</td>' +
          '<td class="px-4 py-3 text-tk-ink-2">' +
          escapeHtml(fmtIso(a.updated_at)) +
          '</td>' +
          '<td class="px-4 py-3 text-right">' +
          '<a href="/accounts/' +
          encodeURIComponent(stripped) +
          '" class="text-sm text-tk-accent hover:underline">Open</a>' +
          '</td></tr>'
        );
      }

      // audit waefer6wu — the footnote advertised cursor pagination
      // ("Pagination via cursor when count exceeds page size") that the UI
      // never actually implemented: buildQuery() never sent `cursor`, and
      // nothing ever read `body.next_cursor`, so once a (possibly filtered)
      // list exceeded 50 rows, every row past the 50th was permanently
      // unreachable with no indication more existed. The server already
      // fully supports this (admin-accounts.ts accepts `cursor`, returns
      // `has_more` + `next_cursor: acc_<uuid>`) — wire it client-side.
      function buildQuery(cursor) {
        const params = new URLSearchParams();
        params.set('limit', '50');
        if (statusEl && statusEl.value) params.set('status', statusEl.value);
        if (tierEl && tierEl.value) params.set('tier', tierEl.value);
        if (searchEl && searchEl.value.trim())
          params.set('email_contains', searchEl.value.trim());
        if (cursor) params.set('cursor', cursor);
        return params;
      }

      const loadMoreBtn = root.querySelector('[data-action="load-more"]');
      let loadedAccounts = [];
      let nextCursor = null;

      let inFlight = 0;
      // append=true fetches the next cursor page and adds it to the
      // currently-rendered rows (the "Load more" click path); the default
      // (filter change / initial load / 30s live poll) always starts a
      // fresh first page — auto-poll intentionally resets any "loaded more"
      // state back to the canonical first 50 rather than trying to merge.
      function load(opts) {
        const append = !!(opts && opts.append);
        if (!token) return Promise.resolve();
        if (append && !nextCursor) return Promise.resolve();
        const myReq = ++inFlight;
        const params = buildQuery(append ? nextCursor : undefined);
        if (loadMoreBtn) loadMoreBtn.disabled = true;
        if (loadController) loadController.abort();
        const controller = new AbortController();
        loadController = controller;
        root.setAttribute('aria-busy', 'true');
        return boundedFetch(
          apiBaseUrl + '/v1/admin/accounts?' + params.toString(),
          {
            headers: { authorization: 'Bearer ' + token },
            credentials: 'include',
          },
          controller,
        )
          .then((r) => {
            if (r.status === 403) return Promise.reject(new Error('forbidden'));
            return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status));
          })
          .then((body) => {
            if (myReq !== inFlight) return; // stale response, ignore
            const accounts = body.data || [];
            loadedAccounts = append ? loadedAccounts.concat(accounts) : accounts;
            nextCursor = body.next_cursor || null;
            if (tbody) {
              if (loadedAccounts.length === 0) {
                tbody.innerHTML =
                  '<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-tk-ink-3">No accounts match the current filter.</td></tr>';
              } else {
                tbody.innerHTML = loadedAccounts.map(rowHtml).join('');
              }
            }
            if (footnote) {
              const more = body.has_more
                ? ' — more available (' + (nextCursor ? 'click Load more' : 'refine filter') + ')'
                : '';
              footnote.textContent =
                'Showing ' +
                loadedAccounts.length +
                ' account' +
                (loadedAccounts.length === 1 ? '' : 's') +
                more +
                '.';
            }
            if (loadMoreBtn) {
              loadMoreBtn.classList.toggle('hidden', !(body.has_more && nextCursor));
              loadMoreBtn.disabled = false;
              loadMoreBtn.textContent = 'Load more';
            }
            hideBanner();
          })
          .catch((err) => {
            if (myReq !== inFlight) return;
            const msg = requestErrorMessage(err, 'network error');
            if (loadMoreBtn) loadMoreBtn.disabled = false;
            // W604 — clear the SSG mock rows on ANY load failure so operators
            // never triage a fabricated customer list (3 fake accounts with
            // Open links into mock detail pages) during an API error.
            if (!append && tbody) {
              tbody.innerHTML =
                '<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-tk-ink-3">Could not load accounts. Resolve the error above and retry.</td></tr>';
            }
            if (!append && footnote) footnote.textContent = '';
            if (msg === 'forbidden') {
              showBanner(
                'Access denied — admin scope required. You are signed in as a customer account.',
              );
            } else {
              showBanner(
                (append ? "Couldn't load more accounts (" : "Couldn't load accounts (") +
                  msg +
                  ').',
              );
            }
          })
          .finally(() => {
            if (append) loadMoreInFlight = false;
            if (myReq === inFlight) {
              loadController = null;
              root.removeAttribute('aria-busy');
            }
            // 2026-05-21 — AdminLayout opacity-gate signal (same pattern
            // as the customer-dashboard pages).
            if (typeof window.dashboardHydrated === 'function') {
              window.dashboardHydrated();
            }
          });
      }

      // start() does the token-gated work: reading the token, deciding
      // sign-in-vs-live, wiring filter/search/live-poll listeners, and
      // firing the first load(). Deferring the whole thing to
      // DOMContentLoaded (see the `token` declaration above) is what
      // actually closes the SSO-bridge race — reading `token` any earlier
      // re-introduces it.
      function start() {
        token = localStorage.getItem('ds_web_session_token');

        if (!token) {
          // W604 — clear the SSG mock so the unauthenticated state never shows
          // fabricated customer accounts with Open links into mock detail pages.
          if (tbody) {
            tbody.innerHTML =
              '<tr><td colspan="6" class="px-4 py-8 text-center text-sm text-tk-ink-3">Sign in with a staff admin account to see accounts.</td></tr>';
          }
          if (footnote) footnote.textContent = '';
          showBanner('Sign in with a staff admin account to see live data.');
          if (typeof window.dashboardHydrated === 'function') window.dashboardHydrated();
          return;
        }

        let debounce = 0;
        function scheduleLoad() {
          clearTimeout(debounce);
          debounce = setTimeout(load, 200);
        }

        if (statusEl) statusEl.addEventListener('change', scheduleLoad);
        if (tierEl) tierEl.addEventListener('change', scheduleLoad);
        if (searchEl) searchEl.addEventListener('input', scheduleLoad);

        if (loadMoreBtn) {
          loadMoreBtn.addEventListener('click', () => {
            if (loadMoreInFlight) return;
            loadMoreInFlight = true;
            loadMoreBtn.textContent = 'Loading…';
            loadMoreBtn.setAttribute('aria-busy', 'true');
            load({ append: true }).finally(() => {
              loadMoreBtn.removeAttribute('aria-busy');
            });
          });
        }

        // 2026-05-22 — "/" focuses the search (GitHub / Slack / Linear
        // convention). Skips if the user is already in an input /
        // textarea so the slash key doesn't hijack legitimate typing.
        document.addEventListener('keydown', (ev) => {
          if (ev.key !== '/' || ev.metaKey || ev.ctrlKey || ev.altKey) return;
          const target = ev.target;
          if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
          if (target instanceof HTMLElement && target.isContentEditable) return;
          ev.preventDefault();
          if (searchEl instanceof HTMLInputElement) {
            searchEl.focus();
            searchEl.select();
          }
        });

        // 2026-05-22 — 30s auto-poll for new sign-ups. Same pattern as
        // the overview live feed (2c24750f). loadWithLive() wraps the
        // existing load() to also flip the live-dot color + record
        // lastFetch. Timer calls it directly (bypasses scheduleLoad's
        // 200ms debounce which is for input typing only).
        let lastFetch = Date.now();
        function loadWithLive() {
          const liveDot = root.querySelector('[data-live-dot]');
          if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-amber-500';
          const p = load();
          if (p && typeof p.then === 'function') {
            p.then(
              () => {
                lastFetch = Date.now();
                if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-emerald-500';
              },
              () => {
                if (liveDot) liveDot.className = 'inline-block h-2 w-2 rounded-full bg-red-500';
              },
            );
          } else {
            lastFetch = Date.now();
          }
        }
        const refreshBtn = root.querySelector('[data-live-refresh]');
        if (refreshBtn) refreshBtn.addEventListener('click', loadWithLive);
        setInterval(loadWithLive, 30_000);
        function fmtAge(ms) {
          const s = Math.floor((Date.now() - ms) / 1000);
          if (s < 5) return 'just now';
          if (s < 60) return s.toString() + 's ago';
          if (s < 3600) return Math.floor(s / 60).toString() + 'm ago';
          return Math.floor(s / 3600).toString() + 'h ago';
        }
        const ageEl = root.querySelector('[data-live-age]');
        setInterval(() => {
          if (ageEl) ageEl.textContent = fmtAge(lastFetch);
        }, 5_000);

        load();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
</AdminLayout>
