---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="404">
  <div class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-oxblood-700">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight"><span class="bg-gradient-to-br from-slate-900 via-slate-900 to-oxblood-700 bg-clip-text text-transparent">Page not found.</span></h1>
    <p class="mt-4 text-slate-600">
      The admin panel has no page at this path. Check the sidebar links.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="btn-primary">Back to overview</a>
    </div>
  </div>
</AdminLayout>
