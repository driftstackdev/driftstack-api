---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="404">
  <div class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-tk-accent">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-tk-ink">Page not found.</h1>
   <div class="mt-3 h-px w-16 bg-gradient-to-r from-oxblood-700 to-transparent" aria-hidden="true"></div>
    <p class="mt-4 text-tk-ink-2">
      The admin panel has no page at this path. Check the sidebar links.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="btn-primary">Back to overview</a>
    </div>
  </div>
</AdminLayout>
