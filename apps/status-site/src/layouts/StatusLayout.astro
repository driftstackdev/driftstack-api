---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-white/10 bg-surface-raised">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-baseline gap-2 text-sm">
          <span class="text-base font-semibold tracking-tight text-ink-primary">Driftstack</span>
          <span class="text-ink-muted">·</span>
          <span class="text-ink-muted">status</span>
        </a>
        <nav class="text-sm">
          <a href="https://driftstack.dev" class="text-ink-muted hover:text-ink-primary">
            driftstack.dev
          </a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
    <footer class="mt-12 border-t border-white/10 bg-surface-raised">
      <div
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-6 py-6 text-xs text-ink-muted"
      >
        <span>Driftstack is a Dutch BV. Status data is operational only — never customer data.</span>
        <a href="https://driftstack.dev/legal/privacy-policy" class="hover:text-ink-primary">
          Privacy
        </a>
      </div>
    </footer>
  </body>
</html>
