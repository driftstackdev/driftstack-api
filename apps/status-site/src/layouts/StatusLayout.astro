---
import '../styles/global.css';

interface Props {
  title: string;
  /** Error and one-time token utility pages must not enter search indexes. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="dark" data-accent="oxblood">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=4" />
  </head>
  <body class="min-h-screen">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR users skip the header nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-glow-red focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to main content
    </a>
    <header class="border-b border-surface-divider bg-surface-raised">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-2 text-sm">
          <img
            src="/driftstack-mark.svg?v=4"
            alt="Driftstack"
            width="24"
            height="24"
            class="inline-block h-6 w-6"
          />
          <span class="text-base font-black italic tracking-tight text-ink-primary">DRIFT<span class="text-glow-red">STACK</span></span>
          <span class="text-ink-muted">·</span>
          <span class="text-ink-muted">status</span>
        </a>
        <nav class="text-sm">
          <a href="https://driftstack.dev" class="text-ink-muted hover:text-ink-primary">
            driftstack.dev
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
    <footer class="mt-12 border-t border-surface-divider bg-surface-raised">
      <div
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-6 py-6 text-xs text-ink-muted"
      >
        <span>Driftstack is a Dutch BV. Status data is operational only — never customer data.</span>
        <a href="https://driftstack.dev/legal/privacy" class="hover:text-ink-primary">
          Privacy
        </a>
      </div>
    </footer>
  </body>
</html>
