---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Error and one-time token utility pages must not enter search indexes. */
  noindex?: boolean;
}

const {
  title,
  description = 'Driftstack service status and incident updates.',
  noindex = false,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// P4 (2026-09-25) — the desktop app's light theme, and ONLY light: the privacy
// policy (section 3.9) says this page stores nothing on the visitor's device,
// and remembering a theme choice would need client storage
// (privacy-policy-storage-claims-hold-in-code guards it). Nothing follows the
// system theme either, as on every surface. theme-color is the light page
// ground (surface-base #ebedf2).
//
// <body> is a column that fills the viewport and <main>
// grows (flex-1), so on a short page (an incident, a 404) the footer sits at
// the bottom edge instead of leaving a strip of page ground under it.
---

<!doctype html>
<html lang="en" data-mode="light" data-accent="oxblood">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Keep iOS Safari's status-bar/chrome aligned with the light page ground
         instead of flashing the UA default. -->
    <meta name="theme-color" content="#ebedf2" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    {!noindex && canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      !noindex && canonicalUrl && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Driftstack status" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta name="twitter:card" content="summary" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
        </>
      )
    }
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=5" />
  </head>
  <body class="flex min-h-screen flex-col">
    {/* WCAG 2.4.1 Bypass Blocks — keyboard/SR users skip the header nav. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent-on"
    >
      Skip to main content
    </a>
    <header class="border-b border-surface-divider bg-surface-raised">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-2 text-sm">
          <img
            src="/driftstack-mark.svg?v=5"
            alt="Driftstack"
            width="24"
            height="24"
            class="inline-block h-6 w-6"
          />
          <span class="text-base font-black italic tracking-tight text-ink-primary">DRIFT<span class="text-accent-text">STACK</span></span>
          <span class="text-ink-muted">·</span>
          <span class="text-ink-muted">status</span>
        </a>
        <nav class="text-sm">
          <a href="https://driftstack.io" class="text-ink-muted hover:text-ink-primary">
            driftstack.io
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-3xl flex-1 px-6 py-10">
      <slot />
    </main>
    <footer class="mt-12 border-t border-surface-divider bg-surface-raised">
      <div
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-6 py-6 text-xs text-ink-muted"
      >
        <span>Driftstack is a Dutch BV. Status data is operational only — never customer data.</span>
        <a href="https://driftstack.io/legal/privacy/" class="hover:text-ink-primary">
          Privacy
        </a>
      </div>
    </footer>
  </body>
</html>
