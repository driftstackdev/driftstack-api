---
import StatusLayout from '../layouts/StatusLayout.astro';

// V-657 — incident-email subscription handler. Renders a tiny form
// that POSTs to /v1/status/subscribe; the V-540.B-11-tested
// double-opt-in flow takes over from there (server emails a confirm
// link; customer clicks; confirmed_at is set on the row).
//
// No JavaScript framework — pure HTML form + inline JS for the
// fetch + success/error UI. Keeps the page light enough to render
// even when the control plane is degraded (the form posts to the
// control plane, but the page itself is static-served from Cloudflare
// Pages).
const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.driftstack.dev';
---

<StatusLayout
  title="Driftstack — Status email subscription"
  description="Subscribe to double-opt-in email notifications for new and resolved Driftstack service incidents."
>
  <section class="mb-8">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Subscribe</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink-primary">
      Get incident emails
    </h1>
    <p class="mt-3 max-w-prose text-sm text-ink-secondary">
      We'll email you when we post a service-status incident, at most
      once an hour while it stays open, and again when it resolves. We
      won't email you for anything else.
    </p>
  </section>

  <section class="mb-12">
    <form
      id="subscribe-form"
      class="rounded-lg border border-surface-divider bg-surface-raised p-6 shadow-xs"
      novalidate
    >
      <label for="email-input" class="block text-sm font-medium text-ink-secondary">
        Email address
      </label>
      <input
        id="email-input"
        type="email"
        name="email"
        required
        autocomplete="email"
        aria-describedby="subscribe-status"
        aria-invalid="false"
        placeholder="you@example.com"
        class="mt-2 block w-full rounded-md border border-surface-divider px-3 py-2 text-sm focus:border-oxblood-700 focus:outline-hidden focus:ring-1 focus:ring-oxblood-700"
      />
      <button
        id="submit-btn"
        type="submit"
        class="mt-4 inline-flex items-center rounded-md bg-oxblood-700 px-4 py-2 text-sm font-medium text-white hover:bg-oxblood-600 disabled:opacity-50"
      >
        Subscribe
      </button>
      <p id="subscribe-status" class="mt-3 hidden text-sm" role="status"></p>
    </form>

    <!-- Wave 1119 / Slice 1119.3 C1 — dedicated confirm pane that replaces
         the form when the 202 fires. The previous UX was a single status
         line which buried the next action ("check inbox + click link")
         in a small italic line below the form. Customers told us they
         weren't sure if the click had taken effect. The pane states
         (a) the address it was sent to, (b) the sender to look for, (c)
         the spam-folder hint, and (d) a "subscribe another address"
         affordance so the customer can subscribe their team without a
         page reload. -->
    <div
      id="subscribe-confirm"
      class="mt-6 hidden rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-6 shadow-xs"
      role="status"
      aria-live="polite"
    >
      <p class="text-sm font-medium text-emerald-300">
        Confirmation email sent to <span id="confirm-email" class="font-mono"></span>.
      </p>
      <p class="mt-3 text-sm text-ink-secondary">
        Look for a message from <span class="font-mono">status@driftstack.dev</span>
        in the next minute or two and click the confirmation link to finish
        subscribing. We won't add your address to the notification list
        until you click. If it doesn't arrive within 5 minutes, check your
        spam folder.
      </p>
      <p class="mt-3 text-xs text-ink-muted">
        Already confirmed? You can close this page. We'll only email you
        about incidents — posted, at most hourly while open, and resolved —
        and every email carries a one-click unsubscribe link.
      </p>
      <button
        id="subscribe-another-btn"
        type="button"
        class="mt-4 inline-flex items-center rounded-md border border-surface-divider px-3 py-1.5 text-xs font-medium text-ink-secondary hover:border-ink-muted hover:text-ink-primary"
      >
        Subscribe another address
      </button>
    </div>

    <div
      id="subscribe-unknown"
      class="mt-6 hidden rounded-lg border border-amber-400/30 bg-amber-400/5 p-6 shadow-xs"
      role="status"
      aria-live="polite"
    >
      <p class="text-sm font-medium text-amber-200">
        Confirmation-email delivery is unknown for
        <span id="unknown-email" class="font-mono"></span>.
      </p>
      <p class="mt-3 text-sm text-ink-secondary">
        The request timed out after it was sent, so the server may already
        have emailed a confirmation link. Do not subscribe this address
        again on this page. Check your inbox and spam folder first; if
        multiple confirmation messages arrive, use the newest one. Reload
        and try again only if nothing arrives within 5 minutes.
      </p>
    </div>
  </section>

  <section class="text-xs text-ink-muted">
    <p>
      Double-opt-in: we send a confirmation email to verify the address
      before adding it to the notification list. Unsubscribe with one
      click — every email carries an unsubscribe link in the footer. We
      never send marketing or promotional email from the status list.
    </p>
  </section>
</StatusLayout>

<script is:inline define:vars={{ API_BASE }}>
  function fetchWithDeadline(input, init, timeoutMs = 10_000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(input, { ...init, signal: controller.signal }).finally(() => clearTimeout(timer));
  }
  const form = document.getElementById('subscribe-form');
  const status = document.getElementById('subscribe-status');
  const submitBtn = document.getElementById('submit-btn');
  const emailInput = document.getElementById('email-input');
  // Wave 1119 / Slice 1119.3 C1 — dedicated confirm pane elements.
  const confirmPane = document.getElementById('subscribe-confirm');
  const confirmEmail = document.getElementById('confirm-email');
  const subscribeAnotherBtn = document.getElementById('subscribe-another-btn');
  const unknownPane = document.getElementById('subscribe-unknown');
  const unknownEmail = document.getElementById('unknown-email');
  let subscribeInFlight = false;
  let subscribeOutcomeUnknown = false;

  function setEmailValid(isValid) {
    if (!emailInput) return;
    emailInput.setAttribute('aria-invalid', isValid ? 'false' : 'true');
    if (!isValid) emailInput.focus();
  }

  function setStatus(message, kind) {
    if (!status) return;
    status.classList.remove(
      'hidden',
      'text-emerald-700',
      'text-red-700',
      'text-ink-secondary',
    );
    status.classList.add(
      kind === 'success'
        ? 'text-emerald-700'
        : kind === 'error'
          ? 'text-red-700'
          : 'text-ink-secondary',
    );
    status.textContent = message;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (subscribeInFlight || subscribeOutcomeUnknown) return;
    const fd = new FormData(form);
    const email = (fd.get('email') || '').toString().trim();
    if (!email || !/^.+@.+\..+$/.test(email)) {
      setStatus('Please enter a valid email address.', 'error');
      setEmailValid(false);
      return;
    }
    setEmailValid(true);
    subscribeInFlight = true;
    submitBtn.setAttribute('disabled', 'true');
    submitBtn.setAttribute('aria-busy', 'true');
    submitBtn.textContent = 'Sending…';
    setStatus('Sending confirmation email…', 'pending');
    try {
      const res = await fetchWithDeadline(`${API_BASE}/v1/status/subscribe`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.status === 202) {
        // Wave 1119 / Slice 1119.3 C1 — swap form for confirm pane so
        // the next action is unmissable + state the sender to look for.
        if (confirmEmail) confirmEmail.textContent = email;
        if (confirmPane) confirmPane.classList.remove('hidden');
        if (form) form.classList.add('hidden');
        if (status) status.classList.add('hidden');
        form.reset();
      } else if (res.status === 400) {
        setStatus("That doesn't look like a valid email address.", 'error');
        setEmailValid(false);
      } else if (res.status === 429) {
        setStatus(
          'Too many subscribe attempts from this IP. Try again in a minute.',
          'error',
        );
      } else {
        setStatus("Couldn't start the subscription right now. Try again in a moment.", 'error');
      }
    } catch (error) {
      if (error && error.name === 'AbortError') {
        subscribeOutcomeUnknown = true;
        if (unknownEmail) unknownEmail.textContent = email;
        if (unknownPane) unknownPane.classList.remove('hidden');
        if (form) form.classList.add('hidden');
        if (status) status.classList.add('hidden');
        return;
      }
      setStatus(
        "Couldn't reach the status API. Your network may be blocking the request.",
        'error',
      );
    } finally {
      subscribeInFlight = false;
      submitBtn.setAttribute('aria-busy', 'false');
      submitBtn.textContent = 'Subscribe';
      if (!subscribeOutcomeUnknown) submitBtn.removeAttribute('disabled');
    }
  });

  // Wave 1119 / Slice 1119.3 C1 — "subscribe another address" reverts
  // the confirm pane to the empty form so the customer can add a
  // teammate without a page reload.
  subscribeAnotherBtn?.addEventListener('click', () => {
    if (confirmPane) confirmPane.classList.add('hidden');
    if (form) form.classList.remove('hidden');
    subscribeOutcomeUnknown = false;
    setEmailValid(true);
    submitBtn.removeAttribute('disabled');
    if (emailInput) emailInput.focus();
  });
</script>
