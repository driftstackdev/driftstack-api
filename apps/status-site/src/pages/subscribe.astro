---
import StatusLayout from '../layouts/StatusLayout.astro';

// V-657 — incident-email subscription handler. Renders a tiny form
// that POSTs to /v1/status/subscribe; the V-540.B-11-tested
// double-opt-in flow takes over from there (server emails a confirm
// link; customer clicks; confirmed_at is set on the row).
//
// No JavaScript framework — pure HTML form + inline JS for the
// fetch + success/error UI. Keeps the page light enough to render
// even when the control plane is degraded (the form posts to the
// control plane, but the page itself is static-served from Cloudflare
// Pages).
const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.driftstack.dev';
---

<StatusLayout title="Driftstack — Status email subscription">
  <section class="mb-8">
    <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Subscribe</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">
      Get incident emails
    </h1>
    <p class="mt-3 max-w-prose text-sm text-slate-600">
      We'll email you when we post a service-status incident, and again
      when it resolves. We won't email you for anything else. Two emails
      per incident maximum.
    </p>
  </section>

  <section class="mb-12">
    <form
      id="subscribe-form"
      class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
      novalidate
    >
      <label for="email-input" class="block text-sm font-medium text-slate-700">
        Email address
      </label>
      <input
        id="email-input"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class="mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-oxblood-700 focus:outline-none focus:ring-1 focus:ring-oxblood-700"
      />
      <button
        id="submit-btn"
        type="submit"
        class="mt-4 inline-flex items-center rounded-md bg-oxblood-700 px-4 py-2 text-sm font-medium text-white hover:bg-oxblood-600 disabled:opacity-50"
      >
        Subscribe
      </button>
      <p id="subscribe-status" class="mt-3 hidden text-sm" role="status"></p>
    </form>
  </section>

  <section class="text-xs text-slate-500">
    <p>
      Double-opt-in: we send a confirmation email to verify the address
      before adding it to the notification list. Unsubscribe with one
      click — every email carries an unsubscribe link in the footer. We
      never send marketing or promotional email from the status list.
    </p>
  </section>
</StatusLayout>

<script is:inline define:vars={{ API_BASE }}>
  const form = document.getElementById('subscribe-form');
  const status = document.getElementById('subscribe-status');
  const submitBtn = document.getElementById('submit-btn');

  function setStatus(message, kind) {
    if (!status) return;
    status.classList.remove(
      'hidden',
      'text-emerald-700',
      'text-red-700',
      'text-slate-700',
    );
    status.classList.add(
      kind === 'success'
        ? 'text-emerald-700'
        : kind === 'error'
          ? 'text-red-700'
          : 'text-slate-700',
    );
    status.textContent = message;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const fd = new FormData(form);
    const email = (fd.get('email') || '').toString().trim();
    if (!email || !/^.+@.+\..+$/.test(email)) {
      setStatus('Please enter a valid email address.', 'error');
      return;
    }
    submitBtn.setAttribute('disabled', 'true');
    setStatus('Sending confirmation email…', 'pending');
    try {
      const res = await fetch(`${API_BASE}/v1/status/subscribe`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.status === 202) {
        setStatus(
          "Check your inbox — click the link in the confirmation email to finish subscribing.",
          'success',
        );
        form.reset();
      } else if (res.status === 400) {
        setStatus("That doesn't look like a valid email address.", 'error');
      } else if (res.status === 429) {
        setStatus(
          'Too many subscribe attempts from this IP. Try again in a minute.',
          'error',
        );
      } else {
        setStatus(`Subscribe failed (HTTP ${res.status}). Try again in a moment.`, 'error');
      }
    } catch {
      setStatus(
        "Couldn't reach the status API. Your network may be blocking the request.",
        'error',
      );
    } finally {
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
