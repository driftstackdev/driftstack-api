---
import StatusLayout from '../layouts/StatusLayout.astro';

// V-657 — incident history view. Reads the same /v1/status/incidents
// public endpoint as the home page, but widens the window to 90 days
// and removes the open/resolved split (everything chronological).
//
// The home page is the "what's happening RIGHT NOW" surface; this is
// the historical record for trust-evaluation use (customers reviewing
// reliability before signing on, post-incident review, etc.).
const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.driftstack.dev';
const R2_FALLBACK_URL =
  import.meta.env.PUBLIC_STATUS_R2_URL ??
  'https://r2-public.driftstack.dev/status/incidents-public.json';
---

<StatusLayout
  title="Driftstack — Incident history"
  description="Review resolved and historical Driftstack service incidents from the past 90 days."
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-ink-muted">History</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink-primary">
      Incident history — 90-day resolved window
    </h1>
    <p class="mt-3 max-w-prose text-sm text-ink-secondary">
      Resolved incidents started in the last 90 days, plus every incident that
      is still open regardless of age. Results are newest first and the page
      says explicitly when the bounded public feed is truncated. The
      <a href="/" class="font-medium text-accent-text underline">live status page</a> shows
      every active incident plus the last 30 days of resolved history.
    </p>
  </section>

  <section id="history-section" class="mb-12">
    <div id="history-list" class="space-y-3">
      {/* 2026-05-24 — skeleton rows for hydrate-state polish; JS replaces
          innerHTML on fetch (or surfaces the empty/all-clear state). */}
      <div class="rounded-xl border border-surface-divider bg-surface-raised p-5">
        <div class="h-3 w-40 animate-pulse rounded-sm bg-surface-divider"></div>
        <div class="mt-3 h-3 w-64 animate-pulse rounded-sm bg-surface-divider"></div>
      </div>
      <div class="rounded-xl border border-surface-divider bg-surface-raised p-5">
        <div class="h-3 w-32 animate-pulse rounded-sm bg-surface-divider"></div>
        <div class="mt-3 h-3 w-56 animate-pulse rounded-sm bg-surface-divider"></div>
      </div>
    </div>
  </section>

  <section class="text-xs text-ink-muted">
    <p>
      Source:
      <code class="font-mono">{API_BASE}/v1/status/incidents?window=90d&amp;limit=100</code>.
      Falls back to the R2 snapshot at
      <code class="font-mono">{R2_FALLBACK_URL}</code> if the API is unreachable.
      No cookies, no visitor tracking.
    </p>
  </section>
</StatusLayout>

<script is:inline define:vars={{ API_BASE, R2_FALLBACK_URL }}>
  function fetchWithDeadline(input, init, timeoutMs = 10_000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(input, { ...init, signal: controller.signal }).finally(() => clearTimeout(timer));
  }
  // P4 (2026-09-25) — the same badge maps as index.astro (the app's status
  // pill in the app's status tokens; colour carries severity, the phases
  // before "resolved" are neutral).
  const SEVERITY_BADGE = {
    minor: ['border-status-busy/30', 'bg-status-busy/15', 'text-status-busy'],
    major: ['border-incident-red/30', 'bg-incident-red/15', 'text-incident-red'],
    outage: ['border-incident-red', 'bg-incident-red', 'text-ink-inverted'],
  };
  const STATUS_BADGE = {
    investigating: ['border-ink-muted/30', 'bg-ink-muted/15', 'text-ink-secondary'],
    identified: ['border-ink-muted/30', 'bg-ink-muted/15', 'text-ink-secondary'],
    monitoring: ['border-ink-muted/30', 'bg-ink-muted/15', 'text-ink-secondary'],
    resolved: ['border-status-ready/30', 'bg-status-ready/15', 'text-status-ready'],
  };
  const INCIDENT_STATUSES = new Set(Object.keys(STATUS_BADGE));
  const INCIDENT_SEVERITIES = new Set(Object.keys(SEVERITY_BADGE));

  function isIso(value) {
    if (typeof value !== 'string') return false;
    const date = new Date(value);
    return Number.isFinite(date.getTime()) && date.toISOString() === value;
  }

  function isPublicIncident(value) {
    return Boolean(
      value &&
        typeof value === 'object' &&
        /^inc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
          value.id,
        ) &&
        typeof value.title === 'string' &&
        typeof value.description === 'string' &&
        INCIDENT_SEVERITIES.has(value.severity) &&
        INCIDENT_STATUSES.has(value.status) &&
        Array.isArray(value.affected_components) &&
        value.affected_components.every((component) => typeof component === 'string') &&
        value.public === true &&
        isIso(value.started_at) &&
        (value.resolved_at === null || isIso(value.resolved_at)) &&
        isIso(value.created_at) &&
        isIso(value.updated_at),
    );
  }

  function parseIncidentFeed(value) {
    if (
      !value ||
      typeof value !== 'object' ||
      !Array.isArray(value.data) ||
      !value.data.every(isPublicIncident) ||
      !Number.isInteger(value.total) ||
      value.total < value.data.length ||
      !Number.isInteger(value.open_count) ||
      value.open_count < 0 ||
      value.open_count > value.total ||
      !Number.isInteger(value.open_outage_count) ||
      value.open_outage_count < 0 ||
      value.open_outage_count > value.open_count ||
      typeof value.truncated !== 'boolean' ||
      value.truncated !== (value.data.length < value.total) ||
      new Set(value.data.map((incident) => incident.id)).size !== value.data.length ||
      (value.open_count > 0 && value.data.length === 0)
    ) {
      throw new Error('invalid incident history feed');
    }
    const visibleOpen = Math.min(value.open_count, value.data.length);
    const visibleOpenRows = value.data.slice(0, visibleOpen);
    const visibleOpenOutages = visibleOpenRows.filter(
      (incident) => incident.severity === 'outage',
    ).length;
    if (
      visibleOpenRows.some((incident) => incident.status === 'resolved') ||
      value.data.slice(visibleOpen).some((incident) => incident.status !== 'resolved') ||
      visibleOpenOutages > value.open_outage_count ||
      (value.open_count <= value.data.length &&
        visibleOpenOutages !== value.open_outage_count)
    ) {
      throw new Error('invalid incident history ordering');
    }
    return value;
  }

  function fmtIso(iso) {
    return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
  }

  // `text` is escaped here, not at the call sites — see the note on the copy in
  // index.astro. The arguments are enum-constrained today; the escape makes that
  // a property of this helper rather than of a column three layers away.
  function badge(text, classes) {
    return `<span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs font-semibold uppercase tracking-wide ${classes.join(' ')}"><span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>${escapeHtml(text)}</span>`;
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => {
      switch (c) {
        case '&':
          return '&amp;';
        case '<':
          return '&lt;';
        case '>':
          return '&gt;';
        case '"':
          return '&quot;';
        case "'":
          return '&#39;';
        default:
          return c;
      }
    });
  }

  function renderIncident(inc) {
    const updates = (inc.updates ?? [])
      .map(
        (u) => `
          <li class="relative pl-5 border-l border-surface-divider">
            <span class="absolute left-[-5px] top-1.5 inline-block h-2 w-2 rounded-full ${u.status === 'resolved' ? 'bg-status-ready' : 'bg-ink-muted'}"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              ${badge(u.status, STATUS_BADGE[u.status] ?? [])}
              <span class="text-xs text-ink-muted">${fmtIso(u.posted_at)}</span>
            </div>
            <p class="mt-1 text-sm text-ink-secondary">${escapeHtml(u.message)}</p>
          </li>
        `,
      )
      .join('');
    // P4 — resolved cards are no longer translucent: opacity pulled their
    // muted meta line under 4.5:1. Each is a card (the status pills need a
    // card under them to clear AA) on the month group's page-ground well.
    return `
      <article class="rounded-xl border border-surface-divider bg-surface-raised p-5">
        <header>
          <div class="flex flex-wrap items-center gap-2">
            ${badge(inc.severity, SEVERITY_BADGE[inc.severity] ?? [])}
            ${badge(inc.status, STATUS_BADGE[inc.status] ?? [])}
          </div>
          <h3 class="mt-2 text-base font-semibold text-ink-primary">${escapeHtml(inc.title)}</h3>
          <p class="mt-1 text-xs text-ink-muted">
            Started ${fmtIso(inc.started_at)}${
              inc.resolved_at ? ` · resolved ${fmtIso(inc.resolved_at)}` : ''
            }
          </p>
        </header>
        ${updates ? `<ol class="mt-3 space-y-3">${updates}</ol>` : ''}
      </article>
    `;
  }

  // Slice 1119.4 B4 — month-key uses the started_at date
  // truncated to YYYY-MM. The display label is humanized below
  // (e.g. "May 2026") so the section headings scan as English instead
  // of as a sortable ISO token.
  const MONTH_LABELS = [
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December',
  ];
  function humanizeMonth(monthKey) {
    const [y, m] = monthKey.split('-');
    const idx = Number(m) - 1;
    return `${MONTH_LABELS[idx] ?? monthKey} ${y}`;
  }
  function pluralizeIncidents(n) {
    return n === 1 ? '1 incident' : `${n} incidents`;
  }

  function groupByMonth(incidents) {
    const byMonth = {};
    for (const inc of incidents) {
      const month = new Date(inc.started_at).toISOString().slice(0, 7);
      (byMonth[month] ||= []).push(inc);
    }
    return Object.keys(byMonth)
      .sort()
      .reverse()
      .map((month) => ({ month, items: byMonth[month] }));
  }

  async function fetchHistory() {
    try {
      const res = await fetchWithDeadline(`${API_BASE}/v1/status/incidents?window=90d&limit=100`, {
        headers: { accept: 'application/json' },
        cache: 'no-store',
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return { source: 'live', feed: parseIncidentFeed(await res.json()) };
    } catch {
      const r2 = await fetchWithDeadline(R2_FALLBACK_URL, {
        headers: { accept: 'application/json' },
        cache: 'no-store',
      });
      if (!r2.ok) throw new Error(`R2 HTTP ${r2.status}`);
      return { source: 'snapshot', feed: parseIncidentFeed(await r2.json()) };
    }
  }

  async function render() {
    const list = document.getElementById('history-list');
    if (!list) return;
    try {
      const { source, feed } = await fetchHistory();
      const incidents = feed.data;
      if (feed.total === 0) {
        list.innerHTML = `
          <div class="rounded-xl border border-surface-divider bg-surface-raised p-5 text-sm text-ink-secondary">
            No open incidents and no resolved incidents in the last 90 days.
          </div>
          ${
            source === 'snapshot'
              ? '<p class="mt-3 rounded-md border border-status-busy/40 border-l-4 border-l-status-busy bg-surface-raised px-3 py-2 text-xs text-ink-primary">The live API is unavailable; this empty result comes from the most recent cached status snapshot.</p>'
              : ''
          }
        `;
        return;
      }
      // Slice 1119.4 B4 — render each month group as a
      // <details> block. The newest month is open by default (the
      // "what's been happening lately" frame) and older months are
      // collapsed so 90 days of history doesn't dump as one wall of
      // cards. Each <summary> shows the humanized month + the per-
      // month incident count so the customer can scan density at a
      // glance before expanding.
      const grouped = groupByMonth(incidents);
      const groupsHtml = grouped
        .map(
          (g, i) => `
            <details ${i === 0 ? 'open' : ''} class="group overflow-hidden rounded-xl border border-surface-divider bg-surface-raised shadow-lift">
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-3 text-sm font-semibold text-ink-primary hover:bg-surface-inset">
                <span class="flex items-baseline gap-3">
                  <span>${humanizeMonth(g.month)}</span>
                  <span class="text-xs font-normal text-ink-muted">${pluralizeIncidents(g.items.length)}</span>
                </span>
                <svg class="h-4 w-4 shrink-0 text-ink-muted transition group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
              </summary>
              <div class="space-y-3 border-t border-surface-divider bg-surface-base p-4 sm:p-5">
                ${g.items.map(renderIncident).join('')}
              </div>
            </details>
          `,
        )
        .join('');
      const notices = [];
      if (feed.truncated) {
        notices.push(
          `<p class="rounded-md border border-surface-divider bg-surface-inset px-3 py-2 text-xs text-ink-secondary">Showing ${incidents.length} of ${feed.total} incidents. The exact open count is ${feed.open_count}; older resolved entries beyond this bounded feed are not shown.</p>`,
        );
      }
      if (source === 'snapshot') {
        notices.push(
          '<p class="rounded-md border border-status-busy/40 border-l-4 border-l-status-busy bg-surface-raised px-3 py-2 text-xs text-ink-primary">The live API is unavailable; this is the most recent cached status snapshot.</p>',
        );
      }
      list.innerHTML = groupsHtml + notices.join('');
    } catch {
      list.innerHTML = `
        <div class="rounded-xl border border-status-busy/40 border-l-4 border-l-status-busy bg-surface-raised p-5 text-sm text-ink-primary">
          <p>Could not load incident history. The live status page may still be available.</p>
          <button
            type="button"
            data-history-retry
            class="mt-3 rounded-md border border-surface-divider bg-surface-elevated px-3 py-1.5 text-xs font-medium text-ink-primary hover:bg-surface-inset disabled:cursor-wait disabled:opacity-60"
          >Retry</button>
        </div>
      `;
      const retry = list.querySelector('[data-history-retry]');
      if (retry) {
        retry.addEventListener('click', function () {
          retry.disabled = true;
          retry.textContent = 'Retrying…';
          render();
        });
      }
    }
  }

  render();
</script>
