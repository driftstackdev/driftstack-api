---
import StatusLayout from '../../layouts/StatusLayout.astro';

// V-657 followup — status-subscription CONFIRM landing page. The
// double-opt-in confirmation email links here, at the status-site path
// `/subscribe/confirm?token=` (see StatusSubscribersService.confirmLink:
// `${baseUrl}/subscribe/confirm?token=...`). On load we read `?token=`
// and call GET /v1/status/subscribe/confirm?token=, then render the
// result.
//
// IMPORTANT: the API endpoint is a GET with a `?token=` query (an
// email-link click), NOT a POST with a JSON body — a spec/page that
// POSTs a body would 404 the route (this was the W-status-subscribe
// spec-drift class). We mirror the GET contract here.
//
// No JavaScript framework — pure inline script — so the page renders
// even when the control plane is degraded (it's static-served from
// Cloudflare Pages; only the confirm call touches the control plane).
const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.driftstack.dev';
---

<StatusLayout title="Driftstack — Confirm status subscription">
  <section class="mb-8">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Subscribe</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink-primary">
      Confirm your subscription
    </h1>
  </section>

  <section class="mb-12">
    <!-- Default pane: the confirm call fires on load. -->
    <div
      id="confirm-pending"
      class="rounded-lg border border-surface-divider bg-surface-raised p-6 shadow-xs"
      role="status"
      aria-live="polite"
    >
      <p class="text-sm text-ink-secondary">Confirming your subscription…</p>
    </div>

    <!-- Success pane (200): confirmation recorded. -->
    <div
      id="confirm-success"
      class="hidden rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-6 shadow-xs"
      role="status"
      aria-live="polite"
    >
      <p class="text-sm font-medium text-emerald-300">Subscription confirmed.</p>
      <p class="mt-3 text-sm text-ink-secondary">
        You'll now receive an email when we post a service-status incident,
        and again when it resolves — nothing else. Two emails per incident
        maximum, and every email carries a one-click unsubscribe link.
      </p>
      <p class="mt-4 text-xs text-ink-muted">
        <a href="/" class="underline hover:text-ink-primary">View live status</a>
      </p>
    </div>

    <!-- Error pane (400 / 404 / 429 / network). -->
    <div
      id="confirm-error"
      class="hidden rounded-lg border border-red-500/30 bg-red-500/5 p-6 shadow-xs"
      role="alert"
      aria-live="assertive"
    >
      <p id="confirm-error-message" class="text-sm font-medium text-red-300"></p>
      <p class="mt-3 text-sm text-ink-secondary">
        You can <a href="/subscribe" class="underline hover:text-ink-primary">subscribe again</a>
        to get a fresh confirmation link.
      </p>
    </div>
  </section>

  <section class="text-xs text-ink-muted">
    <p>
      Double-opt-in: this step verifies the email address before we add it
      to the notification list. We never send marketing or promotional
      email from the status list.
    </p>
  </section>
</StatusLayout>

<script is:inline define:vars={{ API_BASE }}>
  function fetchWithDeadline(input, init, timeoutMs = 10_000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(input, { ...init, signal: controller.signal }).finally(() => clearTimeout(timer));
  }
  const pending = document.getElementById('confirm-pending');
  const success = document.getElementById('confirm-success');
  const errorPane = document.getElementById('confirm-error');
  const errorMessage = document.getElementById('confirm-error-message');

  function showError(message) {
    if (pending) pending.classList.add('hidden');
    if (success) success.classList.add('hidden');
    if (errorMessage) errorMessage.textContent = message;
    if (errorPane) errorPane.classList.remove('hidden');
  }

  function showSuccess() {
    if (pending) pending.classList.add('hidden');
    if (errorPane) errorPane.classList.add('hidden');
    if (success) success.classList.remove('hidden');
  }

  async function confirmSubscription() {
    const token = new URLSearchParams(window.location.search).get('token');
    if (!token) {
      showError('This confirmation link is missing its token. Open the link directly from your email.');
      return;
    }
    try {
      const res = await fetchWithDeadline(
        `${API_BASE}/v1/status/subscribe/confirm?token=${encodeURIComponent(token)}`,
        { method: 'GET', headers: { accept: 'application/json' } },
      );
      if (res.status === 200) {
        showSuccess();
        return;
      }
      // RFC 7807 problem+json carries a user-friendly `detail`; fall
      // back to a status-specific message.
      let detail = '';
      try {
        const body = await res.json();
        detail = (body && (body.detail || body.message)) || '';
      } catch {
        /* non-JSON body */
      }
      if (res.status === 400) {
        showError(detail || 'This confirmation link has expired or is malformed.');
      } else if (res.status === 404) {
        showError(detail || 'This confirmation link is invalid or has already been used.');
      } else if (res.status === 429) {
        showError('Too many attempts from this IP. Try again in a minute.');
      } else {
        showError(detail || `Couldn't confirm your subscription (HTTP ${res.status}).`);
      }
    } catch {
      showError("Couldn't reach the status API. Your network may be blocking the request.");
    }
  }

  confirmSubscription();
</script>
