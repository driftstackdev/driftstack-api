---
import StatusLayout from '../layouts/StatusLayout.astro';
---

<StatusLayout title="404 · Driftstack status">
  <div class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-slate-500">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900">Page not found.</h1>
    <p class="mt-4 text-slate-600">
      The status site only hosts a single overview page plus per-incident pages
      under <code class="font-mono text-sm text-slate-700">/incidents/&lt;id&gt;</code>.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="text-sm text-slate-700 underline hover:text-slate-900">
        ← Back to overview
      </a>
    </div>
  </div>
</StatusLayout>
