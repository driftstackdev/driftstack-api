---
import StatusLayout from '../layouts/StatusLayout.astro';

// Build-time API origin + R2 fallback URL. Both baked into the page at
// build time via env. PUBLIC_API_BASE_URL is the live API origin;
// PUBLIC_STATUS_R2_URL points at the public-readable R2 snapshot
// (V-295c2: `<r2-public-base>/status/incidents-public.json`). The page
// combines live readiness + incident truth; when the live incident feed is
// unavailable it can show the snapshot, but snapshot-only data never proves
// an operational all-clear.
const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'https://api.driftstack.dev';
const R2_FALLBACK_URL =
  import.meta.env.PUBLIC_STATUS_R2_URL ??
  'https://r2-public.driftstack.dev/status/incidents-public.json';
---

<StatusLayout
  title="Driftstack — Service status"
  description="Current operational status and active incidents for Driftstack browser infrastructure."
>
  <section id="overall" class="mb-8">
    <div
      id="overall-card"
      class="rounded-lg border border-surface-divider bg-surface-raised p-6 shadow-xs"
      data-state="loading"
    >
      <div class="flex items-center gap-3">
        <span
          id="overall-dot"
          class="inline-block h-3 w-3 rounded-full bg-ink-muted"
          aria-hidden="true"></span>
        <h1 id="overall-title" class="text-xl font-semibold text-ink-primary">
          Loading current status…
        </h1>
      </div>
      <p id="overall-summary" class="mt-2 text-sm text-ink-muted">
        Fetching incident data from <code class="font-mono text-xs">{API_BASE}/v1/status/incidents</code>.
      </p>
      {/* W563 — "last updated" stamp: a status page's most-expected
          element. Set on every successful fetch (SSE push or 60s poll)
          so a visitor checking during a suspected outage can tell the
          data is current. aria-live=polite announces each refresh. */}
      <p id="last-updated" class="mt-2 text-xs text-ink-muted" aria-live="polite"></p>
    </div>
  </section>

  {/* 2026-05-24 — icon on Incidents header. */}
  <section id="incidents-section" class="mb-12">
    <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-ink-muted">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-glow-red" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </svg>
      Incidents — all active + 30-day history
    </h2>
    <div id="incidents-list" class="space-y-3">
      {/* 2026-05-24 — skeleton row for hydrate-state polish; JS replaces
          innerHTML on fetch (or surfaces the all-clear state). */}
      <div class="rounded-lg border border-surface-divider bg-surface-raised p-5">
        <div class="h-3 w-40 animate-pulse rounded-sm bg-surface-divider"></div>
        <div class="mt-3 h-3 w-64 animate-pulse rounded-sm bg-surface-divider"></div>
      </div>
    </div>
  </section>

  <!-- V-657 — quick-nav to subscription + history views. -->
  <section class="mb-8 flex flex-wrap items-center gap-3 text-sm">
    <a
      href="/subscribe/"
      class="rounded-md border border-surface-divider bg-surface-raised px-3 py-1.5 text-ink-secondary hover:bg-surface-inset"
    >
      Subscribe to incident emails
    </a>
    <a
      href="/history/"
      class="rounded-md border border-surface-divider bg-surface-raised px-3 py-1.5 text-ink-secondary hover:bg-surface-inset"
    >
      Full incident history (90 days)
    </a>
  </section>

  <section class="text-xs text-ink-muted">
    <p>
      This page reads from the public no-auth endpoint
      <code class="font-mono">{API_BASE}/v1/status/incidents</code>. The page itself stores
      no cookies and does not log visitors. Driftstack records its own
      health-probe history (timestamp, success, latency) for 30 days; this
      data does not reference any Customer or visitor.
    </p>
  </section>
</StatusLayout>

<script is:inline define:vars={{ API_BASE, R2_FALLBACK_URL }}>
  function fetchWithDeadline(input, init, timeoutMs = 10_000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(input, { ...init, signal: controller.signal }).finally(() => clearTimeout(timer));
  }
  const SEVERITY_BADGE = {
    minor: ['bg-amber-50', 'text-amber-700'],
    major: ['bg-orange-50', 'text-orange-700'],
    outage: ['bg-red-50', 'text-red-700'],
  };
  const STATUS_BADGE = {
    investigating: ['bg-amber-50', 'text-amber-700'],
    identified: ['bg-blue-50', 'text-blue-700'],
    monitoring: ['bg-indigo-50', 'text-indigo-700'],
    resolved: ['bg-emerald-50', 'text-emerald-700'],
  };
  const DOT_BG = {
    operational: 'bg-emerald-500',
    degraded: 'bg-amber-500',
    outage: 'bg-red-500',
    unknown: 'bg-ink-muted',
  };
  const STATE_TITLE = {
    operational: 'All systems operational',
    degraded: 'Some systems degraded',
    outage: 'Major outage in progress',
    unknown: 'Status currently unavailable',
  };
  const INCIDENT_STATUSES = new Set(Object.keys(STATUS_BADGE));
  const INCIDENT_SEVERITIES = new Set(Object.keys(SEVERITY_BADGE));

  function isIso(value) {
    if (typeof value !== 'string') return false;
    const date = new Date(value);
    return Number.isFinite(date.getTime()) && date.toISOString() === value;
  }

  function isPublicIncident(value) {
    return Boolean(
      value &&
        typeof value === 'object' &&
        /^inc_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
          value.id,
        ) &&
        typeof value.title === 'string' &&
        typeof value.description === 'string' &&
        INCIDENT_SEVERITIES.has(value.severity) &&
        INCIDENT_STATUSES.has(value.status) &&
        Array.isArray(value.affected_components) &&
        value.affected_components.every((component) => typeof component === 'string') &&
        value.public === true &&
        isIso(value.started_at) &&
        (value.resolved_at === null || isIso(value.resolved_at)) &&
        isIso(value.created_at) &&
        isIso(value.updated_at),
    );
  }

  function parseIncidentFeed(value) {
    if (
      !value ||
      typeof value !== 'object' ||
      !Array.isArray(value.data) ||
      !value.data.every(isPublicIncident) ||
      !Number.isInteger(value.total) ||
      value.total < value.data.length ||
      !Number.isInteger(value.open_count) ||
      value.open_count < 0 ||
      value.open_count > value.total ||
      !Number.isInteger(value.open_outage_count) ||
      value.open_outage_count < 0 ||
      value.open_outage_count > value.open_count ||
      typeof value.truncated !== 'boolean' ||
      value.truncated !== (value.data.length < value.total) ||
      new Set(value.data.map((incident) => incident.id)).size !== value.data.length ||
      (value.open_count > 0 && value.data.length === 0)
    ) {
      throw new Error('invalid status feed');
    }
    const visibleOpen = Math.min(value.open_count, value.data.length);
    const visibleOpenRows = value.data.slice(0, visibleOpen);
    const visibleOpenOutages = visibleOpenRows.filter(
      (incident) => incident.severity === 'outage',
    ).length;
    if (
      visibleOpenRows.some((incident) => incident.status === 'resolved') ||
      value.data.slice(visibleOpen).some((incident) => incident.status !== 'resolved') ||
      visibleOpenOutages > value.open_outage_count ||
      (value.open_count <= value.data.length &&
        visibleOpenOutages !== value.open_outage_count)
    ) {
      throw new Error('invalid status feed ordering');
    }
    return value;
  }

  function parseLiveStatus(value) {
    const allowedStatuses = new Set(['operational', 'degraded', 'major_outage']);
    if (
      !value ||
      typeof value !== 'object' ||
      !allowedStatuses.has(value.overall_status) ||
      !Array.isArray(value.components) ||
      !value.components.every(
        (component) =>
          component &&
          typeof component === 'object' &&
          typeof component.name === 'string' &&
          allowedStatuses.has(component.status) &&
          isIso(component.last_checked_at),
      ) ||
      typeof value.incident_data_complete !== 'boolean' ||
      (value.incident_data_complete
        ? !Number.isInteger(value.open_incidents) || value.open_incidents < 0
        : value.open_incidents !== null)
    ) {
      throw new Error('invalid live status response');
    }
    const statusRank = { operational: 0, degraded: 1, major_outage: 2 };
    const worstComponentRank = value.components.reduce(
      (worst, component) => Math.max(worst, statusRank[component.status]),
      0,
    );
    if (
      statusRank[value.overall_status] < worstComponentRank ||
      (!value.incident_data_complete && value.overall_status === 'operational') ||
      (value.incident_data_complete &&
        value.open_incidents > 0 &&
        value.overall_status === 'operational')
    ) {
      throw new Error('incoherent live status response');
    }
    return value;
  }

  function parseSnapshot(value) {
    const feed = parseIncidentFeed(value);
    if (!isIso(value.generated_at)) throw new Error('invalid snapshot timestamp');
    return { feed, generatedAt: value.generated_at };
  }

  function incidentState(feed) {
    return feed.open_outage_count > 0
      ? 'outage'
      : feed.open_count > 0
        ? 'degraded'
        : 'operational';
  }

  function combineLiveTruth(feed, liveStatus) {
    const incidents = incidentState(feed);
    if (!liveStatus) return incidents === 'operational' ? 'unknown' : incidents;
    let readiness =
      liveStatus.overall_status === 'major_outage' ? 'outage' : liveStatus.overall_status;
    if (
      !liveStatus.incident_data_complete ||
      liveStatus.open_incidents !== feed.open_count
    ) {
      if (readiness === 'operational') readiness = 'unknown';
    }
    const rank = { operational: 0, unknown: 1, degraded: 2, outage: 3 };
    return rank[readiness] >= rank[incidents] ? readiness : incidents;
  }

  function formatSnapshotAge(generatedAt) {
    const seconds = Math.max(0, Math.floor((Date.now() - new Date(generatedAt).getTime()) / 1000));
    if (seconds < 90) return `${seconds} second${seconds === 1 ? '' : 's'} old`;
    const minutes = Math.floor(seconds / 60);
    if (minutes < 90) return `${minutes} minute${minutes === 1 ? '' : 's'} old`;
    const hours = Math.floor(minutes / 60);
    if (hours < 48) return `${hours} hour${hours === 1 ? '' : 's'} old`;
    const days = Math.floor(hours / 24);
    return `${days} day${days === 1 ? '' : 's'} old`;
  }

  function fmtIso(iso) {
    return new Date(iso).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
  }

  function badge(text, classes) {
    const cls = classes.join(' ');
    return `<span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium uppercase tracking-wide ${cls}">${text}</span>`;
  }

  function renderOverall(state, openCount) {
    const dot = document.getElementById('overall-dot');
    const title = document.getElementById('overall-title');
    const summary = document.getElementById('overall-summary');
    const card = document.getElementById('overall-card');
    if (!dot || !title || !summary || !card) return;
    dot.className = `inline-block h-3 w-3 rounded-full ${DOT_BG[state] ?? DOT_BG.unknown}`;
    title.textContent = STATE_TITLE[state] ?? STATE_TITLE.unknown;
    if (state === 'operational') {
      summary.textContent = 'No active incidents.';
    } else if (state === 'unknown') {
      summary.textContent =
        'The status feed is temporarily unavailable. Service may still be running normally.';
    } else if (openCount > 0) {
      summary.textContent = `${openCount} active incident${openCount === 1 ? '' : 's'} below.`;
    } else {
      summary.textContent =
        'A service component is reporting a problem; no active incident has been posted yet.';
    }
    card.dataset.state = state;
  }

  // W563 — stamp the last successful refresh. Only called on a good
  // fetch (live or snapshot), so the time always reflects real data —
  // a failed poll leaves the previous stamp intact rather than lying.
  function markUpdated(at = new Date().toISOString()) {
    const el = document.getElementById('last-updated');
    if (!el) return;
    el.textContent = 'Data timestamp ' + new Date(at).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
  }

  function renderIncident(inc) {
    const updates = (inc.updates ?? [])
      .map(
        (u) => `
          <li class="relative pl-5 border-l border-surface-divider">
            <span class="absolute left-[-5px] top-1 inline-block h-2 w-2 rounded-full bg-oxblood-700"></span>
            <div class="flex flex-wrap items-baseline gap-2">
              ${badge(u.status, STATUS_BADGE[u.status] ?? [])}
              <span class="text-xs text-ink-muted">${fmtIso(u.posted_at)}</span>
            </div>
            <p class="mt-1 text-sm text-ink-secondary">${escapeHtml(u.message)}</p>
          </li>
        `,
      )
      .join('');
    const opacity = inc.status === 'resolved' ? 'opacity-80' : '';
    // V-545.A — anchor each card title at /incident?id=<inc_uuid> so
    // visitors can deep-link to the full update timeline. Card body
    // shows headline + a few inline updates; the linked page shows
    // the complete chronology + description.
    const detailHref = inc.id ? `/incident?id=${encodeURIComponent(inc.id)}` : '#';
    return `
      <article class="rounded-lg border border-surface-divider bg-surface-raised p-5 shadow-xs ${opacity}">
        <header class="mb-2">
          <div class="flex flex-wrap items-center gap-2">
            ${badge(inc.severity, SEVERITY_BADGE[inc.severity] ?? [])}
            ${badge(inc.status, STATUS_BADGE[inc.status] ?? [])}
          </div>
          <h3 class="mt-2 text-base font-semibold text-ink-primary">
            <a href="${detailHref}" class="hover:underline">${escapeHtml(inc.title)}</a>
          </h3>
          <p class="mt-1 text-xs text-ink-muted">
            Started ${fmtIso(inc.started_at)}${
              inc.resolved_at ? ` · resolved ${fmtIso(inc.resolved_at)}` : ''
            }${
              inc.affected_components && inc.affected_components.length
                ? ' · affecting ' + inc.affected_components.map(escapeHtml).join(', ')
                : ''
            }
          </p>
        </header>
        <ol class="mt-3 space-y-3">${updates}</ol>
      </article>
    `;
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => {
      switch (c) {
        case '&':
          return '&amp;';
        case '<':
          return '&lt;';
        case '>':
          return '&gt;';
        case '"':
          return '&quot;';
        case "'":
          return '&#39;';
        default:
          return c;
      }
    });
  }

  async function fetchSource() {
    async function load(url, parser) {
      const response = await fetchWithDeadline(url, {
        headers: { accept: 'application/json' },
        cache: 'no-store',
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return parser(await response.json());
    }

    // Readiness and incident truth are independent public contracts. Fetch
    // both: the page may show incident cards when readiness is unavailable,
    // but it cannot promote that partial view to an all-clear.
    const [incidentResult, statusResult] = await Promise.allSettled([
      load(`${API_BASE}/v1/status/incidents`, parseIncidentFeed),
      load(`${API_BASE}/v1/status`, parseLiveStatus),
    ]);
    let source = 'live';
    let generatedAt = null;
    let feed;
    if (incidentResult.status === 'fulfilled') {
      feed = incidentResult.value;
    } else {
      source = 'snapshot';
      const snapshot = await load(R2_FALLBACK_URL, parseSnapshot).catch(() => {
        throw new Error('status-feed-unavailable');
      });
      feed = snapshot.feed;
      generatedAt = snapshot.generatedAt;
    }
    return {
      source,
      feed,
      generatedAt,
      liveStatus: statusResult.status === 'fulfilled' ? statusResult.value : null,
    };
  }

  // Guards against an in-flight fetch overwriting a newer one's render.
  // fetchAndRender() is triggered from three independent places (initial
  // load, the SSE incident.created/incident.resolved handlers, and the
  // 60s safety-net poll) that can overlap — e.g. an SSE push fires while
  // the 60s poll is still mid-flight (or stuck in the R2 fallback path).
  // Without a token, whichever response lands LAST wins the DOM write
  // even if it was the OLDER request, which can re-show a since-resolved
  // incident as still open. Each call takes a token; a call only writes
  // to the DOM if it's still the most recently-started call once its
  // response lands.
  let latestFetchToken = 0;

  async function fetchAndRender() {
    const list = document.getElementById('incidents-list');
    if (!list) return;
    const fetchToken = ++latestFetchToken;
    try {
      const { source, feed, generatedAt, liveStatus } = await fetchSource();
      if (fetchToken !== latestFetchToken) return; // superseded by a newer call
      const homeCutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;
      const incidents = feed.data.filter(
        (incident) =>
          incident.status !== 'resolved' || new Date(incident.started_at).getTime() >= homeCutoff,
      );

      // Hydrate updates for each open incident in parallel. Resolved
      // incidents are listed without updates inline (link out covered
      // in V-295c2 if needed).
      const detailed = await Promise.all(
        incidents.map(async (inc) => {
          if (inc.updates) return inc;
          // No batched-with-updates list endpoint yet; client falls back
          // to surface the description-only view. The public detail endpoint
          // remains available from each card for the full timeline.
          return { ...inc, updates: [] };
        }),
      );

      const open = detailed.filter((i) => i.status !== 'resolved');
      const resolved = detailed.filter((i) => i.status === 'resolved');

      const overall = combineLiveTruth(feed, liveStatus);
      renderOverall(overall, feed.open_count);

      // Surface every partial-truth condition beside the headline. A cached
      // incident feed can still show known problems, but never proves green.
      const truthNotices = [];
      if (source === 'snapshot' && generatedAt) {
        truthNotices.push(`Incident feed is a cached snapshot (${formatSnapshotAge(generatedAt)}).`);
      }
      if (!liveStatus) {
        truthNotices.push('Current component health is unavailable; all-clear is withheld.');
      } else if (
        !liveStatus.incident_data_complete ||
        liveStatus.open_incidents !== feed.open_count
      ) {
        truthNotices.push('Live status could not confirm a coherent incident aggregate.');
      }
      if (truthNotices.length > 0) {
        const summary = document.getElementById('overall-summary');
        if (summary) summary.textContent = `${summary.textContent ?? ''} · ${truthNotices.join(' ')}`;
      }

      // W563 — stamp the source data time, not the browser's fetch time for
      // cached snapshots, before any empty-state early return.
      markUpdated(generatedAt ?? new Date().toISOString());

      if (detailed.length === 0) {
        list.innerHTML = `
          <div class="rounded-lg border border-surface-divider bg-surface-raised p-5 text-sm text-ink-muted">
            No incidents in the last 30 days.
          </div>
        `;
        return;
      }

      const sections = [];
      if (open.length > 0) {
        sections.push(
          `<div class="space-y-3">${open.map(renderIncident).join('')}</div>`,
        );
      }
      if (resolved.length > 0) {
        sections.push(`
          <h3 class="mb-2 mt-6 text-sm font-semibold uppercase tracking-wide text-ink-muted">
            Resolved
          </h3>
          <div class="space-y-3">${resolved.map(renderIncident).join('')}</div>
        `);
      }
      if (feed.truncated || open.length < feed.open_count) {
        sections.push(`
          <p class="mt-4 rounded-md border border-surface-divider bg-surface-inset px-3 py-2 text-xs text-ink-muted">
            Showing ${detailed.length} of ${feed.total} incidents from the bounded feed.
            The active-incident count above is exact${
              open.length < feed.open_count
                ? `; ${feed.open_count - open.length} additional active incident${feed.open_count - open.length === 1 ? '' : 's'} are not shown in this card list`
                : ''
            }.
          </p>
        `);
      }
      list.innerHTML = sections.join('');
    } catch {
      if (fetchToken !== latestFetchToken) return; // superseded by a newer call
      renderOverall('unknown', 0);
      list.innerHTML = `
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-5 text-sm text-amber-800">
          <p>Could not load the incident feed. The Service may still be running normally.</p>
          <button
            type="button"
            data-status-retry
            class="mt-3 rounded-md border border-amber-400/60 px-3 py-1.5 text-xs font-medium hover:bg-amber-100 disabled:cursor-wait disabled:opacity-60"
          >Retry</button>
        </div>
      `;
      const retry = list.querySelector('[data-status-retry]');
      if (retry) {
        retry.addEventListener('click', function () {
          retry.disabled = true;
          retry.textContent = 'Retrying…';
          fetchAndRender();
        });
      }
    }
  }

  fetchAndRender();

  // V-295e — real-time SSE updates. Initial render above gives the
  // user something to look at immediately; the SSE stream then pushes
  // incident.created / incident.resolved as they fire (within a second
  // or two of admin posting). Periodic 60s refetch is kept as a safety
  // net for clients that lose the SSE connection (proxy timeout, network
  // hiccup) — they still get fresh data within a minute either way.
  try {
    const sse = new EventSource(`${API_BASE}/v1/status/stream`);
    function onIncidentEvent() {
      // Re-fetch + render — simpler than splicing the event into the
      // current DOM and lets us keep all rendering logic in one place.
      // The fetch is cache-disabled so we always pull the new state.
      fetchAndRender();
    }
    sse.addEventListener('incident.created', onIncidentEvent);
    sse.addEventListener('incident.resolved', onIncidentEvent);
    sse.addEventListener('error', function () {
      // EventSource auto-reconnects; nothing to do here. The 60s
      // safety-net interval below covers extended SSE outages.
    });
  } catch (e) {
    // EventSource unsupported / blocked — fall back to polling only.
  }
  setInterval(fetchAndRender, 60_000);
</script>
