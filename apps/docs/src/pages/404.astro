---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="text-4xl font-semibold text-tk-ink">Page not found</h1>
    <p class="mt-3 text-sm text-tk-ink-2">
      The page you're looking for might have moved as the docs site is built out. Try the
      <a href="/" class="text-tk-accent-text hover:underline">overview</a>, or check the
      <a
        href="https://github.com/driftstackdev/driftstack-api/tree/main/docs"
        class="text-tk-accent-text hover:underline"
        target="_blank"
        rel="noopener noreferrer">repository docs/ tree</a
      > for canonical references.
    </p>
  </section>
</BaseLayout>
