---
// V-254 / V-257 — docs site landing page.
//
// V-254 replaced the V-250 scaffold-era "site is being built out" copy
// with a real intro that surfaces the doc-tree categories.
// V-257 reorganises around the customer's onboarding path:
// "Quickstart" leads, then per-topic deep dives, then reference at the
// bottom. Pre-launch the per-topic pages migrate in incrementally;
// nav stays stable so deep-link bookmarks survive future content
// additions.
import DocLayout from '../layouts/DocLayout.astro';

const onboarding = [
  {
    label: 'Quickstart',
    description: 'Signup → API key → first session in five minutes. TypeScript, Python, Go.',
    href: '/quickstart/',
  },
  {
    label: 'SDK installation',
    description: 'Install + configure @driftstack/sdk (TS), driftstack-sdk (Python), or sdk-go.',
    href: '/sdk/installation/',
  },
  {
    label: 'License activation',
    description: 'Activate the desktop GUI client against cloud or self-hosted control planes.',
    href: '/license-activation/',
  },
];

const guides = [
  {
    label: 'Profile management',
    description: 'Persistent identities — cookies, storage, stealth state across sessions.',
    href: '/guides/profile-management/',
  },
  {
    label: 'Session lifecycle',
    description: 'States, concurrency caps, idle timeout, error shapes, recovery semantics.',
    href: '/guides/session-lifecycle/',
  },
  {
    label: 'Team RBAC — invite, accept, act-as',
    description:
      'End-to-end multi-user team setup: invite + accept flow, X-Driftstack-Account header, owner / admin / member roles, audit-log review.',
    href: '/guides/team-rbac/',
  },
  {
    label: 'Live video for agent sessions',
    description:
      'Subscribe to the LiveKit room hosting an agent session and render the video. Token mint, connect, input forwarding, reconnect.',
    href: '/guides/live-video/',
  },
];

const reference = [
  {
    label: 'API versioning',
    description: 'Additive vs breaking, deprecation cycle, when /v2/* is justified.',
    href: '/api/versioning/',
  },
  {
    label: 'Webhook events',
    description: 'Event types, payload shape, signature verification, retry policy.',
    href: '/webhooks/events/',
  },
  {
    label: 'SDK versioning',
    description: 'How SDKs version independently of the HTTP API contract.',
    href: '/sdk/versioning/',
  },
  {
    label: 'API keys',
    description: 'Mint, list, rotate, revoke. 24h grace period on rotation.',
    href: '/api/api-keys/',
  },
  {
    label: 'Webhook replay',
    description: 'Replay a single delivery on demand — same idempotency key, fresh attempt.',
    href: '/webhooks/replay/',
  },
  {
    label: 'Team RBAC',
    description: 'Invite, accept, list, remove. Owner / admin / member roles.',
    href: '/api/team/',
  },
  {
    label: 'Agent sessions',
    description:
      'Natural-language decompose-and-execute on top of driver sessions. AI / manual / pair modes; live SSE transcript.',
    href: '/api/agent-sessions/',
  },
  {
    label: 'BYOK Anthropic',
    description: 'Bring your own Anthropic API key — encrypted at rest, decrypted in-memory only.',
    href: '/api/byok-anthropic/',
  },
  {
    label: 'Bundled LLM',
    description:
      'Opt-in deployment-managed Anthropic budget for accounts that don\'t want to manage their own key.',
    href: '/api/bundled-llm/',
  },
  {
    label: 'Recipes',
    description:
      'Snapshot a finished agent-session into a replayable recipe — intent_log + transcript without re-paying decompose cost. Create / list / read / delete ship at v1.0; only execute (replay) lands at v1.1.',
    href: '/api/recipes/',
  },
  {
    label: 'OAuth 2.0',
    description:
      'Third-party clients acting on a customer\'s behalf — Authorization Code with PKCE.',
    href: '/api/oauth/',
  },
  {
    label: 'Idempotency keys',
    description: 'Stripe-pattern `Idempotency-Key` header for safe retries on create-style POSTs.',
    href: '/reference/idempotency/',
  },
  {
    label: 'Pagination',
    description:
      'Cursor-based pagination across every list endpoint; request + response shape, opaque-cursor semantics, drive-to-completion loops.',
    href: '/reference/pagination/',
  },
  {
    label: 'Prometheus metrics',
    description: 'Operator-facing GET /metrics catalogue + suggested PromQL alerts.',
    href: '/reference/metrics/',
  },
];
---

<DocLayout title="Driftstack docs">
  <h1>Driftstack docs</h1>
  <p>
    Reference and guides for integrating with the Driftstack API, using the SDKs, and running
    the desktop GUI client against cloud or self-hosted control planes. Looking for product
    info? <a href="https://driftstack.dev">driftstack.dev</a> has pricing, security, and the rest.
  </p>

  <h2>Get started</h2>
  <p>If you have an API key, start here.</p>
  <ul class="not-prose mt-4 grid gap-4 md:grid-cols-3">
    {
      onboarding.map((s) => (
        <li class="rounded-md border border-white/10 bg-surface-raised p-4 hover:border-oxblood-300">
          <a href={s.href} class="block">
            <p class="font-mono text-xs uppercase tracking-wide text-ink-muted">{s.label}</p>
            <p class="mt-1 text-sm text-ink-secondary">{s.description}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Concept guides</h2>
  <p>What changes when you start running real workloads.</p>
  <ul class="not-prose mt-4 grid gap-4 md:grid-cols-2">
    {
      guides.map((s) => (
        <li class="rounded-md border border-white/10 bg-surface-raised p-4 hover:border-oxblood-300">
          <a href={s.href} class="block">
            <p class="font-mono text-xs uppercase tracking-wide text-ink-muted">{s.label}</p>
            <p class="mt-1 text-sm text-ink-secondary">{s.description}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Reference</h2>
  <p>Spec-level depth for the contracts you build against.</p>
  <ul class="not-prose mt-4 grid gap-4 md:grid-cols-3">
    {
      reference.map((s) => (
        <li class="rounded-md border border-white/10 bg-surface-raised p-4 hover:border-oxblood-300">
          <a href={s.href} class="block">
            <p class="font-mono text-xs uppercase tracking-wide text-ink-muted">{s.label}</p>
            <p class="mt-1 text-sm text-ink-secondary">{s.description}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Looking for something else?</h2>
  <p>
    The canonical source for anything not yet rendered here is the
    <a
      href="https://github.com/driftstackdev/driftstack-api/tree/main/docs"
      target="_blank"
      rel="noopener noreferrer">repository <code>docs/</code> tree</a
    >. The marketing site has product pages at
    <a href="https://driftstack.dev/pricing">/pricing</a>,
    <a href="https://driftstack.dev/security">/security</a>, and
    <a href="https://driftstack.dev/self-hosted">/self-hosted</a>. Email
    <a href="mailto:support@driftstack.dev">support@driftstack.dev</a> if you need a specific
    page prioritized.
  </p>
</DocLayout>
