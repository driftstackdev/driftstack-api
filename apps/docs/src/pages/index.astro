---
// V-254 — docs site landing page. Replaces the V-250 scaffold-era
// "site is being built out" copy with a real intro that surfaces the
// doc-tree categories. Pre-launch the per-topic pages migrate in
// incrementally; nav stays stable so deep-link bookmarks survive
// future content additions.
import DocLayout from '../layouts/DocLayout.astro';

const sections = [
  {
    label: 'API reference',
    description: 'HTTP API surface — versioning, error shapes, endpoint catalog.',
    href: '/api/',
  },
  {
    label: 'Webhooks',
    description: 'Event-driven push notifications — types, payloads, retry policy.',
    href: '/webhooks/events/',
  },
  {
    label: 'SDKs',
    description: 'TypeScript, Python, Go (planned). Identical resource shapes everywhere.',
    href: '/sdk/',
  },
  {
    label: 'Guides',
    description: 'Tutorials + integration patterns. Quickstart, profile reuse, more.',
    href: '/guides/',
  },
];
---

<DocLayout title="Driftstack docs">
  <h1>Driftstack docs</h1>
  <p>
    Reference and guides for integrating with the Driftstack API, using the SDKs, and running
    the self-hosted GUI client. Looking for product info? <a href="https://driftstack.dev"
      >driftstack.dev</a
    > has pricing, security, and the rest.
  </p>

  <h2>Where to start</h2>

  <ul class="not-prose mt-4 grid gap-4 md:grid-cols-2">
    {
      sections.map((s) => (
        <li class="rounded-md border border-slate-200 bg-white p-4 hover:border-oxblood-300">
          <a href={s.href} class="block">
            <p class="font-mono text-xs uppercase tracking-wide text-slate-500">{s.label}</p>
            <p class="mt-1 text-sm text-slate-700">{s.description}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>What's documented today</h2>

  <p>
    The docs site is filling in incrementally. The pages live below; the canonical source for
    anything not yet rendered here is the
    <a
      href="https://github.com/driftstackdev/driftstack-api/tree/main/docs"
      target="_blank"
      rel="noopener noreferrer">repository <code>docs/</code> tree</a
    >. Email <a href="mailto:support@driftstack.dev">support@driftstack.dev</a> if you need a
    specific page prioritized.
  </p>

  <ul>
    <li>
      <a href="/api/versioning/">API versioning policy</a> — additive vs breaking, the deprecation
      cycle, when <code>/v2/*</code> is justified.
    </li>
    <li>
      <a href="/webhooks/events/">Webhook events catalog</a> — every event type, payload shape,
      signature verification, retry policy.
    </li>
    <li>
      <a href="/sdk/versioning/">SDK versioning policy</a> — how SDKs version independently of the
      HTTP API.
    </li>
  </ul>
</DocLayout>
