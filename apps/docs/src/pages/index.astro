---
// V-254 / V-257 — docs site landing page.
//
// V-254 replaced the V-250 scaffold-era "site is being built out" copy
// with a real intro that surfaces the doc-tree categories.
// V-257 reorganises around the customer's onboarding path:
// "Quickstart" leads, then per-topic deep dives, then reference at the
// bottom. Pre-launch the per-topic pages migrate in incrementally;
// nav stays stable so deep-link bookmarks survive future content
// additions.
//
// S22.5 (2026-07-06, Stoplight redesign final slice) — landing rebuilt
// as the front door to the three-pane docs, per the standing
// plain-language mandate for the intro tier. Structure: plain-words
// hero + Quickstart CTA + a search button that reuses the S22.3
// [data-search-open] Pagefind modal (no second search implementation);
// a "pick your path" band matching the three real arrival intents
// (drive it by hand / drive it from code / look something up) with
// plain words leading and a mono aside naming the technical resource;
// and one card per DOC_NAV section — labels, hrefs, and page counts
// derive from DOC_NAV itself so the landing can never drift from the
// tree (only the one-line plain descriptions live here). The old
// hand-kept onboarding/guides/reference card grids are superseded:
// every route sits in the left tree on every page, and each section
// card leads to a section index listing its pages. The V-257
// deep-link promise holds — no slugs changed.
import DocLayout from '../layouts/DocLayout.astro';
import { DOC_NAV } from '../data/nav';

// "Pick your path" — the three ways people actually arrive at these
// docs. Plain words lead; the mono line names the technical resource.
const paths = [
  {
    label: 'Drive it by hand',
    plain:
      'Install the desktop app, paste in your API key, and control a cloud iPhone with your mouse and keyboard — no code needed.',
    mono: 'GUI client · license activation',
    href: '/license-activation/',
    cta: 'Set up the desktop app',
  },
  {
    label: 'Drive it from code',
    plain:
      'Start your first iPhone Safari session from a few lines of TypeScript, Python, or Go — the quickstart has copy-paste examples.',
    mono: 'quickstart · @driftstack/sdk',
    href: '/quickstart/',
    cta: 'Follow the quickstart',
  },
  {
    label: 'Look something up',
    plain:
      'Find the exact request, field, or error you need — or press ⌘K anywhere and search every page at once.',
    mono: 'API reference · /v1/*',
    href: '/api/',
    cta: 'Open the API reference',
  },
];

// One-line plain descriptions for the DOC_NAV sections. Labels, hrefs,
// and page counts come from DOC_NAV (single source of truth) — only
// the plain-words gloss lives here, keyed by section label so a
// renamed or added section surfaces as a card with a missing
// description (and trips the S22.5 re-pins, which assert every
// section label has an entry).
const sectionIntros: Record<string, string> = {
  Overview: 'This page — the front door to everything below.',
  'Get started':
    'Create your account, get a key, and run your first session — from code or from the desktop app.',
  Guides:
    'Longer reads on how the moving parts fit together — profiles, sessions, teams, live video.',
  SDKs: 'The official code libraries for TypeScript, Python, and Go, and how to install them.',
  'API reference': 'Every request the API accepts, with fields, examples, and error shapes.',
  Webhooks:
    'Messages Driftstack sends your server when something happens — payloads, signatures, retries.',
  'Platform reference':
    'The ground rules every request follows — errors, rate limits, paging, safe retries (idempotency), key scopes, metrics.',
};

const sections = DOC_NAV.map((s) => ({
  label: s.label,
  href: s.items[0]?.href ?? '/',
  count: s.items.length,
  intro: sectionIntros[s.label] ?? '',
}));
---

<DocLayout title="Driftstack docs">
  <h1>Driftstack docs</h1>
  <p>
    Driftstack gives you real iPhones in the cloud. These docs show you how to drive them —
    by hand from the desktop app, from code in TypeScript, Python, or Go, or by handing the
    wheel to an AI agent (<a href="/api/agent-sessions/">agent sessions</a>).
  </p>

  <div class="not-prose mt-6 flex flex-wrap items-center gap-3">
    <a href="/quickstart/" class="btn-primary">Start in about five minutes</a>
    <button
      type="button"
      data-search-open
      aria-label="Search docs"
      aria-haspopup="dialog"
      aria-keyshortcuts="Meta+K Control+K /"
      class="btn-secondary gap-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <span>Search the docs</span>
      <kbd
        data-search-kbd
        class="rounded-sm border border-tk-border bg-tk-raised px-1 font-mono text-[0.625rem] leading-4 text-tk-ink-3"
        >⌘K</kbd
      >
    </button>
  </div>

  <h2>Pick your path</h2>
  <p>Three ways people arrive here. Start with the one that sounds like you.</p>
  <ul class="not-prose mt-4 grid gap-4 md:grid-cols-3">
    {
      paths.map((p) => (
        <li class="rounded-md border border-tk-border bg-tk-surface shadow-ambient transition-colors hover:border-tk-accent/40">
          <a href={p.href} class="flex h-full flex-col p-4">
            <p class="text-sm font-semibold text-tk-ink">{p.label}</p>
            <p class="mt-1 text-sm text-tk-ink-2">{p.plain}</p>
            <p class="mt-3 font-mono text-xs text-tk-ink-3">{p.mono}</p>
            <p class="mt-auto pt-3 text-sm font-medium text-tk-accent-text">{p.cta} →</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Browse the docs</h2>
  <p>Every page on this site, grouped the same way as the sidebar tree.</p>
  <ul class="not-prose mt-4 grid gap-4 md:grid-cols-2">
    {
      sections.map((s) => (
        <li class="rounded-md border border-tk-border bg-tk-surface shadow-ambient transition-colors hover:border-tk-accent/40">
          <a href={s.href} class="block h-full p-4">
            <div class="flex items-baseline justify-between gap-3">
              <p class="text-sm font-semibold text-tk-ink">{s.label}</p>
              <p class="shrink-0 font-mono text-xs text-tk-ink-3">
                {s.count} {s.count === 1 ? 'page' : 'pages'}
              </p>
            </div>
            <p class="mt-1 text-sm text-tk-ink-2">{s.intro}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Need help?</h2>
  <p>
    The public API reference in this site is the supported customer contract.
    The repository also contains architecture and deployment material in its
    <a
      href="https://github.com/driftstackdev/driftstack-api/tree/main/docs"
      target="_blank"
      rel="noopener noreferrer">repository <code>docs/</code> tree</a
    >. The marketing site has product pages at
    <a href="https://driftstack.dev/pricing/">/pricing</a>,
    <a href="https://driftstack.dev/security/">/security</a>, and
    <a href="https://driftstack.dev/self-hosted/">/self-hosted</a>. Email
    <a href="mailto:support@driftstack.dev">support@driftstack.dev</a> for account-specific help.
  </p>
</DocLayout>
