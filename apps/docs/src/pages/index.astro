---
// V-250 — docs site landing page. Scaffolding only; per-topic pages
// migrate from /docs/ markdown sources in subsequent V-NNN entries.
// For launch the landing page is the customer's entry point with
// pointers at the canonical docs sources (currently the GitHub repo;
// post-V-251+ they'll be inline pages here).
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    label: 'API reference',
    description: 'HTTP API surface, versioning policy, webhook event catalog.',
    items: [
      {
        href: '/api/',
        title: 'API overview',
        summary: '/v1/* surface, auth, rate limits, error shapes.',
      },
    ],
  },
  {
    label: 'SDKs',
    description: 'TypeScript, Python, Go (planned). Identical resource shapes across all SDKs.',
    items: [
      {
        href: '/sdk/',
        title: 'SDK overview',
        summary: 'Installation, auth, error handling, version compatibility.',
      },
    ],
  },
  {
    label: 'Guides',
    description: 'Onboarding tutorials, common workflows, integration patterns.',
    items: [
      {
        href: '/guides/',
        title: 'Guides overview',
        summary: 'Getting started, first session, profile reuse, webhook integrations.',
      },
    ],
  },
];
---

<BaseLayout title="Driftstack docs">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="mb-12 max-w-2xl">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Driftstack docs</h1>
      <p class="mt-4 text-base text-slate-600">
        Reference and guides for integrating with the Driftstack API, using the SDKs, and running
        the self-hosted GUI client.
      </p>
      <p class="mt-2 text-sm text-slate-500">
        Looking for product info? <a
          href="https://driftstack.dev"
          class="text-oxblood-700 hover:underline">driftstack.dev</a
        > has pricing, security, and the rest.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        sections.map((section) => (
          <article class="rounded-md border border-slate-200 bg-white p-6">
            <h2 class="font-mono text-xs uppercase tracking-wide text-slate-500">{section.label}</h2>
            <p class="mt-3 text-sm text-slate-700">{section.description}</p>
            <ul class="mt-4 space-y-2 text-sm">
              {section.items.map((item) => (
                <li>
                  <a href={item.href} class="text-oxblood-700 hover:underline">
                    {item.title}
                  </a>
                  <p class="mt-0.5 text-xs text-slate-500">{item.summary}</p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-12 rounded-md border border-slate-200 bg-white p-6">
      <h2 class="text-base font-medium text-slate-900">Pre-launch note</h2>
      <p class="mt-2 text-sm text-slate-600">
        Driftstack is pre-launch as of 2026. The docs surface is being built out incrementally;
        the canonical reference for any topic not yet rendered here lives in the
        <a
          href="https://github.com/driftstackdev/driftstack-api/tree/main/docs"
          class="text-oxblood-700 hover:underline"
          target="_blank"
          rel="noopener noreferrer">repository docs/ tree</a
        >. If you need something specific, email
        <a href="mailto:support@driftstack.dev" class="text-oxblood-700 hover:underline"
          >support@driftstack.dev</a
        >
        and we'll prioritize.
      </p>
    </div>
  </section>
</BaseLayout>
