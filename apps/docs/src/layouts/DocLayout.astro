---
// V-254 — doc-page layout. Wraps BaseLayout with a sidebar nav (from
// `data/nav.ts`) and a content column. Used as `layout:` frontmatter
// in `.md` doc pages so markdown content renders into the slot with
// the doc-site brand chrome around it.
//
// Frontmatter contract: pages set `title` (required), optionally
// `description` (overrides BaseLayout default).
import BaseLayout from './BaseLayout.astro';
import { DOC_NAV } from '../data/nav';

interface Props {
  /** Frontmatter object from `.md` pages or direct prop from `.astro` pages. */
  frontmatter?: { title: string; description?: string };
  /** Direct title prop for `.astro` pages without frontmatter. */
  title?: string;
  /** Direct description prop. */
  description?: string;
}

const props = Astro.props;
const title = props.frontmatter?.title ?? props.title ?? 'Driftstack docs';
const description = props.frontmatter?.description ?? props.description;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  // Match exact or trailing-slash variant.
  return pathname === href || pathname === href.replace(/\/$/, '');
}
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto flex max-w-6xl gap-8 px-6 py-8">
    <aside class="hidden w-56 shrink-0 md:block">
      <nav class="sticky top-6">
        {
          DOC_NAV.map((section) => (
            <div class="mb-5">
              <p class="font-mono text-xs uppercase tracking-wide text-ink-muted">
                {section.label}
              </p>
              <ul class="mt-2 space-y-1">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'block rounded px-2 py-1 text-sm transition-colors',
                        isActive(item.href)
                          ? 'bg-glow-red/15 text-glow-red font-medium'
                          : 'text-ink-secondary hover:bg-white/5 hover:text-ink-primary',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>
    <!-- R11 — prose styling rebuilt for the dark surface. Uses
         `prose-invert` so the typography plugin's defaults flip to
         light text on dark, then overrides the load-bearing tokens
         explicitly:
           - body copy: ink-secondary for soft readability
           - headings: ink-primary, semibold
           - links: glow-red (the lighter brand-red reads against
             slate-900; the locked oxblood-700 is too dark to be
             readable on a dark surface)
           - inline code: subtle white/8 chip with ink-primary text
             so it pops against body copy without looking like a
             button
           - fenced pre: surface-inset (slate-950) with a 1px
             white/10 border + ink-secondary text — high-contrast
             monospace replacement for the previous "ugly white
             extra background" the founder flagged
           - blockquote: oxblood-300 left rule + ink-secondary text
           - tables: surface-raised header row + white/10 borders -->
    <article
      class="prose prose-invert prose-slate max-w-3xl flex-1
             prose-headings:font-semibold prose-headings:text-ink-primary
             prose-p:text-ink-secondary prose-li:text-ink-secondary
             prose-strong:text-ink-primary
             prose-a:text-glow-red prose-a:no-underline hover:prose-a:underline
             prose-code:font-mono prose-code:text-[0.875em] prose-code:rounded
             prose-code:bg-white/10 prose-code:px-1.5 prose-code:py-0.5
             prose-code:text-ink-primary prose-code:before:content-none
             prose-code:after:content-none
             prose-pre:bg-surface-inset prose-pre:border prose-pre:border-white/10
             prose-pre:text-ink-secondary prose-pre:shadow-inset-divider
             prose-blockquote:border-l-oxblood-300 prose-blockquote:text-ink-secondary
             prose-blockquote:not-italic
             prose-th:bg-surface-raised prose-th:text-ink-primary
             prose-td:text-ink-secondary
             prose-th:border-white/10 prose-td:border-white/10
             prose-hr:border-white/10"
    >
      <slot />
    </article>
  </div>
</BaseLayout>
