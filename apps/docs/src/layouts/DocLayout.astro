---
// V-254 — doc-page layout. Wraps BaseLayout with a sidebar nav (from
// `data/nav.ts`) and a content column. Used as `layout:` frontmatter
// in `.md` doc pages so markdown content renders into the slot with
// the doc-site brand chrome around it.
//
// Frontmatter contract: pages set `title` (required), optionally
// `description` (overrides BaseLayout default).
//
// S22.2 (2026-07-06) — Stoplight-style three-pane relayout (founder:
// docs were "pretty unclear"; reference = developer.payoneer.com).
// LEFT: the full DOC_NAV tree (all 50 routes) in a sticky,
// independently-scrolling pane with collapsible <details> sections
// (no-JS-safe). CENTER: breadcrumbs + the article at a ~72ch reading
// measure + prev/next cards from the flattened DOC_NAV order — all
// rendered by the LAYOUT, never injected into the .md sources.
// RIGHT (≥xl): a sticky "On this page" rail with h2+h3 depth and
// IntersectionObserver scroll-spy, replacing the old inline-injected
// TOC box.
//
// S22.4 (2026-07-06) — Stoplight reference furniture:
//   - Per-endpoint SUB-NODES in the left tree: DOC_NAV children
//     (anchor href + colored .method-chip method badge) render
//     indented under their resource entry, ONLY while that entry is
//     the active page (Stoplight behavior — the tree stays scannable;
//     other resources show just their label). Children are anchors,
//     not pages: breadcrumbs + prev/next keep walking top-level items.
//   - Client-side LANGUAGE TABS (zero .md churn): the last is:inline
//     script groups runs of adjacent multi-language code samples into
//     a keyboard-accessible tab group and remembers the picked
//     language in localStorage (ds_docs_lang).
import BaseLayout from './BaseLayout.astro';
import { DOC_NAV } from '../data/nav';

interface Props {
  /** Frontmatter object from `.md` pages or direct prop from `.astro` pages. */
  frontmatter?: { title: string; description?: string };
  /** Direct title prop for `.astro` pages without frontmatter. */
  title?: string;
  /** Direct description prop. */
  description?: string;
}

const props = Astro.props;
const title = props.frontmatter?.title ?? props.title ?? 'Driftstack docs';
const description = props.frontmatter?.description ?? props.description;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  // Match exact or trailing-slash variant.
  return pathname === href || pathname === href.replace(/\/$/, '');
}

// S22.2 — breadcrumb + prev/next derive from the SAME nav source
// (DOC_NAV stays the single source of truth): flatten the tree in
// section order so prev/next walk the sidebar's reading order, and
// the breadcrumb is "section › page" for the active item.
const flatNav = DOC_NAV.flatMap((section) =>
  section.items.map((item) => ({ section: section.label, href: item.href, label: item.label })),
);
const activeIndex = flatNav.findIndex((item) => isActive(item.href));
const active = activeIndex === -1 ? undefined : flatNav[activeIndex];
const prevItem = activeIndex > 0 ? flatNav[activeIndex - 1] : undefined;
const nextItem =
  activeIndex !== -1 && activeIndex < flatNav.length - 1 ? flatNav[activeIndex + 1] : undefined;
---

<BaseLayout title={title} description={description}>
  {/* 2026-05-21 — mobile doc-nav toggle. Default sidebar is
      `hidden md:block`; the hamburger flips `html[data-mobile-nav-open]`
      to reveal the aside as a fullscreen overlay. Closes on link tap
      so the destination doc page doesn't briefly show the overlay. */}
  <style>
    html[data-mobile-nav-open='true'] [data-doc-mobile-nav] {
      display: block;
      position: fixed;
      inset: 56px 0 0 0;
      width: 100%;
      z-index: 30;
      overflow-y: auto;
      padding: 1.5rem;
      /* S22.1 — mode-aware overlay scrim (was a baked near-black rgba). */
      background: rgb(var(--bg-rgb) / 0.95);
      backdrop-filter: blur(8px);
    }
  </style>
  <div class="md:hidden flex items-center justify-between border-b border-tk-border px-4 py-3">
    <span class="font-mono text-xs uppercase tracking-widest text-tk-ink-3">Docs</span>
    <button
      type="button"
      data-doc-mobile-nav-toggle
      aria-label="Open docs navigation"
      aria-controls="docs-mobile-navigation"
      aria-expanded="false"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-tk-border text-tk-ink-2 hover:text-tk-ink"
    >
      <svg
        data-doc-mobile-nav-icon="closed"
        viewBox="0 0 16 16"
        width="18"
        height="18"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <path d="M2.5 4h11 M2.5 8h11 M2.5 12h11" />
      </svg>
      <svg
        data-doc-mobile-nav-icon="open"
        viewBox="0 0 16 16"
        width="18"
        height="18"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        class="hidden"
      >
        <path d="m3 3 10 10 M13 3 3 13" />
      </svg>
    </button>
  </div>
  {/* S22.2 — three-pane shell: 16rem tree · fluid article column ·
      15rem "On this page" rail (rail mounts ≥xl only). Wider 90rem
      canvas replaces the two-column max-w-6xl flex shell. */}
  <div
    class="mx-auto w-full max-w-[90rem] px-6 py-8 md:grid md:grid-cols-[16rem_minmax(0,1fr)] md:gap-10 xl:grid-cols-[16rem_minmax(0,1fr)_15rem]"
  >
    <aside id="docs-mobile-navigation" data-doc-mobile-nav class="hidden md:block">
      {/* Sticky, independently-scrolling tree pane (desktop only — in
          the mobile overlay the aside itself is the scroll container,
          so the md: prefixes keep it a plain block there). Sections
          are <details open> groups: collapsible without JS, and every
          section defaults open so the active item is always visible. */}
      <nav
        aria-label="Docs navigation"
        class="md:sticky md:top-6 md:max-h-[calc(100vh-3rem)] md:overflow-y-auto md:pb-10 md:pr-3"
      >
        {
          DOC_NAV.map((section) => (
            <details open class="group" data-nav-section>
              <summary class="flex cursor-pointer select-none list-none items-center justify-between gap-2 rounded-sm px-2 py-1.5 font-mono text-xs uppercase tracking-wide text-tk-ink-3 hover:text-tk-ink [&::-webkit-details-marker]:hidden">
                {section.label}
                <svg
                  viewBox="0 0 16 16"
                  width="12"
                  height="12"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="shrink-0 transition-transform group-open:rotate-90"
                >
                  <path d="m6 4 4 4-4 4" />
                </svg>
              </summary>
              <ul class="mb-4 mt-1 space-y-0.5">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        // 2026-05-21 — font-medium on the base class
                        // keeps text width constant across active /
                        // inactive; otherwise clicking shifted other
                        // items (same fix as DashboardLayout 50b0dd7a).
                        'block rounded-sm px-2 py-1 text-sm font-medium transition-colors',
                        // S22.1 — active = accent-soft WASH bg (background
                        // token only) + AA-safe accent-text ink.
                        isActive(item.href)
                          ? 'bg-tk-accent-soft text-tk-accent-text'
                          : 'text-tk-ink-2 hover:bg-tk-hover hover:text-tk-ink',
                      ]}
                    >
                      {item.label}
                    </a>
                    {/* S22.4 — per-endpoint anchor sub-nodes with method
                        chips, rendered ONLY for the active resource page
                        (Stoplight behavior). The chip text is real content
                        (screen readers announce "GET List"), styled by the
                        base.css .method-chip recipes (AA-verified per
                        mode). */}
                    {item.children && isActive(item.href) && (
                      <ul
                        data-nav-endpoints
                        class="mb-1.5 ml-2 mt-0.5 space-y-px border-l border-tk-border pl-2"
                      >
                        {item.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              class="flex items-center gap-2 rounded-sm px-2 py-0.5 text-[0.8125rem] text-tk-ink-2 transition-colors hover:bg-tk-hover hover:text-tk-ink"
                            >
                              {child.method && (
                                <span class={'method-chip method-chip--' + child.method.toLowerCase()}>
                                  {child.method}
                                </span>
                              )}
                              <span class="min-w-0 truncate">{child.label}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </nav>
    </aside>
    <div class="min-w-0">
      {/* S22.2 — breadcrumb (section › page) from the DOC_NAV lookup;
          layout-rendered above the article's h1, never injected into
          the .md sources. */}
      {
        active && (
          <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-xs">
            <span class="font-mono uppercase tracking-wide text-tk-ink-3">{active.section}</span>
            <span aria-hidden="true" class="text-tk-ink-3">
              ›
            </span>
            <span class="font-medium text-tk-ink-2">{active.label}</span>
          </nav>
        )
      }
      <!-- S22.1 (2026-07-06, brand-parity port) — tk-token-driven prose.
           SUPERSEDES the R11 slate-prose LIGHT-surface stack: the color
           hooks now live in base.css as un-layered `.prose`
           --tw-prose-* overrides reading the mode-scoped tk custom
           properties (single class set, still NOT the dark-inverted
           prose variant — no mode-flip class swap), so body copy /
           headings / links / bullets follow <html data-mode>. Kept here
           explicitly:
             - links: --accent-text via base.css (AA-safe accent TEXT
               tone — never the raw accent, never a wash token as text)
             - inline code: accent-soft WASH chip (background token
               only) with tk-ink text
             - fenced pre: a DARK code surface in BOTH modes
               (--tw-prose-pre-bg: var(--code-bg) — #16171c light /
               #0c0c11 dark; founder-pinned: light code backgrounds were
               flagged "ugly / barely readable", so fenced code stays a
               dark terminal even on the light docs theme)
             - tables/hr: tk-border via the base.css hooks
           S22.2 — flex-1 dropped (the grid column sizes the pane now);
           max-w-3xl keeps the ~72ch reading measure inside the wider
           shell. Blockquote callout restyle lives in base.css.
           S22.3 (2026-07-06) — data-pagefind-body scopes the Pagefind
           index to the ARTICLE only: once any page carries the
           attribute, pages/regions without it stay out of the index, so
           the header/tree/TOC/footer chrome (and the 404 page, which
           wraps BaseLayout directly) never pollute search results. Page
           title metadata = Pagefind's default first-h1 capture (every
           doc page has one — docs-page-h1-presence guards it). -->
      <article
        data-pagefind-body
        class="prose max-w-3xl
               prose-headings:font-semibold
               prose-a:no-underline prose-a:hover:underline
               prose-code:font-mono prose-code:text-[0.875em] prose-code:rounded-sm
               prose-code:bg-tk-accent-soft prose-code:px-1.5 prose-code:py-0.5
               prose-code:before:content-none
               prose-code:after:content-none
               prose-pre:border prose-pre:border-tk-border
               prose-pre:shadow-inset-divider
               prose-blockquote:not-italic
               prose-th:bg-tk-surface"
      >
        <slot />
      </article>
      {/* S22.2 — prev/next pager from the flattened DOC_NAV order
          (layout-rendered, tk-styled cards). */}
      {
        (prevItem || nextItem) && (
          <nav
            aria-label="Previous and next pages"
            class="mt-12 grid max-w-3xl gap-3 border-t border-tk-border pt-6 sm:grid-cols-2"
          >
            {prevItem ? (
              <a
                href={prevItem.href}
                class="group rounded-lg border border-tk-border bg-tk-surface px-4 py-3 transition-colors hover:border-tk-ink-3 hover:bg-tk-hover"
              >
                <span class="block text-xs text-tk-ink-3">
                  <span aria-hidden="true">←</span> Previous
                </span>
                <span class="mt-1 block text-sm font-medium text-tk-ink-2 transition-colors group-hover:text-tk-ink">
                  {prevItem.label}
                </span>
              </a>
            ) : (
              <span class="hidden sm:block" aria-hidden="true" />
            )}
            {nextItem && (
              <a
                href={nextItem.href}
                class="group rounded-lg border border-tk-border bg-tk-surface px-4 py-3 text-right transition-colors hover:border-tk-ink-3 hover:bg-tk-hover"
              >
                <span class="block text-xs text-tk-ink-3">
                  Next <span aria-hidden="true">→</span>
                </span>
                <span class="mt-1 block text-sm font-medium text-tk-ink-2 transition-colors group-hover:text-tk-ink">
                  {nextItem.label}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </div>
    {/* S22.2 — right "On this page" rail (≥xl). Starts hidden; the
        scroll-spy script below populates it from the article's h2/h3
        ids and reveals it when the page has enough sections. */}
    <aside class="hidden xl:block">
      <nav
        data-toc
        aria-label="On this page"
        class="sticky top-6 hidden max-h-[calc(100vh-3rem)] overflow-y-auto pb-10"
      >
        <p class="mb-2 text-xs font-medium uppercase tracking-widest text-tk-ink-3">On this page</p>
        <ul data-toc-list class="space-y-0.5 border-l border-tk-border text-sm"></ul>
      </nav>
    </aside>
  </div>
  <script is:inline>
    (function () {
      var toggle = document.querySelector('[data-doc-mobile-nav-toggle]');
      if (!toggle) return;
      var root = document.documentElement;
      var closedIcon = document.querySelector('[data-doc-mobile-nav-icon="closed"]');
      var openIcon = document.querySelector('[data-doc-mobile-nav-icon="open"]');
      function setOpen(isOpen) {
        if (isOpen) {
          root.setAttribute('data-mobile-nav-open', 'true');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close docs navigation');
          if (closedIcon) closedIcon.classList.add('hidden');
          if (openIcon) openIcon.classList.remove('hidden');
        } else {
          root.removeAttribute('data-mobile-nav-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open docs navigation');
          if (closedIcon) closedIcon.classList.remove('hidden');
          if (openIcon) openIcon.classList.add('hidden');
        }
      }
      toggle.addEventListener('click', function () {
        setOpen(root.getAttribute('data-mobile-nav-open') !== 'true');
      });
      document.querySelectorAll('aside[data-doc-mobile-nav] a').forEach(function (a) {
        a.addEventListener('click', function () {
          setOpen(false);
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.getAttribute('data-mobile-nav-open') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });
      /* S48 2026-07-07 (founder UX report) — every docs navigation is a full page load,
         so the sidebar used to re-render scrolled to the top ("it auto
         scrolls the navigation back up"). Persist the pane's scrollTop
         across navigations (sessionStorage, saved on pagehide + on nav
         clicks), restore it before paint-adjacent work, and only nudge
         the active item into view when it is genuinely outside the
         restored viewport (the S22.2 nudge is now conditional). */
      var navPane = document.querySelector('aside[data-doc-mobile-nav] nav');
      if (navPane) {
        try {
          var savedScroll = sessionStorage.getItem('ds_docs_nav_scroll');
          if (savedScroll !== null) navPane.scrollTop = parseInt(savedScroll, 10) || 0;
        } catch (_) {
          /* storage unavailable — fresh pane each load, as before */
        }
        function saveNavScroll() {
          try {
            sessionStorage.setItem('ds_docs_nav_scroll', String(navPane.scrollTop));
          } catch (_) {
            /* best-effort */
          }
        }
        window.addEventListener('pagehide', saveNavScroll);
        navPane.addEventListener('click', saveNavScroll);
      }
      var current = document.querySelector('aside[data-doc-mobile-nav] a[aria-current="page"]');
      if (current && navPane && current.scrollIntoView) {
        var paneRect = navPane.getBoundingClientRect();
        var itemRect = current.getBoundingClientRect();
        if (itemRect.top < paneRect.top || itemRect.bottom > paneRect.bottom) {
          current.scrollIntoView({ block: 'nearest' });
        }
      }
    })();
  </script>
  <script is:inline>
    {/* Copy-to-clipboard on every docs code block — developers copy SDK
        snippets constantly, so a one-click copy is table-stakes DX. The
        button is a real <button> with an aria-label (keyboard-accessible)
        and only mounts when the Clipboard API is available. */}
    (function () {
      if (!navigator.clipboard || !navigator.clipboard.writeText) return;
      document.querySelectorAll('article pre').forEach(function (pre) {
        if (pre.querySelector('[data-copy-code]')) return;
        pre.style.position = 'relative';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-copy-code', '');
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        btn.setAttribute('aria-live', 'polite');
        btn.setAttribute('aria-atomic', 'true');
        btn.textContent = 'Copy';
        btn.className =
          'absolute right-2 top-2 rounded-sm border border-tk-border bg-tk-raised ' +
          'px-2 py-1 text-xs font-medium text-tk-ink-3 opacity-70 transition ' +
          'hover:text-tk-ink hover:opacity-100 focus-visible:opacity-100';
        var copyInFlight = false;
        var resetTimer = null;
        function resetCopyButton() {
          btn.textContent = 'Copy';
          btn.setAttribute('aria-label', 'Copy code to clipboard');
          resetTimer = null;
        }
        function showCopyResult(label, ariaLabel, delayMs) {
          if (resetTimer !== null) window.clearTimeout(resetTimer);
          btn.textContent = label;
          btn.setAttribute('aria-label', ariaLabel);
          resetTimer = window.setTimeout(resetCopyButton, delayMs);
        }
        btn.addEventListener('click', function () {
          if (copyInFlight) return;
          var code = pre.querySelector('code');
          var text = (code ? code.textContent : pre.textContent) || '';
          copyInFlight = true;
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          var write;
          try {
            write = navigator.clipboard.writeText(text);
          } catch (error) {
            write = Promise.reject(error);
          }
          Promise.resolve(write)
            .then(
              function () {
                showCopyResult('Copied', 'Code copied to clipboard', 1500);
              },
              function () {
                showCopyResult('Copy failed', 'Could not copy code; select it manually', 1800);
              },
            )
            .finally(function () {
              copyInFlight = false;
              btn.disabled = false;
              btn.setAttribute('aria-busy', 'false');
            });
        });
        pre.appendChild(btn);
      });
    })();
  </script>
  <script is:inline>
    {/* Section anchor links — Astro auto-generates heading ids, but there
        was no visible affordance to grab the deep-link. Add a "#" link
        that appears on heading hover/focus; clicking jumps to the section
        AND copies the full URL so the section is shareable. */}
    (function () {
      document.querySelectorAll('article h2[id], article h3[id]').forEach(function (h) {
        if (h.querySelector('[data-anchor]')) return;
        h.classList.add('group');
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.setAttribute('data-anchor', '');
        a.setAttribute('aria-label', 'Link to this section');
        a.textContent = '#';
        a.className =
          'ml-2 inline-block font-normal text-tk-ink-3 no-underline opacity-0 ' +
          'transition-opacity hover:text-tk-accent-text focus-visible:opacity-100 group-hover:opacity-100';
        var copyGeneration = 0;
        var anchorResetTimer = null;
        function showAnchorCopyResult(label, ariaLabel, title) {
          if (anchorResetTimer !== null) window.clearTimeout(anchorResetTimer);
          a.textContent = label;
          a.setAttribute('aria-label', ariaLabel);
          a.title = title;
          anchorResetTimer = window.setTimeout(function () {
            a.textContent = '#';
            a.setAttribute('aria-label', 'Link to this section');
            a.removeAttribute('title');
            anchorResetTimer = null;
          }, 1800);
        }
        a.addEventListener('click', function () {
          var generation = ++copyGeneration;
          var write;
          try {
            if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
              write = Promise.reject(new Error('Clipboard API unavailable'));
            } else {
              write = navigator.clipboard.writeText(
                window.location.origin + window.location.pathname + '#' + h.id,
              );
            }
          } catch (error) {
            write = Promise.reject(error);
          }
          Promise.resolve(write).then(
            function () {
              if (generation !== copyGeneration) return;
              showAnchorCopyResult('✓', 'Section link copied', 'Section link copied');
            },
            function () {
              if (generation !== copyGeneration) return;
              showAnchorCopyResult(
                '!',
                'Could not copy section link; use the browser address bar',
                'Could not copy; use the browser address bar',
              );
            },
          );
        });
        h.appendChild(a);
      });
    })();
  </script>
  <script is:inline>
    {/* S22.2 — "On this page" sticky rail (REPLACES the old inline TOC
        box that was inserted before the first h2). Populates the ≥xl
        right rail from the article's h2 + h3 ids, scroll-spies the
        current section with IntersectionObserver, and smooth-scrolls
        anchor jumps unless the visitor prefers reduced motion. Labels
        come from the heading's FULL textContent with the appended "#"
        anchor element stripped (clone + remove [data-anchor]) — S35
        2026-07-07 (fable-frontend-audit): the old first-text-node read
        truncated any heading that STARTS with inline code to just that
        code span (18 of 30 rail entries on /webhooks/events lost their
        [LIVE]/[PLANNED] tags). The spy also re-syncs on hashchange and
        on rail clicks, so an instant anchor jump that crosses no
        observed heading still highlights the right entry. Plain raw
        code — never a template literal inside an expression container
        (the dead-inline-script trap: Astro would emit the wrapper
        literally as a no-op string). */}
    (function () {
      var article = document.querySelector('article');
      var toc = document.querySelector('[data-toc]');
      var list = document.querySelector('[data-toc-list]');
      if (!article || !toc || !list) return;
      var headings = Array.prototype.slice.call(article.querySelectorAll('h2[id], h3[id]'));
      var h2Count = headings.filter(function (h) {
        return h.tagName === 'H2';
      }).length;
      if (h2Count < 2) return;
      var base =
        'block -ml-px border-l border-transparent py-1 pr-2 text-tk-ink-2 ' +
        'no-underline transition-colors hover:text-tk-ink';
      var activeCls =
        'block -ml-px border-l border-tk-accent py-1 pr-2 font-medium ' +
        'text-tk-accent-text no-underline transition-colors';
      var linkById = {};
      headings.forEach(function (h) {
        /* Full heading text minus the appended "#" anchor link: clone the
           node, remove the [data-anchor] element (added by the earlier
           section-anchor script), then read textContent. The trailing-#
           strip stays as a belt-and-braces guard for a heading whose
           anchor was not yet (or never) appended. */
        var labelSource = h.cloneNode(true);
        var anchorEl = labelSource.querySelector('[data-anchor]');
        if (anchorEl && anchorEl.parentNode) anchorEl.parentNode.removeChild(anchorEl);
        var label = (labelSource.textContent || '').replace(/#$/, '').trim();
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = label;
        a.setAttribute('data-toc-depth', h.tagName === 'H3' ? '3' : '2');
        a.className = base + (h.tagName === 'H3' ? ' pl-6 text-[0.8125rem]' : ' pl-3');
        a.addEventListener('click', function (e) {
          e.preventDefault();
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          h.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          history.pushState(null, '', '#' + h.id);
          /* S35 2026-07-07 (fable-frontend-audit) — pushState fires no
             hashchange and an instant (reduced-motion) jump may cross no
             observed heading, leaving the rail unhighlighted; the click
             names the target, so mark it directly. */
          setActive(h.id);
        });
        li.appendChild(a);
        list.appendChild(li);
        linkById[h.id] = a;
      });
      toc.classList.remove('hidden');
      var currentId = null;
      function setActive(id) {
        if (id === currentId) return;
        if (currentId && linkById[currentId]) {
          var prev = linkById[currentId];
          prev.className = base + (prev.getAttribute('data-toc-depth') === '3' ? ' pl-6 text-[0.8125rem]' : ' pl-3');
        }
        if (linkById[id]) {
          var next = linkById[id];
          next.className =
            activeCls + (next.getAttribute('data-toc-depth') === '3' ? ' pl-6 text-[0.8125rem]' : ' pl-3');
        }
        currentId = id;
      }
      if (!('IntersectionObserver' in window)) return;
      var inView = {};
      /* Shared spy resolution — first intersecting heading wins; when
         nothing intersects the band (mid-section scroll, or an instant
         anchor jump that crossed no heading) fall back to the last
         heading that has scrolled above it. Callable outside the IO
         callback (S35 2026-07-07 fable-frontend-audit: hashchange
         re-sync) because a jump that fires zero IO entries used to
         leave no rail entry highlighted. */
      function resolveSpy() {
        var current = null;
        for (var i = 0; i < headings.length; i++) {
          if (inView[headings[i].id]) {
            current = headings[i].id;
            break;
          }
        }
        if (!current) {
          for (var j = headings.length - 1; j >= 0; j--) {
            if (headings[j].getBoundingClientRect().top < 96) {
              current = headings[j].id;
              break;
            }
          }
        }
        if (current) setActive(current);
      }
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            inView[entry.target.id] = entry.isIntersecting;
          });
          resolveSpy();
        },
        { rootMargin: '-64px 0px -70% 0px' },
      );
      headings.forEach(function (h) {
        observer.observe(h);
      });
      /* S35 2026-07-07 (fable-frontend-audit) — in-article deep links
         and manual #edits navigate via real hash changes: highlight the
         named heading directly when it's a rail entry, else re-run the
         positional spy. */
      window.addEventListener('hashchange', function () {
        var raw = window.location.hash ? window.location.hash.slice(1) : '';
        var id = raw;
        try {
          id = decodeURIComponent(raw);
        } catch (_e) {
          /* malformed escape — use the raw hash */
        }
        if (id && linkById[id]) setActive(id);
        else if (id) resolveSpy();
      });
    })();
  </script>
  <script is:inline>
    /* S22.4 — client-side language tabs (Stoplight look, ZERO .md churn).
       Multi-language samples in the docs are runs of adjacent fenced
       blocks (Astro emits data-language on each astro-code <pre>). This
       groups a run of 2+ sibling <pre> elements whose languages are
       pairwise-DISTINCT members of an allowlist (ts/typescript, js,
       python/py, go, bash/sh, http) into one tab group: a
       role=tablist/tab/tabpanel bar (arrow-key accessible) above a single
       visible panel. A run may be interleaved with the docs' bold
       "**Python:**"-style label paragraphs — a <p><strong>…:</strong></p>
       naming the NEXT block's language joins the run and is hidden (the
       tab bar replaces it); any other content breaks the run. json is NOT
       allowlisted, so a JSON response block following a request sample
       stays OUTSIDE the group. The picked language persists in
       localStorage (ds_docs_lang) and applies to every group on the page.
       Runs in document order AFTER the copy-button script, so each moved
       <pre> carries its copy button along. Plain raw code — never a
       template literal inside an expression container (the
       dead-inline-script trap: Astro would emit the wrapper literally as
       a no-op string). */
    (function () {
      var article = document.querySelector('article');
      if (!article) return;
      var CANON = {
        ts: 'TypeScript',
        typescript: 'TypeScript',
        js: 'JavaScript',
        javascript: 'JavaScript',
        python: 'Python',
        py: 'Python',
        go: 'Go',
        bash: 'bash',
        sh: 'bash',
        http: 'HTTP',
      };
      var STORE_KEY = 'ds_docs_lang';
      var TAB_BASE =
        'rounded-md border border-transparent px-2.5 py-1 font-mono text-xs font-medium ' +
        'text-tk-ink-2 transition-colors hover:bg-tk-hover hover:text-tk-ink ' +
        'focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 ' +
        'focus-visible:outline-tk-accent';
      var TAB_ACTIVE =
        'rounded-md border border-tk-border bg-tk-raised px-2.5 py-1 font-mono text-xs ' +
        'font-medium text-tk-ink transition-colors ' +
        'focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 ' +
        'focus-visible:outline-tk-accent';
      function langOf(el) {
        if (!el || el.tagName !== 'PRE') return null;
        var raw = el.getAttribute('data-language');
        if (!raw) return null;
        return Object.prototype.hasOwnProperty.call(CANON, raw) ? CANON[raw] : null;
      }
      /* A <p><strong>Lang…:</strong></p> paragraph that NAMES the given
         language (the run-label convention in the .md sources). Anything
         else — e.g. "**Response:**" before a json block, prose, tables —
         is NOT absorbed and breaks the run. */
      function isLangLabelFor(el, lang) {
        if (!el || el.tagName !== 'P' || el.children.length !== 1) return false;
        var strong = el.children[0];
        if (strong.tagName !== 'STRONG') return false;
        var text = (el.textContent || '').trim();
        if (text !== (strong.textContent || '').trim()) return false;
        if (text.slice(-1) !== ':') return false;
        return text.toLowerCase().indexOf(lang.toLowerCase()) === 0;
      }
      function readStored() {
        try {
          return window.localStorage.getItem(STORE_KEY);
        } catch (e) {
          return null;
        }
      }
      function writeStored(lang) {
        try {
          window.localStorage.setItem(STORE_KEY, lang);
        } catch (e) {
          /* storage unavailable (private mode) — tabs still work per-page */
        }
      }
      var groups = [];
      var groupSeq = 0;
      function applyEverywhere(lang) {
        groups.forEach(function (g) {
          g.select(lang, false);
        });
      }
      function buildGroup(run, langs) {
        var id = ++groupSeq;
        var wrapper = document.createElement('div');
        wrapper.className = 'my-6';
        wrapper.setAttribute('data-langtabs', '');
        var bar = document.createElement('div');
        bar.setAttribute('role', 'tablist');
        bar.setAttribute('aria-label', 'Code sample language');
        bar.className =
          'flex flex-wrap items-center gap-1 rounded-t-lg border border-b-0 ' +
          'border-tk-border bg-tk-surface px-2 py-1.5';
        wrapper.appendChild(bar);
        var first = run[0].pre;
        first.parentNode.insertBefore(wrapper, first);
        var tabs = [];
        var panels = [];
        run.forEach(function (r, i) {
          var lang = langs[i];
          var tab = document.createElement('button');
          tab.type = 'button';
          tab.setAttribute('role', 'tab');
          tab.id = 'langtab-' + id + '-' + i;
          tab.setAttribute('aria-controls', 'langpanel-' + id + '-' + i);
          tab.setAttribute('data-lang', lang);
          tab.textContent = lang;
          bar.appendChild(tab);
          tabs.push(tab);
          var panel = document.createElement('div');
          panel.setAttribute('role', 'tabpanel');
          panel.id = 'langpanel-' + id + '-' + i;
          panel.setAttribute('aria-labelledby', tab.id);
          panel.setAttribute('tabindex', '0');
          /* Inside a group the pre loses its own vertical margins (the
             wrapper carries them) and its top radius (it sits flush
             under the tab bar). */
          r.pre.classList.add('my-0', 'rounded-t-none');
          panel.appendChild(r.pre);
          wrapper.appendChild(panel);
          panels.push(panel);
          if (r.label) r.label.hidden = true;
          tab.addEventListener('click', function () {
            applyEverywhere(lang);
            writeStored(lang);
          });
        });
        var group = {
          select: function (lang, focus) {
            var idx = langs.indexOf(lang);
            if (idx === -1) return;
            tabs.forEach(function (t, i) {
              var on = i === idx;
              t.setAttribute('aria-selected', on ? 'true' : 'false');
              t.tabIndex = on ? 0 : -1;
              t.className = on ? TAB_ACTIVE : TAB_BASE;
              panels[i].hidden = !on;
            });
            if (focus) tabs[idx].focus();
          },
        };
        bar.addEventListener('keydown', function (e) {
          var current = tabs.indexOf(document.activeElement);
          if (current === -1) return;
          var target = -1;
          if (e.key === 'ArrowRight') target = (current + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') target = (current - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') target = 0;
          else if (e.key === 'End') target = tabs.length - 1;
          if (target === -1) return;
          e.preventDefault();
          applyEverywhere(langs[target]);
          group.select(langs[target], true);
          writeStored(langs[target]);
        });
        groups.push(group);
        group.select(langs[0], false);
      }
      /* Collect maximal runs. "Adjacent" = consecutive element siblings —
         nothing between them except an absorbable language-label
         paragraph. A duplicate (already-seen) language ends the run: two
         bash blocks in a row are separate examples, not alternatives. */
      var pres = Array.prototype.slice.call(article.querySelectorAll('pre[data-language]'));
      var taken = [];
      pres.forEach(function (pre) {
        if (taken.indexOf(pre) !== -1) return;
        var lang = langOf(pre);
        if (!lang) return;
        var run = [{ pre: pre, label: null }];
        var langs = [lang];
        var seen = {};
        seen[lang] = true;
        var node = pre.nextElementSibling;
        var pendingLabel = null;
        while (node) {
          var nl = langOf(node);
          if (nl) {
            if (seen[nl]) break;
            run.push({ pre: node, label: pendingLabel });
            langs.push(nl);
            seen[nl] = true;
            pendingLabel = null;
            node = node.nextElementSibling;
            continue;
          }
          if (!pendingLabel) {
            var next = node.nextElementSibling;
            var nextLang = langOf(next);
            if (nextLang && !seen[nextLang] && isLangLabelFor(node, nextLang)) {
              pendingLabel = node;
              node = next;
              continue;
            }
          }
          break;
        }
        if (run.length < 2) return;
        var lead = pre.previousElementSibling;
        if (lead && isLangLabelFor(lead, langs[0])) run[0].label = lead;
        run.forEach(function (r) {
          taken.push(r.pre);
        });
        buildGroup(run, langs);
      });
      var stored = readStored();
      if (stored) applyEverywhere(stored);
    })();
  </script>
</BaseLayout>
