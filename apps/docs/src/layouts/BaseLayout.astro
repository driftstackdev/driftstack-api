---
// V-250 — docs site BaseLayout. Mirrors apps/marketing-site/BaseLayout
// for brand consistency; OG images point at the marketing site default
// since docs pages don't have their own social cards yet.
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pathname?: string;
}

const {
  title,
  description = 'Driftstack documentation: API reference, SDK guides, self-hosted GUI client.',
  pathname = Astro.url.pathname,
} = Astro.props;

const fullTitle = title === 'Driftstack docs' ? title : `${title} · Driftstack docs`;
const canonical = new URL(pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-mode="light" data-accent="violet">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Driftstack docs" />
    <meta property="og:image" content="https://driftstack.dev/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://driftstack.dev/og-default.png" />
    <link rel="icon" type="image/svg+xml" href="/driftstack-mark.svg?v=3" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface-base text-ink-primary">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
