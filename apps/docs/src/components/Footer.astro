---
// V-250 — docs site footer. Lighter-weight than marketing-site Footer
// (no "Product/Company/Trust/Legal" full grid) since docs.driftstack.dev
// is a focused reference surface; primary navigation is the docs tree.
// Cross-links back to marketing for the full company navigation.
const year = new Date().getUTCFullYear();
---

<footer class="border-t border-white/10 bg-surface-raised">
  <div class="mx-auto max-w-6xl px-6 py-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="flex items-center gap-2 font-mono text-sm font-semibold text-ink-primary">
          <img
            src="/driftstack-mark.svg?v=2"
            alt="Driftstack"
            width="24"
            height="24"
            class="inline-block h-6 w-6"
          />
          <span>driftstack</span>
          <span class="ml-1 text-xs text-ink-muted">docs</span>
        </div>
        <p class="mt-2 max-w-prose text-sm text-ink-secondary">
          Reference + guides for the Driftstack API, SDKs, and self-hosted client.
        </p>
      </div>
      <nav class="flex flex-wrap gap-4 text-sm text-ink-secondary">
        <a href="https://driftstack.dev" class="nav-link" target="_blank" rel="noopener noreferrer"
          >Marketing site</a
        >
        <a href="https://driftstack.dev/pricing" class="nav-link" target="_blank" rel="noopener noreferrer"
          >Pricing</a
        >
        <a href="https://driftstack.dev/security" class="nav-link" target="_blank" rel="noopener noreferrer"
          >Security</a
        >
        <a href="mailto:support@driftstack.dev" class="nav-link">support@driftstack.dev</a>
      </nav>
    </div>
    <div class="mt-6 border-t border-white/10 pt-4 text-xs text-ink-muted">
      <p>&copy; {year} Driftstack.</p>
    </div>
  </div>
</footer>
