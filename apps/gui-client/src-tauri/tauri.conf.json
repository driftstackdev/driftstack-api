{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driftstack",
  "version": "0.0.1",
  "identifier": "dev.driftstack.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Driftstack",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http: https: ws: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["default", "simulator", "updater-windows-linux"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/driftstackdev/driftstack-api/releases/latest/download/latest.json"
      ],
      "pubkey": "$TAURI_UPDATER_PUBKEY"
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["driftstack"]
      }
    }
  }
}
