{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities granted to the main window — only the surfaces the GUI actually needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "allow-ping",
    "allow-secret-save",
    "allow-secret-load",
    "allow-secret-delete",
    "allow-proxy-test",
    "allow-proxy-exit-probe",
    "allow-endpoint-resolve",
    "allow-simulator-app-supported",
    "allow-launch-simulator",
    "allow-close-simulator-windows",
    "allow-repair-simulator-install",
    "store:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/recordings" },
        { "path": "$APPDATA/recordings/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "http://localhost:5173/cli/authorize**" },
        { "url": "https://app.driftstack.io/cli/authorize**" },
        { "url": "https://app.driftstack.dev/cli/authorize**" },
        {
          "url": "https://staging.driftstack-customer-dashboard.pages.dev/cli/authorize**"
        }
      ]
    }
  ]
}
