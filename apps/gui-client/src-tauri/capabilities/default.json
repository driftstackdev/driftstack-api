{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities granted to the main window — only the surfaces the GUI actually needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "store:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/recordings/**" }]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "http://localhost:5173/cli/authorize**" },
        { "url": "https://app.driftstack.dev/cli/authorize**" },
        { "url": "https://app-staging.driftstack.dev/cli/authorize**" }
      ]
    }
  ]
}
