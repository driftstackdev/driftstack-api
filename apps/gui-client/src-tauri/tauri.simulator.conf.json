{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driftstack Simulator",
  "identifier": "dev.driftstack.simulator",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Driftstack Simulator",
        "url": "index.html?window=simulator",
        "width": 330,
        "height": 718,
        "minWidth": 280,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http: https: ws: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["simulator-app"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": []
      }
    }
  }
}
