{
  "name": "@driftstack/gui-client",
  "private": true,
  "version": "0.1.18",
  "description": "Driftstack self-hosted GUI client (Tauri + React + TS + Tailwind). Per file 128.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:simulator": "tauri build --config src-tauri/tauri.simulator.conf.json"
  },
  "dependencies": {
    "@driftstack/behavioural-simulation": "*",
    "@driftstack/sdk": "*",
    "@sentry/browser": "10.65.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-fs": "^2.1.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.1.0",
    "@tauri-apps/plugin-store": "^2.1.0",
    "@tauri-apps/plugin-updater": "^2.1.0",
    "livekit-client": "^2.19.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6"
  }
}
